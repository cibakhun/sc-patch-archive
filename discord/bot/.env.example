# ─────────────────────────────────────────────────────────────
#  VerseBase rank bot — environment
# ─────────────────────────────────────────────────────────────
#  Copy to ".env" and fill in. The real .env is git-ignored.
#
#  This is an ALWAYS-ON bot (it must keep running to award XP from
#  messages and voice). See README.md for deploy (pm2 / systemd / Docker).
# ─────────────────────────────────────────────────────────────

# Required — the bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Optional — the application ID (Developer Portal → General Information).
# If left blank it is derived from the token automatically.
CLIENT_ID=

# Optional — a single server ID. If set, slash commands register there
# instantly. Leave blank for global commands (~1h to appear). While
# HOME_GUILD_ID is empty, this server is also the home server (see below).
GUILD_ID=

# Optional — the ONE server whose Testpilot role and ranks are mirrored to the
# website. Every other server the bot may sit in is ignored for the mirror.
# Order: HOME_GUILD_ID, then GUILD_ID, then the server the website links to
# (discord/site-invite.mjs). An invalid value switches the mirror OFF.
HOME_GUILD_ID=

# Optional but recommended — the ID of the Testpilot role (Server Settings →
# Roles → right-click → Copy Role ID; needs Developer Mode). Without it the
# role is found by name at start (retried on each reconcile); two roles with
# that name switch the mirror off until this is set.
TESTER_ROLE_ID=

# ── Website mirror (Testpilot role + rank on the account page) ──────────────
# The bot writes through the Edge Function `bot-role-sync`, which can do
# exactly three things (list linked accounts, set is_tester, set rank stats).
# BOT_ROLE_SYNC_SECRET must equal the function's secret (32+ characters).
SUPABASE_URL=
BOT_ROLE_SYNC_SECRET=
# Optional — only if the function lives elsewhere than
# ${SUPABASE_URL}/functions/v1/bot-role-sync (must be https).
# BOT_ROLE_SYNC_URL=

# DEPRECATED — the service-role key bypasses every access rule of the whole
# database. Only a fallback while bot-role-sync is not deployed yet; every
# start warns while it is set. Remove it as soon as the function is live.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — days to keep XP/stats of members who left the server
# (default 30, 0 = delete at the next daily run; larger values are capped
# at 365; anything that is not a whole number >= 0 falls back to 30).
# The privacy policy states 30 days (src/pages/datenschutz.astro and
# src/pages/de/datenschutz.astro, #discord-server): change it there too.
# LEAVER_RETENTION_DAYS=30

# Optional — where the SQLite file lives (default: ./data/leveling.db)
# DB_PATH=./data/leveling.db
