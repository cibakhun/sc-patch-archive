---
// Items-Werkbank: Verzeichnis und Item Finder als EIN Werkzeug, gebaut auf
// dem Werkzeug-Standard (src/lib/werkzeugStandard.ts).
//
// Krisz 24.11.2026: „Schon von der Funktion her zusammen bauen zu 1 aber wir
// können die Möglichkeit nutzen um eine richtig geile neuen Standart
// einführen auf unsere Seite“. Seit dem 26.11.2026 ist sie die Seite
// /items.html; /item-finder.html leitet hierher (nginx/umzuege.conf).
//
// Was statisch im HTML steht (ohne Skript lesbar und krabbelbar): Reiter,
// Bedienleiste, die Leiste aller Gruppen und Kategorien als echte Links auf
// die Kategorielisten, der Ueberblick im Blatt mit den Gruppen und Zahlen.
// Die Treffer selbst zeichnet assets/items-werkbank.js aus dem Katalog
// (assets/universal-items.json), wie bisher der Finder.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { WZ_CSS } from '../../lib/werkzeugStandard';
import { wzZeichenCss } from '../../lib/werkzeugZeichen';
import { kategorieBaum, ZEICHEN_BLATT, ZEICHEN_GRUPPE, GRUPPEN_FARBE } from '../../lib/itemKategorien';
import { ITEM_UI } from '../../i18n/itemText';
import { useHelp } from '../../i18n/help';
import { versioned } from '../../lib/assetVersion';
import { assertLocale, href } from '../../i18n/ui';
import { jsonForScript } from '../../lib/safeJson';
import { erzKatalog } from '../../lib/miningLinks';
import { SET_HERSTELLER } from '../../../scripts/lib/armor-sets.mjs';
import { db, items, armorSets, ITEM_PATCH, num } from '../../lib/items';
import { ITEM3D_LISTE_URL } from '../../lib/item3d';
import { itemsWege } from '../../lib/itemsWerkbankWege';
import { BEZUGSWEGE_UI } from '../../i18n/bezugswegeText';
import { recipeForItem } from '../../lib/crafting';
import { datumLang } from '../../lib/datenstand';
import Item3dDialog from '../Item3dDialog.astro';

interface Props { lang: 'de' | 'en' }
const lang = assertLocale(Astro.props.lang, 'ItemsWerkbank');
const de = lang === 'de';
const n = (x: number) => num(x, lang);
const h = useHelp(lang);

// Cache-Bust per Inhalt: die Adresse wechselt mit der Datei, also darf der
// Browser sie lange behalten und holt nach jedem Bau die neue.
const ver = (f: string) => {
  try { return createHash('sha1').update(readFileSync(f)).digest('hex').slice(0, 8); } catch { return 'x'; }
};
const appJs = `/assets/items-werkbank.js?v=${ver('assets/items-werkbank.js')}`;
const dbUrl = `/assets/universal-items.json?v=${ver('assets/universal-items.json')}`;
const craftUrl = `/assets/crafting-db.json?v=${ver('assets/crafting-db.json')}`;

const baum = kategorieBaum(lang);
const total = db.counts.items;
const mitQuelle = db.counts.withObtain;
const groesste = Math.max(...baum.map((g) => g.n));
// Was das Datenblatt beantwortet, fuer das Blatt der Werkbank (Krisz
// 27.11.2026: „wofür sollte ein User den Datenblatt öffnen?“). Laedt mit dem
// ersten geoeffneten Item, wie das Rezept (src/lib/itemsWerkbankWege.ts).
const wege = await itemsWege(lang);
// Im Ueberblick statt „Datenblaetter“ (die es fuer Menschen nicht mehr gibt):
// wie viele Items man herstellen kann.
const herstellbar = items.filter((it) => recipeForItem(it)).length;

const W = {
  de: {
    tabItems: 'Items', tabSets: 'Rüstungssets',
    hilfeKurz: 'Hilfe',
    filter: 'Filter', suche: 'Item, Hersteller, Fundort suchen…', sucheKurz: 'Item, Hersteller, Fundort…', sucheLabel: 'Items durchsuchen', leeren: 'Suche leeren',
    sortEmpf: 'Empfohlen', sortName: 'Name (A–Z)', sortNameZ: 'Name (Z–A)', sortWert: 'Wert (hoch→niedrig)', sortPreis: 'Preis (aufsteigend)', sortPreisZ: 'Preis (absteigend)',
    sortLabel: 'Sortierung', kacheln: 'Kacheln', liste: 'Liste', ansicht: 'Ansicht',
    alle: 'Alle Items', gruppen: 'Gruppen', kategorien: 'Kategorien',
    nItems: 'Items', nSets: 'Sets', laden: 'Katalog wird geladen…',
    fArt: 'Fundart', fGroesse: 'Größe', fKlasse: 'Panzerungsklasse', fSel: 'Seltenheit',
    zuruecksetzen: 'Zurücksetzen', zeigen: '{n} zeigen', keine: 'Keine Treffer', schliessen: 'Schließen',
    ohneJs: 'Suche und Filter brauchen JavaScript. Die Kategorien führen auch so zu ihren Listen.', leerT: 'Nichts gefunden', ladeT: 'Nicht geladen', ladeK: 'Erneut laden', leerX: 'Versuch einen anderen Begriff oder nimm einen Filter heraus.', leerK: 'Alles zurücksetzen',
    ueTitel: 'Item-Katalog', ueLead: `${n(total)} Items aus Star Citizen ${ITEM_PATCH}: Werte, Preise und Fundorte. Wähle eine Gruppe oder ein Item.`,
    kItems: 'Items', kQuelle: 'mit Bezugsquelle', kHerstellbar: 'herstellbar', kSets: 'Sets',
    tippSuche: 'Suche', tippBlaettern: 'blättern', tippEsc: 'schließen',
    craftOeffnen: 'Im Crafting öffnen', craftMehr: '{n} weitere in der Crafting-Werkbank',
    setAnsehen: 'Set ansehen', setTeile: 'Teile in der Liste zeigen',
    schiffZeigen: 'In der Schiffsliste zeigen', fahrzeugWerte: 'Die technischen Daten dieses Fahrzeugs stehen in der Schiffsliste.',
    melden: 'Falschen Wert melden', hAehnlich: 'Ähnliche Items', hSerie: 'Ab Werk verbaut', hWerkzeuge: 'In den Werkzeugen',
    hQuellen: 'Bezugsquellen', hWerte: 'Technische Daten', hText: 'Beschreibung', hVar: 'Varianten', hSet: 'Set', hCraft: 'Crafting-Rezept', hGuide: 'Fundort-Guide', hTeile: 'Teile',
    zurueck: 'Zurück zu {name}', kAb: 'ab', kSchnitt: 'Ø Preis', kQuellen: 'Quellen', kGroesse: 'Größe', kTeile: 'Teile', kKern: 'Kernslots', kKlasse: 'Klasse',
    setKomplett: 'komplett', setTeilweise: '{n}/4 Kernslots', setFilter: 'Set: {name}',
    craftLaden: 'Rezept wird geladen…', imAll: 'im All',
    kurzSets: 'Sets', kurzItems: 'Items',
  },
  en: {
    tabItems: 'Items', tabSets: 'Armor sets',
    hilfeKurz: 'Help',
    filter: 'Filter', suche: 'Search item, manufacturer, location…', sucheKurz: 'Item, maker, location…', sucheLabel: 'Search items', leeren: 'Clear search',
    sortEmpf: 'Featured', sortName: 'Name (A–Z)', sortNameZ: 'Name (Z–A)', sortWert: 'Value (high→low)', sortPreis: 'Price (low→high)', sortPreisZ: 'Price (high→low)',
    sortLabel: 'Sort', kacheln: 'Tiles', liste: 'List', ansicht: 'View',
    alle: 'All items', gruppen: 'Groups', kategorien: 'Categories',
    nItems: 'Items', nSets: 'Sets', laden: 'Loading catalog…',
    fArt: 'Availability', fGroesse: 'Size', fKlasse: 'Armor class', fSel: 'Rarity',
    zuruecksetzen: 'Reset', zeigen: 'Show {n}', keine: 'No results', schliessen: 'Close',
    ohneJs: 'Search and filters need JavaScript. The categories still lead to their lists.', leerT: 'Nothing found', ladeT: 'Not loaded', ladeK: 'Try again', leerX: 'Try another term or remove a filter.', leerK: 'Reset everything',
    ueTitel: 'Item catalog', ueLead: `${n(total)} items from Star Citizen ${ITEM_PATCH}: stats, prices and locations. Pick a group or an item.`,
    kItems: 'Items', kQuelle: 'with a source', kHerstellbar: 'craftable', kSets: 'Sets',
    tippSuche: 'search', tippBlaettern: 'step through', tippEsc: 'close',
    craftOeffnen: 'Open in crafting', craftMehr: '{n} more in the crafting workbench',
    setAnsehen: 'View set', setTeile: 'Show parts in the list',
    schiffZeigen: 'Show in the ship list', fahrzeugWerte: 'This vehicle’s technical data is in the ship list.',
    melden: 'Report a wrong value', hAehnlich: 'Similar items', hSerie: 'Fitted as standard', hWerkzeuge: 'In the tools',
    hQuellen: 'Where to get it', hWerte: 'Specifications', hText: 'Description', hVar: 'Variants', hSet: 'Set', hCraft: 'Crafting recipe', hGuide: 'Location guide', hTeile: 'Parts',
    zurueck: 'Back to {name}', kAb: 'from', kSchnitt: 'Avg. price', kQuellen: 'Sources', kGroesse: 'Size', kTeile: 'Parts', kKern: 'Core slots', kKlasse: 'Class',
    setKomplett: 'complete', setTeilweise: '{n}/4 core slots', setFilter: 'Set: {name}',
    craftLaden: 'Loading recipe…', imAll: 'in space',
    kurzSets: 'Sets', kurzItems: 'Items',
  },
}[lang];

const CFG = {
  lang,
  dbUrl,
  craftUrl,
  // Nur noch fuer die Kachel (Strg-Klick, Crawler) und als Kennung im
  // Meldeformular; fuer Menschen fuehrt kein Knopf mehr aufs Datenblatt.
  itemBase: de ? '/de/items/' : '/items/',
  craftPage: href('/topics/crafting.html', lang),
  // Was das Datenblatt beantwortet (src/lib/itemsWerkbankWege.ts) und wohin
  // die Antworten fuehren: nur in Werkbaenke und Werkzeuge.
  wegeUrl: wege.url,
  bw: BEZUGSWEGE_UI[lang],
  schiffe: href('/schiffe.html', lang),
  wikelo: href('/topics/wikelo-emporium.html', lang),
  bruch: href('/fracturing.html', lang),
  feedback: href('/feedback.html', lang),
  // Stand der Kaufpreise, wie das Datenblatt ihn unter die Tabelle schreibt.
  preisStand: datumLang(db.pricesAsOf, lang),
  baum: baum.map((g) => ({ r: g.root, s: g.slug, n: g.name, c: g.n, g: g.g, f: g.farbe, b: g.blaetter.map((b) => ({ k: b.cat, s: b.slug, n: b.name, c: b.n, g: b.g })) })),
  zb: ZEICHEN_BLATT,
  zg: ZEICHEN_GRUPPE,
  farben: GRUPPEN_FARBE,
  erze: erzKatalog(lang),
  setHersteller: SET_HERSTELLER,
  t: ITEM_UI[lang],
  w: W,
  // „In 3D ansehen“: Liste der Modelle, nur im Vorschau-Bau (src/lib/item3d.ts).
  i3dListe: ITEM3D_LISTE_URL,
};

// Ring um das Emblem: gestrichelte Bahn, gezogener Kreis, vier Marken.
const RING = '<svg viewBox="0 0 120 120" fill="none" aria-hidden="true"><circle class="wzb-ring__a" cx="60" cy="60" r="56"/><circle class="wzb-ring__b" cx="60" cy="60" r="44"/><path class="wzb-ring__c" d="M60 0v10M60 110v10M0 60h10M110 60h10"/></svg>';
const allePfad = href('/items.html', lang);
---
<style is:inline set:html={WZ_CSS + '\n' + wzZeichenCss('.wz')}></style>
<style is:inline>
/* Items: Farben der Seite (Violett und Bernstein wie bisher der Finder). */
.wz--items{--akz:#A78BFA;--wert:#FFB84D}
/* „Elemente erklären“ unter den Schritten der Anleitung. */
.wz-hilfe__el{display:inline-flex;align-items:center;min-height:2.2rem;margin:.9rem 0 0;padding:.35rem .9rem;border:1px solid var(--hl2);border-radius:999px;background:none;color:var(--tx);font:inherit;font-size:var(--fs-7);font-weight:700;cursor:pointer;transition:border-color var(--dur-fast) var(--ease-ui),background-color var(--dur-fast) var(--ease-ui)}
.wz-hilfe__el:hover,.wz-hilfe__el[aria-pressed="true"]{border-color:var(--akz);background:color-mix(in srgb,var(--akz) 14%,transparent)}
.wz-hilfe__el:focus-visible{outline:2px solid var(--akz);outline-offset:2px}
.wz--items .wz-gr__liste{border-left:0}
/* Was das Datenblatt beantwortet (Krisz 27.11.2026), im Blatt der Werkbank:
   „So bekommst du es“ als Karten je Weg, wie auf dem Datenblatt. */
.wzb-wl{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:.5rem;margin:0;padding:0;list-style:none}
.wzb-weg{display:flex;flex-direction:column;gap:.3rem;min-width:0;padding:.65rem .8rem .7rem;border:1px solid var(--hl);border-top:2px solid var(--akz);border-radius:8px;background:var(--e2)}
.wzb-weg--craft{border-top-color:var(--wert)}
.wzb-weg__art{font-size:var(--fs-1);font-weight:700;letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--akz)}
.wzb-weg--craft .wzb-weg__art{color:var(--wert)}
.wzb-weg__h{font-size:var(--fs-8);font-weight:700;line-height:1.25;color:var(--tx);font-variant-numeric:tabular-nums}
.wzb-weg__n{font-size:var(--fs-4);line-height:1.45;color:var(--mu);overflow-wrap:anywhere}
.wzb-weg__z{display:grid;gap:.15rem;margin:0;padding:0;list-style:none;font-size:var(--fs-4);line-height:1.45;color:var(--tx);overflow-wrap:anywhere}
.wzb-weg__z a,.wzb-melden a{color:var(--tx);text-decoration:underline;text-decoration-color:var(--hl2);text-underline-offset:2px}
.wzb-weg__l{align-self:flex-start;margin-top:auto;padding:.2rem 0 0;border:0;background:none;color:var(--akz);font:inherit;font-size:var(--fs-4);font-weight:700;text-decoration:none;cursor:pointer}
.wzb-weg__l:hover,.wzb-weg__z a:hover,.wzb-melden a:hover{text-decoration:underline;text-decoration-color:currentColor}
.wzb-weg__l:focus-visible,.wzb-link:focus-visible,.wzb-sysb:focus-visible{outline:2px solid var(--akz);outline-offset:2px}
.wzb-zw{margin:0 0 .2rem}
.wzb-link{padding:0;border:0;background:none;color:var(--tx);font:inherit;text-decoration:underline;text-decoration-color:var(--hl2);text-underline-offset:2px;cursor:pointer}
.wzb-preise{margin:0 0 .55rem;font-size:var(--fs-4);color:var(--mu)}
.wzb-preise b{color:var(--tx);font-variant-numeric:tabular-nums}
.wzb-sys{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 .6rem}
.wzb-sys[hidden]{display:none}
.wzb-sysb{min-height:2rem;padding:.2rem .75rem;border:1px solid var(--hl2);border-radius:999px;background:none;color:var(--mu);font:inherit;font-size:var(--fs-4);cursor:pointer}
.wzb-sysb[aria-pressed="true"]{border-color:var(--akz);background:color-mix(in srgb,var(--akz) 14%,transparent);color:var(--tx)}
.wzb-setpreis{margin:.2rem 0 .6rem;font-size:var(--fs-5);line-height:1.5;color:var(--tx);overflow-wrap:anywhere}
.wzb-setpreis:empty{display:none}
.wzb-setpreis.is-leer,.wzb-setpreis.is-leer b,.wzb-setpreis__ort{color:var(--mu);font-weight:400}
.wzb-serie a.wz-tag{color:var(--tx);text-decoration:none}
.wzb-serie a.wz-tag:hover{border-color:var(--akz)}
.wzb-mehr{margin:.5rem 0 0;font-size:var(--fs-4);color:var(--mu)}
.wzb-mehr summary{cursor:pointer}
.wzb-melden{margin:1.4rem 0 0;font-size:var(--fs-4);color:var(--mu)}
</style>

<div class="wz wz--items wz-auftakt" id="wz" data-lang={lang}>
  <header class="wz-kopf">
    <div class="wz-reiter" role="tablist" aria-label={W.tabItems} data-help={h('itemfinder.ctl.view')} data-ev-filter="ansicht">
      <button class="wz-reiter__b" role="tab" type="button" id="wz-tab-items" data-tab="items" aria-selected="true" aria-controls="wz-bereich" tabindex="0"><span class="wi wi--grid4" aria-hidden="true"></span>{W.tabItems}<em>{n(total)}</em></button>
      <button class="wz-reiter__b" role="tab" type="button" id="wz-tab-sets" data-tab="sets" aria-selected="false" aria-controls="wz-bereich" tabindex="-1"><span class="wi wi--layers" aria-hidden="true"></span>{W.tabSets}<em>{n(armorSets.length)}</em></button>
    </div>
    {/* Die Anleitung nach dem Vertrag aller Werkzeuge (ToolHelp.astro,
        assets/tool-help.js, verify:help): Zweck, Schritte und der Knopf
        „Elemente erklären“, der die Bedienelemente mit data-help umrandet.
        Gestalt des Werkzeug-Standards; geht nie von selbst auf, sie
        schwebt ueber der Bedienung (data-help-auto="aus"). */}
    <details class="wz-hilfe tool-help" data-tool-id="itemfinder" data-help-auto="aus">
      <summary data-ev-hilfe="anleitung"><span class="wi wi--help" aria-hidden="true"></span><span class="wz-hilfe__lang">{h('itemfinder.title')}</span><span class="wz-hilfe__kurz">{W.hilfeKurz}</span></summary>
      <div class="wz-hilfe__in tool-help__body">
        <p class="tool-help__purpose">{h('itemfinder.purpose')}</p>
        <ol class="tool-help__steps"><li>{h('itemfinder.step1')}</li><li>{h('itemfinder.step2')}</li><li>{h('itemfinder.step3')}</li><li>{h('itemfinder.step4')}</li></ol>
        <button type="button" class="wz-hilfe__el tool-help__elbtn js-tool-help" data-tool-id="itemfinder" data-ev-hilfe="elemente" aria-pressed="false" data-label-off={h('ui.elements')} data-label-on={h('ui.elementsOff')} data-bubble-label={h('ui.bubbleLabel')}>{h('ui.elements')}</button>
      </div>
    </details>
  </header>

  <div class="wz-bar">
    <button class="wz-knopf wz-filterknopf" id="wz-filterknopf" type="button" aria-expanded="false" aria-controls="wz-schublade" data-offcanvas-toggle="wz-schublade" data-help={h('itemfinder.ctl.filter')}><span class="wi wi--filter" aria-hidden="true"></span>{W.filter}</button>
    <div class="wz-suche" id="wz-suche" data-help={h('itemfinder.ctl.search')}>
      <label class="wz-sr" for="wz-q">{W.sucheLabel}</label>
      <span class="wi wi--search" aria-hidden="true"></span>
      <input type="search" id="wz-q" placeholder={W.suche} autocomplete="off" spellcheck="false" enterkeyhint="search" data-ev-filter="suche" />
      <kbd aria-hidden="true">/</kbd>
      <button class="wz-leeren" id="wz-leeren" type="button" aria-label={W.leeren}><span class="wi wi--close" aria-hidden="true"></span></button>
    </div>
    <label class="wz-sort" data-help={h('itemfinder.ctl.sort')}>
      <span class="wz-sr">{W.sortLabel}</span>
      <select id="wz-sort" data-ev-filter="sortierung">
        <option value="relevanz">{W.sortEmpf}</option>
        <option value="name">{W.sortName}</option>
        <option value="name-z">{W.sortNameZ}</option>
        <option value="wert">{W.sortWert}</option>
        <option value="preis">{W.sortPreis}</option>
        <option value="preis-z">{W.sortPreisZ}</option>
      </select>
    </label>
    <div class="wz-ansicht" role="group" aria-label={W.ansicht} data-help={h('itemfinder.ctl.layout')}>
      <button type="button" data-ansicht="kacheln" aria-pressed="true" title={W.kacheln} aria-label={W.kacheln}><span class="wi wi--grid" aria-hidden="true"></span></button>
      <button type="button" data-ansicht="liste" aria-pressed="false" title={W.liste} aria-label={W.liste}><span class="wi wi--list" aria-hidden="true"></span></button>
    </div>
  </div>

  {/* Leiste: jede Kategorie als echter Link auf ihre Liste. Das Skript
      faengt den Klick ab und filtert an Ort und Stelle; Strg-Klick,
      Mittelklick und Crawler folgen dem Link. */}
  <nav class="wz-rail" id="wz-rail" aria-label={W.kategorien} data-help={h('itemfinder.ctl.category')} data-ev-filter="kategorie">
    <a class="wz-rail__alle is-an" href={allePfad} data-kat="" aria-current="true"><span class="wz-z" data-g="grid4" aria-hidden="true"></span>{W.alle}<em>{n(total)}</em></a>
    {baum.map((g) => (
      <div class="wz-gr" data-root={g.root} style={`--kc:${g.farbe}`}>
        <button class="wz-gr__kopf" type="button" data-gruppe={g.slug} aria-expanded="false"><span class="wz-z" data-g={g.g} aria-hidden="true"></span><span title={g.name}>{g.name}</span><em>{n(g.n)} {W.nItems}</em><span class="wi wi--chev" aria-hidden="true"></span></button>
        {/* Ohne Skript klappt nichts: dann steht statt des Knopfs diese
            Ueberschrift da (noscript-Regel unten). */}
        <p class="wz-gr__titel" hidden><span class="wz-z" data-g={g.g} aria-hidden="true"></span><span>{g.name}</span><em>{n(g.n)} {W.nItems}</em></p>
        <ul class="wz-gr__liste">
          {g.blaetter.map((b) => (
            <li><a href={href(`/items/category/${b.slug}.html`, lang)} data-kat={b.slug}><span>{b.name}</span><em>{n(b.n)}</em></a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <div class="wz-chips" id="wz-chips" aria-label={W.gruppen}></div>

  <section class="wz-liste" id="wz-bereich" role="tabpanel" aria-labelledby="wz-tab-items">
    <div class="wz-zahl" id="wz-zahl"><b id="wz-n">{n(total)}</b><span id="wz-n-l">{W.nItems}</span><span class="wz-aktiv" id="wz-aktiv"></span></div>
    {/* Ohne Skript: die Kategorien stehen offen da und fuehren auf ihre
        Listen (unter 1180 px dort, wo sonst die Chips stehen); Suche und
        Treffer brauchen das Skript und sagen das. Was ohne Skript nichts
        tut, ist weg: Reiter, Bedienleiste, Tastenhilfe, die Gruppen-Kacheln
        im Ueberblick. Die Rueckwege im Kopf bleiben. */}
    <noscript>
      <style is:inline set:html={`.wz-rail{display:block!important}.wz-gr__liste{display:block!important}.wz-gr__kopf,.wz-gitter,.wz-chips,.wz-reiter,.wz-bar,.wz-hilfe,.wzu .wzb-inh{display:none!important}.wz-rail .wz-gr__titel[hidden]{display:grid!important;grid-template-columns:auto minmax(0,1fr);grid-template-areas:"z n" "z e";gap:.05rem .6rem;align-items:center;margin:0;padding:.48rem .55rem;font-size:var(--fs-7);font-weight:700;line-height:1.2;color:var(--tx)}.wz-gr__titel>.wz-z{grid-area:z}.wz-gr__titel>span:not([class]){grid-area:n}.wz-rail .wz-gr__titel>em{grid-area:e;justify-self:start;margin:0;padding:0;background:none;font-style:normal;font-size:var(--fs-2);font-weight:600;letter-spacing:var(--ls-5);color:var(--mu)}.wz-ohne-js{margin:.8rem 0;color:var(--mu);font-size:var(--fs-7)}@media (min-width:821px) and (max-width:1179px){.wz-rail{grid-area:chips;margin-bottom:1rem}}`}></style>
      <p class="wz-ohne-js">{W.ohneJs}</p>
    </noscript>
    {/* data-ev-treffer / data-ev-fenster: Messereignis treffer-offen
        (assets/ereignisse.js). Die Treffer sind die Karten; das Blatt steht
        am Schreibtisch im Fluss und zaehlt wie ein offenes Fenster, ein
        Link darin also nicht noch einmal. */}
    <div class="wz-gitter vb-scrollbox" id="wz-gitter" aria-busy="true" data-ev-treffer>
      {Array.from({ length: 12 }, () => (
        <div class="wz-k wz-k--leer" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      ))}
    </div>
  </section>

  <section class="wz-blatt" id="wz-blatt" aria-label={W.ueTitel} data-ev-fenster>
    <div class="wz-blatt__box" id="wz-blatt-box" tabindex="-1">
      <button class="wz-blatt__x" id="wz-blatt-x" type="button" aria-label={W.schliessen}><span class="wi wi--close" aria-hidden="true"></span></button>
      <button class="wz-blatt__zur" id="wz-blatt-zur" type="button" hidden><span class="wi wi--back" aria-hidden="true"></span><span></span></button>
      <div class="wz-blatt__inh" id="wz-blatt-inh">
        <div class="wzu">
          <div class="wzb-kopf" style="--kc:#A78BFA">
            <div class="wzb-emb"><Fragment set:html={RING} /><span class="wg" data-g="grid4" aria-hidden="true"></span></div>
            <div class="wzb-kopf__t">
              <p class="wzb-pfad"><span>Star Citizen {ITEM_PATCH}</span></p>
              <h2 class="wzb-name">{W.ueTitel}</h2>
              <p class="wzu__lead">{W.ueLead}</p>
            </div>
          </div>
          <div class="wzb-kenn">
            <div><span>{W.kItems}</span><b>{n(total)}</b></div>
            <div><span>{W.kQuelle}</span><b class="is-wert">{n(mitQuelle)}</b></div>
            <div><span>{W.kHerstellbar}</span><b>{n(herstellbar)}</b></div>
            <div><span>{W.kSets}</span><b>{n(armorSets.length)}</b></div>
          </div>
          <div class="wzb-inh">
            <h3 class="wzb-h">{W.gruppen}<em>{baum.length}</em></h3>
            <div class="wzu__gr">
              {baum.map((g) => (
                <button class="wzu__g" type="button" data-gruppe={g.slug} style={`--kc:${g.farbe};--anteil:${Math.max(4, Math.round((g.n / groesste) * 100))}%`}>
                  <span class="wz-z" data-g={g.g} aria-hidden="true"></span><b>{g.name}</b><small>{n(g.n)} {W.nItems} · {g.blaetter.length} {W.kategorien}</small><i aria-hidden="true"></i>
                </button>
              ))}
            </div>
            <ul class="wzu__tipp">
              <li><kbd>/</kbd>{W.tippSuche}</li>
              <li><kbd>↑</kbd><kbd>↓</kbd>{W.tippBlaettern}</li>
              <li><kbd>Esc</kbd>{W.tippEsc}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <aside class="wz-schublade" id="wz-schublade" aria-label={W.filter} data-offcanvas data-offcanvas-immer>
    <div class="wz-schublade__kopf">{W.filter}<button type="button" id="wz-schublade-x" aria-label={W.schliessen}><span class="wi wi--close" aria-hidden="true"></span></button></div>
    <div class="wz-fg" data-help={h('itemfinder.ctl.kind')}><h3>{W.fArt}</h3><div class="wz-fchips" id="wz-f-art" data-ev-filter="verfuegbarkeit"></div></div>
    <div class="wz-fg" data-help={h('itemfinder.ctl.size')}><h3>{W.fGroesse}</h3><div class="wz-fchips" id="wz-f-gr" data-ev-filter="groesse"></div></div>
    <div class="wz-fg" data-help={h('itemfinder.ctl.weight')}><h3>{W.fKlasse}</h3><div class="wz-fchips" id="wz-f-pk" data-ev-filter="gewicht"></div></div>
    <div class="wz-fg" data-help={h('itemfinder.ctl.rarity')}><h3>{W.fSel}</h3><div class="wz-fchips" id="wz-f-sel" data-ev-filter="seltenheit"></div></div>
    <div class="wz-schublade__fuss">
      <button class="wz-knopf" type="button" id="wz-f-reset">{W.zuruecksetzen}</button>
      <button class="wz-zeigen" type="button" id="wz-f-zeigen">{W.zeigen.replace('{n}', n(total))}</button>
    </div>
  </aside>
</div>

{ITEM3D_LISTE_URL && <Item3dDialog model={null} name="" lang={lang} liste={ITEM3D_LISTE_URL} />}
<script is:inline set:html={`window.__WZI=${jsonForScript(CFG)};`} />
<script is:inline src={appJs}></script>
<script is:inline defer src={versioned('assets/tool-help.js', '/assets/tool-help.js')}></script>
