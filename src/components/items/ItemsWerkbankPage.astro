---
// Items-Werkbank — EIN Koerper fuer DE und EN (Huellen: src/pages/items/
// index.astro und src/pages/de/items/index.astro, also /items.html).
//
// Aufbau wie die Crafting-Seite (components/topics/crafting.astro): kein
// Kopfband, das Werkzeug ist die Seite. Die Ueberschrift bleibt fuer
// Vorleser und Suchmaschinen im Dokument; was man zum Bedienen nicht
// braucht (Einleitung, Kennzahlen, Hinweise, Verzeichnisse, Datenstand),
// steht darunter, als sichtbarer Text und echte Links.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schliessendes Tag (siehe Sprungmarke).
import SiteNav from '../SiteNav.astro';
import Attribution from '../Attribution.astro';
import Datenstand from '../Datenstand.astro';
import ItemsWerkbank from './ItemsWerkbank.astro';
import { standItems, datumLang } from '../../lib/datenstand';
import { localeFromPath, href } from '../../i18n/ui';
import { versioned } from '../../lib/assetVersion';
import { ITEM_KENNUNG, db, num, roots } from '../../lib/items';
import { patchLinkFromKennung } from '../../lib/patchPages';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const n = (x: number) => num(x, lang);
const total = db.counts.items;
const sourced = db.counts.withObtain;
const unsourced = total - sourced;
const unsourcedPct = Math.round((unsourced / total) * 100);
const nKat = roots.reduce((s, r) => s + r.nodes.length, 0);
const patchLink = patchLinkFromKennung(ITEM_KENNUNG, lang);
const patchHref = patchLink.href;
const crumbPatch = patchHref ? [{ label: patchLink.label, href: patchHref }] : [];
// Dieselben Wertegruppen wie im bisherigen Finder (bis 26.11.2026).
const mitSchnappschuss = db.items.some((i) => i.obtain.some((o) => o.src === 'schnappschuss'));
const mitFundortSpiel = db.items.some((i) => i.fund != null);
---
<style is:inline>
/* Seitenfarben wie bisher der Finder: Violett und Bernstein. */
:root{--bg:#0d0c14;--bg-2:#14121c;--surface:#17151f;--surface-2:#1e1b29;--accent:#A78BFA;--accent-2:#FFB84D;--hot:#A78BFA;--text:#eef1f5;--muted:#9d9cb0;--line:rgba(167,139,250,.22);--line-soft:rgba(238,241,245,.10);--glow:0 0 44px rgba(167,139,250,.28);--ink:#0d0c14;--maxw:1240px;}
body{background:var(--bg)}
/* Das Werkzeug ist die Seite: Freiraum unter der festen Kopfleiste an <main>. */
.wz-seite{padding-top:calc(var(--nav-h,68px) + .5rem)}
.hero.wz-sr{position:absolute;width:1px;height:1px;min-height:0;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
/* Unter dem Werkzeug, auf dessen Kanten. Ab 900 px zwei Spalten: links
   Zeile, Kennzahlen und Verzeichnisse, rechts die Hinweise; der Datenstand
   darunter ueber die ganze Breite. */
.wz-about{margin:1.6rem 0 0;padding:1.4rem clamp(.75rem,1.6vw,1.5rem) 0;border-top:1px solid var(--line-soft);display:flex;flex-direction:column;gap:.9rem}
.wz-about__lead{margin:0;max-width:74ch;color:var(--muted);font-size:var(--fs-9);line-height:1.55}
.wz-about .qbar{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-12);text-transform:uppercase;font-size:var(--fs-5);color:var(--muted)}
.wz-about .qbar b{color:var(--accent-2)}
.wz-about .qbar a{color:inherit;text-decoration:none;border-bottom:1px solid var(--line)}
.wz-about .qbar a:hover{border-color:var(--accent-2)}
.wz-about__hinweise{display:flex;flex-direction:column;gap:.6rem}
.wz-about__note{margin:0;padding-left:.7rem;border-left:2px solid var(--accent-2);color:var(--muted);font-size:var(--fs-7);line-height:1.5}
.wz-about__note b{color:var(--text)}
.wz-about__links{margin:0;display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;font-weight:700;font-size:var(--fs-8)}
.wz-about__links a{color:var(--accent);text-decoration:none;border-bottom:1px solid var(--line)}
.wz-about__links a:hover{color:var(--accent-2);border-color:var(--accent-2)}
.wz-about .vb-stand.vb-stand--innen{margin-bottom:2.4rem}
@media (min-width:900px){
  .wz-about{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,34rem);gap:.9rem 2.4rem;align-items:start}
  .wz-about > *{grid-column:1}
  .wz-about > .wz-about__hinweise{grid-column:2;grid-row:1 / span 3}
  .wz-about > .vb-stand{grid-column:1 / -1}
}
@media (max-width:640px){
  .wz-about{margin-top:1.2rem;padding-top:1rem;gap:.6rem}
  .wz-about__lead{font-size:var(--fs-8);line-height:1.45}
  .wz-about__note{font-size:var(--fs-6);line-height:1.45}
  .wz-about__links{font-size:var(--fs-7);gap:.3rem 1.1rem}
  .wz-about .qbar{gap:.3rem 1rem;font-size:var(--fs-4)}
}
</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav backMark={false} crumbs={[{ label: de ? 'Archiv' : 'Archive', href: de ? '/de/archiv.html' : '/archiv.html' }, ...crumbPatch, { label: 'Items' }]} />

<main id="main" class="wz-seite">
  <section class="hero wz-sr">
    <div class="hero__in">
      <h1><span class="thin">Star Citizen</span> Items</h1>
    </div>
  </section>

  <ItemsWerkbank lang={lang} />

  <aside class="wz-about">
    <p class="wz-about__lead">{de ? 'Jedes Item in Star Citizen an einem Ort: Spielwerte, Kaufpreise, Shop-Orte und Loot-Fundorte.' : 'Every item in Star Citizen in one place: stats, buy prices, shop locations and loot spots.'}</p>
    <div class="qbar"><span>Items <b>{n(total)}</b></span><span>{de ? 'Mit Quellen' : 'With sources'} <b>{n(sourced)}</b></span><span>{de ? 'Kategorien' : 'Categories'} <b>{n(nKat)}</b></span><span>Patch {patchHref ? <a href={patchHref}><b>{patchLink.version}</b></a> : <b>{patchLink.version}</b>}</span></div>
    <p class="wz-about__links">
      <a href={href('/armor-sets.html', lang)}>{de ? 'Rüstungssets →' : 'Armor sets →'}</a>
      <a href={href('/topics/crafting.html', lang)}>Crafting →</a>
    </p>
    <div class="wz-about__hinweise">
      <p class="wz-about__note">{de
        ? <><b>{n(unsourced)} von {n(total)} Items ({unsourcedPct} %)</b> haben noch keine verifizierte Shop- oder Loot-Quelle. Ihr Blatt sagt das offen, statt einen Fundort zu raten; der Filter „Nur Katalog" listet sie.</>
        : <><b>{n(unsourced)} of {n(total)} items ({unsourcedPct}%)</b> have no verified shop or loot source yet. Their sheet says so instead of guessing a location; the "Catalog only" filter lists them.</>}</p>
      <p class="wz-about__note">{de ? 'Preise und Fundorte sind ' : 'Prices and locations are '}<b>{de ? 'Patch-volatil, ingame prüfen' : 'patch-volatile, verify in game'}</b> {de ? `(Preisstand: ${datumLang(db.pricesAsOf, lang)}).` : `(prices as of ${datumLang(db.pricesAsOf, lang)}).`}</p>
    </div>
    <Datenstand lang={lang} innen zeilen={standItems(lang, { preise: true, schnappschuss: mitSchnappschuss, fundorte: true, fundorteSpiel: mitFundortSpiel })} />
  </aside>
</main>

<Attribution sources={[]} />

<script is:inline defer src={versioned('assets/detail.js', '/assets/detail.js')}></script>
