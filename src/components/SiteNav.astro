      // sichtbar laesst den Browser das ganze Menü in einem Zug layouten und
      // zeichnen (4 Gruppen, 15 Zeilen, Bühne, Fuß) — gemessen das teuerste
      // Bild der ganzen Interaktion. Lief die Animation im selben Bild los,
      // fraß dieser Aufbau ihre ersten Bilder auf und sie wirkte hakelig.
      // Jetzt ist der Aufbau fertig, bevor sich etwas bewegt.
      // setTimeout als Rückfall: in gedrosselten oder eingebetteten Ansichten
      // feuert rAF nicht, das Menü stünde sonst unsichtbar offen und finge
      // Klicks ab. Beide Wege sind über `armed` gegeneinander verriegelt.
      var armed = false;
      var arm = function () {
        if (armed) return;
        armed = true;
        deck.classList.add('is-open');
        // ⚠ Gemessen 30.08.2026 bei 390x844: der Rahmen traegt 19 Eintraege
        // = 1361 px in 844 px und ist scrollbar — sechs Zeilen stehen unter
        // der Kante, im Querformat fuenfzehn. assets/theme.css blendet aber
        // JEDE Bildlaufleiste aus, also sagte das niemandem etwas. Der Kasten
        // steht seit demselben Tag in SEL_VFADE; er kann dort aber erst
        // erfasst werden, wenn er GEOEFFNET ist — beim ersten scan() ist er
        // 0x0 gross. Deshalb hier der erneute Anlauf (wie ihn der Item Finder
        // fuer sein Modal machte).
        if (window.VBScrollAffordance) window.VBScrollAffordance();
      };
      requestAnimationFrame(arm);
      setTimeout(arm, 60);
      // is-deck-open bleibt (scrollbar-gutter), die eigentliche Sperre
      // uebernimmt die geteilte Fassung: overflow:hidden am Wurzelelement
      // reicht auf iOS Safari nicht. Siehe assets/scroll-lock.js.
      document.documentElement.classList.add('is-deck-open');
      if (window.VBScrollLock) window.VBScrollLock.lock();
      btn.setAttribute('aria-expanded', 'true');
    }

    function closeDeck() {
      // Auf die Klasse pruefen, NICHT auf `hidden`: das wird erst nach der
      // Ausblend-Dauer gesetzt. In diesem Fenster wuerde ein zweiter Klick
      // sonst ein zweites Mal entsperren.
      if (!deck.classList.contains('is-open')) return;
      deck.classList.remove('is-open');
      document.documentElement.classList.remove('is-deck-open');
      if (window.VBScrollLock) window.VBScrollLock.unlock();
      btn.setAttribute('aria-expanded', 'false');
      // 200 statt 380 ms: die Ausblendung dauert jetzt 160 ms (.snav-deck).
      // Laenger warten hiesse nur, dass das Menue unsichtbar weiter Klicks
      // abfaengt.
      setTimeout(function () { deck.hidden = true; }, 200);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    btn.addEventListener('click', function () {
      deck.hidden ? openDeck() : closeDeck();
    });
    // Motive schon beim Anfahren des Knopfes holen, nicht erst beim Klick:
    // 11 Bilder (~94 KB) im selben Bild zu dekodieren, in dem das Menue
    // aufgebaut wird, kostet genau dort Zeit, wo es auffaellt. Wer klickt,
    // faehrt vorher mit dem Zeiger hin; auf Beruehrung greift der
    // Rueckfall in openDeck().
    ['pointerenter', 'focus'].forEach(function (ev) {
      btn.addEventListener(ev, primeShots, { once: true, passive: true });
    });
    deck.querySelectorAll('[data-deck-close]').forEach(function (el) {
      el.addEventListener('click', closeDeck);
    });

    var ARROWS = { ArrowUp: 1, ArrowDown: 1, ArrowLeft: 1, ArrowRight: 1 };

    addEventListener('keydown', function (e) {
      if (deck.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDeck();
        return;
      }
      if (ARROWS[e.key]) {
        var cols = columns();
        if (!cols.length) return;
        e.preventDefault();
        var active = document.activeElement;
        var c = -1;
        var r = -1;
        for (var i = 0; i < cols.length; i++) {
          var idx = cols[i].indexOf(active);
          if (idx > -1) { c = i; r = idx; break; }
        }
        // noch keine Zeile fokussiert -> erste Zeile übernehmen
        if (c === -1) { focusRow(cols[0][0]); return; }
        if (e.key === 'ArrowDown') r = (r + 1) % cols[c].length;
        else if (e.key === 'ArrowUp') r = (r - 1 + cols[c].length) % cols[c].length;
        else {
          c = e.key === 'ArrowRight' ? (c + 1) % cols.length : (c - 1 + cols.length) % cols.length;
          // Spalten sind unterschiedlich lang: Zeilenindex klemmen statt springen
          r = Math.min(r, cols[c].length - 1);
        }
        focusRow(cols[c][r]);
        return;
      }
      if (e.key !== 'Tab') return;
      // Fokus-Falle: Tab kreist innerhalb des Overlays statt in die Seite zu entkommen
      var items = focusable();
      if (!items.length) return;
      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  })();
</script>
