---
// Kopf der Chronik: das Bild des ersten Abschnitts und seine Schriften laden
// vor allem anderen, damit beim ersten Besuch nichts nachrueckt. Die Quellen
// entsprechen genau dem <picture> in Bild.astro.
import type { Chronik } from '../../lib/patch-chronik/chronik';

interface Props { chronik: Chronik }
const erster = Astro.props.chronik.abschnitte[0];
const b = erster.art === 'auftakt' ? erster.bild : null;
---
{b && (b.avif
  ? <link rel="preload" as="image" type="image/avif" imagesrcset={`${b.avif} ${b.quellen[b.quellen.length - 1].w}w`} imagesizes="100vw" fetchpriority="high" />
  : <link rel="preload" as="image" type="image/webp" imagesrcset={b.quellen.map((q) => `${q.src} ${q.w}w`).join(', ')} imagesizes="100vw" fetchpriority="high" />)}
<link rel="preload" href="/assets/fonts/orbitron-500-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/fonts/rajdhani-600-latin.woff2" as="font" type="font/woff2" crossorigin />
