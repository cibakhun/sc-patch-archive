---
import Bild from './Bild.astro';
import SatzText from './SatzText.astro';
import type { Abschnitt } from '../../lib/patch-chronik/chronik';

interface Props { a: Extract<Abschnitt, { art: 'bild-text' }> }
const { a } = Astro.props;
---
<section class="abschnitt bildtext" id={a.id} aria-labelledby={`${a.id}-h`}>
  <div class="bildtext__text">
    <h2 id={`${a.id}-h`}>{a.titel}</h2>
    <p><SatzText satz={a.satz} /></p>
    {a.gruppen.map((g) => (
      <div class="bildtext__gruppe">
        <h3>{g.titel}</h3>
        <ul>{g.eintraege.map((e) => <li>{e.h ? <a href={e.h}>{e.t}</a> : e.t}</li>)}</ul>
      </div>
    ))}
    <p class="stempel"><SatzText satz={a.stempel} /></p>
  </div>
  <Bild bild={a.bild} class="bildtext__bild" sizes="(max-width: 760px) 100vw, 55vw" />
</section>
