---
import SatzText from './SatzText.astro';
import type { Abschnitt } from '../../lib/patch-chronik/chronik';

interface Props { a: Extract<Abschnitt, { art: 'bestand' }> }
const { a } = Astro.props;
---
<section class="abschnitt bestand" id={a.id} aria-labelledby={`${a.id}-h`}>
  <h2 id={`${a.id}-h`}>{a.titel}</h2>
  <div class="bestand__gruppen">
    {a.gruppen.map((g) => (
      <div class="bestand__gruppe">
        <h3>{g.titel}</h3>
        <dl>
          {g.zeilen.map((z) => (
            <div>
              <dt>{z.name.h ? <a href={z.name.h}>{z.name.t}</a> : z.name.t}</dt>
              {z.werte.map((w) => <dd>{w.k && <span>{w.k}</span>}{w.k && ' '}{w.v}</dd>)}
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
  <div class="ausquelle">
    <h3><SatzText satz={a.ausQuelle.titel} /></h3>
    <ul>{a.ausQuelle.punkte.map((p) => <li><SatzText satz={p} /></li>)}</ul>
  </div>
  <p class="stempel"><SatzText satz={a.stempel} /></p>
</section>
