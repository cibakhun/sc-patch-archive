---
import type { Bild } from '../../lib/patch-chronik/chronik';

interface Props { bild: Bild; class?: string; sizes?: string; laden?: 'eager' | 'lazy' }
const { bild, class: cls, sizes = '100vw', laden = 'lazy' } = Astro.props;
const srcset = bild.breiten.map((b) => `${bild.basis}-${b}.webp ${b}w`).join(', ');
const groesste = bild.breiten[bild.breiten.length - 1];
---
<picture class={cls}>
  {bild.avif && <source type="image/avif" srcset={`${bild.basis}-1920.avif 1920w`} sizes={sizes} />}
  <img src={`${bild.basis}-${groesste}.webp`} srcset={srcset} sizes={sizes} alt={bild.alt} loading={laden} decoding="async" fetchpriority={laden === 'eager' ? 'high' : undefined} />
</picture>
