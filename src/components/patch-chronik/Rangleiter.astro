---
import Bild from './Bild.astro';
import SatzText from './SatzText.astro';
import type { Abschnitt } from '../../lib/patch-chronik/chronik';

interface Props { a: Extract<Abschnitt, { art: 'leiter' }> }
const { a } = Astro.props;
---
<section class="abschnitt leiter" id={a.id} aria-labelledby={`${a.id}-h`}>
  <figure class="leiter__band">
    <Bild bild={a.bild} />
    <figcaption><SatzText satz={a.bildSatz} /></figcaption>
  </figure>
  <div class="leiter__buehne">
    <div class="leiter__text">
      <h2 id={`${a.id}-h`}>{a.titel}</h2>
      {a.text.map((s) => <p><SatzText satz={s} /></p>)}
      <p class="stempel"><SatzText satz={a.stempel} /></p>
    </div>
    <div class="leiter__rechts">
      <h3>{a.leiterTitel}</h3>
      <ol class="leiter__stufen">
        {a.stufen.map((s) => (
          <li class:list={['stufe', { 'stufe--leer': !s.eintraege.length }]}>
            <span class="stufe__rang">{s.rang}</span>
            {s.eintraege.length > 0 && (
              <ul class="stufe__auftraege">{s.eintraege.map((e) => <li>{e.h ? <a href={e.h}>{e.t}</a> : e.t}</li>)}</ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
