---
import SatzText from './SatzText.astro';
import type { Abschnitt } from '../../lib/patch-chronik/chronik';

interface Props { a: Extract<Abschnitt, { art: 'liste' }> }
const { a } = Astro.props;
---
<section class="abschnitt textliste" id={a.id} aria-labelledby={`${a.id}-h`}>
  <div class="textliste__text">
    <h2 id={`${a.id}-h`}>{a.titel}</h2>
    {a.text.map((s) => <p><SatzText satz={s} /></p>)}
    <p class="stempel"><SatzText satz={a.stempel} /></p>
  </div>
  <div class="textliste__liste">
    <h3>{a.listeTitel}</h3>
    <dl>
      {a.gruppen.map((g) => (
        <div>
          <dt>{g.titel}</dt>
          <dd><ul>{g.eintraege.map((e) => <li>{e.h ? <a href={e.h}>{e.t}</a> : e.t}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
  </div>
</section>
