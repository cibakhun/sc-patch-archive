---
// Kategorie-Liste — die Bruecke zwischen Hub und Datenblatt.
//
// Sie listet ALLE Eintraege der Kategorie, auch die ohne eigene Seite: so ist
// jeder Item-Name irgendwo im HTML auffindbar, ohne dass fuer jeden Katalog-
// Rest eine eigene, leere URL entsteht.
import DataShell from './DataShell.astro';
import { standItems, datumLang } from '../lib/datenstand';
import { href, type Locale } from '../i18n/ui';
import { itemT, obtainLabel, fill, categoryLabel } from '../i18n/itemText';
import {
  PER_PAGE, auec, avgPrice, categoryPath, db, displayName, itemPath, itemsHubPath,
  minPrice, num, pageCount, pageItemIds, roots, type CategoryNode, type Item,
} from '../lib/items';
import { kartenName, kategorieTitel, kategorienSortiert } from '../lib/itemKategorien';
import { categorySeo } from '../lib/itemSeo';
import { versioned } from '../lib/assetVersion';

interface Props { node: CategoryNode; page: number; lang: Locale }
const { node, page, lang } = Astro.props;

const t = itemT(lang);
const pages = pageCount(node);
const seo = categorySeo(node.cat, node.items.length, page, pages, lang);
const slice = node.items.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const siblings = kategorienSortiert(roots.find((r) => r.root === node.root)?.nodes ?? [], node.root, lang);
// Lesbarer Name statt des Datenschluessels („Helme“ statt „Helmets“,
// „Unterlauf“ statt „BottomAttachment“); die Adresse bleibt der Schluessel.
const titel = kategorieTitel(node.cat, lang);
const gruppe = categoryLabel(node.root, lang);
const mitGruppe = node.cat === node.root ? titel : `${titel} (${gruppe})`;

// Kennzahlen im Seitenkopf. „Wie viele davon kann ich ueberhaupt kaufen und
// was ist das guenstigste" ist die Frage, mit der man auf einer Kategorie
// landet — die Gesamtzahl allein beantwortet sie nicht.
const prices = node.items.map(minPrice).filter((p): p is number => p != null);
const buyable = prices.length;
const cheapest = prices.length > 0 ? Math.min(...prices) : null;

// Woher ein gezeigter Preis kommt: UEX, ausser bei Shop-Zeilen aus dem eigenen
// Schnappschuss (src, nur wo UEX das Item nicht fuehrt). Jede Preisangabe
// traegt ihre Marke, der Datenstand nennt genau die Quellen der Seite.
type Bezug = Item['obtain'][number];
const preisQ = (o: Bezug) => (o.src === 'schnappschuss' ? 'shop-schnappschuss' : 'uex-items');
// Die Zeile hinter minPrice: niedrigster Preis > 0, bei Gleichstand die erste.
const minZeile = (i: Item): Bezug | undefined => {
  let best: Bezug | undefined;
  for (const o of i.obtain) if (o.price != null && o.price > 0 && (best?.price == null || o.price < best.price)) best = o;
  return best;
};
const cheapestZeile = node.items.map(minZeile).find((o) => o?.price === cheapest);
const zeigtPreisQ = new Set([
  ...(cheapestZeile ? [preisQ(cheapestZeile)] : []),
  ...slice.map(minZeile).filter((o): o is Bezug => !!o).map(preisQ),
]);

// Die Bezugsspalte zeigt je Item die erste Bezugszeile. Ist das ein Loot-Ort,
// stammt er aus der eigenen Recherche, und der Datenstand nennt die Fundorte
// (bis zur Review-Korrektur stand hier pauschal `fundorte: false`). Die Marke
// data-stand-q haelt verify:patch-angaben [6] gegen die Zeilen des Bausteins.
const standQ = (o: Bezug | undefined) =>
  !o ? undefined : o.src === 'schnappschuss' ? 'shop-schnappschuss'
  : o.kind === 'shop' || o.kind === 'vehicle' ? 'uex-items'
  : o.kind === 'loot' ? (o.ort ? 'fundorte-spiel' : 'fundorte') : undefined;
const lootZuerst = slice.some((i) => i.obtain[0]?.kind === 'loot' && !i.obtain[0].ort);
const lootBestaetigtZuerst = slice.some((i) => i.obtain[0]?.kind === 'loot' && !!i.obtain[0].ort);
const bezugQ = new Set(slice.map((i) => standQ(i.obtain[0])));

// Filterfeld ueber der Liste (UX-Audit HE B16): filtert die gezeigte Seite,
// bei mehreren Seiten fuehrt ein Link mit derselben Suche in den Item Finder.
const filterJs = versioned('assets/kategorie-filter.js', '/assets/kategorie-filter.js');

const crumbs = [
  { label: t('breadcrumbItems'), href: itemsHubPath },
  { label: titel, href: pages > 1 && page > 1 ? categoryPath(node) : undefined },
  ...(page > 1 ? [{ label: `${t('page')} ${page}` }] : []),
];

// Erste Bezugszeile wie auf dem Datenblatt beschriftet (obtainLabel): eine
// Exklusiv-Zeile traegt im Feld `loc` den englischen Satz der Datenquelle.
// Bis 04.11.2026 stand er hier roh — auf den deutschen Kategorielisten also
// "Promotional item — not obtainable in-game".
const sourceLabel = (obtain: Item['obtain']) =>
  obtain.length ? (obtain.length > 1 ? `${obtainLabel(obtain[0], lang)} +${obtain.length - 1}` : obtainLabel(obtain[0], lang)) : t('noSourceData');
---
<DataShell
  lang={lang}
  title={seo.title}
  description={seo.description}
  crumbs={crumbs}
  eyebrow={(node.cat === node.root ? [t('sectionCategory')] : [gruppe, t('sectionCategory')]).join(' · ')}
  modified={db.generatedAt}
  stand={standItems(lang, {
    preise: zeigtPreisQ.has('uex-items') || bezugQ.has('uex-items'),
    schnappschuss: zeigtPreisQ.has('shop-schnappschuss') || bezugQ.has('shop-schnappschuss'),
    fundorte: lootZuerst,
    fundorteSpiel: lootBestaetigtZuerst,
  })}
>
  <h1 slot="hero">{titel}</h1>
  <p class="dp-lead" slot="hero">
    {fill(t('listingLead'), { n: num(node.items.length, lang), cat: mitGruppe, date: datumLang(db.pricesAsOf, lang) })}
  </p>

  <ul class="dp-keys" slot="hero">
    <li class="dp-key"><b>{t('entries')}</b><span>{num(node.items.length, lang)}</span></li>
    <li class="dp-key"><b>{t('kindBuy')}</b><span>{num(buyable, lang)}</span></li>
    {cheapest != null && cheapestZeile && <li class="dp-key" data-stand-q={preisQ(cheapestZeile)}><b>{t('cheapest')}</b><span>{auec(cheapest, lang)}</span></li>}
    <li class="dp-key"><b>{t('pricesAsOf')}</b><span>{datumLang(db.pricesAsOf, lang)}</span></li>
  </ul>

  <div class="dp-kf" data-kf hidden
    data-t-zahl={t('kfZahl')} data-t-alle={t('kfFinder')} data-finder={href('/item-finder.html', lang)}>
    <label class="dp-kf__l" for="dp-kf-q">{t('kfLabel')}</label>
    <input id="dp-kf-q" class="dp-kf__q" type="search" placeholder={t('kfPlatzhalter')} autocomplete="off" spellcheck="false" />
    <span class="dp-kf__n" data-kf-n aria-live="polite"></span>
    {pages > 1 && <a class="dp-kf__alle" data-kf-alle hidden href={href('/item-finder.html', lang)}></a>}
  </div>

  <div class="dp-tablewrap vb-scrollbox" tabindex="0" role="region" aria-label={t('tableRegion')}>
    <table class="dp-table dp-table--liste">
      <thead>
        <tr>
          <th>{t('thItem')}</th>
          <th>{t('thSources')}</th>
          <th class="dp-num">{t('thFrom')}</th>
          <th class="dp-num">{t('thAvg')}</th>
        </tr>
      </thead>
      <tbody>
        {slice.map((i) => {
          const p = minPrice(i);
          const pz = minZeile(i);
          const avg = avgPrice(i);
          const linked = pageItemIds.has(i.id);
          return (
            <tr>
              <td>
                {linked
                  ? <a href={href(itemPath(i), lang)}>{displayName(i, lang)}</a>
                  : <span title={t('listingNoPage')}>{displayName(i, lang)}</span>}
              </td>
              <td data-stand-q={standQ(i.obtain[0])}>{sourceLabel(i.obtain)}</td>
              <td class="dp-num" data-th={t('thFrom')}>
                {p != null && pz ? <span class="dp-price" data-stand-q={preisQ(pz)}>{auec(p, lang)}</span> : <span class="dp-muted">—</span>}
              </td>
              <td class="dp-num" data-th={t('thAvg')} data-leer={avg == null ? '' : undefined}>
                <span class="dp-muted">{avg != null ? auec(avg, lang) : '—'}</span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {pages > 1 && (
    <nav class="dp-pager" aria-label={t('pagination')}>
      {page > 1 && <a href={href(categoryPath(node, page - 1), lang)} rel="prev">{t('prevPage')}</a>}
      {Array.from({ length: pages }, (_, n) => n + 1).map((n) =>
        n === page
          ? <span aria-current="page">{n}</span>
          : <a href={href(categoryPath(node, n), lang)}>{n}</a>
      )}
      {page < pages && <a href={href(categoryPath(node, page + 1), lang)} rel="next">{t('nextPage')}</a>}
    </nav>
  )}

  {siblings.length > 1 && (
    <section class="dp-sec" style="margin-top:2.4rem">
      <h2>{categoryLabel(node.root, lang)}</h2>
      <ul class="dp-cards">
        {siblings.filter((s) => s.slug !== node.slug).map((s) => (
          <li>
            <a class="dp-card dp-card--cat" href={href(categoryPath(s), lang)}>
              <strong>{kartenName(s.cat, lang, false)}</strong>
              <em>{num(s.items.length, lang)}</em>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script is:inline src={filterJs} defer></script>

  <div class="dp-actions">
    <a class="dp-btn dp-btn--ghost" href={href(itemsHubPath, lang)}>{t('backToHub')}</a>
    <a class="dp-btn dp-btn--ghost" href={href('/item-finder.html', lang)}>{t('backToFinder')}</a>
  </div>
</DataShell>
