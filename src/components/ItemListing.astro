---
// Kategorie-Liste — die Bruecke zwischen Hub und Datenblatt.
//
// Sie listet ALLE Eintraege der Kategorie, auch die ohne eigene Seite: so ist
// jeder Item-Name irgendwo im HTML auffindbar, ohne dass fuer jeden Katalog-
// Rest eine eigene, leere URL entsteht.
import DataShell from './DataShell.astro';
import { standItems, datumLang } from '../lib/datenstand';
import { href, type Locale } from '../i18n/ui';
import { itemT, obtainLabel, fill, categoryLabel } from '../i18n/itemText';
import {
  PER_PAGE, auec, avgPrice, categoryPath, db, displayName, itemPath, itemsHubPath,
  leafCategory, midCategory, minPrice, num, pageCount, pageItemIds, roots, type CategoryNode, type Item,
} from '../lib/items';
import { categorySeo } from '../lib/itemSeo';

interface Props { node: CategoryNode; page: number; lang: Locale }
const { node, page, lang } = Astro.props;

const t = itemT(lang);
const pages = pageCount(node);
const seo = categorySeo(node.cat, node.items.length, page, pages, lang);
const slice = node.items.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const siblings = roots.find((r) => r.root === node.root)?.nodes ?? [];

// Kennzahlen im Seitenkopf. „Wie viele davon kann ich ueberhaupt kaufen und
// was ist das guenstigste" ist die Frage, mit der man auf einer Kategorie
// landet — die Gesamtzahl allein beantwortet sie nicht.
const prices = node.items.map(minPrice).filter((p): p is number => p != null);
const buyable = prices.length;
const cheapest = prices.length > 0 ? Math.min(...prices) : null;

// Die Bezugsspalte zeigt je Item die erste Bezugszeile. Ist das ein Loot-Ort,
// stammt er aus der eigenen Recherche, und der Datenstand nennt die Fundorte
// (bis zur Review-Korrektur stand hier pauschal `fundorte: false`). Die Marke
// data-stand-q haelt verify:patch-angaben [6] gegen die Zeilen des Bausteins.
const standQ = (k: string | undefined) => (k === 'shop' || k === 'vehicle' ? 'uex-items' : k === 'loot' ? 'fundorte' : undefined);
const lootZuerst = slice.some((i) => i.obtain[0]?.kind === 'loot');

const crumbs = [
  { label: t('breadcrumbItems'), href: itemsHubPath },
  { label: leafCategory(node.cat), href: pages > 1 && page > 1 ? categoryPath(node) : undefined },
  ...(page > 1 ? [{ label: `${t('page')} ${page}` }] : []),
];

// Erste Bezugszeile wie auf dem Datenblatt beschriftet (obtainLabel): eine
// Exklusiv-Zeile traegt im Feld `loc` den englischen Satz der Datenquelle.
// Bis 04.11.2026 stand er hier roh — auf den deutschen Kategorielisten also
// "Promotional item — not obtainable in-game".
const sourceLabel = (obtain: Item['obtain']) =>
  obtain.length ? (obtain.length > 1 ? `${obtainLabel(obtain[0], lang)} +${obtain.length - 1}` : obtainLabel(obtain[0], lang)) : t('noSourceData');
---
<DataShell
  lang={lang}
  title={seo.title}
  description={seo.description}
  crumbs={crumbs}
  eyebrow={[categoryLabel(node.root, lang), midCategory(node.cat), t('sectionCategory')].filter(Boolean).join(' · ')}
  modified={db.generatedAt}
  stand={standItems(lang, { preise: buyable > 0, fundorte: lootZuerst })}
>
  <h1 slot="hero">{leafCategory(node.cat)}</h1>
  <p class="dp-lead" slot="hero">
    {fill(t('listingLead'), { n: num(node.items.length, lang), cat: node.cat, date: datumLang(db.pricesAsOf, lang) })}
  </p>

  <ul class="dp-keys" slot="hero">
    <li class="dp-key"><b>{t('entries')}</b><span>{num(node.items.length, lang)}</span></li>
    <li class="dp-key"><b>{t('kindBuy')}</b><span>{num(buyable, lang)}</span></li>
    {cheapest != null && <li class="dp-key" data-stand-q="uex-items"><b>{t('cheapest')}</b><span>{auec(cheapest, lang)}</span></li>}
    <li class="dp-key"><b>{t('pricesAsOf')}</b><span>{datumLang(db.pricesAsOf, lang)}</span></li>
  </ul>

  <div class="dp-tablewrap vb-scrollbox" tabindex="0" role="region" aria-label={t('tableRegion')}>
    <table class="dp-table">
      <thead>
        <tr>
          <th>{t('thItem')}</th>
          <th>{t('thSources')}</th>
          <th class="dp-num">{t('thFrom')}</th>
          <th class="dp-num">{t('thAvg')}</th>
        </tr>
      </thead>
      <tbody>
        {slice.map((i) => {
          const p = minPrice(i);
          const avg = avgPrice(i);
          const linked = pageItemIds.has(i.id);
          return (
            <tr>
              <td>
                {linked
                  ? <a href={href(itemPath(i), lang)}>{displayName(i, lang)}</a>
                  : <span title={t('listingNoPage')}>{displayName(i, lang)}</span>}
              </td>
              <td data-stand-q={standQ(i.obtain[0]?.kind)}>{sourceLabel(i.obtain)}</td>
              <td class="dp-num">
                {p != null ? <span class="dp-price">{auec(p, lang)}</span> : <span class="dp-muted">—</span>}
              </td>
              <td class="dp-num">
                <span class="dp-muted">{avg != null ? auec(avg, lang) : '—'}</span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {pages > 1 && (
    <nav class="dp-pager" aria-label={t('pagination')}>
      {page > 1 && <a href={href(categoryPath(node, page - 1), lang)} rel="prev">{t('prevPage')}</a>}
      {Array.from({ length: pages }, (_, n) => n + 1).map((n) =>
        n === page
          ? <span aria-current="page">{n}</span>
          : <a href={href(categoryPath(node, n), lang)}>{n}</a>
      )}
      {page < pages && <a href={href(categoryPath(node, page + 1), lang)} rel="next">{t('nextPage')}</a>}
    </nav>
  )}

  {siblings.length > 1 && (
    <section class="dp-sec" style="margin-top:2.4rem">
      <h2>{categoryLabel(node.root, lang)}</h2>
      <ul class="dp-cards">
        {siblings.filter((s) => s.slug !== node.slug).map((s) => (
          <li>
            <a class="dp-card dp-card--cat" href={href(categoryPath(s), lang)}>
              {midCategory(s.cat) && <span class="dp-card-path">{midCategory(s.cat)}</span>}
              <strong>{leafCategory(s.cat)}</strong>
              <em>{num(s.items.length, lang)}</em>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="dp-actions">
    <a class="dp-btn dp-btn--ghost" href={href(itemsHubPath, lang)}>{t('backToHub')}</a>
    <a class="dp-btn dp-btn--ghost" href={href('/item-finder.html', lang)}>{t('backToFinder')}</a>
  </div>
</DataShell>
