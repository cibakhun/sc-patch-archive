---
// Schlanke Huelle fuer die MASSEN-Seiten der Datenschicht (Item-Datenblaetter,
// Blueprint-Seiten, Kategorie-Listen).
//
// Warum nicht SiteNav wie ueberall sonst: das volle Nav-Deck plus Such-Overlay
// sind ~18 KB Markup und ~19 KB inline-JS PRO Seite. Bei ~14.000 generierten
// Seiten waeren das ~500 MB HTML im Build — fuer Seiten, deren eigener Inhalt
// 3–8 KB gross ist. Diese Huelle traegt dieselbe Identitaet (Farben, Typo,
// Sprachumschalter, Rechtliches), kostet aber ~1,5 KB.
//
// JavaScript: genau EINE externe Datei, assets/back-link.js (~1,4 KB, defer,
// inhaltsgehasht und damit dauerhaft gecacht). Sie wertet die letzte Brotkrume
// zu history.back() auf, wenn man nachweislich von dort kommt. Das widerspricht
// dem urspruenglichen „ohne eigenes JavaScript" nur dem Wortlaut nach, nicht
// dem Grund dafuer: geaechtet waren ~19 KB INLINE-JS pro Seite, die sich mit
// jeder der ~14.000 Seiten multiplizieren. Eine gecachte Datei tut das nicht.
//
// Alles Wiederkehrende (Layoutregeln) liegt in der EINEN externen Datei
// /assets/data-page.css, die keinen einzigen Hex-Wert enthaelt; die eine
// Farbpalette steht inline als :root-Block (unten). Der Ton-Tausch Items/
// Crafting laeuft nicht ueber die Palette, sondern ueber data-tone und
// --tone-1/--tone-2 in data-page.css.
import Layout from '../layouts/Layout.astro';
import { versioned } from '../lib/assetVersion';
import { SITE, DISCORD } from '../consts';
import { href, pathForLocale, useTranslations, LOCALE_SHORT, HTML_LANG, type Locale } from '../i18n/ui';
import { jsonForScript } from '../lib/safeJson';
import { bereiche, bereichVon, dienste, krumen, recht, ziel } from '../lib/bereiche';
import Datenstand from './Datenstand.astro';
import type { StandZeile } from '../lib/datenstand';

export interface Crumb {
  label: string;
  /** Basisform (EN-Pfad); wird fuer DE automatisch praefixt. Fehlt = aktuelle Seite. */
  href?: string;
}

interface Props {
  lang: Locale;
  title: string;
  description: string;
  crumbs: Crumb[];
  /** kleiner Kicker ueber der H1 */
  eyebrow?: string;
  /** violett (Items) oder bernstein (Crafting) */
  tone?: 'items' | 'craft';
  ogImage?: string;
  /** Datenstand fuer ItemPage-JSON-LD (dateModified) */
  modified?: string;
  /** Name des beschriebenen Dings im ItemPage-LD (sonst steht der ganze <title> drin) */
  ldName?: string;
  /** zusaetzliche JSON-LD-Knoten (z. B. Product) */
  jsonLd?: Record<string, unknown>[];
  /**
   * Datenstand am Seitenende (src/lib/datenstand.ts): je Wertegruppe Herkunft
   * und Stand. Pflicht — seit 06.11.2026 ersetzt er die Quellen-Zeile im
   * Fuss, die nur eine Quelle und das Preisdatum kannte.
   */
  stand: StandZeile[];
  /** Detailseite: im Datenstand der Link „Falschen Wert melden“ */
  melden?: boolean;
  /**
   * Uebersicht mit Kachel-/Chip-Raster: die Spalte darf auf breiten Schirmen
   * mitwachsen (theme.css § 5, --vb-breit). Nur fuer Seiten, deren Breite in
   * RASTERN steckt — Fliesstext haelt hier ohnehin 68–72ch, Tabellen aber
   * nicht. Detail- und Listenseiten bleiben deshalb bei 1080 px.
   */
  breit?: boolean;
}

const {
  lang, title, description, crumbs, eyebrow, tone = 'items',
  ogImage, modified, ldName, jsonLd = [], stand, melden = false, breit = false,
} = Astro.props;

const t = useTranslations(lang);
const base = SITE.url.replace(/\/$/, '');

// Cache-Busting fuer /assets/data-page.css: feste URL, von Cloudflare 1 Tag
// gecacht (nginx-Map: text/css -> 1d). Ohne Content-Hash im Query lieferte die
// Edge nach einem Deploy bis zu 24 h die ALTE Datei — genau das ist nach dem
// box-sizing-Fix passiert (cf-cache-status HIT, age 6213). Gleiche Technik wie
// /assets/account-lite.js (SiteNav) und /assets/archive.js (PatchArchive).
// Der Hash wird pro Prozess EINMAL berechnet, nicht pro Seite: diese Huelle
// rendert ~17.000 Mal.
const cssHref = versioned('assets/data-page.css', '/assets/data-page.css');
const other: Locale = lang === 'de' ? 'en' : 'de';
const otherHref = pathForLocale(Astro.url.pathname, other);

// Die Brotkrumenspur ist hier die EINZIGE Elternnavigation — die SiteNav-
// Seiten bekommen dafuer ein eigenes Zurueck-Element, diese Huelle bewusst
// nicht (zwei Angebote nebeneinander waeren eines zu viel). JEDE Krume mit
// href traegt data-backlink: back-link.js vergleicht pro Element den
// Referrer-Pfad mit dessen eigenem data-back-path und macht daraus
// automatisch genau die Krume zum history.back(), aus der der Nutzer
// nachweislich kam — Scrollposition der jeweiligen Liste zurueck. Diese
// Listen sind bis zu 7 Bildschirme lang, ein normaler Klick landet wieder
// ganz oben. Beschriftungen werden dabei NIE umgeschrieben, nur breiter
// markiert. Gemessen: 4200 px vorher, 4200 px nachher.
//
// Seit UX-Audit A2 laedt die Huelle back-link.js immer: es schliesst auch das
// Menue (Esc, Klick daneben) und stellt „Anmelden“ auf „Konto“, wenn eine
// Sitzung im Browser liegt — ohne account-lite.js (40 KB) auf jede der
// ~17.000 Seiten zu legen.
const backLinkSrc = versioned('assets/back-link.js', '/assets/back-link.js');

// Suche (seit 06.11.2026): ein Knopf in der Kopfleiste, sonst nichts im HTML.
// assets/data-search.js (klein, gecacht) baut das Overlay erst beim Antippen
// und laedt dann Logik und Aussehen nach — dieselben Dateien wie die Seiten
// mit voller Navigation (assets/search-overlay.js/.css). Texte und Index-
// Adressen holt es dann aus /search-ui.json (src/lib/searchUi.ts) — am Knopf
// stehen nur drei Adressen, damit jede Seite so wenig wie moeglich mehr traegt.
const searchBoot = versioned('assets/data-search.js', '/assets/data-search.js');
const searchJs = versioned('assets/search-overlay.js', '/assets/search-overlay.js');
const searchCss = versioned('assets/search-overlay.css', '/assets/search-overlay.css');
const searchUi = href('/search-ui.json', lang);

// Fuss: Ziele und Namen aus der Bereichsliste (src/lib/bereiche.ts). Vorher
// stand hier „Preise & Fundorte“ fuer das Item-Verzeichnis und „Blaupausen &
// Planer“ fuer das Blueprint-Verzeichnis — im Menue die Unterzeilen von Item
// Finder und Werkbank, also zwei Namen fuer je zwei Ziele (UX-Audit A4).
const fussZiele = ['finder', 'items', 'blueprints', 'schiffe', 'missionen'].map((k) => ziel(k, lang));
const fussRecht = [...recht(lang), ziel('feedback', lang), ziel('support', lang)];

// Brotkrumen nach der Bereichsliste (UX-Audit A3, krumen() in
// src/lib/bereiche.ts): Bereich › Seite › was die Seite darunter nennt. Die
// Seiten reichen ihre Krumen unveraendert durch (Basisform, EN-Pfad); die
// Spur kommt mit fertigen Adressen in der Sprache der Seite zurueck.
const trail = krumen(Astro.url.pathname, crumbs, lang);

// Breadcrumb-JSON-LD: gibt der Trefferzeile in Google den Pfad statt der nackten
// URL — und macht die Kategorie-Ebene als eigenes Ziel sichtbar. Dieselbe
// Wurzel wie auf den Seiten mit voller Navigation (SiteNav).
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: t('nav.home'), href: lang === 'en' ? '/' : href('/index.html', lang) },
    ...trail.map((c) => ({ name: c.label, href: c.href })),
  ].map((c, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: c.name,
    ...(c.href ? { item: base + c.href } : {}),
  })),
};

// Bereichsleiste und Menue (UX-Audit A2): dieselben Bereiche und Namen wie
// die volle Navigation, aus der einen Liste. Die Leiste zeigt ab 1200 px je
// Bereich einen Eintrag; das Menue (alle Breiten) jede Seite je Bereich,
// dazu Konto & Service und die Sprache. Bewusst nur Namen, keine Unterzeilen
// und Glyphen: die Huelle rendert ~17.000 Mal.
const hier = bereichVon(Astro.url.pathname);
const alleBereiche = bereiche(lang);
const leiste = alleBereiche.map((b) => ({ key: b.key, href: b.href, label: b.kurz, current: hier?.bereich === b.key }));
const dienstZiele = dienste(lang);
const SPRACHE: Record<Locale, string> = { de: 'Deutsch', en: 'English' };
const loginHref = href('/account/login.html', lang);
const kontoHref = href('/account.html', lang);
---
<Layout
  title={title}
  description={description}
  themeColor="#0d0c14"
  ogType="article"
  ogImage={ogImage ?? '/assets/cz-loot.jpg'}
  translated={true}
  itemPage={{ modified, name: ldName }}
>
  <link slot="head" rel="stylesheet" href={cssHref} />
  <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(crumbLd)} />
  {jsonLd.map((node) => (
    <script slot="head" type="application/ld+json" is:inline set:html={jsonForScript(node)} />
  ))}
  <style is:inline>
:root{--bg:#0d0c14;--bg-2:#14121c;--surface:#17151f;--surface-2:#1e1b29;--accent:#A78BFA;--accent-2:#FFB84D;--hot:#A78BFA;--text:#eef1f5;--muted:#9d9cb0;--line:rgba(167,139,250,.22);--line-soft:rgba(238,241,245,.10);--glow:0 0 44px rgba(167,139,250,.28);--ink:#0d0c14;--maxw:1080px;}
  </style>

  <a class="dp-skip" href="#main">{t('skip.toContent')}</a>

  <div class="dp" data-tone={tone} data-breit={breit ? '' : undefined}>
    <header class="dp-bar">
      <a class="dp-home" href={href('/index.html', lang)} aria-label={t('nav.home.aria')}>VerseBase</a>
      {/* Reihenfolge im DOM = Tab-Reihenfolge: Wortmarke, Bereiche, Suche,
          Sprache, Konto, Discord, Menue, dann der Pfad. Startlink, Suchknopf,
          Sprachschalter und Pfad bleiben DIREKTE Kinder der Leiste: das
          Hangar-Terminal blendet sie ueber `.dp-bar>…` aus (TERM_CSS,
          verify:hangar-orte [4]). Alles Neue blendet data-page.css dort aus. */}
      <ul class="dp-areas" role="list" aria-label={t('nav.areas')}>
        {leiste.map((b) => (
          <li><a href={b.href} data-area={b.key} aria-current={b.current ? 'true' : undefined}>{b.label}</a></li>
        ))}
      </ul>
      <button
        type="button"
        class="dp-search"
        data-scs-boot
        data-js={searchJs}
        data-css={searchCss}
        data-ui={searchUi}
        aria-label={t('search.button')}
        aria-keyshortcuts="Control+K"
      ><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.2-4.2"/></svg></button>
      <a class="dp-lang" href={otherHref} hreflang={HTML_LANG[other]} rel="alternate">{LOCALE_SHORT[other]}</a>
      <a class="dp-acct" href={loginHref} data-dp-acct data-in={kontoHref} data-l-in={t('nav.account')}>{t('nav.account.login')}</a>
      <a class="dp-discord" href={DISCORD.invite} target="_blank" rel="noopener noreferrer" aria-label={t('nav.discord.aria')}></a>
      <details class="dp-menu">
        <summary aria-label={t('nav.menu.open')}><span class="dp-menu__icon" aria-hidden="true"></span><span class="dp-menu__txt">{t('nav.menu')}</span></summary>
        <nav class="dp-menu__panel" aria-label={t('nav.main')}><div class="dp-menu__cols">
          {alleBereiche.map((b) => (
            <div class="dp-menu__grp">
              <p class="dp-menu__h">{b.name}</p>
              <ul role="list">
                {b.seiten.map((z) => (
                  <li><a href={z.href} aria-current={hier?.seite === z.key ? 'true' : undefined}>{z.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="dp-menu__grp">
            <p class="dp-menu__h">{t('nav.deck.grp.account')}</p>
            <ul role="list">
              {dienstZiele.map((z) => (
                z.key === 'konto'
                  ? <li><a href={loginHref} data-dp-acct data-in={kontoHref} data-l-in={t('nav.account')}>{z.name}</a></li>
                  : z.extern
                    ? <li><a href={z.href} target="_blank" rel="noopener noreferrer">{z.name}</a></li>
                    : <li><a href={z.href}>{z.name}</a></li>
              ))}
              <li><a href={otherHref} hreflang={HTML_LANG[other]} lang={HTML_LANG[other]} rel="alternate">{SPRACHE[other]}</a></li>
            </ul>
          </div>
        </div></nav>
      </details>
      <nav class="dp-crumbs" aria-label={t('nav.path')} data-back-self={trail[trail.length - 1]?.label}>
        {trail.map((c, idx) => (
          <>
            {idx > 0 && <span class="dp-sep" aria-hidden="true">›</span>}
            {c.href ? (
              <a
                href={c.href}
                data-backlink
                data-back-path={c.href.split(/[?#]/)[0]}
              >{c.label}</a>
            ) : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    </header>

    <main id="main" class="dp-main">
      {/* Der Seitenkopf ist EIN Element: Kicker, Titel, Einleitung und die
          Kennzahlen sitzen zusammen in der Hero-Konsole. Die Seiten liefern
          ihre drei Teile ueber denselben benannten Slot (Astro erlaubt
          mehrere Kinder mit gleichem slot-Namen); der Kicker kommt weiter
          von hier, weil ihn alle sieben Seiten gleich aufbauen. */}
      <header class="dp-hero">
        {eyebrow && <p class="dp-eyebrow">{eyebrow}</p>}
        <slot name="hero" />
      </header>
      <slot />
      <Datenstand lang={lang} zeilen={stand} innen melden={melden} />
    </main>

    <footer class="dp-foot">
      <nav class="dp-foot-nav" aria-label={t('footer.pageNav')}>
        {fussZiele.map((z) => <a href={z.href}>{z.name}</a>)}
        <a href={href('/index.html', lang)}>{t('nav.home')}</a>
      </nav>
      <p class="dp-legal">{t('footer.disclaimer')}</p>
      <p class="dp-foot-nav dp-foot-legal">
        {fussRecht.map((z) => <a href={z.href}>{z.name}</a>)}
      </p>
    </footer>
  </div>
  <script is:inline src={backLinkSrc} defer></script>
  <script is:inline src={searchBoot} defer></script>
</Layout>
