---
// MiningWorkbench.astro — Drei-Spalten-Werkbank für das Mining-Thema.
//
// ZWEITE FASSUNG (11.08.2026). Die erste war zu duenn — Rueckmeldung des
// Nutzers woertlich: „super unpolished", „basic features", „sieht aus als
// hatte man es in 15 min gevibecoded". Beides zu Recht, und beides Folge
// meiner eigenen Entscheidungen:
//
//   · Die Mineralliste zeigte 6 von 37. Die Vorgabe lautete von Anfang an
//     „ALL the minerals listed on the left side" — ich hatte stattdessen auf
//     die Projektregel „Filterkonsole und ERSTE Ergebniszeile ueber der Falz"
//     optimiert. Jetzt: Kachelraster, alle 37 ohne Scrollen.
//   · Verarbeitung: In Skizze 004 standen drei Grade zur Wahl, gewaehlt wurde
//     der zurueckgenommenste. Im Mockup las sich das als Praezision, im
//     fertigen Produkt als unfertig — genau die Gegenprobe, die in
//     004/README.md als Bedingung notiert war. Die verworfene Verarbeitung
//     (Messgeraet, versenkte Wannen, Segmentbalken, Eckwinkel, Kante, Korn,
//     reicher Grund) ist jetzt drin.
//   · Substanz: die erste Fassung ERSETZTE Funktionen durch Zusammenfassungen.
//     Neu und aus denselben Spieldaten: welche Steine dieses Erz fuehren
//     (211 Kompositionen), welche der 20 Stationen am meisten dafuer zahlt,
//     Blueprint- und Schiffsbezug.
//
// ⚠ 12.08.2026 — KEIN FRACTURING MEHR HIER. Laser, Module, Gadget,
// Felsmasse, das Messgeraet, die Brechbarkeits-Punkte auf den Kacheln, der
// Filter „nur brechbar" und der Physikwert „effektiv" sind auf eine eigene
// Seite gezogen: components/FracturingCalc.astro auf /fracturing.html. Das
// war eine ausdrueckliche Entscheidung, keine Auslassung — diese Werkbank
// beantwortet „welches Erz, wo, was ist es wert?", der Rechner „krieg ich
// es auf?". Wer hier wieder ein Urteil einbaut, dreht das zurueck.
// Verbunden sind die beiden nur ueber ?mineral=<Name>, in beide Richtungen.
//
// FALLEN, die hier bewusst umgangen sind:
//  · Astro 5.18 verschluckt das schliessende Tag, wenn ein Element auf
//    OBERSTER Template-Ebene einen {ausdruck} als Kind hat -> set:text.
//  · `:global()` ist in `<style is:inline>` kein CSS und wird still verworfen.
//  · KEINE eigenen Farbtoken: build-light-palettes.mjs kennt nur eine feste
//    Namensliste (theme-color.mjs:194ff) und ignoriert alles andere still.
//    Alle Flaechen kommen aus den bestehenden Token, Zwischenstufen ueber
//    color-mix. Zustandsfarben ueber `currentColor` + `color`, weil
//    build-light-overrides.mjs:85 zwar `color` abdeckt, aber NICHT
//    `background`.
//  · KEIN `clip-path` auf Paneelen: die Paarung clip-path ueber
//    backdrop-filter drueckte den Menue-Eintritt schon einmal auf 840 ms.
//    Die angeschraegte Ecke entsteht aus einem Pseudo-Element mit Verlauf.
//  · id="db" ist PFLICHT: miningLinks.ts:129 erzeugt aus der Crafting-DB
//    ueber 8000 Tieflinks der Form ?mineral=<Name>#db.
//  · Jeder innen scrollende Kasten muss in die Selektorliste in
//    assets/mobile-ux.css, sonst blendet theme.css seine Leiste aus.
import DB from '../../assets/mining-db.json';
import MODEL from '../../assets/mining-model.json';
import ToolHelp from './ToolHelp.astro';
import { versioned } from '../lib/assetVersion';
import { blueprintsPerMineral, craftingPath } from '../lib/miningLinks';
import { buildMiningShips } from '../lib/miningShips';
import { href } from '../i18n/ui';
import { useHelp, type HelpKey } from '../i18n/help';

/* Titelstreifen der Seite ist ins Gehaeuse gewandert (15.08.2026): das Kopfband
   der Grafik traegt ihn, und dadurch faellt der separate `.hero` weg — genau
   die Hoehe, die der Rahmen sonst zusaetzlich kosten wuerde. Die Texte kommen
   weiterhin von der Seite, damit die <h1> dort bleibt, wo der Inhalt lebt. */
interface Props {
  lang: 'de' | 'en';
  title: string;
  eyebrow: string;
  /* Optional seit 16.08.2026 — s. die Begruendung an der Rendering-Stelle. */
  lead?: string;
}
const { lang, title, eyebrow, lead } = Astro.props;
const de = lang === 'de';
/* Stufe 2 des Werkzeug-Hilfe-Vertrags. Fehlte in der zweiten Fassung
   vollstaendig: 0 data-help gegen 8-10 in jedem anderen Werkzeug, und der
   Knopf „Elemente erklaeren" hob deshalb nur die drei Anker des
   RefineryFinders weit unterhalb hervor. verify:help sah es nicht, weil
   Zusicherung 6 pro SEITE zaehlte statt pro Werkzeug. */
const h = useHelp(lang);
const hlp = (k: string) => h(`mining.ctl.${k}` as HelpKey);

const elemByName: Record<string, any> = {};
for (const e of (MODEL.elements as any[])) elemByName[e.name] = e;

const RAR_ORDER = ['legendary', 'epic', 'rare', 'uncommon', 'common'];
const rarIdx = (r: string | null) => {
  const i = RAR_ORDER.indexOf(r || '');
  return i < 0 ? RAR_ORDER.length : i;
};

/* Ertragsprofile: fuer jedes Erz die Stationen nach Aufschlag sortieren.
   Das ist die Antwort auf „wo bringe ich DAS hin?" und stand bisher nirgends. */
const refineries = (MODEL.refineries as any[]).map((r) => ({ n: r.name, s: r.system, p: r.profileId }));
const profiles = MODEL.refineryProfiles as Record<string, Record<string, number>>;

const minerals = (DB.minerals as any[])
  .map((m) => {
    const e = elemByName[m.name] || {};
    return {
      name: m.name, code: m.code, kind: m.kind,
      rarity: m.rarity || null, method: m.method, methods: m.methods || [],
      refine: !!m.needs_refine, systems: m.systems || [], scu: m.weight_scu,
      // ms = hoechster Massenanteil ("bis X %"), ef = Erwartungswert des Anteils.
      // ef rangiert die Fundorte; ms allein taugt dafuer nicht, weil es je Erz oft
      // an allen Fundorten identisch ist.
      locs: (m.locations || []).map((l: any) => ({
        // `pt` = die realen Anflugpunkte. "Lagrange D" ist fuer sich keine
        // Ortsangabe — angeflogen werden ARC-L3, CRU-L5, MIC-L4. Das Feld lag
        // in den Daten (68 Paare) und wurde hier bisher fallen gelassen.
        p: l.location, s: l.system, t: l.type, mi: l.mining, ms: l.maxShare, ch: l.chance, ef: l.eff,
        pt: l.points || null,
      })),
      sig: e.scanSignature || null,
      bp: blueprintsPerMineral[m.name] || 0,
    };
  })
  .sort((a, b) => rarIdx(a.rarity) - rarIdx(b.rarity) || a.name.localeCompare(b.name));

const sel = minerals[0];
const RAR_LBL: Record<string, { de: string; en: string }> = {
  legendary: { de: 'legendär', en: 'legendary' }, epic: { de: 'episch', en: 'epic' },
  rare: { de: 'selten', en: 'rare' }, uncommon: { de: 'ungewöhnlich', en: 'uncommon' },
  common: { de: 'häufig', en: 'common' },
};
const rarLbl = (r: string | null) => (r && RAR_LBL[r] ? RAR_LBL[r][lang] : de ? 'ohne Stufe' : 'no tier');

/* ───────────── Kachelliste: nach Abbauart, darin nach Qualitätsstufe ─────────
   16.08.2026, auf Ansage: die Liste warf Schiff-, ROC- und Hand-Mining in
   EINEN Topf, und die Stufe (legendär/episch/…) stand nur im Kopf des gerade
   gewählten Erzes — man musste 37 Kacheln durchklicken, um sie zu erfahren.

   Zwei Ebenen, beide aus den Daten:
     1. Abbauart — welche Ausrüstung macht den Stein auf.
     2. Qualitätsstufe — als eigene Bandüberschrift, nicht als Farbe allein.
        Eine Farbe MUSS man erst lernen; die Überschrift steht da und sortiert
        das Band gleich mit. Der farbige Kachelrand ist die Wiederholung, nicht
        der Träger der Aussage.

   ⚠ Ein Erz kann in ZWEI Gruppen stehen: Carinite trägt Kompositionen für das
   Multitool UND für den ROC (siehe scripts/build-mining-db.mjs). Es bekommt
   deshalb in beiden Gruppen eine Kachel — die Frage „was kann ich mit meinem
   ROC abbauen?" wäre sonst falsch beantwortet. Beide Kacheln tragen dasselbe
   data-min; renderList() in assets/mining-workbench.js läuft über
   querySelectorAll und hält damit Auswahl- und Anheft-Zustand auf allen
   Kacheln gleich. Der Zähler zählt deshalb NAMEN, nicht Kacheln.

   ⚠ Die elf Hand-/ROC-Erze haben keine Stufe — sie stehen unter „ohne Stufe".
   Das ist kein fehlender Wert, den man noch nachtragen könnte: das Spiel
   vergibt Stufen nur an die 26 Schiff-Erze. */
const METHOD_ORDER = ['ship', 'roc', 'hand'] as const;
const BAND_ORDER = ['legendary', 'epic', 'rare', 'uncommon', 'common', 'none'];
const GRP_LBL: Record<string, { de: string; en: string }> = {
  ship: { de: 'Schiff-Mining', en: 'Ship mining' },
  roc: { de: 'ROC / Bodenfahrzeug', en: 'ROC / ground vehicle' },
  hand: { de: 'Hand-Mining', en: 'Hand mining' },
};
const GRP_GEAR: Record<string, string> = {
  ship: 'Prospector · MOLE · Golem', roc: 'ROC · ROC-DS', hand: 'Multitool',
};
const methodsOf = (m: (typeof minerals)[number]) => (m.methods.length ? m.methods : m.method ? [m.method] : []);
const groups = METHOD_ORDER.map((id) => {
  const mine = minerals.filter((m) => methodsOf(m).includes(id));
  const bands = BAND_ORDER.map((band) => ({
    band,
    label: rarLbl(band === 'none' ? null : band),
    items: mine.filter((m) => (m.rarity || 'none') === band),
  })).filter((b) => b.items.length);
  /* Traegt eine Gruppe nur EIN Band, wandert dessen Beschriftung in die
     Gruppenzeile. Sonst stuende ueber den vier ROC-Erzen eine eigene Zeile
     „OHNE STUFE 4", die nichts sagt, was die Gruppenzeile nicht schon
     eingerahmt haette — zwei Ueberschriften fuer eine Reihe Kacheln. */
  const solo = bands.length === 1 ? bands[0].label : null;
  return { id, label: GRP_LBL[id][lang], gear: GRP_GEAR[id], total: mine.length, bands, solo };
}).filter((g) => g.total);

/* Bricht den Build ab, statt ein Mineral still aus der Liste fallen zu lassen.
   METHOD_ORDER ist eine feste Dreierliste; kaeme aus den Spieldaten je ein
   vierter Wert (etwa `harvest`), stuenden die betroffenen Erze in KEINER
   Gruppe — die Seite saehe heil aus und waere unvollstaendig. Genau diese
   Bauart hat das Projekt schon zweimal Erze gekostet. Vorbild:
   assertMiningLangParity() weiter unten. */
function assertEveryMineralGrouped(): void {
  const placed = new Set(groups.flatMap((g) => g.bands.flatMap((b) => b.items.map((m) => m.name))));
  const lost = minerals.filter((m) => !placed.has(m.name));
  if (lost.length) {
    throw new Error(
      `MiningWorkbench: ${lost.length} Mineral(e) in keiner Abbauart-Gruppe — ` +
        lost.map((m) => `${m.name} (methods: ${methodsOf(m).join(',') || 'keine'})`).join('; ') +
        `. Bekannte Gruppen: ${METHOD_ORDER.join(', ')}.`
    );
  }
}
assertEveryMineralGrouped();

/* Die zweite Fassung haengte `ships.slice(0,3)` an JEDES Erz — Prospector,
   MOLE und Golem standen also auch unter den elf Erzen, die sich gar nicht
   per Schiff abbauen lassen. Die Daten kennen vier Methoden: ship (26),
   roc (4), fps (4), hand (3). Ein Verweis erscheint nur noch da, wo das
   Fahrzeug die Methode auch bedient; Hand-Erze bekommen keinen. */
const shipsAll = buildMiningShips(lang);
const VEHICLE_FOR: Record<string, string[]> = {
  ship: ['misc-prospector', 'argo-mole', 'drak-golem'],
  roc: ['grin-roc', 'grin-roc-ds'],
};
const shipsByMethod: Record<string, any[]> = {};
for (const [meth, ids] of Object.entries(VEHICLE_FOR)) {
  shipsByMethod[meth] = ids
    .map((id) => shipsAll.find((s: any) => s.id === id))
    .filter(Boolean)
    .map((s: any) => ({ n: s.name, h: s.href, ore: s.ore }));
}

const fracturingPath = href('/fracturing.html', lang);

/* Gehaeuse-Grafik ueber versioned(): der sha1 haengt am Inhalt, nicht an einer
   hochgezaehlten `?v=`-Zahl — die Falle, die schon zweimal gecachte Assets
   ausgeliefert hat. */
const chassisFrame = versioned('assets/chassis-frame.webp', '/assets/chassis-frame.webp');
const chassisPlug = versioned('assets/chassis-plug.webp', '/assets/chassis-plug.webp');

/* Zwei benannte Konstanten statt eines `de ? {…} : {…}`-Ternarys: ein in nur
   einem Zweig vergessener Schluessel fiel bislang erst im Browser der ANDEREN
   Sprache auf. Die Pruefung darunter bricht das stattdessen beim Bauen ab —
   Vorbild und Begruendung: assertHelpParity() in src/i18n/help.ts, seit
   Phase 01.2 im selben Amt. */
const S_DE = {
  minerals: 'Minerale', view: 'Ansicht', signatures: 'Signaturen', locations: 'Fundorte',
  search: 'Mineral suchen',
  pinHint: 'Auf einer Erz-Kachel links den Anheft-Knopf drücken — oder oben am gewählten Erz „Anheften". Diese Spalte zeigt dann seine Signatur mal Clustergröße.',
  presets: 'Presets', presetNew: 'Neues Preset', presetSave: 'Speichern',
  presetDel: 'Löschen', presetName: 'Name des Presets', presetCancel: 'Abbrechen',
  presetRename: 'Umbenennen', presetRenamed: 'Umbenannt.', presetNameTaken: 'Dieser Name ist schon vergeben.',
  presetListEmpty: 'Noch kein Preset gespeichert. Erze oder Fundorte anheften, dann mit „+" benennen.',
  presetDelAsk: 'Wirklich löschen?', presetUpdAsk: 'Wirklich überschreiben?',
  presetUpdate: 'Mit der aktuellen Auswahl überschreiben', presetUpdated: 'Überschrieben.',
  presetShow: 'Inhalt anzeigen', presetHide: 'Inhalt ausblenden',
  presetRemoveEntry: 'Aus dem Preset entfernen', presetNoEntries: 'Dieses Preset ist leer.',
  presetGuest: 'Zusammenstellungen speichern:', presetLogin: 'anmelden',
  /* Eigenes Fenster (16.08.2026). „Popout" bleibt unuebersetzt stehen, weil
     es im Deutschen keinen kuerzeren Begriff gibt, der dasselbe meint —
     „Abdocken" waere geraten, „Eigenes Fenster" passt in keinen Knopf. */
  popout: 'Eigenes Fenster', popoutBack: 'Zurück in die Spalte',
  popoutOut: 'Die Listen liegen im eigenen Fenster.',
  popoutTitle: 'Signaturen & Fundorte — verse-base',
  popoutBlocked: 'Der Browser hat das Fenster blockiert. Popups für diese Seite erlauben, dann erneut.',
  presetSaved: 'Gespeichert.', presetDeleted: 'Gelöscht.',
  presetEmpty: 'Erst Erze oder Fundorte anheften, dann speichern.', presetFail: 'Speichern fehlgeschlagen.',
  signature: 'Signatur',
  station: 'Station', fracturing: 'Fracturing-Rechner', fracturingGo: 'Bricht der Brocken? →',
  none: '—', pin: 'Anheften', unpin: 'Lösen', noLocs: 'Keine Fundorte bekannt.',
  locPinsEmpty: 'Noch keine Fundorte angeheftet. Bei einem Erz mit Fundorten die Nadel neben einer Zeile drücken.',
  locPinsFull: 'Die Merkliste ist voll (128 Fundorte). Erst einen lösen, dann neu anheften.',
  ship: 'Schiff', hand: 'Hand', roc: 'ROC', refinable: 'raffinierbar',
  // Kachel-Abzeichen für ein Erz, das zwei Abbauarten trägt (nur Carinite).
  also: 'auch', tier: 'Stufe',
  chance: 'Chance', upTo: 'bis', yieldAvg: 'Ø-Anteil',
  tPlanet: 'Planet', tMoon: 'Mond', tBelt: 'Gürtel', tLagrange: 'Lagrange', tCluster: 'Cluster',
  tCave: 'Höhle', tEvent: 'Event', tSpecial: 'Sonderort',
  bestRef: 'Beste Stationen', yieldMod: 'Ertrag', worst: 'schlechteste', yourPick: 'deine Wahl',
  usedIn: 'Blueprints', ships: 'Schiffe', openCrafting: 'Crafting öffnen',
  // Phase 12: Fundort-Ansicht (D-01/D-11) — Zurueck-Knopf-Beschriftung und
  // das Spur-Abzeichen fuer Erze mit hoechstens 10 % Anteil (D-07).
  backToOre: 'Zurück zur Erz-Ansicht', trace: 'Spur',
};
const S_EN = {
  minerals: 'Minerals', view: 'View', signatures: 'Signatures', locations: 'Locations',
  search: 'Search mineral',
  pinHint: 'Hit the pin button on an ore tile at the left — or “Pin” above the selected ore. This column then shows its signature times cluster size.',
  presets: 'Presets', presetNew: 'New preset', presetSave: 'Save',
  presetDel: 'Delete', presetName: 'Preset name', presetCancel: 'Cancel',
  presetRename: 'Rename', presetRenamed: 'Renamed.', presetNameTaken: 'That name is already taken.',
  presetListEmpty: 'No preset saved yet. Pin ores or locations, then name one with the plus button.',
  presetDelAsk: 'Really delete?', presetUpdAsk: 'Really overwrite?',
  presetUpdate: 'Overwrite with the current selection', presetUpdated: 'Overwritten.',
  presetShow: 'Show contents', presetHide: 'Hide contents',
  presetRemoveEntry: 'Remove from preset', presetNoEntries: 'This preset is empty.',
  presetGuest: 'Save your sets:', presetLogin: 'sign in',
  popout: 'Own window', popoutBack: 'Back into the column',
  popoutOut: 'The lists are in their own window.',
  popoutTitle: 'Signatures & locations — verse-base',
  popoutBlocked: 'The browser blocked the window. Allow popups for this site, then try again.',
  presetSaved: 'Saved.', presetDeleted: 'Deleted.',
  presetEmpty: 'Pin some ores or locations first, then save.', presetFail: 'Saving failed.',
  signature: 'Signature',
  station: 'Station', fracturing: 'Fracturing calculator', fracturingGo: 'Will it break? →',
  none: '—', pin: 'Pin', unpin: 'Unpin', noLocs: 'No locations known.',
  locPinsEmpty: 'No locations pinned yet. On an ore with locations, hit the pin next to a row.',
  locPinsFull: 'The shortlist is full (128 locations). Unpin one before pinning another.',
  ship: 'Ship', hand: 'Hand', roc: 'ROC', refinable: 'refinable',
  // Tile badge for an ore that carries two mining methods (Carinite only).
  also: 'also', tier: 'Tier',
  chance: 'chance', upTo: 'up to', yieldAvg: 'avg share',
  tPlanet: 'Planet', tMoon: 'Moon', tBelt: 'Belt', tLagrange: 'Lagrange', tCluster: 'Cluster',
  tCave: 'Cave', tEvent: 'Event', tSpecial: 'Special',
  bestRef: 'Best stations', yieldMod: 'Yield', worst: 'worst', yourPick: 'your pick',
  usedIn: 'Blueprints', ships: 'Ships', openCrafting: 'Open crafting',
  // Phase 12: location view (D-01/D-11) — back-button label and the trace
  // badge for ores with at most 10% share (D-07).
  backToOre: 'Back to ore view', trace: 'Trace',
};

/* Bricht den Build ab, statt eine Sprache mit fehlendem Schluessel stumm
   auszuliefern (leerer Text bzw. "undefined" im HTML). Laeuft fuer JEDEN
   Aufruf der Komponente (also fuer beide Sprachseiten je einmal) — das
   reicht, weil beide Zweige feste Objektliterale sind, keine Laufzeitdaten. */
function assertMiningLangParity(): void {
  const deKeys = Object.keys(S_DE);
  const enKeys = Object.keys(S_EN);
  const deSet = new Set(deKeys);
  const enSet = new Set(enKeys);
  const missingInEn = deKeys.filter((k) => !enSet.has(k));
  const missingInDe = enKeys.filter((k) => !deSet.has(k));
  if (missingInEn.length || missingInDe.length) {
    throw new Error(
      `MiningWorkbench: Sprachschluessel von DE und EN weichen ab. ` +
        `Fehlt in EN: ${missingInEn.join(', ') || '—'}; fehlt in DE: ${missingInDe.join(', ') || '—'}`
    );
  }
}
assertMiningLangParity();

const S = de ? S_DE : S_EN;

const payload = {
  lang, minerals, refineries, profiles, t: S,
  rar: Object.fromEntries(Object.entries(RAR_LBL).map(([k, v]) => [k, v[lang]])),
  craftingPath: href(craftingPath, lang),
  fracturingPath,
  shipsByMethod,
};
const systems = [...new Set(minerals.flatMap((m) => m.systems))].sort();
---

<section class="wb" id="db" data-wb
         style={`--wb-frame:url('${chassisFrame}');--wb-plug:url('${chassisPlug}')`}>
  {/* ⚠ DIE WAND hinter dem Geraet (16.08.2026, auf Ansage: der Grund zwischen
      Fensterrand und Geraetekante soll als RAUM lesen, nicht als flache
      Flaeche). Ein ECHTES Element, kein `::before` — eine Pseudo-Selektor-
      Familie mit Verlauf meldet `verify:layers` (Zusicherung 5) zu Recht als
      Fund ohne Registry-Eintrag; das hat dieses Bauteil schon zweimal
      gekostet.
      Sie steht VOR dem Gehaeuse im Markup und liegt mit z-index 0 dahinter —
      das Gehaeuse hebt sich mit z-index 1 darueber. */}
  <span class="wb__wall" aria-hidden="true"></span>

  {/* ───────────────────────── Gehaeuse ─────────────────────────
      Der Rahmen ist EINE Grafik mit festem Seitenverhaeltnis, die Bildflaeche
      ein Prozentkasten darin. KEIN `border-image`/9-Slice: das streckt die
      Mitte jeder Kante, und genau dort hat die Vorlage ihre Zeichnung
      (Steckerbuchse mit Lueftungsgittern unten, Seriennummer oben rechts).
      Zuschnitt und Prozentwerte sind gemessen, nicht geschaetzt —
      .planning/sketches/tools/make-chassis.mjs hat sie eingemessen, Belege in
      .planning/sketches/010-chassis-asset/README.md.

      ⚠ Der Titel steht als HTML IM Kopfband, nicht in der Grafik: er muss
      uebersetzbar, suchbar und die echte <h1> der Seite bleiben. Nur die
      aufgedruckte Seriennummer ist Dekoration.

      ⚠ Kein `backdrop-filter` mehr auf den Paneelen — hinter einem deckenden
      Gehaeuse hat Glas nichts zu spiegeln. Damit ist die Paarung clip-path
      ueber backdrop-filter (840 ms Menue-Eintritt) baulich ausgeschlossen. */}
  {/* EIN Symbol fuer 38 Knoepfe (37 Kacheln + der grosse am gewaehlten Erz).
      Als <use>-Verweis statt 38-mal dasselbe Pfad-d im HTML — und als Symbol
      statt Schriftzeichen, weil „☆/★" in jeder Schrift anders aussieht, nicht
      zur Strichstaerke der uebrigen Symbole passt und sich nicht faerben
      laesst wie ein Icon. Der Zustand kommt NICHT aus einem zweiten Symbol,
      sondern aus `.is-on` am Knopf: das Skript tauscht damit kein Markup mehr
      aus. Reissbrettnadel, nicht Stern — die Handlung heisst „Anheften". */}
  <svg class="wb__sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <symbol id="wb-i-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5 3h5M11 3v6.2L7.4 13h9.2L13 9.2V3M12 13v8" />
    </symbol>
    {/* Stift fuer "Umbenennen" an der Preset-Zeile (Phase 10, D-02 Form 1) —
        dieselbe Bauform wie #wb-i-pin daneben, kein zweites Icon-Verfahren. */}
    <symbol id="wb-i-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20h4l10.5-10.5a2.12 2.12 0 0 0-3-3L5 17v3z" />
      <path d="M13.5 6.5l4 4" />
    </symbol>
    {/* Muelleimer fuer "Loeschen" (Phase 10, D-01) — dasselbe Symbol, das der
        Konto-Bereich fuer seine Gefahrenzone benutzt (#ic-trash in
        AccountDashboard.astro). Kein neu erfundenes Zeichen, und "×" bleibt
        dadurch eindeutig "Abbrechen/Schliessen". */}
    <symbol id="wb-i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
      <path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13M10 11v6M14 11v6" />
    </symbol>
    {/* Kreispfeil — "aktualisieren mit der aktuellen Auswahl" (Phase 10, D-02
        Form 2: Ueberschreiben). Betreiber-Befund 15.08.2026: das vorherige
        Zeichen (Pfeil nach unten in eine offene Wanne) ist die uebliche
        Download-Glyphe und wurde genau so gelesen — hier wird aber nichts
        heruntergeladen, sondern der gespeicherte Inhalt mit dem Arbeitsstand
        ersetzt. */}
    {/* ⚠⚠ Betreiber-Befund "das icon ist nicht in der mitte", zweimal gemeldet.
        Der erste Anlauf richtete die BOUNDING BOX am Papierkorb aus (Mitte y 12,5)
        und lag falsch: der Pfeilsporn oben rechts zieht die Box mit, dadurch rutschte
        der RING auf y 12,52 und hing sichtbar unter der Mitte. Bei einem Ring liest
        das Auge den Kreismittelpunkt, nicht die Box — der Sporn darf ueberhaengen.
        Jetzt: Ring-Mitte exakt 12/12, Aussendurchmesser 17,50. Die Nachbarn messen
        17,80 (Papierkorb) und 17,12 (Stift); ein Kreis wirkt bei gleicher Box
        groesser als eine eckige Form, deshalb bewusst am unteren Ende der Spanne.
        stroke-width 2.32 gleicht die 0,861-Skalierung aus, damit der sichtbare
        Strich wieder bei 2 landet wie bei allen anderen Symbolen.
        ⭐ Lehre fuer das naechste Symbol: an der Form ausrichten, die die Figur
        traegt (Ring, Korpus), nicht an der Umgrenzung samt Auslegern. */}
    <symbol id="wb-i-update" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.32" stroke-linecap="round" stroke-linejoin="round">
      <g transform="translate(12,12) scale(0.861) translate(-12,-12)">
        <path d="M21 3v6h-6" />
        <path d="M21 12a9 9 0 1 1-3.2-6.9L21 9" />
      </g>
    </symbol>
    {/* Pfeil zurueck — der Zurueck-Knopf im Fundort-Kopf (Phase 12, D-01),
        fuehrt zur zuletzt gewaehlten Erz-Ansicht. Dieselbe Stilfamilie wie
        jedes andere Symbol hier. */}
    <symbol id="wb-i-back" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 4 4 12l7 8M4 12h16" />
    </symbol>
  </svg>

  <div class="wb__chassis">
    {/* ⚠ Titel und Vorzeile standen bis 15.08.2026 sichtbar im Kopfband. Der
        Betreiber hat sie als „ultra ugly" gestrichen — das Blech traegt seine
        eigene Beschriftung (die aufgedruckte Seriennummer), ein zweiter
        Schriftzug darauf war Fremdkoerper. Die <h1> BLEIBT, nur unsichtbar:
        sie ist die Ueberschrift des Dokuments und darf fuer Suchmaschinen und
        Vorleseprogramme nicht verschwinden. Die Vorzeile ist ersatzlos weg —
        die Spielversion steht ohnehin in der Fusszeile. */}
    <h1 class="wb__ctitle" set:text={title} />
    <div class="wb__cscreen">
      {/* ⚠ Der Schirm-Schleier ist ein ECHTES Element, kein `::before`.
          Zwei Gruende, beide bezahlt:
          · Er muss UEBER dem Inhalt liegen — Lichtsaum, Glasspiegelung und
            Vignette wirken nur, wenn sie auf allem liegen. Ein `background` am
            Schirm liegt dahinter und ist wirkungslos.
          · `verify:layers` (Zusicherung 5) meldet jede Pseudo-Selektor-Familie
            mit Verlauf als Fund ohne Registry-Eintrag. Eine Klasse tut das
            nicht. */}
      <span class="wb__glare" aria-hidden="true"></span>
      {/* Die Vorzeile ist seit 16.08.2026 OPTIONAL und auf der Mining-Seite
          abbestellt. Sie zaehlte „Physik, Gesteinsarten" auf — beides ist am
          12.08. mit dem Fracturing-Rechner auf /fracturing.html gezogen, der
          Satz versprach also seit vier Tagen Funktionen, die es hier nicht
          mehr gibt. Ohne Vorzeile faellt auch ihr Zeilenkasten weg, statt
          leer stehen zu bleiben. */}
      {lead && <p class="wb__clead" set:text={lead} />}

  <div class="wb__grid">

    <!-- ========================================= Spalte 1: alle 37 Erze -->
    <div class="wb__pane wb__pane--list chamf">
      <div class="wb__filters">
        {/* Seit 16.08.2026 SECHS Schritte. Vier beschrieben das Werkzeug nur
            bis zur Haelfte: die Presets kamen ueberhaupt nicht vor, das
            ausgelagerte Fenster ebenso wenig — beides Dinge, die man ohne
            Hinweis nicht findet („erklaert es nicht zb die presets, das
            popout undso"). Reihenfolge folgt dem Arbeitsweg: erst anheften
            (4), dann benennen (5), dann herausloesen (6). */}
        <ToolHelp tool="mining" lang={lang} steps={6} />
        <div class="wb__frow">
          <input class="wb__search" id="wb-q" type="search" placeholder={S.search} aria-label={S.search} data-help={hlp('search')} />
          <span class="wb__c" id="wb-count">{minerals.length}</span>
        </div>
        {/* Der Chip „nur brechbar" stand hier bis 12.08. mit daneben — er
            urteilte ueber eine Ausruestung, die es auf dieser Seite nicht
            mehr gibt, und ist mit dem Rechner umgezogen. */}
        <div class="wb__chips" data-help={hlp('system')}>
          {systems.map((s) => (<button type="button" class="wb__chip" data-sys={s} set:text={s} />))}
        </div>
      </div>
      {/* Kachelraster, seit 12.08.2026 in GROSS. Vorher: 79x41 px, Name auf
          rund 54 px beschnitten, Anheft-Ziel 28 px in der Ecke ueber der
          Signatur. Der Nutzer hat das zweimal als zu klein gemeldet — beim
          zweiten Mal ausdruecklich mit „wir haben da genug platz".
          Jetzt vier statt fuenf Spalten in einer breiteren Saeule: der Name
          bekommt die volle Kachelbreite (rund 94 px), Signatur und
          Anheft-Knopf teilen sich die zweite Zeile.
          ⚠ Das kostet die alte Zusage „alle 37 ohne Scrollen bei 1280x720":
          bei 1920x1080 stehen weiterhin alle 37 im Bild, bei 1280x720 scrollt
          die Liste. Gemessen und begruendet in
          .planning/notes/signaturliste-anheften.md. */}
      {/* data-help sitzt am Kasten, nicht mehr an einem einzelnen Raster:
          seit der Gruppierung gibt es mehrere .wb__tiles, und Zusicherung 3
          von verify:help zaehlt die Anker je Sprache — ein Anker bleibt ein
          Anker, egal wie viele Baender darunter liegen. */}
      <div class="wb__scroll" id="wb-list" data-help={hlp('tiles')}>
        {/* ⚠ `div`, NICHT `section`: die Seite traegt eine globale
            `section{padding:…}`-Regel, die der Gruppe hier 99 px oben/unten
            und 72 px seitlich verpasst hat — das Kachelraster verlor dadurch
            eine Spalte und die Liste wurde dreimal so hoch. Dieselbe Falle
            steckte schon im Konto-Panel. */}
        {groups.map((g) => (
          <div class="wb__grp" data-grp={g.id}>
            <h3 class="wb__ghd">
              <span class="wb__ghd__t" set:text={g.label} />
              <span class="wb__ghd__g" set:text={g.solo ? `${g.gear} · ${g.solo}` : g.gear} />
              <span class="wb__ghd__n num" set:text={String(g.total)} />
            </h3>
            {g.bands.map((b) => (
              <div class="wb__band" data-band={b.band}>
                {g.solo ? null : (
                <h4 class={`wb__bhd wb__bhd--${b.band}`}>
                  <span class="wb__bhd__t" set:text={b.label} />
                  <i class="wb__bhd__r" aria-hidden="true"></i>
                  <span class="wb__bhd__n num" set:text={String(b.items.length)} />
                </h4>
                )}
                <div class="wb__tiles">
                  {b.items.map((m) => {
                    const other = methodsOf(m).filter((x) => x !== g.id).map((x) => (S as any)[x]);
                    return (
                      <div class={`wb__tile wb__tile--${b.band}${m.name === sel.name ? ' is-sel' : ''}`}
                           data-min={m.name} role="button" tabindex="0"
                           title={`${m.name} — ${S.tier}: ${b.label}${other.length ? ` · ${S.also} ${other.join(' / ')}` : ''}`}>
                        <span class="wb__tn">
                          <span class="wb__tn__n" set:text={m.name} />
                          {other.length ? (<span class="wb__talso" set:text={`+${other.join('/')}`} />) : null}
                        </span>
                        <span class="wb__ts num" set:text={m.sig ? String(m.sig) : '—'} />
                        <button type="button" class="wb__pin" data-pin={m.name} aria-pressed="false" aria-label={`${S.pin}: ${m.name}`}>
                          <svg class="wb__pin__i" aria-hidden="true" focusable="false"><use href="#wb-i-pin" /></svg>
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- ============================================= Spalte 2: Ansicht -->
    {/* Bis 14.08.2026 zwei Teilspalten (wb__pane--a/wb__pane--b) in
        `.wb__mid{grid-template-columns:1fr 1fr}`. Seit der Fundort-Korrektur
        hat ein Erz bis zu 27 Fundorte (gemessen 15.08., vorher stand „bis zu
        21" in CONTEXT.md), die schmale Bahn reichte dafuer nicht mehr — jetzt
        EIN Paneel, EINE Bahn: Kopf, Fundorte, Beste Stationen (D-01..D-03).
        Physik, Qualitaetsstufen und „Steine mit diesem Erz" sind mit der
        Detailspalte ersatzlos gestrichen, nicht verschoben. */}
    <div class="wb__pane wb__pane--mid chamf">
      <div class="wb__id" id="wb-orehead">
        <div class="wb__idrow">
          <div class="wb__idl">
            <h2 id="wb-name" set:text={sel.name} />
            <div class="wb__tags" id="wb-tags"></div>
          </div>
          <div class="wb__sigbox">
            <span class="wb__lbl" set:text={S.signature} />
            <b class="num" id="wb-sig" set:text={sel.sig ? String(sel.sig) : S.none} />
          </div>
          {/* Der zweite, grosse Weg am gerade gewaehlten Erz. Traegt
              `data-pin` erst zur Laufzeit; der delegierte Klick-Handler
              erkennt ihn dadurch ohne Sonderfall. */}
          <button type="button" class="wb__pinbig" id="wb-pinsel" aria-pressed="false" data-help={hlp('pinbtn')}>
            <svg class="wb__pinbig__i" aria-hidden="true" focusable="false"><use href="#wb-i-pin" /></svg>
            <span id="wb-pinsel-txt" set:text={S.pin} />
          </button>
        </div>
      </div>
      {/* Fundort-Kopf (Phase 12, D-01/D-11) — Geschwister von wb-orehead, nicht
          Overlay: renderLocation() in assets/mining-workbench.js schaltet
          beide gegeneinander um. Zurueck-Knopf -> Textblock (Name + Unterzeile
          aus Art · System · Anflugpunkten); rechts davon steht ABSICHTLICH
          nichts -- Signaturkasten und grosser Anheft-Knopf entfallen
          ersatzlos, kein Platzhalter. wb-locname/wb-locsub bleiben server-
          seitig leer, weil sie erst zur Laufzeit ueber textContent befuellt
          werden (kein Ladezustand noetig, die Daten liegen bereits inline). */}
      <div class="wb__id wb__id--loc" id="wb-lochead" hidden>
        <div class="wb__idrow">
          <button type="button" class="wb__back" id="wb-back" data-back aria-label={S.backToOre} title={S.backToOre}>
            <svg class="wb__back__i" aria-hidden="true" focusable="false"><use href="#wb-i-back" /></svg>
          </button>
          <div class="wb__idl">
            <h2 id="wb-locname" />
            <div class="wb__locsub" id="wb-locsub"></div>
          </div>
        </div>
      </div>
      <div class="wb__scroll" id="wb-oreview">
        <div class="wb__sec"><h4 id="wb-loch" set:text={S.locations} /><div class="wb__locs" id="wb-locs" data-help={hlp('locpin')}></div></div>
        <div class="wb__sec"><h4 set:text={S.bestRef} /><div class="wb__refs" id="wb-refs"></div></div>
        <div class="wb__sec"><div class="wb__links" id="wb-links"></div></div>
      </div>
      <div class="wb__scroll" id="wb-locview" hidden></div>
    </div>

    <!-- =========================================== Spalte 3: Signaturen -->
    <div class="wb__pane wb__pane--sig chamf">
      {/* AUSLAGERN (16.08.2026). Der Knopf sitzt absolut in der oberen rechten
          Ecke der SPALTE, nicht in der Presetzeile darunter: die Presetzeile
          (#wb-pre-pick) ist fuer Gaeste verborgen, ein Knopf darin waere ohne
          Konto unerreichbar. Absolut positioniert, weil die Spalte sonst eine
          vierte Kopfzeile bekaeme und die Presets ihren dokumentierten Platz
          „an oberster Stelle" (D-04) verlieren wuerden; .wb__pane traegt
          bereits position:relative. Die Polsterung von .wb__pre ist rechts
          entsprechend aufgeweitet, damit das „+" nicht darunter laeuft. */}
      <button type="button" class="wb__popb" id="wb-pop" data-help={hlp('popout')}
              title={S.popout} aria-label={S.popout}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
      </button>
      {/* Platzhalter, solange die Listen ausgelagert sind. Ohne ihn stuende
          hier eine leere Spalte — von „ausgelagert" nicht zu unterscheiden.
          Der Knopf darin ist der zweite Rueckweg neben dem Fensterkreuz. */}
      <div class="wb__popslot" id="wb-pop-slot" hidden>
        <p set:text={S.popoutOut} />
        <button type="button" class="wb__popslot__b" id="wb-pop-back" set:text={S.popoutBack} />
      </div>
      {/* #wb-pop-body ist die EINE Huelle, die ins Fremdfenster wandert —
          Presetzeile und beide Listen zusammen, damit ein Preset dort
          aufrufbar bleibt. Sie erbt die Flex-Eigenschaften, die vorher direkt
          an .wb__pre/.wb__stack gegen die Spalte wirkten (s. Stilblock);
          ohne das faellt die Hoehenkette und die Listen scrollen nicht mehr. */}
      <div class="wb__popbody" id="wb-pop-body">
      {/* Presets — benannte Zusammenstellungen BEIDER Listen, kontogebunden
          (Tabelle mining_sig_presets, RLS wie crafting_entries). Bewusst AN
          OBERSTER STELLE der Spalte: das ist die sichtbare Form von „ein
          gemeinsames Preset-System" (D-04). Seit Phase 10 (D-03) steht hier
          kein Reiter mehr darueber — die Kopfpolsterung dieses Blocks ist
          deshalb direkt auf den Spaltenrand abgestimmt (s. Stilblock).
          ⚠ Die ANGEHEFTETEN Listen selbst bleiben im localStorage: sie sind
          der Arbeitsstand und muessen ohne Konto funktionieren. Ans Konto
          geht nur, was man benennt und wieder aufruft. Zwei getrennte Dinge;
          sie in einen Topf zu werfen hiesse, Gaesten das Anheften wegzunehmen.
          Serverseitig steht hier der Gast-Zustand — welcher Fall gilt, weiss
          erst der Browser (VBAccount.session()). */}
      <div class="wb__pre" id="wb-pre" data-help={hlp('presets')}>
        <div class="wb__pre__pick" id="wb-pre-pick" hidden>
          <div class="wb__pre__bar">
            <span class="wb__lbl" set:text={S.presets} />
            <button type="button" class="wb__pre__b is-go" id="wb-pre-new" title={S.presetNew} aria-label={S.presetNew}>+</button>
          </div>
          <div class="wb__pre__list" id="wb-preset-list"></div>
        </div>
        {/* Eigene Zeile statt window.prompt(): der Dialog ist in vielen
            Browsern unterdrueckt, sieht ueberall anders aus und laesst sich
            nicht beschriften. */}
        <div class="wb__pre__row" id="wb-pre-edit" hidden>
          <input class="wb__pre__in" id="wb-pre-name" type="text" maxlength="60" placeholder={S.presetName} aria-label={S.presetName} />
          <button type="button" class="wb__pre__b is-go" id="wb-pre-ok" title={S.presetSave} aria-label={S.presetSave}>✓</button>
          <button type="button" class="wb__pre__b" id="wb-pre-cancel" title={S.presetCancel} aria-label={S.presetCancel}>×</button>
        </div>
        <p class="wb__pre__msg" id="wb-pre-msg" hidden></p>
        <p class="wb__pre__guest" id="wb-pre-guest">
          <span set:text={S.presetGuest} /> <a id="wb-pre-login" href="#" set:text={S.presetLogin} />
        </p>
      </div>

      {/* Signaturen und Fundort-Merkliste stehen seit Phase 10 (D-03) BEIDE
          gleichzeitig sichtbar untereinander statt hinter einem Reiter — ein
          Reiter zeigt zwangslaeufig immer nur eine der beiden Listen, das war
          der eigentliche Grund fuer den teuersten Befund aus CONTEXT.md.
          Beide Kaesten teilen sich die Resthoehe der Spalte (flex:1 1 0 mit
          min-height:0 an .wb__sec2, s. Stilblock) und tragen je eine eigene
          Ueberschrift mit Zaehler (Formvorbild #wb-loch in Spalte 2). Die ids
          wb-pinsh/wb-lpinsh sind neu, weil wb-loch in Spalte 2 bereits die
          Fundort-Ueberschrift des gewaehlten Erzes belegt. */}
      <div class="wb__stack">
        <div class="wb__sec2">
          <h4 id="wb-pinsh" set:text={S.signatures} />
          <div class="wb__scroll" id="wb-pins" data-help={hlp('pins')}></div>
        </div>
        <div class="wb__sec2">
          <h4 id="wb-lpinsh" set:text={S.locations} />
          <div class="wb__scroll" id="wb-locpins" data-help={hlp('shortlist')}></div>
        </div>
      </div>
      </div>{/* #wb-pop-body */}
    </div>
  </div>

  {/* Aus der Rig-Leiste ist eine Fusszeile geworden: geblieben ist die
      Station — sie gehoert zum Ertrag, nicht zum Brechen — und daneben der
      Weg zum Rechner. Der Verweis ist kein Zierrat: die Brechbarkeit war
      hier eine sichtbare Zusage, und wer sie sucht, muss erfahren, wohin sie
      gegangen ist, statt sie fuer geloescht zu halten. */}
  <div class="wb__rig chamf">
    {/* ⚠ VERBORGEN, NICHT ENTFERNT (16.08.2026, auf Ansage: „logik dahinter
        drinlassen aber nur dem user nicht zeigen"). Das <select> bleibt samt
        Optionen im Dokument, `S.ref` wird weiterhin geladen, gespeichert und
        von renderDetail() gelesen — die Rangliste markiert also unveraendert
        eine Station als „deine Wahl". Nur waehlen kann man sie nicht mehr:
        ohne Bedienelement bleibt es beim gespeicherten Wert, bei neuen
        Besuchern also bei der ersten Station. Das ist die Folge der Ansage,
        keine Nebenwirkung — wer die Markierung ganz loswerden will, muss
        renderDetail() anfassen, nicht dieses Attribut.
        `hidden` am <label>, nicht am <select>: sonst bliebe die
        Beschriftung „Station" allein stehen. */}
    <label class="wb__rgrp" hidden><span class="wb__lbl" set:text={S.station} />
      {/* ⚠ KEIN data-help mehr: eine Erklaerung fuer ein Bedienelement, das
          niemand sieht, ist keine Hilfe, sondern ein Eintrag im
          Elemente-Modus, der auf nichts zeigt. Der Schluessel
          mining.ctl.station ist mit entfallen — Zusicherung 7 in
          verify-help.mjs haelt beides zusammen. */}
      <select class="wb__sel" id="wb-ref">{refineries.map((r, i) => (<option value={String(i)} set:text={r.n} />))}</select>
    </label>
    <a class="wb__frac" id="wb-frac" href={fracturingPath} data-help={hlp('fracturing')}>
      <span class="wb__frac__ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13H11l-1 9 9.5-12H13z"/></svg>
      </span>
      <span class="wb__frac__t"><b set:text={S.fracturing} /><span class="wb__lbl" id="wb-frac-ore" set:text={sel.name} /></span>
      <span class="wb__frac__go" set:text={S.fracturingGo} />
    </a>
  </div>
    </div>{/* .wb__cscreen */}
  </div>{/* .wb__chassis */}
</section>

<script type="application/json" id="wb-data" set:html={JSON.stringify(payload)}></script>
<script is:inline src={versioned('assets/mining-workbench.js', '/assets/mining-workbench.js')}></script>

<style is:inline>
/* ⚠ Randlos (15.08.2026): das Gehaeuse soll bis an die Fensterkanten laufen.
   Die vorherigen 1560 px Deckel plus 1–2 rem Polsterung liessen es bei 1920
   nur 1488 px breit werden — und weil seine Hoehe ueber das feste
   Seitenverhaeltnis an der Breite haengt, war es dadurch auch zu flach.
   `100vw` statt `100%`, damit die Breite nicht an einem Eltern-Container
   haengt; der negative Rand holt die Sektion aus dem Textkoerper heraus. */
/* Randnah, aber nicht buendig: „muss nicht direkt am Bildschirmrand sein, kann
   gerne bisschen Platz dazwischen sein". Die Polsterung waechst mit dem Fenster
   mit, damit das Verhaeltnis bei jeder Groesse gleich wirkt — und sie ist der
   Gegenposten zur breiteren Rahmenstaerke: „du kannst das gesamte Fenster etwas
   kleiner machen, und den Rahmen etwas breiter". */
.wb{width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);
  padding:0 clamp(16px,2.6vw,56px) 1.4rem;
  /* ⚠ Hier lag bis 16.08.2026 ein Lichtsaum von 6 % als `background` der
     Sektion. Er ist in `.wb__wall` aufgegangen — als Hintergrund der Sektion
     konnte er nicht ueber deren Kasten hinausreichen, und genau das braucht
     die Wand: sie muss oben und unten AUSLAUFEN, sonst steht der Raum in
     einem sichtbaren Rechteck. */
  display:flex;flex-direction:column;gap:10px;font-family:var(--font-ui,system-ui);
  line-height:1.3;position:relative;isolation:isolate;
  /* Alles, was oberhalb und unterhalb des Rasters Hoehe kostet: Titelstreifen,
     Rig-Leiste, Abstaende. Steht als Variable, weil die Rig-Leiste je nach
     Breite umbricht und dann mehr braucht — s. die Medienabfragen unten. */
  --wb-chrome:132px}

/* ══════════════════════ DIE WAND HINTER DEM GERAET ══════════════════════
   Ansage 16.08.2026: „das was hinter dem ganzen liegt … so gestalten dass es
   so aussieht als wäre es in einem 3d space, also hervorheben vom
   Hintergrund." Gewaehlt wurde von den drei vorgelegten Raumbildern die
   BELEUCHTETE WAND: das Geraet schwebt davor, kein Boden.

   ⚠⚠ DIE ENTSCHEIDENDE MESSUNG ZUERST — an der ausgelieferten Seite, nicht
   geschaetzt: das Umfeld ist ein SCHMALER RAHMEN. 33 px (1280) bis 56 px
   (2560) an den Seiten, 79 px oben, 53 px unten. Daraus folgen zwei Dinge,
   die man ohne die Messung falsch macht:

   (1) Ein auf das GERAET zentrierter Radialverlauf taugt hier NICHT als
       Lichtwurf. Nachgerechnet: bei einer Ellipse ueber die Sektionsbreite
       liegt der linke Fensterrand bei ~39 % des Verlaufs und die linke
       Geraetekante bei ~37 % — ueber die ganzen 42 px Rahmen faellt der
       Verlauf also um zwei Prozentpunkte. Das ist kein Lichtabfall, das ist
       eine gleichmaessige Tuenche.
       Das Licht muss der SILHOUETTE folgen, nicht der Sektionsmitte. Genau
       das kann `drop-shadow` am Gehaeuse (es folgt der Alphakante der
       Rahmengrafik, s. u.) — und ein Verlauf kann es nicht.
   (2) Die Wand muss ueber die Sektion HINAUSREICHEN und auslaufen. Endet sie
       an deren Kasten, sieht man ein Rechteck aus Dunkelheit mitten auf der
       Seite. Darum negative Einrueckungen plus `mask-image`.

   Alle Schichten sind DURCHSCHEINEND ueber dem Seitengrund — keine eigene
   deckende Grundfarbe. Sonst muesste die Maske von „Wandfarbe" nach
   „Seitenfarbe" ueberblenden und hinterliesse ein sichtbares Band. */
.wb__wall{position:absolute;left:0;right:0;top:-46px;bottom:-190px;
  z-index:0;pointer-events:none;
  background:
    /* 1. Der Rand ins Dunkle — der Haupthebel. Erst wenn der Rahmen merklich
       tiefer steht als der Seitengrund, sitzt das Geraet in einer Nische statt
       auf einer Flaeche.
       ⚠⚠ HIER LAG DER FEHLER ZWEIER ANLAEUFE, und die Rechnung ist der Grund:
       die beiden Prozentwerte vor `at` sind RADIEN in Breite/Hoehe des
       Elements, nicht Durchmesser. Mit 112 % liegt der Fensterrand (800 px von
       der Mitte bei 1600 px Breite) erst bei 800/1792 = 45 % des Verlaufs —
       also fast am hellen Ende. Am Bildpunkt gemessen kam dort rgb(18,23,25)
       gegen einen Seitengrund von rgb(20,24,26) heraus: ein Unterschied von
       zwei Stufen, den kein Mensch sieht.
       54 % setzt den Fensterrand auf 800/864 = 93 % — dorthin, wo der Verlauf
       wirklich dunkel ist. Nachgerechnet UND nachgemessen, nicht geschaetzt. */
    radial-gradient(54% 62% at 50% 46%,
      transparent 0 34%,
      color-mix(in srgb,var(--ink) 62%,transparent) 74%,
      color-mix(in srgb,var(--ink) 96%,transparent) 100%),
    /* 2. Die Wandflaeche selbst — bewusst KNAPP. Sie soll nur verhindern, dass
       hinter dem Geraet totes Schwarz steht; das eigentliche Licht kommt vom
       Silhouetten-Wurf am Gehaeuse.
       ⚠ Bei 15 % war genau das falsch herum: die breite Aufhellung uebertoente
       den Wurf, und was blieb, war eine gleichmaessige gruene Tuenche ueber
       der ganzen Sektion. Ein Lichtabfall braucht ein Gefaelle, keine Decke. */
    radial-gradient(74% 62% at 50% 44%,
      color-mix(in srgb,var(--accent) 6%,transparent) 0%,
      color-mix(in srgb,var(--accent) 2%,transparent) 54%,
      transparent 82%);
  /* Oben kurz, unten lang auslaufen: nach oben stoesst die Wand nach 46 px an
     die feste Leiste, nach unten hat sie die ganze Seitenlaenge Zeit. */
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 7%,#000 72%,transparent 100%);
  mask-image:linear-gradient(180deg,transparent 0,#000 7%,#000 72%,transparent 100%)}

/* ═══════════════════════ Gehaeuse — 9-Slice ═══════════════════════
   ⚠⚠ ZWEITE BAUFORM (15.08.2026). Die erste war EIN Bild mit festem
   Seitenverhaeltnis; damit hing die Rahmenstaerke zwangslaeufig an der Breite
   (7,4 % je Seite = 141 px bei 1920 — Rueckmeldung: „viel zu fett"). Duenner
   ginge dort nur ueber ein kleineres Gehaeuse, und dann waere es wieder zu
   niedrig. „Duenner", „hoeher" und „Platz zum Rand" schliessen sich in jener
   Bauform gegenseitig aus.

   Jetzt ein echter 9-Slice. Moeglich wurde er erst, nachdem die MITTIGEN
   Zierteile aus der Grafik verschwunden sind — Kopfband-Mitte, Steckerbuchse,
   Lueftungsgitter, Leuchtsegmente und Seriennummer sind mit sauberem Blech
   ueberzogen (.planning/sketches/tools/cut-chassis-9slice.mjs). In den
   Streckbereichen steht damit glattes Metall, und das darf beliebig lang
   gezogen werden. Steckerbuchse und Leuchtsegment kommen als eigene, mittig
   gesetzte Stuecke wieder obenauf.

   Gemessen (Blaustich des Bildschirms gegen neutrales Metall — der einzige
   Weg, der nicht durch die dunklen Gitterblenden IM Rahmen laeuft):
     Rahmengrafik 2533 x 1167, Bildflaeche 224 / 143 / 106 / 166 (l/o/r/u).

   ⚠ `border-image-width` UND `border-width` muessen uebereinstimmen: das erste
   bestimmt, wie gross der Rahmen GEZEICHNET wird, das zweite, wieviel Platz er
   BELEGT. Weichen sie ab, liegt die Grafik ueber dem Inhalt.
   ⚠ `fill` ist Pflicht, sonst bleibt die Mittelkachel ungezeichnet.
   ⚠ Links und rechts bewusst GLEICH stark, obwohl die Vorlage dort 224 gegen
   106 misst — ein sichtbar dickerer linker Rand liest sich als Fehler. Der
   Preis ist, dass die Fraesung links staerker verkleinert wird als rechts; bei
   dieser Staerke faellt es nicht auf. */
/* ⚠ Staerke: 15–32 px waren zu duenn — beim Duennermachen ging die Zeichnung
   mit verloren („der rahmen design hat schon gepasst aber es war zu fett, du
   hast es getrimmt"). Jetzt 34–62 px: breit genug, dass Fraesung und die
   wieder eingesetzten Zierstuecke lesbar sind, und weit unter den 141 px der
   ersten Bauform. Das Fenster gibt dafuer aussen etwas Platz ab. */
.wb__chassis{--rahmen:clamp(34px,3.1vw,62px);
  position:relative;display:flex;flex-direction:column;min-height:0;
  border-style:solid;border-color:transparent;
  border-image-source:var(--wb-frame);
  border-image-slice:81 138 66 140 fill;
  border-image-width:calc(var(--rahmen)*.579) calc(var(--rahmen)*.986) calc(var(--rahmen)*.471) var(--rahmen);
  border-width:calc(var(--rahmen)*.579) calc(var(--rahmen)*.986) calc(var(--rahmen)*.471) var(--rahmen);
  /* Die Hoehe haengt an nichts mehr — kein Seitenverhaeltnis diktiert sie. */
  height:clamp(430px,calc(100vh - var(--wb-chrome)),1180px);
  /* Ueber der Wand liegen — sie steht mit z-index 0 dahinter. */
  z-index:1;
  /* ⚠ Die Aussenkante endete hart gegen den flachen Seitengrund — gemeldet als
     „immer noch etwas zu abrupt abgeschnitten". In der Vorlage stand das Geraet
     in einer beleuchteten Szene, die Kante hatte etwas, in das sie auslaufen
     konnte; auf der Seite steht dahinter nichts. `drop-shadow` folgt der
     ALPHAKANTE der Rahmengrafik (anders als `box-shadow`, das dem rechteckigen
     Rahmenkasten folgt und die geschnittenen Ecken verfehlen wuerde) und setzt
     das Geraet auf die Seite, statt es hineinzustanzen.

     ⚠⚠ SEIT 16.08.2026 TRAEGT DIESE ZEILE DEN LICHTWURF, nicht die Wand.
     Begruendung und Rechnung stehen bei `.wb__wall`; kurz: im 42 px schmalen
     Rahmen faellt ein auf die Sektion zentrierter Verlauf um zwei
     Prozentpunkte ab und wirkt als gleichmaessige Tuenche. `drop-shadow`
     dagegen folgt der Silhouette — das Licht sitzt damit ueberall gleich weit
     von der Geraetekante entfernt, also genau dort, wo ein Schirm seine
     Umgebung anleuchtet.
     Drei Stufen, in dieser Reihenfolge lesbar:
       1. der Lichtwurf des Schirms auf die Wand (Akzent, weit),
       2. ein enger, harter Saum, der die Kante vom Licht wieder abtrennt,
       3. der Schlagschatten in den Raum — kraeftiger und tiefer als vorher
          (55 %/38 px -> 76 %/46 px), weil er jetzt gegen eine ANGELEUCHTETE
          Wand arbeitet statt gegen flaches Grau. Er ist es, der das Geraet
          vor die Wand stellt, statt es darauf zu kleben.
     ⚠ Der Streuradius des Lichtwurfs ist an der GEMESSENEN Rahmenbreite
     gewaehlt (33–56 px): 48 px heisst, das Licht ist am Fensterrand gerade
     ausgeklungen. Groesser waere Dunst, kleiner ein Strich um das Geraet. */
  filter:drop-shadow(0 0 48px color-mix(in srgb,var(--accent) 34%,transparent))
         drop-shadow(0 3px 4px color-mix(in srgb,var(--ink) 88%,transparent))
         drop-shadow(0 22px 46px color-mix(in srgb,var(--ink) 76%,transparent))}

/* ─── Zierstuecke, die aus den Streckbereichen genommen wurden, wieder an Ort
   Steckerbuchse mittig auf dem Sockel, Leuchtsegmente mittig in beiden Holmen.
   Mittig und in fester Groesse, damit sie beim Wachsen des Rahmens nicht in
   die Laenge gezogen werden.

   ⚠⚠ ENTSCHEIDEND ist die Maske. Beim ersten Versuch lagen dieselben Stuecke
   ohne sie auf dem Blech und lasen sich als rechteckige Flicken — harte
   Laengskanten, an denen der Verlauf des Stuecks nicht auf den des Balkens
   traf. `mask-image` loest sie auf; erst dadurch sitzen sie IM Blech statt
   darauf. Wer die Stuecke wieder anfasst: die Maske ist kein Feinschliff,
   sondern die Bedingung, unter der sie ueberhaupt funktionieren. */
.wb__chassis::after{content:'';position:absolute;
  pointer-events:none;z-index:2}
/* Steckerbuchse (640x166 in der Vorlage). */
.wb__chassis::after{left:50%;transform:translateX(-50%);
  bottom:calc(var(--rahmen)*-.471);height:calc(var(--rahmen)*.471);
  width:calc(var(--rahmen)*.471*470/66);
  background:var(--wb-plug) center/100% 100% no-repeat;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent)}

/* ⚠ Titel und Vorzeile standen bis 15.08.2026 SICHTBAR im Kopfband und sind
   auf Ansage des Betreibers gestrichen ("ultra ugly"): das Blech traegt seine
   eigene Beschriftung, ein zweiter Schriftzug darauf war Fremdkoerper.
   Die <h1> bleibt — sie ist die Ueberschrift des Dokuments und darf fuer
   Suchmaschinen und Vorleseprogramme nicht verschwinden. Deshalb unsichtbar
   statt geloescht, und NICHT per display:none (das nimmt sie auch dem
   Vorleseprogramm). Gleiche Bauart wie `.skip` im Layout. */
.wb__ctitle{position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;
  overflow:hidden;clip-path:inset(50%);white-space:nowrap}

/* Die Bildflaeche ist jetzt schlicht der Inhaltskasten des Gehaeuses — kein
   Prozentkasten mehr noetig, weil der Rahmen seinen Platz ueber `border-width`
   selbst belegt. */
/* Die Bildflaeche liest sich als leuchtender Schirm, nicht als Seitenhintergrund:
   feine waagerechte Zeilenstruktur plus eine Aufhellung zur Mitte hin.
   ⚠ Als `background` am Element selbst, NICHT als `::before` mit Verlauf — das
   waere eine neue Selektor-Familie und `verify:layers` (Zusicherung 5) meldet
   sie zu Recht als Fund ohne Registry-Eintrag. Schon einmal bezahlt. */
/* ── DER SCHIRM ───────────────────────────────────────────────────────────
   Der Rahmen ist das Geraet, diese Flaeche sein Bildschirm.

   ⚠⚠ UMBAU 16.08.2026 auf Ansage des Betreibers: „sehr stoerend beim Lesen,
   ausserdem sehr statisch und liefert nicht die erwartete Wirkung."
   Zwei getrennte Befunde, zwei getrennte Antworten:

   (1) STOEREND. Das Zeilenraster lag mit 1 px auf 3 px bei 46 % Deckkraft
       UEBER dem Text. Bei 13-14 px Schriftgroesse kreuzen damit vier bis fuenf
       dunkle Balken JEDE Glyphe — in der Lupe sind „Aslarite", „Tungsten",
       „Copper" sichtbar zerschnitten. Das ist kein Kontrastproblem, das ist
       zerstoerte Buchstabenform, und die faellt aus keiner WCAG-Zahl heraus.
       Antwort: das starke Raster wandert HIERHER, hinter die Paneele. Die
       Paneele sind deckend, also sieht man es nur dort, wo nichts zu lesen
       steht — Fugen, Kopfzone, Rand. Ueber dem Text bleibt im Schleier nur
       noch ein Hauch (4 px Teilung, 13 % statt 46 %): genug, dass die Flaeche
       geriffelt liest, zu wenig, um eine Glyphe zu zerteilen.

   (2) STATISCH. Beantwortet war das mit einem wandernden Abtaststrahl
       (`.wb__scan`, 9 s Takt). ⚠⚠ VOM BETREIBER WIEDER ABBESTELLT, 16.08.2026:
       „dieses effekt was einmal so durchgeht kann raus." Ersatzlos entfernt —
       NICHT abgeschwaecht, nicht an einen Schalter gehaengt. Wer ihn
       wiederhaben will, holt ihn aus `4fb2409`.
       ⚠ Damit ist die Flaeche bewusst wieder unbewegt. Das ist eine
       Entscheidung, kein Versaeumnis: bevor hier jemand erneut Bewegung
       einbaut, muss sie neu beauftragt sein.

   Reihenfolge der Schichten, von hinten nach vorn:
     1. eigene, tiefere Schwaerze mit kuehlem Stich (nicht der Seitengrund),
     2. Eigenleuchten aus der Mitte heraus,
     3. starkes Zeilenraster  ─ hier, HINTER den Paneelen,
     4. der Inhalt,
     5. Lichtsaum, Glasspiegelung, Vignette, Hauch-Raster (`.wb__glare`).
   ⚠ Ein erster Anlauf hatte 1–3 bei 3 % Deckkraft — das sieht niemand („es
   sieht ueberhaupt nicht so aus wie ein bildschirm"). Die Staerke ist also
   nicht das Problem gewesen, der ORT war es. */
.wb__cscreen{position:relative;display:flex;flex-direction:column;gap:8px;min-height:0;flex:1;
  background:
    /* Zeilenraster in voller Staerke — es liegt hinter den Paneelen und
       kreuzt deshalb keine einzige Glyphe. */
    repeating-linear-gradient(0deg,
      color-mix(in srgb,var(--ink) 58%,transparent) 0 1px, transparent 1px 3px),
    radial-gradient(120% 85% at 50% 38%,
      color-mix(in srgb,var(--accent) 20%,transparent) 0%,
      color-mix(in srgb,var(--accent) 5%,transparent) 46%, transparent 74%),
    linear-gradient(180deg,
      color-mix(in srgb,var(--ink) 92%,var(--accent)) 0%, var(--ink) 100%),
    var(--ink)}

/* ⚠⚠ HIER LAG DER ABTASTSTRAHL (`.wb__scan`/`.wb__scanbar` + @keyframes
   wbscan), 16.08.2026 gebaut und am selben Tag auf Ansage wieder ERSATZLOS
   entfernt: „dieses effekt was einmal so durchgeht kann raus."
   Nicht abgeschwaecht, nicht hinter einen Schalter gelegt — weg. Der volle
   Bau samt Begruendung steht in `4fb2409`, falls er je zurueck soll.
   Was davon zu behalten ist, steht in der Erfahrung, nicht im Code: ein
   breiter weicher Verlauf bei niedriger Deckkraft ist auf fast schwarzem
   Grund unsichtbar (der erste Anlauf mit 4,5 % ueber 300 Bildpunkte war es),
   waehrend eine scharfe Kante bei gleicher Durchschnittshelligkeit deutlich
   sichtbar ist. Beides gilt weiter — nur will hier gerade niemand Bewegung. */

/* Der Schleier ueber allem: Lichtsaum, Glasspiegelung, Vignette, Hauch-Raster.
   ⚠ `pointer-events:none` ist PFLICHT — ohne das schluckt er jeden Klick auf
   Kacheln, Zeilen und Knoepfe darunter.
   ⚠ Hier liegt ALLES ueber dem Text. Deshalb nur noch grossflaechige, weiche
   Verlaeufe: die zerteilen keine Buchstaben. Das feine, hochfrequente Zeug
   (das Raster) ist genau darum nach hinten gewandert. */
.wb__glare{position:absolute;inset:0;z-index:5;pointer-events:none;border-radius:2px;
  background:
    /* 1. Lichtsaum an der Oberkante — verkauft die hinterleuchtete Scheibe.
       Neu am 16.08.2026: dem Schirm fehlte jeder Hinweis, dass er LEUCHTET,
       und nicht bloss eine dunkle Flaeche im Blech ist. */
    radial-gradient(150% 20% at 50% 0%,
      color-mix(in srgb,var(--accent) 9%,transparent) 0%, transparent 100%),
    /* 2. Glasspiegelung: breiter und flacher als vorher (5 % -> 3,5 %), damit
       sie als Scheibe liest und nicht als aufgemalter Streifen. */
    linear-gradient(104deg,
      transparent 0 26%,
      color-mix(in srgb,var(--text) 3.5%,transparent) 44%,
      color-mix(in srgb,var(--text) 1.5%,transparent) 58%,
      transparent 74% 100%),
    /* 3. Vignette, zurueckgenommen (55 % -> 34 %, freie Mitte bis 58 %): sie
       lag mit voller Staerke auf den AUSSENSPALTEN, also genau dort, wo die
       langen Listen stehen. Ecken abdunkeln ja, Leselast erzeugen nein. */
    radial-gradient(126% 104% at 50% 46%,
      transparent 0 58%, color-mix(in srgb,var(--ink) 34%,transparent) 100%),
    /* 4. Hauch-Raster: 4 px Teilung statt 3, 13 % statt 46 %. Es traegt die
       Riffelung ueber die Paneele hinweg weiter, ohne die Schrift zu saegen.
       4 px, weil das bei doppelter Bildpunktdichte auf ganze Geraetepunkte
       faellt — 3 px tat das nicht und flimmerte beim Rollen. */
    repeating-linear-gradient(0deg,
      color-mix(in srgb,var(--ink) 13%,transparent) 0 1px, transparent 1px 4px)}

/* (Der `prefers-reduced-motion`-Block stand hier und ist mit dem Abtaststrahl
   entfallen — es bewegt sich auf dem Schirm nichts mehr, was abzubestellen
   waere.) */
.wb__clead{margin:0;text-align:center;font-size:var(--fs-4);
  color:color-mix(in srgb,var(--muted) 92%,transparent)}
/* ⚠ Der Zier-Grund (`.wb::before`: zwei Rastermassstaebe, zwei Lichtabfaelle,
   Vignette) ist am 15.08.2026 entfallen. Er war die Antwort auf „kein Foto,
   aber auch keine tote Flaeche" — diese Aufgabe hat jetzt das Gehaeuse. Er
   reichte ausserdem 8 px UEBER die Werkbank hinaus und legte dadurch einen
   sichtbaren Lichthof um den Rahmen, der wie ein Darstellungsfehler aussah.
   Nur der Kachelgrund unter der Bildflaeche bleibt — dezent, weil die Grafik
   dort schon einen eigenen Verlauf mitbringt. */
/* ⚠ Hier lag bis 15.08.2026 ein CSS-Raster als Grund der Bildflaeche. Es ist
   ersatzlos entfallen: die Gehaeuse-Grafik bringt ihren eigenen Verlauf im
   Bildschirmbereich mit, und eine zweite Zier-Schicht darueber waere eine
   neue Selektor-Familie, die erify:layers (Zusicherung 5) zu Recht als
   Fund ohne Registry-Eintrag meldet. Weniger Schichten, ein Tor weniger zu
   befriedigen, gleiches Bild. */

.wb__lbl{font-size:var(--fs-4);font-weight:500;color:color-mix(in srgb,var(--muted) 88%,transparent);letter-spacing:var(--ls-4)}
.num{font-family:var(--font-mono,ui-monospace);font-variant-numeric:tabular-nums}

/* ⚠ KEIN Glas mehr (15.08.2026, mit dem Gehaeuse): hinter einer deckenden
   Metallblende hat `backdrop-filter` nichts zu spiegeln — es kostete nur
   Rechenzeit und war der eine Teil der Paarung `clip-path` ueber
   `backdrop-filter`, die den Menue-Eintritt schon einmal auf 840 ms gedrueckt
   hat. Die Paneele sind jetzt deckende Flaechen auf der Bildflaeche der
   Grafik. */
/* ⚠ Gestalt-Durchgang 15.08.2026, AUSDRUECKLICH NUR OPTIK: der Aufbau —
   Spalten, Kachelraster, Zeilen — bleibt unangetastet („nicht vom layout oder
   so, ich meinte nur vom optischen her"). Geaendert wird, WIE die Flaechen
   aussehen, nicht WO sie liegen.
   Leitgedanke: der Rahmen ist das Geraet, die Flaeche darin sein BILDSCHIRM.
   Also keine schwebenden Karten mit weichem Radius, sondern eingelassene
   Anzeigefelder: dunkler als ihre Umgebung, harte Fase oben, feiner
   Lichtstrich an der Oberkante, Radius 4 statt 12. */
.wb__pane,.wb__rig{
  background:color-mix(in srgb,var(--ink) 90%,var(--surface));
  border-radius:4px;
  box-shadow:inset 0 2px 5px color-mix(in srgb,var(--ink) 85%,transparent),
    inset 0 1px 0 color-mix(in srgb,var(--text) 11%,transparent),
    inset 0 0 0 1px color-mix(in srgb,var(--text) 7%,transparent);
  display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden;position:relative}
/* Angeschraegte Ecke OHNE clip-path (die Paarung mit backdrop-filter kostete
   schon einmal 520 ms): ein Pseudo-Element mit 45deg-Verlauf fuellt sie. */
.chamf::after{content:'';position:absolute;top:-1px;right:-1px;width:14px;height:14px;
  pointer-events:none;z-index:3;
  background:linear-gradient(45deg,transparent 0 calc(50% - .5px),
    color-mix(in srgb,var(--accent) 40%,transparent) calc(50% - .5px) calc(50% + .5px),
    var(--bg) calc(50% + .5px) 100%)}

/* 470/330 statt 470/262 (15.08.2026, Phase 10, D-04): die rechte Spalte legt
   68 px zu, weil sie seit dem Wegfall der Reiter beide Listen UND die
   Preset-Zeile gleichzeitig traegt. Die 68 px kommen aus der MITTLEREN
   Spalte (1fr), die seit dem Auszug des Fracturing-Rechners Luft hat — NICHT
   aus der Erzliste, die am 12.08.2026 bewusst auf 470 px verbreitert wurde,
   damit die Kacheln gross genug zum Treffen sind. */
/* ⚠ Die HOEHE kommt seit dem Gehaeuse (15.08.2026) NICHT mehr aus
   `100vh - --wb-chrome`, sondern aus der Bildflaeche: die Grafik hat ein
   festes Seitenverhaeltnis, also ist die verfuegbare Hoehe eine Folge der
   Breite. Eine zweite, davon unabhaengige Hoehenrechnung wuerde sich
   zwangslaeufig widersprechen. `--wb-chrome` bleibt fuer die schmalen Breiten
   unten stehen, wo das Gehaeuse entfaellt.
   Die Spaltenbreiten aus Phase 10 bleiben unangetastet — nur `minmax(0,…)`
   statt fester Werte, weil das Raster jetzt in einem Flex-Kasten sitzt und
   eine feste Spalte dort nicht mehr schrumpfen duerfte. */
/* ⚠⚠ Die MITTE braucht eine Untergrenze. Am ausgelieferten Stand nachgemessen:
   bei 1280 px Fensterbreite ist die Bildflaeche des Gehaeuses 1064 px breit —
   470 + 330 + zwei Luecken lassen der Mitte 234 px. Die Fundortzeilen brachen
   dort vierzeilig um und der Anheft-Knopf wurde vom Nachbarpaneel
   abgeschnitten. Die beiden Aussenspalten duerfen dafuer nachgeben (minmax mit
   0 als Minimum), die Mitte nicht: bei 1064 ergibt das rund 434/300/310 statt
   470/234/330. Die Erzliste behaelt damit ihre vier Kachelspalten
   (434 - 16 Polsterung = 418, bei minmax(104px,1fr) also vier). */
/* ⚠ Erster Anlauf war `minmax(0,470px)` fuer die Erzliste — dann nahm sich das
   Raster die fehlende Breite dort statt rechts und die Liste fiel bei 1280 auf
   DREI Kachelspalten (gemessen 414/300/330). 447 ist die gerechnete Untergrenze
   fuer vier: 4x104 Kachel + 3x5 Luecke + 16 Polsterung. Nachgeben soll die
   rechte Spalte, sie traegt Listen ohne feste Zeilenbreite. */
/* ⚠⚠ Feste Spaltenbreiten funktionieren hier NICHT mehr. Gemessen: mit
   470/1fr/330 bekam bei 1920 allein die MITTE den Zugewinn (871 px) und bei
   1280 blieb ihr nichts (234 px) — die Fundortzeilen brachen vierzeilig um und
   der Anheft-Knopf wurde abgeschnitten. Jetzt Untergrenze + Wachstumsanteil je
   Spalte: unter Druck geben alle drei bis zu ihrem Minimum nach, im Ueberfluss
   wachsen alle drei mit. Die Erzliste bekommt den groessten Anteil, weil sie
   die einzige Spalte ist, die aus Breite mehr ZEILEN macht (mehr Kacheln je
   Reihe). Minimum 447 = 4x104 Kachel + 3x5 Luecke + 16 Polsterung. */
.wb__grid{display:grid;
  grid-template-columns:minmax(447px,1fr) minmax(300px,1.2fr) minmax(280px,.7fr);
  gap:10px;min-height:0;flex:1}
.wb__scroll{flex:1;overflow-y:auto;overflow-x:hidden;min-height:0}

/* ---------------- Spalte 1: Kachelraster, alle 37 ---------------- */
.wb__filters{flex:0 0 auto;padding:9px 10px;display:flex;flex-direction:column;gap:7px;position:relative}
.wb__filters .tool-help__summary{padding:6px 10px;font-size:var(--fs-5);line-height:1.3}
/* Der Koerper liegt ueber dem Kachelraster, und tool-help.js klappt ihn beim
   Erstbesuch von selbst auf (D-09) — der erste Eindruck ist also eine
   teilweise zugedeckte Mineralliste. Der Kasten ist deshalb von 400 auf 244 px
   eingeschnuert; ganz aufloesen laesst sich der Konflikt hier NICHT:
   · Blosses Weiter-Einschnueren hilft nicht — das Raster ist nur rund 330 px
     hoch und beginnt direkt unter der Filterleiste, jede fuer vier Schritte
     brauchbare Hoehe deckt es zu.
   · ⚠ NEBEN die Spalte legen (left:calc(100% + 10px)) ist eine SACKGASSE und
     wurde vorgefuehrt: `.wb__pane` traegt `overflow:hidden`, der Kasten wird
     dadurch restlos weggeschnitten und die Hilfe ist unsichtbar — schlimmer
     als zugedeckt. Nicht noch einmal versuchen.
   · Das Auto-Oeffnen abzustellen oder ToolHelp aus der Spalte zu heben, waere
     ein Eingriff in den geteilten Vertrag bzw. ins Hoehenbudget — eine
     Produktentscheidung, keine Fehlerbehebung. Steht als Sichturteil in
     .planning/notes/mining-werkbank-defekte.md. */
/* ⚠⚠ ZWEI Zeilen, die zusammengehoeren — einzeln richtet keine etwas aus.
   `position:relative` macht das <details> zum Bezug des absolut gesetzten
   Rumpfes. Ohne sie fiel der Bezug auf .wb__filters (die einzige positionierte
   Ahnin), und `top:calc(100% - 4px)` hiess: unter die GANZE Filterleiste,
   also 99 px unterhalb der eigenen Ueberschrift, mit Suchfeld und Systemchips
   dazwischen (gemessen 16.08.2026: Ueberschrift endet bei 171, Rumpf begann
   bei 270). Der Betreiber dazu: „how does it work ist iwi deattached von dem
   dropdown."
   `overflow:visible` ist die Bedingung dafuer, dass das ueberhaupt geht:
   .tool-help traegt `overflow:hidden` (ToolHelp.astro), und ein absolut
   gesetzter Rumpf in einem positionierten Elternteil MIT overflow:hidden wird
   restlos weggeschnitten — genau die Sackgasse, die beim Versuch „neben die
   Spalte legen" schon einmal die ganze Hilfe unsichtbar gemacht hat. */
.wb__filters .tool-help{position:relative;overflow:visible}
.wb__filters .tool-help[open] .tool-help__body{position:absolute;top:calc(100% - 4px);left:0;right:0;
  z-index:14;background:var(--surface);border-radius:12px;line-height:1.45;
  box-shadow:0 10px 30px color-mix(in srgb,var(--ink) 60%,transparent);
  /* ⚠ 15.08.2026 von 244 auf 168 px: mit dem Gehaeuse ist die Bildflaeche
     kuerzer, und der beim Erstbesuch selbsttaetig aufklappende Kasten deckte
     das Kachelraster VOLLSTAENDIG zu — der erste Eindruck der Seite war eine
     Anleitung ohne Minerale. Bei 168 px bleiben zwei Kachelzeilen sichtbar,
     der Kasten scrollt dafuer intern.
     ⚠⚠ 16.08.2026 von 140 auf 300 px, und das kostet KEINE einzige Kachel
     mehr: der Rumpf haengt seit der Zeile weiter oben an seiner eigenen
     Ueberschrift statt am Fuss der Filterleiste und beginnt dadurch 99 px
     hoeher. Gemessen (1600x900): Rumpf 171–471 statt 270–410, der Bildlaufkasten
     der Kacheln beginnt bei 274 — verdeckt werden also 197 statt 136 px, bei
     mehr als der doppelten Textmenge. Der Anlass war ein Befund des
     Betreibers: „erklaert es nicht zb die presets, das popout undso" — der
     Inhalt misst 472 px, sichtbar waren 140, also 30 %. Wer das hier weiter
     aufzieht, nimmt ab jetzt echte Kachelzeilen. */
  max-height:min(46vh,300px);overflow-y:auto;padding:10px 12px 12px}
.wb__frow{display:flex;align-items:center;gap:8px}
.wb__search{flex:1;min-width:0;background:color-mix(in srgb,var(--ink) 34%,transparent);border:0;
  color:var(--text);padding:7px 10px;font-size:var(--fs-6);border-radius:7px;font-family:inherit}
.wb__c{font-size:var(--fs-4);color:color-mix(in srgb,var(--muted) 88%,transparent);font-family:var(--font-mono,ui-monospace)}
.wb__chips{display:flex;gap:5px;flex-wrap:wrap}
.wb__chip{font-size:var(--fs-4);font-weight:500;padding:4px 9px;
  background:color-mix(in srgb,var(--ink) 30%,transparent);border:0;color:var(--muted);
  border-radius:999px;cursor:pointer;font-family:inherit;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__chip:hover{background:color-mix(in srgb,var(--surface-2) 90%,var(--text));color:var(--text)}
.wb__chip.is-on{background:var(--accent-2);color:var(--ink);font-weight:600}
/* Vier Spalten statt fuenf, in einer 470 statt 420 px breiten Saeule: 110 px
   je Kachel statt 79. Das ist der Platz, aus dem der Name seine volle Breite
   und der Anheft-Knopf sein eigenes Feld bekommt. */
/* padding-bottom 5 statt 8: es gibt jetzt bis zu sechs dieser Raster
   untereinander, und die Luft zwischen Band und naechster Ueberschrift bringt
   die Ueberschrift schon selbst mit. */
.wb__tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(104px,1fr));gap:5px;padding:0 8px 5px}
/* ---- Gruppen (Abbauart) und Baender (Qualitaetsstufe) ----------------------
   Zwei Ueberschriftenebenen in einer 483 px breiten Saeule — sie duerfen
   deshalb nur Zeilenhoehe kosten, keine Kaesten. Die Gruppe traegt eine
   Haarlinie ueber sich (Trennung), das Band eine durchlaufende Linie neben
   dem Wort (Bindung an seine Kacheln).
   .wb__grp/.wb__band bekommen ihr `hidden` zur Laufzeit von renderList(),
   wenn die Suche oder ein Systemchip alles darunter wegfiltert. */
.wb__grp[hidden],.wb__band[hidden]{display:none}
.wb__ghd{display:flex;align-items:baseline;gap:7px;margin:0;padding:9px 10px 4px;
  font-size:var(--fs-3);font-weight:600;letter-spacing:var(--ls-11);text-transform:uppercase;
  color:var(--text)}
.wb__grp + .wb__grp .wb__ghd{margin-top:4px;border-top:1px solid color-mix(in srgb,var(--text) 9%,transparent)}
.wb__ghd__g{flex:1;min-width:0;font-size:var(--fs-2);font-weight:400;letter-spacing:var(--ls-5);
  text-transform:none;color:color-mix(in srgb,var(--muted) 85%,transparent);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__ghd__n{flex:none;font-family:var(--font-mono,ui-monospace);font-variant-numeric:tabular-nums;
  color:color-mix(in srgb,var(--muted) 90%,transparent)}
/* Bandueberschrift: das Wort in der Stufenfarbe, die Linie in derselben Farbe
   stark abgeschwaecht. `color:var(--rar)` statt einer Flaeche — damit bleibt
   der Kontrast an der Schrift messbar und die Regel faellt in den Bereich,
   den build-light-overrides.mjs abdeckt (PROPS kennt `color`, kein
   `background`). */
.wb__bhd{--rar:var(--muted);display:flex;align-items:center;gap:7px;margin:0;padding:5px 10px 3px;
  font-size:var(--fs-2);font-weight:700;letter-spacing:var(--ls-12);text-transform:uppercase;
  color:var(--rar)}
.wb__bhd__t{flex:none}
.wb__bhd__r{flex:1;height:1px;min-width:8px;background:currentColor;opacity:.26}
.wb__bhd__n{flex:none;font-family:var(--font-mono,ui-monospace);font-variant-numeric:tabular-nums;opacity:.8}
/* Die Stufenfarben. --hot ist auf dieser Seite der dritte Akzent (Violett) und
   traegt „episch"; „legendaer" braucht einen Ton, den die Palette nicht hat —
   er steht deshalb als einziger Literalwert hier. */
.wb__bhd--legendary,.wb__tile--legendary{--rar:#E0564B}
.wb__bhd--epic,.wb__tile--epic{--rar:var(--hot)}
.wb__bhd--rare,.wb__tile--rare{--rar:var(--accent-2)}
.wb__bhd--uncommon,.wb__tile--uncommon{--rar:var(--accent)}
.wb__bhd--common,.wb__tile--common{--rar:color-mix(in srgb,var(--muted) 78%,transparent)}
.wb__bhd--none,.wb__tile--none{--rar:color-mix(in srgb,var(--muted) 42%,transparent)}
/* Zwei Zeilen: oben der Name ueber die GANZE Breite (vorher teilte er sie mit
   nichts, war aber auf 54 px gedrueckt, weil der Stern rechts darueber lag),
   unten Signatur und Anheft-Knopf nebeneinander. */
.wb__tile{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;
  grid-template-rows:auto auto;gap:1px 6px;align-content:center;
  /* Kachel als Ableseposten: kantig (Radius 3), eingelassen statt aufgelegt.
     Groesse, Raster und Polsterung unveraendert — nur die Oberflaeche. */
  padding:5px 6px 5px 9px;border-radius:3px;cursor:pointer;
  background:color-mix(in srgb,var(--ink) 48%,transparent);
  /* Erster Schatten = der Stufenrand. Er wiederholt, was die Bandueberschrift
     sagt, damit die Stufe auch dann noch an der Kachel steht, wenn ihre
     Ueberschrift aus dem Bild gescrollt ist. --rar kommt von .wb__tile--*. */
  box-shadow:inset 3px 0 0 var(--rar,transparent),
    inset 0 1px 0 color-mix(in srgb,var(--text) 7%,transparent),
    inset 0 0 0 1px color-mix(in srgb,var(--text) 5%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__tile:hover{background:color-mix(in srgb,var(--surface-2) 88%,var(--text))}
/* Der Stufenrand bleibt auch in der Auswahl stehen — sonst verlaere genau die
   Kachel, auf die man sieht, ihre Stufenangabe. */
.wb__tile.is-sel{background:color-mix(in srgb,var(--accent-2) 20%,transparent);
  box-shadow:inset 3px 0 0 var(--rar,transparent),inset 0 0 0 1px var(--accent-2)}
/* Kachel-Markierung „kommt an diesem Fundort vor" (Phase 12, D-09). Eigene
   Bildebene (pointer-events:none, 10x10 px) statt einer ganzflaechigen
   Toenung oder eines Rings -- beides kollidierte mit der Flaechentoenung
   und dem Innenring von .is-sel (oben) sowie mit dem 28x28-Feld von
   .wb__pin (rechter Kachelrand, Z. 568 unten). Ecke OBEN LINKS -- gegenueber
   der Panel-eigenen Schraege aus .chamf::after (oben rechts), damit beide
   nicht verwechselt werden. Farbton var(--accent), NICHT der zweite,
   andernorts fuer "an/ausgewaehlt/angeheftet" reservierte Akzentton (siehe
   Kopfkommentar dieses Stilblocks) -- "kommt hier vor" ist eine
   Dateninformation wie die Signaturzahl (.wb__ts, ebenfalls var(--accent)),
   keine Auswahl. Token-basiert (var(--accent) im Verlauf) -- aendert sich
   mit der Palette mit, deshalb braucht build-light-overrides.mjs (PROPS,
   ohne background) hierfuer keine eigene Hellmodus-Entsprechung. */
/* ⚠ 16.08.2026 von OBEN LINKS nach OBEN RECHTS gespiegelt. Nicht aus
   Geschmack: seit die Kachel links einen 3 px breiten Stufenrand traegt,
   sassen beide Marken auf denselben zehn Bildpunkten — die Fundort-Ecke
   schnitt ein Stueck aus dem Stufenrand heraus, und in der Lupe las das
   Ergebnis als Zeichenfehler, nicht als zwei Aussagen. Jetzt gehoert die
   linke Kante der Stufe, die rechte obere Ecke dem Fundort. Der
   Anheft-Knopf sitzt unten rechts und wird nicht gestreift. */
.wb__tile.is-here::before{content:'';position:absolute;top:-1px;right:-1px;
  width:10px;height:10px;pointer-events:none;border-radius:0 8px 0 0;
  background:linear-gradient(45deg,transparent 0 50%,var(--accent) 50% 100%)}
.wb__tn{grid-column:1/-1;display:flex;align-items:baseline;gap:4px;min-width:0;
  font-size:var(--fs-5);font-weight:500;color:var(--text)}
.wb__tn__n{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* „+ROC" / „+Hand" an dem einen Erz, das zwei Abbauarten traegt: es steht in
   BEIDEN Gruppen, und ohne diesen Hinweis sieht die zweite Kachel wie ein
   Doppeleintrag aus. */
.wb__talso{flex:none;font-size:var(--fs-1);font-weight:600;letter-spacing:var(--ls-5);
  color:color-mix(in srgb,var(--muted) 90%,transparent)}
.wb__ts{align-self:center;font-size:var(--fs-3);color:var(--hot);
  text-shadow:0 0 7px color-mix(in srgb,var(--hot) 60%,transparent)}
/* ⚠ Zwei Fehlschlaege stecken in diesem Knopf, beide vom Nutzer gemeldet:
   erst war er unsichtbar (opacity:0 + :hover — auf Touch existiert er dann
   gar nicht), dann mit 28 px Tippziel „zu schwer". Er ist jetzt ein eigenes
   Feld in der Kachel statt ein Aufkleber in der Ecke: 28x28 sichtbar, ueber
   das Pseudo-Element 40x36 greifbar, und er verschiebt nichts mehr, weil das
   Raster ihm seine Spalte gibt. Dauerhaft sichtbar, nur zurueckgenommen. */
.wb__pin{grid-column:2;align-self:center;width:28px;height:28px;display:grid;place-items:center;
  border:0;background:color-mix(in srgb,var(--ink) 34%,transparent);
  color:color-mix(in srgb,var(--muted) 78%,transparent);
  cursor:pointer;border-radius:7px;line-height:0;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__pin__i{width:15px;height:15px;pointer-events:none}
/* Tippziel ueber die sichtbare Flaeche hinaus. Nach aussen begrenzt die
   Kachelkante, weil dort die Nachbarkachel obenauf liegt — deshalb 6 px
   Polsterung rechts statt buendig. */
.wb__pin::before{content:'';position:absolute;inset:auto -6px -5px auto;width:40px;height:36px}
.wb__tile:hover .wb__pin{background:color-mix(in srgb,var(--ink) 55%,transparent);color:var(--text)}
/* Angeheftet ist ein Zustand, kein Zeichenwechsel: dieselbe Sprache wie
   .wb__chip.is-on und .wb__pinbig.is-on — gefuellte Flaeche in --accent-2. */
.wb__pin.is-on{background:var(--accent-2);color:var(--ink)}
.wb__tile:hover .wb__pin.is-on{background:var(--accent-2);color:var(--ink)}

/* ---------------- Spalte 2 ---------------- */
/* flex:0 0 auto: sonst staucht die Kopfzeile, wenn die Fundortliste unten
   lang wird (bis zu 27 Fundorte je Erz, gemessen 15.08.2026). */
.wb__id{padding:11px 14px 9px;flex:0 0 auto}
.wb__idrow{display:flex;align-items:flex-start;gap:10px}
.wb__id h2{font-size:var(--fs-13);font-weight:600;line-height:1.05;margin:0;color:var(--text);letter-spacing:var(--ls-1)}
.wb__tags{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}
.wb__tag{font-size:var(--fs-3);padding:2px 7px;border-radius:999px;
  background:color-mix(in srgb,var(--ink) 30%,transparent);color:var(--muted)}
.wb__tag.is-rar{background:color-mix(in srgb,var(--accent-2) 18%,transparent);color:var(--accent-2)}
.wb__sigbox{margin-left:auto;text-align:right}
/* Der Signaturwert ist der EINE Messwert des Geraets — er bekommt eine
   geaetzte Wanne mit Zeilenraster und Glimmen statt nur einer Farbe. Groesse
   und Position unveraendert. */
.wb__sigbox b{display:block;font-size:var(--fs-11);color:var(--hot);font-weight:700;
  line-height:1.1;margin-top:1px;padding:2px 9px;border-radius:3px;
  font-family:var(--font-mono,ui-monospace);font-variant-numeric:tabular-nums;
  letter-spacing:var(--ls-5);
  text-shadow:0 0 12px color-mix(in srgb,var(--hot) 55%,transparent);
  background:
    repeating-linear-gradient(0deg,
      color-mix(in srgb,var(--ink) 55%,transparent) 0 1px, transparent 1px 3px),
    color-mix(in srgb,var(--ink) 62%,transparent);
  box-shadow:inset 0 2px 5px color-mix(in srgb,var(--ink) 80%,transparent),
    inset 0 0 0 1px color-mix(in srgb,var(--hot) 22%,transparent)}
/* Grosser Anheft-Knopf am gewaehlten Erz — der bequeme Weg in die
   Signaturenliste. Deckender Grund ueber Variablen (Hellmodus, s. o.). */
.wb__pinbig{display:inline-flex;align-items:center;gap:7px;align-self:center;white-space:nowrap;
  padding:8px 13px;border:0;border-radius:9px;cursor:pointer;font-family:inherit;
  font-size:var(--fs-5);font-weight:600;color:var(--text);
  background:color-mix(in srgb,var(--ink) 34%,var(--surface));
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--text) 12%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__pinbig:hover{background:color-mix(in srgb,var(--accent-2) 24%,var(--surface))}
.wb__pinbig.is-on{background:var(--accent-2);color:var(--ink);box-shadow:none}
.wb__pinbig__i{width:17px;height:17px;flex:0 0 auto}

/* ---------------- Fundort-Kopf (Phase 12, D-01/D-11) ---------------- */
/* .wb__id--loc erbt Polsterung und Zeilenstruktur von .wb__id UNVERAENDERT
   (11px 14px 9px) — das Hoehenbudget der Variable --wb-chrome (236px) laesst
   bei 1080p rund 2 px Luft, keine eigene Regel hier. */
.wb__locsub{font-size:var(--fs-3);color:color-mix(in srgb,var(--muted) 88%,transparent);margin-top:6px}
/* Bauform von .wb__pin (Z. 535-544 oben), aber KEIN Umschalter: kein is-on,
   kein aria-pressed. Ruhezustand neutral, Hover wortgleich zu
   .wb__tile:hover .wb__pin — kein --accent-2 hier (der ist site-weit fuer
   "an/ausgewaehlt/angeheftet" reserviert). */
.wb__back{flex:0 0 auto;width:28px;height:28px;display:grid;place-items:center;
  border:0;background:color-mix(in srgb,var(--ink) 34%,transparent);
  color:color-mix(in srgb,var(--muted) 78%,transparent);
  cursor:pointer;border-radius:7px;line-height:0;position:relative;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__back:hover{background:color-mix(in srgb,var(--ink) 55%,transparent);color:var(--text)}
/* Vergroessertes Tippziel, dieselbe Loesung wie bei .wb__pin::before. */
.wb__back::before{content:'';position:absolute;inset:-4px -6px}
.wb__back__i{width:17px;height:17px;pointer-events:none}
/* [hidden] NACH den Grundregeln notieren — die Datei hat den umgekehrten
   Fall bereits zweimal bezahlt (s. Kommentar bei .wb__pre__pick[hidden]). */
#wb-lochead[hidden],#wb-locview[hidden],#wb-oreview[hidden]{display:none}

.wb__sec{padding:0 14px 11px}
/* Abschnittsmarken als GRAVIERTE Schilder: Mono, Versalien, weit gesperrt,
   mit einem hellen Kantenlicht unter der Grundlinie. Nur Schriftbild — Groesse
   und Platz bleiben, wie sie waren. */
.wb__sec h4{font-size:var(--fs-3);font-weight:600;
  font-family:var(--font-mono,ui-monospace);letter-spacing:var(--ls-14);text-transform:uppercase;
  color:color-mix(in srgb,var(--muted) 96%,transparent);
  margin:0 0 7px;padding-bottom:5px;position:relative}
.wb__sec h4::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;
  background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--text) 14%,transparent) 0 1px,transparent 1px 7px)}
.wb__locs,.wb__refs{display:flex;flex-direction:column;gap:3px}
/* Zeilen als Ableseposten auf dem Schirm: kantiger (Radius 3 statt 7) und mit
   einer feinen Lichtkante oben, damit sie im Schirm liegen statt darauf.
   Polsterung und Raster unveraendert. */
.wb__row2{display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;
  padding:5px 9px;border-radius:3px;background:color-mix(in srgb,var(--ink) 46%,transparent);
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--text) 6%,transparent)}
.wb__row2 .p{font-size:var(--fs-5);font-weight:500;color:var(--text);display:block;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__row2 .s{font-size:var(--fs-3);color:color-mix(in srgb,var(--muted) 88%,transparent);display:block;margin-top:1px}
.wb__row2 .r{display:flex;align-items:center;gap:8px}
/* Nadelknopf je Fundort-Zeile — dieselbe Sprache wie .wb__pin.is-on (D-05):
   gefuellte Flaeche in --accent-2, dunkles Symbol. Kleiner als .wb__pin
   (22 statt 28 px), weil er neben Balken und Prozentwert in der Zeile steht,
   nicht wie dort allein in einer Kachelspalte. Steht NUR in Fundort-Zeilen —
   row2() erhaelt den siebten Parameter (pinKey) ausschliesslich beim
   Zeichnen der Fundorte, die Stationszeilen bleiben sechsstellig. */
.wb__lpin{flex:0 0 auto;width:22px;height:22px;display:grid;place-items:center;border:0;
  background:color-mix(in srgb,var(--ink) 34%,transparent);
  color:color-mix(in srgb,var(--muted) 78%,transparent);
  cursor:pointer;border-radius:6px;line-height:0;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__lpin__i{width:13px;height:13px;pointer-events:none}
.wb__lpin.is-on{background:var(--accent-2);color:var(--ink)}
/* Gefraeste Spur mit gezaehnter Fuellung statt glattem Balken. */
.wb__bar{width:46px;height:5px;border-radius:3px;overflow:hidden;
  background:color-mix(in srgb,var(--ink) 55%,transparent);
  box-shadow:inset 0 1px 2px color-mix(in srgb,var(--ink) 70%,transparent)}
.wb__bar i{display:block;height:100%;
  background:repeating-linear-gradient(90deg,var(--hot) 0 3px,transparent 3px 5px);
  filter:drop-shadow(0 0 4px color-mix(in srgb,var(--hot) 70%,transparent))}
.wb__bar.amber i{background:repeating-linear-gradient(90deg,var(--accent-2) 0 3px,transparent 3px 5px)}
/* 44 px reichten fuer „28–78 %" nicht: die Spanne brach ueber drei Zeilen um
   (und stand vor der Rundung ohnehin als 28.29999923 da). */
.wb__row2 em{font-size:var(--fs-4);color:var(--muted);font-style:normal;width:58px;text-align:right;
  white-space:nowrap;font-family:var(--font-mono,ui-monospace)}
/* Die in der Rig-Leiste gewaehlte Station. */
.wb__row2.is-pick{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent-2) 60%,transparent)}
/* Klickbare Fundort- UND Erzzeile (Phase 12, D-01/D-02) — wortgleicher
   Hover zu .wb__tile:hover, damit "hier kann man klicken" nicht wie
   "ausgewaehlt" aussieht (--accent-2 bleibt fuer Zustaende reserviert).
   Beide Attribute (data-loc, data-ore) teilen sich EINEN Regelblock statt
   die Werte zweimal zu schreiben -- Stationszeilen tragen keins von beiden
   und bleiben dadurch ohne Zeigerhand. */
.wb__row2[data-loc],.wb__row2[data-ore]{cursor:pointer;transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__row2[data-loc]:hover,.wb__row2[data-ore]:hover{background:color-mix(in srgb,var(--surface-2) 88%,var(--text))}
/* Zeilenkopf fuer den Fall mit Abzeichen (Spur, D-07) — .p behaelt seine
   Ellipsenkuerzung, weil sie nicht mehr allein die Flex-Breite traegt. */
.wb__nm{display:flex;align-items:center;gap:6px;min-width:0}
.wb__nm .p{min-width:0}
/* Spurenerze (Hoechstanteil <= 10 %, D-07): Daempfung AUSSCHLIESSLICH ueber
   color-mix()/opacity, NIE ueber eine gedimmte Flaeche -- build-light-
   overrides.mjs (PROPS) deckt kein `background` ab, der Hellmodus bekaeme
   sonst lautlos keine Entsprechung. Die Zeilen-Flaeche (.wb__row2 background)
   bleibt unveraendert; nur Text, Unterzeile, Prozentzahl und Balken daempfen.
   Die Werte 82 %/90 % sind GEMESSEN (scripts/probes/mining-locview-messung.mjs,
   15.08.2026, am gerenderten Bildpunkt in beiden Farbmodi) -- die Startwerte
   62 %/65 % aus dem UI-SPEC waren ausdruecklich kein Freigabewert und lagen
   bei der Unterzeile real bei nur 2,9:1 bis 3,4:1 (Marke 4,5:1). Schlechtester
   gemessener Wert bei 82 %/90 %: Unterzeile hell 4,91:1. */
.wb__row2.is-trace .p{color:color-mix(in srgb,var(--text) 82%,transparent)}
.wb__row2.is-trace .s{color:color-mix(in srgb,var(--muted) 90%,transparent)}
.wb__row2.is-trace em{color:color-mix(in srgb,var(--muted) 90%,transparent)}
.wb__row2.is-trace .wb__bar{opacity:.6}
/* Das Abzeichen selbst bleibt bei voller Deckkraft -- es ist das Signal,
   nicht das Gedaempfte. Eigene Modifikatorklasse, NICHT .wb__tag.is-rar
   (Seltenheitsstufe) und NICHT --accent-2 (reserviert fuer "an/ausgewaehlt").
   line-height:1 (Fund 15.08.2026, scripts/probes/mining-locview-messung.mjs,
   Backstop E5/long-text): das geerbte .wb__tag benutzt die Komponentenbasis
   1.3 (15,21px bei 11,7px Schrift) + 2px Innenabstand oben/unten = 19,2px --
   hoeher als die 17,55px einer .p-Zeile. In der Fundort-Ansicht sitzen Name
   und Abzeichen zum ERSTEN MAL in derselben Flex-Zeile (.wb__nm), dort macht
   das Abzeichen die Zeile 1,6px hoeher als eine gewoehnliche -- gemessen an
   JEDER Spurenzeile, nicht nur bei langen Namen. line-height:1 (11,7px + 4px
   Innenabstand = 15,7px) bleibt unter den 17,55px von .p, die Zeilenhoehe
   gleicht sich wieder an. Nur die is-trace-Zeilenmarke, nicht das geerbte
   .wb__tag selbst (das lebt auch ausserhalb dieser Zeile, z. B. #wb-tags). */
.wb__tag.is-trace{background:color-mix(in srgb,var(--muted) 22%,transparent);color:var(--muted);line-height:1}
.wb__links{display:flex;gap:6px;flex-wrap:wrap}
.wb__link{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:7px;
  background:color-mix(in srgb,var(--ink) 28%,transparent);color:var(--text);
  font-size:var(--fs-5);text-decoration:none;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__link:hover{background:color-mix(in srgb,var(--accent) 22%,transparent)}
.wb__link b{color:var(--accent-2);font-family:var(--font-mono,ui-monospace)}

/* ---------------- Spalte 3 ---------------- */
/* ⚠ Reiterleiste und Scanwert-Feld sind in Phase 10 (D-04) ausgebaut worden —
   beide Listen stehen jetzt gestapelt in der rechten Spalte. Beim Merge des
   Gehaeuse-Zweiges am 15.08.2026 stand hier deren alte Fassung samt violettem
   Scanwert-Feld; sie ist bewusst NICHT wiedergekommen. Violett traegt jetzt
   die Kachelsignaturen, den grossen Signaturwert und die Anteilsbalken. */
/* Preset-Zeile. Zwei Zustaende teilen sich denselben Platz (Auswahl bzw.
   Namenseingabe) — beide sind eine Zeile hoch, damit die Spalte nicht
   springt, wenn man auf „+" drueckt. Kopfpolsterung wie die Filterleiste in
   Spalte 1: seit Phase 10 (D-03) faellt die frühere Reiterleiste darueber
   weg, die Zeile sitzt jetzt direkt am Spaltenrand. */
.wb__pre{flex:0 0 auto;padding:7px 9px 6px}
.wb__pre__row{display:flex;gap:5px;align-items:center}
.wb__pre__row[hidden]{display:none}
/* Presetzeile als senkrechter Block statt <select> (D-05): Kopfzeile
   (Beschriftung + "+") ueber der sichtbaren Liste. ⚠ Reihenfolge ist
   Pflicht: [hidden] MUSS NACH der display-Regel stehen, sonst schlaegt
   display:flex das hidden-Attribut (Pitfall 2, s.o. bereits zweimal geloest). */
.wb__pre__pick{display:flex;flex-direction:column;gap:6px}
.wb__pre__pick[hidden]{display:none}
.wb__pre__bar{display:flex;align-items:center;gap:6px}
.wb__pre__bar .wb__pre__b{margin-left:auto}
.wb__pre__list{display:flex;flex-direction:column;gap:2px}
.wb__pre__in{flex:1;min-width:0;border:0;border-radius:7px;font-family:inherit;
  font-size:var(--fs-4);padding:6px 8px;color:var(--text);
  /* Deckend mischen — ein halbtransparenter Grund vererbt sich in Chrome an
     die aufgeklappte Liste und rechnet sie ueber Weiss unleserlich. */
  background:color-mix(in srgb,var(--ink) 34%,var(--surface))}
.wb__pre__b{flex:0 0 auto;width:28px;height:28px;display:grid;place-items:center;border:0;
  border-radius:7px;cursor:pointer;font-family:inherit;font-size:var(--fs-6);line-height:1;
  background:color-mix(in srgb,var(--ink) 34%,transparent);color:var(--muted);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__pre__b:hover:not(:disabled){background:color-mix(in srgb,var(--accent) 22%,transparent);color:var(--text)}
.wb__pre__b.is-go{background:color-mix(in srgb,var(--accent-2) 22%,transparent);color:var(--accent-2)}
.wb__pre__msg{margin:5px 0 0;font-size:var(--fs-3);color:var(--accent-2)}
.wb__pre__msg[hidden]{display:none}
.wb__pre__guest{margin:0;font-size:var(--fs-3);line-height:1.4;
  color:color-mix(in srgb,var(--muted) 88%,transparent)}
.wb__pre__guest[hidden]{display:none}
.wb__pre__guest a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}

/* Zwei gestapelte Listen (D-03) statt zwei Reiterkoerper: Signaturen und
   Fundort-Merkliste teilen sich die Resthoehe der Spalte, jede mit eigener
   Ueberschrift und eigenem Bildlauf. flex:1 1 0 UND min-height:0 sind an
   .wb__sec2 beide Pflicht — ohne die Null-Basis bekaeme der erste Kasten
   die ganze Resthoehe, ohne min-height:0 wuechse er ueber seinen Elternteil
   hinaus statt innen zu scrollen (dasselbe Muster traegt bereits .wb__pane
   weiter oben). */
.wb__stack{display:flex;flex-direction:column;flex:1;min-height:0}
.wb__sec2{display:flex;flex-direction:column;flex:1 1 0;min-height:0;padding:0 0 4px}
.wb__sec2 h4{flex:0 0 auto;font-size:var(--fs-4);font-weight:600;
  color:color-mix(in srgb,var(--muted) 88%,transparent);
  margin:0;padding:9px 10px 6px;position:relative}
.wb__sec2 h4::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;
  background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--text) 14%,transparent) 0 1px,transparent 1px 7px)}

/* ---------------- Auslagern in ein eigenes Fenster (16.08.2026) ----------
   Die Spalte kann in ein echtes, frei verschiebbares Betriebssystem-Fenster
   umziehen (Document Picture-in-Picture, sonst window.open) — gedacht fuer
   den zweiten Bildschirm neben dem laufenden Spiel.
   ⚠ Diese Regeln muessen HIER stehen, nicht als JS-Zeichenkette: das
   Fremdfenster bekommt saemtliche <style>- und <link>-Elemente dieser Seite
   kopiert, also gilt dort dasselbe Blatt. Eine zweite, per JS gebaute
   Stilquelle waere die uebliche Falle „im Fremdfenster sieht es anders aus".

   Knopf: absolut in der Spaltenecke. `right:10px` statt buendig, damit er
   nicht unter die 14 px grosse Fase von .chamf::after (z-index:3) laeuft. */
.wb__popb{position:absolute;top:6px;right:10px;z-index:2;
  width:24px;height:24px;display:grid;place-items:center;border:0;border-radius:7px;
  cursor:pointer;color:var(--muted);
  background:color-mix(in srgb,var(--ink) 34%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__popb:hover{background:color-mix(in srgb,var(--accent) 22%,transparent);color:var(--text)}
.wb__popb svg{pointer-events:none}
.wb__popb[hidden]{display:none}

/* Die Presetzeile weicht dem Knopf rechts aus (10 + 24 + 6 px Luft). */
.wb__pre{padding-right:40px}

/* Traegt im Fremdfenster die Hoehenkette, die sonst .wb__pre/.wb__stack
   direkt gegen die Spalte aufbauen — ohne sie scrollen die Listen dort
   nicht mehr, sondern wachsen aus dem Fenster heraus. */
.wb__popbody{display:flex;flex-direction:column;flex:1;min-height:0}

/* Platzhalter in der Spalte, solange die Listen draussen sind. */
.wb__popslot{display:flex;flex-direction:column;align-items:flex-start;gap:10px;
  flex:1;min-height:0;padding:14px 12px;font-size:var(--fs-3);
  color:color-mix(in srgb,var(--muted) 88%,transparent)}
.wb__popslot p{margin:0;line-height:1.45}
.wb__popslot__b{border:0;border-radius:7px;cursor:pointer;font-family:inherit;
  font-size:var(--fs-3);padding:7px 11px;color:var(--accent-2);
  background:color-mix(in srgb,var(--accent-2) 20%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__popslot__b:hover{background:color-mix(in srgb,var(--accent-2) 32%,transparent);color:var(--text)}
/* ⚠ NACH der display-Regel — sonst schlaegt display:flex das hidden-Attribut
   (dieselbe Falle steht bei .wb__pre__pick schon einmal aufgeschrieben). */
.wb__popslot[hidden]{display:none}

/* Im Fremdfenster traegt die Werkbank-Huelle das GANZE Fenster. Die
   Randlos-Regeln von .wb (100vw, negative Raender, Polsterung, Rasterhoehe
   aus dem Seitenverhaeltnis des Gehaeuses) sind auf einen Textkoerper
   gemuenzt, den es dort nicht gibt.
   ⚠ Erste Fassung (16.08.2026) setzte hier zusaetzlich `border-radius:0`,
   `box-shadow:none` und blendete die Fase aus — und nahm dem Fenster damit
   GENAU die drei Merkmale, an denen man dieses Bauteil erkennt. Der
   Betreiber dazu: „fenster spricht nicht unsere design sprache". Zu Recht:
   uebrig blieb ein dunkles Rechteck. Jetzt umgekehrt — das Fenster ist ein
   herausgeloestes Stueck des GERAETS und bekommt dessen Schichtung: schmaler
   Gehaeuserand aussen, darin das eingelassene Anzeigefeld mit Lichtstrich an
   der Oberkante (die box-shadow von .wb__pane bleibt also stehen) und der
   angeschraegten Ecke oben rechts.
   ⚠ KEIN Nachbau des gefraesten Blechs: dass CSS-Verlaeufe und SVG-Filter
   dafuer nicht reichen, ist im Gehaeuse-Durchgang vorgefuehrt und
   aufgeschrieben worden, und die Rahmengrafik traegt ein FESTES
   Seitenverhaeltnis, das ein frei groessenveraenderliches Fenster nicht hat.
   Was hier steht, ist das, was in reinem CSS ehrlich zu haben ist. */
/* ⚠ KEIN eigener `background` hier — die Huelle traegt im Fremdfenster
   zusaetzlich die Klasse .wb__cscreen (s. mining-workbench.js), und deren
   Schichtstapel IST der Bildschirm. Ein Grundton an dieser Stelle stuende
   spaeter im Blatt und wuerde ihn still ueberdecken. Die 8 px Polsterung
   sind dieselben 8 px, mit denen die Paneele in der Werkbank auf dem Schirm
   schwimmen (`.wb__cscreen{gap:8px}`) — der Rand des Fensters ist also
   sichtbarer Schirm, kein Rahmen aus dem Nichts. */
.wb--pop{box-sizing:border-box;width:100%;height:100%;margin:0;gap:0;padding:8px}
.wb--pop .wb__pane{height:100%}

/* ⚠⚠ Das Fremdfenster ist SCHMAL, aber es ist ein MAUS-Fenster auf dem
   Schreibtisch — keine Handflaeche. Die globale Fingerregel
   `@media(max-width:820px){button,[role="button"],input[type="submit"],
   input[type="button"],summary{min-height:44px;display:inline-flex;
   align-items:center;justify-content:center}}` haengt an der FENSTERBREITE,
   nicht am Zeigegeraet, und greift deshalb hier mit voller Wucht.
   Gemessen am 16.08.2026, Seite gegen Fenster: die Presetkarte wuchs von 55
   auf 103 px, die ganze Presetzeile von 105 auf 169, und der Name sprang von
   18 auf 44 px Hoehe UND in die Mitte. Betreiber: „presets viel zu gross".
   Zurueckgenommen wird NUR an den Knoepfen, die sichtbar aufblaehen, und nur
   in den Eigenschaften, die die Fingerregel setzt:
     · ⚠ KEIN Sammelselektor `.wb--pop button{…}`. Der schluege mit (0,1,1)
       die Bauteilregeln mit (0,1,0) — `align-items` daran raubte .wb__pre-a
       und .wb__pre__b ihr `place-items:center`, und die Symbole klebten
       oben in ihrer Rasterzelle. Vorgefuehrt, nicht vermutet.
     · ⚠ Die VERGROESSERTEN TIPPZIELE bleiben unangetastet: die sitzen in
       .wb__pin-top button::before / .wb__pre-ent button::before und sind
       Pseudo-Elemente — von min-height unberuehrt. Ein Klick daneben darf
       auch hier nicht den Fundort oeffnen.
     · .wb__pin-item[data-loc] traegt ebenfalls role="button" und behaelt
       seine 44 px bewusst: die Zeile ist ohnehin hoeher, und sie ist der
       eine Ort, an dem ein Fehlgriff etwas Falsches TUT. */
.wb--pop .wb__pre-name,.wb--pop .wb__pre-cnt,.wb--pop .wb__pre-a,
.wb--pop .wb__pre__b,.wb--pop .wb__pre-ent button,
.wb--pop .wb__pin-top button{min-height:0}
/* Nur die zwei Textknoepfe: die Fingerregel zentriert ihre Beschriftung.
   Bei den Symbolknoepfen daneben kommt die Zentrierung aus place-items und
   muss bleiben. */
.wb--pop .wb__pre-name,.wb--pop .wb__pre-cnt{justify-content:normal;align-items:normal}

/* Eine Preset-Zeile — Vorbild .wb__pin-item (Name+Aktion-Zeile), Auswahl-
   zustand wortgleich zu .wb__tile.is-sel (D-05). */
/* ⚠ Gestrafft am 16.08.2026 („presets viel zu gross allgemein"). Die Karte
   ist ein Listeneintrag, kein Steckbrief: sie stand mit 12 px Polsterung,
   18 px Name, 3 px Luft und 22 px Symbolreihe bei 55 px, die ganze
   Presetzeile bei 105 — ein Sechstel der Spalte fuer EIN Preset.
   Jede Stelle einen Schritt zurueck, der AUFBAU bleibt: Name auf eigener
   Zeile, darunter Zaehlzeile und Aktionen.
   ⚠ BEWUSST NICHT auf eine Zeile zusammengelegt, obwohl das am meisten
   spart: dann stuende der Loesch-Muelleimer unmittelbar neben der
   Namensflaeche, die das Preset AUSWAEHLT. Das Bauteil hat am selben Tag
   Aufwand darauf verwendet, dass ein Fehlgriff nicht das Falsche loescht
   (.wb__pre-ent button::before, -2px statt -3px) — diesen Gewinn fuer
   ein paar Pixel wieder herzugeben waere ein schlechter Tausch. */
.wb__pre-item{padding:5px 7px;border-radius:7px;background:color-mix(in srgb,var(--ink) 22%,transparent)}
.wb__pre-item.is-sel{background:color-mix(in srgb,var(--accent-2) 20%,transparent);
  box-shadow:inset 0 0 0 1px var(--accent-2)}
.wb__pre-top{display:flex;align-items:center;gap:6px}
.wb__pre-act{display:flex;align-items:center;gap:4px;margin-top:2px}
.wb__pre-name{flex:1;min-width:0;border:0;background:0;padding:0;margin:0;text-align:left;
  font-family:inherit;font-size:var(--fs-4);color:var(--text);cursor:pointer;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* Zaehlzeile — seit D-02 Form 3 zugleich der Aufklapp-Griff: die Zahl selbst
   ist der Griff (button statt span), aria-expanded traegt den Zustand. Kein
   Klappzeichen aus einer Schriftart. */
.wb__pre-cnt{margin-right:auto;border:0;background:0;padding:0;font-family:inherit;text-align:left;
  cursor:pointer;font-size:var(--fs-3);color:color-mix(in srgb,var(--muted) 88%,transparent);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__pre-a{flex:0 0 auto;width:20px;height:20px;display:grid;place-items:center;border:0;
  border-radius:6px;cursor:pointer;background:color-mix(in srgb,var(--ink) 34%,transparent);
  color:color-mix(in srgb,var(--muted) 78%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__pre-a:hover{background:color-mix(in srgb,var(--accent) 22%,transparent);color:var(--text)}
.wb__pre-a svg{width:13px;height:13px;pointer-events:none}
/* Loeschen (D-01): eigenes Symbol (Muelleimer statt ×), eigener
   Ueberfahren-Farbton — der Ruhezustand bleibt wie jeder andere
   Symbolknopf (.wb__pre-a), nur der Hover-Ton weicht ab. */
.wb__pre-a--del:hover{color:var(--accent-2)}
/* Beide Rueckfragen (Loeschen UND Ueberschreiben, seit 15.08.2026) ersetzen
   die ganze Aktionszeile ueber die volle Breite (statt in der 22-px-Ecke zu
   sitzen) und tragen als einzige Aktionen im Bauteil Worte statt eines
   Zeichens. Nur EINE steht je Zeile gleichzeitig (preAsk/preAskWhat in
   assets/mining-workbench.js) -- welche, entscheidet der Modifikator
   darunter, nicht diese Basisregel. */
.wb__pre-ask{width:100%;display:block;border:0;border-radius:7px;cursor:pointer;
  font-family:inherit;font-size:var(--fs-4);font-weight:600;padding:4px;color:var(--ink)}
/* ⚠ Die Worte stehen NICHT auf der Schraffur, sondern auf einer ruhigen
   Flaeche darin -- die Schraffur bleibt der Rahmen. Gemessen am Bildpunkt
   (nicht aus dem CSS geschaetzt): Schrift direkt auf den hellen Streifen-
   haelften ergab 2,6:1 (hell) bzw. 3,4:1 (dunkel) und riss damit AA (4,5:1
   bei 12,6 px). Auf --surface/--text gilt der site-weit gepruefte
   Koerpertext-Kontrast. Der Warnwert der Schraffur bleibt erhalten, weil sie
   die Flaeche vollstaendig umschliesst. */
.wb__pre-ask>span{display:block;background:var(--surface);color:var(--text);
  border-radius:4px;padding:3px 6px}
/* Loeschen verwirft ENDGUELTIG und ohne jede Korrektur -- Warnschraffur wie
   .danger-card .dz-hazard in assets/account-dossier.css Zeile 380, in
   --accent-2 (Amber/Gold): kein Hex-Wert, kein neuer Token (⚠ var(--hot)
   ist auf dieser Seite KEINE Gefahrenfarbe, siehe src/components/topics/
   mining.astro Zeile 26: dort gleich --accent). */
.wb__pre-ask--del{background:repeating-linear-gradient(-45deg,var(--accent-2) 0 9px,
    color-mix(in srgb,var(--accent-2) 55%,var(--ink)) 9px 18px)}
/* Ueberschreiben verwirft den gespeicherten Inhalt ebenso unwiederbringlich
   und bekommt deshalb dieselbe Warn-Bildsprache (Diagonalschraffur, Worte
   statt Zeichen) -- MUSS sich aber auf einen Blick von "Loeschen"
   unterscheiden lassen, sonst wiederholt sich genau der teuerste Befund
   dieser Phase (CONTEXT.md) nur an neuer Stelle. Deshalb --accent (Teal)
   statt --accent-2 (Amber/Gold): derselbe Kontrast zu --ink, ein anderer
   Farbton, wieder kein neuer Hex-Wert. */
.wb__pre-ask--upd{background:repeating-linear-gradient(-45deg,var(--accent) 0 9px,
    color-mix(in srgb,var(--accent) 55%,var(--ink)) 9px 18px)}
/* Aufklapp-Ansicht einer Preset-Zeile (D-02 Form 3): bleibt INNERHALB der
   Panelgrenzen -- .wb__pane traegt overflow:hidden und schneidet jede
   Overlay-Positionierung restlos weg (Pitfall 1, bereits einmal vorgefuehrt
   und zurueckgenommen). Die Klasse wb__scroll daneben liefert die sichtbare
   Bildlaufleiste, weil assets/mobile-ux.css sie klassenbasiert registriert
   -- kein neuer Eintrag dort noetig. */
.wb__pre-body{max-height:150px;margin-top:5px;display:flex;flex-direction:column;gap:2px}
.wb__pre-ent{display:flex;align-items:center;gap:6px;font-size:var(--fs-3);
  color:color-mix(in srgb,var(--muted) 92%,transparent);padding:2px 4px}
.wb__pre-ent span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__pre-ent button{margin-left:auto;position:relative;background:0;border:0;color:color-mix(in srgb,var(--muted) 80%,transparent);
  cursor:pointer;font-size:var(--fs-6);line-height:1;padding:0 2px}
/* Dasselbe zu kleine Kreuz (12,4 x 14,4 px) wie in der Merkliste daneben,
   deshalb dasselbe Mittel -- aber senkrecht deutlich zurueckhaltender, und
   das ist hier die eigentliche Entscheidung. Die Eintraege stehen dicht:
   19,2 px Zeile, 2 px Abstand, zwischen den Kreuzen zweier Nachbarzeilen
   liegen gemessen 6,8 px. Schon -3px stiessen die beiden Ziele bueendig
   aneinander -- dann loescht ein knapp danebengegangener Klick den FALSCHEN
   Eintrag, still. -2px laesst ein schmales totes Band (2,8 px) dazwischen:
   dort passiert nichts, und nichts ist bei einer loeschenden Schaltflaeche
   das bessere Ergebnis als das Falsche. Die Merkliste darf sich die vollen
   24 px nehmen, weil die Alternative dort nicht "falscher Eintrag geloescht"
   heisst, sondern "Fundort geht auf". Waagerecht begrenzt der Koerperrand
   (4 px), dort gibt es keinen Nachbarn. */
.wb__pre-ent button::before{content:'';position:absolute;inset:-2px -4px}

.wb__pin-item{padding:7px 9px;margin:0 6px 3px;border-radius:8px;
  background:color-mix(in srgb,var(--ink) 22%,transparent)}
/* Merklistenzeile klickbar (Phase 12, D-03) — dieselbe Klickbarkeit wie die
   Fundort-Zeile in der Mitte, wortgleicher Hover. data-loc traegt NUR diese
   Zeile: die Signaturen-Eintraege in #wb-pins benutzen dieselbe Klasse
   .wb__pin-item, aber ohne das Attribut -- die Selektor-Bedingung ist
   deshalb Pflicht, sonst bekaeme die Signaturenliste eine Klickbarkeit, die
   sie nicht hat. */
/* ⚠ `display:block` ist hier KEINE Zierde, sondern eine Reparatur. Die Zeile
   traegt role="button" (fuer die Tastatur, s.o.), und die globale Mobilregel
   `@media(max-width:820px){button,[role="button"],summary{display:inline-flex}}`
   macht daraus unterhalb von 820 px eine schrumpfende Inline-Schachtel:
   Name, Kreuz und Wertezeile stehen dann NEBENeinander in einer einzigen
   Zeile statt untereinander (gemessen 16.08.2026 bei 800 px: 404 statt 691 px
   breit). Das ist ein Fehler der ausgelieferten Seite auf Tablet und Handy,
   nicht erst im ausgelagerten Fenster — dort faellt er nur zwangslaeufig auf,
   weil ein ~360 px breites Fenster IMMER die Mobilfassung der Seite bekommt.
   Die Zeile ist optisch keine Schaltflaeche, sondern eine volle Listenzeile;
   das role-Attribut sagt nur, dass sie sich mit Enter bedienen laesst.
   Spezifitaet (0,2,0) schlaegt [role="button"] (0,1,0) unabhaengig von der
   Reihenfolge — eine Umsortierung der Blaetter kann das nicht kippen. */
.wb__pin-item[data-loc]{display:block;cursor:pointer;transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__pin-item[data-loc]:hover{background:color-mix(in srgb,var(--surface-2) 88%,var(--text))}
.wb__pin-top{display:flex;align-items:center;gap:7px}
.wb__pin-top .nm{font-size:var(--fs-5);font-weight:500;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__pin-top button{margin-left:auto;position:relative;background:0;border:0;color:color-mix(in srgb,var(--muted) 80%,transparent);
  cursor:pointer;font-size:var(--fs-6);line-height:1;padding:0 2px}
/* Vergroessertes Tippziel, dieselbe Loesung wie bei .wb__pin::before -- hier
   aber kein Feinschliff, sondern die Behebung eines gemeldeten Fehlers
   (Betreiber, 16.08.2026: „das Kreuz funktioniert nicht, der Fundort oeffnet
   sich"). Gemessen misst das Kreuz 12,4 x 14,4 px, die Zeile darum 268 x
   48,8 px. Seit Phase 12 (D-03) traegt die Merklistenzeile data-loc, ein
   Fehlgriff NEBEN das Kreuz oeffnet also den Fundort: von 49 Rasterpunkten
   im +/-18-px-Umfeld trafen nur 9 das Kreuz, 27 oeffneten den Fundort --
   schon 6 px ueber oder unter der Mitte. In der Signaturenliste faellt
   derselbe Fehlgriff nicht auf, weil die Zeile dort KEINE eigene Wirkung
   hat; daher der Eindruck „bei den Signaturen geht es, bei den Orten nicht".
   -5px/-6px heben das Ziel auf 24,4 x 24,4 px (WCAG 2.2, 2.5.8 Zielgroesse).
   Mehr geht nicht: 3,6 px unter dem Kreuz beginnt die Wertezeile .wb__lmeta,
   links schliesst der Name buendig an (.wb__pin-top{gap:7px}). */
.wb__pin-top button::before{content:'';position:absolute;inset:-5px -6px}
/* Wertezeile der Fundort-Merkliste (O-3): System links, Chance/Hoechstanteil
   rechts -- gebaut wie .wb__row2 .s und .wb__row2 em (Mono-Ziffern, gedaempfte
   Farbe), damit beide Ansichten derselben Werte gleich aussehen. Kein neuer
   Farbtoken: build-light-palettes.mjs kennt nur seine feste Namensliste. */
.wb__lmeta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:2px}
.wb__lmeta span{font-size:var(--fs-3);color:color-mix(in srgb,var(--muted) 88%,transparent);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__lmeta em{font-size:var(--fs-3);color:var(--muted);font-style:normal;
  font-family:var(--font-mono,ui-monospace);white-space:nowrap;flex:0 0 auto}
.wb__mult{display:flex;gap:3px;margin-top:5px}
/* Die Vielfachen sind derselbe Messwert wie .wb__sigbox b (Z. 1200), nur klein
   und in Reihe — sie leuchten deshalb wie dort: Phosphorglimmen und feste
   Ziffernbreite. Statt var(--muted) jetzt Terminalgruen: --accent (Teal)
   traegt hier die Bedienelemente und --hot den EINEN grossen Wert; ein
   dritter, eigener Ton haelt die Merkliste davon getrennt lesbar. Bewusst
   KEIN Paletten-Token, sondern eine bauteillokale Variable —
   build-light-palettes.mjs kennt nur seine feste Namensliste (gleicher Grund
   wie bei .wb__lmeta, Z. 1486); build-light-overrides.mjs zaehlt eigene
   Variablen dagegen mit und erzeugt die helle Entsprechung selbst.

   SCHRIFT: --font-body (Barlow), nicht mono — auf Ansage („was weicheres",
   16.08.). Vier Kandidaten am echten Bauteil gerendert und verglichen
   (Barlow / Rajdhani / Share Tech Mono / Teko); Barlow ist die runde,
   ruhige. Die feste Ziffernbreite kommt jetzt aus tabular-nums statt aus
   der Bauform der Schrift — und die Zellen sind ohnehin flex:1, die Spalten
   stehen also unabhaengig von der Textbreite.
   ⚠ Landmine nebenan: --font-mono ist auf DIESER Seite gar nicht gesetzt
   (das Werkzeug bringt keinen --font-*-Stapel mit). `var(--font-mono,
   ui-monospace)` fiel hier still auf Consolas durch — Share Tech Mono stand
   nie im Bild, obwohl der Token danach aussieht. .wb__lmeta em (Z. 1493)
   und .wb__sigbox b (Z. 1203) haengen unveraendert in derselben Falle.

   ⚠ KEIN Zeilenraster wie bei .wb__sigbox b. Das deckt dort var(--fs-11);
   auf var(--fs-3) zersaegt ein Raster die Glyphen — der Ort entscheidet,
   nicht die Staerke (Befund aus dem Bildschirmeffekt-Durchgang).
   ⚠ Auch KEINE Haarlinie in --phos wie dort. Vorgefuehrt und wieder
   abgeraeumt: einmal ist es EIN Messwert, hier stehen bis zu sechs Zellen
   in einer Reihe — die Umrandung machte aus jeder einen Knopf, den es
   nicht gibt. Der Grund bleibt die flache Wanne von vorher. */
.wb__mult i{--phos:#3dff6e;flex:1;font-family:var(--font-body,'Barlow',system-ui,sans-serif);
  font-size:var(--fs-3);font-weight:500;font-style:normal;text-align:center;
  padding:3px 0;border-radius:5px;
  color:var(--phos);font-variant-numeric:tabular-nums;letter-spacing:var(--ls-5);
  text-shadow:0 0 7px color-mix(in srgb,var(--phos) 45%,transparent);
  background:color-mix(in srgb,var(--ink) 40%,transparent)}
.wb__empty{padding:16px 12px;text-align:center;color:color-mix(in srgb,var(--muted) 88%,transparent);
  font-size:var(--fs-4);line-height:1.55;margin:0}

/* ---------------- Fusszeile ---------------- */
/* Hiess bis 12.08. „Rig" und trug Laser, Module, Gadget, Felsmasse, Station
   und das Messgeraet. Geblieben ist die Station; der Rest steht im
   Fracturing-Rechner. ⚠ Ein Umbruch dieser Zeile kostet Hoehe, und daran
   haengt ueber --wb-chrome, ob alle 37 Kacheln bei 1280x720 ohne Scrollen
   ins Bild passen — bei zwei Kindern ist das jetzt reichlich weit weg, war
   es mit sieben aber nicht (Messungen in
   .planning/notes/mining-werkbank-rigbalken.md). */
.wb__rig{flex:0 0 auto;flex-direction:row;align-items:center;gap:16px;flex-wrap:wrap;padding:9px 14px}
.wb__rgrp{flex:0 0 auto;display:flex;flex-direction:column;gap:3px}
/* ⚠ MUSS NACH der display-Regel stehen — sonst schlaegt display:flex das
   hidden-Attribut und die verborgene Stationswahl stuende weiterhin da.
   Dieselbe Falle ist in dieser Datei bereits bei .wb__pre__pick und
   .wb__popslot aufgeschrieben; sie ist hier zum dritten Mal einschlaegig. */
.wb__rgrp[hidden]{display:none}
.wb__rig::before{content:'';position:absolute;left:0;right:0;top:0;height:2px;
  background:repeating-linear-gradient(90deg,var(--accent-2) 0 5px,transparent 5px 10px);opacity:.5}
/* ⚠ Der Grund MUSS deckend sein. Mit `…,transparent)` steht das Feld auf
   Alpha 0,34 — und Chrome vererbt den Grund an die aufgeklappte Liste, die
   dadurch durchscheinend ueber dem Seiteninhalt liegt (gemeldet als „beim
   ersten Oeffnen optisch verbuggt"). Die `<option>` selbst hatten gar keinen
   Grund (rgba(0,0,0,0)). Beides ueber Variablen gemischt, nicht fest
   verdrahtet: build-light-overrides.mjs deckt `background` nicht ab. */
.wb__sel{background:color-mix(in srgb,var(--ink) 34%,var(--surface));border:0;color:var(--text);
  font-size:var(--fs-5);padding:6px 9px;cursor:pointer;max-width:260px;border-radius:7px;font-family:inherit}
.wb__sel option{background:var(--surface);color:var(--text)}

/* Der Weg zum Rechner. Kein Randhinweis, sondern die Antwort auf „wo ist die
   Brechbarkeit hin?" — deshalb mit Erznamen, Ziel und Pfeil. */
.wb__frac{margin-left:auto;display:flex;align-items:center;gap:11px;max-width:100%;
  padding:8px 13px;border-radius:9px;text-decoration:none;
  background:color-mix(in srgb,var(--ink) 30%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 30%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.wb__frac:hover{background:color-mix(in srgb,var(--accent) 16%,transparent)}
.wb__frac__ico{flex:0 0 auto;display:grid;place-items:center;color:var(--accent)}
.wb__frac__t{min-width:0;display:flex;flex-direction:column;line-height:1.25}
.wb__frac__t b{font-size:var(--fs-5);font-weight:600;color:var(--text)}
.wb__frac__t .wb__lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb__frac__go{flex:0 0 auto;font-size:var(--fs-4);font-weight:600;color:var(--accent);white-space:nowrap}

.wb__search:focus-visible,.wb__sel:focus-visible,.wb__chip:focus-visible,
.wb__pin:focus-visible,.wb__tile:focus-visible,.wb__link:focus-visible,
.wb__pre__in:focus-visible,.wb__pre__b:focus-visible,
.wb__pre-name:focus-visible,.wb__pre-cnt:focus-visible,.wb__pre-a:focus-visible,.wb__pre-ask:focus-visible,
.wb__frac:focus-visible,.wb__pinbig:focus-visible,.wb__lpin:focus-visible,
.wb__row2[data-loc]:focus-visible,.wb__row2[data-ore]:focus-visible,
.wb__pin-item[data-loc]:focus-visible,.wb__back:focus-visible,
/* Die zwei Knoepfe des Auslagerns (16.08.2026). Sie stehen hier NICHT
   der Vollstaendigkeit halber: die Liste ist der Ort, an dem dieses
   Bauteil seinen eigenen Fokusring vergibt, und ein Knopf, der
   stattdessen den Browser-Standardring bekaeme, faellt auf dem dunklen
   Paneel kaum auf. */
.wb__popb:focus-visible,.wb__popslot__b:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}
/* Das Sprite traegt nur <symbol> und darf keinen Platz belegen. */
.wb__sprite{position:absolute;width:0;height:0;overflow:hidden}

.wb__seg{display:none}
@media(max-width:1180px){
  .wb__grid{grid-template-columns:1fr;height:auto;flex:none}
  .wb__pane{height:min(62vh,560px)}
  /* ⚠ Fruehere Fassung schaltete das Gehaeuse hier AUS — bei festem
     Seitenverhaeltnis schrumpfte seine Bildflaeche auf schmalen Fenstern auf
     eine unbrauchbare Hoehe. Mit dem 9-Slice entfaellt der Grund: die
     Rahmenstaerke haengt nicht mehr an der Breite, und der Rahmen traegt auch
     bei 390 px. Er BLEIBT also an; hier wird nur der Inhalt einspaltig.
     Die frueheren Ruecksetzungen fuer Kopfband und Titel sind mit ihnen
     entfallen — beide Elemente gibt es nicht mehr. */
}
@media(max-width:760px){
  .wb__seg{display:flex;gap:5px;flex-wrap:wrap;padding-bottom:2px}
  .wb__pane{height:auto}
  .wb__scroll{max-height:70vh}
  .wb__grid.has-seg{display:block}
  .wb__grid.has-seg > .wb__pane{display:none}
  .wb__grid.has-seg.seg-list > .wb__pane:first-of-type{display:flex}
  .wb__grid.has-seg.seg-sig > .wb__pane:last-of-type{display:flex}
  /* Die Ansichtsspalte ist seit 15.08.2026 selbst ein normales Paneel statt
     eines eigenen Grid-Wrappers — die generische Zeile oben blendet sie also
     schon aus; hier braucht es nur noch das Wieder-Einblenden fuer seg-view.
     Ueber die Position (2. von 3 Paneelen) adressiert, wie die beiden
     Nachbarregeln mit :first-of-type/:last-of-type — nicht ueber ihren
     Klassennamen, den ein Stil-Kommentar sonst ein zweites Mal ins
     ausgelieferte HTML schriebe (is:inline zaehlt jedes Zeichen mit). */
  .wb__grid.has-seg.seg-view > .wb__pane:nth-of-type(2){display:flex}
  /* Untereinander statt nebeneinander: der Verweis auf den Rechner traegt
     drei Textstuecke und wird sonst zur Ellipsen-Wueste. */
  .wb__rig{gap:10px}
  .wb__rgrp,.wb__frac{width:100%}
  .wb__rgrp .wb__sel{max-width:none}
  .wb__frac{margin-left:0}
}
/* Hell-Entsprechungen — erzeugt von scripts/build-light-overrides.mjs. Nicht von Hand ändern. */
:root[data-theme="light"] .wb__bhd--legendary,.wb__tile--legendary{--rar:#a7040d}
:root[data-theme="light"] .wb__mult i{--phos:#016b24}
