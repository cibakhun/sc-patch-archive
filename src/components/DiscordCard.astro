---
// Geteilte Discord-Karte — die EINE Quelle für Markup, Text und Stil des
// Server-Hinweises (analog FeedbackForm). Startseite und Feedback-Seite in
// beiden Sprachen mounten dieselbe Karte.
//
// WORUM ES GEHT: Der Server ist die Werkstatt hinter verse-base.com — Fehler
// melden, mitbestimmen was als Nächstes gebaut wird. KEIN allgemeiner
// Star-Citizen-Server; davon gibt es genug, und wer mit dieser Erwartung
// kommt, geht enttäuscht wieder. Der Text sagt den engen Zweck deshalb
// ausdrücklich, statt „Community" zu versprechen.
//
// Die Karte trägt keine eigenen Farben: sie liest --accent/--surface/--line
// der jeweiligen Seite und steht damit auf der cyanfarbenen Startseite wie
// auf der bernsteinfarbenen Feedback-Seite richtig.
import { DISCORD } from '../consts';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;

// Seiten-spezifische Copy — kein wiederkehrender Chrome, deshalb lokal statt
// im UI-Katalog (dieselbe Trennung wie in FeedbackForm).
const COPY = {
  de: {
    kicker: 'Discord',
    title: 'Die Werkstatt hinter der Seite',
    body: 'Was hier gebaut wird, entsteht aus dem, was Spieler melden. Auf dem Server geht ein Fehlerbericht direkt an den, der die Werkzeuge schreibt — mit Rückfrage, wenn etwas unklar ist, und einer Nachricht, wenn es behoben ist.',
    scope: 'Es geht ausschließlich um VerseBase — kein allgemeiner Star-Citizen-Server.',
    lines: ['Fehler melden', 'Vorschlagen, was als Nächstes kommt', 'Patch-Notes, sobald sie da sind'],
    cta: 'Server beitreten',
    linkLabel: 'Einladung öffnen — führt zu Discord',
  },
  en: {
    kicker: 'Discord',
    title: 'The workshop behind the site',
    body: 'What gets built here comes out of what players report. On the server a bug report goes straight to the person writing the tools — with a follow-up question when something is unclear, and a note when it is fixed.',
    scope: 'It is about VerseBase only — not a general Star Citizen server.',
    lines: ['Report bugs', 'Suggest what gets built next', 'Patch notes as they land'],
    cta: 'Join the server',
    linkLabel: 'Open the invite — goes to Discord',
  },
}[lang];
---

{/* Der Wirt misst die Karte, nicht das Fenster: dieselbe Karte steht auf der
    Startseite über die volle Spalte (~1150px) und auf der Feedback-Seite in
    760px. Eine Fenster-Abfrage würde beide gleich behandeln und die schmale
    Fassung zerreissen. */}
<div class="dsc-host">
<div class="dsc">
  <div class="dsc__mark" aria-hidden="true">
    {/* Offizielles Discord-Markenzeichen — steht hier als Wiedererkennung des
        Ziels, nicht als Schmuck: wer das Glyph sieht, weiß vor dem Klick,
        wohin der Knopf führt. */}
    <svg viewBox="0 0 127.14 96.36" role="img" focusable="false">
      <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21H.55A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
    </svg>
  </div>

  <div class="dsc__body">
    <span class="dsc__kicker">{COPY.kicker}</span>
    <h3 class="dsc__title">{COPY.title}</h3>
    <p class="dsc__text">{COPY.body}</p>
    <ul class="dsc__lines">
      {COPY.lines.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
    <p class="dsc__scope">{COPY.scope}</p>
  </div>

  {/* Eigenes Rasterfeld statt im Textblock: nur so kann die Aktion auf einer
      breiten Karte nach rechts wandern, statt eine leere Spalte zu lassen.
      Die Lesereihenfolge im Quelltext bleibt dieselbe. */}
  <div class="dsc__actions">
    <a
      class="dsc__cta"
      href={DISCORD.invite}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={COPY.linkLabel}
    >
      {COPY.cta}
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg>
    </a>
    <span class="dsc__addr">{DISCORD.invite.replace('https://', '')}</span>
  </div>
</div>
</div>

<style>
  .dsc-host { container-type: inline-size; }

  /* Zwei Spalten: das Markenzeichen als stehende Marke links, der Text
     rechts, die Aktion darunter über die volle Breite. Unter 680px stapelt
     es — das Glyph rutscht dann über den Text und schrumpft, statt eine
     halbe Zeile Breite zu fressen. */
  .dsc {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    align-items: start;
    border: 1px solid var(--line, var(--line-soft));
    background: linear-gradient(180deg, var(--surface, transparent), var(--bg-2, transparent));
    padding: clamp(1.3rem, 3.5vw, 2.2rem);
  }
  .dsc__mark {
    width: clamp(46px, 6vw, 66px);
    color: var(--accent);
    line-height: 0;
  }
  .dsc__mark svg {
    width: 100%;
    height: auto;
    fill: currentColor;
  }
  .dsc__body { min-width: 0; }
  .dsc__kicker {
    display: block;
    font-family: var(--font-ui, sans-serif);
    font-weight: 800;
    font-size: var(--fs-5);
    letter-spacing: var(--ls-14);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.45rem;
  }
  .dsc__title {
    font-family: var(--font-display, sans-serif);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.8vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: var(--ls-4);
    color: var(--text);
    margin: 0 0 0.7rem;
  }
  .dsc__text {
    color: var(--muted);
    font-size: var(--fs-10);
    line-height: 1.6;
    max-width: 58ch;
    margin: 0;
  }
  /* Die drei Zeilen sagen, was der Server konkret ist — sie ersetzen den
     zweiten Absatz, den sonst niemand liest. Trennzeichen ist ein gesetzter
     Strich, kein Aufzählungspunkt: die Reihe wird gescannt, nicht gelesen. */
  .dsc__lines {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-7);
    letter-spacing: var(--ls-7);
    color: var(--text);
  }
  .dsc__lines li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .dsc__lines li::before {
    content: "";
    width: 14px;
    height: 1px;
    background: var(--accent);
    flex: none;
  }
  .dsc__scope {
    margin: 0.9rem 0 0;
    font-size: var(--fs-7);
    color: var(--muted);
    line-height: 1.55;
    max-width: 58ch;
  }
  .dsc__actions {
    grid-column: 2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
    /* Klein halten: der Zeilenabstand des Rasters (bis 2,2rem) traegt den
       Abstand bereits. Mit den urspruenglichen 1,5rem obendrauf standen
       gemessene 62px zwischen letztem Satz und Knopf — der Knopf sah aus,
       als gehoere er nicht mehr dazu. */
    margin-top: 0.4rem;
  }
  .dsc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-8);
    letter-spacing: var(--ls-10);
    text-transform: uppercase;
    color: var(--ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.78rem 1.5rem;
    transition: filter var(--dur-fast) var(--ease-ui), transform var(--dur-fast) var(--ease-ui);
  }
  .dsc__cta:hover,
  .dsc__cta:focus-visible {
    filter: brightness(1.08);
    transform: translateX(2px);
  }
  /* Die Adresse ausgeschrieben: ein Einladungslink ist eine Zieladresse, und
     wer sie vor dem Klick lesen kann, klickt eher. */
  .dsc__addr {
    font-family: var(--font-ui, sans-serif);
    font-size: var(--fs-6);
    letter-spacing: var(--ls-7);
    color: var(--muted);
  }

  /* Breite Karte (Startseite): dritte Spalte für die Aktion. Ohne sie stand
     der Knopf unter einem Text, der bei 58ch endet — rechts blieb ein Drittel
     der Karte leer. Gemessen an der KARTE, nicht am Fenster. */
  @container (min-width: 860px) {
    .dsc { grid-template-columns: auto 1fr auto; }
    .dsc__actions {
      grid-column: 3;
      grid-row: 1;
      align-self: center;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.7rem;
      margin-top: 0;
      text-align: right;
    }
  }

  @media (max-width: 680px) {
    .dsc {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    /* Schmales Raster hat nur 1rem Zeilenabstand — hier traegt der Rand
       wieder mehr, sonst klebt der Knopf am Text. */
    .dsc__actions { grid-column: 1; margin-top: 0.8rem; }
    .dsc__mark { width: 40px; }
  }
</style>
