---
// Patch archive hub — "Stellar Cartography".
//
// The whole page body, rendered once for both languages: the DE and EN routes
// are thin wrappers that only supply <Layout> metadata. Every string here comes
// from the i18n catalog and every fact from the patch collection via
// buildArchive(), so the two outputs can never drift apart.
//
// Design: the Alpha-4 era rendered as a voyage through deep space. A parallax
// starfield + era-tinted nebula sit behind a glowing vertical FLIGHT PATH that
// charges as the reader scrolls. The six eras each carry their real accent
// colour from the data, so the page recolours era-by-era — a spectral voyage —
// over a stable holo-cyan interface layer. Major releases are cinematic
// waypoint panels, point releases are compact signal-log rows.
//
// Self-contained: assets/archive.css is a standalone stylesheet (it does NOT
// load detail.css). SiteNav + the global footer theme themselves from the
// palette vars archive.css declares, so the shared chrome joins the voyage.
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import SiteNav from './SiteNav.astro';
import { buildArchive } from '../lib/archive';
import { localeFromPath, useTranslations, href } from '../i18n/ui';
import { useHelp } from '../i18n/help';
import ToolHelp from './ToolHelp.astro';

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
// Werkzeug-Hilfe (Phase 01.2) — siehe
// .planning/phases/01.2-werkzeuge-erklaeren/01.2-03-PLAN.md.
const h = useHelp(lang);
const L = (p: string) => href(p, lang);
const a = buildArchive(await getCollection('patches'), lang);

// Cache-Bust für /assets/archive.js (feste URL): nach einem Deploy liefert das
// CDN sonst bis zu 1 Tag die alte Datei — analog zur CSS in den Seitenhüllen.
let jsVer = 'x';
try {
  jsVer = createHash('sha1').update(readFileSync('assets/archive.js')).digest('hex').slice(0, 8);
} catch { /* dev-Fallback */ }

/** t() with %placeholders% filled in */
const tf = (key: Parameters<typeof t>[0], vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((s, [k, v]) => s.replace(`%${k}%`, String(v)), t(key));

const dives = (n: number) => tf(n === 1 ? 'arch.deepdive' : 'arch.deepdives', { n });
const pad2 = (n: number) => String(n).padStart(2, '0');

// The flight path below reads newest-first (a.eras), but the ribbon is a plot
// of real time and runs oldest-left. Its DOM has to run that way too: the
// chapter dividers are drawn by `.ribbon__band + .ribbon__band` on each band's
// LEFT edge, so a reversed list puts a hairline at x=0 and drops the one
// between the last two chapters.
const ribbonBands = a.eras.slice().reverse();
---

{/* Runs while the document is still parsing, so the reveal styles are armed
    before the timeline exists — no flash, and no blank page if archive.js
    never arrives (see the .js gate in archive.css). */}
<script is:inline>document.documentElement.classList.add('js');</script>

<a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>

<SiteNav
  crumbs={[{ label: 'VerseBase', href: L('/index.html') }, { label: t('nav.archive') }]}
  hasEn={true}
/>

{/* ── Deep-space backdrop ──────────────────────────────────────────────────
    Fixed behind everything, pointer-events off. The canvas draws a parallax
    starfield (archive.js); the nebula + horizon-grid recolour with --era. */}
<div class="space" aria-hidden="true">
  <canvas id="stars" class="space__stars"></canvas>
  <div class="space__nebula"></div>
  <div class="space__grid"></div>
  <div class="space__scan"></div>
  <div class="space__vignette"></div>
</div>

<main id="main" class="pa">
  <!-- ── Masthead — command console ─────────────────────────────────────── -->
  <header class="mast">
    <p class="mast__eyebrow">
      <span class="mast__pulse" aria-hidden="true"></span>
      <span class="mast__eyebrow-txt" set:html={t('arch.eyebrow')} />
      <span class="mast__eyebrow-code" aria-hidden="true">
        {a.stats.patches} REL · {a.stats.eras} ERA · {a.stats.majors} MAJ
      </span>
    </p>

    <h1 class="mast__title">
      <span class="mast__title-kicker">{t('arch.titleThin')}</span>
      <span class="mast__title-main">{t('arch.title')}</span>
    </h1>
    <p class="mast__lead">{t('arch.lead')}</p>

    {/* Telemetry — the ledger's own bookkeeping as a HUD readout row. */}
    <dl class="tele">
      <div class="tele__cell">
        <dd class="tele__n count" data-to={a.stats.patches}>{a.stats.patches}</dd>
        <dt class="tele__l">{t('arch.stat.patches')}</dt>
      </div>
      <div class="tele__cell">
        <dd class="tele__n count" data-to={a.stats.majors}>{a.stats.majors}</dd>
        <dt class="tele__l">{t('arch.stat.majors')}</dt>
      </div>
      <div class="tele__cell">
        <dd class="tele__n count" data-to={a.stats.topics}>{a.stats.topics}</dd>
        <dt class="tele__l">{t('arch.stat.topics')}</dt>
      </div>
      <div class="tele__cell">
        <dd class="tele__n count" data-to={a.stats.days}>{a.stats.days}</dd>
        <dt class="tele__l">{t('arch.stat.days')}</dt>
      </div>
    </dl>

    {/* Release trace — a real plot, not a progress bar. Releases are stems
        rising from a hairline axis at their true position in time; the axis
        itself is segmented into the six chapters, each segment in its era's
        colour and captioned with the same numeral the chapter carries below.
        The cadence of the voyage (the dense 4.8 cluster, the 2025 summer gaps)
        is legible before any entry is read. */}
    <nav class="ribbon" aria-label={t('arch.ribbon.aria')}>
      <div class="ribbon__plot">
        {/* Numeral and data-chapter both come from era.chapter — the
            CHRONOLOGICAL number, which is what the chapter heading below prints
            and what archive.js lights up when that chapter takes the screen. */}
        {ribbonBands.map((era) => (
          <span
            class:list={['ribbon__band', { 'is-narrow': era.to - era.from < 6 }]}
            data-chapter={era.chapter}
            style={`--from:${era.from.toFixed(2)}%;--to:${era.to.toFixed(2)}%;--c:${era.accent}`}
            aria-hidden="true"
          >
            <i class="ribbon__band-n">{pad2(era.chapter)}</i>
          </span>
        ))}

        {/* Calendar gridlines — the plot needs a scale, or the cadence has
            nothing to be a cadence against. */}
        {a.ribbon.years.map((y) => (
          <span class="ribbon__year" style={`--x:${(y.t * 100).toFixed(2)}%`} aria-hidden="true">
            <i>{y.label}</i>
          </span>
        ))}

        {a.entries.map((e) => (
          <a
            class:list={['ribbon__tick', { 'is-major': e.type === 'major', 'is-latest': e.isLatest }]}
            style={`--x:${(e.t * 100).toFixed(2)}%;--c:${e.accent}`}
            href={`#p-${e.anchor}`}
            data-label={`${e.version} · ${e.codename}`}
          >
            <i class="ribbon__pip" aria-hidden="true"></i>
            <span class="sr">{`Alpha ${e.version} — ${e.codename}, ${e.dateDisplay}`}</span>
          </a>
        ))}
      </div>
      <p class="ribbon__axis">
        <span>{a.ribbon.startLabel}</span>
        <span class="ribbon__legend" aria-hidden="true">
          <span class="ribbon__k ribbon__k--major">{t('arch.filter.major')}</span>
          <span class="ribbon__k ribbon__k--point">{t('arch.filter.point')}</span>
          <span class="ribbon__hint">{t('arch.ribbon.hint')}</span>
        </span>
        <span>{a.ribbon.endLabel}</span>
      </p>
    </nav>
  </header>

  <ToolHelp tool="archive" lang={lang} steps={4} />

  <!-- ── Control bar — nav computer ─────────────────────────────────────── -->
  <div class="cbar">
    <div class="cbar__in">
      <p class="cbar__era" data-help={h('archive.ctl.era')}>
        <span class="cbar__dot" aria-hidden="true"></span>
        <span class="sr">{t('arch.here')}:</span>
        <span id="eraNow" class="cbar__eratxt">{a.eras[0]?.label}</span>
      </p>

      <div class="cbar__search" data-help={h('archive.ctl.search')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
        >
        <label class="sr" for="q">{t('arch.filter.label')}</label>
        <input id="q" type="search" autocomplete="off" placeholder={t('arch.filter.placeholder')} />
        <button id="qx" class="cbar__x" type="button" hidden aria-label={t('arch.filter.clear')}>×</button>
      </div>

      <div class="cbar__chips" role="group" aria-label={t('arch.filter.label')} data-help={h('archive.ctl.chips')}>
        <button class="chipbtn" type="button" data-type="all" aria-pressed="true">{t('arch.filter.all')}</button>
        <button class="chipbtn" type="button" data-type="major" aria-pressed="false">{t('arch.filter.major')}</button>
        <button class="chipbtn" type="button" data-type="point" aria-pressed="false">{t('arch.filter.point')}</button>
      </div>

      <output
        id="count"
        class="cbar__count"
        data-tpl={t('arch.filter.count')}
        data-help={h('archive.ctl.count')}
        aria-live="polite"
        set:text={tf('arch.filter.count', { n: a.stats.patches, t: a.stats.patches })}
      />
    </div>
  </div>

  <!-- ── 01 · Timeline — the flight path ────────────────────────────────── -->
  <section class="sec sec--flight" id="timeline">
    <div class="sec__head reveal">
      <span class="sec__idx">01</span>
      <h2>{t('arch.sec.timeline')}</h2>
      <span class="sec__rule"></span>
      <span class="sec__tag">{a.stats.patches} {t('arch.versions')}</span>
    </div>

    <div class="flight">
      {a.eras.map((era) => (
        // data-accent/-accent2 drive the shared --era contract that archive.js
        // morphs on scroll; data-label feeds the control-bar readout;
        // data-chapter pairs the block with its ribbon band (the two lists run
        // in opposite directions, so an index would pair the wrong ones).
        <div
          class="era"
          id={`era-${era.chapter}`}
          data-accent={era.accent}
          data-accent2={era.accent2}
          data-label={era.label}
          data-chapter={era.chapter}
          style={`--c:${era.accent};--c2:${era.accent2}`}
        >
          <div class="era__head reveal">
            <span class="era__glyph" aria-hidden="true">{pad2(era.chapter)}</span>
            <div class="era__id">
              <p class="era__kicker">{lang === 'de' ? 'Kapitel' : 'Chapter'} {pad2(era.chapter)}</p>
              <h3 class="era__name">{era.label}</h3>
              <p class="era__meta">
                <span class="era__range">{era.range}</span>
                <span class="era__count">
                  {era.entries.length} {era.entries.length === 1 ? t('arch.entry') : t('arch.entries')}
                </span>
              </p>
            </div>
          </div>

          {era.entries.map((e) => (
            <article
              class:list={['node', `node--${e.type}`, { 'node--latest': e.isLatest }]}
              id={`p-${e.anchor}`}
              data-type={e.type}
              data-search={e.search}
              style={`--c:${e.accent};--c2:${e.accent2}`}
            >
              {/* Rail gutter: date readout + the lane marker. The vertical lane
                  itself and its charge overlay are drawn in CSS. */}
              <div class="node__rail" aria-hidden="true">
                <span class="node__day">{e.day}</span>
                <time class="node__my" datetime={e.date}>{e.dateShort}</time>
                <span class="node__mark"><i></i></span>
              </div>

              <div class="node__card">
                {e.art && (
                  <figure class="node__art" style={`--art:url('${e.art}')`}>
                    <span class="node__ver-ghost" aria-hidden="true">{e.version}</span>
                  </figure>
                )}
                <div class="node__body">
                  <p class="node__top">
                    <span class="node__ver">{e.version}</span>
                    <span class="tag" set:text={t(e.type === 'major' ? 'arch.badge.major' : 'arch.badge.point')} />
                    {e.isLatest && <span class="tag tag--live">{t('arch.badge.latest')}</span>}
                  </p>
                  <h4 class="node__name">
                    <a href={e.href} aria-label={tf('arch.openAria', { v: e.version })}>{e.codename}</a>
                  </h4>
                  <p class="node__tag">{e.tagline}</p>
                  <p class="node__foot">
                    <span class="node__go">{t('arch.open')} <span class="ar" aria-hidden="true">→</span></span>
                    {e.topics.length > 0 && (
                      <span class="node__dives">
                        {e.topics.map((tp) => (
                          <a class="dive" href={tp.href}>{tp.title}</a>
                        ))}
                      </span>
                    )}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}

      <div class="empty" id="empty">
        <p>{t('arch.filter.empty')}</p>
        <button id="reset" type="button">{t('arch.filter.emptyHint')}</button>
      </div>
    </div>
  </section>

  <!-- ── 02 · Key topics — priority intel ───────────────────────────────── -->
  <section class="sec" id="intel">
    <div class="sec__head reveal">
      <span class="sec__idx">02</span>
      <h2>{t('arch.sec.key')}</h2>
      <span class="sec__rule"></span>
    </div>
    <div class="intel reveal">
      {a.keyTopics.map((k, i) => (
        <article class="icard" style={`--c:${k.accent}`}>
          <span class="icard__n" aria-hidden="true">{pad2(i + 1)}</span>
          <div class="icard__body">
            <h3 class="icard__t"><a href={k.href}>{k.title}</a></h3>
            <p class="icard__v">Alpha {k.version}</p>
            <p class="icard__d">{k.desc}</p>
          </div>
          <span class="icard__go" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
  </section>

  <!-- ── 03 · All topics — database index ───────────────────────────────── -->
  <section class="sec" id="themen">
    <div class="sec__head reveal">
      <span class="sec__idx">03</span>
      <h2>{t('arch.sec.all')}</h2>
      <span class="sec__rule"></span>
      <span class="sec__tag">{dives(a.stats.topics)}</span>
    </div>
    <div class="tindex reveal">
      {a.topicGroups.map((g) => (
        <div class="tgroup" style={`--c:${g.accent}`}>
          <div class="tgroup__h">
            <h3 class="tgroup__l">Alpha {g.line}.x</h3>
            <span class="tgroup__rule" aria-hidden="true"></span>
            <span class="tgroup__n">{pad2(g.topics.length)}</span>
          </div>
          <div class="trows">
            {g.topics.map((tp) => (
              <a
                class="trow"
                href={tp.href}
                title={tp.title}
                data-search={`${tp.title} ${tp.version}`.toLowerCase()}
              >
                <span class="trow__t">{tp.title}</span>
                <span class="trow__v">{tp.version}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</main>

<a class="totop" id="totop" href="#main" aria-label={t('arch.toTop')}>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"
    ><path d="M12 19V5M5 12l7-7 7 7"></path></svg
  >
</a>

<script is:inline src={`/assets/archive.js?v=${jsVer}`} defer></script>
