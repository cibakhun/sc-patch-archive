---
// Item-Datenblatt — die indexierbare Fassung dessen, was der Item-Finder sonst
// nur als Modal zeigt. Reihenfolge folgt der Frage, mit der Leute ankommen:
// erst "was kostet das und wo", dann "was kann das", dann Fundort-Guide,
// Rezept und Nachbarn.
import DataShell from './DataShell.astro';
import { standItems, datumLang } from '../lib/datenstand';
import { href, type Locale } from '../i18n/ui';
import { itemT, itemLabel, obtainLabel, categoryLabel, fill } from '../i18n/itemText';
import {
  ITEM_KENNUNG, altName, auec, avgPrice, categoryPath, categorySlug, db, description,
  displayName, itemPath, itemsHubPath, leafCategory, maxPrice, minPrice, num,
  pageItemIds, relatedItems, rootCategory, sortedObtain, type Item,
  armorSetById, setItemsBySlot, woText,
} from '../lib/items';
import { specChips, statEntries, statRows, primaryStat, variantHead } from '../lib/itemStats';
import { itemSeo, itemZusatz, itemZwillinge } from '../lib/itemSeo';
import { bwT } from '../i18n/bezugswegeText';
import { tabellenGruppen, type GruppenSchluessel } from '../lib/bezugswege';
import { SYSTEME } from '../lib/itemLinks';
import { blueprintPath, craftEntryPath, craftTime, recipeForItem, resourceNames } from '../lib/crafting';
import { shipIdForVehicleItem } from '../lib/vehicleItems';
import { patchLinkFromKennung } from '../lib/patchPages';
import { patchesMentioning } from '../lib/patchMentions';
import { stockShips, inFracturingCalc, wikeloTrades } from '../lib/itemLinks';
import Item3d from './Item3d.astro';
import Bezugswege from './Bezugswege.astro';
import { item3dFor } from '../lib/item3d';

interface Props { item: Item; lang: Locale }
const { item, lang } = Astro.props;

const t = itemT(lang);
const patchLink = patchLinkFromKennung(ITEM_KENNUNG, lang);
const patchHref = patchLink.href;
const mentions = patchesMentioning(itemPath(item));
const seo = itemSeo(item, lang);
// D7: gleichnamige Datenblaetter unterscheiden und gegenseitig verlinken.
const zusatz = itemZusatz(item, lang);
const zwillinge = itemZwillinge(item, lang);
const bwt = bwT(lang);
const name = displayName(item, lang);
const alt = altName(item, lang);
const desc = description(item, lang);
// Ohne deutsche Fassung steht auf DE der englische Spieltext — als englisch
// ausgezeichnet (Vorlesen; verify:sprache prueft ihn dann nicht als DE-Text).
const descLang = lang === 'de' && !item.game?.descDe ? 'en' : undefined;
const chips = specChips(item, lang);
const stats = statEntries(item, lang);
const variants = item.game?.variants ?? [];
const key = primaryStat(item, lang);
const rows = sortedObtain(item);
const lo = minPrice(item);
const hi = maxPrice(item);
const avg = avgPrice(item);
const gruppen = tabellenGruppen(rows);
const mitGruppen = gruppen.length > 1;
// Filterknoepfe: die Systeme, die eine Zeile nennt, dann „Ohne Systemangabe".
const filterSysteme = [...SYSTEME.filter((s) => gruppen.some((g) => g.rows.some((z) => z.systeme.includes(s)))), ...(gruppen.some((g) => g.system === null) ? [null] : [])];
// Der Filter richtet sich nach seinen Knoepfen, nicht nach den Gruppen: nennen
// alle Zeilen mehrere Systeme, gibt es nur die Gruppe „mehrere“, aber sehr
// wohl etwas zu waehlen (Review #434).
const mitFilter = filterSysteme.length > 1;
const gruppenName = (k: GruppenSchluessel) => (k === 'mehrere' ? bwt('sysMulti') : k ?? bwt('buyNoSystem'));
const mitPreis = rows.some((o) => o.price != null);
const vendors = item.obtain.filter((o) => o.kind === 'shop' || o.kind === 'vehicle').length;
// Datenstand: Verkaufsstellen von UEX und aus dem eigenen Shop-Schnappschuss
// (src, nur wo UEX das Item nicht fuehrt) getrennt nennen.
const snapVendors = item.obtain.filter((o) => o.kind === 'shop' && o.src === 'schnappschuss').length;
const uexVendors = vendors - snapVendors;
const loot = item.obtain.filter((o) => o.kind === 'loot').length;
// Fundort-Status (Discord-Vorschlag „Loot-only Items", 10.11.2026): bestaetigt
// = die Zeile kommt aus den Loot-Belegungen des Spiels (`ort`), unbestaetigt =
// eigene Recherche. Unbekannt = das Spiel schliesst Loot nicht aus, aber das
// Item hat gar keine Bezugszeile (sonst stuende es als Katalog-Eintrag da).
const lootBestaetigt = item.obtain.filter((o) => o.kind === 'loot' && o.ort).length;
const lootRecherche = loot - lootBestaetigt;
const fundortUnbekannt = item.game?.lootable === true && item.obtain.length === 0;
// Der UEX-Preisstand gehoert nur unter Preise, die von UEX kommen.
const mitUexPreis = rows.some((o) => o.price != null && o.src !== 'schnappschuss');
// Welche Zeile des Datenstands diese Bezugszeile belegt (verify:patch-angaben
// [6] haelt beides gegeneinander): Shop und Schiffshaendler kommen von UEX,
// ausser Shop-Zeilen aus dem eigenen Schnappschuss (src), Loot aus der eigenen
// Recherche, bestaetigte Fundorte aus dem Spielstand ihres Datenlaufs;
// Exklusiv-Zeilen sind Spielwerte.
const standQ = (o: { kind: string; src?: string; ort?: string }) =>
  o.src === 'schnappschuss' ? 'shop-schnappschuss'
  : o.kind === 'shop' || o.kind === 'vehicle' ? 'uex-items'
  : o.kind === 'loot' ? (o.ort ? 'fundorte-spiel' : 'fundorte') : undefined;
const schwankend = rows.some((o) => o.kind !== 'exclusive');
// Rezept dieses Items: zuerst ueber die guid des Rezepts, dann ueber den
// Namen (recipeForItem, src/lib/crafting.ts) — dasselbe Rezept, auf das
// „Herstellen“ in der Suche zeigt.
const bp = recipeForItem(item);
// Fahrzeug-Item -> Schiffsdatenblatt (Skizze 016, 09.11.2026).
const shipId = await shipIdForVehicleItem(item);
// Drehbares Modell (nur Vorschau-Bau, src/lib/item3d.ts).
const model3d = item3dFor(item.id);
const related = relatedItems(item, 12);
const set = item.game?.setId ? armorSetById.get(item.game.setId) ?? null : null;
const setSlots = set ? setItemsBySlot(set.id) : [];
// Serienbelegung: auf welchen Schiffen das Teil ab Werk sitzt. Die ersten
// STOCK_SHOWN stehen offen, der Rest im eingeklappten Block — als echte
// Links im HTML, ohne Skript (die Huelle traegt bewusst keins).
const STOCK_SHOWN = 12;
const stock = stockShips(item);
const stockLead = stock.length === 1
  ? (stock[0].spaceship ? t('stockOneShip') : t('stockOneVehicle'))
  : fill(
      stock.every((s) => s.spaceship) ? t('stockShips') : stock.every((s) => !s.spaceship) ? t('stockVehicles') : t('stockMixed'),
      { n: num(stock.length, lang) },
    );
// Werkzeuge, die genau dieses Item kennen — nichts Generisches: der
// Bruchrechner nur fuer Teile, die er zur Auswahl hat, Wikelo nur, wenn ein
// Tauschgeschaeft das Item nennt.
const fracturing = inFracturingCalc(item);
const wikelo = wikeloTrades(item);
const wikeloHref = `${href('/topics/wikelo-emporium.html', lang)}?item=${encodeURIComponent(item.name)}`;
const plural = (n: number, one: Parameters<typeof t>[0], many: Parameters<typeof t>[0]) =>
  n === 1 ? t(one) : fill(t(many), { n: num(n, lang) });

const root = rootCategory(item.category);
const catSlug = categorySlug(item.category);
const kindLabel = (k: string) =>
  k === 'shop' ? t('kindShop') : k === 'vehicle' ? t('kindVehicleShop')
  : k === 'exclusive' ? t('kindExclusive') : t('kindLoot');
// Exklusiv-Zeilen tragen keinen Ort, sondern eine Bezugsart (Promo, Concierge,
// Twitch-Drop …) — die wird uebersetzt. Echte Orte sind Eigennamen und bleiben.
// Dieselbe Regel gilt in der Kategorieliste (ItemListing), deshalb ein Helfer.
const locLabel = (o: { kind: string; loc: string; reason?: string }) => obtainLabel(o, lang);

const crumbs = [
  { label: t('breadcrumbItems'), href: itemsHubPath },
  { label: leafCategory(item.category), href: categoryPath(catSlug) },
  { label: name },
];
---
<DataShell
  lang={lang}
  title={seo.title}
  description={seo.description}
  crumbs={crumbs}
  eyebrow={`${categoryLabel(root, lang)} · ${t('pageEyebrow')}`}
  modified={db.generatedAt}
  ldName={name}
  stand={standItems(lang, { preise: uexVendors > 0, schnappschuss: snapVendors > 0, fundorte: lootRecherche > 0, fundorteSpiel: lootBestaetigt > 0 })}
  melden
>
  {/* data-fahrzeug-item: Fahrzeug-Itemblatt — verify:bezugswege [6] prueft,
      dass es sichtbar auf sein Schiffsblatt zeigt (Krisz 24.11.2026: beide
      Blaetter gleichrangig, kein Canonical, gegenseitige Links). */}
  <h1 slot="hero" data-fahrzeug-item={item.category === 'Vehicle' || undefined}>{name}</h1>
  {alt && <p class="dp-alt" slot="hero" lang={lang === 'de' ? 'en' : 'de'}>{alt}</p>}
  <p class="dp-lead" slot="hero">{seo.lead}</p>
  {zwillinge.length > 0 && (
    <p class="dp-note dp-zwilling" slot="hero" data-zwilling={zusatz}>
      {zusatz && <>{bwt('twinThis')}{' '}<b>{zusatz}</b>.{' '}</>}
      {bwt(zwillinge.length === 1 ? 'twinItem' : 'twinItems')}{' '}
      {zwillinge.map((z, i) => (
        <>{i > 0 && ', '}<a href={href(itemPath(z.item), lang)}>{z.label}</a></>
      ))}
    </p>
  )}
  {/* Direkte Wege (Skizze 016, 09.11.2026): vom Item ins Crafting-Werkzeug
      mit diesem Rezept, und vom Fahrzeug-Item auf sein Schiffsdatenblatt.
      Davor das Modell in 3D, wo es eines gibt (nur Vorschau-Bau). */}
  {(bp || shipId || model3d) && (
    <div class="dp-cta" slot="hero">
      <Item3d model={model3d} name={name} lang={lang} />
      {bp && <a class="dp-btn" href={href(craftEntryPath(bp), lang)} data-weg="herstellen">{t('headCraft')} →</a>}
      {shipId && <a class="dp-btn" href={href(`/schiffe/${shipId}.html`, lang)} data-weg="schiff">{t('headShip')} →</a>}
    </div>
  )}

  <ul class="dp-keys" slot="hero">
    {lo != null && (
      <li class="dp-key"><b>{t('cheapest')}</b><span>{auec(lo, lang)}</span></li>
    )}
    {lo != null && hi != null && hi !== lo && (
      <li class="dp-key"><b>{t('priceRange')}</b><span>{num(lo, lang)}–{num(hi, lang)}</span></li>
    )}
    {vendors > 0 && (
      <li class="dp-key"><b>{vendors === 1 ? t('soldAtOne') : t('soldAt')}</b><span>{num(vendors, lang)}</span></li>
    )}
    {loot > 0 && (
      <li class="dp-key"><b>{t('lootSources')}</b><span>{num(loot, lang)}</span></li>
    )}
    {key && <li class="dp-key"><b>{key[0]}</b><span>{key[1]}</span></li>}
  </ul>

  {/* -- So bekommst du es: alle Wege an einer Stelle, je mit naechstem
         Schritt (UX-Audit Paket D1, src/components/Bezugswege.astro). -- */}
  <Bezugswege item={item} lang={lang} />

  {/* -- Bezugsquellen: die eigentliche Antwort auf "where to buy" -- */}
  <section class="dp-sec" id="bezugsquellen">
    <h2>{t('sectionObtain')}</h2>
    {rows.length > 0 ? (
      <>
        {/* D5: Ø-Preis einmal ueber der Tabelle statt in jeder Zeile; Preis-
            spalte nur, wo eine Zeile einen Preis hat; Zeilen nach System
            gebuendelt, mit Filter, der sich das gewaehlte System merkt. */}
        {avg != null && <p class="dp-avg">{bwt('avgLine')} <b>{auec(avg, lang)}</b></p>}
        {mitFilter && (
          <div class="dp-sysfilter" role="group" aria-label={bwt('sysFilter')} data-sysfilter hidden>
            <button type="button" class="dp-sysbtn" aria-pressed="true" data-sys="">{bwt('sysAll')}</button>
            {filterSysteme.map((sys) => (
              <button type="button" class="dp-sysbtn" aria-pressed="false" data-sys={sys ? sys.toLowerCase() : 'ohne'}>{sys ?? bwt('buyNoSystem')}</button>
            ))}
          </div>
        )}
        <div class="dp-tablewrap">
          {/* Rollen ausdruecklich: am Handy werden die Zeilen zum Raster
              (Style unten), und manche Browser vergessen dann, dass es eine
              Tabelle ist. */}
          <table class="dp-table dp-bezug" role="table">
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader">{t('thLocation')}</th>
                <th role="columnheader">{t('thKind')}</th>
                {mitPreis && <th class="dp-num" role="columnheader">{t('thPrice')}</th>}
              </tr>
            </thead>
            {gruppen.map((g) => (
              <tbody role="rowgroup" data-system={g.system ? g.system.toLowerCase() : 'ohne'}>
                {mitGruppen && (
                  <tr class="dp-gruppe" role="row">
                    <th scope="rowgroup" role="rowheader" colspan={mitPreis ? 3 : 2}>
                      {g.rows.length === 1
                        ? fill(bwt('sysGroupOne'), { sys: gruppenName(g.system) })
                        : fill(bwt('sysGroup'), { sys: gruppenName(g.system), n: num(g.rows.length, lang) })}
                    </th>
                  </tr>
                )}
                {g.rows.map(({ o, systeme }) => (
                  <tr class={o === rows[0] && o.price != null ? 'dp-best' : undefined} role="row" data-stand-q={standQ(o)} data-sys={systeme.length ? systeme.join(' ').toLowerCase() : 'ohne'}>
                    <td role="cell">{locLabel(o)}{o.wo && <span class="dp-wo">{woText(o.wo, t('inSpace'))}</span>}</td>
                    <td role="cell">
                      {kindLabel(o.kind)}
                      {o.kind === 'loot' && (o.ort
                        ? <span class="dp-fund dp-fund--ok" title={t('lootConfirmedTitle')}>{t('lootConfirmed')}</span>
                        : <span class="dp-fund" title={t('lootUnconfirmedTitle')}>{t('lootUnconfirmed')}</span>)}
                    </td>
                    {mitPreis && (
                      <td class="dp-num" role="cell">
                        {/* Leerwert bleibt leer statt „—" (D5): eine Loot-Zeile hat keinen Preis. */}
                        {o.price != null && <span class="dp-price" data-stand-q={standQ(o)}>{auec(o.price, lang)}</span>}
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
        {/* Preisdatum nur, wo ein Preis steht: ein Item nur mit Exklusiv-Zeilen
            (Promo, Concierge …) hat keinen, und der Datenstand nennt dann auch
            keine Kaufpreise. Der Hinweis auf schwankende Preise und Orte nur,
            wo es Shop- oder Loot-Zeilen gibt. */}
        {schwankend && (
          <p class="dp-note">{t('volatileNote')}{mitUexPreis && <> · {t('pricesAsOf')}{' '}{datumLang(db.pricesAsOf, lang)}</>}{lootBestaetigt > 0 && <> · {t('lootStatusNote')}</>}</p>
        )}
      </>
    ) : (
      <p class="dp-callout">{fundortUnbekannt ? t('lootUnknown') : t('catalogNote')}</p>
    )}
  </section>

  {/* -- Spielwerte -- */}
  {(chips.length > 0 || stats.length > 0 || desc) && (
    <section class="dp-sec">
      <h2>{t('sectionSpecs')}</h2>
      {chips.length > 0 && (
        <ul class="dp-chips">
          {chips.map(([l, v]) => <li class="dp-chip"><b>{l}</b>{v}</li>)}
        </ul>
      )}
      {stats.length > 0 && (
        <ul class="dp-stats">
          {stats.map(([l, v]) => <li class="dp-stat"><b>{l}</b><span>{v}</span></li>)}
        </ul>
      )}
      {desc && <p class="dp-desc" lang={descLang}>{desc}</p>}
    </section>
  )}

  {/* -- Varianten: mehrere Spiel-Items teilen sich diesen Anzeigenamen. Die
         Werte stehen je Ausfuehrung statt einmal geraten weiter oben. -- */}
  {variants.length > 0 && (
    <section class="dp-sec">
      <h2>{t('sectionVariants')}</h2>
      <p class="dp-note">{t('variantsNote')}</p>
      {variants.map((v) => (
        <>
          <h3 class="dp-variant-h" set:text={variantHead(item, v, lang)} />
          {statRows(v.stats, lang).length > 0 && (
            <ul class="dp-stats">
              {statRows(v.stats, lang).map(([l, val]) => (
                <li class="dp-stat"><b>{l}</b><span>{val}</span></li>
              ))}
            </ul>
          )}
        </>
      ))}
    </section>
  )}

  {/* -- Serienbelegung: von der Item-Seite zu den Schiffen, die das Teil
         ab Werk tragen (src/lib/itemLinks.ts, Zuordnung ueber Name + Groesse). -- */}
  {stock.length > 0 && (
    <section class="dp-sec" id="serie">
      <h2>{t('sectionStock')}</h2>
      <p class="dp-lead-s">{stockLead}</p>
      <ul class="dp-chips dp-chips--links">
        {stock.slice(0, STOCK_SHOWN).map((s) => (
          <li><a class="dp-chip" href={href(`/schiffe/${s.id}.html`, lang)}>{s.name}</a></li>
        ))}
      </ul>
      {stock.length > STOCK_SHOWN && (
        <details class="dp-more">
          <summary>{fill(t('stockMore'), { n: num(stock.length - STOCK_SHOWN, lang) })}</summary>
          <ul class="dp-chips dp-chips--links">
            {stock.slice(STOCK_SHOWN).map((s) => (
              <li><a class="dp-chip" href={href(`/schiffe/${s.id}.html`, lang)}>{s.name}</a></li>
            ))}
          </ul>
        </details>
      )}
    </section>
  )}

  {/* -- Set-Zugehoerigkeit: beantwortet "was fehlt mir noch" und haelt den
         Crawler auf den Geschwisterteilen statt nur in der Kategorie. -- */}
  {set && (
    <section class="dp-sec">
      <h2>{t('setPartOf')}: {set.name}</h2>
      <ul class="dp-chips">
        {set.manufacturer && <li class="dp-chip"><b>{t('specMfr')}</b>{set.manufacturer}</li>}
        {set.weight && <li class="dp-chip"><b>{t('facetWeight')}</b>{itemLabel(lang, 'w' + set.weight.replace(/[^A-Za-z]/g, ''), set.weight)}</li>}
        <li class="dp-chip"><b>{t('setPieces')}</b>{num(set.parts, lang)}</li>
        <li class="dp-chip">
          <b>{t('setsCompleteLabel')}</b>
          {set.coreSlots === 4 ? t('setsComplete') : `${set.coreSlots}/4`}
        </li>
      </ul>
      {setSlots.map(([slot, list]) => (
        <p class="dp-desc">
          <b>{itemLabel(lang, 'slot' + slot, slot)}:</b>{' '}
          {list.map((s, i) => (
            <>
              {i > 0 && ', '}
              {s.id === item.id
                ? <b>{displayName(s, lang)}</b>
                : pageItemIds.has(s.id)
                  ? <a href={href(itemPath(s), lang)}>{displayName(s, lang)}</a>
                  : <span>{displayName(s, lang)}</span>}
            </>
          ))}
        </p>
      ))}
      <div class="dp-actions">
        <a class="dp-btn" href={`${href('/armor-sets.html', lang)}#${set.id}`}>{t('setViewAll')} →</a>
      </div>
    </section>
  )}

  {/* -- Fundort-Guide (eigene Recherche) -- */}
  {item.guide && (
    <section class="dp-sec">
      <h2>{t('sectionGuide')}</h2>
      <p class="dp-callout">{item.guide}</p>
    </section>
  )}

  {/* -- Rezept: Kurzfassung + Link auf die Blueprint-Seite -- */}
  {bp && (
    <section class="dp-sec">
      <h2>{t('sectionCrafting')}</h2>
      <ul class="dp-chips">
        <li class="dp-chip"><b>{t('craftTime')}</b>{craftTime(bp.craft_time_seconds, lang)}</li>
        {bp.tiers > 0 && <li class="dp-chip"><b>{t('craftTiers')}</b>{bp.tiers}</li>}
        <li class="dp-chip"><b>{t('craftMaterials')}</b>{resourceNames(bp).join(', ')}</li>
      </ul>
      <div class="dp-actions">
        <a class="dp-btn" href={href(blueprintPath(bp), lang)}>{t('breadcrumbCrafting')}: {bp.name} →</a>
      </div>
    </section>
  )}

  {/* -- Werkzeuge, die genau dieses Item kennen (src/lib/itemLinks.ts) -- */}
  {(fracturing || wikelo) && (
    <section class="dp-sec" id="werkzeuge">
      <h2>{t('sectionTools')}</h2>
      <div class="dp-actions dp-actions--tight">
        {fracturing && <a class="dp-btn" href={href('/fracturing.html', lang)}>{t('toolFracturing')} →</a>}
        {wikelo && wikelo.material > 0 && (
          <a class="dp-btn" href={wikeloHref}>{plural(wikelo.material, 'toolWikeloMaterialOne', 'toolWikeloMaterial')} →</a>
        )}
        {wikelo && wikelo.reward > 0 && (
          <a class="dp-btn" href={wikeloHref}>{plural(wikelo.reward, 'toolWikeloRewardOne', 'toolWikeloReward')} →</a>
        )}
      </div>
    </section>
  )}

  {/* -- Nachbarn: haelt den Crawler in der Kategorie und den Klickpfad kurz -- */}
  {related.length > 0 && (
    <section class="dp-sec">
      <h2>{t('sectionRelated')}</h2>
      <ul class="dp-cards" data-aehnlich>
        {related.map((r) => {
          const p = minPrice(r);
          const linked = pageItemIds.has(r.id);
          return (
            <li data-item={r.id}>
              {linked ? (
                <a class="dp-card" href={href(itemPath(r), lang)}>
                  <strong>{displayName(r, lang)}</strong>
                  <em>{p != null ? <span class="dp-card-price">{t('thFrom')} {auec(p, lang)}</span> : leafCategory(r.category)}</em>
                </a>
              ) : (
                <span class="dp-card">
                  <strong>{displayName(r, lang)}</strong>
                  <em>{leafCategory(r.category)}</em>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <div class="dp-actions">
    <a class="dp-btn dp-btn--ghost" href={href(categoryPath(catSlug), lang)}>{t('allInCategory')}: {leafCategory(item.category)}</a>
    <a class="dp-btn dp-btn--ghost" href={href('/item-finder.html', lang)}>{t('backToFinder')}</a>
    {/* Nur verlinken, wenn die Patch-Seite existiert — sie ist handgeschrieben
        und folgt einem Datenlauf NICHT automatisch (src/lib/patchPages.ts).
        Fehlt sie, entfaellt der Knopf ganz: ein <span> mit Knopf-Klassen saehe
        aus wie ein Knopf und waere keiner. Die Patch-Kennung steht ohnehin im
        Seitentitel. */}
    {/* Nennt die Patch-Seite schon ein Erwaehnungs-Knopf daneben („Alpha 4.10.2 ·
        RSI Discovery Month"), entfaellt der schlichte: zwei Knoepfe zur selben Seite. */}
    {patchHref && !mentions.some((p) => p.page && href(p.page, lang) === patchHref) && <a class="dp-btn dp-btn--ghost" href={patchHref}>{patchLink.label}</a>}
    {mentions.map((p) => (p.page ? <a class="dp-btn dp-btn--ghost" href={href(p.page, lang)}>Alpha {p.version} · {p.codename}</a> : <span class="dp-btn dp-btn--ghost">Alpha {p.version} · {p.codename}</span>))}
  </div>
</DataShell>

<script>
  // D5: System-Filter der Bezugsquellen. Ohne Skript stehen alle Gruppen da
  // (der Filter bleibt verborgen); mit Skript merkt er sich die Wahl
  // seitenuebergreifend — wer in Pyro spielt, sieht beim naechsten Item zuerst Pyro.
  const SCHLUESSEL = 'vb-system';
  for (const leiste of document.querySelectorAll<HTMLElement>('[data-sysfilter]')) {
    const tabelle = leiste.parentElement?.querySelector('table.dp-bezug');
    if (!tabelle) continue;
    const knoepfe = [...leiste.querySelectorAll<HTMLButtonElement>('button[data-sys]')];
    // Zeilen tragen ihre Systeme (data-sys, Fundorte oft mehrere); eine
    // Gruppe ohne sichtbare Zeile verschwindet samt Kopf.
    const zeige = (sys: string) => {
      for (const k of knoepfe) k.setAttribute('aria-pressed', String(k.dataset.sys === sys));
      for (const tb of tabelle.querySelectorAll<HTMLElement>('tbody[data-system]')) {
        let sichtbar = 0;
        for (const tr of tb.querySelectorAll<HTMLElement>('tr[data-sys]')) {
          tr.hidden = sys !== '' && !(tr.dataset.sys ?? '').split(' ').includes(sys);
          if (!tr.hidden) sichtbar++;
        }
        tb.hidden = sichtbar === 0;
      }
    };
    leiste.addEventListener('click', (e) => {
      const k = (e.target as Element | null)?.closest<HTMLButtonElement>('button[data-sys]');
      if (!k) return;
      const sys = k.dataset.sys ?? '';
      zeige(sys);
      try { if (sys) localStorage.setItem(SCHLUESSEL, sys); else localStorage.removeItem(SCHLUESSEL); } catch { /* privat: nur ohne Merken */ }
    });
    let gemerkt = '';
    try { gemerkt = localStorage.getItem(SCHLUESSEL) ?? ''; } catch { /* privat */ }
    if (gemerkt && knoepfe.some((k) => k.dataset.sys === gemerkt)) zeige(gemerkt);
    leiste.hidden = false;
  }
</script>

