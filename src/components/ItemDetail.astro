  /* Am Handy nicht abschneiden: der Preis bricht nie um, der Ort darf. */
  .dp-bezug .dp-num { white-space: nowrap; }
  /* Schmal reicht die Breite nicht fuer drei Spalten (390 px: Tabelle 411,
     Kasten 356, der Preis lag hinter der Kante). Dann wird jede Zeile ein
     Raster: oben der Ort ueber die volle Breite, darunter Art und Preis. */
  @media (max-width: 600px) {
    .dp-bezug, .dp-bezug tbody { display: block; }
