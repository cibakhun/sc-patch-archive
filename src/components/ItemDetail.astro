      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip-path: inset(50%); white-space: nowrap;
    }
    .dp-bezug tr { display: grid; grid-template-columns: 1fr auto; }
    .dp-bezug tbody tr:not(.dp-gruppe) { border-bottom: 1px solid var(--line-soft); }
    .dp-bezug tbody tr:last-child { border-bottom: none; }
    .dp-bezug .dp-gruppe th { grid-column: 1 / -1; }
    .dp-bezug td { border-bottom: none; }
    .dp-bezug tbody td:first-child { grid-column: 1 / -1; border-left: none; padding-bottom: 0.15rem; }
    .dp-bezug tbody td + td { padding-top: 0.15rem; }
  }
</style>
