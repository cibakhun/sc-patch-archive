---
// Preiszeile eines Ruestungs-Sets (Task-Flow D05): „komplett ab“, fehlende
// Ladenpreise benannt, guenstigster Laden mit allen Kernteilen. Steht auf der
// Set-Seite unter jedem Set und im Set-Abschnitt des Item-Datenblatts.
// Rechnung: src/lib/setPreis.ts.
import type { Locale } from '../i18n/ui';
import { setPreisText } from '../lib/setPreisText';
interface Props { id: string; lang: Locale; class?: string }
const { id, lang, class: klasse } = Astro.props;
// Text an einer Stelle (src/lib/setPreisText.ts): die Items-Werkbank zeigt
// denselben, ueber /items-wege.json.
const z = setPreisText(id, lang);
---
{z.teile > 0 && (
  <p class:list={['set-preis', klasse, { 'set-preis--leer': z.leer }]} title={z.titel ?? undefined} data-set-preis>
    <b>{z.kopf}</b>
    {z.ohne && <span> · {z.ohne}</span>}
    {z.ort && <span class="set-preis__ort"> · {z.ort}</span>}
  </p>
)}

<style>
  .set-preis { margin: .35rem 0 .6rem; font-size: var(--fs-8); color: var(--text); overflow-wrap: anywhere; }
  .set-preis b { font-weight: 600; }
  .set-preis--leer, .set-preis--leer b { color: var(--muted); font-weight: 400; }
  .set-preis__ort { color: var(--muted); }
</style>
