<script is:inline>

const tb=document.getElementById('topbar');
addEventListener('scroll',()=>tb.classList.toggle('scrolled',scrollY>40),{passive:true});
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
document.querySelectorAll('.video[data-yt],.bvid[data-yt]').forEach(v=>{v.addEventListener('click',()=>{const id=v.getAttribute('data-yt');v.innerHTML='<iframe src="https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe>';},{once:true});});
/* Lightbox: Karten/Bilder klickbar */
(function(){const lb=document.getElementById('lb'),lbc=lb.querySelector('.lb__content');
function show(h){lbc.innerHTML=h;lb.classList.add('open');lb.setAttribute('aria-hidden','false');}
function close(){lb.classList.remove('open');lbc.innerHTML='';lb.setAttribute('aria-hidden','true');}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
document.querySelectorAll('[data-lb]').forEach(el=>el.addEventListener('click',()=>{const v=el.getAttribute('data-lb');if(v.startsWith('yt:')){show('<div class="ratio"><iframe src="https://www.youtube-nocookie.com/embed/'+v.slice(3)+'?autoplay=1&rel=0" title="Video" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe></div>');}else{show('<img src="'+v.slice(4)+'" alt="">');}}));
document.querySelectorAll('[data-info]').forEach(el=>el.addEventListener('click',()=>{const img=el.getAttribute('data-img'),ti=esc(el.getAttribute('data-title')),tx=esc(el.getAttribute('data-text'));show('<div class="lb__info">'+(img?'<img src="'+img+'" alt="">':'')+'<div class="lb__txt"><h3>'+ti+'</h3><p>'+tx+'</p></div></div>');}));
lb.addEventListener('click',e=>{if(e.target===lb||e.target.closest('.lb__x'))close();});
addEventListener('keydown',e=>{if(e.key==='Escape')close();});})();
/* Staub-Partikel: warme Motes, driften seitwärts (Frontier-Wind) */
(function(){const c=document.getElementById('dust');if(!c)return;const x=c.getContext('2d');let running=false;const fxOn=()=>document.documentElement.getAttribute('data-fx')==='on';let w,h,st;const COL=['#e3aa4b','#e94f3d','#f2d3a0','#b3a698'];
function size(){w=c.width=innerWidth;h=c.height=Math.max(innerHeight,1);st=Array.from({length:Math.min(120,Math.floor(w/12))},()=>({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.6+.3,a:Math.random(),s:Math.random()*.012+.003,vx:Math.random()*.35+.08,c:COL[Math.floor(Math.random()*COL.length)]}));}
function tick(){if(!running)return;x.clearRect(0,0,w,h);for(const s of st){s.a+=s.s;s.x+=s.vx;if(s.x>w+4)s.x=-4;const o=.18+Math.abs(Math.sin(s.a))*.6;x.globalAlpha=o;x.fillStyle=s.c;x.beginPath();x.arc(s.x,s.y,s.r,0,7);x.fill();}x.globalAlpha=1;requestAnimationFrame(tick);}
size();addEventListener('resize',size);document.addEventListener('vbfxchange',(e)=>{if(e.detail.on&&!running){size();running=true;requestAnimationFrame(tick);}else if(!e.detail.on){running=false;}});if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&fxOn()){running=true;tick();}})();

</script>
