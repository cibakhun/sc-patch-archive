---
// „sc-4-9-0" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import QuickFacts from '../../components/dossier/QuickFacts.astro';
import PatchDossier from '../../components/dossier/PatchDossier.astro';
import PatchSeo from '../../components/dossier/PatchSeo.astro';
import { getEntry } from 'astro:content';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const entry = await getEntry('patches', '4-9-0');
if (!entry) throw new Error('Patch-Daten 4-9-0 fehlen in src/data/patches/');
const patch = mergePatchEn('4-9-0', entry.data, lang);
---
<PatchSeo patch={patch} image="/assets/trailer-4-9-0.jpg" />
<style is:inline>

/* 4.9.0 "Frontier Tensions" — media-first / low-text / Rust-Frontier
   Design-Welt: Nyx-Staub, Alliance-Zinnober, Schrott-Manifest-Mono */
:root{
  --bg:#140f0c;--bg-2:#1b1410;--surface:#241a14;--surface-2:#2e211a;
  --accent:#e94f3d;--accent-2:#e3aa4b;--hot:#e94f3d;
  --text:#f2ece4;--muted:#b3a698;
  --line:rgba(233,79,61,.24);--line-soft:rgba(242,236,228,.10);
  --glow:0 0 44px rgba(233,79,61,.28);
  --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;
  --maxw:1280px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#fef6f1;--bg-2:#f6ebe6;--surface:#fffdfc;--surface-2:#fbf0ea;--text:#231f19;--muted:#615649;--accent:#ab0b01;--accent-2:#714d03;--hot:#9d0901;--ink:#ffffff;--accent-media:#e94f3d;--accent-2-media:#e3aa4b;--line:rgba(164,89,78,.3);--line-soft:rgba(49,45,39,.12);--glow:0 6px 22px rgba(172,83,70,.18)}




*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.skip{position:absolute;left:-999px;top:0;z-index:200;background:var(--accent);color:var(--ink);padding:.6rem 1rem;font-family:var(--font-ui);font-weight:700}.skip:focus{left:0}

/* Effekt-Overlays: warme Vignette + feine Scanlines */
body::after{content:"";position:fixed;inset:0;z-index:9000;pointer-events:none;background:radial-gradient(130% 115% at 50% 42%,transparent 54%,var(--vignette) 100%),repeating-linear-gradient(0deg,var(--scanline) 0 1px,transparent 1px 3px);opacity:var(--ambient-opacity)}

/* HERO */
.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:7rem clamp(1.25rem,5vw,4.5rem) 4rem;overflow:hidden}
.hero__photo{position:absolute;inset:0;z-index:0;background:url('/assets/trailer-4-9-0.jpg') center/cover;animation:kb 30s ease-in-out infinite alternate}
@keyframes kb{from{transform:scale(1.06)}to{transform:scale(1.18) translate(-1.5%,-1.5%)}}
.hero__photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,var(--scrim-2),var(--scrim-4) 55%,var(--bg)),radial-gradient(120% 90% at 80% 20%,transparent,var(--bg) 88%)}
#dust{position:absolute;inset:0;z-index:1;opacity:.5}html:not([data-fx="on"]) #dust{display:none}
.hero__in{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.eyebrow{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;font-size:var(--fs-6);color:var(--accent-2)}
.hero h1{position:relative;font-family:var(--font-display);font-weight:900;line-height:.82;letter-spacing:var(--ls-1);margin:.6rem 0 .1rem;font-size:clamp(4.5rem,22vw,18rem);background:linear-gradient(180deg,var(--title-hi),var(--accent) 75%,#5e1710);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 36px rgba(233,79,61,.45));animation:flick 8s steps(1) infinite}
@keyframes flick{0%,92%,100%{opacity:1}93%{opacity:.55}94%{opacity:1}96%{opacity:.8}97%{opacity:1}}
.hero h1::after{content:attr(data-text);position:absolute;left:3px;top:0;-webkit-text-fill-color:var(--accent-2);color:var(--accent-2);opacity:0;mix-blend-mode:screen;animation:rgbs 8s steps(1) infinite}
@keyframes rgbs{0%,92%,100%{opacity:0;transform:translate(0,0)}93%{opacity:.6;transform:translate(-4px,2px)}95%{opacity:0}}
.hero .codename{font-family:var(--font-display);font-weight:700;font-size:clamp(1.3rem,4vw,2.6rem);color:var(--on-media)}
.hero .codename span{color:var(--accent-2)}
.hero .tagline{font-family:var(--font-ui);font-weight:600;font-size:clamp(1rem,2vw,1.4rem);color:var(--accent);letter-spacing:var(--ls-5);margin-top:.7rem}
.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.tag{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-5);padding:.4rem .8rem;border:1px solid var(--line);border-radius:50px;background:var(--veil);color:var(--text)}
.tag.hot{border-color:rgba(233,79,61,.55);color:#ffa08f}
.scrollcue{position:absolute;bottom:1.3rem;left:50%;transform:translateX(-50%);z-index:2;font-family:var(--font-ui);letter-spacing:var(--ls-16);text-transform:uppercase;font-size:var(--fs-4);color:var(--muted);animation:bob 2s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,7px)}}

/* Marquee */
.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(90deg,var(--bg-2),var(--surface),var(--bg-2));padding:.8rem 0}
.mtrack{display:flex;gap:2.4rem;white-space:nowrap;width:max-content;animation:scrollx 32s linear infinite;font-family:var(--font-display);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--accent)}
.mtrack .dot{color:var(--accent-2)}
@keyframes scrollx{to{transform:translateX(-50%)}}

/* Section */
section{position:relative;padding:clamp(3rem,7vw,6rem) clamp(1.25rem,5vw,4.5rem)}
.wrap{max-width:var(--maxw);margin:0 auto}
.sec-head{display:flex;align-items:center;gap:1rem;margin-bottom:2rem}
.sec-head .num{font-family:var(--font-display);font-weight:900;font-size:var(--fs-9);color:var(--accent);opacity:.8}
.sec-head h2{font-family:var(--font-display);font-weight:700;font-size:clamp(1.4rem,3.5vw,2.3rem)}
.sec-head .rule{flex:1;height:1px;background:var(--line)}

/* BENTO */
.bento{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:185px;gap:.8rem}
@media(max-width:820px){.bento{grid-template-columns:repeat(2,1fr)}}
.tile{position:relative;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:1.2rem}
.tile .tbg{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;transition:transform .9s ease}
.tile:hover .tbg{transform:scale(1.09)}
.tile.img::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(0deg,var(--scrim-6),var(--scrim-0) 65%)}
.tile>*{position:relative;z-index:2}
.tile .lbl{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-7);font-size:var(--fs-10);text-shadow:0 1px 8px var(--on-media-shadow)}
.tile .sub{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-12);font-size:var(--fs-4);color:var(--accent-2);margin-top:.2rem}
.tile.word{background:linear-gradient(140deg,var(--surface),var(--bg-2));justify-content:center}
.tile.word b{font-family:var(--font-display);font-weight:900;font-size:clamp(1.35rem,2.4vw,2.1rem);line-height:.95;color:var(--accent)}
.tile.word.hot b{color:#ffa08f}
.tile.word small{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-12);font-size:var(--fs-4);color:var(--muted);margin-top:.5rem}
.tile.stat{background:linear-gradient(140deg,var(--surface-2),var(--bg-2));align-items:center;justify-content:center;text-align:center}
.tile.stat .num{font-family:var(--font-display);font-weight:900;font-size:clamp(2.2rem,5vw,3.6rem);color:var(--accent);line-height:1}
.tile.stat .cap{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-13);font-size:var(--fs-4);color:var(--muted);margin-top:.5rem}
.w2{grid-column:span 2}.h2{grid-row:span 2}.b2{grid-column:span 2;grid-row:span 2}
@media(max-width:820px){.b2{grid-column:span 2}.h2{grid-row:span 1}}

/* SHOT */
.shot{position:relative;min-height:90vh;display:flex;align-items:flex-end;padding:clamp(2.5rem,7vw,7rem) clamp(1.25rem,5vw,4.5rem);overflow:hidden}
.shot .sbg{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;animation:kb2 26s ease-in-out infinite alternate}
@keyframes kb2{from{transform:scale(1.08)}to{transform:scale(1.24) translate(-3%,-2%)}}
.shot::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,var(--scrim-0),var(--scrim-3) 60%,var(--bg)),linear-gradient(90deg,var(--scrim-4),transparent 55%)}
.shot__in{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.shot .kx{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-20);text-transform:uppercase;color:var(--accent-2);font-size:var(--fs-6)}
.shot .big{font-family:var(--font-display);font-weight:900;font-size:clamp(3rem,15vw,11.5rem);line-height:.8;color:var(--on-media);text-shadow:0 6px 70px var(--on-media-shadow),0 0 50px rgba(233,79,61,.26);overflow-wrap:normal;text-wrap:balance}
.shot p{max-width:48ch;color:var(--on-media-dim);font-size:clamp(1rem,1.6vw,1.25rem);margin-top:.6rem;text-shadow:0 2px 14px var(--on-media-shadow)}

/* CONTRACT BOARD — Alliance-Aushang (Signatur-Element dieser Seite) */
.cbnote{max-width:64ch;color:var(--muted);font-size:var(--fs-10);line-height:1.55;margin-bottom:1.4rem}
.cbnote b{color:#ffa08f}
.cboard{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:.8rem}
.contract{position:relative;background:var(--surface);border:1px solid var(--line-soft);border-top:2px solid var(--accent-2);padding:1.05rem 1.15rem .95rem;clip-path:polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%)}
.contract::before{content:"";position:absolute;top:0;right:0;width:34px;height:34px;background:repeating-linear-gradient(-45deg,rgba(227,170,75,.5) 0 5px,transparent 5px 10px);clip-path:polygon(100% 0,0 0,100% 100%);opacity:.5}
.contract .cid{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-13);color:var(--accent-2);text-transform:uppercase}
.contract b{display:block;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);color:var(--text);margin:.35rem 0 .25rem}
.contract small{display:block;color:var(--muted);font-size:var(--fs-8);line-height:1.5}
.contract.rep{grid-column:1/-1;border-top-color:var(--accent);background:linear-gradient(140deg,var(--surface-2),var(--bg-2))}
.contract.rep b{color:#ffa08f}
.chips{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem}
.chip{font-family:var(--font-mono);font-size:var(--fs-5);letter-spacing:var(--ls-9);color:var(--text);border:1px solid rgba(227,170,75,.4);padding:.28rem .6rem;border-radius:2px;background:var(--veil)}

/* BASHER — Schrott-Manifest + Spec-Readout */
.basher{display:grid;grid-template-columns:1.15fr .85fr;gap:.9rem}
@media(max-width:900px){.basher{grid-template-columns:1fr}}
.panel{background:var(--surface);border:1px solid var(--line-soft);padding:1.15rem 1.3rem;clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px)}
.panel .phead{display:flex;align-items:baseline;justify-content:space-between;gap:.8rem;border-bottom:1px solid var(--line);padding-bottom:.5rem;margin-bottom:.75rem}
.panel .phead h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--text)}
.panel .phead .pc{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-12);color:var(--accent-2);text-transform:uppercase}
.manifest{list-style:none;display:grid;gap:.45rem;font-family:var(--font-mono);font-size:var(--fs-8)}
.manifest li{display:flex;gap:.7rem;align-items:baseline;border-left:2px solid rgba(227,170,75,.35);padding:.3rem 0 .3rem .7rem;color:var(--text)}
.manifest .mk{color:var(--accent-2);flex:none;font-size:var(--fs-6);letter-spacing:var(--ls-11)}
.manifest small{color:var(--muted);font-family:var(--font-body);font-size:var(--fs-7)}
.readout{display:grid;gap:.4rem;font-family:var(--font-mono);font-size:var(--fs-8)}
.readout .row{display:flex;align-items:baseline;gap:.6rem}
.readout dt{color:var(--muted);font-size:var(--fs-5);letter-spacing:var(--ls-12);text-transform:uppercase;flex:none}
.readout .lead{flex:1;border-bottom:1px dotted rgba(242,236,228,.25);transform:translateY(-3px)}
.readout dd{color:var(--text);text-align:right}
.readout dd em{color:var(--accent-2);font-style:normal}
.bvid{position:relative;grid-column:1/-1;aspect-ratio:21/8;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:center/cover no-repeat;cursor:pointer}
@media(max-width:900px){.bvid{aspect-ratio:16/9}}
.bvid::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,var(--veil-2),transparent 55%)}
.bvid .play{position:absolute;inset:0;margin:auto;width:74px;height:74px;z-index:2;border:0;border-radius:50%;background:var(--scrim-4);color:var(--on-media);font-size:var(--fs-14);cursor:pointer;display:grid;place-items:center;transition:transform var(--dur-base) var(--ease-ui),background var(--dur-base) var(--ease-ui);backdrop-filter:blur(2px)}
.bvid:hover .play{transform:scale(1.12);background:var(--accent);color:var(--ink-media)}
.bvid .vlbl{position:absolute;left:14px;bottom:12px;z-index:2;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-8);color:var(--on-media);text-shadow:0 1px 8px var(--on-media-shadow)}

/* HIT MARKERS — Reticle-Zustandsleiste */
.hmnote{max-width:64ch;color:var(--muted);font-size:var(--fs-10);line-height:1.55;margin-bottom:1.4rem}
.hmnote b{color:#ffa08f}
.hms{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.8rem}
.hm{display:flex;flex-direction:column;align-items:center;text-align:center;gap:.6rem;background:var(--surface);border:1px solid var(--line-soft);border-radius:10px;padding:1.1rem .8rem .95rem;transition:border-color var(--dur-fast) var(--ease-ui),background-color var(--dur-fast) var(--ease-ui)}
.hm:hover{border-color:var(--line);background:var(--surface-2)}
.hm svg{width:56px;height:56px;flex:none}
.hm b{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);letter-spacing:var(--ls-7)}
.hm small{color:var(--muted);font-size:var(--fs-6);line-height:1.4}
.hmaudio{margin-top:1rem;font-family:var(--font-mono);font-size:var(--fs-6);letter-spacing:var(--ls-7);color:var(--muted);border:1px dashed rgba(227,170,75,.4);padding:.7rem .9rem}
.hmaudio b{color:var(--accent-2);font-weight:400}
.hmsrc{margin-top:.6rem;font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-7);color:var(--muted);opacity:.75}

/* Video wall */
.vwall{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:1rem}
.video{position:relative;aspect-ratio:16/9;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--media-void) center/cover no-repeat;cursor:pointer}
.video::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,var(--scrim-4),transparent 55%);pointer-events:none}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:3}
.video .play{position:absolute;inset:0;margin:auto;width:74px;height:74px;z-index:2;border:0;border-radius:50%;background:var(--scrim-4);color:var(--on-media);font-size:var(--fs-14);cursor:pointer;display:grid;place-items:center;transition:transform var(--dur-base) var(--ease-ui),background var(--dur-base) var(--ease-ui);backdrop-filter:blur(2px)}
.video:hover .play{transform:scale(1.12);background:var(--accent);color:var(--ink-media)}
.video .vlbl{position:absolute;left:14px;bottom:12px;z-index:2;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-8);color:var(--on-media);text-shadow:0 1px 8px var(--on-media-shadow)}
.vsrc{margin-top:1rem;font-size:var(--fs-6);color:var(--muted)}.vsrc a{color:var(--accent);border-bottom:1px solid var(--line)}

/* Mosaic gallery */
.mosaic{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:160px;gap:.7rem}
@media(max-width:820px){.mosaic{grid-template-columns:repeat(2,1fr)}}
.mosaic figure{position:relative;margin:0;overflow:hidden;border-radius:10px;border:1px solid var(--line)}
.mosaic img{width:100%;height:100%;object-fit:cover;transition:transform .6s,filter .6s;filter:saturate(.92)}
.mosaic figure:hover img{transform:scale(1.1);filter:saturate(1.15)}
.mosaic figcaption{position:absolute;left:0;right:0;bottom:0;padding:.6rem .7rem;font-family:var(--font-ui);font-weight:600;font-size:var(--fs-6);background:linear-gradient(0deg,var(--scrim-6),transparent)}

/* Footer */
footer{border-top:1px solid var(--line);background:var(--bg-2);padding:clamp(2.5rem,6vw,4rem) clamp(1.25rem,5vw,4.5rem) 3rem}
.pager{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:2rem;max-width:var(--maxw);margin-inline:auto}
.pager>a,.pager>span{flex:1;min-width:min(200px,100%);display:flex;flex-direction:column;border:1px solid var(--line);border-radius:8px;padding:1.1rem 1.3rem;background:var(--surface);transition:border-color var(--dur-base) var(--ease-ui),transform var(--dur-base) var(--ease-ui)}
.pager a:hover{border-color:var(--accent);transform:translateY(-2px)}
.pager .dir{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-14);font-size:var(--fs-4);color:var(--muted)}
.pager .ttl{font-family:var(--font-display);font-weight:700;font-size:var(--fs-10);margin-top:.3rem;overflow-wrap:break-word}
.pager .next{text-align:right}
.pager .disabled{opacity:.35}
.foot-meta{max-width:var(--maxw);margin:0 auto;display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;font-size:var(--fs-7);color:var(--muted)}
.foot-meta a{color:var(--accent)}
.home-link{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-11);text-transform:uppercase;font-size:var(--fs-6)}
.disclaimer{max-width:var(--maxw);margin:1.6rem auto 0;font-size:var(--fs-4);color:var(--muted);opacity:.65;border-top:1px solid var(--line-soft);padding-top:1.2rem}

/* Klickbar-Affordance + Lightbox */
.tile.img,.tile.word,.tile.stat,.mosaic figure{cursor:pointer}
.zoomic{position:absolute;top:.7rem;right:.7rem;z-index:3;width:34px;height:34px;border-radius:50%;background:var(--scrim-4);border:1px solid var(--line);display:grid;place-items:center;font-size:var(--fs-8);color:var(--on-media);opacity:.55;transition:opacity var(--dur-base) var(--ease-ui),background var(--dur-base) var(--ease-ui),transform var(--dur-base) var(--ease-ui)}
.tile.img:hover .zoomic,.tile.word:hover .zoomic,.tile.stat:hover .zoomic,.mosaic figure:hover .zoomic{opacity:1;background:var(--accent);color:var(--ink-media);transform:scale(1.12)}
.lb{position:fixed;inset:0;z-index:9500;display:none;align-items:center;justify-content:center;background:var(--lb-backdrop);backdrop-filter:blur(5px);padding:3vh 3vw}
.lb.open{display:flex}
.lb__body{position:relative;max-width:1120px;width:100%}
.lb__body img{display:block;width:100%;height:auto;max-height:88vh;object-fit:contain;border:1px solid var(--line);border-radius:8px}
.lb__body .ratio{position:relative;aspect-ratio:16/9}
.lb__body .ratio iframe{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:8px}
