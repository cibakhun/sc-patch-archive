<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>
<script is:inline>

const tb=document.getElementById('topbar');
addEventListener('scroll',()=>tb.classList.toggle('scrolled',scrollY>40),{passive:true});
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -10% 0px',threshold:0});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
(function(){const lb=document.getElementById('lb'),lbc=lb.querySelector('.lb__content');
function show(h){lbc.innerHTML=h;lb.classList.add('open');lb.setAttribute('aria-hidden','false');}
function close(){lb.classList.remove('open');lbc.innerHTML='';lb.setAttribute('aria-hidden','true');}
function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
document.querySelectorAll('[data-lb]').forEach(el=>el.addEventListener('click',()=>{const v=el.getAttribute('data-lb');show('<img src="'+v.slice(4)+'" alt="">');}));
document.querySelectorAll('[data-info]').forEach(el=>el.addEventListener('click',()=>{const img=el.getAttribute('data-img'),ti=esc(el.getAttribute('data-title')),tx=esc(el.getAttribute('data-text'));show('<div class="lb__info">'+(img?'<img src="'+img+'" alt="">':'')+'<div class="lb__txt"><h3>'+ti+'</h3><p>'+tx+'</p></div></div>');}));
lb.addEventListener('click',e=>{if(e.target===lb||e.target.closest('.lb__x'))close();});
addEventListener('keydown',e=>{if(e.key==='Escape')close();});})();
(function(){const c=document.getElementById('haze');if(!c)return;const x=c.getContext('2d');let running=false;const fxOn=()=>document.documentElement.getAttribute('data-fx')==='on';let w,h,st;const COL=['#d9b46a','#7cc6e6','#f3e3bd','#a3abb8'];
function size(){w=c.width=innerWidth;h=c.height=Math.max(innerHeight,1);st=Array.from({length:Math.min(90,Math.floor(w/16))},()=>({x:Math.random()*w,y:Math.random()*h,r:Math.random()*2.2+.6,a:Math.random(),s:Math.random()*.009+.002,vx:Math.random()*.22+.05,vy:-(Math.random()*.05+.01),c:COL[Math.floor(Math.random()*COL.length)]}));}
function tick(){if(!running)return;x.clearRect(0,0,w,h);for(const s of st){s.a+=s.s;s.x+=s.vx;s.y+=s.vy;if(s.x>w+6)s.x=-6;if(s.y<-6)s.y=h+6;const o=.12+Math.abs(Math.sin(s.a))*.45;x.globalAlpha=o;x.fillStyle=s.c;x.beginPath();x.arc(s.x,s.y,s.r,0,7);x.fill();}x.globalAlpha=1;requestAnimationFrame(tick);}
size();addEventListener('resize',size);document.addEventListener('vbfxchange',(e)=>{if(e.detail.on&&!running){size();running=true;requestAnimationFrame(tick);}else if(!e.detail.on){running=false;}});if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&fxOn()){running=true;tick();}})();

</script>
