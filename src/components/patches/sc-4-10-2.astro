---
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag.
import SiteNav from '../../components/SiteNav.astro';
import QuickFacts from '../../components/dossier/QuickFacts.astro';
import PatchDossier from '../../components/dossier/PatchDossier.astro';
import PatchSeo from '../../components/dossier/PatchSeo.astro';
import { getEntry } from 'astro:content';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath, href } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const L = (path: string) => href(path, lang);
const NOTES = 'https://robertsspaceindustries.com/en/comm-link/Patch-Notes/21351-Star-Citizen-Alpha-4102';
const entry = await getEntry('patches', '4-10-2');
if (!entry) throw new Error('Patch-Daten 4-10-2 fehlen in src/data/patches/');
const patch = mergePatchEn('4-10-2', entry.data, lang);

const DECK = [
  { kde: 'Bug', ken: 'Bow', de: 'Brücke', en: 'Bridge',
    tde: 'Verglasung neu, die großen Streben an der Nase sind weg. Selbstzerstörung, Port und Schild jetzt im Flug-HUD.',
    ten: 'New glass, the big struts across the nose are gone. Self-destruct, port and shield prompts now in the flight HUD.' },
  { kde: 'Mitte', ken: 'Midship', de: 'Fracht & Lifte', en: 'Cargo & lifts',
    tde: 'Frachtlift mit eigenem Bedienfeld, Taurus-Frachtraum neu zugeschnitten, vorderer Crewlift neu animiert.',
    ten: 'Cargo lift with its own panel, Taurus cargo bay refitted, front crew lift newly animated.' },
  { kde: 'Wohndeck', ken: 'Hab deck', de: 'Wohnbereich', en: 'Habitation',
    tde: 'Persönlicher Stauraum, nutzbare Sitzbänke, VIP-Räume ohne rutschende Möbel, Lichtschalter in jeder Variante.',
    ten: 'Personal storage, usable benches, VIP rooms without sliding furniture, light controls on every variant.' },
  { kde: 'Seite', ken: 'Side', de: 'Luftschleuse', en: 'Airlock',
    tde: 'Die Phoenix bekommt eine seitliche Schleuse. Schalter jetzt in der Frachtraumwand und außen neben der Tür.',
    ten: 'The Phoenix gains a side airlock. Controls now in the cargo bay wall and outside next to the door.' },
  { kde: 'Heck', ken: 'Stern', de: 'Annexdock', en: 'Snub bay',
    tde: 'Dock und Merlin-Andockung überarbeitet, die Kollisionslücke an der Einfahrt ist zu.',
    ten: 'Bay and Merlin docking reworked, the collision gap at the entrance is closed.' },
  { kde: 'Waffen', ken: 'Weapons', de: 'Türme', en: 'Turrets',
    tde: 'Eigene Anzeigen oben und unten, richtige Reichweiten und Schwenkgrenzen, obere Raketenwerfer neu gebaut.',
    ten: 'Own displays top and bottom, correct ranges and gimbal limits, top missile racks rebuilt.' },
  { kde: 'Technik', ken: 'Engineering', de: 'Maschinenraum', en: 'Engineering',
    tde: 'Bauteile leichter zu tauschen, Zustand der Komponentenbuchten korrigiert.',
    ten: 'Components easier to swap, component bay health corrected.' },
  { kde: 'Außen', ken: 'Exterior', de: 'Außenhülle', en: 'Exterior',
    tde: 'Kompletter Neuanstrich mit neuen Schadensstufen, dazu eine Abschieds- und eine Emerald-Lackierung.',
    ten: 'Full art pass with new damage states, plus a retirement and an emerald livery.' },
];
---
<PatchSeo patch={patch} image="/assets/trailer-4-10-2.jpg" />
<style is:inline>

:root{
  --bg:#0e121b;--bg-2:#131926;--surface:#182030;--surface-2:#1f2a3d;
  --accent:#d9b46a;--accent-2:#7cc6e6;--hot:#7cc6e6;
  --text:#eef1f5;--muted:#a3abb8;
  --line:rgba(217,180,106,.24);--line-soft:rgba(238,241,245,.10);
  --glow:0 0 44px rgba(217,180,106,.26);
  --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;
  --maxw:1280px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f7fe;--bg-2:#e9eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#1d1f22;--muted:#515864;--accent:#745502;--accent-2:#055e7a;--hot:#055b76;--ink:#ffffff;--accent-media:#d9b46a;--accent-2-media:#7cc6e6;--line:rgba(140,108,38,.3);--line-soft:rgba(44,46,49,.12);--glow:0 6px 22px rgba(140,108,38,.18)}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.skip{position:absolute;left:-999px;top:0;z-index:200;background:var(--accent);color:var(--ink);padding:.6rem 1rem;font-family:var(--font-ui);font-weight:700}.skip:focus{left:0}

body::after{content:"";position:fixed;inset:0;z-index:9000;pointer-events:none;background:radial-gradient(130% 115% at 50% 38%,transparent 54%,var(--vignette) 100%);opacity:var(--ambient-opacity);-webkit-mask-image:linear-gradient(90deg,#000 0,#000 calc(50% - var(--maxw)/2 - 80px),transparent calc(50% - var(--maxw)/2),transparent calc(50% + var(--maxw)/2),#000 calc(50% + var(--maxw)/2 + 80px),#000 100%);mask-image:linear-gradient(90deg,#000 0,#000 calc(50% - var(--maxw)/2 - 80px),transparent calc(50% - var(--maxw)/2),transparent calc(50% + var(--maxw)/2),#000 calc(50% + var(--maxw)/2 + 80px),#000 100%)}

.hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding:7rem clamp(1.25rem,5vw,4.5rem) 4rem;overflow:hidden}
.hero__photo{position:absolute;inset:0;z-index:0;background:url('/assets/trailer-4-10-2.jpg') center/cover;animation:kb 30s ease-in-out infinite alternate}
@keyframes kb{from{transform:scale(1.06)}to{transform:scale(1.18) translate(-1.5%,-1.5%)}}
.hero__photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,var(--scrim-2),var(--scrim-4) 55%,var(--scrim-4) 90%,var(--bg)),radial-gradient(120% 90% at 78% 22%,transparent,var(--bg) 88%)}
.hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,var(--scanline) 0 1px,transparent 1px 3px);opacity:var(--ambient-opacity)}
#haze{position:absolute;inset:0;z-index:1;opacity:.55}html:not([data-fx="on"]) #haze{display:none}
.hero__in{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.eyebrow{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;font-size:var(--fs-6);color:var(--accent-2)}
.hero h1{position:relative;font-family:var(--font-display);font-weight:900;line-height:.82;letter-spacing:var(--ls-1);margin:.6rem 0 .1rem;font-size:clamp(3.4rem,17vw,14rem);background:linear-gradient(180deg,var(--title-hi),var(--accent) 75%,#6b4f1e);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 36px rgba(217,180,106,.45))}
.hero h1::after{content:attr(data-text);position:absolute;left:3px;top:0;-webkit-text-fill-color:var(--accent-2);color:var(--accent-2);opacity:0;mix-blend-mode:screen;animation:rgbs 9s steps(1) infinite}
@keyframes rgbs{0%,93%,100%{opacity:0;transform:translate(0,0)}94%{opacity:.5;transform:translate(-4px,2px)}96%{opacity:0}}
.hero .codename{font-family:var(--font-display);font-weight:700;font-size:clamp(1.3rem,4vw,2.6rem);color:var(--on-media)}
.hero .codename span{color:var(--accent-2)}
.hero .tagline{font-family:var(--font-ui);font-weight:600;font-size:clamp(1rem,2vw,1.4rem);color:var(--accent);letter-spacing:var(--ls-5);margin-top:.7rem}
.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.4rem}
.tag{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-5);padding:.4rem .8rem;border:1px solid var(--line);border-radius:50px;background:var(--veil);color:var(--text)}
.tag.hot{border-color:rgba(124,198,230,.55);color:#c4e8f7}
.scrollcue{position:absolute;bottom:1.3rem;left:50%;transform:translateX(-50%);z-index:2;font-family:var(--font-ui);letter-spacing:var(--ls-16);text-transform:uppercase;font-size:var(--fs-4);color:var(--muted);animation:bob 2s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,7px)}}

.marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:linear-gradient(90deg,var(--bg-2),var(--surface),var(--bg-2));padding:.8rem 0}
.mtrack{display:flex;gap:2.4rem;white-space:nowrap;width:max-content;animation:scrollx 34s linear infinite;font-family:var(--font-display);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--accent)}
.mtrack .dot{color:var(--accent-2)}
@keyframes scrollx{to{transform:translateX(-50%)}}

section{position:relative;padding:clamp(3rem,7vw,6rem) clamp(1.25rem,5vw,4.5rem)}
.wrap{max-width:var(--maxw);margin:0 auto}
.sec-head{display:flex;align-items:center;gap:1rem;margin-bottom:2rem}
.sec-head .num{font-family:var(--font-display);font-weight:900;font-size:var(--fs-9);color:var(--accent);opacity:.8}
.sec-head h2{font-family:var(--font-display);font-weight:700;font-size:clamp(1.4rem,3.5vw,2.3rem)}
.sec-head .rule{flex:1;height:1px;background:var(--line)}
.lead{max-width:64ch;color:var(--muted);font-size:var(--fs-10);line-height:1.55;margin-bottom:1.4rem}
.lead b{color:#ecd5a3}

.bento{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:185px;gap:.8rem}
@media(max-width:820px){.bento{grid-template-columns:repeat(2,1fr)}}
.tile{position:relative;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:1.2rem}
.tile .tbg{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;transition:transform .9s ease}
.tile:hover .tbg{transform:scale(1.09)}
.tile.img::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,var(--scanline) 0 1px,transparent 1px 3px);opacity:var(--ambient-opacity)}
.tile.img::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(0deg,var(--scrim-6),var(--scrim-0) 65%)}
.tile>*{position:relative;z-index:2}
.tile .lbl{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-7);font-size:var(--fs-10);text-shadow:0 1px 8px var(--on-media-shadow)}
.tile .sub{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-12);font-size:var(--fs-4);color:var(--accent-2);margin-top:.2rem}
.tile.word{background:linear-gradient(140deg,var(--surface),var(--bg-2));justify-content:center}
.tile.word b{font-family:var(--font-display);font-weight:900;font-size:clamp(1.35rem,2.4vw,2.1rem);line-height:.95;color:var(--accent)}
.tile.word.hot b{color:#c4e8f7}
.tile.word small{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-12);font-size:var(--fs-4);color:var(--muted);margin-top:.5rem}
.tile.stat{background:linear-gradient(140deg,var(--surface-2),var(--bg-2));align-items:center;justify-content:center;text-align:center}
.tile.stat .num{font-family:var(--font-display);font-weight:900;font-size:clamp(2.2rem,5vw,3.6rem);color:var(--accent);line-height:1}
.tile.stat .cap{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-13);font-size:var(--fs-4);color:var(--muted);margin-top:.5rem}
.w2{grid-column:span 2}.h2{grid-row:span 2}.b2{grid-column:span 2;grid-row:span 2}
@media(max-width:820px){.b2{grid-column:span 2}.h2{grid-row:span 1}}

.shot{position:relative;min-height:90vh;display:flex;align-items:flex-end;padding:clamp(2.5rem,7vw,7rem) clamp(1.25rem,5vw,4.5rem);overflow:hidden}
.shot .sbg{position:absolute;inset:0;z-index:0;background-size:cover;background-position:center;animation:kb2 26s ease-in-out infinite alternate}
@keyframes kb2{from{transform:scale(1.08)}to{transform:scale(1.24) translate(-3%,-2%)}}
.shot::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,var(--scanline) 0 1px,transparent 1px 3px);opacity:var(--ambient-opacity)}
.shot::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,var(--scrim-0),var(--scrim-3) 60%,var(--scrim-3) 90%,var(--bg)),linear-gradient(90deg,var(--scrim-4),transparent 55%)}
.shot__in{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.shot .kx{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-20);text-transform:uppercase;color:var(--accent-2);font-size:var(--fs-6)}
.shot .big{font-family:var(--font-display);font-weight:900;font-size:clamp(2.6rem,13vw,10rem);line-height:.8;color:var(--on-media);text-shadow:0 6px 70px var(--on-media-shadow),0 0 50px rgba(217,180,106,.26);overflow-wrap:normal;text-wrap:balance}
.shot p{max-width:48ch;color:var(--on-media-dim);font-size:clamp(1rem,1.6vw,1.25rem);margin-top:.6rem;text-shadow:0 2px 14px var(--on-media-shadow)}

.prov{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem}
@media(max-width:1000px){.prov{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.prov{grid-template-columns:minmax(0,1fr)}}
.icard{position:relative;background:var(--surface);border:1px solid var(--line-soft);padding:1.2rem 1.35rem 1.05rem}
.icard::before,.icard::after{content:"";position:absolute;width:16px;height:16px;border:2px solid var(--accent-2);opacity:.75}
.icard::before{top:-1px;left:-1px;border-right:0;border-bottom:0}
.icard::after{bottom:-1px;right:-1px;border-left:0;border-top:0}
.icard .ik{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-13);color:var(--accent-2);text-transform:uppercase}
.icard b{display:block;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);color:var(--text);margin:.35rem 0 .3rem}
.icard small{display:block;color:var(--muted);font-size:var(--fs-8);line-height:1.5}
.icard .route{display:block;margin-top:.6rem;font-family:var(--font-mono);font-size:var(--fs-6);letter-spacing:var(--ls-7);color:var(--accent);overflow-wrap:anywhere}

.track{list-style:none;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.6rem;position:relative;margin-top:.4rem}
@media(max-width:900px){.track{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:520px){.track{grid-template-columns:repeat(2,minmax(0,1fr))}}
.step{position:relative;min-width:0;background:var(--surface);border:1px solid var(--line-soft);border-bottom:3px solid var(--accent);padding:.95rem 1rem .9rem}
.step.a{border-bottom-color:var(--accent-2)}
.step .sn{font-family:var(--font-display);font-weight:900;font-size:var(--fs-12);line-height:1;color:var(--accent)}
.step.a .sn{color:var(--accent-2)}
.step .sk{display:block;margin-top:.45rem;font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--muted)}
.step b{display:block;margin-top:.25rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-9);line-height:1.25;color:var(--text);overflow-wrap:anywhere}
.track.deck{grid-template-columns:repeat(4,minmax(0,1fr))}
@media(max-width:900px){.track.deck{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.track.deck{grid-template-columns:minmax(0,1fr)}}
.step small{display:block;margin-top:.4rem;color:var(--muted);font-size:var(--fs-7);line-height:1.45}
.srnote .chips{margin:.9rem 0 0}
.icard a,.gcard a,.lead a,.qpanel p.after a{color:var(--accent);text-decoration:underline;text-decoration-color:rgba(217,180,106,.45);text-underline-offset:3px}
a.chip{transition:border-color var(--dur-base) var(--ease-ui)}a.chip:hover{border-color:var(--accent)}
.icard a.route{text-decoration:none}
.tracknote{margin-top:1rem;color:var(--muted);font-size:var(--fs-7);line-height:1.5;max-width:70ch}
.tracknote b{color:var(--text)}

.qgrid{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
@media(max-width:900px){.qgrid{grid-template-columns:1fr}}
.qgrid>*{min-width:0}
.qpanel{background:var(--surface);border:1px solid var(--line-soft);padding:1.15rem 1.3rem;clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px)}
.qpanel .phead{display:flex;align-items:baseline;justify-content:space-between;gap:.8rem;border-bottom:1px solid var(--line);padding-bottom:.5rem;margin-bottom:.85rem;min-width:0;overflow-wrap:anywhere}
.qpanel .phead h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--text)}
.qpanel .phead .pc{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-12);color:var(--accent-2);text-transform:uppercase}
.qpanel p{color:var(--muted);font-size:var(--fs-8);line-height:1.55;margin-bottom:.8rem}
.readout{display:grid;gap:.4rem;font-family:var(--font-mono);font-size:var(--fs-8)}
.readout .row{display:flex;align-items:baseline;gap:.6rem}
.readout dt{color:var(--muted);font-size:var(--fs-5);letter-spacing:var(--ls-12);text-transform:uppercase;flex:none}
.readout .lead2{flex:1;border-bottom:1px dotted rgba(238,241,245,.25);transform:translateY(-3px)}
.readout dd{color:var(--text);text-align:right;min-width:0;overflow-wrap:anywhere}
.readout dd em{color:var(--accent-2);font-style:normal}

.sr{display:grid;grid-template-columns:1.25fr .75fr;gap:.9rem}
@media(max-width:900px){.sr{grid-template-columns:1fr}}
.sr>*{min-width:0}
.srshot{min-height:330px}
.srnote{background:var(--surface);border:1px solid var(--line-soft);border-top:2px solid var(--accent);padding:1.15rem 1.3rem}
.srnote h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--text);margin-bottom:.5rem}
.srnote p{color:var(--muted);font-size:var(--fs-8);line-height:1.55;margin-bottom:.9rem}
.qpanel p.after,.srnote p.after{margin:.85rem 0 0}
.srnote p.after a{color:var(--accent)}

.gear{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));gap:.8rem}
.gcard{background:var(--surface);border:1px solid var(--line-soft);border-left:2px solid var(--accent-2);padding:1.05rem 1.15rem .95rem}
.gcard .gk{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-13);color:var(--accent-2);text-transform:uppercase}
.gcard b{display:block;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);color:var(--text);margin:.35rem 0 .25rem}
.gcard small{display:block;color:var(--muted);font-size:var(--fs-8);line-height:1.5}
.chips{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem}
.chip{font-family:var(--font-mono);font-size:var(--fs-5);letter-spacing:var(--ls-9);color:var(--text);border:1px solid rgba(217,180,106,.4);padding:.28rem .6rem;border-radius:2px;background:var(--veil)}

footer{border-top:1px solid var(--line);background:var(--bg-2);padding:clamp(2.5rem,6vw,4rem) clamp(1.25rem,5vw,4.5rem) 3rem}
.pager{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:2rem;max-width:var(--maxw);margin-inline:auto}
.pager>a,.pager>span{flex:1;min-width:min(200px,100%);display:flex;flex-direction:column;border:1px solid var(--line);border-radius:8px;padding:1.1rem 1.3rem;background:var(--surface);transition:border-color var(--dur-base) var(--ease-ui),transform var(--dur-base) var(--ease-ui)}
.pager a:hover{border-color:var(--accent);transform:translateY(-2px)}
.pager .dir{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-14);font-size:var(--fs-4);color:var(--muted)}
.pager .ttl{font-family:var(--font-display);font-weight:700;font-size:var(--fs-10);margin-top:.3rem;overflow-wrap:break-word}
.pager .next{text-align:right}
.pager .disabled{opacity:.35}
.foot-meta{max-width:var(--maxw);margin:0 auto;display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;font-size:var(--fs-7);color:var(--muted)}
.foot-meta a{color:var(--accent)}
.home-link{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-11);text-transform:uppercase;font-size:var(--fs-6)}
.disclaimer{max-width:var(--maxw);margin:1.6rem auto 0;font-size:var(--fs-4);color:var(--muted);opacity:.65;border-top:1px solid var(--line-soft);padding-top:1.2rem}

.tile.img,.tile.word,.tile.stat{cursor:pointer}
.zoomic{position:absolute;top:.7rem;right:.7rem;z-index:3;width:34px;height:34px;border-radius:50%;background:var(--scrim-4);border:1px solid var(--line);display:grid;place-items:center;font-size:var(--fs-8);color:var(--on-media);opacity:.55;transition:opacity var(--dur-base) var(--ease-ui),background var(--dur-base) var(--ease-ui),transform var(--dur-base) var(--ease-ui)}
.tile.img:hover .zoomic,.tile.word:hover .zoomic,.tile.stat:hover .zoomic{opacity:1;background:var(--accent);color:var(--ink-media);transform:scale(1.12)}
.lb{position:fixed;inset:0;z-index:9500;display:none;align-items:center;justify-content:center;background:var(--lb-backdrop);backdrop-filter:blur(5px);padding:3vh 3vw}
.lb.open{display:flex}
.lb__body{position:relative;max-width:1120px;width:100%}
.lb__body img{display:block;width:100%;height:auto;max-height:88vh;object-fit:contain;border:1px solid var(--line);border-radius:8px}
.lb__x{position:absolute;top:-3.4rem;right:0;background:none;border:1px solid var(--line);color:var(--on-media);width:46px;height:46px;border-radius:50%;font-size:var(--fs-12);cursor:pointer;transition:background var(--dur-base) var(--ease-ui),color var(--dur-base) var(--ease-ui)}
.lb__x:hover{background:var(--accent);color:var(--ink-media)}
.lb__info{background:var(--surface);border:1px solid var(--line);border-radius:8px;overflow:hidden;max-height:88vh;overflow-y:auto}
.lb__info img{display:block;width:100%;max-height:46vh;object-fit:cover}
.lb__txt{padding:1.4rem 1.7rem}
.lb__txt h3{font-family:var(--font-display);font-weight:800;font-size:var(--fs-14);color:var(--accent);margin-bottom:.5rem}
.lb__txt p{color:var(--text);font-size:var(--fs-10);line-height:1.6}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
/* Hell-Entsprechungen — erzeugt von scripts/build-light-overrides.mjs. Nicht von Hand ändern. */
:root[data-theme="light"] .tag.hot{border-color:rgba(42,130,163,.73);color:#375e6e}
:root[data-theme="light"] .lead b{color:#6d5416}
:root[data-theme="light"] .tile.word.hot b{color:#375e6e}
:root[data-theme="light"] .icard a,.gcard a,.lead a,.qpanel p.after a{text-decoration-color:rgba(151,112,16,.63)}
</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.10.2' }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.10.2' }]} />

<main id="main">

  <section class="hero">
    <div class="hero__photo" aria-hidden="true"></div>
    <canvas id="haze" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow">{de ? '9. Oktober 2026 · Point-Release' : 'October 9, 2026 · Point Release'}</div>
      <h1 data-text="4.10.2">4.10.2</h1>
      <div class="codename">RSI <span>Discovery Month</span></div>
      <div class="tagline">{de ? 'Die Constellation neu gebaut, dazu ein Event für die RSI-Flotte' : 'The Constellation rebuilt, plus an event for the RSI fleet'}</div>
      <div class="tags">
        <span class="tag hot">{de ? 'Event in Stanton' : 'Event in Stanton'}</span><span class="tag">Constellation Mk IV</span><span class="tag">Mk V Centaurus</span><span class="tag">Skylark</span><span class="tag">{de ? 'VR-Zoom' : 'VR zoom'}</span><span class="tag">{de ? '71 Fehler behoben' : '71 issues fixed'}</span><span class="tag">{de ? 'Kein Wipe' : 'No Wipe'}</span>
      </div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="mtrack">
      <span>RSI DISCOVERY MONTH</span><span class="dot">◆</span><span>CONSTELLATION MK IV</span><span class="dot">◆</span><span>MK V CENTAURUS</span><span class="dot">◆</span><span>SKYLARK</span><span class="dot">◆</span><span>MICROTECH</span><span class="dot">◆</span><span>HAMMERHEAD</span><span class="dot">◆</span><span>{de ? 'PHYSIK-NETZCODE' : 'PHYSICS NETCODE'}</span><span class="dot">◆</span><span>{de ? '71 FEHLER BEHOBEN' : '71 ISSUES CLOSED'}</span><span class="dot">◆</span>
      <span>RSI DISCOVERY MONTH</span><span class="dot">◆</span><span>CONSTELLATION MK IV</span><span class="dot">◆</span><span>MK V CENTAURUS</span><span class="dot">◆</span><span>SKYLARK</span><span class="dot">◆</span><span>MICROTECH</span><span class="dot">◆</span><span>HAMMERHEAD</span><span class="dot">◆</span><span>{de ? 'PHYSIK-NETZCODE' : 'PHYSICS NETCODE'}</span><span class="dot">◆</span><span>{de ? '71 FEHLER BEHOBEN' : '71 ISSUES CLOSED'}</span><span class="dot">◆</span>
    </div>
  </div>

  <QuickFacts facts={patch.keyFacts} stand={`Alpha ${patch.version} · ${patch.dateDisplay}`} lang={de ? 'de' : 'en'} />

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">01</span><h2>Highlights</h2><span class="rule"></span></div>
      <div class="bento reveal">
        <div class="tile img b2" data-lb="img:/assets/trailer-4-10-2.jpg"><div class="tbg" style="background-image:url('/assets/trailer-4-10-2.jpg')"></div><span class="zoomic">⤢</span><div class="lbl">Constellation Mk IV</div><div class="sub">{de ? 'Die ganze Reihe neu gebaut' : 'The whole series rebuilt'}</div></div>
        <div class="tile img" data-lb="img:/assets/t-discovery-1.jpg"><div class="tbg" style="background-image:url('/assets/t-discovery-1.jpg')"></div><span class="zoomic">⤢</span><div class="lbl">Discovery Month</div><div class="sub">{de ? 'Drei Laufbahnen' : 'Three tracks'}</div></div>
        <div class="tile word hot" data-info data-title="Constellation Mk V Centaurus" data-text={de ? 'Die nächste Constellation-Generation steht komplett im Bestand. Sie ist größer und hat 240 SCU Fracht statt 96 bei der Mk IV Andromeda, 170.500 Hüllen- und 200.000 Schild-HP, 32 StrikeForce-II-Raketen und einen Andockplatz für das neue Beiboot, die RSI Skylark.' : 'The next Constellation generation is complete in the catalogue. It is bigger and has 240 SCU of cargo instead of the Mk IV Andromeda\'s 96, 170,500 hull and 200,000 shield HP, 32 StrikeForce II missiles and a docking port for the new snub, the RSI Skylark.'}><span class="zoomic">+</span><b>MK V</b><small>{de ? 'Centaurus + Skylark' : 'Centaurus + Skylark'}</small></div>
        <div class="tile img w2" data-lb="img:/assets/img-hammerhead.jpg"><div class="tbg" style="background-image:url('/assets/img-hammerhead.jpg')"></div><span class="zoomic">⤢</span><div class="lbl">Aegis Hammerhead</div><div class="sub">{de ? 'Neue Fassung · nicht in den Notes' : 'New version · not in the notes'}</div></div>
        <div class="tile stat" data-info data-title={de ? '71 geschlossene Fehler' : '71 closed issues'} data-text={de ? 'Der Patch schließt 71 Fehler seit 4.10.1, darunter mehrere Exploits. 13 kamen über das Issue Council. Fünf davon sind Absturz- und Stabilitätsfehler. Dazu kommen 20 Korrekturen, die schon während 4.10.1 als Hotfix nachgeliefert wurden, vor allem für die Serverstabilität.' : 'The patch closes 71 issues since 4.10.1, including several exploits. 13 came through the Issue Council. Five of them are crash and stability issues. On top come 20 fixes already shipped as hotfixes during 4.10.1, mostly for server stability.'}><span class="zoomic">+</span><div class="num">71</div><div class="cap">{de ? 'Fehler behoben' : 'Issues closed'}</div></div>
        <div class="tile word" data-info data-title={de ? 'VR-Zoom' : 'VR zoom'} data-text={de ? 'VR bekommt einen eigenen Zoom, der das Sichtfeld verengt. Er greift bei F-Interaktion, Präzisionszielen im Schiff und FPS-Visieren und ist als Übergang gedacht, bis Zielfernrohre physikalisch umgesetzt sind. Die Option „Zoom Gameplay Strength“ regelt die Stärke, und 0 schaltet ihn ab.' : 'VR gets its own zoom that narrows the field of view. It applies to F interaction, precision targeting in ships and FPS scopes, as a stopgap until scopes are physicalised. The "Zoom Gameplay Strength" option sets its strength, and 0 turns it off.'}><span class="zoomic">+</span><b>VR<br>ZOOM</b><small>{de ? 'abschaltbar' : 'can be switched off'}</small></div>
        <div class="tile word hot w2" data-info data-title={de ? 'Physik-Netzcode' : 'Physics netcode'} data-text={de ? 'Wie lose Objekte übers Netz abgeglichen werden, ist neu geschrieben. Statt den Serverzustand blind zu übernehmen, bekommt er einen Vertrauenswert. Korrekturen kommen als Geschwindigkeitsschub statt Teleport. Würfe starten am echten Loslass-Moment, und Traktorstrahlen ziehen nichts mehr zurück. Das gilt für Kisten, Granaten und Wurfgegenstände, nicht für Schiffe, Fahrzeuge oder Charaktere.' : 'How loose objects are reconciled across the network has been rewritten. Instead of applying the server state blindly, it gets a trust score. Corrections arrive as velocity nudges instead of teleports. Throws start at the real release moment, and tractor beams no longer drag things back. This applies to crates, grenades and throwables, not to ships, vehicles or characters.'}><span class="zoomic">+</span><b set:html={de ? 'PHYSIK-<br>NETZCODE' : 'PHYSICS<br>NETCODE'} /><small>{de ? 'Kisten, Granaten, Würfe' : 'Crates, grenades, throws'}</small></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">02</span><h2>{de ? 'Die drei Laufbahnen' : 'The three tracks'}</h2><span class="rule"></span></div>
      <p class="lead reveal">{de ? 'Acht Auftraggeber, drei Wege zu denselben Belohnungen. Jeder Auftrag bringt ' : 'Eight contract providers, three paths to the same rewards. Every contract earns '}<b>{de ? 'Eventpunkte' : 'event points'}</b>{de ? ', mit denen man in der eigenen Laufbahn aufsteigt.' : ' that move you up your chosen track.'}</p>
      <div class="prov reveal">
        <article class="icard"><span class="ik">{de ? 'Verteidigung' : 'Defence'}</span><b>BHG · Foxwell · Northrock</b><small>{de ? 'Den Raum um microTech von Piraten freihalten, während die Besucher anreisen: Schiffskampf und Patrouillen, dazu Bodeneinsätze in Höhlen, Außenposten und Distributionszentren.' : 'Keep the space around microTech clear of pirates while visitors arrive: ship combat and patrols, plus ground work at caves, outposts and distribution centres.'}</small><span class="route">microTech · {de ? 'Raum · Boden' : 'space · ground'}</span></article>
        <article class="icard"><span class="ik">Transport</span><b>Ling · Covalex · FTL</b><small>{de ? 'Waren von Landezonen, Distributionszentren und Stationen im niedrigen Orbit zur Expo-Plattform bringen.' : 'Move goods from landing zones, distribution centres and low-orbit stations to the expo platform.'}</small><span class="route">→ {de ? 'Expo-Plattform' : 'expo platform'}</span></article>
        <article class="icard"><span class="ik">{de ? 'Sammeln' : 'Collection'}</span><b>Shubin · Adagio</b><small>{de ? 'Shubin kauft Roh- und Fertigmaterial für den Schiffsbau, Adagio will Rümpfe zum Recycling zerlegt haben, darunter Kruger Merlins, Archimedes und Constellations.' : 'Shubin buys raw and crafted materials for shipbuilding, Adagio wants hulls broken down for recycling, including Kruger Merlins, Archimedes and Constellations.'}</small><span class="route">{de ? 'Rohstoffe · Salvage' : 'Materials · salvage'}</span></article>
        <article class="icard"><span class="ik">{de ? 'Im Bestand' : 'In the catalogue'}</span><b>{de ? '30 neue Familien' : '30 new families'}</b><small>{de ? '12 tragen das Kürzel ' : '12 carry the '}<a href={L('/missionen/rsi-disc-month-refuel-request.html')}>RSI Disc. Month</a>{de ? ', darunter Betankungsrufe in drei Dringlichkeiten, Paketbergung und der Ankauf von raffiniertem Beryl, Eisen und Quantainium. 18 weitere laufen als ' : ' tag, among them refuel calls in three urgencies, package recovery and purchase orders for refined beryl, iron and quantainium. 18 more run as the '}<a href={L('/missionen/iasi-patrol-medium.html')}>{de ? '„Iasi“-Reihe' : '"Iasi" line'}</a>.</small><a class="route" href={L('/missionen.html')}>{de ? '1.355 → 1.387 Familien' : '1,355 → 1,387 families'} →</a></article>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">03</span><h2>{de ? 'Rundgang durch die neue Mk IV' : 'A walk through the new Mk IV'}</h2><span class="rule"></span></div>
      <p class="lead reveal"><a href={L('/schiffe/rsi-constellation-andromeda.html')}>Andromeda</a>, <a href={L('/schiffe/rsi-constellation-aquila.html')}>Aquila</a>, <a href={L('/schiffe/rsi-constellation-phoenix.html')}>Phoenix</a>{de ? ' und ' : ' and '}<a href={L('/schiffe/rsi-constellation-taurus.html')}>Taurus</a>: <b>{de ? 'die ganze Reihe ist neu gebaut' : 'the whole series has been rebuilt'}</b>{de ? '. Die acht Stationen gehen vom Bug zum Heck.' : '. The eight stops run from bow to stern.'}</p>
      <ol class="track deck reveal">
        {DECK.map((d, i) => (
          <li class={i % 2 ? 'step a' : 'step'}><span class="sn">{String(i + 1).padStart(2, '0')}</span><span class="sk">{de ? d.kde : d.ken}</span><b>{de ? d.de : d.en}</b><small>{de ? d.tde : d.ten}</small></li>
        ))}
      </ol>
      <p class="tracknote reveal">{de ? 'Dazu eigene KI- und Missionsvarianten: ' : 'Plus dedicated AI and mission variants: '}<b>{de ? 'NPC-Constellations fliegen den neuen Rumpf' : 'NPC Constellations fly the new hull'}</b>{de ? ', und der Collector-Auftrag gibt jetzt die Gold-Standard-Taurus. Obendrauf liegt ein kompletter Balance-Durchgang.' : ', and the Collector contract now awards the Gold Standard Taurus. A full vehicle balance pass sits on top of it all.'}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>{de ? 'Was sich an Werten bewegt hat' : 'What moved in the numbers'}</h2><span class="rule"></span></div>
      <p class="lead reveal">{de ? 'Der Balance-Durchgang zeigt sich vor allem an der Hülle. ' : 'The balance pass shows mostly in the hull. '}<b>{de ? 'Die Constellation verliert gut 40 Prozent ihrer Hüllen-HP' : 'The Constellation loses over 40 percent of its hull HP'}</b>{de ? '. Die Hammerhead legt gut ein Drittel zu, obwohl die Notes sie nicht erwähnen.' : '. The Hammerhead gains over a third, though the notes never mention it.'}</p>
      <div class="qgrid reveal">
        <div class="qpanel">
          <div class="phead"><h3>Constellation Mk IV</h3><span class="pc">{de ? 'vorher → nachher' : 'before → after'}</span></div>
          <dl class="readout">
            <div class="row"><dt>{de ? 'Hülle Andromeda · Aquila' : 'Hull Andromeda · Aquila'}</dt><span class="lead2"></span><dd>{de ? '180.644 → ' : '180,644 → '}<em>{de ? '103.004' : '103,004'}</em></dd></div>
            <div class="row"><dt>{de ? 'Hülle Phoenix · Taurus' : 'Hull Phoenix · Taurus'}</dt><span class="lead2"></span><dd>{de ? '180.644 → ' : '180,644 → '}<em>{de ? '104.005' : '104,005'}</em></dd></div>
            <div class="row"><dt>{de ? 'Taurus Wasserstoff' : 'Taurus hydrogen'}</dt><span class="lead2"></span><dd>19 → <em>33</em> SCU</dd></div>
            <div class="row"><dt>{de ? 'Name' : 'Name'}</dt><span class="lead2"></span><dd>{de ? 'jetzt mit ' : 'now with '}<em>Mk IV</em></dd></div>
          </dl>
          <p class="after">{de ? 'Lackierungen und Modelle der Reihe laufen im Katalog jetzt ebenfalls unter „Mk IV“.' : 'The series\' liveries and models are now listed under "Mk IV" in the catalogue too.'} <a href={de ? '/de/schiffe/rsi-constellation-andromeda.html' : '/schiffe/rsi-constellation-andromeda.html'}>{de ? 'Zum Datenblatt →' : 'Full data sheet →'}</a></p>
        </div>
        <div class="qpanel">
          <div class="phead"><h3>Aegis Hammerhead</h3><span class="pc">{de ? 'nicht in den Notes' : 'not in the notes'}</span></div>
          <dl class="readout">
            <div class="row"><dt>{de ? 'Hülle' : 'Hull'}</dt><span class="lead2"></span><dd>{de ? '295.600 → ' : '295,600 → '}<em>{de ? '403.400' : '403,400'}</em></dd></div>
            <div class="row"><dt>{de ? 'Schild' : 'Shield'}</dt><span class="lead2"></span><dd>{de ? '144.000 → ' : '144,000 → '}<em>{de ? '211.200' : '211,200'}</em></dd></div>
            <div class="row"><dt>{de ? 'Fracht' : 'Cargo'}</dt><span class="lead2"></span><dd>40 → <em>64</em> SCU</dd></div>
            <div class="row"><dt>{de ? 'Mindestcrew' : 'Minimum crew'}</dt><span class="lead2"></span><dd>9 → <em>8</em></dd></div>
            <div class="row"><dt>{de ? 'Quantum-Reichweite' : 'Quantum range'}</dt><span class="lead2"></span><dd><em>{de ? 'rund ⅓' : 'about ⅓'}</em></dd></div>
          </dl>
          <p class="after">{de ? 'Wie die Constellation steht sie in einer neu gebauten Fassung im Bestand.' : 'Like the Constellation, it is in the catalogue in a rebuilt version.'} <a href={de ? '/de/schiffe/aegs-hammerhead.html' : '/schiffe/aegs-hammerhead.html'}>{de ? 'Zum Datenblatt →' : 'Full data sheet →'}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>{de ? 'Neu im Bestand' : 'New in the catalogue'}</h2><span class="rule"></span></div>
      <p class="lead reveal">{de ? 'Das Event feiert ' : 'The event celebrates '}<b><a href={L('/schiffe/rsi-constellation-mk5-centaurus.html')}>{de ? 'die Constellation Mk V Centaurus' : 'the Constellation Mk V Centaurus'}</a></b>{de ? ' und ihr Beiboot, die ' : ' and its snub, the '}<a href={L('/schiffe/rsi-skylark.html')}>Skylark</a>{de ? '. Beide stehen mit vollständigen Werten im Bestand.' : '. Both are in the catalogue with full stats.'}</p>
      <div class="qgrid reveal">
        <div class="srnote">
          <h3>Constellation Mk V Centaurus</h3>
          <p>{de ? 'Größer als die Mk IV, mit größerer Messe und größerem Frachtraum, stärkeren Türmen und Raketenwerfern und einem neuen Andockplatz für die Skylark.' : 'Bigger than the Mk IV, with a larger mess and cargo bay, stronger turrets and missile racks and a new docking port for the Skylark.'}</p>
          <dl class="readout">
            <div class="row"><dt>{de ? 'Rolle' : 'Role'}</dt><span class="lead2"></span><dd>{de ? 'Frachter / Kanonenschiff' : 'Freight / gunship'}</dd></div>
            <div class="row"><dt>{de ? 'Mindestcrew' : 'Minimum crew'}</dt><span class="lead2"></span><dd>4</dd></div>
            <div class="row"><dt>{de ? 'Hülle / Schild' : 'Hull / shield'}</dt><span class="lead2"></span><dd><em>{de ? '170.500' : '170,500'}</em> / {de ? '200.000' : '200,000'}</dd></div>
            <div class="row"><dt>SCM / Max</dt><span class="lead2"></span><dd>170 / {de ? '1.075' : '1,075'} m/s</dd></div>
            <div class="row"><dt>{de ? 'Fracht' : 'Cargo'}</dt><span class="lead2"></span><dd><em>240</em> SCU</dd></div>
            <div class="row"><dt>{de ? 'Raketen' : 'Missiles'}</dt><span class="lead2"></span><dd>32 × StrikeForce II</dd></div>
          </dl>
          <div class="chips"><span class="chip">Blackthorn</span><span class="chip">Convergence</span><span class="chip">Heritage</span><span class="chip">Magnitude</span><span class="chip">Patrician</span><span class="chip">Starwalker</span></div>
          <p class="after"><a href={de ? '/de/schiffe/rsi-constellation-mk5-centaurus.html' : '/schiffe/rsi-constellation-mk5-centaurus.html'}>{de ? 'Zum Datenblatt →' : 'Full data sheet →'}</a></p>
        </div>
        <div class="srnote">
          <h3>RSI Skylark</h3>
          <p>{de ? 'Die Skylark ist das Beiboot der Mk V, ein wendiger Annexjäger für den Andockplatz der Centaurus. Sie hat dieselben sechs Lackierungen.' : 'The Skylark is the Mk V\'s snub, a nimble snub fighter for the Centaurus\' docking port. It has the same six liveries.'}</p>
          <dl class="readout">
            <div class="row"><dt>{de ? 'Rolle' : 'Role'}</dt><span class="lead2"></span><dd>{de ? 'Annexjäger' : 'Snub fighter'}</dd></div>
            <div class="row"><dt>Crew</dt><span class="lead2"></span><dd>1</dd></div>
            <div class="row"><dt>{de ? 'Hülle / Schild' : 'Hull / shield'}</dt><span class="lead2"></span><dd><em>{de ? '6.230' : '6,230'}</em> / {de ? '6.000' : '6,000'}</dd></div>
            <div class="row"><dt>SCM / Max</dt><span class="lead2"></span><dd>227 / {de ? '1.240' : '1,240'} m/s</dd></div>
            <div class="row"><dt>{de ? 'Wendigkeit' : 'Agility'}</dt><span class="lead2"></span><dd>70 / 58 / 212 °/s</dd></div>
            <div class="row"><dt>{de ? 'Raketen' : 'Missiles'}</dt><span class="lead2"></span><dd>10 × Marksman I</dd></div>
          </dl>
          <p class="after"><a href={de ? '/de/schiffe/rsi-skylark.html' : '/schiffe/rsi-skylark.html'}>{de ? 'Zum Datenblatt →' : 'Full data sheet →'}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>{de ? 'Unter der Haube' : 'Under the hood'}</h2><span class="rule"></span></div>
      <div class="qgrid reveal">
        <div class="qpanel">
          <div class="phead"><h3>{de ? 'Physik-Netzcode' : 'Physics netcode'}</h3><span class="pc">{de ? 'experimentell' : 'experimental'}</span></div>
          <p>{de ? 'Bisher war der Serverzustand eines losen Objekts ganz richtig oder ganz falsch. Ein einziger schlechter Zustand konnte zu Desync, Gummiband-Effekten und hüpfenden Kisten führen. Dazu kam ein Kollisionsfehler, der Objekten zusätzlichen Schwung gab.' : 'Until now a loose object\'s server state was either fully right or fully wrong. A single bad state could cascade into desync, rubber banding and bouncing crates. On top came a collision bug that injected extra force into objects.'}</p>
          <dl class="readout">
            <div class="row"><dt>{de ? 'Serverzustand' : 'Server state'}</dt><span class="lead2"></span><dd>{de ? 'mit ' : 'weighed by '}<em>{de ? 'Vertrauenswert' : 'trust score'}</em></dd></div>
            <div class="row"><dt>{de ? 'Korrektur' : 'Correction'}</dt><span class="lead2"></span><dd>{de ? 'Schub statt Teleport' : 'nudge, not teleport'}</dd></div>
