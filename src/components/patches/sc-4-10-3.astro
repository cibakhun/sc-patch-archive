type Buy = { price: number; shop: string; where: string; system: string };
const PLACES: Record<string, { shop: string; where: string; match: (b: Buy) => boolean }> = {
  lorville: { shop: 'New Deal', where: 'Lorville', match: (b) => b.where === 'Lorville' },
  levski: { shop: "Teach's Ship Shop", where: 'Levski', match: (b) => b.where === 'Levski' },
  pyro: { shop: 'Buy and Fly', where: T('Ruin Station, Checkmate und Orbituary · Pyro', 'Ruin Station, Checkmate and Orbituary · Pyro'), match: (b) => b.system === 'Pyro' },
  area18: { shop: 'Astro Armada', where: 'Area18', match: (b) => b.where === 'Area 18' },
};
const AUEC_SHIPS: [string, string, string[]][] = [
  ['aegs-tiburon', 'Tiburon', ['lorville']],
  ['misc-starlite', 'Starlite', ['lorville', 'levski']],
  ['drak-ironclad', 'Ironclad', ['levski']],
  ['drak-pitbull', 'Pitbull', ['levski', 'pyro']],
  ['drak-ironclad-assault', 'Ironclad Assault', ['pyro']],
  ['glsn-basher', 'Basher', ['pyro']],
  ['orig-m80', 'M80', ['area18']],
  ['gama-tyilui', 'Tyilui', ['area18']],
];
const vehicles = new Map((await getCollection('vehicles')).map((v) => [v.id, v.data]));
const auec = AUEC_SHIPS.map(([id, name, places]) => {
  const v = vehicles.get(id);
  if (!v) throw new Error(`sc-4-10-3: Schiff ${id} fehlt im Bestand`);
  const buy = priceInfo(id)?.buy ?? [];
  return {
    id,
    name,
    thumb: pickThumb(v),
    offers: places.map((p) => {
      const place = PLACES[p];
      const prices = new Set(buy.filter(place.match).map((b) => b.price));
      if (prices.size !== 1) throw new Error(`sc-4-10-3: ${prices.size} aUEC-Preise für ${id} in ${place.where}, erwartet genau einer`);
      return { shop: place.shop, where: place.where, price: [...prices][0] };
    }),
  };
});

