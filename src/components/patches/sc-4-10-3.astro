const NEW_VEHICLES: Link[] = [
  { t: 'Galaxy', h: '/schiffe/rsi-galaxy.html' },
  { t: 'Liberator', h: '/schiffe/anvl-liberator.html' },
  ...['argo-atls-geo-collector-grad02', 'argo-atls-ikti', 'argo-atls-geo-ikti', 'argo-atls-geo-ikti-ntls'].map((id) => {
    const v = vehicles.get(id);
