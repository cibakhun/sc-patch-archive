            <div class="row"><dt>{de ? 'Türme' : 'Turrets'}</dt><span class="lead2"></span><dd>4 × <a href={L('/items/cf-337-panther-repeater.html')}>Panther</a> · 2 × <a href={L('/items/cf-557-galdereen-repeater.html')}>Galdereen</a></dd></div>
