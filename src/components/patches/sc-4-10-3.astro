---
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag.
// Was die Seite sagt, steht in src/lib/patch-4-10-3/inhalt.ts.
import SiteNav from '../../components/SiteNav.astro';
import PatchDossier from '../../components/dossier/PatchDossier.astro';
import PatchSeo from '../../components/dossier/PatchSeo.astro';
import Text from '../patch-blocks/Text.astro';
import { getEntry } from 'astro:content';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath, href } from '../../i18n/ui';
import { HAS_HANGAR } from '../../lib/seo';
import { patchInhalt } from '../../lib/patch-4-10-3/inhalt';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const L = (path: string) => href(path, lang);
const T = (d: string, e: string) => (de ? d : e);
const n = (x: number) => x.toLocaleString(de ? 'de-DE' : 'en-US');
// Änderung mit eigenem Vorzeichen: +3, −21 (echtes Minus), ±0 (UX-Audit P89, vorher „+-21“).
const delta = (d: number) => (d > 0 ? `+${n(d)}` : d < 0 ? `−${n(-d)}` : '±0');
const entry = await getEntry('patches', '4-10-3');
if (!entry) throw new Error('Patch-Daten 4-10-3 fehlen in src/data/patches/');
const patch = mergePatchEn('4-10-3', entry.data, lang);
const I = await patchInhalt(lang);
const W = Object.fromEntries(I.werte.map((g) => [g.id, g]));
const K = Object.fromEntries(I.ausruestung.karten.map((k) => [k.id, k]));
const SALVAGE_MAX = Math.max(...W.salvage.zeilen.map((r) => r.nachher.zahl ?? 0));
---
<PatchSeo patch={patch} image="/assets/img-vanduul.jpg" />
<style is:inline>

:root{
  --bg:#0c0e13;--bg-2:#12151c;--surface:#181c25;--surface-2:#212634;
  --accent:#e0563f;--accent-2:#8fb8d8;--hot:#8fb8d8;
  --text:#eef1f5;--muted:#a3abb8;
  --line:rgba(224,86,63,.24);--line-soft:rgba(238,241,245,.10);--line-ice:rgba(143,184,216,.28);
  --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;
  --maxw:1280px;--gut:clamp(1rem,5vw,4.5rem);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.skip{position:absolute;left:-999px;top:0;z-index:200;background:var(--accent);color:var(--ink);padding:.6rem 1rem;font-family:var(--font-ui);font-weight:700}.skip:focus{left:0}
[id]{scroll-margin-top:5.5rem}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

body::after{content:"";position:fixed;inset:0;z-index:9000;pointer-events:none;background:radial-gradient(130% 115% at 50% 38%,transparent 54%,var(--vignette) 100%);opacity:var(--ambient-opacity);-webkit-mask-image:linear-gradient(90deg,#000 0,#000 calc(50% - var(--maxw)/2 - 80px),transparent calc(50% - var(--maxw)/2),transparent calc(50% + var(--maxw)/2),#000 calc(50% + var(--maxw)/2 + 80px),#000 100%);mask-image:linear-gradient(90deg,#000 0,#000 calc(50% - var(--maxw)/2 - 80px),transparent calc(50% - var(--maxw)/2),transparent calc(50% + var(--maxw)/2),#000 calc(50% + var(--maxw)/2 + 80px),#000 100%)}

.hero{position:relative;min-height:min(86svh,780px);display:flex;flex-direction:column;justify-content:flex-end;padding:7rem var(--gut) 2.4rem;overflow:hidden}
.hero__photo{position:absolute;inset:0;z-index:0;background:url('/assets/img-vanduul.jpg') center/cover;animation:kb 30s ease-in-out infinite alternate}
@keyframes kb{from{transform:scale(1.06)}to{transform:scale(1.18) translate(-1.5%,-1.5%)}}
.hero__photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,var(--scrim-2),var(--scrim-4) 55%,var(--scrim-4) 90%,var(--bg)),radial-gradient(120% 90% at 78% 22%,transparent,var(--bg) 88%)}
.hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,var(--scanline) 0 1px,transparent 1px 3px);opacity:var(--ambient-opacity)}
#haze{position:absolute;inset:0;z-index:1;opacity:.55}html:not([data-fx="on"]) #haze{display:none}
.hero__in{position:relative;z-index:2;max-width:var(--maxw);margin:0 auto;width:100%}
.eyebrow{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;font-size:var(--fs-6);color:var(--accent-2)}
.hero h1{position:relative;font-family:var(--font-display);font-weight:900;line-height:.82;letter-spacing:var(--ls-1);margin:.6rem 0 .2rem;font-size:clamp(3.4rem,15vw,12rem);background:linear-gradient(180deg,var(--title-hi),var(--accent) 75%,#6b4f1e);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 36px rgba(224,86,63,.45))}
.hero .codename{font-family:var(--font-display);font-weight:700;font-size:clamp(1.2rem,3.6vw,2.4rem);color:var(--on-media);line-height:1.15}
.hero .codename span{color:var(--accent-2)}
.hero .chronik{margin-top:1rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-6)}
.hero .chronik a{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;color:var(--accent);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--accent) 45%,transparent)}
.hero .chronik a:hover,.hero .chronik a:focus-visible{border-bottom-color:currentColor}
.hero .tagline{max-width:62ch;font-size:clamp(1rem,1.6vw,1.2rem);line-height:1.5;color:var(--on-media-dim);margin-top:.9rem;text-shadow:0 2px 14px var(--on-media-shadow)}
.jump{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.6rem;list-style:none}
.jump a{display:inline-block;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-5);padding:.42rem .85rem;border:1px solid var(--line-ice);background:var(--veil);color:var(--on-media);transition:border-color var(--dur-base) var(--ease-ui),background var(--dur-base) var(--ease-ui)}
.jump a:hover{border-color:var(--accent-2);background:rgba(143,184,216,.12)}

section.blk{position:relative;padding:clamp(1.8rem,3.5vw,2.8rem) var(--gut)}
.wrap{max-width:var(--maxw);margin:0 auto}
.head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.4rem 1.5rem;border-bottom:1px solid var(--line);padding-bottom:.7rem;margin-bottom:1.4rem}
.head h2{font-family:var(--font-display);font-weight:700;font-size:clamp(1.3rem,3vw,2rem);line-height:1.15}
.head .meta{font-family:var(--font-mono);font-size:var(--fs-6);letter-spacing:var(--ls-7);color:var(--muted)}
.head .meta b{color:var(--accent-2);font-weight:400}
.lead{max-width:68ch;color:var(--muted);font-size:var(--fs-10);line-height:1.55;margin:-.4rem 0 1.4rem}
.lead b{color:var(--text);font-weight:600}
.txt a,.lead a,.note a{color:var(--accent-2);text-decoration:underline;text-decoration-color:rgba(143,184,216,.4);text-underline-offset:3px}
.txt a:hover,.lead a:hover,.note a:hover{text-decoration-color:var(--accent-2)}
.note{margin-top:.8rem;color:var(--muted);font-size:var(--fs-8);line-height:1.5}

.glance{padding-top:clamp(1.6rem,3vw,2.4rem)}
.tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);list-style:none}
@media(max-width:1000px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
.tiles a{position:relative;display:flex;flex-direction:column;gap:.25rem;height:100%;padding:1rem 1.1rem 1.05rem;background:var(--bg-2);transition:background var(--dur-base) var(--ease-ui)}
.tiles a::after{content:"→";position:absolute;top:.85rem;right:1rem;font-family:var(--font-ui);color:var(--muted);transition:transform var(--dur-base) var(--ease-ui),color var(--dur-base) var(--ease-ui)}
.tiles a:hover{background:var(--surface)}
.tiles a:hover::after{transform:translateX(3px);color:var(--accent)}
.tiles .k{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-5);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--accent-2);padding-right:1.4rem}
.tiles .v{font-family:var(--font-display);font-weight:800;font-size:clamp(1.15rem,2vw,1.55rem);line-height:1.15;color:var(--text);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.tiles .s{color:var(--muted);font-size:var(--fs-7);line-height:1.4}
@media(max-width:520px){.tiles a{padding:.75rem .8rem}.tiles a::after{display:none}.tiles .k{padding-right:0;font-size:var(--fs-4)}.tiles .v{font-size:var(--fs-11)}.tiles .s{font-size:var(--fs-6)}}

.ops{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}
@media(max-width:860px){.ops{grid-template-columns:minmax(0,1fr)}}
.op{background:var(--surface);border:1px solid var(--line-soft);border-top:2px solid var(--accent);padding:1.05rem 1.2rem 1rem}
.op .type{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--accent-2)}
.op h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-12);line-height:1.2;margin:.2rem 0 .3rem}
.op p{color:var(--muted);font-size:var(--fs-8);line-height:1.5}
.op ol{list-style:none;margin-top:.75rem;border-top:1px solid var(--line-soft)}
.op li{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.1rem .8rem;border-bottom:1px solid var(--line-soft);padding:.5rem 0}
.op li>a{font-family:var(--font-ui);font-weight:600;font-size:var(--fs-10);color:var(--text);transition:color var(--dur-base) var(--ease-ui)}
.op li>a::after{content:" →";color:var(--accent)}
.op li>a:hover{color:var(--accent)}
.op .rank{font-family:var(--font-mono);font-size:var(--fs-5);letter-spacing:var(--ls-7);color:var(--muted);white-space:nowrap}
.op .reward{flex-basis:100%;font-family:var(--font-mono);font-size:var(--fs-5);color:var(--accent-2);text-decoration:underline;text-decoration-color:rgba(143,184,216,.4);text-underline-offset:3px}

.bay{background:radial-gradient(90% 70% at 50% 0%,rgba(143,184,216,.10),transparent 70%),linear-gradient(180deg,var(--bg),#081018 30%,#081018 70%,var(--bg))}
.ships{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
@media(max-width:900px){.ships{grid-template-columns:minmax(0,1fr)}}
.ship{display:flex;flex-direction:column;border:1px solid var(--line-ice);background:rgba(8,16,24,.7)}
.ship figure{position:relative;aspect-ratio:16/9;overflow:hidden;background:#071019}
.ship figure img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 40%;-webkit-mask-image:linear-gradient(180deg,#000 70%,transparent);mask-image:linear-gradient(180deg,#000 70%,transparent);transition:transform 1.2s var(--ease-ui)}
.ship:hover figure img{transform:scale(1.03)}
.ship .body{padding:0 1.3rem 1.25rem;margin-top:-2.6rem;position:relative}
.ship .maker{font-family:var(--font-mono);font-size:var(--fs-5);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--accent-2)}
.ship h3{font-family:var(--font-display);font-weight:900;font-size:clamp(1.8rem,4vw,2.8rem);line-height:1;margin:.15rem 0 .6rem}
.ship h3 a:hover{color:var(--accent-2)}
.ship .lede{color:var(--muted);font-size:var(--fs-9);line-height:1.55;margin-bottom:.9rem}
.readout{display:grid;gap:.38rem;font-family:var(--font-mono);font-size:var(--fs-8)}
.readout div{display:flex;align-items:baseline;gap:.6rem}
.readout dt{color:var(--muted);font-size:var(--fs-5);letter-spacing:var(--ls-12);text-transform:uppercase;flex:none}
.readout div::after{content:"";order:1;flex:1;min-width:1rem;border-bottom:1px dotted rgba(238,241,245,.22);transform:translateY(-3px)}
.readout dd{order:2;color:var(--text);text-align:right;min-width:0;overflow-wrap:anywhere}
.readout dd a{color:var(--accent-2);text-decoration:underline;text-decoration-color:rgba(143,184,216,.4);text-underline-offset:3px}
.parts{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.9rem;list-style:none}
.parts a{display:inline-block;font-family:var(--font-mono);font-size:var(--fs-5);padding:.25rem .55rem;border:1px solid var(--line-ice);color:var(--text);transition:border-color var(--dur-base) var(--ease-ui)}
.parts a:hover{border-color:var(--accent-2)}
.more{display:inline-block;margin-top:1rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--accent-2)}
.more:hover{color:var(--text)}

.shop{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;list-style:none}
@media(max-width:1100px){.shop{grid-template-columns:repeat(2,minmax(0,1fr))}}
.buy{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line-soft);transition:border-color var(--dur-base) var(--ease-ui)}
.buy:hover{border-color:var(--line)}
.buy .pic{display:block;aspect-ratio:16/9;overflow:hidden;background:linear-gradient(140deg,var(--surface-2),var(--bg-2))}
.buy .pic img{display:block;width:100%;height:100%;object-fit:cover}
.buy .pic .none{display:grid;place-items:center;height:100%;font-family:var(--font-display);font-weight:700;font-size:var(--fs-12);color:rgba(238,241,245,.18)}
.buy .in{padding:.75rem .95rem .85rem}
.buy h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-12);line-height:1.15}
.buy h3 a:hover{color:var(--accent)}
.buy dl{margin-top:.45rem;display:grid;gap:.35rem}
.buy dl div{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:0 .8rem;border-top:1px solid var(--line-soft);padding-top:.35rem}
.buy dt{font-size:var(--fs-7);color:var(--muted);line-height:1.35}
.buy dt b{display:block;color:var(--text);font-family:var(--font-ui);font-weight:600;font-size:var(--fs-8)}
.buy dd{font-family:var(--font-mono);font-size:var(--fs-9);color:var(--accent);font-variant-numeric:tabular-nums;white-space:nowrap}
.buy dd small{font-size:var(--fs-4);color:var(--muted);margin-left:.25rem}
@media(max-width:520px){.shop{grid-template-columns:minmax(0,1fr)}.buy{flex-direction:row}.buy .pic{flex:0 0 34%;aspect-ratio:auto}.buy .in{flex:1;min-width:0;padding:.6rem .75rem .7rem}}
.credit{margin-top:.7rem;font-size:var(--fs-5);color:var(--muted)}

.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem}
@media(max-width:900px){.panels{grid-template-columns:minmax(0,1fr)}}
.panel{min-width:0;background:var(--surface);border:1px solid var(--line-soft);padding:1rem 1.2rem 1.05rem}
.panel>header{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.2rem .8rem;margin-bottom:.5rem}
.panel h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);letter-spacing:var(--ls-11);text-transform:uppercase}
.panel .tag{font-family:var(--font-mono);font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--accent-2)}
.panel .tag.off{color:var(--accent)}
.scroll{overflow-x:auto}
table.ba{width:100%;border-collapse:collapse;font-size:var(--fs-8)}
.ba th{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted);text-align:left;padding:.35rem .6rem .35rem 0;border-bottom:1px solid var(--line)}
.ba td{padding:.45rem .6rem .45rem 0;border-bottom:1px solid var(--line-soft);vertical-align:baseline}
.ba tr:last-child td{border-bottom:0}
.ba td:first-child{font-family:var(--font-ui);font-weight:600;font-size:var(--fs-9)}
.ba td.was{color:var(--muted);font-family:var(--font-mono)}
.ba td.ist{color:var(--text);font-family:var(--font-mono)}
.ba td.ist::before{content:"→ ";color:var(--accent)}
.ba td.ist.only::before{content:""}
.ba .num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
.ba th.num{text-align:right}
.ba a{text-decoration:underline;text-decoration-color:rgba(238,241,245,.25);text-underline-offset:3px}
.ba a:hover{color:var(--accent-2);text-decoration-color:var(--accent-2)}
.ba td.ist a{color:var(--accent-2)}
.ba td.bar{width:38%;padding-right:0}
.bar i{position:relative;display:block;height:8px;background:var(--line-soft)}
.bar i::before,.bar i::after{content:"";position:absolute;left:0;top:0;bottom:0}
.bar i::after{width:calc(var(--b)*100%);background:linear-gradient(90deg,rgba(224,86,63,.55),var(--accent))}
.bar i::before{width:calc(var(--a)*100%);background:var(--muted);z-index:1;opacity:.55}
@media(max-width:560px){
  .ba thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .ba tr{display:flex;flex-wrap:wrap;align-items:baseline;gap:.1rem .6rem;padding:.5rem 0;border-bottom:1px solid var(--line-soft)}
  .ba tr:last-child{border-bottom:0}
  .ba td{padding:0;border:0}
  .ba td:first-child{flex-basis:100%}
  .ba .num{text-align:left}
  .ba td.bar{display:none}
}

.gear{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.9rem}
@media(max-width:1000px){.gear{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.gear{grid-template-columns:minmax(0,1fr)}}
.gear .panel.wide{grid-column:span 2}
@media(max-width:640px){.gear .panel.wide{grid-column:auto}}
.txt{color:var(--muted);font-size:var(--fs-8);line-height:1.55}
.txt b{color:var(--text);font-weight:600}
.list{list-style:none;margin-top:.7rem;border-top:1px solid var(--line-soft)}
.list li{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:.1rem .8rem;padding:.4rem 0;border-bottom:1px solid var(--line-soft);font-size:var(--fs-8)}
.list li>span{color:var(--muted);font-family:var(--font-mono);font-size:var(--fs-5);letter-spacing:var(--ls-9);text-transform:uppercase}
.list a{font-family:var(--font-ui);font-weight:600;font-size:var(--fs-9);color:var(--text);text-decoration:underline;text-decoration-color:rgba(238,241,245,.25);text-underline-offset:3px}
.list a:hover{color:var(--accent-2);text-decoration-color:var(--accent-2)}
.list .refs{display:flex;flex-wrap:wrap;gap:.2rem .7rem}

.fold summary{display:flex;flex-wrap:wrap;align-items:baseline;gap:.3rem 1.2rem;cursor:pointer;list-style:none;padding:1rem 1.2rem;border:1px solid var(--line);border-top:2px solid var(--accent);background:var(--surface);transition:background var(--dur-base) var(--ease-ui)}
.fold summary::-webkit-details-marker{display:none}
.fold summary::after{content:"+";margin-left:auto;font-family:var(--font-display);font-weight:700;color:var(--accent)}
.fold details[open] summary::after{content:"−"}
.fold summary:hover{background:var(--surface-2)}
.fold summary .ttl{font-family:var(--font-display);font-weight:700;font-size:clamp(1.1rem,2.4vw,1.5rem)}
.fold summary .sub{color:var(--muted);font-size:var(--fs-8)}
.fold details .do{padding:1rem 0 0}

footer{border-top:1px solid var(--line);background:var(--bg-2);padding:clamp(2.5rem,6vw,4rem) var(--gut) 3rem}
.pager{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:2rem;max-width:var(--maxw);margin-inline:auto}
.pager>a,.pager>span{flex:1;min-width:min(200px,100%);display:flex;flex-direction:column;border:1px solid var(--line);border-radius:8px;padding:1.1rem 1.3rem;background:var(--surface);transition:border-color var(--dur-base) var(--ease-ui),transform var(--dur-base) var(--ease-ui)}
.pager a:hover{border-color:var(--accent);transform:translateY(-2px)}
.pager .dir{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:var(--ls-14);font-size:var(--fs-4);color:var(--muted)}
.pager .ttl{font-family:var(--font-display);font-weight:700;font-size:var(--fs-10);margin-top:.3rem;overflow-wrap:break-word}
.pager .next{text-align:right}
.pager .disabled{opacity:.35}
.foot-meta{max-width:var(--maxw);margin:0 auto;display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;font-size:var(--fs-7);color:var(--muted)}
.foot-meta a{color:var(--accent)}
.home-link{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-11);text-transform:uppercase;font-size:var(--fs-6)}
.disclaimer{max-width:var(--maxw);margin:1.6rem auto 0;font-size:var(--fs-4);color:var(--muted);opacity:.65;border-top:1px solid var(--line-soft);padding-top:1.2rem}

.reveal{opacity:0;transform:translateY(18px);transition:opacity .6s,transform .6s}.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}*{animation:none!important}}
</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.10.3' }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.10.3' }]} />

<main id="main">

  <section class="hero">
    <div class="hero__photo" aria-hidden="true"></div>
    <canvas id="haze" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow">{I.kopf.eyebrow}</div>
      <h1>{I.kopf.titel}</h1>
      <div class="codename">{I.kopf.codename[0]}<span>{I.kopf.codename[1]}</span></div>
      <p class="tagline">{I.kopf.satz}</p>
      {/* Chronik zu diesem Patch (UX-Audit P71), wie diese Seite nur im Vorschau-Bau. */}
      {HAS_HANGAR && (<p class="chronik"><a href={L('/patches/4-10-3-film.html')}>{T('Chronik: 4.10.3 Schritt für Schritt', 'Chronicle: 4.10.3 step by step')} <span aria-hidden="true">→</span></a></p>)}
      <nav aria-label={T('Abschnitte', 'Sections')}>
        <ul class="jump">
          {I.abschnitte.map((j) => <li><a href={`#${j.id}`}>{j.t}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  <section class="blk glance" aria-label={T('Auf einen Blick', 'At a glance')}>
    <div class="wrap">
      <ul class="tiles reveal">
        {I.kacheln.map((g) => (
          <li><a href={`#${g.ziel}`}><span class="k">{g.k}</span><span class="v">{g.v}</span><span class="s">{g.s}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="blk" id="auftraege">
    <div class="wrap">
      <header class="head reveal">
        <h2>{I.auftraege.titel}</h2>
        <span class="meta">{T('Auftraggeber', 'Contractor')} <b>{I.auftraege.auftraggeber}</b></span>
      </header>
      <p class="lead reveal"><Text text={I.auftraege.lead} /></p>
      <div class="ops reveal">
        {I.auftraege.gruppen.map((m) => (
          <article class="op">
            <span class="type">{m.typ}</span>
            <h3>{m.titel}</h3>
            <p>{m.text}</p>
            <ol>
              {m.auftraege.map((x) => (
                <li>
                  <a href={L(x.link.h)}>{x.titel}</a>
                  <span class="rank">{T('ab', 'from')} {x.rang}</span>
                  {x.belohnung && <a class="reward" href={L(x.belohnung.h)}>{x.belohnung.t}</a>}
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blk bay" id="schiffe">
    <div class="wrap">
      <header class="head reveal">
        <h2>{T('Neue Schiffe', 'New ships')}</h2>
        <span class="meta">{T('Hologramme aus den Rümpfen im Spiel', 'Holograms from the in-game hulls')}</span>
      </header>
      <div class="ships">
        {I.neueSchiffe.map((s) => (
          <article class="ship reveal">
            <figure><img src={s.hologramm.groessen[0].src} alt={s.hologramm.alt} width={s.hologramm.groessen[0].w} height={s.hologramm.groessen[0].h} loading="lazy" decoding="async" /></figure>
            <div class="body">
              <span class="maker">{s.hersteller}</span>
              <h3><a href={L(s.link.h)}>{s.name}</a></h3>
              <p class="lede">{s.text}</p>
              <dl class="readout">
                {s.werte.map((r) => (
                  <div><dt>{r.k}</dt><dd><Text text={r.v} /></dd></div>
                ))}
              </dl>
              {s.module.length > 0 && (
                <ul class="parts">{s.module.map((p) => <li><a href={L(p.h)}>{p.t}</a></li>)}</ul>
              )}
              <a class="more" href={L(s.link.h)}>{T('Zum Datenblatt →', 'Full data sheet →')}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="blk" id="auec">
    <div class="wrap">
      <header class="head reveal">
        <h2>{I.auec.titel}</h2>
        <span class="meta">{T('Kaufpreis im Spiel', 'In-game purchase price')}</span>
      </header>
      <p class="lead reveal"><Text text={I.auec.lead} /></p>
      <ul class="shop reveal">
        {I.auec.schiffe.map((s) => (
          <li class="buy">
            <a class="pic" href={L(s.link.h)} tabindex="-1" aria-hidden="true">
              {s.vorschau ? <img src={s.vorschau} alt="" width="320" height="180" loading="lazy" decoding="async" /> : <span class="none">{s.name}</span>}
            </a>
            <div class="in">
              <h3><a href={L(s.link.h)}>{s.name}</a></h3>
              <dl>
                {s.angebote.map((o) => (
                  <div><dt><b>{o.haendler}</b>{o.ort}</dt><dd>{n(o.preis)}<small>aUEC</small></dd></div>
                ))}
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="credit">{I.auec.bildnachweis}</p>
    </div>
  </section>

  <section class="blk" id="werte">
    <div class="wrap">
      <header class="head reveal">
        <h2>{T('Geänderte Werte', 'Changed values')}</h2>
        <span class="meta"><a href={I.notes.h} target="_blank" rel="noopener">{I.notes.t}</a></span>
      </header>
      <div class="panels reveal">
        <section class="panel" id="radar">
          <header><h3>{W.radar.titel}</h3><span class="tag">{W.radar.tag}</span></header>
          <div class="scroll">
            <table class="ba">
              <thead><tr><th>{T('Schiff', 'Ship')}</th><th>{T('Vorher', 'Before')}</th><th>{T('Jetzt', 'Now')}</th></tr></thead>
              <tbody>
                {W.radar.zeilen.map((r) => (
                  <tr>
                    <td>{r.schiffe.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}</td>
                    {r.vorher ? <td class="was"><Text text={r.vorher.v} /></td> : <td class="was">{T('schon', 'already')}</td>}
                    <td class="ist"><Text text={r.nachher.v} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note"><Text text={W.radar.notiz} /></p>
        </section>

        <section class="panel" id="salvage">
          <header><h3>{W.salvage.titel}</h3><span class="tag">{W.salvage.tag}</span></header>
          <div class="scroll">
            <table class="ba">
              <thead><tr><th>{T('Schiff', 'Ship')}</th><th class="num">{T('Vorher', 'Before')}</th><th class="num">{T('Jetzt', 'Now')}</th><th><span class="sr-only">{T('Vergleich', 'Comparison')}</span></th></tr></thead>
              <tbody>
                {W.salvage.zeilen.map((r) => (
                  <tr>
                    <td><a href={L(r.schiffe[0].h)}>{r.schiffe[0].t}</a></td>
                    <td class="was num">{r.vorher?.zahl}</td>
                    <td class="ist num">{r.nachher.zahl}</td>
                    <td class="bar" aria-hidden="true"><i style={`--a:${(r.vorher?.zahl ?? 0) / SALVAGE_MAX};--b:${(r.nachher.zahl ?? 0) / SALVAGE_MAX}`}></i></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note"><Text text={W.salvage.notiz} /></p>
        </section>

        <section class="panel" id="kampf">
          <header><h3>{W.kampf.titel}</h3><span class="tag">{W.kampf.tag}</span></header>
          <div class="scroll">
            <table class="ba">
              <thead><tr><th>{T('Wert', 'Value')}</th><th>{T('Vorher', 'Before')}</th><th>{T('Jetzt', 'Now')}</th></tr></thead>
              <tbody>
                {W.kampf.zeilen.map((c) => (
                  <tr>
                    <td><Text text={c.was} /></td>
                    {c.vorher ? <td class="was"><Text text={c.vorher.v} /></td> : <td class="ist only" colspan="2"><Text text={c.nachher.v} /></td>}
                    {c.vorher && <td class="ist"><Text text={c.nachher.v} /></td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note"><Text text={W.kampf.notiz} /></p>
        </section>

        <section class="panel" id="vanguard">
          <header><h3>{W.vanguard.titel}</h3><span class="tag off">{W.vanguard.tag}</span></header>
          <div class="scroll">
            <table class="ba">
              <thead><tr><th>{T('Schiff', 'Ship')}</th><th>{T('Wert', 'Value')}</th><th>{T('Vorher', 'Before')}</th><th>{T('Jetzt', 'Now')}</th></tr></thead>
              <tbody>
                {W.vanguard.zeilen.map((r) => (
                  <tr>
                    <td>{r.schiffe.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}</td>
                    <td class="was"><Text text={r.was} /></td>
                    <td class="was">{r.vorher && <Text text={r.vorher.v} />}</td>
                    <td class="ist"><Text text={r.nachher.v} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note"><Text text={W.vanguard.notiz} /></p>
        </section>
      </div>
    </div>
  </section>

  <section class="blk" id="ausruestung">
    <div class="wrap">
      <header class="head reveal">
        <h2>{I.ausruestung.titel}</h2>
        <span class="meta">{T('Baupläne', 'Blueprints')} <b>+{I.ausruestung.bauplaeneNeu}</b></span>
      </header>
      <div class="gear reveal">
        <article class="panel">
          <header><h3>{K.skarnov.titel}</h3><span class="tag">{K.skarnov.tag}</span></header>
          <p class="txt"><Text text={K.skarnov.text} /></p>
          <ul class="list">
            <li><span>{K.skarnov.liste[0].k}</span><span class="refs">{K.skarnov.liste[0].v.map((x) => <a href={L(x.h)}>{x.t}</a>)}</span></li>
            <li><span>{K.skarnov.liste[1].k}</span><a href={L(K.skarnov.liste[1].v[0].h)}>{K.skarnov.liste[1].v[0].t}</a></li>
          </ul>
        </article>
        <article class="panel">
          <header><h3>{K['raider-camo'].titel}</h3><span class="tag">{K['raider-camo'].tag}</span></header>
          <p class="txt"><Text text={K['raider-camo'].text} /></p>
          <ul class="list">
            {I.ausruestung.camo.map((c) => (
              <li><span>{c.k}</span><span class="refs">{c.v.map((x) => <a href={L(x.h)}>{x.t}</a>)}</span></li>
            ))}
          </ul>
        </article>
        <article class="panel">
          <header><h3>{K.deterrent.titel}</h3><span class="tag">{K.deterrent.tag}</span></header>
          <p class="txt"><Text text={K.deterrent.text} /></p>
          <ul class="list">
            {K.deterrent.liste.map((z) => <li><a href={L(z.v[0].h)}>{z.v[0].t}</a></li>)}
          </ul>
        </article>
        <article class="panel wide">
          <header><h3>{K['iae-2956'].titel}</h3><span class="tag">{K['iae-2956'].tag}</span></header>
          <p class="txt"><Text text={K['iae-2956'].text} /></p>
        </article>
        <article class="panel" id="namen">
          <header><h3>{K.namen.titel}</h3><span class="tag">{K.namen.tag}</span></header>
          <p class="txt"><Text text={K.namen.text} /></p>
        </article>
      </div>
    </div>
  </section>

  <section class="blk" id="bestand">
    <div class="wrap">
      <header class="head reveal">
        <h2>{T('Bestand', 'Catalogue')}</h2>
        <span class="meta"><a href={L(I.vorgaenger.h)}>{I.vorgaenger.t}</a> → {I.version}</span>
      </header>
      <div class="panel reveal">
        <div class="scroll">
          <table class="ba">
            <thead><tr><th>{T('Bereich', 'Area')}</th><th class="num">4.10.2</th><th class="num">4.10.3</th><th class="num">{T('Änderung', 'Change')}</th></tr></thead>
            <tbody>
              {I.bestand.zeilen.map((c) => (
                <tr>
                  <td><a href={L(c.was.h)}>{c.was.t}</a></td>
                  <td class="was num">{n(c.vorher)}</td>
                  <td class="ist num">{n(c.nachher)}</td>
                  <td class="num">{delta(c.nachher - c.vorher)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note"><Text text={I.bestand.notiz} /></p>
      </div>
    </div>
  </section>

  <section class="blk fold">
    <details class="wrap" id="akte">
      <summary><span class="ttl">{I.dossier.titel}</span><span class="sub">{I.dossier.text}</span></summary>
      <PatchDossier patch={patch} lang={de ? 'de' : 'en'} />
    </details>
  </section>

</main>

<footer>
  <nav class="pager" aria-label={de ? 'Patch-Navigation' : 'Patch navigation'}>
    <a href={L(I.vorgaenger.h)}><span class="dir">{de ? '← Älter' : '← Older'}</span><span class="ttl">{I.vorgaenger.titel}</span></a>
    <span class="next disabled"><span class="dir">{de ? 'Neuer →' : 'Newer →'}</span><span class="ttl">{de ? 'Aktuellster Patch' : 'Latest patch'}</span></span>
  </nav>
  <div class="foot-meta">
    <a class="home-link" href={de ? '/de/archiv.html' : '/archiv.html'}>{de ? '⌂ Alle Patches' : '⌂ All patches'}</a>
    <span><Fragment set:html={de ? 'Quellen: RSI Patch Notes &amp; Comm-Links · starcitizen.tools' : 'Sources: RSI patch notes &amp; comm-links · starcitizen.tools'} /></span>
  </div>
  <p class="disclaimer"><Fragment set:html={de ? 'Inoffizielles Fan-Projekt. Star Citizen® © Cloud Imperium Rights LLC &amp; Ltd. — keine Verbindung zu CIG. Standbilder &amp; Schiff-/System-Bilder aus offiziellen Quellen (© Cloud Imperium Games), Fan-Content-Nutzung.' : 'Unofficial fan project. Star Citizen® © Cloud Imperium Rights LLC &amp; Ltd. No affiliation with CIG. Stills &amp; ship/system imagery from official sources (© Cloud Imperium Games), fan-content usage.'} /></p>
</footer>

<script is:inline>

const tb=document.getElementById('topbar');
addEventListener('scroll',()=>tb.classList.toggle('scrolled',scrollY>40),{passive:true});
const io=new IntersectionObserver((es)=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -10% 0px',threshold:0});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
(function(){const c=document.getElementById('haze');if(!c)return;const x=c.getContext('2d');let running=false;const fxOn=()=>document.documentElement.getAttribute('data-fx')==='on';let w,h,st;const COL=['#e0563f','#8fb8d8','#f2c2b4','#a3abb8'];
function size(){w=c.width=innerWidth;h=c.height=Math.max(innerHeight,1);st=Array.from({length:Math.min(90,Math.floor(w/16))},()=>({x:Math.random()*w,y:Math.random()*h,r:Math.random()*2.2+.6,a:Math.random(),s:Math.random()*.009+.002,vx:Math.random()*.22+.05,vy:-(Math.random()*.05+.01),c:COL[Math.floor(Math.random()*COL.length)]}));}
function tick(){if(!running)return;x.clearRect(0,0,w,h);for(const s of st){s.a+=s.s;s.x+=s.vx;s.y+=s.vy;if(s.x>w+6)s.x=-6;if(s.y<-6)s.y=h+6;const o=.12+Math.abs(Math.sin(s.a))*.45;x.globalAlpha=o;x.fillStyle=s.c;x.beginPath();x.arc(s.x,s.y,s.r,0,7);x.fill();}x.globalAlpha=1;requestAnimationFrame(tick);}
size();addEventListener('resize',size);document.addEventListener('vbfxchange',(e)=>{if(e.detail.on&&!running){size();running=true;requestAnimationFrame(tick);}else if(!e.detail.on){running=false;}});if(!matchMedia('(prefers-reduced-motion:reduce)').matches&&fxOn()){running=true;tick();}})();

</script>
<link rel="stylesheet" href={versioned('assets/a11y.css', '/assets/a11y.css')} />
<script is:inline src={versioned('assets/a11y.js', '/assets/a11y.js')}></script>
