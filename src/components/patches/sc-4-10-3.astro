            <div class="row"><dt>{de ? 'Mindestcrew' : 'Minimum crew'}</dt><span class="lead2"></span><dd>6</dd></div>
            <div class="row"><dt>{de ? 'Hülle / Schild' : 'Hull / shield'}</dt><span class="lead2"></span><dd><em>{de ? '148.700' : '148,700'}</em> / {de ? '200.000' : '200,000'}</dd></div>
            <div class="row"><dt>SCM / Max</dt><span class="lead2"></span><dd>145 / 950 m/s</dd></div>
            <div class="row"><dt>{de ? 'Fracht' : 'Cargo'}</dt><span class="lead2"></span><dd>64 · <em>720</em> SCU</dd></div>
            <div class="row"><dt>{de ? 'Raketen' : 'Missiles'}</dt><span class="lead2"></span><dd>32 × <a href={L('/items/tempest-ii-missile.html')}>Tempest II</a></dd></div>
          </dl>
          <div class="chips"><a class="chip" href={L('/items/galaxy-cargo-module.html')}>Cargo Module</a><a class="chip" href={L('/items/galaxy-med-bay-module.html')}>Med Bay Module</a><a class="chip" href={L('/items/galaxy-stock-module.html')}>Stock Module</a><a class="chip" href={L('/items/lephari.html')}>{de ? 'Radar Lephari' : 'Lephari radar'}</a></div>
          <p class="after"><a href={L('/schiffe/rsi-galaxy.html')}>{de ? 'Zum Datenblatt →' : 'Full data sheet →'}</a></p>
