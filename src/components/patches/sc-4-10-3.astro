  { to: 'kampf', k: T('Torpedos', 'Torpedoes'), v: T('ab 700 m', 'from 700 m'), s: T('Größe 5 und 7 machen sich erst dann scharf', 'Size 5 and 7 only arm from there') },
  { to: 'ausruestung', k: T('Baupläne', 'Blueprints'), v: '+17', s: T('Raider Camo, Skarnov, Deterrent', 'Raider Camo, Skarnov, Deterrent') },
];

