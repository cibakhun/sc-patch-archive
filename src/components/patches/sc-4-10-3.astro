---
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag.
import SiteNav from '../../components/SiteNav.astro';
import PatchDossier from '../../components/dossier/PatchDossier.astro';
import PatchSeo from '../../components/dossier/PatchSeo.astro';
import { getCollection, getEntry } from 'astro:content';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath, href } from '../../i18n/ui';
import { pickThumb } from '../../lib/shipRenders';
import { priceInfo } from '../../lib/shipExtras';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const L = (path: string) => href(path, lang);
const T = (d: string, e: string) => (de ? d : e);
const n = (x: number) => x.toLocaleString(de ? 'de-DE' : 'en-US');
const NOTES = 'https://robertsspaceindustries.com/en/comm-link/Patch-Notes/21429-Star-Citizen-Alpha-4103';
const entry = await getEntry('patches', '4-10-3');
if (!entry) throw new Error('Patch-Daten 4-10-3 fehlen in src/data/patches/');
const patch = mergePatchEn('4-10-3', entry.data, lang);

type Ref = { t: string; h?: string };
type Link = { t: string; h: string };

const JUMPS = [
  { id: 'auftraege', t: T('Aufträge', 'Contracts') },
  { id: 'schiffe', t: T('Neue Schiffe', 'New ships') },
