---
// MISSION — Detailseite (geteilt DE/EN, Prop `lang`), /missionen/<slug>.html
// Zeigt alles, was zu einer Mission in den Spieldateien steht: Belohnung,
// Reputationshuerden, Auftraggeber, Orte, Regeln, Ablauf — und die Varianten-
// tabelle, wenn die Familie mehrere Angebote buendelt.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import Datenstand from './Datenstand.astro';
import { standMission } from '../lib/datenstand';
import { db, uec, dur, mins, cmpSign, repSummary, repLine, standingLabel, missions, seoText, clip, phLabel, spielerJeInstanz, missionName, missionZusatz, missionVollname, belohnung, ortName, regionenHinweis, rangFolge, regionFolge } from '../lib/missions';
import type { Mission } from '../lib/missions';
import { ICON_BLUEPRINT } from '../lib/icons';
import { lesbarerRufBereich } from '../lib/lesbar';
import { blueprintPath, blueprintsByMission, blueprintListLabels, itemForBlueprint } from '../lib/crafting';
import { itemPath, pageItemIds, displayName } from '../lib/items';
import { href, useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/ui';
import { versioned } from '../lib/assetVersion';
import { patchesMentioning } from '../lib/patchMentions';

interface Props { m: Mission; lang: Locale }
const { m, lang } = Astro.props;
const L = (p: string) => href(p, lang);
const nf = lang === 'de' ? 'de-DE' : 'en-US';

// Eckdaten fuehren in die Missionssuche: Typ, Auftraggeber, Region und Gilde
// oeffnen /missionen.html mit genau diesem Filter (assets/missions-app.js,
// fromUrl — der Wert muss eine Option des Filters sein, sonst setzt die Suche
// ihn nicht). Link wird nur, was eine Kennung hat: giverNames fuehrt auch
// Organisationsnamen aus dem Auftragstext ohne eigenen Auftraggeber-Eintrag,
// die bleiben Text.
const missionSearch = (param: string, id: string) => `${L('/missionen.html')}?${param}=${encodeURIComponent(id)}`;
type FactLink = { n: string; href: string | null };
const factLinks = (names: string[], ids: string[], list: { id: string; name: string }[], param: string): FactLink[] => {
  const known = new Map(list.map((r) => [r.id, r.name]));
  const idByName = new Map<string, string>();
  for (const id of ids) {
    const n = known.get(id);
    if (n && !idByName.has(n)) idByName.set(n, id);
  }
  return names.map((n) => ({ n, href: idByName.has(n) ? missionSearch(param, idByName.get(n)!) : null }));
};
const typeLinks = factLinks(m.typeNames, m.types, db.types, 'type');
const giverLinks = factLinks(m.giverNames, m.givers, db.givers, 'giver');
// Regionen nach Buchstaben, Systeme und Orte davor (vorher A, C, B, D).
const regionLinks = (() => {
  const l = factLinks(m.localityNames, m.localities, db.localities, 'loc');
  const folge = regionFolge(l.map((f) => f.n));
  return l.sort((a, b) => folge.indexOf(a.n) - folge.indexOf(b.n));
})();
const guildLinks = factLinks(m.guilds, db.guilds.filter((g) => m.guilds.includes(g.name)).map((g) => g.id), db.guilds, 'guild');

const S = {
  de: {
    // titleKind nur im <title> (Suchanfrage ist „star citizen <mission>");
    // kind bleibt der sichtbare Eyebrow-Text auf der Seite.
    kind: 'Mission', titleKind: 'Star-Citizen-Mission',
    internal: 'Name abgeleitet', internalT: 'Diese Mission trägt im Spiel keinen festen Titel. Der Name hier ist aus ihrem Arbeitsnamen abgeleitet; Auftraggeber, Ort und Stufe stehen darunter. Im Spiel heißt sie anders.',
    workName: 'Arbeitsname',
    mgHead: 'Auftragstext', mgCode: 'mobiGlas // Übertragung',
    mgEnd: 'Ende der Übertragung', mgAria: 'Auftragstext, wie ihn das mobiGlas anzeigt',
    dynamic: 'Titel wird zur Laufzeit gefüllt',
    dynamicT: 'Kursive Wörter stehen für Werte, die das Spiel einsetzt. Die Vorlage lautet:',
    repNoneShort: 'keine Hürde', more: 'weitere', moreFacts: 'Weitere Angaben', count: 'Anzahl', same: 'gleich',
    appears: 'Erscheint im Spiel als',
    appearsP: 'Je nach Auftraggeber setzt das Spiel einen anderen Titel ein:',
    facts: 'Eckdaten',
    reward: 'Belohnung', rewardR: 'Belohnungsspanne', buyIn: 'Einsatz', type: 'Typ', giver: 'Auftraggeber',
    region: 'Region', places: 'Orte', legal: 'Rechtslage', lawful: 'Legal', unlawful: 'Illegal', mixed: 'Gemischt',
    players: 'Spieler je Instanz', shareable: 'Teilbar', yes: 'Ja', no: 'Nein',
    deadline: 'Zeitlimit', lifetime: 'Angebot verfällt nach', cooldown: 'Abklingzeit', wanted: 'Max. Fahndungsstufe',
    offers: 'Angebote', offersP: 'Dieselbe Mission wird %n% mal angeboten — mit unterschiedlichem Auftraggeber, Ort, Rang oder Lohn.',
    single: 'Dieses Angebot gibt es genau einmal.',
    rep: 'Reputation', repP: 'Diese Bedingungen müssen erfüllt sein, damit die Mission überhaupt erscheint.',
    repNone: 'Keine Reputationsbedingung im Spiel.',
    faction: 'Fraktion', standing: 'Rang', scope: 'Bereich', threshold: 'Schwelle', perk: 'Vorteil',
    flow: 'Ablauf', flowNote: 'Achtung: Das ist nicht der Zieltext aus dem mobiGlas.',
    flowP: 'Der Spielertext der Missionsziele ist nicht verfügbar — die Missionslogik läuft serverseitig. Was hier steht, sind die Schritte und Ablaufregeln, wie die Entwickler sie benannt haben.',
    steps: 'Schritte', rules: 'Ablaufregeln', flowNone: 'Kein Ablauf im Spiel hinterlegt.',
    tblGiver: 'Auftraggeber', tblLoc: 'Region', tblReward: 'Belohnung', tblRep: 'Reputation', tblPlaces: 'Orte',
    module: 'Missionsmodul', entries: 'Angebots-Einträge', tech: 'Technische Details', tags: 'Tags', none: '—', noReward: 'keine',
    guild: 'Gilde', rank: 'Karrierestufe', src: 'Quelle', calcReward: 'wird zur Laufzeit berechnet',
    bpH: 'Blueprints', bpChance: 'Chance',
    bpP: 'Diese Mission kann Blueprints abwerfen. Welcher davon fällt, entscheidet der Zufall — du bekommst nicht die ganze Liste.',
    bpItem: 'Item', bpItemT: 'Item-Datenblatt: %s',
    srcBroker: 'Missionsbrett', srcContract: 'Contract-Manager',
    srcNote: 'Es gibt zwei Missionssysteme: das ältere Missionsbrett und den Contract-Manager, in den CIG gerade migriert. Blueprints und Gilden gibt es nur im zweiten.',
    rec: 'Datensatz',
  },
  en: {
    kind: 'Mission', titleKind: 'Star Citizen Mission',
    internal: 'Derived name', internalT: 'This mission has no fixed title in the game. The name shown is derived from its working name; contractor, location and tier are listed below it. In game it is called something else.',
    workName: 'Working name',
    mgHead: 'Contract briefing', mgCode: 'mobiGlas // transmission',
    mgEnd: 'End of transmission', mgAria: 'Contract briefing as the mobiGlas shows it',
    dynamic: 'Title is filled in at runtime',
    dynamicT: 'Italic words stand for values the game fills in. The template reads:',
    repNoneShort: 'no requirement', more: 'more', moreFacts: 'More details', count: 'Count', same: 'identical',
    appears: 'Appears in game as',
    appearsP: 'Depending on the contractor, the game uses a different title:',
    facts: 'Key facts',
    reward: 'Reward', rewardR: 'Reward range', buyIn: 'Buy-in', type: 'Type', giver: 'Contractor',
    region: 'Region', places: 'Locations', legal: 'Legality', lawful: 'Lawful', unlawful: 'Unlawful', mixed: 'Mixed',
    players: 'Players per instance', shareable: 'Shareable', yes: 'Yes', no: 'No',
    deadline: 'Time limit', lifetime: 'Offer expires after', cooldown: 'Cooldown', wanted: 'Max. wanted level',
    offers: 'Offers', offersP: 'The same mission is offered %n% times — with a different contractor, location, rank or payout.',
    single: 'This offer exists exactly once.',
    rep: 'Reputation', repP: 'These conditions must be met for the mission to show up at all.',
    repNone: 'No reputation requirement in the game.',
    faction: 'Faction', standing: 'Standing', scope: 'Scope', threshold: 'Threshold', perk: 'Perk',
    flow: 'Flow', flowNote: 'Note: this is not the objective text from your mobiGlas.',
    flowP: 'The player-facing objective text is not available — mission logic runs server-side. What follows are the steps and flow rules as the developers named them.',
    steps: 'Steps', rules: 'Flow rules', flowNone: 'No flow recorded in the game.',
    tblGiver: 'Contractor', tblLoc: 'Region', tblReward: 'Reward', tblRep: 'Reputation', tblPlaces: 'Locations',
    module: 'Mission module', entries: 'Offer entries', tech: 'Technical details', tags: 'Tags', none: '—', noReward: 'none',
    guild: 'Guild', rank: 'Career rank', src: 'Source', calcReward: 'calculated at runtime',
    bpH: 'Blueprints', bpChance: 'Chance',
    bpP: 'This mission can drop blueprints. Which one drops is chance-based — you do not get the whole list.',
    bpItem: 'Item', bpItemT: 'Item data sheet: %s',
    srcBroker: 'Mission board', srcContract: 'Contract Manager',
    srcNote: 'There are two mission systems: the older mission board and the Contract Manager that CIG is migrating to. Blueprints and guilds exist only in the latter.',
    rec: 'Record',
  },
}[lang];

// Regex mit geschweiften Klammern gehoert ins Frontmatter: im Template zaehlt
// der Astro-Compiler die Klammern des Literals mit und bricht ab. Der
// Chip-Text laeuft durch phLabel() (D-03) — dieselbe Aufbereitung wie in
// MissionsApp.astro.
const parts = (s: string) => String(s).split(/(\{[^}]*\})/).filter(Boolean)
  .map((x) => (x.startsWith('{') ? { t: phLabel(x.slice(1, -1)), ph: true } : { t: x, ph: false }));
const titleParts = parts(m.title);
// Lesbarer, unterscheidbarer Name (UX-Audit F1, src/lib/missionTitel.ts)
const name = missionName(m);
const zusatz = missionZusatz(m, lang);
const vollname = missionVollname(m, lang);
const reward = belohnung(m, lang);
const descParts = m.desc ? parts(m.desc) : null;
const reps = repSummary(m);
// Rezepte, die DIESE Mission als Quelle nennen. Der Join geht nur in dieser
// Richtung: der Pool in missions.json fuehrt interne Kennungen
// (`klwe_pistol_energy_01_black02`), und die stehen in KEINER committeten
// Datei ein zweites Mal — weder als item.id noch als Blueprint-Name.
// datamine-crafting.mjs:455 kennt die Regel, die beide verbindet, schreibt
// aber nur das Ergebnis (blueprint.missions[]) heraus, nicht den Schluessel.
// Darum wird hier von der Bauplan-Seite her aufgeloest, nicht vom Pool her.
const craftedHere = blueprintsByMission.get(m.slug) ?? [];
const mentions = patchesMentioning(`/missionen/${m.slug}.html`);
// Gleichnamige Bauplaene in DERSELBEN Liste bekommen einen Unterscheider —
// sonst stehen zwei identische Chips da, die auf verschiedene Seiten fuehren
// (Register id 49). Details in blueprintListLabels().
const craftedLabels = blueprintListLabels(craftedHere, lang);
// Gegenrichtung der Bauplanseite (UX-Audit F7): was der Bauplan herstellt,
// als eigener Link neben dem Rezept — nur, wo das Item ein Datenblatt hat.
const craftedItems = craftedHere.map((b) => {
  const it = itemForBlueprint(b);
  return it && pageItemIds.has(it.id) ? it : null;
});
const srcLabel = m.sources.map((s) => (s === 'broker' ? S.srcBroker : S.srcContract)).join(' + ');
const legal = m.lawful && m.unlawful ? S.mixed : m.lawful ? S.lawful : S.unlawful;
const v0 = m.variants[0];
// Gleiche Zeilen der Angebotstabelle zusammenfassen (UX-Audit F3): 43
// Tabellen bestanden ueberwiegend aus identischen Zeilen (Salvage Contractor:
// 24-mal dasselbe). Eine Zeile je Inhalt, mit Anzahl.
// Spalten der Variantentabelle nur zeigen, wenn sie irgendwo etwas enthalten —
// bei 470 Hauling-Angeboten waeren 4 leere Spalten reines Rauschen.
// Steht in einer Spalte ueberall derselbe Wert, sagt sie nichts, was die
// Eckdaten nicht schon sagen (Hauler: 7 Zeilen „Red Wind Linehaul"), und
// eine Belohnungsspalte voller „—" ebenso wenig (UX-Audit F3).
const verschieden = (xs: (string | null | undefined)[]) => new Set(xs.map((x) => x ?? '')).size > 1;
const colGiver = m.variants.some((v) => v.giver) && verschieden(m.variants.map((v) => v.giver));
const colLoc = m.variants.some((v) => v.locality) && verschieden(m.variants.map((v) => v.locality));
const colReward = m.variants.some((v) => v.reward);
const colPlaces = m.variants.some((v) => v.places.length);
const colRep = m.variants.some((v) => v.rep.length);
// Ist die ganze Mission legal oder illegal, steht das schon in den Eckdaten.
const colLegal = m.lawful && m.unlawful;
// Bei 96 Missionen bliebe sonst nur die Spalte Belohnung: 87 Einzelangebote, die
// die Eckdaten wiederholen, und 9 mit mehreren Angeboten und ueberall „—“.
// Unterschiedliche Betraege allein tragen die Tabelle auch: die Spanne in
// den Eckdaten sagt nicht, wie viele Angebote wie viel zahlen (Review #428).
const offerTable = colGiver || colLoc || colPlaces || colRep || colLegal || verschieden(m.variants.map((v) => String(v.reward ?? '')));
type Zeile = { giver: string; loc: string; places: string; legal: boolean; reward: string; rep: string; n: number };
const zeilen: Zeile[] = [];
{
  const idx = new Map<string, Zeile>();
  for (const v of m.variants) {
    const z: Zeile = {
      giver: v.giver ?? S.none,
      loc: v.locality ?? S.none,
      places: v.places.length ? v.places.map(ortName).join(', ') : S.none,
      legal: v.lawful,
      reward: v.reward ? uec(v.reward, lang) : S.none,
      rep: v.rep.length ? v.rep.map((r) => repLine(r, lang)).join(' · ') : S.none,
      n: 1,
    };
    const k = [colGiver && z.giver, colLoc && z.loc, colPlaces && z.places, colLegal && z.legal, colReward && z.reward, colRep && z.rep].join('\u0001');
    const da = idx.get(k);
    if (da) da.n++;
    else { idx.set(k, z); zeilen.push(z); }
  }
}
// Zeilen in der Reihenfolge der Eckdaten: Systeme vorn, Regionen nach Buchstaben
if (colLoc) {
  const folge = regionFolge([...new Set(zeilen.map((z) => z.loc))]);
  zeilen.sort((a, b) => folge.indexOf(a.loc) - folge.indexOf(b.loc));
}
const colN = zeilen.some((z) => z.n > 1);
// Kopfzeile der Eckdaten: Ruf als eine Zeile, Region mit Erklaerung
const repKurz = reps.length ? repLine(reps[0], lang) : null;
const regionText = regionenHinweis(m.localityNames, lang);
const related = missions
  .filter((o) => o.slug !== m.slug && o.types.some((t) => m.types.includes(t)))
  .sort((a, b) => b.count - a.count).slice(0, 6);
// SEO-Meta: seoName statt plain — plain laesst {TargetName} & Co. als rohes
// CamelCase stehen; im h1 bleiben die Marker sichtbar (titleParts), aber in
// <title>/description sollen lesbare Woerter stehen. clip() kuerzt an der
// Wortgrenze auf SERP-Laenge (~160), statt hart bei 180 abzuschneiden.
const seoName = vollname;
// Platzhalter-Descs aus dem DataCore („Mission description (WIP)“) fallen
// unter die 50-Zeichen-SEO-Schwelle — dann trägt das generische Template mehr.
const descFallback = lang === 'de'
  ? `${seoName}: Belohnung, Reputation, Auftraggeber und Orte für Star Citizen.`
  : `${seoName}: reward, reputation, contractors and locations for Star Citizen.`;
const descFromData = m.desc ? `${seoName} — ${seoText(m.desc)}` : '';
const desc = clip(descFromData.length >= 50 ? descFromData : descFallback);
const t = useTranslations(lang);
---
<Layout
  title={`${seoName} — ${S.titleKind} | VerseBase`}
  description={desc}
  themeColor="#0b0906"
  footer={false}
  ogType="article"
  translated={true}
  itemPage={{ modified: db.meta.generated }}
>
  <link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
  <style is:inline>
    :root {
      --bg: #0b0906; --bg-2: #110d08; --surface: #191309; --surface-2: #221a0e;
      --accent: #f5a524; --accent-2: #ffd79a; --hot: #ff7a45;
      --text: #f3ece1; --muted: #a1927c; --line: rgba(245, 165, 36, .22); --line-soft: rgba(243, 236, 225, .10);
      --glow: 0 0 44px rgba(245, 165, 36, .26); --ink: #0b0906; --maxw: 1180px;
    }
  </style>

  <a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
  {/* crumbs -> BreadcrumbList-JSON-LD (wie Schiffe/Topics); hasEn, damit der
      Sprachumschalter zur Mission wechselt statt zur EN-Startseite. */}
  <SiteNav
    crumbs={[
      { label: t('crumbs.archive'), href: L('/index.html') },
      { label: t('crumbs.missions'), href: L('/missionen.html') },
      { label: name.titel },
    ]}
    hasEn={true}
  />

  <main id="main" class="md">
    <div class="md__wrap">
      <header class="md__head">
        <p class="md__eyebrow">{m.typeNames.join(' · ') || S.kind}</p>
        {/* Lesbarer Titel (UX-Audit F1): Platzhalter als kursives
            allgemeines Wort; darunter, was gleichnamige Missionen
            unterscheidet. Die Vorlage mit Marken steht im Hinweis unten. */}
        {/* Missionstitel sind englisch (im Spiel gibt es keine deutschen).
            lang="en" laesst den Browser englisch trennen — mit der Seiten-
            sprache wurde „Ship Mined Ore" zu „Ship Mi- / ned Ore". */}
        <h1 class="md__h1" lang={lang === 'de' ? 'en' : undefined}>
          {name.teile.map((p) => (p.gen ? <i class="md__gen">{p.t}</i> : <span>{p.t}</span>))}
        </h1>
        {zusatz && <p class="md__sub">{zusatz}</p>}

        {/* Eckdaten VOR dem Auftragstext (UX-Audit F2): Belohnung, Ruf,
            Region und Typ standen nach 1,3 Bildschirmen Brieftext, am
            Telefon nach 2,2. Leere Felder fallen weg, statt „—" zu zeigen. */}
        <dl class="md__key">
          <div class="md__keyLohn">
            <dt>{m.rewardMin === m.rewardMax ? S.reward : S.rewardR}</dt>
            <dd><span class={reward.zahl ? 'md__uec' : 'md__var'}>{reward.text}</span>{reward.hinweis && <small class="md__hint">{reward.hinweis}</small>}</dd>
          </div>
          <div>
            <dt>{S.rep}</dt>
            <dd>{repKurz ? <a class="md__fact" href="#ruf">{repKurz}</a> : <span class="md__dim">{S.repNoneShort}</span>}{reps.length > 1 && <span class="md__dim"> +{reps.length - 1}</span>}</dd>
          </div>
          {regionLinks.length > 0 && (
            <div class:list={[{ md__keyWeit: regionLinks.length > 2 || (regionText?.length ?? 0) > 40 }]}>
              <dt>{S.region}</dt>
              <dd>{regionLinks.map((f, i) => <>{i > 0 && ', '}{f.href ? <a class="md__fact" href={f.href}>{f.n}</a> : f.n}</>)}{regionText && <small class="md__hint">{regionText}</small>}</dd>
            </div>
          )}
          {typeLinks.length > 0 && (
            <div>
              <dt>{S.type}</dt>
              <dd>{typeLinks.map((f, i) => <>{i > 0 && ', '}{f.href ? <a class="md__fact" href={f.href}>{f.n}</a> : f.n}</>)}</dd>
            </div>
          )}
          {giverLinks.length > 0 && (
            <div>
              <dt>{S.giver}</dt>
              <dd>{giverLinks.map((f, i) => <>{i > 0 && ', '}{f.href ? <a class="md__fact" href={f.href}>{f.n}</a> : f.n}</>)}</dd>
            </div>
          )}
          {craftedHere.length > 0 && (
            <div>
              <dt>{S.bpH}</dt>
              <dd><a class="md__fact" href="#blueprints">{craftedHere.length}</a>{m.bpChance != null && <span class="md__dim"> · {S.bpChance} {Math.round(m.bpChance * 100)}%</span>}</dd>
            </div>
          )}
        </dl>

        {/* Auftragstext — inszeniert als mobiGlas-Uebertragung (Holo-Panel
            mit Brackets + Scanlines). */}
        {descParts && (
          <figure class="md__mg" role="group" aria-label={S.mgAria}>
            <figcaption class="md__mgHead">
              <span class="md__mgDot" aria-hidden="true"></span>
              <span>{S.mgHead}</span>
              <span class="md__mgCode">{S.mgCode}</span>
            </figcaption>
            <p class="md__desc">
              {descParts.map((p) => (p.ph ? <i class="md__ph md__ph--sm">{p.t}</i> : <span>{p.t}</span>))}
            </p>
            <p class="md__mgEnd" aria-hidden="true">{S.mgEnd}</p>
          </figure>
        )}

        {m.noTitle && (
          <p class="md__warn" role="note">
            <b>{S.internal}.</b> {S.internalT}
          </p>
        )}
        {m.titleDynamic && !m.noTitle && (
          <p class="md__warn" role="note">
            <b>{S.dynamic}.</b> {S.dynamicT}{' '}
            <span class="md__tpl">{titleParts.map((p) => (p.ph ? <i class="md__ph md__ph--sm">{p.t}</i> : <span>{p.t}</span>))}</span>
          </p>
        )}
      </header>

      {/* Konkrete Titel je Auftraggeber */}
      {m.titleVariants.length > 0 && (
        <section class="md__sec">
          <h2 class="md__h2">{S.appears}</h2>
          <p class="md__p">{S.appearsP}</p>
          <ul class="md__appear">
            {m.titleVariants.map((v) => (
              <li><span class="md__org">{v.org}</span><span class="md__at">{parts(v.text).map((p) => (p.ph ? <i class="md__ph md__ph--sm">{p.t}</i> : <span>{p.t}</span>))}</span></li>
            ))}
          </ul>
        </section>
      )}

      {/* Weitere Angaben — was oben in den Eckdaten steht, fehlt hier. */}
      <section class="md__sec">
        <h2 class="md__h2">{S.moreFacts}</h2>
        <dl class="md__facts">
          {m.guilds.length > 0 && <div><dt>{S.guild}</dt><dd>{guildLinks.map((f, i) => <>{i > 0 && ', '}{f.href ? <a class="md__fact" href={f.href}>{f.n}</a> : f.n}</>)}{m.orgs.length > 0 && <span class="md__dim"> · {m.orgs.join(', ')}</span>}</dd></div>}
          {m.ranks.length > 0 && <div><dt>{S.rank}</dt><dd>{rangFolge(m.ranks).join(', ')}</dd></div>}
          <div><dt>{S.legal}</dt><dd>{legal}</dd></div>
          <div><dt>{S.offers}</dt><dd>{m.count.toLocaleString(nf)}</dd></div>
          <div><dt>{S.src}</dt><dd>{srcLabel}</dd></div>
          {spielerJeInstanz(m) != null && <div><dt>{S.players}</dt><dd>{spielerJeInstanz(m)}</dd></div>}
          <div><dt>{S.shareable}</dt><dd>{m.shareable ? S.yes : S.no}</dd></div>
          {v0.buyIn > 0 && <div><dt>{S.buyIn}</dt><dd>{uec(v0.buyIn, lang)} aUEC</dd></div>}
          {dur(v0.deadlineSec, lang) && <div><dt>{S.deadline}</dt><dd>{dur(v0.deadlineSec, lang)}</dd></div>}
          {mins(v0.lifetimeMin, lang) && <div><dt>{S.lifetime}</dt><dd>{mins(v0.lifetimeMin, lang)}</dd></div>}
          {mins(v0.cooldownMin, lang) && <div><dt>{S.cooldown}</dt><dd>{mins(v0.cooldownMin, lang)}</dd></div>}
          {v0.wantedMax != null && <div><dt>{S.wanted}</dt><dd>{v0.wantedMax}</dd></div>}
        </dl>
        {m.places.length > 0 && (
          <>
            <h3 class="md__h3">{S.places}</h3>
            <ul class="md__tags">{m.places.map((p) => <li class="md__tag">{ortName(p)}</li>)}</ul>
          </>
        )}
        {/* Der interne Pfad des Missionsmoduls (PU/PU_Missions/…) und die internen
            Kennungen der Angebote sind fuer die Fehlersuche nuetzlich, aber nichts
            fuer Spieler — deshalb eingeklappt (Krisz 04.11.2026). */}
        <details class="md__tech">
          <summary>{S.tech}</summary>
          <dl class="md__facts">
            {m.noTitle && <div><dt>{S.workName}</dt><dd>{m.title}</dd></div>}
            {m.module && <div><dt>{S.module}</dt><dd><code class="md__code">{m.module}</code></dd></div>}
            <div><dt>{S.entries}</dt><dd><ul class="md__tags">{m.variants.map((v) => <li><code class="md__code">{v.key}</code></li>)}</ul></dd></div>
          </dl>
        </details>
      </section>

      {/* Blueprints — die Antwort auf "wirft die was ab?"

          Bis 27.08.2026 standen hier ZWEI Listen uebereinander: erst der rohe
          Pool aus den Spieldaten — die Kennung `BP_MISSIONREWARD_…` als
          sichtbarer Text, darunter Eintraege wie `klwe_pistol_energy_01_black02`
          ohne Verweis —, darunter dieselbe Sache noch einmal lesbar und
          verlinkt. Gemessen ueber alle 335 Familien mit Pool:

            3.823 Pool-Eintraege, davon 0 mit einem Gewicht ungleich 1
            74 Familien mit mehr als einem Pool, davon 0 mit abweichender Chance
            335 von 335 Familien: die lesbare Liste ist mindestens so lang
                wie der Pool — Unterdeckung 0, Familien ohne lesbare Liste 0

          Der Rohblock trug damit keine einzige Angabe, die nicht daneben stand.
          Was er stattdessen trug: 483 Maschinenkennungen auf 335 Seiten, davon
          224 Seiten mit rohen Klassennamen als Listeneintrag. Er ist ersatzlos
          entfallen; Anzahl und Chance stehen weiter in der Ueberschrift.

          Die Zahl 335 haelt ab jetzt die Klinke `missionenMitBauplan`
          (scripts/lib/metrics-baseline.mjs). Bricht ein kuenftiger Datenlauf
          den Join, verschwindet dieser Abschnitt nicht mehr still — das Tor
          reisst vorher. */}
      {craftedHere.length > 0 && (
        <section class="md__sec" id="blueprints">
          <h2 class="md__h2">
            <Fragment set:html={ICON_BLUEPRINT} /> {S.bpH} <span class="md__n">{craftedHere.length}</span>
            {m.bpChance != null && <span class="md__badge md__badge--bp">{S.bpChance} {Math.round(m.bpChance * 100)}%</span>}
          </h2>
          <p class="md__p">{S.bpP}</p>
          <ul class="md__tags">
            {craftedHere.map((b, i) => (
              <li class="md__tag md__tag--bp">
                <a href={L(blueprintPath(b))}>{craftedLabels[i]}</a>
                {craftedItems[i] && (
                  <a class="md__itemLink" href={L(itemPath(craftedItems[i]!))} aria-label={S.bpItemT.replace('%s', displayName(craftedItems[i]!, lang))} title={S.bpItemT.replace('%s', displayName(craftedItems[i]!, lang))}>{S.bpItem}<span aria-hidden="true"> ↗</span></a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Reputation */}
      <section class="md__sec" id="ruf">
        <h2 class="md__h2">{S.rep}</h2>
        {reps.length ? (
          <>
            <p class="md__p">{S.repP}</p>
            <div class="md__tblWrap">
              <table class="md__tbl">
                <thead><tr>
                  <th>{S.faction}</th><th>{S.scope}</th><th>{S.standing}</th><th>{S.threshold}</th><th>{S.perk}</th>
                </tr></thead>
                <tbody>
                  {reps.map((r) => (
                    <tr>
                      <td>{r.factionName ?? S.none}</td>
                      <td class="md__dim">{r.scope ? lesbarerRufBereich(r.scope) : S.none}</td>
                      <td>{r.standing ? <><span class="md__cmp">{cmpSign(r.comparison)}</span> {standingLabel(r, lang, false)}</> : S.none}</td>
                      <td class="md__num">{r.standingMin != null ? uec(r.standingMin, lang) : S.none}</td>
                      <td class="md__dim">{r.perk ?? S.none}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : <p class="md__p md__dim">{S.repNone}</p>}
      </section>

      {/* Ablauf — bewusst NICHT "Ziele" */}
      <section class="md__sec">
        <h2 class="md__h2">{S.flow}</h2>
        <p class="md__note"><b>{S.flowNote}</b> {S.flowP}</p>
        {(m.flow.steps.length || m.flow.rules.length) ? (
          <>
            {m.flow.steps.length > 0 && (
              <>
                <h3 class="md__h3">{S.steps}</h3>
                <ol class="md__steps">
                  {m.flow.steps.map((s) => (
                    <li><code class="md__code">{s.name}</code>{s.startsActive && <span class="md__badge">start</span>}</li>
                  ))}
                </ol>
              </>
            )}
            {m.flow.rules.length > 0 && (
              <>
                <h3 class="md__h3">{S.rules}</h3>
                <ul class="md__rules">{m.flow.rules.map((r) => <li>{r}</li>)}</ul>
              </>
            )}
          </>
        ) : <p class="md__p md__dim">{S.flowNone}</p>}
      </section>

      {/* Varianten */}
      <section class="md__sec">
        <h2 class="md__h2">{S.offers} <span class="md__n">{m.count.toLocaleString(nf)}</span></h2>
        {m.count > 1 ? (
          <p class="md__p" set:html={S.offersP.replace('%n%', m.count.toLocaleString(nf))} />
        ) : <p class="md__p md__dim">{S.single}</p>}
        {offerTable && (
          <div class="md__tblWrap">
            <table class="md__tbl md__tbl--var">
              <thead><tr>
                {colN && <th class="md__num">{S.count}</th>}
                {colGiver && <th>{S.tblGiver}</th>}
                {colLoc && <th>{S.tblLoc}</th>}
                {colPlaces && <th>{S.tblPlaces}</th>}
                {colLegal && <th>{S.legal}</th>}
                {colReward && <th>{S.tblReward}</th>}
                {colRep && <th>{S.tblRep}</th>}
              </tr></thead>
              <tbody>
                {zeilen.map((z) => (
                  <tr>
                    {colN && <td class="md__num">{z.n > 1 ? `${z.n} ×` : ''}</td>}
                    {colGiver && <td>{z.giver}</td>}
                    {colLoc && <td>{z.loc}</td>}
                    {colPlaces && <td class="md__dim md__places">{z.places}</td>}
                    {colLegal && <td>{z.legal ? S.lawful : <span class="md__badge md__badge--il">{S.unlawful}</span>}</td>}
                    {colReward && <td class="md__num md__uec">{z.reward}</td>}
                    {colRep && <td class="md__dim">{z.rep}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      {mentions.length > 0 && (
        <section class="md__sec">
          <h2 class="md__h2">{lang === 'de' ? 'Im Patch-Archiv' : 'In the patch archive'}</h2>
          <ul class="md__rel">
            {mentions.map((p) => (
              <li>
                {p.page ? (
                  <a href={L(p.page)}>
                    <b>Alpha {p.version}</b>
                    <span>{p.codename}</span>
                  </a>
                ) : (
                  <span>
                    <b>Alpha {p.version}</b>
                    <span>{p.codename}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Verwandte */}
      {related.length > 0 && (
        <section class="md__sec">
          <h2 class="md__h2">{lang === 'de' ? 'Ähnliche Missionen' : 'Related missions'}</h2>
          <ul class="md__rel">
            {related.map((r) => (
              <li>
                <a href={L(`/missionen/${r.slug}.html`)}>
                  <b>{missionName(r).titel}</b>
                  <span>{[missionZusatz(r, lang) || r.typeNames[0] || '', r.rewardMax ? `${uec(r.rewardMax, lang)} aUEC` : ''].filter(Boolean).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <Datenstand lang={lang} zeilen={standMission(lang)} innen melden />
    </div>
  </main>

  {/* Keine Quellen-Zeile im Fuss: die Missionsdaten sind eigene Aufbereitung,
      und die Vorgabe von Attribution (Wiki, RSI, YouTube) stimmte hier nicht.
      Ihren Stand nennt der Datenstand am Ende des Inhalts. */}
  <Attribution sources={[]} />
  <script is:inline defer src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>

{/* KEIN is:inline: gebuendelt in den <head> statt hinter den Inhalt (FOUC).
    Die :root-Palette oben bleibt inline — die muss detail.css ueberschreiben. */}
<style>
  /* Der obere Abstand war mit 5,5rem fest verdrahtet und meinte die
     Kopfleiste. Seit die Zurueck-Marke frei unter der Leiste haengt (SiteNav),
     ist der Freiraum nicht mehr konstant — --nav-h veroeffentlicht ihn. Ohne
     das lag die Marke auf der Rubrikzeile (.md__eyebrow). */
  .md { padding: calc(var(--nav-h, 68px) + 1.5rem) 0 4rem; }
  .md__wrap { width: min(var(--maxw), 100%); margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }

  .md__head { padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); margin-bottom: 1.6rem; }
  .md__eyebrow {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-19); font-size: var(--fs-4);
    color: var(--accent); margin-bottom: .6rem;
  }
  .md__h1 {
    /* ⚠ GEMESSEN 31.08.2026: der untere Anschlag von 1.9rem (34,2 px) greift
       auf jedem Telefon. „XENOTHREAT SURVEILLANCE" brauchte damit 312 px bei
       271 px Platz und brach mitten im Wort („SURVEILLAN / CE"). Die
       Missionstitel setzen den Teil nach dem Doppelpunkt in VERSALIEN, und
       versale Glyphen sind breiter als ihre gemeinen — die Formel muss sich
       am laengsten davon ausrichten, nicht am Durchschnitt.
       Ab 380 px Fensterbreite ist ohnehin die 5vw-Komponente die groessere;
       darueber aendert dieser Anschlag nichts. */
    font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 3.4rem); line-height: 1.04; font-weight: 900;
    letter-spacing: var(--ls-2); margin-bottom: .7rem; color: var(--text);
  }
  .md__ph {
    font-style: normal; font-size: .62em; vertical-align: .12em; padding: .1em .45em; border-radius: 7px;
    white-space: nowrap; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent);
  }
  /* Lesbarer Titel (UX-Audit F1): Platzhalter als kursives allgemeines Wort
     statt Marke — dieselbe Lesart wie die Karten der Missionsliste. */
  .md__gen { font-style: italic; color: color-mix(in srgb, var(--accent-2) 70%, var(--muted)); }
  .md__sub {
    margin: -.2rem 0 .9rem; font-family: var(--font-ui); font-size: var(--fs-9); color: var(--accent-2); line-height: 1.35;
  }
  /* Eckdaten (UX-Audit F2): eine Zeile Kacheln vor dem Auftragstext.
     Am Telefon zwei Spalten; die Belohnung nimmt dort die volle Breite,
     weil ihr Hinweis („variiert") sonst in eine 150-px-Spalte bricht. */
  .md__key {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(10.5rem, 100%), 1fr)); gap: .5rem;
    margin: .4rem 0 0; max-width: 74ch;
  }
  .md__key > div {
    padding: .55rem .7rem; border: 1px solid var(--line-soft); border-radius: 10px; background: var(--surface); min-width: 0;
  }
  .md__key dt {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-12); font-size: var(--fs-2);
    color: var(--muted); margin-bottom: .2rem;
  }
  .md__key dd { font-size: var(--fs-8); overflow-wrap: anywhere; }
  .md__keyLohn { border-color: color-mix(in srgb, var(--accent) 35%, transparent) !important; }
  .md__keyLohn .md__uec { font-size: var(--fs-11); }
  .md__var { font-family: var(--font-display); font-weight: 700; color: var(--accent-2); }
  .md__hint { display: block; margin-top: .2rem; font-size: var(--fs-5); color: var(--muted); line-height: 1.4; }
  .md__tpl { display: inline; font-family: var(--font-ui); color: var(--text); }
  @media (max-width: 640px) {
    .md__key { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md__keyLohn, .md__keyWeit { grid-column: 1 / -1; }
    /* Eine breite Region-Kachel liesse den Ruf allein in seiner Zeile;
       dense zieht die naechste schmale Kachel daneben. */
    .md__key { grid-auto-flow: row dense; }
  }
  /* ---------- mobiGlas-Panel: der In-Game-Auftragstext als Holo-Uebertragung ---------- */
  /* Eckig statt Site-Radius: SC-HUD-Sprache (Brackets vertragen keine runden
     Ecken). Amber-Glow nutzt die Seitenpalette, keine neuen Farben. */
  .md__mg {
    position: relative; max-width: 74ch; margin: 1.3rem 0 .3rem; padding: 1rem 1.3rem .9rem;
    background:
      linear-gradient(color-mix(in srgb, var(--accent) 6%, transparent), transparent 46%),
      color-mix(in srgb, var(--surface) 74%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    box-shadow: inset 0 0 36px rgba(245, 165, 36, .05), 0 0 26px rgba(245, 165, 36, .08);
  }
  /* Eck-Brackets (je Ecke zwei Striche) */
  .md__mg::before {
    content: ""; position: absolute; inset: -1px; pointer-events: none;
    background:
      linear-gradient(var(--accent), var(--accent)) left 0 top 0 / 16px 2px,
      linear-gradient(var(--accent), var(--accent)) left 0 top 0 / 2px 16px,
      linear-gradient(var(--accent), var(--accent)) right 0 top 0 / 16px 2px,
      linear-gradient(var(--accent), var(--accent)) right 0 top 0 / 2px 16px,
      linear-gradient(var(--accent), var(--accent)) left 0 bottom 0 / 16px 2px,
      linear-gradient(var(--accent), var(--accent)) left 0 bottom 0 / 2px 16px,
      linear-gradient(var(--accent), var(--accent)) right 0 bottom 0 / 16px 2px,
      linear-gradient(var(--accent), var(--accent)) right 0 bottom 0 / 2px 16px;
    background-repeat: no-repeat;
  }
  /* Scanlines — reine Deko, bewusst sehr leise */
  .md__mg::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(180deg, transparent 0 3px, rgba(245, 165, 36, .03) 3px 4px);
  }
  /* flex-wrap: gemessen 30.08.2026 bei 320 px ragte `.md__mgCode` (nowrap,
     rechtsbuendig ueber margin-left:auto) 11 px ueber den Rand und war dort
     abgeschnitten. Mit Umbruch rutscht der Code in die zweite Zeile. */
  .md__mgHead {
    display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; margin-bottom: .85rem; padding-bottom: .6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-17); font-size: var(--fs-2);
    color: var(--accent);
  }
  .md__mgDot {
    width: 7px; height: 7px; border-radius: 50%; flex: none;
    background: var(--accent); box-shadow: 0 0 9px var(--accent);
    animation: mdMgPulse 2.4s ease-in-out infinite;
  }
  @keyframes mdMgPulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .md__mgDot { animation: none; } }
  .md__mgCode { margin-left: auto; color: var(--muted); letter-spacing: var(--ls-13); white-space: nowrap; }
  .md__mgEnd {
    margin-top: .95rem; padding-top: .6rem;
    border-top: 1px dashed color-mix(in srgb, var(--accent) 26%, transparent);
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-19); font-size: var(--fs-1);
    color: color-mix(in srgb, var(--accent) 55%, var(--muted));
  }
  /* Briefings sind mehrabsaetzig; die Umbrueche stehen als \n im Text. */
  .md__desc { color: color-mix(in srgb, var(--accent-2) 12%, var(--muted)); max-width: 70ch; font-size: var(--fs-10); white-space: pre-line; }
  .md__ph--sm { font-size: .8em; vertical-align: baseline; }
  .md__warn {
    margin-top: 1rem; padding: .7rem .9rem; border-radius: 10px; font-size: var(--fs-7); color: var(--accent-2);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent); border-left-width: 3px;
  }

  /* detail.css gibt jedem <section> clamp(3rem,7vw,5.5rem) Polster oben und
     unten und bis 4rem seitlich — auf dem Missionsblatt waren das bis zu
     240 px Leere zwischen zwei Abschnitten und ein Versatz gegen den Kopf
     (UX-Audit F2, „weniger Leerraum"). Abstand regelt hier allein der Rand. */
  .md__sec { padding: 0; margin-bottom: 2.4rem; }
  .md__h2 {
    font-family: var(--font-display); font-size: var(--fs-11); font-weight: 800; letter-spacing: var(--ls-7);
    text-transform: uppercase; color: var(--accent); margin-bottom: .7rem;
  }
  .md__n { color: var(--muted); font-size: .8em; }
  .md__h3 {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-14); font-size: var(--fs-4);
    color: var(--muted); margin: 1.2rem 0 .5rem;
  }
  .md__p { color: var(--muted); max-width: 74ch; font-size: var(--fs-8); margin-bottom: .8rem; }
  .md__dim { color: var(--muted); }
  .md__note {
    padding: .8rem 1rem; border-radius: 10px; font-size: var(--fs-7); color: var(--muted); max-width: 82ch;
    background: var(--bg-2); border: 1px solid var(--line-soft); border-left: 3px solid var(--accent); margin-bottom: 1rem;
  }
  .md__note b { color: var(--accent-2); }

  .md__facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(13rem,100%), 1fr)); gap: .8rem; }
  .md__facts > div {
    padding: .7rem .8rem; border: 1px solid var(--line-soft); border-radius: 10px; background: var(--surface); min-width: 0;
  }
  .md__facts dt {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-12); font-size: var(--fs-2);
    color: var(--muted); margin-bottom: .25rem;
  }
  .md__facts dd { font-size: var(--fs-8); overflow-wrap: anywhere; }
  /* Eckdaten als Einstieg in die vorgefilterte Missionssuche */
  .md__fact {
    color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .md__fact:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .md__tech { margin-top: 1.2rem; }
  .md__tech > summary {
    cursor: pointer; width: fit-content; font-family: var(--font-ui); text-transform: uppercase;
    letter-spacing: var(--ls-14); font-size: var(--fs-4); color: var(--muted);
  }
  .md__tech > summary:hover { color: var(--accent-2); }
  .md__tech[open] > summary { margin-bottom: .6rem; }
  .md__tech .md__facts { grid-template-columns: minmax(0, 1fr); }
  .md__uec { font-family: var(--font-display); font-weight: 700; color: var(--accent-2); }

  .md__appear { display: grid; gap: .4rem; }
  .md__appear li {
    display: grid; grid-template-columns: minmax(8rem, 14rem) 1fr; gap: .8rem; align-items: baseline;
    padding: .5rem .7rem; border: 1px solid var(--line-soft); border-radius: 9px; background: var(--surface);
  }
  .md__org {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-11); font-size: var(--fs-3); color: var(--muted);
  }
  .md__at { font-size: var(--fs-9); color: var(--accent-2); }

  .md__tblWrap { overflow-x: auto; border: 1px solid var(--line-soft); border-radius: 10px; }
  .md__tbl { width: 100%; border-collapse: collapse; font-size: var(--fs-7); }
  .md__tbl th {
    font-family: var(--font-ui); text-transform: uppercase; letter-spacing: var(--ls-11); font-size: var(--fs-2); color: var(--muted);
    text-align: left; padding: .55rem .7rem; background: var(--bg-2); border-bottom: 1px solid var(--line-soft);
    white-space: nowrap; position: sticky; top: 0;
  }
  .md__tbl td { padding: .5rem .7rem; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  .md__tbl tr:last-child td { border-bottom: 0; }
  .md__tbl tbody tr:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .md__num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .md__cmp { color: var(--accent); font-weight: 700; }
  .md__places { min-width: 11rem; max-width: 22rem; font-size: var(--fs-6); }
  .md__tbl .md__badge { margin-left: 0; }
  /* 470 Zeilen: Tabelle deckeln, sonst scrollt die Seite ewig */
  .md__tbl--var { display: table; }
  .md__sec .md__tblWrap:has(.md__tbl--var) { max-height: 32rem; overflow-y: auto; }

  .md__code {
    font-family: ui-monospace, monospace; font-size: .8em; padding: .1em .35em; border-radius: 4px;
    background: var(--bg-2); color: var(--accent-2); overflow-wrap: anywhere;
  }
  .md__badge {
    display: inline-block; margin-left: .4rem; font-family: var(--font-ui); text-transform: uppercase;
