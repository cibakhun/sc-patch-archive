---
// Onepager-Link: prominenter Button, der einen eigenständigen visuellen
// Guide (statisches HTML unter /onepager/<slug>/) in einem neuen Tab öffnet.
// Themt sich über die Palette-Variablen der jeweiligen Themenseite.
//
// Darunter steht seit 24.11.2026 ein Weg zu den Downloads (UX-Audit H3): die
// Seite hatte keinen einzigen Inhaltslink, und die Onepager als Datei gibt es
// nur dort. Den Onepager selbst gibt es nur auf Deutsch (public/onepager/) —
// die EN-Seite verlinkte ihn deshalb nie und soll das auch nicht anfangen;
// sie zeigt nur den Weg zu den Downloads (Bilder und Onepager als Datei).
import { localeFromPath, href as hrefLang } from '../i18n/ui';
interface Props {
  href: string;        // z.B. "/onepager/contested-zones/index.html"
  title?: string;      // Überschrift des Guides
  note?: string;       // kurze Beschreibung
}
const de = localeFromPath(Astro.url.pathname) === 'de';
// Der Onepager-Block (section.opl-wrap) steht nur in der DE-Fassung; die
// Downloads-Zeile in beiden. verify:sync schneidet den DE-Block per
// Ausnahme X-onepager-de-only, danach muessen beide Fassungen gleich sein.
const {
  href,
  title = 'Visueller Guide',
  note = 'Eigenständiger Übersichts-Guide mit Karten, Loot und Ablauf.',
} = Astro.props;
---
{de && (
<section class="opl-wrap reveal">
  <a class="opl" href={href} target="_blank" rel="noopener">
    <span class="opl__ic" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13 3v5h5M8.5 13h7M8.5 16.5h7M8.5 9.5h2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </span>
    <span class="opl__txt">
      <span class="opl__kx">Onepager</span>
      <span class="opl__title">{title}</span>
      <span class="opl__note">{note}</span>
    </span>
    <span class="opl__arrow" aria-hidden="true">↗</span>
  </a>
</section>
)}
<div class="opl-dl">
  <p class="opl-more">
    <a href={hrefLang('/downloads.html', de ? 'de' : 'en')}>{de ? 'Onepager als Datei und weitere Bilder: Downloads' : 'One-pager guides (German) and images: Downloads'} →</a>
  </p>
</div>

<style>
  .opl-wrap {
    max-width: var(--maxw, 1180px);
    margin-inline: auto;
    padding: 1rem clamp(1.25rem, 5vw, 4rem) 2rem;
  }
  .opl {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.4rem;border:1px solid var(--line, var(--line-soft));background:color-mix(in srgb, var(--accent, #2dd4ff) 6%, var(--surface, var(--veil)));
    box-shadow: var(--glow, none);
    transition: transform var(--dur-base) var(--ease-ui), border-color var(--dur-base) var(--ease-ui), background-color var(--dur-base) var(--ease-ui);
  }
  .opl:hover {
    transform: translateY(-2px);
    border-color: var(--accent, #2dd4ff);background:color-mix(in srgb, var(--accent, #2dd4ff) 12%, var(--surface, var(--veil)));
  }
  .opl__ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    color: var(--accent, #2dd4ff);border:1px solid var(--line, var(--line-soft));background:var(--veil);
  }
  .opl__txt {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .opl__kx {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-4);
    letter-spacing: var(--ls-19);
    text-transform: uppercase;
    color: var(--accent-2, var(--accent, #2dd4ff));
  }
  .opl__title {
    font-family: var(--font-display, sans-serif);
    font-weight: 700;
    font-size: var(--fs-12);
    color: var(--text, #f3e9df);
  }
  .opl__note {
    font-size: var(--fs-8);
    color: var(--muted, #b6a596);
  }
  .opl__arrow {
    margin-left: auto;
    flex: none;
    font-size: var(--fs-14);
    color: var(--accent, #2dd4ff);
    transition: transform var(--dur-base) var(--ease-ui);
  }
  .opl:hover .opl__arrow {
    transform: translate(3px, -3px);
  }
  @media (max-width: 560px) {
    .opl__note {
      display: none;
    }
  }
  .opl-dl {
    max-width: var(--maxw, 1180px);
    margin-inline: auto;
    padding: 0 clamp(1.25rem, 5vw, 4rem) 2rem;
  }
  .opl-wrap + .opl-dl {
    margin-top: -1.2rem;
  }
  .opl-more {
    margin: 0;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-7);
    letter-spacing: var(--ls-8);
  }
  .opl-more a {
    color: var(--accent, #2dd4ff);
    border-bottom: 1px solid color-mix(in srgb, var(--accent, #2dd4ff) 40%, transparent);
    padding-bottom: 0.1rem;
    text-decoration: none;
  }
  .opl-more a:hover,
  .opl-more a:focus-visible {
    color: var(--text, #f3e9df);
    border-bottom-color: currentColor;
  }
</style>
