---
// Blueprint-Seite — die indexierbare Fassung der Karten-Detailansicht aus dem
// Crafting-Planer: Zutaten-Slots, Qualitaets-Effekte, Item-Werte und die
// Missionen, die den Blueprint droppen. Verlinkt in beide Richtungen: zum
// Item-Datenblatt, zu den Missions-Seiten und zurueck in den Planer.
import DataShell from './DataShell.astro';
import { standCrafting } from '../lib/datenstand';
import { href, type Locale } from '../i18n/ui';
import { itemT } from '../i18n/itemText';
import { pfadname, wertname } from '../i18n/craftingWerte';
import {
  type BlueprintEntry, blueprintPath, craftCategoryPath, craftDb, craftLeaf,
  craftPatch, craftTime, itemForBlueprint, plannerPath, relatedBlueprints,
  resourceNames, slugify, totalScu,
} from '../lib/crafting';
import { displayName, itemPath, num, pageItemIds } from '../lib/items';
import { mineralFor, miningLink } from '../lib/miningLinks';
import { formatResist } from '../lib/itemStats';
import { bauplanZusatz, bauplanZwillinge, blueprintSeo } from '../lib/itemSeo';
import { patchesMentioning } from '../lib/patchMentions';
import Item3d from './Item3d.astro';
import { item3dFor } from '../lib/item3d';
import { HAS_HANGAR } from '../lib/seo';
import { bwT } from '../i18n/bezugswegeText';
import { fill } from '../i18n/itemText';
import { auec } from '../lib/items';
import { bezugswege, materialWege, missionsZeilen } from '../lib/bezugswege';
import { wikeloBlueprintTrades } from '../lib/itemLinks';

interface Props { bp: BlueprintEntry; lang: Locale }
const { bp, lang } = Astro.props;
const mentions = patchesMentioning(`/crafting/${bp.slug}.html`);

const t = itemT(lang);
const seo = blueprintSeo(bp, lang, craftPatch, craftDb.snapshot_date);
// D7: gleichnamige Bauplaene unterscheiden und gegenseitig verlinken.
const zusatz = bauplanZusatz(bp, lang);
const zwillinge = bauplanZwillinge(bp, lang);
const item = itemForBlueprint(bp);
const linkedItem = item && pageItemIds.has(item.id) ? item : null;
// Drehbares Modell des Ergebnisses (nur Vorschau-Bau, src/lib/item3d.ts).
const model3d = item3dFor(linkedItem?.id);
const related = relatedBlueprints(bp, 12);
const stats = bp.item_stats ?? {};
const missions = bp.missions ?? [];
const scu = totalScu(bp);

const crumbs = [
  { label: t('breadcrumbCrafting'), href: '/crafting.html' },
  { label: craftLeaf(bp.category), href: craftCategoryPath(slugify(bp.category)) },
  { label: bp.name },
];

/** Qualitaets-Effekt als "× 0,9 → × 1,1" bzw. "+ 0 → + 12". */
const effect = (v: number, mult: boolean) =>
  mult ? `× ${num(v, lang)}` : `+ ${num(v, lang)}`;

// temperature_resistance und damage_resistance sind OBJEKTE, keine Zahlen:
// {min,max} bzw. Schadens-Multiplikatoren je Kanal (+ Ruestungsprofil).
// Angezeigt wird die Reduktion (1 − Multiplikator), wie im Item-Datenblatt und
// im Spiel-UI — 0,6 als "60 %" zu lesen waere genau verkehrt herum.
// Mining-Modifikatoren in fester Reihenfolge, nur die gesetzten. Die
// Reihenfolge ist die des Spiels (Ladefenster vor Widerstand vor Splitterung),
// nicht die des JSON — sonst wechselt sie mit jedem Datenlauf.
const MIN_ORDER = ['optimal_charge_window_size', 'optimal_charge_window_rate', 'catastrophic_charge_window_rate',
  'instability', 'resistance', 'shatter_damage', 'cluster_factor', 'filter'] as const;
// Typ-Waechter mit dem Schluessel als Literal: so prueft tsc, dass jedes Glied
// von MIN_ORDER sein Label `bpMin_<k>` im Katalog hat.
const minMods = MIN_ORDER
  .map((k) => [k, stats.mining_modifiers?.[k]] as const)
  .filter((p): p is readonly [(typeof MIN_ORDER)[number], { value: number; mode: string }] => !!p[1]);

const tempRes = stats.temperature_resistance;
const dmgRes = stats.damage_resistance;
// formatResist ist dieselbe Funktion, die das Item-Datenblatt benutzt — gleiche
// Rechnung, gleiche Kanal-Labels in beiden Sprachen.
const resistRow = dmgRes ? formatResist(dmgRes, lang) : null;

// Ohne Missionsquelle (UX-Audit Paket D2, 940 von 1.634 Bauplaenen): ehrlich
// „Quelle unbekannt" statt der Vermutung „evtl. über Shop oder Reputation",
// dazu was man stattdessen tun kann. Wikelo-Tausch ist ein bekannter Weg.
const bt = bwT(lang);
const wikeloBp = wikeloBlueprintTrades(bp.name);
const wikeloBpHref = `${href('/topics/wikelo-emporium.html', lang)}?item=${encodeURIComponent(`${bp.name} Blueprint`)}`;
const itemWege = (() => {
  if (missions.length > 0 || !linkedItem) return [];
  const w = bezugswege(linkedItem);
  const out: string[] = [];
  if (w.kaufen) out.push(fill(bt('bpNextItemBuy'), { p: auec(w.kaufen.ab, lang) }));
  if (w.finden && (w.finden.bestaetigt.length || w.finden.recherche.length)) out.push(bt('bpNextItemFind'));
  if (w.abWerk.length) out.push(bt('bpNextItemStock'));
  if (w.wikelo > 0) out.push(bt('bpNextItemWikelo'));
  return out;
})();
// D4: Pool statt „100 %" — die Chance gilt dem Pool, nicht diesem Bauplan.
const zeilen = missionsZeilen(bp);
const prozent = (c: number) => (lang === 'de' ? `${Math.round(c * 100)} %` : `${Math.round(c * 100)}%`);
// Steht nicht fest, aus welchem von mehreren Pools der Bauplan kommt, steht
// die Spanne da („1 von 5–8“, poolSpanne in src/lib/bezugswege.ts).
const spanne = (z: { pool: number; poolMin: number }) => (z.poolMin < z.pool ? `${num(z.poolMin, lang)}–${num(z.pool, lang)}` : num(z.pool, lang));
const poolText = (z: { chance: number; pool: number; poolMin: number }) => {
  const n = spanne(z);
  if (z.chance < 1) return fill(bt(z.pool > 1 ? 'bpPoolCellChance' : 'bpPoolOnlyChance'), { p: prozent(z.chance), n });
  return z.pool > 1 ? fill(bt('bpPoolCell'), { n }) : bt('bpPoolOnly');
};
// Beispiel unter der Tabelle: der erste feste Pool mit mehr als einem Bauplan;
// steht eine Spanne in der Tabelle, erklaert ein zweiter Satz sie.
const beispielPool = zeilen.find((z) => z.pool > 1 && z.poolMin === z.pool)?.pool ?? 1;
const beispielSpanne = zeilen.find((z) => z.poolMin < z.pool);
const nurSpannen = zeilen.length > 0 && zeilen.every((z) => z.poolMin < z.pool);
// D8: jedes Material einmal, mit seinen Wegen (abbauen, kaufen, zerlegen).
const materialien = [...new Set(bp.ingredients.flatMap((ing) => (ing.options ?? []).map((o) => o.name)))]
  .map((name) => ({ name, wege: materialWege(name, item?.id) }));
const meldenHref = `${href('/feedback.html', lang)}?wert=${encodeURIComponent(Astro.url.pathname).replace(/%2F/g, '/')}`;
---
<DataShell
  lang={lang}
  title={seo.title}
  description={seo.description}
  crumbs={crumbs}
  eyebrow={`${pfadname(bp.category, lang)} · ${t('bpEyebrow')}`}
  tone="craft"
  ogImage="/assets/t-craft-1.jpg"
  modified={craftDb.snapshot_date}
  ldName={bp.name}
  stand={standCrafting(lang)}
  melden
>
  <h1 slot="hero">{bp.name}</h1>
  <p class="dp-lead" slot="hero">{seo.lead}</p>
  {zwillinge.length > 0 && (
    <p class="dp-note dp-zwilling" slot="hero" data-zwilling={zusatz}>
      {zusatz && <>{bwT(lang)('twinThis')}{' '}<b>{zusatz}</b>.{' '}</>}
      {bwT(lang)(zwillinge.length === 1 ? 'twinBp' : 'twinBps')}{' '}
      {zwillinge.map((z, i) => (
        <>{i > 0 && ', '}<a href={href(blueprintPath(z.bp), lang)}>{z.bp.name}{z.zusatz && ` (${z.zusatz})`}</a></>
      ))}
    </p>
  )}

  {/* Suchtreffer landen hier und wollen meist ins Werkzeug. Der Planer-Knopf
      stand nur am Seitenende; ?bp= oeffnet den Planer mit diesem Blueprint.
      Vor den Kennzahlen, weil er dahinter bei 320x640 unter die Falz rutschte. */}
  {/* data-bp-item: welches Item dieser Blueprint herstellt — verify:item3d
      leitet daraus ab, welches Modell hier stehen muss (oder keins). Nur im
      Vorschau-Bau, wo es die 3D-Ansicht gibt. */}
  <div class="dp-cta" slot="hero" data-bp-item={HAS_HANGAR ? linkedItem?.id : undefined}>
    <a class="dp-btn" href={href(plannerPath(bp), lang)}>{t('bpOpenPlanner')} →</a>
    <span class="dp-note">{t('bpPlannerHint')}</span>
    {/* Wie sieht das Ergebnis aus? Hinter dem Hinweis, der zum Planer gehoert. */}
    <Item3d model={model3d} name={linkedItem ? displayName(linkedItem, lang) : bp.name} lang={lang} />
  </div>

  <ul class="dp-keys" slot="hero">
    <li class="dp-key"><b>{t('craftTime')}</b><span>{craftTime(bp.craft_time_seconds, lang)}</span></li>
    <li class="dp-key"><b>{t('bpIngredients')}</b><span>{bp.ingredients.length}</span></li>
    {scu > 0 && <li class="dp-key"><b>{t('bpTotalScu')}</b><span>{num(scu, lang)} SCU</span></li>}
    {bp.tiers > 0 && <li class="dp-key"><b>{t('craftTiers')}</b><span>{bp.tiers}</span></li>}
    {missions.length > 0 && <li class="dp-key"><b>{t('bpMissions')}</b><span>{missions.length}</span></li>}
  </ul>

  {/* -- Zutaten je Slot -- */}
  <section class="dp-sec">
    <h2>{t('bpIngredients')}</h2>
    <div class="dp-tablewrap">
      <table class="dp-table">
        <thead>
          <tr>
            <th>{t('bpSlot')}</th>
            <th>{t('bpMaterial')}</th>
            <th class="dp-num">{t('bpAmount')}</th>
            <th class="dp-num">{t('bpMinQuality')}</th>
          </tr>
        </thead>
        <tbody>
          {bp.ingredients.flatMap((ing) =>
            (ing.options ?? []).map((o, oi) => (
              <tr>
                <td>{oi === 0 ? ing.slot : ''}</td>
                {/* Material -> Mineral-Datenblatt: die Frage nach dem Rezept ist
                    immer „und wo bekomme ich das her?". Ohne Mineral in der
                    Mining-DB (Yormandi Eye) bleibt der Name schlichter Text. */}
                <td>
                  {miningLink(o.name, lang)
                    ? <a href={miningLink(o.name, lang)} title={t('bpWhereToMine').replace('{name}', mineralFor(o.name)!)}>{o.name}</a>
                    : o.name}
                </td>
                <td class="dp-num">{num(o.quantity_scu, lang)} SCU</td>
                <td class="dp-num">{num(o.min_quality, lang)}</td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
    {bp.ingredients.some((ing) => (ing.options ?? []).some((o) => mineralFor(o.name))) && (
      <p class="dp-note">{t('bpMaterialsNote')}</p>
    )}

    {/* D8: je Material alle Wege — abbauen, kaufen, zerlegen. */}
    {materialien.length > 0 && (
      <>
        <h3 id="materialwege">{bt('matTitle')}</h3>
        <ul class="bp-mat">
          {materialien.map(({ name, wege }) => (
            <li data-material={name}>
              <b>{name}</b>
              <span class="bp-mat-wege">
                {miningLink(name, lang)
                  ? <a href={miningLink(name, lang)} data-mat-weg="abbauen">{bt('matMine')}</a>
                  : <span class="dp-muted" data-mat-ohne="abbauen">{bt('matMineNone')}</span>}
                {wege.kaufen === true && <span data-mat-weg="kaufen">{bt('matBuy')}</span>}
                {wege.kaufen === false && <span class="dp-muted" data-mat-ohne="kaufen">{bt('matBuyNone')}</span>}
                {wege.kaufen === null && <span class="dp-muted" data-mat-ohne="kaufen">{bt('matBuyUnknown')}</span>}
                {wege.zerlegen === 'gesperrt'
                  ? <span class="dp-muted" data-mat-ohne="zerlegen">{bt('matSalvageNone')}</span>
                  : wege.zerlegen && (
                    <span data-mat-weg="zerlegen">{bt('matSalvage')}{' '}<a href={href(itemPath(wege.zerlegen.item), lang)}>{displayName(wege.zerlegen.item, lang)}</a>{wege.zerlegen.anzahl > 1 && <>{' '}{fill(bt('matSalvageMore'), { n: num(wege.zerlegen.anzahl - 1, lang) })}</>}</span>
                  )}
              </span>
            </li>
          ))}
        </ul>
      </>
    )}

    {bp.ingredients.some((i) => i.quality_effects?.length) && (
      <>
        <h3>{t('bpQualityEffects')}</h3>
        <div class="dp-tablewrap">
          <table class="dp-table">
            <thead>
              <tr>
                <th>{t('bpSlot')}</th>
                <th>{t('bpStat')}</th>
                <th class="dp-num">{t('bpAtMin')}</th>
                <th class="dp-num">{t('bpAtMax')}</th>
              </tr>
            </thead>
            <tbody>
              {bp.ingredients.flatMap((ing) =>
                (ing.quality_effects ?? []).map((q, qi) => (
                  <tr>
                    <td>{qi === 0 ? ing.slot : ''}</td>
                    <td>{wertname(q.stat, lang)}</td>
                    <td class="dp-num">{effect(q.modifier_at_min, q.multiplicative)}</td>
                    <td class="dp-num">{effect(q.modifier_at_max, q.multiplicative)}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
        <p class="dp-note">{t('bpQualityNote')}</p>
      </>
    )}
  </section>

  {/* -- Werte des fertigen Items -- */}
  {(stats.mass_kg || stats.overheat_temperature || tempRes || resistRow ||
    stats.fire_modes?.length || stats.max_ammo || stats.cargo_capacity_scu != null ||
    minMods.length > 0) && (
    <section class="dp-sec">
      <h2>{t('bpItemStats')}</h2>
      <ul class="dp-stats">
        {/* Erz-Pod: Fassungsvermoegen und Haltbarkeit stehen VORNE — sie sind
            der Grund, warum man einen Pod dem anderen vorzieht. */}
        {stats.cargo_capacity_scu != null && <li class="dp-stat"><b>{t('bpCargo')}</b><span>{num(stats.cargo_capacity_scu, lang)} SCU</span></li>}
        {stats.health != null && <li class="dp-stat"><b>{t('bpHealth')}</b><span>{num(stats.health, lang)}</span></li>}
        {/* Mining-Modul: jeder gesetzte Modifikator als eigene Zeile, mit
            Vorzeichen und Einheit. `additiv` und `multiplikativ` stehen im
            Spiel nebeneinander — ohne die Unterscheidung waere "+20" gegen
            "-15,5 %" nicht lesbar. */}
        {minMods.map(([k, m]) => (
          <li class="dp-stat"><b>{t(`bpMin_${k}`)}</b><span>{m.value > 0 ? '+' : ''}{num(m.value, lang)}{m.mode === 'multiplikativ' ? ' %' : ''}</span></li>
        ))}
        {stats.mass_kg != null && <li class="dp-stat"><b>{t('bpMass')}</b><span>{num(stats.mass_kg, lang)} kg</span></li>}
        {stats.overheat_temperature != null && <li class="dp-stat"><b>{t('bpOverheat')}</b><span>{num(stats.overheat_temperature, lang)} °C</span></li>}
        {tempRes && <li class="dp-stat"><b>{t('bpTempRes')}</b><span>{tempRes.min} / {tempRes.max} °C</span></li>}
        {resistRow && <li class="dp-stat"><b>{t('bpDmgRes')}</b><span>{resistRow}</span></li>}
        {dmgRes?.profile && <li class="dp-stat"><b>{t('bpArmorClass')}</b><span>{dmgRes.profile}</span></li>}
        {stats.max_ammo != null && <li class="dp-stat"><b>{t('bpMaxAmmo')}</b><span>{num(stats.max_ammo, lang)}</span></li>}
        {stats.max_restock != null && <li class="dp-stat"><b>{t('bpMaxRestock')}</b><span>{num(stats.max_restock, lang)}</span></li>}
        {stats.fire_modes && stats.fire_modes.length > 0 && (
          <li class="dp-stat"><b>{t('bpFireModes')}</b><span>{stats.fire_modes.map((f) => f.name).join(', ')}</span></li>
        )}
      </ul>
    </section>
  )}

  {/* -- Missions-Quellen: verlinkt auf die vorhandenen Missions-Datenblaetter -- */}
  <section class="dp-sec" id="missionen">
    <h2>{missions.length > 0 ? t('bpMissions') : bt('bpSourceTitle')}</h2>
    {missions.length > 0 ? (
      <>
        <div class="dp-tablewrap">
          <table class="dp-table">
            <thead>
              <tr>
                <th>{bt('bpPoolMission')}</th>
                <th class="dp-num">{bt('bpPoolHead')}</th>
              </tr>
            </thead>
            <tbody>
              {zeilen.map((z) => (
                <tr data-mission={z.slug}>
                  <td>
                    {z.seite
                      ? <a href={href(`/missionen/${z.slug}.html`, lang)}>{z.label}</a>
                      : z.label}
                  </td>
                  <td class="dp-num" data-pool={z.pool} data-pool-min={z.poolMin < z.pool ? z.poolMin : undefined}>{poolText(z)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {/* Das Beispiel ist ein Pool dieser Tabelle, keine feste Zahl. */}
        {!nurSpannen && <p class="dp-note">{beispielPool > 1 ? fill(bt('bpPoolNote'), { n: num(beispielPool, lang) }) : bt('bpPoolNoteOne')}</p>}
        {beispielSpanne && <p class="dp-note" data-pool-spanne>{fill(bt('bpPoolRange'), { min: num(beispielSpanne.poolMin, lang), max: num(beispielSpanne.pool, lang) })}</p>}
        {wikeloBp > 0 && <div class="dp-actions bp-wikelo"><a class="dp-btn" href={wikeloBpHref}>{bt('bpSourceWikelo')} →</a></div>}
      </>
    ) : (
      <>
        {wikeloBp > 0 ? (
          <>
            <p class="dp-callout" data-quelle="wikelo">{fill(bt('bpSourceWikeloText'), { patch: craftPatch })}</p>
            <div class="dp-actions bp-wikelo"><a class="dp-btn" href={wikeloBpHref}>{bt('bpSourceWikelo')} →</a></div>
          </>
        ) : (
          <p class="dp-callout" data-quelle="unbekannt"><b>{bt('bpSourceUnknown')}</b> {fill(bt('bpSourceUnknownText'), { patch: craftPatch })}</p>
        )}
        <h3>{bt('bpNextTitle')}</h3>
        <ul class="dp-next">
          {itemWege.length > 0 && linkedItem && (
            <li>{fill(bt('bpNextItem'), { wege: itemWege.join(', ') })} <a href={`${href(itemPath(linkedItem), lang)}#so-bekommst-du-es`}>{bt('bpNextItemOpen')} →</a></li>
          )}
          <li>{bt('bpNextReport')} <a href={meldenHref} rel="nofollow" data-hinweis>{bt('report')} →</a></li>
        </ul>
      </>
    )}
  </section>

  {related.length > 0 && (
    <section class="dp-sec">
      <h2>{t('bpRelated')}</h2>
      <ul class="dp-cards">
        {related.map((r) => (
          <li>
            <a class="dp-card" href={href(blueprintPath(r), lang)}>
              <strong>{r.name}</strong>
              <em>{resourceNames(r).slice(0, 3).join(', ')}</em>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="dp-actions">
    {linkedItem && <a class="dp-btn" href={href(itemPath(linkedItem), lang)}>{t('bpOpenItem')} →</a>}
    {/* Der Planer-Knopf steht einmal, im Kopf (UX-Audit D10). */}
    <a class="dp-btn dp-btn--ghost" href={href(craftCategoryPath(slugify(bp.category)), lang)}>{craftLeaf(bp.category)}</a>
    {mentions.map((p) => (p.page ? <a class="dp-btn dp-btn--ghost" href={href(p.page, lang)}>Alpha {p.version} · {p.codename}</a> : <span class="dp-btn dp-btn--ghost">Alpha {p.version} · {p.codename}</span>))}
  </div>
</DataShell>

<style>
  /* „Was du stattdessen tun kannst" (Paket D2): schlichte Liste im Ton der
     Huelle, je Zeile ein naechster Schritt mit Link. */
  .dp-next {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 72ch;
  }
  .dp-next li {
    position: relative;
    padding: 0.35rem 0 0.35rem 1.1rem;
    line-height: 1.5;
    color: var(--text);
  }
  .dp-next li::before {
    content: '›';
    position: absolute;
    left: 0.2rem;
    color: var(--tone-1);
  }
  .dp-next a { white-space: nowrap; }
  .bp-wikelo { margin-top: 0.8rem; }
  .dp-zwilling { margin: 0.2rem 0 0.9rem; }
  .bp-mat { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; gap: 0.45rem; }
  .bp-mat li { display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; align-items: baseline; padding: 0.45rem 0.7rem; border: 1px solid var(--line-soft); background: var(--dp-fill); }
  .bp-mat b { min-width: 9rem; }
  .bp-mat-wege { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; }
  .bp-mat-wege > * + *::before { content: '·'; margin-right: 0.6rem; color: var(--muted); }
  /* Schmal bricht die Zeile ohnehin: dann je Weg eine Zeile statt eines
     Trennpunkts am Zeilenanfang. */
  @media (max-width: 600px) {
    .bp-mat-wege { flex-direction: column; gap: 0.15rem; }
    .bp-mat-wege > * + *::before { content: none; }
  }
</style>
