---
// Provenance-driven, license-clean footer. One source of truth for the
// "unofficial fansite" + CC-BY-SA + sources notices the blueprint requires.
// Styled with the page's own CSS variables (--muted/--line/--accent/--bg-2)
// so it adapts to each patch palette automatically.
import { localeFromPath, useTranslations, href } from '../i18n/ui';
import { DISCORD } from '../consts';
interface Props {
  /** data freshness stamp, e.g. "28. Juni 2026" (shown when data is baked in) */
  updated?: string;
  /** attribution sources for this page */
  sources?: string[];
  credit?: string;
}
const { updated, sources = ['starcitizen.tools', 'RSI', 'YouTube'], credit } = Astro.props;

const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const L = (p: string) => href(p, lang);
const creditText = credit ?? t('footer.credit');
---
<footer class="site-attr">
  <nav class="attr-nav" aria-label={t('footer.pageNav')}>
    <a href={L('/index.html')}>{t('nav.home')}</a>
    <span aria-hidden="true">·</span>
    <a href={L('/archiv.html')}>{t('nav.allPatches')}</a>
    <span aria-hidden="true">·</span>
    <a href={L('/impressum.html')}>{t('footer.imprint')}</a>
    <span aria-hidden="true">·</span>
    <a href={L('/datenschutz.html')}>{t('footer.privacy')}</a>
    <span aria-hidden="true">·</span>
    <a href={L('/feedback.html')}>{t('footer.feedback')}</a>
    <span aria-hidden="true">·</span>
    {/* Der einzige auswärtige Eintrag dieser Zeile — er trägt deshalb das
        Discord-Glyph, damit man vor dem Klick sieht, dass er die Seite
        verlässt. */}
    <a class="ext" href={DISCORD.invite} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 127.14 96.36" width="14" height="11" aria-hidden="true" focusable="false"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21H.55A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
      {t('footer.discord')}
    </a>
    <span aria-hidden="true">·</span>
    <a href={L('/support.html')}>{t('footer.support')}</a>
  </nav>
  <div class="credit">{creditText}</div>
  {sources.length > 0 && <div class="srcs">{t('footer.sources')}: {sources.join(' · ')}</div>}
  <p class="disclaimer">{t('footer.disclaimer')}</p>
  {updated && <div class="asof">{t('footer.dataAsOf')}: {updated}</div>}
</footer>
<style>
  .site-attr {border-top:1px solid var(--line, var(--line-soft));
    padding: 3rem clamp(1.25rem, 5vw, 3rem);
    text-align: center;
    background: var(--bg-2, transparent);
  }
  .site-attr .attr-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.7rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-7);
    letter-spacing: var(--ls-12);
    text-transform: uppercase;
  }
  .site-attr .attr-nav a {
    color: var(--muted, #8a99b8);
  }
  .site-attr .attr-nav a:hover,
  .site-attr .attr-nav a:active {
    color: var(--accent, #2dd4ff);
  }
  /* Glyph und Wort sitzen auf einer Grundlinie und färben gemeinsam um —
     das Zeichen ist Teil des Links, nicht ein Bild daneben. */
  .site-attr .attr-nav a.ext {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .site-attr .attr-nav a.ext svg {
    fill: currentColor;
    flex: none;
  }
  /* Diese Zeile steht im Fuss JEDER Seite. Bei 375 px waren die Links
     24–26 px hoch und standen als umbrechende Reihe dicht beieinander —
     man traf staendig den Nachbarn. Die Trefferhoehe waechst auf 44 px,
     die Schrift bleibt; der Zeilenabstand wird entsprechend kleiner
     gesetzt, damit der Fuss nicht insgesamt aufgeht. */
  @media (max-width: 820px) {
    .site-attr .attr-nav {
      gap: 0 0.9rem;
    }
    .site-attr .attr-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    .site-attr .attr-nav span {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  .site-attr .attr-nav span {
    color: var(--muted, #8a99b8);
    opacity: 0.5;
  }
  /* Keine Versalien mehr: „VerseBase · a Star Citizen fan project" sind 38
     Zeichen Fliesstext, und Versalien nehmen Woertern die Ober- und
     Unterlaengen, an denen wir sie erkennen. Versalien bleiben den kurzen
     Marken vorbehalten, nicht ganzen Zeilen. */
  .site-attr .credit {
    font-family: var(--font-ui, sans-serif);
    letter-spacing: var(--ls-5);
    font-size: var(--fs-7);
    color: var(--muted, #8a99b8);
    margin-bottom: 1rem;
  }
  /* Kein opacity auf --muted: der Token ist bereits auf Lesbarkeit gegen
     --bg-2 abgestimmt, ein zusätzlicher Faktor darauf drückte diese beiden
     Zeilen auf 2,8:1 bzw. 2,6:1 — unter WCAG AA. Wer sie schwächer will,
     ändert --muted, nicht die Deckkraft an der Verwendungsstelle. */
  .site-attr .srcs {
    font-size: var(--fs-7);
    color: var(--muted, #8a99b8);
    margin-bottom: 0.8rem;
  }
  .site-attr .disclaimer {
    max-width: 70ch;
    margin: 0 auto;
    font-size: var(--fs-7);
    color: var(--muted, #8a99b8);
  }
  .site-attr .asof {
    margin-top: 0.8rem;
    font-size: var(--fs-6);
    color: var(--accent, #2dd4ff);
    letter-spacing: var(--ls-10);
    text-transform: uppercase;
  }</style>
