  padding:6px 10px;border-radius:7px;background:color-mix(in srgb,var(--ink) 22%,transparent)}
.fc__mrow .p{font-size:var(--fs-5);color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
