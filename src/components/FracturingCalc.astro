---
// FracturingCalc.astro — der Fracturing-Rechner als eigenes Werkzeug.
//
// Am 12.08.2026 aus MiningWorkbench.astro herausgeloest. Der Rechner sass
// dort in der Bedienleiste unter einer Werkbank, die eine ganz andere Frage
// beantwortet: Mining sagt „welches Erz, wo, was ist es wert?", dieser
// Rechner sagt „krieg ich diesen Brocken mit MEINER Ausruestung auf?". Auf
// der Mining-Seite gibt es seither weder Laser noch Module noch ein Urteil
// zur Brechbarkeit — das war ausdruecklich so entschieden, nicht vergessen.
//
// Aufbau: links die 37 Erze mit Punkt UND Verhaeltniszahl (das ist hier die
// eigentliche Antwort, nicht nur ein Wegweiser), Mitte das Messgeraet mit
// ausgeschriebenem Rechenweg, rechts die Ausruestung.
//
// FALLEN, die hier bewusst umgangen sind (alle in der Werkbank bezahlt):
//  · Astro 5.18 verschluckt das schliessende Tag, wenn ein Element auf
//    OBERSTER Template-Ebene einen {ausdruck} als Kind hat -> set:text.
//  · `:global()` ist in `<style is:inline>` kein CSS und wird still verworfen.
//  · KEINE eigenen Farbtoken: build-light-palettes.mjs kennt nur eine feste
//    Namensliste und ignoriert alles andere still. Zustandsfarben ueber
//    `color` + `currentColor`, weil build-light-overrides.mjs zwar `color`
//    abdeckt, aber NICHT `background`.
//  · Jeder innen scrollende Kasten muss in die Selektorliste in
//    assets/mobile-ux.css, sonst blendet theme.css seine Leiste aus.
//    `.fc__scroll` steht dort.
import MODEL from '../../assets/mining-model.json';
import DB from '../../assets/mining-db.json';
import ToolHelp from './ToolHelp.astro';
import { versioned } from '../lib/assetVersion';
import { href } from '../i18n/ui';
import { useHelp, type HelpKey } from '../i18n/help';

/* Titel ins Gehaeuse (15.08.2026), wie bei der Mining-Werkbank: das Kopfband
   der Grafik traegt ihn, der separate `.hero` der Seite faellt dafuer weg. */
interface Props {
  lang: 'de' | 'en';
  title: string;
  eyebrow: string;
  lead: string;
}
const { lang, title, eyebrow, lead } = Astro.props;

/* Dieselbe Gehaeuse-Grafik wie die Mining-Werkbank — die beiden Seiten sind
   ein Paar, und zwei verschiedene Rahmen waeren ein Bruch. Ueber versioned(),
   damit der sha1 am Inhalt haengt statt an einer hochgezaehlten `?v=`-Zahl. */
const chassis1x = versioned('assets/chassis-1600.webp', '/assets/chassis-1600.webp');
const chassis2x = versioned('assets/chassis-2400.webp', '/assets/chassis-2400.webp');
const de = lang === 'de';
const h = useHelp(lang);
const hlp = (k: string) => h(`fracturing.ctl.${k}` as HelpKey);

const elemByName: Record<string, any> = {};
for (const e of (MODEL.elements as any[])) elemByName[e.name] = e;

const RAR_ORDER = ['legendary', 'epic', 'rare', 'uncommon', 'common'];
const rarIdx = (r: string | null) => {
  const i = RAR_ORDER.indexOf(r || '');
  return i < 0 ? RAR_ORDER.length : i;
};

/* Nur, was zum Brechen gehoert. Fundorte, Ertragsprofile, Steine und
   Blueprints bleiben in der Mining-Werkbank — sie hier zu doppeln waere
   genau die Vermischung, die dieser Umzug aufloest. */
const minerals = (DB.minerals as any[])
  .map((m) => {
    const e = elemByName[m.name] || {};
    return {
      name: m.name, kind: m.kind, rarity: m.rarity || null,
      systems: m.systems || [],
      res: typeof e.resistance === 'number' ? e.resistance : null,
      inst: typeof e.instability === 'number' ? e.instability : null,
      win: typeof e.optimalWindowThinness === 'number' ? e.optimalWindowThinness : null,
    };
  })
  .sort((a, b) => rarIdx(a.rarity) - rarIdx(b.rarity) || a.name.localeCompare(b.name));

/* ⚠ Das Feld heisst `moduleSlots`. Ein `l.slots || 0` auf dem geratenen
   Namen lieferte in der Werkbank fuer ALLE 14 Laser null Modulplaetze —
   drei Knoepfe dauerhaft gesperrt, 26 Module unerreichbar, die Rechnung
   ignorierte Module vollstaendig. Nicht wieder umbenennen. */
const lasers = (MODEL.lasers as any[])
  .filter((l) => !l.builtIn && l.mining && l.mining.dps)
  .map((l) => ({ n: l.name, size: l.size, slots: l.moduleSlots || 0, dps: Math.round(l.mining.dps), mods: l.mods || {} }))
  .sort((a, b) => b.dps - a.dps);
const modules = (MODEL.modules as any[])
  .map((m) => ({ n: m.name, type: m.type, mult: m.miningMult || 1, mods: m.mods || {} }))
  .sort((a, b) => a.n.localeCompare(b.n));
const gadgets = (MODEL.gadgets as any[]).map((g) => ({ n: g.name, mods: g.mods || {} }));

const P: any = (MODEL.params as any).ship || {};
const MASS_PRESETS = [
  { m: 2000, de: 'klein', en: 'small' }, { m: 8000, de: 'mittel', en: 'medium' },
  { m: 22000, de: 'gross', en: 'large' }, { m: 45000, de: 'riesig', en: 'huge' },
];
const DEFAULT_MASS = 8000;

/* Serverseitiges Urteil fuer den ersten Anblick — mit dem staerksten Laser
   ohne Module, also genau dem Zustand, den das Skript gleich uebernimmt,
   falls nichts gespeichert ist. */
function verdict(res: number | null, dps: number, resMod: number, mass: number) {
  if (res === null) return { cls: 'na', ratio: null as number | null };
  const Reff = Math.max(0, res) * (1 + resMod / 100);
  const effDps = dps * Math.max(0.05, 1 - Reff);
  const decay = (P.decayPerMass || 0.2) * mass;
  const ratio = decay > 0 ? effDps / decay : 99;
  return { cls: ratio <= 1 ? 'bad' : ratio < 1.3 ? 'warn' : 'ok', ratio };
}
const L0 = lasers[0];
const ssr = (m: any) => verdict(m.res, L0.dps, L0.mods.resistance || 0, DEFAULT_MASS);
const num = (v: number) => (de ? v.toFixed(2).replace('.', ',') : v.toFixed(2));

const RAR_LBL: Record<string, { de: string; en: string }> = {
  legendary: { de: 'legendär', en: 'legendary' }, epic: { de: 'episch', en: 'epic' },
  rare: { de: 'selten', en: 'rare' }, uncommon: { de: 'ungewöhnlich', en: 'uncommon' },
  common: { de: 'häufig', en: 'common' },
};

const sel = minerals[0];
const miningPath = href('/topics/mining.html', lang);

const S = de ? {
  ores: 'Erze', search: 'Erz suchen', onlyBreakable: 'nur brechbar',
  gear: 'Ausrüstung', laser: 'Laser', modules: 'Module', gadget: 'Gadget',
  rock: 'Felsmasse', slots: 'Modulplätze', none: '—',
  breakable: 'Brechbar', marginal: 'Grenzwertig', impossible: 'Nicht brechbar',
  noPhys: 'keine Physikdaten',
  resistance: 'Widerstand', effective: 'effektiv', instability: 'Instabilität',
  window: 'Fenster', physics: 'Physik des Erzes', math: 'Rechenweg',
  mLaser: 'Laserschaden', mResist: 'Widerstand mit Res-Mod',
  mCharge: 'Wirksamer Schaden', mMass: 'Nötiger Schaden', mRatio: 'Verhältnis',
  laserDps: 'Laser-DPS', guteZone: 'gut ab 1,30', grenzZone: 'grenzwertig ab 1,00',
  backLead: 'Fundorte, Ertrag und Steine zu', backGo: 'Im Mining ansehen →',
} : {
  ores: 'Ores', search: 'Search ore', onlyBreakable: 'breakable only',
  gear: 'Gear', laser: 'Laser', modules: 'Modules', gadget: 'Gadget',
  rock: 'Rock mass', slots: 'module slots', none: '—',
  breakable: 'Breakable', marginal: 'Marginal', impossible: 'Not breakable',
  noPhys: 'no physics data',
  resistance: 'Resistance', effective: 'effective', instability: 'Instability',
  window: 'Window', physics: 'Ore physics', math: 'The maths',
  mLaser: 'Laser damage', mResist: 'Resistance with res-mod',
  mCharge: 'Effective damage', mMass: 'Damage needed', mRatio: 'Ratio',
  laserDps: 'Laser DPS', guteZone: 'good from 1.30', grenzZone: 'marginal from 1.00',
  backLead: 'Locations, yield and rocks for', backGo: 'Open in Mining →',
};

const payload = {
  lang, minerals, lasers, modules, gadgets,
  params: { decayPerMass: P.decayPerMass || 0.2 },
  defaultMass: DEFAULT_MASS, t: S, miningPath,
  rar: Object.fromEntries(Object.entries(RAR_LBL).map(([k, v]) => [k, v[lang]])),
};
const systems = [...new Set(minerals.flatMap((m) => m.systems))].sort();
---

<section class="fc" id="calc" data-fc
         style={`--fc-chassis-img:url('${chassis1x}');--fc-chassis-img-2x:url('${chassis2x}')`}>
  {/* Gehaeuse: EIN Bild mit festem Seitenverhaeltnis, Bildflaeche als
      Prozentkasten. Begruendung, Messwerte und der verworfene 9-Slice-Weg
      stehen in .planning/sketches/010-chassis-asset/README.md. */}
  <div class="fc__chassis">
    <div class="fc__chead">
      <div class="fc__ceyebrow" set:text={eyebrow} />
      <h1 class="fc__ctitle" set:text={title} />
    </div>
    <div class="fc__cscreen">
      <p class="fc__clead" set:text={lead} />
  <div class="fc__grid">

    <!-- ============================================ Spalte 1: die 37 Erze -->
    <div class="fc__pane fc__pane--list chamf">
      <div class="fc__filters">
        <ToolHelp tool="fracturing" lang={lang} steps={4} />
        <div class="fc__frow">
          <input class="fc__search" id="fc-q" type="search" placeholder={S.search} aria-label={S.search} data-help={hlp('search')} />
          <span class="fc__c" id="fc-count">{minerals.length}</span>
        </div>
        <div class="fc__chips" data-help={hlp('system')}>
          {systems.map((s) => (<button type="button" class="fc__chip" data-sys={s} set:text={s} />))}
          <button type="button" class="fc__chip" data-only="break" data-help={hlp('breakable')} set:text={S.onlyBreakable} />
        </div>
      </div>
      {/* Jede Kachel traegt ihr Verhaeltnis. Der Punkt allein sagt nur „geht /
          geht nicht"; die Zahl sagt, wie knapp — und genau darum geht es hier. */}
      <div class="fc__scroll" id="fc-list">
        <div class="fc__tiles" data-help={hlp('tiles')}>
          {minerals.map((m) => {
            const v = ssr(m);
            return (
              <div class={`fc__tile${m.name === sel.name ? ' is-sel' : ''}`} data-min={m.name} role="button" tabindex="0" title={m.name}>
                <span class={`fc__dot is-${v.cls}`} aria-hidden="true"></span>
                <span class="fc__tn" set:text={m.name} />
                <span class="fc__tr num" set:text={v.ratio === null ? '—' : `×${num(v.ratio)}`} />
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- ========================================= Spalte 2: Urteil + Weg -->
    <div class="fc__pane fc__pane--main chamf">
      <div class="fc__head">
        <h2 id="fc-name" set:text={sel.name} />
        <div class="fc__tags" id="fc-tags"></div>
      </div>

      <div class="fc__scroll">
        <div class="fc__gauge" id="fc-gauge" data-help={hlp('verdict')}>
          <div class="fc__gtop">
            <span class="fc__gst"><span class="fc__dot" id="fc-vddot"></span><span id="fc-vdlbl"></span></span>
            <b class="num" id="fc-vdratio"></b>
          </div>
          <div class="fc__scale" id="fc-scale"></div>
          <div class="fc__gfoot">
            <span class="fc__lbl">0</span>
            <span class="fc__lbl" set:text={S.grenzZone} />
            <span class="fc__lbl" set:text={S.guteZone} />
            <span class="fc__lbl" set:text={de ? '2,0' : '2.0'} />
          </div>
        </div>

        <div class="fc__sec"><h4 set:text={S.math} /><div class="fc__math" id="fc-math" data-help={hlp('math')}></div></div>
        <div class="fc__sec"><h4 set:text={S.physics} /><div class="fc__stats" id="fc-stats"></div></div>
        <div class="fc__sec">
          <a class="fc__back" id="fc-back" href={miningPath}>
            <span class="fc__back__t"><span set:text={S.backLead} /> <b id="fc-back-ore" set:text={sel.name} /></span>
            <span class="fc__back__go" set:text={S.backGo} />
          </a>
        </div>
      </div>
    </div>

    <!-- ========================================== Spalte 3: Ausruestung -->
    <div class="fc__pane fc__pane--rig chamf">
      <div class="fc__rig">
        <label class="fc__rgrp"><span class="fc__lbl" set:text={S.laser} />
          <select class="fc__sel" id="fc-laser" data-help={hlp('laser')}>{lasers.map((l, i) => (<option value={String(i)} set:text={`${l.n.replace(' Mining Laser', '')} · S${l.size}`} />))}</select>
        </label>
        <div class="fc__rgrp">
          <span class="fc__lbl"><span set:text={S.modules} /> · <span id="fc-slotcount">0</span> <span set:text={S.slots} /></span>
          <div class="fc__slots" id="fc-slots" data-help={hlp('modules')}></div>
        </div>
        <label class="fc__rgrp"><span class="fc__lbl" set:text={S.gadget} />
          <select class="fc__sel" id="fc-gadget" data-help={hlp('gadget')}><option value="-1" set:text={S.none} />{gadgets.map((g, i) => (<option value={String(i)} set:text={g.n} />))}</select>
        </label>
        <div class="fc__rgrp"><span class="fc__lbl" set:text={S.rock} />
          <div class="fc__chips" id="fc-mass" data-help={hlp('mass')}>{MASS_PRESETS.map((p) => (<button type="button" class={`fc__chip${p.m === DEFAULT_MASS ? ' is-on' : ''}`} data-mass={String(p.m)} set:text={p[lang]} />))}</div>
        </div>
        <div class="fc__rstat">
          <span class="fc__kv"><span class="fc__lbl" set:text={S.laserDps} /><b class="num" id="fc-dps">—</b></span>
          <span class="fc__kv"><span class="fc__lbl">Res-Mod</span><b class="num" id="fc-resmod">—</b></span>
        </div>
      </div>
    </div>
  </div>
    </div>{/* .fc__cscreen */}
  </div>{/* .fc__chassis */}
</section>

<script type="application/json" id="fc-data" set:html={JSON.stringify(payload)}></script>
<script is:inline src={versioned('assets/fracturing-calc.js', '/assets/fracturing-calc.js')}></script>

<style is:inline>
.fc{max-width:1560px;margin:0 auto;padding:0 clamp(1rem,4vw,2rem) 1.4rem;
  display:flex;flex-direction:column;gap:10px;font-family:var(--font-ui,system-ui);
  line-height:1.3;position:relative;isolation:isolate;
  /* Titelstreifen plus Abstaende. Anders als in der Mining-Werkbank haengt
     hier KEINE Bedienleiste unter dem Raster — der Wert ist deshalb kleiner.
     ⚠ Am gebauten Stand nachgemessen: mit 186 fehlten dem Kachelraster bei
     1280x720 genau 7 px und die letzte Reihe (Soldynium) rutschte ins
     Scrollen, waehrend unter der Werkbank 8 px Falzluft ungenutzt lagen.
     178 gibt sie dem Raster. Wer die Zahl anfasst, misst beides nach:
     `#fc-list` darf nicht scrollen UND `.fc` nicht unter die Falz laufen. */
  --fc-chrome:178px}
/* ═══════════════════════ Gehaeuse ═══════════════════════
   Dieselbe Grafik und dieselben gemessenen Prozentwerte wie in der
   Mining-Werkbank — die beiden Seiten sind ein Paar. Belege und der
   verworfene 9-Slice-Weg: .planning/sketches/010-chassis-asset/README.md.
   ⚠ Der alte Zier-Grund `.fc::before` ist damit entfallen: er reichte 8 px
   ueber die Sektion hinaus und legte einen Lichthof um den Rahmen. */
.fc__chassis{position:relative;aspect-ratio:2552/1167;width:100%;
  background:var(--fc-chassis-img) center/100% 100% no-repeat}
@media (min-resolution:1.5dppx),(min-width:1700px){
  .fc__chassis{background-image:var(--fc-chassis-img-2x)}}
.fc__chead{position:absolute;left:0;right:0;top:0;height:11.225%;pointer-events:none;
  container-type:size}
/* ⚠ Titel eigenstaendig zentrieren, NICHT gemeinsam mit der Vorzeile in einer
   Flexbox — sonst ist die Gruppe mittig und der Titel sitzt daneben. */
.fc__ctitle{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);margin:0;
  font-size:clamp(1rem,1.75cqw,1.65rem);font-weight:600;letter-spacing:var(--ls-1);
  line-height:1;color:#f2fafb;white-space:nowrap;text-shadow:0 1px 3px var(--shadow-color),0 2px 12px var(--shadow-color)}
.fc__ceyebrow{position:absolute;left:24%;top:50%;transform:translateY(-50%);
  font-family:var(--font-mono,ui-monospace);font-weight:600;
  font-size:clamp(.5rem,.66cqw,.7rem);letter-spacing:var(--ls-15);text-transform:uppercase;
  color:#ffcf7a;white-space:nowrap;padding:4px 9px;border-radius:5px;background:var(--veil-2);box-shadow:inset 0 0 0 1px rgba(255,207,122,.28)}
@media(max-width:1180px){.fc__ceyebrow{display:none}}
.fc__cscreen{position:absolute;left:7.367%;top:11.225%;width:88.088%;height:76.692%;
  display:flex;flex-direction:column;gap:8px;min-height:0}
.fc__clead{margin:0;text-align:center;font-size:var(--fs-4);
  color:color-mix(in srgb,var(--muted) 92%,transparent)}
/* ⚠ Hier lag bis 15.08.2026 ein CSS-Raster als Grund der Bildflaeche. Es ist
   ersatzlos entfallen: die Gehaeuse-Grafik bringt ihren eigenen Verlauf im
   Bildschirmbereich mit, und eine zweite Zier-Schicht darueber waere eine
   neue Selektor-Familie, die erify:layers (Zusicherung 5) zu Recht als
   Fund ohne Registry-Eintrag meldet. Weniger Schichten, ein Tor weniger zu
   befriedigen, gleiches Bild. */

.fc__lbl{font-size:var(--fs-4);font-weight:500;color:color-mix(in srgb,var(--muted) 88%,transparent);letter-spacing:var(--ls-4)}
.num{font-family:var(--font-mono,ui-monospace);font-variant-numeric:tabular-nums}

.fc__pane{
  /* Kein Glas mehr: hinter einer deckenden Metallblende hat backdrop-filter
     nichts zu spiegeln (15.08.2026, mit dem Gehaeuse). */
  background:color-mix(in srgb,var(--ink) 62%,var(--surface));
  border-radius:12px;box-shadow:inset 0 1px 0 color-mix(in srgb,var(--text) 8%,transparent),
    0 3px 14px color-mix(in srgb,var(--ink) 40%,transparent);
  display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden;position:relative}
/* Angeschraegte Ecke OHNE clip-path — die Paarung mit backdrop-filter kostete
   an anderer Stelle schon einmal 520 ms Eintrittsanimation. */
.chamf::after{content:'';position:absolute;top:-1px;right:-1px;width:14px;height:14px;
  pointer-events:none;z-index:3;
  background:linear-gradient(45deg,transparent 0 calc(50% - .5px),
    color-mix(in srgb,var(--accent) 40%,transparent) calc(50% - .5px) calc(50% + .5px),
    var(--bg) calc(50% + .5px) 100%)}

.fc__grid{display:grid;grid-template-columns:404px 1fr 268px;gap:10px;min-height:0;
  flex:1}
.fc__scroll{flex:1;overflow-y:auto;overflow-x:hidden;min-height:0}

/* ---------------- Spalte 1 ---------------- */
.fc__filters{flex:0 0 auto;padding:9px 10px;display:flex;flex-direction:column;gap:7px;position:relative}
.fc__filters .tool-help__summary{padding:6px 10px;font-size:var(--fs-5);line-height:1.3}
.fc__filters .tool-help[open] .tool-help__body{position:absolute;top:calc(100% - 4px);left:0;right:0;
  z-index:14;background:var(--surface);border-radius:12px;line-height:1.45;
  box-shadow:0 10px 30px color-mix(in srgb,var(--ink) 60%,transparent);
  max-height:min(38vh,244px);overflow-y:auto;padding:10px 12px 12px}
.fc__frow{display:flex;align-items:center;gap:8px}
.fc__search{flex:1;min-width:0;background:color-mix(in srgb,var(--ink) 34%,transparent);border:0;
  color:var(--text);padding:7px 10px;font-size:var(--fs-6);border-radius:7px;font-family:inherit}
.fc__c{font-size:var(--fs-4);color:color-mix(in srgb,var(--muted) 88%,transparent);font-family:var(--font-mono,ui-monospace)}
.fc__chips{display:flex;gap:5px;flex-wrap:wrap}
.fc__chip{font-size:var(--fs-4);font-weight:500;padding:4px 9px;
  background:color-mix(in srgb,var(--ink) 30%,transparent);border:0;color:var(--muted);
  border-radius:999px;cursor:pointer;font-family:inherit;
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease),color var(--dur-fast,.15s) var(--ease-ui,ease)}
.fc__chip:hover{background:color-mix(in srgb,var(--surface-2) 90%,var(--text));color:var(--text)}
.fc__chip.is-on{background:var(--accent-2);color:var(--ink);font-weight:600}
.fc__tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:3px;padding:0 8px 8px}
.fc__tile{position:relative;display:grid;grid-template-columns:7px 1fr;grid-template-rows:auto auto;
  gap:0 6px;align-content:center;padding:3px 6px;border-radius:6px;cursor:pointer;
  background:color-mix(in srgb,var(--ink) 26%,transparent);
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--text) 5%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.fc__tile:hover{background:color-mix(in srgb,var(--surface-2) 88%,var(--text))}
.fc__tile.is-sel{background:color-mix(in srgb,var(--accent-2) 20%,transparent);
  box-shadow:inset 0 0 0 1px var(--accent-2)}
.fc__tn{grid-column:2;font-size:var(--fs-4);font-weight:500;color:var(--text);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fc__tr{grid-column:2;font-size:var(--fs-2);color:var(--accent)}
.fc__dot{grid-row:1/3;align-self:center;width:7px;height:7px;border-radius:999px;background:currentColor;
  color:color-mix(in srgb,var(--surface-2) 84%,var(--text))}
.fc__dot.is-ok{color:#6FBE7A}
.fc__dot.is-warn{color:var(--accent-2)}
.fc__dot.is-bad{color:#D2705A}

/* ---------------- Spalte 2 ---------------- */
.fc__head{padding:11px 14px 9px;flex:0 0 auto}
.fc__head h2{font-size:var(--fs-13);font-weight:600;line-height:1.05;margin:0;color:var(--text);letter-spacing:var(--ls-1)}
.fc__tags{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}
.fc__tag{font-size:var(--fs-3);padding:2px 7px;border-radius:999px;
  background:color-mix(in srgb,var(--ink) 30%,transparent);color:var(--muted)}
.fc__tag.is-rar{background:color-mix(in srgb,var(--accent-2) 18%,transparent);color:var(--accent-2)}

/* Messgeraet — hier die Hauptsache der Seite und deshalb wieder gross.
   Zustandsfarbe ueber `color`, alles Farbige darin per currentColor. */
.fc__gauge{margin:0 14px 12px;padding:11px 13px 9px;border-radius:10px;position:relative;
  background:color-mix(in srgb,var(--ink) 30%,transparent);
  box-shadow:inset 0 1px 0 color-mix(in srgb,var(--text) 6%,transparent)}
.fc__gauge::before{content:'';position:absolute;left:5px;top:5px;width:10px;height:10px;
  border-left:1px solid currentColor;border-top:1px solid currentColor;opacity:.5}
.fc__gauge.is-ok{color:#6FBE7A}.fc__gauge.is-warn{color:var(--accent-2)}.fc__gauge.is-bad{color:#D2705A}
.fc__gtop{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.fc__gst{display:flex;align-items:center;gap:8px;font-size:var(--fs-10);font-weight:600;color:currentColor}
.fc__gtop b{margin-left:auto;font-size:var(--fs-15);font-weight:600;line-height:1;color:currentColor}
.fc__scale{position:relative;height:26px;border-radius:5px;overflow:hidden;
  background:color-mix(in srgb,var(--ink) 62%,transparent);
  box-shadow:inset 0 2px 4px color-mix(in srgb,var(--ink) 70%,transparent)}
.fc__scale i.tick{position:absolute;top:0;bottom:0;width:1px;background:color-mix(in srgb,var(--text) 9%,transparent)}
.fc__scale i.tick.maj{background:color-mix(in srgb,var(--text) 20%,transparent)}
.fc__scale i.zone{position:absolute;top:0;bottom:0}
.fc__scale i.zone.w{background:repeating-linear-gradient(45deg,color-mix(in srgb,var(--accent-2) 18%,transparent) 0 4px,transparent 4px 8px)}
.fc__scale i.zone.g{background:repeating-linear-gradient(45deg,color-mix(in srgb,#6FBE7A 20%,transparent) 0 4px,transparent 4px 8px)}
.fc__scale i.fill{position:absolute;left:0;top:4px;bottom:4px;border-radius:2px;
  background:repeating-linear-gradient(90deg,currentColor 0 4px,transparent 4px 6px)}
.fc__scale i.mark{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--text)}
.fc__gfoot{display:flex;justify-content:space-between;margin-top:5px;gap:6px}

.fc__sec{padding:0 14px 12px}
.fc__sec h4{font-size:var(--fs-4);font-weight:600;color:color-mix(in srgb,var(--muted) 88%,transparent);
  margin:0 0 7px;padding-bottom:5px;position:relative}
.fc__sec h4::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;
  background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--text) 14%,transparent) 0 1px,transparent 1px 7px)}

/* Rechenweg: vier Zeilen und eine Summe. Jede Zeile nennt links den Schritt,
   in der Mitte die eingesetzten Zahlen und rechts das Zwischenergebnis —
   damit sichtbar ist, an welcher Schraube ein „nicht brechbar" haengt. */
.fc__math{display:flex;flex-direction:column;gap:3px}
.fc__mrow{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:baseline;gap:10px;
  padding:6px 10px;border-radius:7px;background:color-mix(in srgb,var(--ink) 22%,transparent)}
.fc__mrow .p{font-size:var(--fs-5);color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fc__mrow .s{font-size:var(--fs-3);color:color-mix(in srgb,var(--muted) 88%,transparent);white-space:nowrap}
.fc__mrow b{font-size:var(--fs-8);font-weight:600;color:var(--text);min-width:72px;text-align:right}
.fc__mrow.is-sum{background:color-mix(in srgb,var(--accent-2) 14%,transparent)}
.fc__mrow.is-sum b{color:var(--accent-2)}

.fc__stats{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}
.fc__stat{padding:7px 10px;border-radius:7px;
  background:color-mix(in srgb,var(--ink) 40%,transparent);
  box-shadow:inset 0 1px 3px color-mix(in srgb,var(--ink) 60%,transparent),
    inset 0 -1px 0 color-mix(in srgb,var(--text) 6%,transparent)}
.fc__stat b{display:block;font-size:var(--fs-9);font-weight:600;margin-top:2px;color:var(--text)}
.fc__stat.is-hot b{color:var(--accent-2)}
.fc__empty{padding:16px 12px;text-align:center;color:color-mix(in srgb,var(--muted) 88%,transparent);
  font-size:var(--fs-4);line-height:1.55;margin:0}

.fc__back{display:flex;align-items:center;gap:12px;padding:9px 12px;border-radius:8px;
  text-decoration:none;background:color-mix(in srgb,var(--ink) 24%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--accent) 26%,transparent);
  transition:background var(--dur-fast,.15s) var(--ease-ui,ease)}
.fc__back:hover{background:color-mix(in srgb,var(--accent) 16%,transparent)}
.fc__back__t{flex:1;min-width:0;font-size:var(--fs-5);color:var(--muted)}
.fc__back__t b{color:var(--text);font-weight:600}
.fc__back__go{flex:0 0 auto;font-size:var(--fs-4);font-weight:600;color:var(--accent);white-space:nowrap}

/* ---------------- Spalte 3 ---------------- */
.fc__rig{padding:11px 12px;display:flex;flex-direction:column;gap:12px}
.fc__rgrp{display:flex;flex-direction:column;gap:4px}
/* ⚠ Der Grund MUSS deckend sein: mit `…,transparent)` steht das Feld auf
   Alpha 0,34, und Chrome vererbt den Grund an die aufgeklappte Liste — die
   rechnet ihn ueber Weiss und wird unleserlich. Ueber Variablen gemischt,
   weil build-light-overrides.mjs `background` NICHT abdeckt. */
.fc__sel{background:color-mix(in srgb,var(--ink) 34%,var(--surface));border:0;color:var(--text);
  font-size:var(--fs-5);padding:7px 9px;cursor:pointer;width:100%;border-radius:7px;font-family:inherit}
.fc__sel option,.fc__slot option{background:var(--surface);color:var(--text)}
.fc__slots{display:flex;flex-direction:column;gap:4px}
.fc__slot{height:30px;border:0;padding:0 7px;font-size:var(--fs-4);width:100%;
  color:var(--text);cursor:pointer;border-radius:6px;font-family:inherit;
  background:color-mix(in srgb,var(--ink) 34%,var(--surface))}
.fc__slot.is-full{color:#6FBE7A;background:color-mix(in srgb,currentColor 18%,transparent)}
.fc__slot:disabled{opacity:.3;cursor:not-allowed}
.fc__rstat{margin-top:2px;display:flex;gap:14px;padding-top:11px;
  border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.fc__kv{flex:1}
.fc__kv b{display:block;font-size:var(--fs-9);font-weight:600;margin-top:2px;color:var(--accent-2)}

.fc__search:focus-visible,.fc__sel:focus-visible,.fc__chip:focus-visible,
.fc__slot:focus-visible,.fc__tile:focus-visible,.fc__back:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}

@media(max-width:1180px){
  .fc__grid{grid-template-columns:1fr;height:auto;flex:none}
  .fc__pane{height:auto}
  .fc__pane--list{height:min(62vh,560px)}
  .fc__scroll{max-height:none}
  /* ⚠ Gehaeuse AUS — wie in der Mining-Werkbank. Es hat ein festes
     Seitenverhaeltnis von 2552:1167; bei schmalen Fenstern schrumpft seine
     Bildflaeche damit auf eine Hoehe, in der nichts mehr Platz hat, waehrend
     die Spalten untereinander in die Laenge wachsen. */
  .fc__chassis{aspect-ratio:auto;background:none;display:flex;flex-direction:column;gap:10px}
  /* ⚠ `container-type:size` MUSS hier zurueck. Ein Groessen-Container
     berechnet seine Hoehe OHNE seinen Inhalt (Size-Containment) — das
     Kopfband fiel dadurch auf die reine Polsterung von 5 px zusammen,
     waehrend die <h1> darueber hinausragte und den Untertitel ueberdeckte.
     Gemessen bei 390 px: chead 5 px hoch, ctitle 29 px. */
  .fc__chead{position:static;height:auto;padding:0 0 .3rem;container-type:normal}
  .fc__ctitle{position:static;transform:none;white-space:normal;text-shadow:none;
    color:var(--text);font-size:clamp(1.6rem,3vw,2.1rem)}
  .fc__cscreen{position:static;left:auto;top:auto;width:auto;height:auto}
  .fc__clead{text-align:left;font-size:var(--fs-6)}
}
@media(max-width:760px){
  .fc__pane--list{height:auto}
  .fc__pane--list .fc__scroll{max-height:56vh}
  .fc__mrow{grid-template-columns:minmax(0,1fr) auto}
  .fc__mrow .s{grid-column:1/-1;text-align:right}
}
/* Hell-Entsprechungen — erzeugt von scripts/build-light-overrides.mjs. Nicht von Hand ändern. */
:root[data-theme="light"] .fc__ctitle{color:#525a5b}
:root[data-theme="light"] .fc__ceyebrow{color:#735103}
:root[data-theme="light"] .fc__dot.is-ok{color:#036b26}
:root[data-theme="light"] .fc__dot.is-bad{color:#9b2a10}
:root[data-theme="light"] .fc__gauge.is-ok{color:#036b26}
:root[data-theme="light"] .fc__gauge.is-bad{color:#9b2a10}
:root[data-theme="light"] .fc__slot.is-full{color:#036b26}
</style>
