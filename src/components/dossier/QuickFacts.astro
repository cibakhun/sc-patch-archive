---
// "Auf einen Blick" — REGISTRATUR design language.
// Renders the page's single Registertrenner (cinema→data seam) followed by
// the facts panel: 2px accent top rail + 12px corner notches (the register's
// stamp), Kopfleiste with Aktencode, values-on-stage typography.
// Accent budget: rail, title, (values stay --text). No motion.
interface Fact {
  label: string;
  value: string;
  unverified?: boolean;
}
import { useTranslations, assertLocale, type Locale } from '../../i18n/ui';
import { getCollection } from 'astro:content';
import Bezuege from './Bezuege.astro';
import { patchBezuege } from '../../lib/bezuege';
interface Props {
  facts: Fact[];
  /** Aktencode payload, e.g. "Alpha 4.0.0 · 19. Dez 2024" */
  stand?: string;
  title?: string;
  lang: Locale;
}
const { facts, stand, title } = Astro.props;
// Sprache ohne Vorgabe (assertLocale, Anlass in src/i18n/ui.ts).
const lang = assertLocale(Astro.props.lang, 'QuickFacts');
const t = useTranslations(lang);
const heading = title ?? t('qf.title');
// Schiffe und Items des Patches (UX-Audit H7): der Patch kommt aus der
// Adresse, damit keine der 22 Patchseiten etwas uebergeben muss.
const patchId = /\/patches\/sc-(\d+(?:-\d+)+)/.exec(Astro.url.pathname)?.[1];
const patchEintrag = patchId ? (await getCollection('patches')).find((p) => p.id === patchId) : undefined;
const bezuege = patchEintrag ? patchBezuege(patchEintrag.data) : [];
---
<div class="reg-divider">
  <div class="reg-divider__in">
    <span class="reg-divider__l">{t('qf.register')}</span>
    {stand && <span class="reg-divider__r">DAT&nbsp;//&nbsp;{stand}</span>}
  </div>
</div>
<section class="qf" aria-label={heading}>
  <div class="qf__in">
    <header class="qf__head">
      <h2>{heading}</h2>
      {stand && <span class="qf__code">DAT&nbsp;//&nbsp;{stand}</span>}
    </header>
    <dl class="qf__grid">
      {facts.map((f) => (
        <div class="qf__item">
          <dt>{f.label}</dt>
          <dd>{f.value}{f.unverified && <abbr class="qf__unv" title={t('common.unverified')}>*</abbr>}</dd>
        </div>
      ))}
    </dl>
    <Bezuege eintraege={bezuege} mehrHref="#dossier" max={6} />
    <nav class="qf__jump" aria-label={t('qf.jump')} data-qf-jump hidden>
      <span class="qf__jump-l">{t('qf.jump')}</span>
      <ol class="qf__jump-list"></ol>
    </nav>
  </div>
</section>

<script>
  // Sprungleiste (UX-Audit H6): Patchseiten laufen am Handy ueber 15
  // Bildschirme, ohne Inhaltsverzeichnis. Die Leiste sammelt die Abschnitte,
  // die NACH ihr kommen (".sec-head" mit Nummer und Ueberschrift, dazu der
  // Kopf des Dossiers), und zeigt sie unter "Auf einen Blick". Erst ab drei
  // Zielen; ohne Skript bleibt sie verborgen und die Seite wie bisher.
  const nav = document.querySelector<HTMLElement>('[data-qf-jump]');
  const list = nav?.querySelector('ol');
  if (nav && list) {
    const slug = (s: string) =>
      s
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    const ziele = [...document.querySelectorAll<HTMLElement>('main .sec-head, main .do__head')].filter(
      (el) => nav.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING,
    );
    const eintraege = ziele.flatMap((el) => {
      const name = el.querySelector('h2')?.textContent?.trim();
      if (!name) return [];
      const num = el.querySelector('.num, .do__num')?.textContent?.trim() ?? '';
      const sektion = el.closest<HTMLElement>('section[id]');
      let id = el.id || (el.classList.contains('do__head') && sektion ? sektion.id : '');
      if (!id) {
        const basis = `abschnitt-${slug(name) || num}`;
        id = basis;
        for (let i = 2; document.getElementById(id); i++) id = `${basis}-${i}`;
        el.id = id;
      }
      return [{ id, name, num }];
    });
    if (eintraege.length >= 3) {
      for (const e of eintraege) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${e.id}`;
        if (e.num) {
          const n = document.createElement('span');
          n.className = 'qf__jump-n';
          n.textContent = e.num;
          a.append(n);
        }
        a.append(e.name);
        li.append(a);
        list.append(li);
      }
      nav.hidden = false;
      // Kam die Adresse mit einem dieser Anker, gab es ihn beim Laden noch nicht.
      let ziel: HTMLElement | null = null;
      try {
        ziel = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      } catch {
        ziel = null;
      }
      if (ziel && eintraege.some((e) => e.id === ziel!.id)) ziel.scrollIntoView();
    }
  }
</script>

<style>
  /* Registertrenner — the seam between film and file */
  .reg-divider {border-top:1px solid var(--line, var(--line-soft));border-bottom:1px solid var(--line, var(--line-soft));background:var(--bg-2, var(--veil));
    padding: 0.45rem clamp(1.25rem, 5vw, 4.5rem);
  }
  .reg-divider__in {
    max-width: var(--maxw, 1280px);
    margin: 0 auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .reg-divider__l {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-14);
    text-transform: uppercase;
    color: var(--accent, #2dd4ff);
  }
  .reg-divider__r {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-13);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Panel — Registerrahmen + Eckfase */
  .qf {
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 5vw, 4.5rem);
  }
  .qf__in {
    max-width: var(--maxw, 1280px);
    margin: 0 auto;background:var(--surface, var(--veil-2));border:1px solid var(--line, var(--line-soft));
    border-top: 2px solid var(--accent, #2dd4ff);
    padding: 1.25rem 1.5rem 1.4rem;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
  }
  .qf__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;border-bottom:1px solid var(--line, var(--line-soft));
    padding-bottom: 0.55rem;
    margin-bottom: 1rem;
  }
  .qf__head h2 {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-9);
    letter-spacing: var(--ls-17);
    text-transform: uppercase;
    color: var(--accent, #2dd4ff);
  }
  .qf__code {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-13);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
    white-space: nowrap;
  }
  .qf__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px,100%), 1fr));
    gap: 0.7rem 1.4rem;
    margin: 0;
  }
  .qf__item {border-left:1px solid var(--line, var(--line-soft));
    padding-left: 0.8rem;
  }
  .qf__item dt {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-14);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
  }
  .qf__item dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-body, system-ui, sans-serif);
    font-weight: 500;
    font-size: var(--fs-11);
    line-height: 1.35;
    letter-spacing: var(--ls-4);
    font-variant-numeric: tabular-nums;
    color: var(--text, #e8eefc);
  }
  .qf__unv {
    color: var(--accent, #2dd4ff);
    text-decoration: none;
    cursor: help;
    margin-left: 0.15rem;
    font-size: var(--fs-10);
  }
  /* Sprungleiste unter den Fakten (UX-Audit H6) */
  .qf__jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line, var(--line-soft));
  }
  .qf__jump[hidden] {
    display: none;
  }
  .qf__jump-l {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-14);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
    margin-right: 0.3rem;
  }
  .qf__jump-list {
    display: contents;
    list-style: none;
  }
  .qf__jump-list :global(li) {
    display: contents;
  }
  .qf__jump-list :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--line, var(--line-soft));
    border-radius: 999px;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-8);
    color: var(--text, #e8eefc);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-ui), background-color var(--dur-base) var(--ease-ui);
  }
  .qf__jump-list :global(a:hover),
  .qf__jump-list :global(a:focus-visible) {
    border-color: var(--accent, #2dd4ff);
    background: color-mix(in srgb, var(--accent, #2dd4ff) 12%, transparent);
  }
  .qf__jump-list :global(.qf__jump-n) {
    color: var(--accent, #2dd4ff);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 820px) {
    .qf__jump-list :global(a) {
      min-height: 44px;
    }
  }
  /* Ziele der Leiste landen nicht unter der festen Kopfleiste. */
  :global(main .sec-head),
  :global(main #dossier) {
    scroll-margin-top: 6rem;
  }
  @media (max-width: 560px) {
    .qf__head {
      flex-direction: column;
      gap: 0.2rem;
    }
    .reg-divider__r {
      display: none;
    }
  }
  /* Mobil: die dekorative Aktencode-Zeile (DAT // …) umbrechen statt am
     Viewport-Rand abzuschneiden — voller Text bleibt sichtbar, kein Clip. */
  @media (max-width: 640px) {
    .qf__head {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .qf__code {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      overflow-wrap: anywhere;
      min-width: 0;
    }
  }
</style>
