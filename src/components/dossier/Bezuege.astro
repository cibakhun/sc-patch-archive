---
// Zeile „Schiffe und Items“ unter „Auf einen Blick“ der Themen- und
// Patchseiten (UX-Audit H7). Die Eintraege kommen aus src/lib/bezuege.ts;
// ohne Eintraege rendert die Komponente nichts.
import { href, localeFromPath, useTranslations } from '../../i18n/ui';
import { bezugPfad, type Bezug } from '../../lib/bezuege';

interface Props {
  eintraege: Bezug[];
  /** Ziel fuer „+N weitere“, wenn mehr Eintraege da sind als `max`. */
  mehrHref?: string;
  max?: number;
}
const { eintraege, mehrHref, max = 10 } = Astro.props;
const lang = localeFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const sichtbar = eintraege.slice(0, max);
const rest = eintraege.length - sichtbar.length;
---
{eintraege.length > 0 && (
  <div class="bz">
    <span class="bz__l">{t('bz.titel')}</span>
    <ul class="bz__list">
      {sichtbar.map((b) => (
        <li>
          <a class="bz__a" href={href(bezugPfad(b), lang)}>
            <span class="bz__art">{t(b.art === 'schiff' ? 'bz.schiff' : 'bz.item')}</span>
            <span class="bz__name">{b.name}</span>
            <span class="bz__pfeil" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      {rest > 0 && mehrHref && (
        <li><a class="bz__mehr" href={mehrHref}>{t('bz.mehr').replace('%n%', String(rest))}</a></li>
      )}
    </ul>
  </div>
)}

<style>
  .bz {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line, var(--line-soft));
  }
  .bz__l {
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-14);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
    margin-right: 0.3rem;
  }
  .bz__list {
    display: contents;
    list-style: none;
  }
  .bz__list li {
    display: contents;
  }
  .bz__a,
  .bz__mehr {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--accent, #2dd4ff) 45%, transparent);
    border-radius: 999px;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: var(--fs-6);
    letter-spacing: var(--ls-6);
    color: var(--text, #e8eefc);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-ui), background-color var(--dur-base) var(--ease-ui);
  }
  .bz__mehr {
    border-style: dashed;
    color: var(--muted, #8a99b8);
  }
  .bz__a:hover,
  .bz__a:focus-visible,
  .bz__mehr:hover,
  .bz__mehr:focus-visible {
    border-color: var(--accent, #2dd4ff);
    background: color-mix(in srgb, var(--accent, #2dd4ff) 12%, transparent);
  }
  .bz__art {
    font-size: 0.82em;
    letter-spacing: var(--ls-12);
    text-transform: uppercase;
    color: var(--muted, #8a99b8);
  }
  .bz__pfeil {
    color: var(--accent, #2dd4ff);
  }
  @media (max-width: 820px) {
    .bz__a,
    .bz__mehr {
      min-height: 44px;
    }
  }
</style>
