---
// Ruestungs-Set-Verzeichnis — /armor-sets.html
//
// Warum eine eigene Seite: der Finder beantwortet "was kann dieses Teil", aber
// nicht "was fehlt mir noch zum kompletten Set". Genau danach wird gesucht
// ("star citizen <set> armor set", "where to get <set> helmet"). Die Set-Ebene
// existiert in den Spieldaten (siehe scripts/lib/armor-sets.mjs) und war bis
// jetzt nirgends sichtbar.
//
// Alles hier ist statisches HTML mit echten Links auf die Item-Datenblaetter —
// kein JavaScript, keine Nachladerei.
import DataShell from './DataShell.astro';
import { href, type Locale } from '../i18n/ui';
import { itemT, fill } from '../i18n/itemText';
import {
  ITEM_PATCH, armorSets, db, itemPath, num, pageItemIds, setItemsBySlot, setsByManufacturer,
} from '../lib/items';
import { useHelp } from '../i18n/help';
import ToolHelp from './ToolHelp.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = itemT(lang);
// Werkzeug-Hilfe (Phase 01.2) — siehe
// .planning/phases/01.2-werkzeuge-erklaeren/01.2-03-PLAN.md.
const h = useHelp(lang);

const totalParts = armorSets.reduce((n, s) => n + s.parts, 0);
const complete = armorSets.filter((s) => s.coreSlots === 4).length;

const slotLabel = (slot: string) => t(('slot' + slot) as never) || slot;
// Panzerungsklasse: dieselben Schluessel wie im Finder (w<Wert> ohne Sonderzeichen)
const weightLabel = (w: string | null) => (w ? t(('w' + w.replace(/[^A-Za-z]/g, '')) as never) || w : null);
const rarityLabel = (r?: string) => (r ? t(('r' + r) as never) || r : null);
---
<DataShell
  lang={lang}
  title={lang === 'de'
    ? `Rüstungs-Sets — alle ${num(armorSets.length, lang)} Sets | Star Citizen ${ITEM_PATCH} | VerseBase`
    : `Armor Sets — all ${num(armorSets.length, lang)} sets | Star Citizen ${ITEM_PATCH} | VerseBase`}
  description={fill(t('setsLead'), { sets: num(armorSets.length, lang), parts: num(totalParts, lang), patch: ITEM_PATCH })}
  crumbs={[{ label: t('breadcrumbItems'), href: '/items.html' }, { label: t('setsBreadcrumb') }]}
  eyebrow={`Star Citizen ${ITEM_PATCH}`}
  modified={db.generatedAt}
  sources={['UEX Corp']}
  updated={db.pricesAsOf}
>
  <h1 slot="hero">{t('setsTitle')}</h1>
  <p class="dp-lead" slot="hero">{fill(t('setsLead'), { sets: num(armorSets.length, lang), parts: num(totalParts, lang), patch: ITEM_PATCH })}</p>

  <ul class="dp-keys" slot="hero" data-help={h('armorsets.ctl.keys')}>
    <li class="dp-key"><b>{t('setsCountLabel')}</b><span>{num(armorSets.length, lang)}</span></li>
    <li class="dp-key"><b>{t('setsPartsLabel')}</b><span>{num(totalParts, lang)}</span></li>
    <li class="dp-key"><b>{t('setsCompleteLabel')}</b><span>{num(complete, lang)}</span></li>
    <li class="dp-key"><b>{t('dataAsOf')}</b><span>{db.generatedAt}</span></li>
  </ul>

  <p class="as-intro">{t('setsIntro')}</p>

  {/* Kein Werkzeugleiste auf dieser Seite (Annahme A2, siehe PLAN.md
      <rules>) — der Einstieg sitzt hier, zwischen dem beschreibenden
      Vorspann und der einzigen echten Bedienung der Seite. Diese Setzung
      ist eine Annahme, keine Entscheidung des Betreibers, und steht zur
      Bestaetigung in der Abschlusspruefung der Phase (Plan 04, Task 3). */}
  <ToolHelp tool="armorsets" lang={lang} steps={4} />

  {/* Sprungmarken je Hersteller — bei 20+ Herstellern sonst endloses Scrollen */}
  <nav class="as-jump" aria-label={t('setsBreadcrumb')} data-help={h('armorsets.ctl.jump')}>
    {setsByManufacturer.map((g) => (
      <a href={`#mfr-${g.mfr.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.mfr} <span>({g.sets.length})</span></a>
    ))}
  </nav>

  {setsByManufacturer.map((g) => (
    <section class="dp-sec" id={`mfr-${g.mfr.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
      <h2>{g.mfr} <span class="dp-muted">({num(g.sets.length, lang)})</span></h2>

      {g.sets.map((s) => (
        <article class="as-set" id={s.id}>
          <header class="as-set-h">
            <h3>{s.name}</h3>
            <div class="as-set-meta">
              {s.weight && <span class="as-badge">{weightLabel(s.weight)}</span>}
              <span class={s.coreSlots === 4 ? 'as-badge as-badge--ok' : 'as-badge as-badge--part'}>
                {s.coreSlots === 4 ? t('setsComplete') : fill(t('setsPartial'), { n: s.coreSlots })}
              </span>
              <span class="dp-muted">{num(s.parts, lang)} {t('setPieces')}</span>
            </div>
          </header>

          {/* Fehlt der Helm, ist das eine echte Aussage ueber die Spieldaten —
              kein Datenfehler unsererseits. Deshalb benennen statt verschweigen. */}
          {!s.slots.Helmet && <p class="as-note">{t('setsNoHelmet')}</p>}

          {setItemsBySlot(s.id).map(([slot, list]) => (
            <div class="as-slot">
              <h4>{slotLabel(slot)} <span class="dp-muted">({num(list.length, lang)})</span></h4>
              <ul class="as-parts">
                {list.map((i) => (
                  <li>
                    {pageItemIds.has(i.id)
                      ? <a href={href(itemPath(i), lang)}>{lang === 'de' && i.game?.nameDe ? i.game.nameDe : i.name}</a>
                      : <span>{lang === 'de' && i.game?.nameDe ? i.game.nameDe : i.name}</span>}
                    {i.game?.rarity && i.game.rarity !== 'Common' && (
                      <em class={`as-rar as-rar--${i.game.rarity.toLowerCase()}`}>{rarityLabel(i.game.rarity)}</em>
                    )}
                    {i.game?.lootable === false && <em class="as-rar as-rar--excl">{t('notLootable')}</em>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </article>
      ))}
    </section>
  ))}

  <div class="dp-actions">
    <a class="dp-btn" href={href('/item-finder.html', lang)}>{t('backToFinder')} →</a>
    <a class="dp-btn" href={href('/items.html', lang)}>{t('breadcrumbItems')} →</a>
  </div>
</DataShell>

<style is:inline>
  /* Set-eigene Schicht. Die Formsprache (Eckklammern, Akzentschienen,
     Teko-Ziffern, Mono-Mikrolabels) kommt aus assets/data-page.css — hier
     steht nur, was es dort nicht gibt: Herstellersprung, Set-Karte, Slots
     und die Seltenheits-Marker.

     Die Seltenheitsfarben sind KEINE Palettenfarben, sondern eine Leiter mit
     eigener Bedeutung (die Spieldaten kennen Common..Legendary). Sie stehen
     deshalb als eigene Tokens hier — und ein zweites Mal fuer den Hellmodus,
     weil Neongruen auf Papier nicht lesbar ist. Bewusst NICHT in einem
     :root{}-Block: scripts/build-light-palettes.mjs erzeugt genau aus solchen
     Bloecken den hellen Zwilling und wuerde hier eine zweite Wahrheit anlegen. */
  .dp {
    --rar-uncommon: #4ec97a;
    --rar-rare: #4aa3ff;
    --rar-epic: #b07cff;
    --rar-legendary: #f0a52e;
    --rar-warn: #d7a13a;
  }
  :root[data-theme='light'] .dp {
    --rar-uncommon: #1d7a44;
    --rar-rare: #1b5fae;
    --rar-epic: #6b39b8;
    --rar-legendary: #8a5a02;
    --rar-warn: #7d5504;
  }

  .as-intro { color: var(--muted); font-size: var(--fs-9); line-height: 1.6; margin: 0 0 1.4rem; max-width: 72ch; }

  /* Herstellersprung: 20+ Ziele — als Mono-Kacheln mit Zahl statt als
     Pillenband, sonst verschwimmt die Reihe zu einem Grauwert.

     Kein Bildlauf-Kasten fuer diese Seite (Dokument mit Sprungmarken, kein
     Ergebnisraster, Begruendung im PLAN) — stattdessen klebt die Sprungleiste,
     damit sie von jeder Stelle der Seite aus erreichbar ist, ohne 20 Abschnitte
     durchzuscrollen. Deckender Hintergrund + blur wie .dp-bar
     (assets/data-page.css), Haarlinie als untere Kante. z-index 15,
     ausdruecklich UNTER der Brotkrumenleiste .dp-bar (20), sonst laege die
     Sprungleiste beim Scrollen darueber. */
  .as-jump {
    display: flex; flex-wrap: wrap; gap: .35rem; margin: 0 0 2.2rem;
    position: sticky; top: 0; z-index: 15;
    padding: .8rem 0; background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--line-soft);
  }
  .as-jump a {
    display: inline-flex; align-items: baseline; gap: .4rem;
    font-family: var(--font-ui); font-weight: 600; font-size: var(--fs-8);
    padding: .3rem .7rem; border: 1px solid var(--line-soft);
    border-left: 2px solid var(--dp-rail); border-radius: 2px;
    color: var(--muted); text-decoration: none;
    transition: color var(--dur-base) var(--ease-ui), border-color var(--dur-base) var(--ease-ui), background-color var(--dur-base) var(--ease-ui);
  }
  .as-jump a:hover { color: var(--text); border-color: var(--dp-hair); border-left-color: var(--tone-1); background: var(--dp-tint); }
  .as-jump span { font-family: var(--font-num); font-weight: 600; font-size: var(--fs-11); color: var(--tone-1); opacity: .85; }

  /* mobile-ux.css (Abschnitt 6) setzt scroll-margin-top fuer [id] nur hinter
     @media (max-width:820px) — dort reicht die feste Brotkrumenleiste .dp-bar
     allein. Mit der nun am DESKTOP klebenden .as-jump wuerde ein Sprungziel
     sonst unter BEIDEN Leisten landen. Diese Regel gehoert hierher statt in
     mobile-ux.css, weil sie genau diese eine Seite und genau diese eine neue
     Leiste betrifft (.dp-bar 4rem + .as-jump ca. 3rem = 7rem). */
  .dp-sec[id] { scroll-margin-top: 7rem; }

  /* Set-Karte: dieselbe Konsole wie die Kategorie-Karten, eine Stufe ruhiger. */
  .as-set {
    position: relative;
    border: 1px solid var(--line-soft);
    border-left: 2px solid var(--dp-rail);
    background: linear-gradient(180deg, var(--dp-fill), transparent 60%);
    padding: .95rem 1.05rem 1.05rem;
    margin: 0 0 .7rem;
  }
  .as-set::after {
    content: ''; position: absolute; top: -1px; right: -1px; width: 12px; height: 12px;
    border-top: 2px solid var(--dp-rail); border-right: 2px solid var(--dp-rail);
  }
  .as-set:target { border-left-color: var(--tone-1); background: linear-gradient(180deg, var(--dp-tint), transparent 60%); }

  .as-set-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem .9rem; }
  .as-set-h h3 {
    margin: 0; font-family: var(--font-display); font-weight: 800;
    font-size: var(--fs-11); letter-spacing: var(--ls-4); color: var(--text);
  }
  .as-set-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; font-size: var(--fs-6); }
  .as-set-meta > .dp-muted { font-family: var(--font-mono); font-size: var(--fs-4); letter-spacing: var(--ls-11); text-transform: uppercase; }
  .as-badge {
    font-family: var(--font-mono); font-size: var(--fs-3); letter-spacing: var(--ls-12); text-transform: uppercase;
    padding: .16rem .5rem; border: 1px solid var(--line); color: var(--muted);
  }
  .as-badge--ok { color: var(--rar-uncommon); border-color: currentColor; }
  .as-badge--part { color: var(--rar-warn); border-color: currentColor; }
  .as-note { margin: .55rem 0 0; font-size: var(--fs-7); color: var(--muted); font-style: italic; }

  .as-slot { margin-top: .95rem; }
  .as-slot h4 {
    display: flex; align-items: center; gap: .5rem;
    margin: 0 0 .45rem; font-family: var(--font-mono); font-weight: 400;
    font-size: var(--fs-4); text-transform: uppercase; letter-spacing: var(--ls-14); color: var(--muted);
  }
  .as-slot h4::after { content: ''; flex: 1; height: 1px; background: var(--line-soft); }

  /* Teile als Kacheln statt als unterstrichene Linkwand: bei 30 Varianten je
     Slot war die alte Reihe eine einzige unterstrichene Textflaeche. */
  .as-parts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem; }
  .as-parts li {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: var(--fs-7); padding: .22rem .55rem;
    background: var(--dp-fill-2); border: 1px solid var(--line-soft); border-radius: 2px;
  }
  .as-parts a { color: var(--text); text-decoration: none; }
  .as-parts li:has(a):hover { border-color: var(--tone-1); background: var(--dp-tint); }
  .as-parts a:hover { color: var(--tone-1); }
  .as-parts li > span { color: var(--muted); }
  /* Ohne Rahmen: in einem Slot mit 26 Varianten trug frueher fast jede Kachel
     ein umrandetes „UNCOMMON" — 26 gruene Kaesten nebeneinander uebertoenten
     die Teilenamen. Die Farbe allein reicht, der Kasten war das Geschrei. */
  .as-rar {
    display: inline-flex; align-items: center; gap: .25rem;
    font-family: var(--font-mono); font-size: var(--fs-2); letter-spacing: var(--ls-11); text-transform: uppercase;
    font-style: normal; color: currentColor; opacity: .95;
  }
  .as-rar::before {
    content: ''; width: 5px; height: 5px; flex: none;
    background: currentColor; clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }
  .as-rar--uncommon { color: var(--rar-uncommon); }
  .as-rar--rare { color: var(--rar-rare); }
  .as-rar--epic { color: var(--rar-epic); }
  .as-rar--legendary { color: var(--rar-legendary); }
  .as-rar--excl { color: var(--rar-warn); }

  /* ⚠ Gemessen 30.08.2026 (Aufloesungs-Durchgang): die UMBRECHENDE Leiste
     wurde bei 320 px 1044 px hoch — 184 % der Fensterhoehe — und klebt oben.
     Sie verdeckte damit den gesamten Bildschirm; bei 390 px waren es 780 px
     (92 %), bei 1024x768 noch 277 px (36 %). Unterhalb von 1181 px laeuft sie
     deshalb in EINER Zeile und wird seitwaerts gewischt.
     Die weiche rechte Kante kommt aus assets/scroll-affordance.js (SEL_FADE),
     wie bei .holo__rail — eine dauerhafte 8-px-Leiste wie bei den Tabellen in
     mobile-ux.css 5c laege hier mitten unter den Sprungmarken.
     Die zweite Bedingung ist die Hoehe: bei 1181x560 (breit, aber flach)
     blieb die Leiste 226 px = 40 % des Fensters. Breit genug fuer zwei
     Zeilen ist eben nicht dasselbe wie hoch genug fuer zwei Zeilen. */
  @media (max-width: 1180px), (max-height: 700px) {
    .as-jump {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }
    .as-jump a { flex: none; white-space: nowrap; }
  }

  @media (max-width: 820px) {
    .as-jump a { min-height: 44px; }
    .as-parts li { min-height: 34px; }
  }
</style>
