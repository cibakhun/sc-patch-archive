      ] as [string, string, boolean][],
      ps: [
        /* "The machine VerseBase is built on cuts out without warning" stand
           hier bis zum 07.08.2026 — ohne `that` liest man "VerseBase is built
           on cuts out" und stolpert. Die deutsche Fassung macht es mit Kommas
           richtig ("Der Rechner, auf dem VerseBase entsteht, …"). */
        'The PC that VerseBase is built on cut out without warning. Everything since the last save was lost, and long data runs had to start over.',
        '<b>The new power supply has been bought, and the collection for it is closed.</b> Thank you to everyone who chipped in. There is no new funding goal.',
      ],
    },
    amountLbl: 'Amount',
    amountFree: 'Other',
    cta: 'Support with €%s',
    ctaBusy: 'One moment …',
    payHint: 'Card, PayPal, Apple Pay, Google Pay or direct debit. The payment page is hosted by Stripe — this site never sees your card details.',
    payAlt: 'Prefer PayPal directly',
    payErr: 'The payment page would not open just now. Try again in a moment — or take the PayPal route below, which runs independently of it.',
    thanks: '<b>Received.</b> Thank you — that genuinely helps.',
    err: `Please enter an amount between €${MIN} and €${MAX}.`,
    honest: '<b>Voluntary, nothing in return.</b> No invoice, no contract, no perks in your account, nothing behind a paywall. I cannot issue a donation receipt — VerseBase is a private fan project, not a registered charity.',
  },
