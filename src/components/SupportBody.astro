const ctaInitial = T.cta.replace('%s', String(PRESELECT));
---
<style is:inline>
/* Instandsetzung — warme Werkstatt-Palette. Gold ist die EINE Akzentfarbe; sie
   markiert ausschliesslich den Befund (Zeichnung, Titel, Zustand) und die
   Behebung (Anzeige, Knopf). Positionsnummern bleiben bewusst grau: sie sind
   Gliederung, kein Hinweis. */
:root{--bg:#0d0a06;--bg-2:#14100a;--surface:#191309;--surface-2:#221a0e;--accent:#e8a83c;--accent-2:#ffcf7a;--hot:#e8a83c;--text:#f2ece1;--muted:#ab9d88;--line:rgba(232,168,60,.22);--line-soft:rgba(242,236,225,.10);--ink:#1a1004;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#fbf7f0;--bg-2:#f3ede4;--surface:#fffdfa;--surface-2:#f8f1e8;--text:#231f17;--muted:#635643;--accent:#795201;--accent-2:#6f4f02;--hot:#6f4a01;--ink:#ffffff;--accent-media:#e8a83c;--accent-2-media:#ffcf7a;--line:rgba(145,105,37,.3);--line-soft:rgba(49,45,37,.12)}

/* SCHRIFTEN. Am 03.08.2026 im Browser gemessen und es war schlecht: diese Seite
   lud als EINZIGE Signaturseite kein `assets/detail.css`, und dort stehen die
   Schrift-Token der Site. Die Folge war nicht "leicht anders", sondern:
     --font-ui  war NICHT GESETZT -> generisches sans statt Rajdhani
     der Fliesstext hatte gar keine Angabe -> "Times New Roman"
   Times auf fast schwarzem Grund ist duenn, kontrastreich im Strich und
   flimmert — genau die Ermuedung, die gemeldet wurde. Zum Vergleich auf
   /de/feedback.html gemessen: dort Barlow, hier Times.

   Die Token stehen ABSICHTLICH hier und nicht via detail.css: jenes Blatt
   bringt Hero-, Band- und Abschnittsregeln plus eine Rasterschicht ueber
   `body::after` mit, die mit dem eigenstaendigen Werkstatt-Aufbau kollidieren.
   Gebraucht werden nur die drei Zeilen. Sie sind woertlich aus detail.css
   uebernommen — laufen sie auseinander, faellt diese Seite wieder aus der Reihe.

   Bewusst auf .sup statt auf :root: die Farbtoken-Zeile darueber wird von
   scripts/build-light-palettes.mjs erzeugt, dort haben Schriften nichts zu
   suchen. Eigenschaften vererben sich ohnehin nach unten. */
.sup{--font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;font-family:var(--font-body);-webkit-font-smoothing:antialiased}

/* box-sizing ist hier NICHT vorsorglich: die Seite setzt keinen globalen Reset,
   und bei 360 px ragten dadurch die Auftragsfelder auf 422 px und der Knopf auf
   369 px hinaus — `width:100%` plus Innenabstand ergibt mehr als die Spalte.
   Sichtbar war davon NICHTS: theme.css versteckt jede Bildlaufleiste und
   Layout.astro setzt `overflow-x:clip`, der Ueberlauf wird also stillschweigend
   abgeschnitten. Im Browser bei 360 px gemessen. */
.sup,.sup *{box-sizing:border-box}
.sup{max-width:var(--maxw);margin:0 auto}
.sup .cap{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.sup .cap--wide{letter-spacing:.38em}
.sup .num{font-variant-numeric:tabular-nums;font-family:var(--font-mono,'Share Tech Mono',monospace)}

/* --- Auftragskopf --------------------------------------------------------- */
.sup__head{border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--bg-2),var(--bg))}
/* Die Kopfleiste der Seite ist `position:fixed` und 62 px hoch. Ohne diesen
   Abstand liegt der Titel 32 px DAHINTER — im Browser auf staging gemessen,
   "Instandsetzung" war zur Haelfte verdeckt. Die Hero-Seiten der Site loesen
   dasselbe mit padding-top: 6.2rem bzw. 4.4rem unter 700 px. */
.sup__headtop{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:clamp(4.6rem,7vw,6rem) clamp(16px,4vw,40px) 12px;flex-wrap:wrap}
.sup__ttl{font-family:var(--font-display,sans-serif);font-weight:700;font-size:clamp(1.5rem,4.6vw,2.3rem);line-height:1.05;letter-spacing:.01em;color:var(--text);margin:0}
.sup__ttl em{font-style:normal;color:var(--accent)}
/* minmax(0,1fr) statt 1fr: `1fr` ist `minmax(auto,1fr)`, die Zelle kann also
   nicht unter ihre Inhaltsbreite schrumpfen. Bei 360 px blieben die Zellen
   deshalb 206 px breit — zusammen 413 px — und „Kostenrahmen 120,00 EUR" wurde
   rechts abgeschnitten, unsichtbar, weil overflow-x:clip greift. Gemessen. */
.sup__fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-soft);margin:0}
.sup__fields dt,.sup__fields dd{overflow-wrap:anywhere}
.sup__fields>div{padding:12px clamp(16px,4vw,40px) 14px;border-right:1px solid var(--line-soft)}
.sup__fields>div:last-child{border-right:0}
.sup__fields>div:not(:first-child){padding-left:18px}
.sup__fields dt{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.sup__fields dd{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.86rem;letter-spacing:.05em;color:var(--text);margin:4px 0 0;font-variant-numeric:tabular-nums}
.sup__fields dd.hi{color:var(--accent)}

/* --- Koerper: Zeichnung | Auftrag ----------------------------------------- */
/* align-items:stretch statt start: die Zeichnung ist 660 px hoch, die
   Auftragsspalte 1322 — bei `start` klaffte darunter ein 662 px hohes dunkles
   Loch, auf staging angesehen der auffaelligste Fehler der Seite. Gestreckt
   laeuft das Rasterpapier samt Trennlinie durch, wie auf einem echten
   Zeichnungsblatt. Die Zeichnung selbst bleibt per sticky stehen, solange man
   den Auftrag daneben liest — sie gehoert zum Text, nicht davor. */
.sup__body{display:grid;grid-template-columns:minmax(300px,400px) minmax(0,1fr);align-items:stretch}
.sup__sticky{position:sticky;top:5.2rem}
/* Unten 22 statt 40 px: gemessen blieben 105 px Totraum unter der Zeichnung,
   das Rasterpapier lief sichtbar ins Leere. */
.sup__drawing{position:relative;padding:32px clamp(16px,3vw,32px) 22px;border-right:1px solid var(--line-soft);background:linear-gradient(90deg,var(--line-soft) 0 1px,transparent 1px 100%) 0 0/32px 32px,linear-gradient(0deg,var(--line-soft) 0 1px,transparent 1px 100%) 0 0/32px 32px,var(--bg)}
/* Eckklammern wie auf einem Zeichnungsblatt */
.sup__drawing::before{content:"";position:absolute;inset:14px;pointer-events:none;background:linear-gradient(var(--line) 0 0) 0 0/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 0 0/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 100% 0/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 100% 0/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 0 100%/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 0 100%/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 100% 100%/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 100% 100%/1px 18px no-repeat}
.sup__drawcap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px;padding-top:10px;border-top:1px solid var(--line-soft)}
.sup__sch{display:block;width:100%;height:auto}
.sup__sch .o{fill:none;stroke:var(--muted);stroke-width:1.7;vector-effect:non-scaling-stroke}
.sup__sch .t{fill:none;stroke:var(--line);stroke-width:1;vector-effect:non-scaling-stroke}
.sup__sch .c{fill:none;stroke:var(--muted);stroke-width:1;stroke-dasharray:14 4 3 4;opacity:.45;vector-effect:non-scaling-stroke}
.sup__sch .d{fill:none;stroke:var(--muted);stroke-width:1;opacity:.7;vector-effect:non-scaling-stroke}
.sup__sch .ar{fill:var(--muted);opacity:.7;stroke:none}
.sup__sch .hot{fill:none;stroke:var(--accent);stroke-width:1.7;stroke-dasharray:7 4;vector-effect:non-scaling-stroke}
.sup__sch .ld{fill:none;stroke:var(--accent);stroke-width:1;vector-effect:non-scaling-stroke}
.sup__sch .dot{fill:var(--line);stroke:none}
.sup__sch text{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:10.5px;letter-spacing:.1em;fill:var(--muted)}
.sup__sch text.hi{fill:var(--accent)}
.sup__sch g{stroke-linecap:butt;stroke-linejoin:miter}

/* --- Positionen ----------------------------------------------------------- */
.sup__order{padding:32px clamp(16px,4vw,40px) 0}
.sup__pos{border-top:1px solid var(--line-soft);padding:20px 0;display:grid;grid-template-columns:3.4rem 1fr;gap:0 16px}
.sup__pos:first-of-type{border-top:0;padding-top:0}
.sup__pos-n{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.74rem;letter-spacing:.12em;color:var(--muted);padding-top:4px;text-transform:uppercase}
.sup__pos h2{font-family:var(--font-ui,sans-serif);font-weight:700;font-size:.82rem;letter-spacing:.16em;text-transform:uppercase;color:var(--text);margin:0 0 8px}
/* Der Fliesstext stand in var(--muted) — also in der Farbe, die auf dieser
   Seite sonst BESCHRIFTUNGEN traegt (Feldnamen, Skala, Positionsnummern).
   Gemessen: 7,44:1 gegen 12,8:1 fuer var(--text). Das besteht die Norm, aber es
   ist die gedaempfte Stufe, und der laengste Lesetext der Seite stand darin.
   Die Gliederung kommt weiterhin aus Fettung und Akzent, nicht aus Absenkung. */
.sup__pos p{color:var(--text);font-size:.98rem;line-height:1.7;max-width:58ch;margin:0}
.sup__pos p+p{margin-top:10px}
/* 700 statt 600, seit der Fliesstext dieselbe Farbe hat: die Hervorhebung trug
   sich vorher zur Haelfte ueber die Helligkeit. Bleibt nur die Fettung, muss
   die auch tragen. */
.sup__pos p b,.sup__pos p strong{color:var(--text);font-weight:700}

/* --- Kostenrahmen mit Teilung --------------------------------------------- */
.sup__gauge{margin:24px 0 8px}
.sup__ghead{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:10px}
.sup__gread{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:1.02rem;letter-spacing:.06em;color:var(--accent);font-variant-numeric:tabular-nums}
/* Die Anzeige ist ein KOSTENRAHMEN mit Marke, kein Fortschrittsbalken. Der
   Unterschied ist nicht kosmetisch: bei den vorgewaehlten 5 von 120 EUR sind
   4 % gefuellt — als Fortschritt gelesen sieht das aus wie "fast nichts
   erreicht", und im Browser sah es schlicht nach einem leeren, kaputten Balken
   aus (auf staging angesehen). Als Skala mit Marke gelesen stimmt dasselbe
   Bild: "dein Betrag steht hier". Deshalb gedaempfte Flaeche plus eine
   deutliche Kante, die auch bei 3 EUR sichtbar bleibt.
   Teilstriche nur an den vier beschrifteten Marken — zwoelf Striche liessen
   den Balken segmentiert und defekt wirken. */
.sup__gtrack{position:relative;height:26px;border:1px solid var(--line);background:var(--surface-2);overflow:hidden}
.sup__gfill{position:absolute;inset:0 auto 0 0;min-width:3px;background:color-mix(in srgb,var(--accent) 26%,transparent);border-right:3px solid var(--accent);transition:width .6s cubic-bezier(.16,.84,.34,1)}
.sup__gticks{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--muted) 34%,transparent) 0 1px,transparent 1px calc(100% / 4))}
/* Teilungsbeschriftung ueber flex + space-between statt Null-Spalte mit
   transform: ein verschobenes Element verkleinert seinen Scroll-Kasten NICHT
   und riss die Skizze bei 360 px um 23 px auf. */
.sup__gscale{display:flex;justify-content:space-between;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.62rem;letter-spacing:.1em;color:var(--muted);margin-top:5px}
.sup__gscale span{white-space:nowrap}

/* Admin-Feld: nur sichtbar, wenn <html> die is-admin-Klasse traegt. Das ist
   eine ANZEIGE-Sperre. Die echte Sperre ist die RLS-Regel auf der Tabelle —
   wer das Feld per Konsole einblendet, bekommt vom Server ein Nein. */
.sup__admin{margin:16px 0 0;padding:14px 16px;border:1px dashed var(--line);background:var(--surface-2)}
.sup__admin[hidden]{display:none}
.sup__adminlbl{display:block;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
.sup__adminrow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sup__adminrow input{width:7rem;min-height:44px;padding:.5rem .7rem;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:1rem;color:var(--text);background:var(--bg-2);border:1px solid var(--line-soft);font-variant-numeric:tabular-nums}
.sup__adminrow input:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px;border-color:var(--accent)}
.sup__adminrow .cur{font-family:var(--font-ui,sans-serif);font-weight:700;color:var(--muted)}
.sup__adminrow button{min-height:44px;padding:.5rem 1.1rem;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);background:var(--accent);border:1px solid var(--accent);cursor:pointer;transition:filter .15s}
.sup__adminrow button:hover{filter:brightness(1.08)}
.sup__adminrow button:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.sup__adminrow button[disabled]{opacity:.5;cursor:default}
.sup__adminmsg{margin:10px 0 0;font-size:.84rem;line-height:1.5;color:var(--accent)}
.sup__adminmsg[hidden]{display:none}
.sup__adminmsg.is-bad{color:var(--accent-2)}
.sup__adminhint{margin:8px 0 0;font-size:.74rem;color:var(--muted);line-height:1.5;opacity:.8}
/* Die Aufteilung gezaehlt/eingetragen. Nur hier — nach aussen steht EINE Zahl. */
.sup__adminsplit{margin:10px 0 0;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.74rem;letter-spacing:.06em;color:var(--muted);font-variant-numeric:tabular-nums}
.sup__adminsplit[hidden]{display:none}

/* --- Waehler -------------------------------------------------------------- */
.sup__card{border:1px solid var(--line);background:linear-gradient(180deg,var(--surface),var(--bg-2));padding:24px;margin-top:8px;display:grid;gap:16px;clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px))}
.sup__lbl{display:block;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text);margin-bottom:8px}
.sup__row{display:flex;flex-wrap:wrap;gap:8px}
.sup__pill{position:relative;cursor:pointer}
.sup__pill input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sup__pill span{display:block;min-width:4.4rem;min-height:44px;text-align:center;border:1px solid var(--line);background:var(--veil,var(--veil-hi));padding:11px 16px;transition:border-color .15s,background-color .15s,color .15s;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:.95rem;color:var(--text)}
.sup__pill:hover span{border-color:var(--accent)}
.sup__pill input:checked+span{background:color-mix(in srgb,var(--accent) 14%,transparent);border-color:var(--accent);color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.sup__pill input:focus-visible+span{outline:2px solid var(--accent-2);outline-offset:3px}
.sup__freewrap{display:flex;align-items:stretch}
/* DIREKTES Kind. Ohne den `>` traf diese Regel auch das <span class="cur"> mit
   dem Eurozeichen, das INNERHALB liegt: das € bekam damit denselben Rahmen,
   denselben Hintergrund, 14 px Polster und 44 px Mindesthoehe wie das Feld
   selbst — eine Schachtel in der Schachtel. Im Browser am 03.08.2026 gesehen,
   nachdem es gemeldet wurde. Der neue Fokus-Umriss weiter unten hat es dann
   verdoppelt und damit endgueltig kaputt aussehen lassen. */
.sup__freewrap > span{display:flex;align-items:center;gap:6px;min-width:0;min-height:44px;border:1px solid var(--line);background:var(--veil,var(--veil-hi));padding:0 14px}
.sup__freewrap input{width:4.6rem;background:none;border:0;outline:none;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:.95rem;padding:11px 0;color:var(--text);font-variant-numeric:tabular-nums}
.sup__freewrap .cur{font-family:var(--font-ui,sans-serif);font-weight:700;color:var(--muted)}
/* Der Platzhalter „Anderer" stand auf der VORGABE DES BROWSERS: rgb(117,117,117),
   ein neutrales Grau in einer durchweg warmen Palette, gemessene 4,29:1 — der
   schlechteste Wert der ganzen Seite, waehrend alles andere ueber 7:1 liegt.
   `opacity:1` ist noetig, weil Firefox den Platzhalter zusaetzlich auf 0.54
   herunterblendet und die Farbe allein dort nichts ausrichtet. */
.sup__freewrap input::placeholder,.sup__adminrow input::placeholder{color:var(--muted);opacity:1}
/* FOKUS. Vorher: `outline:none` am Feld, und sichtbar wurde nur ein 1-px-Rand,
   der von rgba(232,168,60,.22) auf volles Gold wechselte. Die Betragsstufen
   direkt daneben bekommen im Fokus einen 2-px-Umriss mit Abstand — dasselbe
   Bedienelement, zwei verschiedene Antworten. Beim Anklicken sah das Feld
   dadurch eher kaputt als aktiv aus.
   Jetzt derselbe Umriss wie bei den Stufen, plus eine angehobene Flaeche:
   der Rand allein traegt bei einem Feld nicht, das man gerade beschreibt. */
.sup__freewrap:focus-within > span{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent);outline:2px solid var(--accent-2);outline-offset:3px}
/* Der Fokusring von detail.css setzt --accent-2; hier ausdruecklich gesetzt,
   damit er nicht von der Seitenpalette abweicht. */
.sup__freewrap input:focus-visible{outline:none}
.sup__cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:.92rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:var(--accent);border:1px solid var(--accent);padding:15px 28px;text-decoration:none;transition:filter .15s,opacity .15s;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px))}
.sup__cta:hover{filter:brightness(1.08)}
.sup__cta:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.sup__cta[aria-disabled='true']{opacity:.5;pointer-events:none}
/* Der Knopf ist seit dem Wechsel auf Stripe ein <button>, kein <a>: der Betrag
   entsteht erst beim Klick, ein href waere eine Luege. Was der Browser dafuer
   von sich aus mitbringt und hier stoert: eigene Schriftgroesse (font:inherit
   greift nicht, weil .sup__cta die Schrift ohnehin setzt) und der Pfeil-Cursor. */
.sup__cta{cursor:pointer;width:100%;text-align:center}
/* Waehrend die Bezahlseite geholt wird. KEIN [disabled]: ein disabled-Knopf
   verliert den Fokus, und der Screenreader verliert damit die Stelle. */
.sup__cta[data-busy]{opacity:.6;pointer-events:none}
/* Nebenweg. Bewusst leise — eine Zeile, keine zweite Schaltflaeche: zwei
   gleich laute Knoepfe machen aus einer Entscheidung zwei. */
.sup__alt{margin:-4px 0 0;font-size:.84rem;line-height:1.5;color:var(--muted)}
.sup__alt a{text-underline-offset:3px}
.sup__payhint{margin:-6px 0 0;font-size:.78rem;line-height:1.55;color:var(--muted);opacity:.85}
/* Rueckkehr von Stripe (?danke=1). Startet verborgen; das Skript unten blendet
   es ein. Kein Betrag darin — der stuende sonst in der Adresszeile und damit
   im Verlauf, im Verweis-Kopf und in jedem Log (D-16). */
.sup__thanks{margin:0;padding:14px 16px;border-left:2px solid var(--accent);background:var(--surface-2);font-size:.9rem;line-height:1.6;color:var(--text)}
.sup__thanks[hidden]{display:none}
.sup__thanks b{color:var(--accent)}
.sup__err{color:var(--accent-2);font-size:.88rem;line-height:1.5;margin:4px 0 0}
.sup__err[hidden]{display:none}
.sup__honest{font-size:.82rem;line-height:1.6;color:var(--muted);border-left:2px solid var(--line);padding-left:14px;margin:0}
.sup__honest b{color:var(--text);font-weight:600}

/* --- Fuss: was genauso hilft ---------------------------------------------- */
.sup__help{margin:44px clamp(16px,4vw,40px) 0;border-top:1px solid var(--line);padding:24px 0 56px}
.sup__help h2{font-family:var(--font-ui,sans-serif);font-weight:700;letter-spacing:.16em;text-transform:uppercase;font-size:.82rem;color:var(--accent);margin:0 0 14px}
.sup__help ul{list-style:none;padding:0;margin:0;display:grid;gap:12px}
.sup__help li{color:var(--muted);font-size:.96rem;line-height:1.6;padding-left:16px;border-left:1px solid var(--line-soft)}
.sup__help li b{color:var(--text);font-weight:600}
.sup__help p{margin:18px 0 0;font-size:.92rem}
.sup__help a{color:var(--accent)}

/* Bewegung ist Verstaerkung: assets/detail.css gattert bei reduzierter Bewegung
   nur `animation`, NICHT `transition` — die Uebergaenge oben brauchen deshalb
   ihre eigene Klammer, sonst laufen sie trotz Systemeinstellung weiter. */
@media (prefers-reduced-motion:reduce){
  .sup__gfill,.sup__pill span,.sup__cta{transition:none}
}
@media (max-width:860px){
  .sup__body{grid-template-columns:minmax(0,1fr)}
  /* Einspaltig gibt es nichts mehr, woran die Zeichnung kleben koennte —
     sticky wuerde sie nur ueber den Text schieben. */
  .sup__sticky{position:static}
  .sup__drawing{border-right:0;border-bottom:1px solid var(--line-soft)}
  .sup__fields{grid-template-columns:repeat(2,minmax(0,1fr))}
  .sup__fields>div:nth-child(2){border-right:0}
}
@media (max-width:480px){
  /* Der Innenabstand der Zellen war bei 360 px der zweite Teil des Problems:
     16 px links plus 18 px Zusatz je Folgezelle fressen ein Zehntel der
     Bildbreite, bevor Text ueberhaupt anfaengt. */
  .sup__fields>div{padding-left:14px;padding-right:14px}
  .sup__fields>div:not(:first-child){padding-left:14px}
}
@media (max-width:560px){
  .sup__row{display:grid;grid-template-columns:1fr 1fr}
  .sup__pill span{min-width:0}
  .sup__freewrap{grid-column:1/-1}
  /* Auch hier das direkte Kind: ohne `>` bekam das € ebenfalls width:100% und
     drueckte im schmalen Raster gegen das Eingabefeld. */
  .sup__freewrap > span{width:100%}
  .sup__freewrap input{width:100%}
  .sup__cta{width:100%}
  .sup__pos{grid-template-columns:1fr;gap:6px}
}</style>

<main id="main">
  <article class="sup">

    <header class="sup__head">
      <div class="sup__headtop">
        <h1 class="sup__ttl">{T.ttl1}<br /><em set:text={T.ttl2}></em></h1>
        <span class="cap cap--wide" set:text={T.kicker}></span>
      </div>
      <dl class="sup__fields">
        {T.fields.map(([k, v, hi]) => (
          <div>
            <dt set:text={k}></dt>
            <dd class={hi ? 'hi' : undefined} set:text={v}></dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="sup__body">

      {/* Senkrechte Explosionsdarstellung: Gehaeuse, Luefter, Platine mit der
          Kondensatorbank (das Fehlerteil, golden umgrenzt), Anschlussfeld. */}
      <div class="sup__drawing">
        <div class="sup__sticky">
        <svg class="sup__sch" viewBox="0 0 400 640" role="img" aria-label={T.schAlt}>
          <g>
            <path class="c" d="M150 22 V 596"></path>

            <path class="d" d="M52 40 H 20 M52 570 H 20 M26 46 V 564"></path>
            <path class="ar" d="M22 52 L26 40 L30 52 Z"></path>
            <path class="ar" d="M22 558 L26 570 L30 558 Z"></path>
            <text transform="translate(15,305) rotate(-90)" text-anchor="middle" set:text={T.sch.dim}></text>

            <rect class="o" x="55" y="40" width="190" height="110"></rect>
            <rect class="t" x="63" y="48" width="174" height="94"></rect>
            <circle class="t" cx="150" cy="95" r="42"></circle>
            <circle class="t" cx="150" cy="95" r="30"></circle>
            <circle class="t" cx="150" cy="95" r="18"></circle>
            <circle class="o" cx="150" cy="95" r="7"></circle>
            <path class="t" d="M157 95 H192 M154.95 99.95 L179.7 124.7 M150 102 V137 M145.05 99.95 L120.3 124.7 M143 95 H108 M145.05 90.05 L120.3 65.3 M150 88 V53 M154.95 90.05 L179.7 65.3"></path>
            <path class="ld" d="M245 95 H261"></path>
            <text x="265" y="92" set:text={T.sch.case[0]}></text>
            <text x="265" y="106" set:text={T.sch.case[1]}></text>

            <rect class="t" x="108" y="188" width="84" height="84"></rect>
            <circle class="o" cx="150" cy="230" r="40"></circle>
            <circle class="o" cx="150" cy="230" r="11"></circle>
            <path class="t" d="M161 230 H188 M156.9 238.6 L173.7 259.7 M147.6 240.7 L141.5 267 M140.1 234.8 L115.8 246.5 M140.1 225.2 L115.8 213.5 M147.6 219.3 L141.5 193 M156.9 221.4 L173.7 200.3"></path>
            <path class="ld" d="M192 230 H261"></path>
            <text x="265" y="227" set:text={T.sch.fan[0]}></text>
            <text x="265" y="241" set:text={T.sch.fan[1]}></text>

            <rect class="o" x="45" y="305" width="210" height="145"></rect>
            <path class="t" d="M55 312 H245"></path>
            <path class="t" d="M60 440 V428 H120 V436 M240 440 V425 H180"></path>
            <g class="dot">
              <circle cx="60" cy="443" r="1.6"></circle><circle cx="74" cy="443" r="1.6"></circle>
              <circle cx="88" cy="443" r="1.6"></circle><circle cx="102" cy="443" r="1.6"></circle>
              <circle cx="116" cy="443" r="1.6"></circle><circle cx="130" cy="443" r="1.6"></circle>
              <circle cx="144" cy="443" r="1.6"></circle><circle cx="158" cy="443" r="1.6"></circle>
              <circle cx="172" cy="443" r="1.6"></circle><circle cx="186" cy="443" r="1.6"></circle>
              <circle cx="200" cy="443" r="1.6"></circle><circle cx="214" cy="443" r="1.6"></circle>
              <circle cx="228" cy="443" r="1.6"></circle><circle cx="242" cy="443" r="1.6"></circle>
            </g>
            <ellipse class="o" cx="90" cy="330" rx="18" ry="6"></ellipse>
            <path class="o" d="M72 330 V412 A18 6 0 0 0 108 412 V330"></path>
            <path class="t" d="M81 330 H99 M90 324 V336 M72 352 H108"></path>
            <ellipse class="o" cx="150" cy="330" rx="18" ry="6"></ellipse>
            <path class="o" d="M132 330 V412 A18 6 0 0 0 168 412 V330"></path>
            <path class="t" d="M141 330 H159 M150 324 V336 M132 352 H168"></path>
            <ellipse class="o" cx="210" cy="330" rx="18" ry="6"></ellipse>
            <path class="o" d="M192 330 V412 A18 6 0 0 0 228 412 V330"></path>
            <path class="t" d="M201 330 H219 M210 324 V336 M192 352 H228"></path>
            <rect class="hot" x="62" y="316" width="176" height="110"></rect>
            <path class="ld" d="M238 352 H261"></path>
            <text class="hi" x="265" y="342" set:text={T.sch.cap[0]}></text>
            <text x="265" y="356" set:text={T.sch.cap[1]}></text>
            <text x="265" y="370" set:text={T.sch.cap[2]}></text>
            <text class="hi" x="265" y="390" set:text={T.sch.cap[3]}></text>
            <text class="hi" x="265" y="404" set:text={T.sch.cap[4]}></text>
            <path class="ld" d="M255 436 H261"></path>
            <text x="265" y="440" set:text={T.sch.pcb}></text>

            <rect class="o" x="70" y="490" width="160" height="80"></rect>
            <path class="o" d="M92 548 V524 L100 516 H136 L144 524 V548 Z"></path>
            <rect class="t" x="102" y="528" width="8" height="12"></rect>
            <rect class="t" x="114" y="532" width="8" height="12"></rect>
            <rect class="t" x="126" y="528" width="8" height="12"></rect>
            <rect class="o" x="166" y="516" width="44" height="32"></rect>
            <path class="t" d="M188 516 V548"></path>
            <text x="172" y="540" font-size="11">I</text>
            <text x="196" y="540" font-size="11">O</text>
            <path class="ld" d="M230 530 H261"></path>
            <text x="265" y="527" set:text={T.sch.conn[0]}></text>
            <text x="265" y="541" set:text={T.sch.conn[1]}></text>
          </g>
        </svg>
        <div class="sup__drawcap">
          <span class="cap" set:text={T.schCap1}></span>
          <span class="cap" set:text={T.schCap2}></span>
        </div>
        </div>
      </div>

      {/* Der Auftrag. Bewusst <div> statt <section>: assets/detail.css stylt
          blankes `section` mit clamp(3rem,7vw,5.5rem) Innenabstand — dieselbe
          Falle, die schon das Konto-Panel getroffen hat. */}
      <div class="sup__order">
        {T.pos.map(([n, h, p1, p2]) => (
          <div class="sup__pos">
            <span class="sup__pos-n" set:text={n}></span>
            <div>
              <h2 set:text={h}></h2>
              <p set:html={p1}></p>
              {p2 && <p set:html={p2}></p>}
            </div>
          </div>
        ))}

        {/* Kostenrahmen. Zeigt den GEWAEHLTEN Betrag, NICHT einen Ist-Stand —
            den gibt es nicht, siehe Kopfkommentar. */}
        {/* Stand der Sammlung. Startet VERBORGEN und wird erst sichtbar, wenn
            der Wert aus der Datenbank da ist. Faellt der Abruf aus, bleibt der
            Abschnitt weg — lieber kein Balken als ein leerer, der einen Stand
            von null behauptet (Hausregel „Never fabricate data"). */}
        <div class="sup__gauge" id="supGauge" hidden>
          <div class="sup__ghead">
            <span class="cap" set:text={T.gaugeHead}></span>
            <span class="sup__gread num" id="supRead">— / — EUR</span>
          </div>
          <div class="sup__gtrack">
            <div class="sup__gfill" id="supFill" style="width:0%"></div>
            <div class="sup__gticks" aria-hidden="true"></div>
          </div>
          <div class="sup__gscale" id="supScale" aria-hidden="true"></div>

          {/* Nur fuer Admins. Das Gatter ist die is-admin-Klasse auf <html>,
              die Layout.astro aus dem Rollen-Cache setzt — dasselbe und
              EINZIGE Admin-Gatter der Seite. Es ist nur eine Anzeige-Sperre;
              die echte Sperre ist die RLS-Regel auf der Tabelle, die
              Schreibzugriff auf Admins begrenzt. */}
          <div class="sup__admin" id="supAdmin" hidden>
            <label class="sup__adminlbl" for="supNew" set:text={T.adminLbl}></label>
            <div class="sup__adminrow">
              <input id="supNew" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" />
              <span class="cur">€</span>
              <button type="button" id="supSave" set:text={T.adminSave}></button>
            </div>
            <p class="sup__adminmsg" id="supMsg" role="status" hidden></p>
            <p class="sup__adminsplit" id="supSplit" hidden></p>
            <p class="sup__adminhint" set:text={T.adminHint}></p>
          </div>
        </div>

        <div class="sup__card">
          {/* Rueckkehr von der Bezahlseite. role="status" statt "alert": es ist
              eine Bestaetigung, keine Warnung — ein alert unterbricht den
              Screenreader mitten im Satz. */}
          <p class="sup__thanks" id="supThanks" role="status" hidden set:html={T.thanks}></p>
          <div>
            <span class="sup__lbl" id="supAmtLbl" set:text={T.amountLbl}></span>
            <div class="sup__row" role="radiogroup" aria-labelledby="supAmtLbl">
              {STEPS.map((v) => (
                <label class="sup__pill">
                  <input type="radio" name="sup-amount" value={v} checked={v === PRESELECT} />
                  <span>{v} €</span>
                </label>
              ))}
              <label class="sup__freewrap">
                <span>
                  <input id="supFree" type="text" inputmode="decimal" autocomplete="off" placeholder={T.amountFree} aria-label={T.amountFree} aria-describedby="supErr" />
                  <span class="cur">€</span>
                </span>
              </label>
            </div>
          </div>
          <p class="sup__err" id="supErr" role="status" hidden set:text={T.err}></p>
          {/* Ein <button>, kein <a>: die Zieladresse existiert beim Rendern noch
              gar nicht — sie entsteht erst, wenn Stripe die Bezahlseite anlegt.
              Ein href waere entweder falsch oder eine Attrappe. */}
          <button class="sup__cta" id="supCta" type="button" data-cents={String(PRESELECT * 100)}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7"></path></svg>
            <span id="supCtaTxt" set:text={ctaInitial}></span>
          </button>
          <p class="sup__err" id="supPayErr" role="status" hidden set:text={T.payErr}></p>
          <p class="sup__payhint" set:text={T.payHint}></p>
          {/* Nebenweg. Behaelt seinen href und funktioniert deshalb auch dann,
              wenn das Skript daneben gar nicht erst laeuft. */}
          <p class="sup__alt">
            <a id="supPp" href={`${PAYPAL}/${PRESELECT}EUR`} rel="noopener" set:text={T.payAlt}></a>
          </p>
          <p class="sup__honest" set:html={T.honest}></p>
        </div>
      </div>
    </div>

    <div class="sup__help">
      <h2 set:text={T.h2help}></h2>
      <ul>
        {T.helps.map(([b, rest]) => <li><b>{b}</b> {rest}</li>)}
      </ul>
      <p><a href={href('/feedback.html', lang)} set:text={T.feedback}></a></p>
    </div>
  </article>
</main>

{/* Betragswahl -> beide Wege + Anzeige.
    Fuer den Hauptweg wird der Betrag in CENT am Knopf hinterlegt; das Skript
    darunter liest ihn beim Klick. Zwei Skripte statt einem, weil sie
    verschiedene Dinge tun: dieses rechnet und beschriftet, jenes redet mit dem
    Netz. Bricht der Netz-Teil, bleibt die Betragswahl trotzdem bedienbar.
    Der PayPal-Empfaenger stammt AUSSCHLIESSLICH aus der Konstante — aus der
    Eingabe kommt nur die Zahl, und die wird geklemmt. */}
<script
  is:inline
  data-sup-base={PAYPAL}
  data-sup-min={String(MIN)}
  data-sup-max={String(MAX)}
  data-sup-goal={String(GOAL)}
  data-sup-pre={String(PRESELECT)}
  data-sup-tpl={T.cta}
  set:html={`(function(){
var s=document.currentScript;
var base=s.getAttribute('data-sup-base'),min=+s.getAttribute('data-sup-min'),
    max=+s.getAttribute('data-sup-max'),goal=+s.getAttribute('data-sup-goal'),
    pre=s.getAttribute('data-sup-pre'),tpl=s.getAttribute('data-sup-tpl');
var cta=document.getElementById('supCta'),txt=document.getElementById('supCtaTxt'),
    pp=document.getElementById('supPp'),
    free=document.getElementById('supFree'),err=document.getElementById('supErr'),
    radios=document.querySelectorAll('input[name="sup-amount"]');
if(!cta||!txt||!free||!err)return;
/* Auf ganze Cent runden und schlicht ausgeben: PayPal.me nimmt 1, 5 oder 12.5 —
   aber kein Komma und keine Exponentialschreibweise. */
function fmt(n){return (Math.round(n*100)/100).toString()}
function apply(n,bad){
  if(bad){err.hidden=false;cta.setAttribute('aria-disabled','true');return}
  err.hidden=true;cta.removeAttribute('aria-disabled');
  /* Cent als GANZE Zahl. Math.round auf das Produkt, nicht auf den Bruch:
     12.35*100 ist in Gleitkomma 1234.9999999999998, und ein Betrag, den die
     Function als nicht-ganzzahlig ablehnt, waere hier kaum zu finden. */
  cta.setAttribute('data-cents',String(Math.round(n*100)));
  if(pp)pp.href=base+'/'+fmt(n)+'EUR';
  txt.textContent=tpl.replace('%s',fmt(n));
}
for(var i=0;i<radios.length;i++){
  radios[i].addEventListener('change',function(e){free.value='';apply(+e.target.value,false)});
}
free.addEventListener('input',function(){
  var raw=free.value.trim();
  if(raw===''){
    /* Leeren muss IMMER in einen gueltigen Zustand zurueckfuehren. Sonst bleibt
       der Knopf nach einer ungueltigen Eingabe dauerhaft gesperrt — im Browser
       gemessen: nach "abc" und anschliessendem Leeren blieb die Sperre stehen,
       weil zu diesem Zeitpunkt KEINE Stufe mehr angehakt war. */
    var c=document.querySelector('input[name="sup-amount"]:checked');
    if(!c){c=document.querySelector('input[name="sup-amount"][value="'+pre+'"]');if(c)c.checked=true}
    apply(c?+c.value:+pre,false);
    return;
  }
  var n=parseFloat(raw.replace(',','.'));
  if(!isFinite(n)||n<min||n>max){apply(0,true);return}
  for(var j=0;j<radios.length;j++)radios[j].checked=false;
  apply(n,false);
});})()`}
/>

{/* Hauptweg: Bezahlseite holen und hingehen. Plus die Rueckkehr von dort.

    WARUM location.href UND KEIN FORMULAR: ein POST an Stripe fiele unter die
    form-action-Direktive der CSP und wuerde still blockiert. Eine Weiterleitung
    der obersten Ebene faellt unter GAR KEINE Direktive — deshalb kostet dieser
    Weg keinen einzigen neuen CSP-Eintrag (mit `npm run audit:csp` geprueft).

    WARUM DER apikey-KOPF: `verify_jwt = false` schaltet die SITZUNGSpruefung ab,
    nicht das Gateway. Ohne diesen Kopf antwortet Supabase mit 401, bevor die
    Function ueberhaupt laeuft. Der Schluessel ist der oeffentliche — er steht
    ohnehin in jeder Seite, geschuetzt wird nicht durch ihn, sondern durch die
    Betragsklemme in der Function. */}
<script
  is:inline
  data-pay-url={CHECKOUT}
  data-pay-key={SUPABASE.publishableKey}
  data-pay-lang={lang}
  data-pay-busy={T.ctaBusy}
  set:html={`(function(){
var s=document.currentScript;
var EP=s.getAttribute('data-pay-url'),KEY=s.getAttribute('data-pay-key'),
    LANG=s.getAttribute('data-pay-lang'),BUSY=s.getAttribute('data-pay-busy');
var cta=document.getElementById('supCta'),txt=document.getElementById('supCtaTxt'),
    perr=document.getElementById('supPayErr'),thanks=document.getElementById('supThanks');

/* --- Rueckkehr von der Bezahlseite ------------------------------------------
   Der Parameter wird nach dem Einblenden aus der Adresse GENOMMEN. Sonst steht
   er im Lesezeichen, im Verlauf und im Verweis-Kopf jedes Weiterklicks — und
   ein simples Neuladen zeigte die Bestaetigung ein zweites Mal, obwohl nichts
   Zweites passiert ist. */
if(thanks&&/(^|[?&])danke=1(&|$)/.test(location.search)){
  thanks.hidden=false;
  if(history.replaceState)history.replaceState(null,'',location.pathname);
}

if(!cta||!txt||!perr)return;

var idle=txt.textContent;
function reset(){
  cta.removeAttribute('data-busy');cta.removeAttribute('aria-busy');
  txt.textContent=idle;
}
function fail(){reset();perr.hidden=false}

/* Kommt jemand mit dem Zurueck-Knopf von Stripe wieder her, liefert der Browser
   die Seite aus dem Vor-/Zurueck-Speicher — MIT dem Wartezustand von vorhin.
   Der Knopf waere dann dauerhaft blass und nicht anklickbar. */
addEventListener('pageshow',function(e){if(e.persisted)reset()});

cta.addEventListener('click',function(){
  if(cta.getAttribute('aria-disabled')==='true')return;
  if(cta.hasAttribute('data-busy'))return;
  var cents=parseInt(cta.getAttribute('data-cents'),10);
  if(!isFinite(cents)||cents<=0){perr.hidden=false;return}

  perr.hidden=true;
  idle=txt.textContent;
  cta.setAttribute('data-busy','1');cta.setAttribute('aria-busy','true');
  txt.textContent=BUSY;

  fetch(EP,{
    method:'POST',
    headers:{'Content-Type':'application/json',apikey:KEY,Authorization:'Bearer '+KEY},
    body:JSON.stringify({amount_cents:cents,lang:LANG})
  })
    /* r.json() steht bewusst INNERHALB der Kette: antwortet das Gateway mit
       einer HTML-Fehlerseite, wirft es hier und landet im catch — statt weiter
       unten an einem undefined zu scheitern. */
    .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j}})})
    .then(function(res){
      if(res.ok&&res.j&&typeof res.j.url==='string'&&res.j.url.indexOf('https://')===0){
        /* Kein Aufraeumen danach: die Seite verlaesst uns gerade. Bliebe der
           Knopf hier stehen, waere das der einzige Moment, in dem er wieder
           anklickbar aussieht, waehrend die Weiterleitung schon laeuft. */
        location.href=res.j.url;
        return;
      }
      fail();
    })
    .catch(fail);
});
})()`}
/>

{/* Stand der Sammlung: lesen (jeder) und setzen (nur Admins).
    Bewusst OHNE supabase-js — die Bibliothek wiegt ~37 KB und wird nur auf den
    /account/-Seiten gebundelt. Gelesen wird mit dem oeffentlichen Schluessel
    per einfachem fetch, geschrieben ueber window.VBAccount aus
    assets/account-lite.js, das SiteNav ohnehin auf jeder Seite laedt (dort
    liegen Session-Refresh und Sperre bereits — zwei Wahrheiten waeren ein Bug).
    Die is-admin-Klasse blendet das Feld nur EIN; verhindern tut den Schreib-
    zugriff die RLS-Regel auf der Tabelle. */}
<script
  is:inline
  data-sp-url={SUPABASE.url}
  data-sp-key={SUPABASE.publishableKey}
  data-sp-slug={PROGRESS_SLUG}
  data-sp-loc={lang === 'de' ? 'de-DE' : 'en-GB'}
  data-sp-ok={T.adminOk}
  data-sp-range={T.adminErrRange}
  data-sp-auth={T.adminErrAuth}
  data-sp-net={T.adminErrNet}
  data-sp-split={T.adminSplit}
  set:html={`(function(){
var s=document.currentScript;
var URL_=s.getAttribute('data-sp-url'),KEY=s.getAttribute('data-sp-key'),
    SLUG=s.getAttribute('data-sp-slug'),LOC=s.getAttribute('data-sp-loc'),
    M_OK=s.getAttribute('data-sp-ok'),M_RANGE=s.getAttribute('data-sp-range'),
    M_AUTH=s.getAttribute('data-sp-auth'),M_NET=s.getAttribute('data-sp-net'),
    SPLIT=s.getAttribute('data-sp-split');
var box=document.getElementById('supGauge'),read=document.getElementById('supRead'),
    fill=document.getElementById('supFill'),scale=document.getElementById('supScale'),
    admin=document.getElementById('supAdmin'),
    inp=document.getElementById('supNew'),btn=document.getElementById('supSave'),
    msg=document.getElementById('supMsg'),split=document.getElementById('supSplit');
if(!box||!read||!fill)return;
var REST=URL_+'/rest/v1/support_progress?slug=eq.'+encodeURIComponent(SLUG);
var goalC=0;

function eur(c){return (c/100).toLocaleString(LOC,{minimumFractionDigits:(c%100?2:0),maximumFractionDigits:2})+' \\u20ac'}
function say(text,bad){if(!msg)return;msg.textContent=text;msg.hidden=false;
  if(bad)msg.classList.add('is-bad');else msg.classList.remove('is-bad')}

function paint(row){
  goalC=row.goal_cents;
  /* ZWEI Quellen, eine Zahl nach aussen:
       stripe_cents — gezaehlt, vom signaturgeprueften Webhook ueber den Trigger
       raised_cents — eingetragen, fuer die PayPal-Eingaenge
     Getrennt gespeichert, damit jederzeit erkennbar bleibt, welcher Teil
     gemessen und welcher getippt ist. Zusammengezaehlt wird erst hier. */
  var manual=+row.raised_cents||0,auto=+row.stripe_cents||0,r=manual+auto;
  var pct=Math.max(0,Math.min(100,(r/row.goal_cents)*100));
  read.textContent=eur(r)+' / '+eur(row.goal_cents);
  fill.style.width=pct+'%';
  /* Teilung in Vierteln, aus dem Ziel abgeleitet statt fest verdrahtet —
     aendert sich das Ziel, stimmt die Beschriftung weiter. */
  if(scale){scale.innerHTML='';
    for(var i=0;i<=4;i++){var sp=document.createElement('span');
      sp.textContent=Math.round(row.goal_cents/100*i/4);scale.appendChild(sp)}}
  box.hidden=false;
  /* Das Eingabefeld traegt den HANDGEPFLEGTEN Teil, NICHT die Summe. Stuende
     die Summe darin, wuerde der naechste Speichervorgang den bereits
     gezaehlten Stripe-Anteil ein zweites Mal als PayPal-Eingang eintragen —
     und der Stand liefe mit jedem Speichern weiter auseinander. */
  if(inp)inp.value=(manual/100).toFixed(2).replace('.',',');
  if(split){
    split.textContent=SPLIT.replace('%s',eur(auto)).replace('%s',eur(manual));
    split.hidden=false;
  }
}

/* Lesen: oeffentlich, ohne Session. Schlaegt es fehl, bleibt der Abschnitt
   verborgen — kein leerer Balken, der einen Stand von null behauptet. */
fetch(REST+'&select=goal_cents,raised_cents,stripe_cents,updated_at&limit=1',
  {headers:{apikey:KEY,Authorization:'Bearer '+KEY}})
  .then(function(r){return r.ok?r.json():null})
  .then(function(rows){if(rows&&rows[0])paint(rows[0])})
  .catch(function(){/* verborgen lassen */});

/* Admin-Feld einblenden, sobald die Rolle feststeht. account-lite setzt die
   Klasse ggf. erst nach dem Laden der echten Rolle, deshalb zusaetzlich am
   Ereignis haengen statt nur einmal zu pruefen. */
function syncAdmin(){
  if(!admin)return;
  /* SYMMETRISCH. Die fruehere Fassung konnte nur EINblenden, nie wieder aus.
     Der Weg dahin: Layout.astro setzt is-admin schon im <head> aus dem
     Rollen-ZWISCHENSPEICHER (sessionStorage vb_user_role), damit nichts
     aufblitzt. Ist der Speicher veraltet — Rolle entzogen, fremdes Geraet,
     abgelaufene Sitzung — steht die Klasse zunaechst faelschlich da, das Feld
     erschien, und wenn account-lite.js kurz darauf die ECHTE Rolle holte und
     die Klasse per classList.toggle wieder abraeumte, blieb das Feld stehen.
     Geschrieben haette dieser Nutzer nichts (die RLS-Regel auf der Tabelle
     laesst nur Admins durch, gegen die lebende Anlage geprueft) — aber sichtbar
     war es, und genau das soll es nicht sein. */
  admin.hidden=!document.documentElement.classList.contains('is-admin');
}
syncAdmin();
addEventListener('vb-account-ready',syncAdmin);
setTimeout(syncAdmin,1500);

if(btn&&inp){btn.addEventListener('click',function(){
  var raw=inp.value.trim().replace(/\\s|\\u20ac/g,'').replace(',','.');
  var v=parseFloat(raw);
  /* goalC steht in CENT, v in Euro — deshalb v*100 gegen goalC und nicht gegen
     goalC*100. Die frueher hier stehende Fassung verglich Cent mit Cent mal
     hundert und liess damit das Hundertfache des Ziels durch: bei einem Ziel
     von 120 € waere ein vertippter Eintrag ueber 12.000 € anstandslos
     gespeichert worden, obwohl die Meldung daneben „zwischen 0 € und dem Ziel"
     verspricht. Der Zweck der Grenze ist genau dieser Tippfehler. */
  if(!isFinite(v)||v<0||(goalC&&v*100>goalC)){say(M_RANGE,true);return}
  var cents=Math.round(v*100);
  if(!window.VBAccount){say(M_AUTH,true);return}
  btn.disabled=true;
  window.VBAccount.session().then(function(sess){
    if(!sess){say(M_AUTH,true);btn.disabled=false;return}
    return window.VBAccount.rest(sess,'PATCH',
      'support_progress?slug=eq.'+encodeURIComponent(SLUG),
      {raised_cents:cents},'return=representation')
      .then(function(r){
        btn.disabled=false;
        if(!r.ok){say(r.status===401||r.status===403?M_AUTH:M_NET,true);return}
        return r.json().then(function(rows){
          /* NICHT auf r.ok vertrauen: filtert die Zugriffsregel den Schreib-
             versuch auf null Zeilen, antwortet PostgREST mit 200 und einer
             LEEREN Liste — der Aufruf ist formal gelungen, gespeichert wurde
             nichts. Gemessen: ein anonymer PATCH auf diese Tabelle liefert
             genau das. Ohne diese Pruefung meldete die Seite „Gespeichert.",
             waehrend der Wert unveraendert blieb. */
          if(!rows||!rows[0]){say(M_AUTH,true);return}
          paint(rows[0]);
          say(M_OK,false);
        });
      });
  }).catch(function(){btn.disabled=false;say(M_NET,true)});
});}
})()`}
/>
