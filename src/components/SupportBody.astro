/** „Pos 01“ / „Item 01“ — zweistellig wie auf einem Auftragsblatt. */
const posN = (i: number) => `${T.pos} ${String(i).padStart(2, '0')}`;

const ctaInitial = T.cta.replace('%s', String(PRESELECT));

/**
 * Geldbetrag in der Schreibweise der jeweiligen Sprache: im Deutschen steht das
 * Eurozeichen hinter der Zahl, im Englischen davor. Die Betragsknoepfe hatten
 * bis zum 07.08.2026 fest `{v} €` — auf der englischen Seite standen deshalb
 * "3 €", "5 €" neben einem Knopf, der "Support with €5" sagte. Dieselbe Regel
 * gilt in `eur()` im Seitenskript weiter unten.
 */
const money = (n: number) => (lang === 'de' ? `${n} €` : `€${n}`);
---
<style is:inline>
/* Instandsetzung — warme Werkstatt-Palette. Gold ist die EINE Akzentfarbe; sie
   markiert ausschliesslich den Befund (Zeichnung, Titel, Zustand) und die
   Behebung (Anzeige, Knopf). Positionsnummern bleiben bewusst grau: sie sind
   Gliederung, kein Hinweis. */
:root{--bg:#0d0a06;--bg-2:#14100a;--surface:#191309;--surface-2:#221a0e;--accent:#e8a83c;--accent-2:#ffcf7a;--hot:#e8a83c;--text:#f2ece1;--muted:#ab9d88;--line:rgba(232,168,60,.22);--line-soft:rgba(242,236,225,.10);--ink:#1a1004;--maxw:1180px;}
/* ⚠⚠ GEMESSEN 30.08.2026: die Schrift-Token stehen weiter unten auf `.sup`
   — also NUR innerhalb des Seitenkoerpers. Alles daneben erbt sie nicht,
   und das ist hier die Fusszeile: die sechs Verweise und die Zeile
   "VerseBase · a Star Citizen fan project" liefen auf generisches
   sans-serif, der Rechtshinweis darunter auf Times New Roman. Auf einer
   Seite, auf der um Geld gebeten wird, ist das die falsche Stelle fuer
   einen Bruch. Die Token gehoeren deshalb zusaetzlich an die Wurzel.
   Dieselbe Ursache wie auf /impressum und /datenschutz (dort im
   Kontaktbogen als Times-Seite aufgefallen). */
:root{--font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace}
body{font-family:var(--font-body)}

/* SCHRIFTEN. Am 03.08.2026 im Browser gemessen und es war schlecht: diese Seite
   lud als EINZIGE Signaturseite kein `assets/detail.css`, und dort stehen die
   Schrift-Token der Site. Die Folge war nicht "leicht anders", sondern:
     --font-ui  war NICHT GESETZT -> generisches sans statt Rajdhani
     der Fliesstext hatte gar keine Angabe -> "Times New Roman"
   Times auf fast schwarzem Grund ist duenn, kontrastreich im Strich und
   flimmert — genau die Ermuedung, die gemeldet wurde. Zum Vergleich auf
   /de/feedback.html gemessen: dort Barlow, hier Times.

   Die Token stehen ABSICHTLICH hier und nicht via detail.css: jenes Blatt
   bringt Hero-, Band- und Abschnittsregeln plus eine Rasterschicht ueber
   `body::after` mit, die mit dem eigenstaendigen Werkstatt-Aufbau kollidieren.
   Gebraucht werden nur die drei Zeilen. Sie sind woertlich aus detail.css
   uebernommen — laufen sie auseinander, faellt diese Seite wieder aus der Reihe.

   Bewusst auf .sup statt auf :root: die Farbtoken-Zeile darueber traegt nur
   Farben. Eigenschaften vererben sich ohnehin nach unten. */
.sup{--font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;font-family:var(--font-body);-webkit-font-smoothing:antialiased}

/* box-sizing ist hier NICHT vorsorglich: die Seite setzt keinen globalen Reset,
   und bei 360 px ragten dadurch die Auftragsfelder auf 422 px und der Knopf auf
   369 px hinaus — `width:100%` plus Innenabstand ergibt mehr als die Spalte.
   Sichtbar war davon NICHTS: theme.css versteckt jede Bildlaufleiste und
   Layout.astro setzt `overflow-x:clip`, der Ueberlauf wird also stillschweigend
   abgeschnitten. Im Browser bei 360 px gemessen. */
.sup,.sup *{box-sizing:border-box}
.sup{max-width:var(--maxw);margin:0 auto}
.sup .cap{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-3);letter-spacing:var(--ls-17);text-transform:uppercase;color:var(--muted)}
.sup .num{font-variant-numeric:tabular-nums;font-family:var(--font-mono,'Share Tech Mono',monospace)}

/* --- Auftragskopf --------------------------------------------------------- */
/* Randloses Band wie auf jeder anderen Seite der Site.
   Vorher lag der Auftragskopf samt Hintergrund IN der 1180-px-Spalte. Auf
   einem breiten Bildschirm stand die Seite damit als Kasten im Schwarzen,
   waehrend jede andere Seite mit einem Element ueber die volle Fensterbreite
   oeffnet (`.hero`/`.band` in assets/detail.css, Inhalt innen auf --maxw).
   Gemessen auf 1912 px: kein einziges randloses Element auf dieser Seite.

   Umgesetzt ueber ein Pseudoelement statt ueber Aufbrechen des Markups: nur
   der HINTERGRUND wandert nach aussen, Titel und Auftragsfelder bleiben, wo
   sie sind. Damit aendert sich keine Zeile Layout und kein Umbruch.
   `left:50%` + `translateX(-50%)` + `100vw` ist die Site-uebliche Loesung;
   Bildlaufleisten sind site-weit ausgeblendet, 100vw entspricht hier also der
   Fensterbreite (nachgemessen: scrollWidth == innerWidth, kein Ueberlauf). */
.sup__head{position:relative}
.sup__head::before{content:'';position:absolute;top:0;bottom:0;left:50%;transform:translateX(-50%);width:100vw;
  background:linear-gradient(180deg,var(--bg-2),var(--bg));border-bottom:1px solid var(--line);z-index:0}
.sup__head > *{position:relative;z-index:1}
/* Die Kopfleiste der Seite ist `position:fixed` und 62 px hoch. Ohne diesen
   Abstand liegt der Titel 32 px DAHINTER — im Browser auf staging gemessen,
   "Instandsetzung" war zur Haelfte verdeckt. Die Hero-Seiten der Site loesen
   dasselbe mit padding-top: 6.2rem bzw. 4.4rem unter 700 px. */
.sup__headtop{padding:clamp(4.6rem,7vw,6rem) clamp(16px,4vw,40px) 18px}
.sup__ttl{font-family:var(--font-display,sans-serif);font-weight:700;font-size:clamp(1.5rem,4.6vw,2.3rem);line-height:1.05;letter-spacing:var(--ls-4);color:var(--text);margin:0}
.sup__ttl em{font-style:normal;color:var(--accent)}
/* Einleitung unter dem Titel (zweiter Durchgang 08.11.2026): sagt in einem
   Satz, was die Seite will, bevor die Felder kommen. Textfarbe statt
   --muted — es ist der erste Satz, den Neue lesen. */
.sup__lead{margin:14px 0 0;max-width:60ch;font-size:var(--fs-11);line-height:1.55;color:var(--text)}
/* Sprung zum Bezahlweg — nur schmal (siehe Markup), breit steht er daneben. */
.sup__jump{display:none;align-items:center;gap:8px;min-height:44px;margin-top:16px;padding:0 16px;border:1px solid var(--line);color:var(--accent);font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-7);letter-spacing:var(--ls-10);text-transform:uppercase;text-decoration:none}
.sup__jump:hover{border-color:var(--accent)}
.sup__jump:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
/* Ziel des Sprungs. mobile-ux.css setzt den Abstand unter der Kopfleiste nur
   bis 820 px, der Sprung ist bis 860 px sichtbar. */
#beitrag{scroll-margin-top:calc(var(--nav-h,68px) + .8rem)}
/* minmax(0,1fr) statt 1fr: `1fr` ist `minmax(auto,1fr)`, die Zelle kann also
   nicht unter ihre Inhaltsbreite schrumpfen. Bei 360 px blieben die Zellen
   deshalb 206 px breit — zusammen 413 px — und „Kostenrahmen 120,00 EUR" wurde
   rechts abgeschnitten, unsichtbar, weil overflow-x:clip greift. Gemessen. */
.sup__fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line-soft);margin:0}
/* `overflow-wrap:anywhere` ist die NOTBREMSE gegen waagerechten Ueberlauf und
   bleibt. Allein war sie aber zu grob: sie trennt an beliebiger Stelle, und am
   03.08.2026 stand auf staging bei 958 px Fensterbreite „Entwicklungsrechn /
   er" im Feld GERAET — ein Bruch mitten in der Silbe, der wie ein Defekt
   aussieht.
   Gemessen: das Wort braucht 159 px, seine Zelle bot 158. Es fehlte EIN Pixel.
   Und ausgerechnet die erste Zelle ist die engste, weil sie den grossen
   Aussenabstand der Seite traegt (bis 40 px) statt der 18 px der Folgezellen —
   das laesst sich nicht wegnehmen, ohne den Anschluss an den Titel zu
   verlieren.
   `hyphens:auto` loest das an der richtigen Stelle: der Browser trennt nach den
   Regeln der Seitensprache (`lang` steht am <html>), also „Entwicklungs-“ /
   „rechner“. Die Notbremse greift erst, wenn auch das nicht mehr reicht. */
.sup__fields dt,.sup__fields dd{overflow-wrap:anywhere;hyphens:auto}
.sup__fields>div{padding:12px clamp(16px,4vw,40px) 14px;border-right:1px solid var(--line-soft)}
.sup__fields>div:last-child{border-right:0}
.sup__fields>div:not(:first-child){padding-left:18px}
.sup__fields dt{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-2);letter-spacing:var(--ls-16);text-transform:uppercase;color:var(--muted)}
.sup__fields dd{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-7);letter-spacing:var(--ls-8);color:var(--text);margin:4px 0 0;font-variant-numeric:tabular-nums}
.sup__fields dd.hi{color:var(--accent)}

/* --- Koerper: Zeichnung als Grund, Auftrag oben rechts -------------------- */
/* Umbau 03.08.2026. Vorher standen Zeichnung und Text als zwei gleichberechtigte
   Spalten nebeneinander, und der Auftrag lag ganz unten in der rechten Spalte —
   man musste erst an drei Textbloecken vorbei, bevor ueberhaupt ein Knopf zu
   sehen war. Jetzt:
     * die Zeichnung liegt gross und blass HINTER allem (Wasserzeichen),
     * der Auftrag steht oben rechts und bleibt beim Lesen stehen,
     * der Text laeuft links daneben.

   `isolation:isolate` statt blossem z-index: das haelt die Stapelung in diesem
   Kasten. Ohne das kann ein spaeteres `position`-Element weiter unten auf der
   Seite unter den Hintergrund rutschen. */
.sup__body{position:relative;isolation:isolate;padding:0;background:linear-gradient(90deg,var(--line-soft) 0 1px,transparent 1px 100%) 0 0/32px 32px,linear-gradient(0deg,var(--line-soft) 0 1px,transparent 1px 100%) 0 0/32px 32px,var(--bg)}
/* Eckklammern wie auf einem Zeichnungsblatt — jetzt um das ganze Blatt */
.sup__body::before{content:"";position:absolute;inset:14px;pointer-events:none;z-index:1;background:linear-gradient(var(--line) 0 0) 0 0/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 0 0/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 100% 0/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 100% 0/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 0 100%/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 0 100%/1px 18px no-repeat,linear-gradient(var(--line) 0 0) 100% 100%/18px 1px no-repeat,linear-gradient(var(--line) 0 0) 100% 100%/1px 18px no-repeat}

/* DIE ZEICHNUNG ALS GRUND.
   `height:100%;width:auto` statt beides auf 100%: das Seitenverhaeltnis muss
   erhalten bleiben, sonst wird aus dem runden Luefter ein Ei. Sie sitzt links
   und laeuft oben wie unten aus dem Kasten heraus — angeschnitten wirkt sie
   gross, vollstaendig eingepasst wirkt sie nur klein und mittig.
   Die Deckkraft ist der ganze Trick: bei .14 sind die Striche noch als Technik
   lesbar, aber der Text darueber steht bei gemessenen 16,8:1 — die Zeichnung
   nimmt ihm nichts. Ein Wasserzeichen mit mehr Deckkraft haette genau den
   Vorwurf zurueckgeholt, den diese Seite gerade erst losgeworden ist. */
/* Der Grund laeuft ueber die volle FENSTERbreite, nicht nur im Kasten.
   Bis zum 07.08.2026 stand hier `inset:0` — der Grund war damit auf die
   1180-px-Spalte begrenzt und konnte den Bereich daneben gar nicht erreichen.
   Zusammen mit der Deckkraft .15 blieb links schlicht nichts: die Zeichnung,
   die vor dem Umbau eine sichtbare eigene Spalte war, verschwand im Kasten,
   und um den Kasten herum war leere Flaeche. Genau das ist als "kaputt"
   aufgefallen.
   Jetzt ankert sie am linken FENSTERrand (justify-content:flex-start bei
   100vw) und traegt den Rand mit, so wie es der Umbau vorhatte. */
.sup__bg{position:absolute;top:0;bottom:0;left:50%;transform:translateX(-50%);width:100vw;overflow:hidden;pointer-events:none;z-index:0;display:flex;justify-content:flex-start;align-items:center}
/* Grundfall (bis 1400 px): unveraendert Wasserzeichen HINTER dem Inhalt —
   dort gibt es keinen freien Rand, und ein kraeftigerer Grund wuerde nur den
   Text stoeren. */
.sup__bg .sup__sch{height:152%;width:auto;max-width:none;flex:none;margin-left:clamp(-190px,-9vw,-60px);opacity:.15}

/* Ab 1400 px liegt neben dem 1180-px-Kasten ein Rand von mindestens 110 px
   frei — und genau der war das Problem: die Zeichnung stand bis zum
   07.08.2026 mit `inset:0` INNERHALB des Kastens und konnte ihn gar nicht
   erreichen. Die Seite war ein Viereck in der Mitte, drumherum nichts.

   Hier ruecht sie deshalb ganz in den Rand: `right: calc(50% + 560px)` setzt
   ihre rechte Kante 30 px unter die linke Kastenkante (der Kasten ist
   1180 px breit, seine linke Kante liegt also 590 px links der Mitte).
   Damit steht sie neben dem Text statt darunter — und darf kraeftiger sein.

   Deckkraft: .15 sind gemessen 1,22:1 gegen den Seitengrund, fuer
   1-bis-1,7-px-Linien schlicht unsichtbar. Das war der eigentliche Fehler des
   Umbaus vom 04.08.: gewollt war ein Wasserzeichen, entstanden ist eine leere
   Flaeche. .3 liegt bei 1,66:1 (Linien) bzw. 1,82:1 (die goldene
   Fehlerstelle) — als Struktur erkennbar, ohne Anspruch auf Lesbarkeit. */
@media (min-width:1800px){
  /* Ab hier ist der Rand neben dem 1180-px-Kasten mindestens 310 px breit —
     genug fuer die GANZE Zeichnung in lesbarer Groesse.

     Die Schwelle lag zuerst bei 1600 px. Nachgemessen und verworfen: dort ist
     der Rand 210 px, die Zeichnung waere auf 170 px geschrumpft und ihre
     Beschriftungen auf gut 4 px — das ist keine Zeichnung mehr, sondern
     Grieß. Lieber erst dann, wenn Platz dafuer da ist; darunter bleibt das
     alte Wasserzeichen. Sie wird dort wieder das, was sie vor dem
     Umbau vom 04.08. war: eine lesbare Werkstattskizze neben dem Auftrag.

     Der erste Versuch (07.08.) hat sie nur nach links geschoben und am
     Fensterrand abgeschnitten. Im Browser angesehen und verworfen: sichtbar
     waren ein Rechteck, ein Bogen und ein halber Zylinder — Bruchstuecke, die
     wie Schutt aussehen, nicht wie eine Zeichnung. Sichtbarkeit allein
     genuegt nicht, die Figur muss ganz sein.

     `width` statt `height`: die Breite ist hier die knappe Groesse (der Rand),
     die Hoehe ist reichlich. 400:640 aus der viewBox liefert die Hoehe.

     Die Beschriftungen kommen mit zurueck. Sie waren am 04.08. abgeschaltet
     worden, weil sie als Grund HINTER den Absaetzen landeten — zwei
     Schriftsaetze uebereinander. Neben dem Text stellt sich die Frage nicht
     mehr, und ohne sie ist es keine technische Zeichnung, sondern Dekor. */
  /* Die Zeichnung bekommt eine EIGENE SPALTE statt eines Randplatzes.
     Vorher stand sie im Aussenrand neben dem 1180-px-Kasten: 314 px breit, und
     der Auftragstext lag dadurch bei 1920 px Fensterbreite mit seiner Mitte auf
     736 px — 224 px links der Bildschirmmitte. Die Seite sah aus, als waere sie
     nach links gerutscht, und rechts stand 370 px leerer Rand.

     Jetzt ist das Blatt selbst breiter (bis 1720 px) und traegt drei Spalten:
     Zeichnung | Text | Auftrag. Die beiden AUSSEREN sind absichtlich exakt
     gleich breit (minmax(320px,400px)) — dadurch liegt die Mittelspalte
     rechnerisch genau auf der Fenstermitte, ohne dass irgendwo ein fester
     Versatz eingetragen werden muesste. Bei 1920 px: Text 588–1332, Mitte 960.

     Die Zeichnung darf mit der Spalte auf 400 px wachsen (+27 %); ihre
     Beschriftungen wachsen mit, was der eigentliche Punkt ist — bei 314 px
     waren sie an der Lesbarkeitsgrenze. */
  .sup{--maxw:min(1720px,calc(100vw - 160px))}
  /* Ueberall eine Stufe hoeher ueber den Elternknoten: die Grundregeln fuer
     Raster und Spaltenzuweisung stehen WEITER UNTEN in der Datei und gewaennen
     bei gleicher Spezifitaet — Medienabfragen erhoehen sie nicht. Derselbe
     Stolperstein wie bei den Beschriftungen ein paar Zeilen tiefer. Ohne den
     Vorsatz blieb die Mittelspalte 0 px breit und der Auftrag lief in eine
     stillschweigend erzeugte vierte Spalte. */
  .sup .sup__grid{grid-template-columns:minmax(320px,400px) minmax(0,1fr) minmax(320px,400px)}
  .sup .sup__order{grid-area:1/2}
  .sup .sup__aside{grid-area:1/3}
  .sup .sup__past{grid-area:2/2}
  .sup__bg{display:block}
  /* Sie bleibt absolut im 100vw-Grund liegen (sonst muesste das Markup eine
     leere Spalte tragen) und wird ueber die Blattkante auf die reservierte
     Spalte gerechnet: linke Blattkante + Innenabstand des Rasters. */
  /* Unten verankert statt mittig (zweiter Durchgang 08.11.2026): die
     Zeichnung gehoert zum Rueckblick (Pos 04) am Seitenende, nicht neben
     „Kostenlos helfen". */
  .sup__bg .sup__sch{position:absolute;top:auto;bottom:clamp(40px,3vw,64px);transform:none;
    left:calc((100vw - var(--maxw))/2 + clamp(16px,4vw,40px));
    width:clamp(300px,21vw,400px);height:auto;margin:0;opacity:.62}
  /* `.sup__bg .sup__sch text{display:none}` steht weiter unten in der Datei und
     haette bei gleicher Spezifitaet gewonnen — Medienabfragen erhoehen sie
     nicht. Deshalb hier eine Stufe hoeher ueber den Elternknoten. */
  .sup__body .sup__bg .sup__sch text,.sup__body .sup__bg .sup__sch .ld{display:initial}
}
.sup__sch{display:block}
/* DIE BESCHRIFTUNGEN DER ZEICHNUNG SIND IM GRUND AUS.
   Im Browser angesehen, nachdem der Umbau stand: „GEHÄUSE", „LÜFTER 80 MM",
   „OHNE WARNUNG" und „PLATINE" landeten mitten in den Absaetzen von Pos 01 und
   Pos 02 — zwei Schriftsaetze uebereinander, von denen einer nicht gelesen
   werden soll. Genau das war die Beanstandung.
   Weggenommen wird nur die SCHRIFT. Die golden gestrichelte Umrandung der
   Kondensatorbank bleibt: sie zeigt die Fehlerstelle als Geometrie, ohne ein
   zweites Wort auf die Seite zu bringen. Und die Fuehrungslinien, die nun ins
   Leere zeigten, gehen mit. */
.sup__bg .sup__sch text,.sup__bg .sup__sch .ld{display:none}

/* Raster: Text links, Auftrag rechts. Die Zuweisung steht ausdruecklich da,
   weil der Auftrag im Quelltext ZUERST kommt (siehe Kommentar am Markup) — ohne
   die Angabe landete er links. */
.sup__grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,400px);gap:0 clamp(20px,3vw,48px);align-items:start;padding:36px clamp(16px,4vw,40px) 40px}
.sup__order{grid-area:1/1}
/* `stretch`: die Spalte muss so hoch sein wie Pos 01–03 daneben, sonst hat
   der klebende Kasten darin keinen Weg und bleibt oben stehen. Er laeuft so
   bis zum Ende von Pos 03 mit und bleibt vor dem Rueckblick stehen. */
.sup__aside{grid-area:1/2;align-self:stretch}
.sup__past{grid-area:2/1}
.sup__sticky{position:sticky;top:5.2rem}
.sup__sch .o{fill:none;stroke:var(--muted);stroke-width:1.7;vector-effect:non-scaling-stroke}
.sup__sch .t{fill:none;stroke:var(--line);stroke-width:1;vector-effect:non-scaling-stroke}
.sup__sch .c{fill:none;stroke:var(--muted);stroke-width:1;stroke-dasharray:14 4 3 4;opacity:.45;vector-effect:non-scaling-stroke}
.sup__sch .d{fill:none;stroke:var(--muted);stroke-width:1;opacity:.7;vector-effect:non-scaling-stroke}
.sup__sch .ar{fill:var(--muted);opacity:.7;stroke:none}
.sup__sch .hot{fill:none;stroke:var(--accent);stroke-width:1.7;stroke-dasharray:7 4;vector-effect:non-scaling-stroke}
.sup__sch .ld{fill:none;stroke:var(--accent);stroke-width:1;vector-effect:non-scaling-stroke}
.sup__sch .dot{fill:var(--line);stroke:none}
.sup__sch text{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-2);letter-spacing:var(--ls-11);fill:var(--muted)}
.sup__sch text.hi{fill:var(--accent)}
.sup__sch g{stroke-linecap:butt;stroke-linejoin:miter}

/* --- Positionen ----------------------------------------------------------- */
/* Der Innenabstand sitzt am Raster, nicht an dieser Spalte.
   „Verteilt" heisst hier: die Positionen stehen bewusst weit auseinander,
   damit die Zeichnung im Grund zwischen ihnen durchkommt. Vorher waren es
   20 px und die Bloecke lasen sich als ein einziger Textklumpen, der die
   Zeichnung von oben bis unten zudeckte. */
.sup__order{padding:0}
/* Spaltenbreite aus dem Inhalt statt fester 3.4rem: „POS 01" passte, das
   englische „ITEM 01" brach in zwei Zeilen um. Im Browser gesehen. `auto` misst
   die laengste Marke der Seite, also je Sprache richtig. */
.sup__pos{border-top:1px solid var(--line-soft);padding:clamp(26px,4.5vw,52px) 0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:0 18px}
.sup__pos:first-of-type{border-top:0;padding-top:0}
.sup__pos:last-of-type{padding-bottom:0}
.sup__pos-n{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-5);letter-spacing:var(--ls-12);color:var(--muted);padding-top:4px;text-transform:uppercase;white-space:nowrap}
/* fs-10 statt fs-6 (14,4 px) seit dem zweiten Durchgang: die Positionen sind
   jetzt die Abschnitte der Seite, und ihre Ueberschrift muss die Gliederung
   tragen — auf dem Handy war sie kleiner als der Fliesstext darunter. */
.sup__pos h2{font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-10);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--text);margin:0 0 10px}
/* Der Fliesstext stand in var(--muted) — also in der Farbe, die auf dieser
   Seite sonst BESCHRIFTUNGEN traegt (Feldnamen, Skala, Positionsnummern).
   Gemessen: 7,44:1 gegen 12,8:1 fuer var(--text). Das besteht die Norm, aber es
   ist die gedaempfte Stufe, und der laengste Lesetext der Seite stand darin.
   Die Gliederung kommt weiterhin aus Fettung und Akzent, nicht aus Absenkung. */
.sup__pos p{color:var(--text);font-size:var(--fs-10);line-height:1.7;max-width:58ch;margin:0}
.sup__pos p+p{margin-top:12px}
/* 700 statt 600, seit der Fliesstext dieselbe Farbe hat: die Hervorhebung trug
   sich vorher zur Haelfte ueber die Helligkeit. Bleibt nur die Fettung, muss
   die auch tragen. */
.sup__pos p b,.sup__pos p strong{color:var(--text);font-weight:700}

/* --- Pos 02: Wege ohne Geld ----------------------------------------------- */
/* Kacheln im Kartenschnitt und Verlauf des Bezahlkastens (abgeschnittene
   Ecke), damit sie als Bedienangebote lesbar sind und nicht als weiterer
   Fliesstext. Deckend: halbdurchsichtig liefen Raster und Zeichnung des
   Grundes quer durch den Kacheltext (bei 390 px gesehen). */
.sup__ways{list-style:none;padding:0;margin:18px 0 0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.sup__way{display:flex;flex-direction:column;gap:6px;padding:16px 18px 10px;border:1px solid var(--line-soft);background:linear-gradient(180deg,var(--surface),var(--bg-2));clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,0 100%)}
.sup__way h3{font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-9);letter-spacing:var(--ls-10);text-transform:uppercase;color:var(--text);margin:0}
.sup__way p{font-size:var(--fs-9);line-height:1.6;color:var(--muted);margin:0 0 6px}
.sup__way a{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-8);letter-spacing:var(--ls-6);text-underline-offset:3px}
.sup__way a:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}

/* --- Pos 04: Rueckblick --------------------------------------------------- */
.sup__past{border-top:1px solid var(--line);margin-top:clamp(26px,4.5vw,52px);padding-top:clamp(26px,4.5vw,52px)}
/* Ueberschrift und Stempel als umbrechende Zeile: passt der Stempel nicht
   mehr daneben (EN „Looking back: power supply" bei 360 px), steht er
   buendig darunter statt eingerueckt. */
.sup__past h2{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
/* Der Rueckblick tritt eine Stufe zurueck: Fliesstext in --muted (gemessen
   7,4:1, weiter ueber AAA), nur die fette Kernaussage bleibt in Textfarbe.
   So liest sich die Seite als VerseBase-Seite mit erledigter Vorgeschichte,
   nicht umgekehrt. */
.sup__past .sup__pos p{color:var(--muted)}
/* Stempel „Abgeschlossen" — grau, nicht gold: erledigt ist kein Hinweis mehr.
   Gold traegt im Block nur das Ergebnis („Ersatz gekauft"). */
.sup__badge{display:inline-block;padding:3px 8px;border:1px solid var(--line);font-family:var(--font-mono,'Share Tech Mono',monospace);font-weight:400;font-size:var(--fs-4);letter-spacing:var(--ls-12);color:var(--muted);white-space:nowrap}
.sup__specs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line-soft);margin:6px 0 18px}
.sup__specs>div{padding:10px 14px;border-right:1px solid var(--line-soft);min-width:0}
.sup__specs>div:last-child{border-right:0}
.sup__specs dt,.sup__specs dd{overflow-wrap:anywhere;hyphens:auto}
.sup__specs dt{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-2);letter-spacing:var(--ls-16);text-transform:uppercase;color:var(--muted)}
.sup__specs dd{font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-7);letter-spacing:var(--ls-6);color:var(--text);margin:4px 0 0}
.sup__specs dd.hi{color:var(--accent)}

/* --- Waehler -------------------------------------------------------------- */
.sup__card{border:1px solid var(--line);background:linear-gradient(180deg,var(--surface),var(--bg-2));padding:24px;margin-top:8px;display:grid;gap:16px;clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px))}
.sup__lbl{display:block;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-7);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--text);margin-bottom:8px}
.sup__row{display:flex;flex-wrap:wrap;gap:8px}
.sup__pill{position:relative;cursor:pointer}
.sup__pill input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.sup__pill span{display:block;min-width:4.4rem;min-height:44px;text-align:center;border:1px solid var(--line);background:var(--veil,var(--veil-hi));padding:11px 16px;transition:border-color var(--dur-fast) var(--ease-ui),background-color var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui);font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-9);color:var(--text)}
.sup__pill:hover span{border-color:var(--accent)}
.sup__pill input:checked+span{background:color-mix(in srgb,var(--accent) 14%,transparent);border-color:var(--accent);color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}
.sup__pill input:focus-visible+span{outline:2px solid var(--accent-2);outline-offset:3px}
.sup__freewrap{display:flex;align-items:stretch}
/* DIREKTES Kind. Ohne den `>` traf diese Regel auch das <span class="cur"> mit
   dem Eurozeichen, das INNERHALB liegt: das € bekam damit denselben Rahmen,
   denselben Hintergrund, 14 px Polster und 44 px Mindesthoehe wie das Feld
   selbst — eine Schachtel in der Schachtel. Im Browser am 03.08.2026 gesehen,
   nachdem es gemeldet wurde. Der neue Fokus-Umriss weiter unten hat es dann
   verdoppelt und damit endgueltig kaputt aussehen lassen. */
.sup__freewrap > span{display:flex;align-items:center;gap:6px;min-width:0;min-height:44px;border:1px solid var(--line);background:var(--veil,var(--veil-hi));padding:0 14px}
.sup__freewrap input{width:4.6rem;background:none;border:0;outline:none;font-family:var(--font-mono,'Share Tech Mono',monospace);font-size:var(--fs-9);padding:11px 0;color:var(--text);font-variant-numeric:tabular-nums}
.sup__freewrap .cur{font-family:var(--font-ui,sans-serif);font-weight:700;color:var(--muted)}
/* Der Platzhalter „Anderer" stand auf der VORGABE DES BROWSERS: rgb(117,117,117),
   ein neutrales Grau in einer durchweg warmen Palette, gemessene 4,29:1 — der
   schlechteste Wert der ganzen Seite, waehrend alles andere ueber 7:1 liegt.
   `opacity:1` ist noetig, weil Firefox den Platzhalter zusaetzlich auf 0.54
   herunterblendet und die Farbe allein dort nichts ausrichtet. */
.sup__freewrap input::placeholder{color:var(--muted);opacity:1}
/* FOKUS. Vorher: `outline:none` am Feld, und sichtbar wurde nur ein 1-px-Rand,
   der von rgba(232,168,60,.22) auf volles Gold wechselte. Die Betragsstufen
   direkt daneben bekommen im Fokus einen 2-px-Umriss mit Abstand — dasselbe
   Bedienelement, zwei verschiedene Antworten. Beim Anklicken sah das Feld
   dadurch eher kaputt als aktiv aus.
   Jetzt derselbe Umriss wie bei den Stufen, plus eine angehobene Flaeche:
   der Rand allein traegt bei einem Feld nicht, das man gerade beschreibt. */
.sup__freewrap:focus-within > span{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent);outline:2px solid var(--accent-2);outline-offset:3px}
/* Der Fokusring von detail.css setzt --accent-2; hier ausdruecklich gesetzt,
   damit er nicht von der Seitenpalette abweicht. */
.sup__freewrap input:focus-visible{outline:none}
.sup__cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;font-family:var(--font-ui,sans-serif);font-weight:700;font-size:var(--fs-8);letter-spacing:var(--ls-10);text-transform:uppercase;color:var(--ink);background:var(--accent);border:1px solid var(--accent);padding:15px 28px;text-decoration:none;transition:filter var(--dur-fast) var(--ease-ui),opacity var(--dur-fast) var(--ease-ui);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px))}
.sup__cta:hover{filter:brightness(1.08)}
.sup__cta:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.sup__cta[aria-disabled='true']{opacity:.5;pointer-events:none}
/* Der Knopf ist seit dem Wechsel auf Stripe ein <button>, kein <a>: der Betrag
   entsteht erst beim Klick, ein href waere eine Luege. Was der Browser dafuer
   von sich aus mitbringt und hier stoert: eigene Schriftgroesse (font:inherit
   greift nicht, weil .sup__cta die Schrift ohnehin setzt) und der Pfeil-Cursor. */
.sup__cta{cursor:pointer;width:100%;text-align:center}
/* Waehrend die Bezahlseite geholt wird. KEIN [disabled]: ein disabled-Knopf
   verliert den Fokus, und der Screenreader verliert damit die Stelle. */
.sup__cta[data-busy]{opacity:.6;pointer-events:none}
/* Nebenweg. Bewusst leise — eine Zeile, keine zweite Schaltflaeche: zwei
   gleich laute Knoepfe machen aus einer Entscheidung zwei. */
/* Der Link stand in der Linkfarbe des Browsers (lila) — die einzige fremde
   Farbe der Seite. Jetzt Textfarbe mit goldenem Unterstrich. */
.sup__alt{margin:-4px 0 0;font-size:var(--fs-8);line-height:1.5;color:var(--muted)}
.sup__alt a{color:var(--text);text-decoration-color:var(--accent);text-underline-offset:3px}
.sup__alt a:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}
/* fs-7 statt fs-6 und ohne `opacity:.85`: die Abdunklung kostete den Hinweis
   unter dem Knopf Kontrast, ohne dass er dadurch ruhiger wirkte. */
.sup__payhint{margin:-6px 0 0;font-size:var(--fs-7);line-height:1.55;color:var(--muted)}
/* Rueckkehr von Stripe (?danke=1). Startet verborgen; das Skript unten blendet
   es ein. Kein Betrag darin — der stuende sonst in der Adresszeile und damit
   im Verlauf, im Verweis-Kopf und in jedem Log (D-16). */
.sup__thanks{margin:0;padding:14px 16px;border-left:2px solid var(--accent);background:var(--surface-2);font-size:var(--fs-8);line-height:1.6;color:var(--text)}
.sup__thanks[hidden]{display:none}
.sup__thanks b{color:var(--accent)}
.sup__err{color:var(--accent-2);font-size:var(--fs-8);line-height:1.5;margin:4px 0 0}
.sup__err[hidden]{display:none}
.sup__honest{font-size:var(--fs-7);line-height:1.6;color:var(--muted);border-left:2px solid var(--line);padding-left:14px;margin:0}
.sup__honest b{color:var(--text);font-weight:600}

/* Bewegung ist Verstaerkung: assets/detail.css gattert bei reduzierter Bewegung
   nur `animation`, NICHT `transition` — die Uebergaenge oben brauchen deshalb
   ihre eigene Klammer, sonst laufen sie trotz Systemeinstellung weiter. */
@media (prefers-reduced-motion:reduce){
  .sup__pill span,.sup__cta{transition:none}
}
@media (max-width:860px){
  /* Einspaltig: der Auftrag steht oben, weil er im Quelltext zuerst kommt —
     genau so soll es sein. Die Rasterzuweisung muss dafuer weichen, sonst
     zwingt sie ihn weiter in eine zweite Spalte, die es nicht mehr gibt. */
  .sup__grid{grid-template-columns:minmax(0,1fr);gap:clamp(26px,6vw,40px) 0}
  .sup__order,.sup__aside,.sup__past{grid-area:auto}
  /* Der Abstand kommt schmal vom Raster (gap), nicht doppelt. */
  .sup__past{margin-top:0}
  .sup__jump{display:inline-flex}
  .sup__lead{font-size:var(--fs-10)}
  /* Nichts mehr, woran der Auftrag kleben koennte — sticky wuerde ihn nur
     ueber den Text schieben. */
  .sup__sticky{position:static}
  /* Schmal wird die Zeichnung zur blossen Textur: sie steht dann zwangslaeufig
     hinter JEDEM Absatz statt nur daneben. Weiter zurueckgenommen und mittig,
     damit sie den Text nicht streift. */
  .sup__bg{justify-content:center}
  .sup__bg .sup__sch{height:100%;opacity:.09;margin-left:0}
  .sup__fields{grid-template-columns:repeat(2,minmax(0,1fr))}
  .sup__fields>div:nth-child(2){border-right:0}
}
@media (max-width:480px){
  /* Handy (zweiter Durchgang 08.11.2026, gemessen bei 360 und 390 px):
     Beschriftungen und Kleintexte eine Stufe hoeher. Feldnamen lagen bei
     12,6 px Versalien, Hinweis und Kleingedrucktes im Kasten bei 14,4 px. */
  .sup__fields dt,.sup__specs dt,.sup__badge{font-size:var(--fs-5)}
  .sup__way{padding:14px 16px 8px}
  .sup__fields dd,.sup__specs dd{font-size:var(--fs-8)}
  .sup__payhint,.sup__honest{font-size:var(--fs-8)}
  .sup__alt a{display:inline-flex;align-items:center;min-height:44px}
  .sup__card{padding:20px 18px}
  /* Der Innenabstand der Zellen war bei 360 px der zweite Teil des Problems:
     16 px links plus 18 px Zusatz je Folgezelle fressen ein Zehntel der
     Bildbreite, bevor Text ueberhaupt anfaengt. */
  .sup__fields>div{padding-left:14px;padding-right:14px}
  .sup__fields>div:not(:first-child){padding-left:14px}
}
@media (max-width:560px){
  .sup__row{display:grid;grid-template-columns:1fr 1fr}
  .sup__pill span{min-width:0}
  .sup__freewrap{grid-column:1/-1}
  /* Auch hier das direkte Kind: ohne `>` bekam das € ebenfalls width:100% und
     drueckte im schmalen Raster gegen das Eingabefeld. */
  .sup__freewrap > span{width:100%}
  .sup__freewrap input{width:100%}
  .sup__cta{width:100%}
  .sup__pos{grid-template-columns:1fr;gap:6px}
  .sup__ways{grid-template-columns:minmax(0,1fr)}
  /* Rueckblick-Felder untereinander, Name links, Wert rechts. */
  .sup__specs{grid-template-columns:minmax(0,1fr)}
  .sup__specs>div{display:flex;justify-content:space-between;align-items:baseline;gap:14px;border-right:0;border-bottom:1px solid var(--line-soft)}
  .sup__specs>div:last-child{border-bottom:0}
  .sup__specs dt{flex:none;white-space:nowrap}
  .sup__specs dd{margin:0;text-align:right;min-width:0}
}</style>

