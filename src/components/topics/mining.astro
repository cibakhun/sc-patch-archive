---
// „mining" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import MiningWorkbench from '../../components/MiningWorkbench.astro';
import RefineryFinder from '../../components/RefineryFinder.astro';
import DB from '../../../assets/mining-db.json';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const total = DB.counts.minerals;
const snap = DB.snapshot_date;
const ver = DB.game_version;
const verShort = ver.split('-')[0]; // "4.9.0-live.12248363" -> "4.9.0"
---
<TopicSeo slug="mining" image="/assets/img-mole.jpg" />
<style is:inline>
:root{--bg:#14181a;--bg-2:#181d1f;--surface:#1e2427;--surface-2:#252c30;--accent:#2FBFA4;--accent-2:#E0A526;--hot:#A970FF;--text:#eaf2f1;--muted:#8fa3a0;--line:rgba(47,191,164,.22);--line-soft:rgba(234,242,241,.10);--glow:0 0 44px rgba(47,191,164,.26);--ink:#0e1214;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fb;--bg-2:#e8eff2;--surface:#fcfefe;--surface-2:#ebf4f9;--text:#1b2120;--muted:#4a5c5a;--accent:#036a5a;--accent-2:#704f00;--hot:#642aaa;--ink:#ffffff;--accent-media:#2FBFA4;--accent-2-media:#E0A526;--line:rgba(43,130,113,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,130,113,.18)}




/* Werkzeugseite, keine Leinwand: der Hero ist ein schmaler Titelstreifen.
   `min-height:0` ist der groesste Hebel — dieselbe Entscheidung wie bei
   `hero--tool` in ItemFinderPage.astro:54. Gemessen in Skizze 002: 42 px
   Streifen gegen 273 px vormals; erste Mineralzeile bei 162 px statt 217.
   Foto und Sterne-Canvas entfallen mit dem Hero. verify:fx sichert sie NICHT
   ab — es huetet die getilgten Ambiente-Effekte, den Not-Ausgang und die
   Umschalter-Paritaet; welche Namen das genau sind, steht in
   scripts/verify-fx.mjs und bewusst NICHT hier: dieser Kommentar landet in
   der gebauten Seite, und das Tor sucht die Namen genau dort. Er hat sie
   beim ersten Anlauf prompt gefunden. */
/* ⚠ Der `.hero`-Block dieser Seite ist am 15.08.2026 ersatzlos entfallen — das
   Gehäuse der Werkbank trägt den Titel jetzt selbst. Was hier bleibt, ist
   allein die Polsterung, die vorher am Hero hing: die Navigationsleiste ist
   fest positioniert, und ohne Hero stünde die Werkbank sonst darunter.
   Die 4,4rem sind wie zuvor auf das Höhenbudget gerechnet; unterhalb von
   1180 px veröffentlicht die Leiste ihre wirkliche Höhe als --nav-h und wird
   mit sichtbarer Zurück-Marke 116 px hoch (SiteNav:877). Dort steht die
   Werkbank ohnehin einspaltig, das Budget gilt da nicht. */
main > .wb{padding-top:4.4rem}
@media(max-width:1180px){main > .wb{padding-top:calc(var(--nav-h,116px) + .6rem)}}
.mn-tag{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-14);text-transform:uppercase;font-size:var(--fs-4);color:var(--accent-2)}
.qbar{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin-top:1.4rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-12);text-transform:uppercase;font-size:var(--fs-5);color:var(--muted)}
.qbar b{color:var(--accent)}
.mn-note{max-width:var(--maxw);margin:0 auto 1.2rem;display:flex;align-items:flex-start;gap:.75rem;border:1px solid var(--accent-2);border-left-width:3px;background:color-mix(in srgb,var(--accent-2) 8%,transparent);padding:.9rem 1.1rem;border-radius:4px;color:var(--text);font-size:var(--fs-8);line-height:1.55}
.mn-note b{color:var(--text)}
.mn-note a{color:var(--accent);border-bottom:1px solid var(--line);white-space:nowrap}
.mn-sec-h{max-width:var(--maxw);margin:2.6rem auto 1rem;display:flex;align-items:baseline;gap:.8rem;padding:0 clamp(1rem,4vw,2rem)}
.mn-sec-h h2{font-family:var(--font-display);font-weight:900;font-size:clamp(1.5rem,4vw,2.4rem);color:var(--text);margin:0}
.mn-sec-h .num{font-family:var(--font-display);font-weight:900;color:transparent;-webkit-text-stroke:1.4px var(--accent);font-size:clamp(1.4rem,3.6vw,2.2rem)}
.mn-wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(1rem,4vw,2rem)}
/* Refinery methods */
.rf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.7rem}
.rf-card{border:1px solid var(--line);border-top:2px solid var(--accent-2);background:var(--surface);border-radius:2px;padding:.85rem .9rem}
.rf-card h3{font-family:var(--font-display);font-weight:800;color:var(--text);font-size:var(--fs-10);margin:0 0 .1rem}
.rf-code{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-11);text-transform:uppercase;font-size:var(--fs-2);color:var(--muted)}
.rf-rows{margin-top:.6rem;display:flex;flex-direction:column;gap:.28rem}
.rf-row{display:flex;justify-content:space-between;align-items:center;font-size:var(--fs-6);color:var(--muted);font-family:var(--font-ui)}
.rf-row b{color:var(--text);font-weight:600}
.pips{display:inline-flex;gap:3px;vertical-align:middle}
.pips i{width:8px;height:8px;border-radius:50%;background:var(--line-soft);display:inline-block}
.pips i.on{background:var(--accent)}
.pips.cost i.on{background:var(--accent-2)}
/* Ships */
.sh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.8rem}
.sh-card{border:1px solid var(--line);background:var(--surface);border-radius:4px;overflow:hidden;display:flex;flex-direction:column;color:inherit;text-decoration:none;transition:border-color var(--dur-fast) var(--ease-ui),transform var(--dur-fast) var(--ease-ui)}
.sh-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.sh-link{margin-top:.2rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-9);text-transform:uppercase;font-size:var(--fs-3);color:var(--accent)}
.sh-photo{height:120px;background-size:cover;background-position:center;background-color:var(--surface-2);border-bottom:1px solid var(--line)}
.sh-icon{height:120px;display:flex;align-items:center;justify-content:center;font-size:var(--fs-17);color:var(--accent);background:linear-gradient(135deg,var(--surface-2),var(--surface));border-bottom:1px solid var(--line)}
.sh-body{padding:.85rem .9rem;display:flex;flex-direction:column;gap:.35rem}
.sh-role{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-2);color:var(--accent-2)}
.sh-card h3{font-family:var(--font-display);font-weight:800;color:var(--text);font-size:var(--fs-11);margin:0}
.sh-meta{display:flex;gap:.9rem;font-size:var(--fs-5);color:var(--muted);font-family:var(--font-ui)}
.sh-meta b{color:var(--text)}
.sh-note{font-size:var(--fs-6);color:var(--muted);line-height:1.45}
.mn-cta{display:flex;align-items:center;gap:1rem;border:1px solid var(--line);border-left:3px solid var(--accent);background:linear-gradient(180deg,var(--surface),var(--bg-2));border-radius:4px;padding:1rem 1.2rem;text-decoration:none;color:inherit;transition:border-color var(--dur-fast) var(--ease-ui),box-shadow var(--dur-fast) var(--ease-ui)}
.mn-cta:hover{border-color:var(--accent);box-shadow:var(--glow)}
.mn-cta__ico{flex:none;width:44px;height:44px;display:grid;place-items:center;color:var(--accent);border:1px solid var(--line);background:color-mix(in srgb,var(--accent) 10%,transparent);border-radius:3px}
.mn-cta__body{flex:1;min-width:0;display:flex;flex-direction:column;gap:.15rem}
.mn-cta__body b{font-family:var(--font-display);font-weight:800;color:var(--text);font-size:var(--fs-10)}
.mn-cta__body span{font-size:var(--fs-7);color:var(--muted);line-height:1.45}
.mn-cta__go{flex:none;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-9);text-transform:uppercase;font-size:var(--fs-4);color:var(--accent);white-space:nowrap}
@media(max-width:560px){.mn-cta{flex-wrap:wrap}.mn-cta__go{width:100%;text-align:right}}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: "Mining" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: "Mining" }]} />

<main id="main">
  {/* ⚠ Der `.hero` ist am 15.08.2026 ERSATZLOS entfallen — nicht versehentlich.
      Das Gehäuse der Werkbank trägt den Titel in seinem Kopfband (wie in den
      Vorlagen), und der Hero hätte dieselbe Aussage ein zweites Mal gemacht.
      Der gewonnene Platz ist genau der, den der Rahmen kostet: ohne diesen
      Tausch stünde die Werkbank bei 1280×720 unter der Falz.
      Die <h1> ist damit NICHT verschwunden, sie steht in `.wb__ctitle`.
      „Brechbarkeit" stand bis 12.08.2026 im Untertitel; sie ist mit dem
      Fracturing-Rechner auf /fracturing.html gezogen. */}
  <MiningWorkbench
    lang={de ? 'de' : 'en'}
    title="Mining"
    eyebrow={`Alpha ${verShort}${de ? ' · Live-Daten' : ' · live data'}`}
    lead={de
      ? 'Erz wählen — Fundorte, Physik, Gesteinsarten und Refinery-Ertrag stehen sofort daneben.'
      : 'Pick an ore — locations, physics, rock types and refinery yield stand right beside it.'} />

  <div class="mn-sec-h reveal" id="refinery"><span class="num">02</span><h2>Refinery Finder</h2></div>
  <RefineryFinder lang={de ? 'de' : 'en'} />
  <div class="mn-wrap reveal" style="margin-top:1.2rem">
    {/* Steht bewusst VOR den beiden anderen: der Rechner ist am 12.08.2026
        aus der Werkbank oben herausgezogen worden, und wer die Brechbarkeit
        dort sucht, muss sie hier finden. */}
    <a class="mn-cta" href={de ? '/de/fracturing.html' : '/fracturing.html'} style="margin-bottom:.7rem">
      <span class="mn-cta__ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13H11l-1 9 9.5-12H13z"/></svg></span>
      <span class="mn-cta__body">
        <b>{de ? 'Fracturing-Rechner' : 'Fracturing calculator'}</b>
        <span>{de ? 'Laser, Module, Gadget und Felsmasse einstellen — der Rechner sagt für jedes Erz, ob der Brocken aufgeht, und zeigt die Rechnung dahinter.' : 'Set laser, modules, gadget and rock mass — the calculator says for every ore whether the rock opens up, and shows the sum behind it.'}</span>
      </span>
      <span class="mn-cta__go">{de ? 'Öffnen →' : 'Open →'}</span>
    </a>
    <a class="mn-cta" href={de ? '/de/refinery.html' : '/refinery.html'}>
      <span class="mn-cta__ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6M10 3v5.5L4.6 19A1.4 1.4 0 0 0 5.8 21h12.4a1.4 1.4 0 0 0 1.2-2L14 8.5V3"/><path d="M7.5 15h9"/></svg></span>
      <span class="mn-cta__body">
        <b>Refinery Dashboard</b>
        <span><Fragment set:html={de ? 'Verfolge deine echten Refinery-Aufträge — Station, Methode, Live-Countdown &amp; Erlös, in deinem Konto gespeichert.' : 'Track your actual refinery work orders — station, method, live countdown &amp; payout, saved to your account.'} /></span>
      </span>
      <span class="mn-cta__go">{de ? 'Öffnen →' : 'Open →'}</span>
    </a>
    <a class="mn-cta" href={de ? '/de/precision-jump.html' : '/precision-jump.html'} style="margin-top:.7rem">
      <span class="mn-cta__ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg></span>
      <span class="mn-cta__body">
        <b>{de ? 'Precision Jump — Aaron-Halo-Routenrechner' : 'Precision Jump — Aaron Halo route calculator'}</b>
        <span>{de ? 'Plotte die Quantum-Travel-Linie zwischen zwei Markern und erhalte die exakte Ausstiegs-Koordinate für das Asteroidenband, das du abbauen willst.' : 'Plot the quantum-travel line between two markers and get the exact dropout coordinate to land in the asteroid band you want to mine.'}</span>
      </span>
      <span class="mn-cta__go">{de ? 'Öffnen →' : 'Open →'}</span>
    </a>
  </div>

  <TopicFacts topicSlug="mining" dataVersion={verShort} />
</main>

<RelatedTopics topicSlug="mining" />
<Attribution sources={[]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
