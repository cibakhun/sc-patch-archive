---
// „mining" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import MiningWorkbench from '../../components/MiningWorkbench.astro';
import DB from '../../../assets/mining-db.json';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const snap = DB.snapshot_date;
const ver = DB.game_version;
const verShort = ver.split('-')[0]; // "4.9.0-live.12248363" -> "4.9.0"
---
<TopicSeo slug="mining" image="/assets/img-mole.jpg" />
<style is:inline>
:root{--bg:#14181a;--bg-2:#181d1f;--surface:#1e2427;--surface-2:#252c30;--accent:#2FBFA4;--accent-2:#E0A526;--hot:#2FBFA4;--text:#eaf2f1;--muted:#8fa3a0;--line:rgba(47,191,164,.22);--line-soft:rgba(234,242,241,.10);--glow:0 0 44px rgba(47,191,164,.26);--ink:#0e1214;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fb;--bg-2:#e8eff2;--surface:#fcfefe;--surface-2:#ebf4f9;--text:#1b2120;--muted:#4a5c5a;--accent:#036a5a;--accent-2:#704f00;--hot:#046151;--ink:#ffffff;--accent-media:#2FBFA4;--accent-2-media:#E0A526;--line:rgba(43,130,113,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,130,113,.18)}




/* Werkzeugseite, keine Leinwand: der Hero ist ein schmaler Titelstreifen.
   `min-height:0` ist der groesste Hebel — dieselbe Entscheidung wie bei
   `hero--tool` in ItemFinderPage.astro:54. Gemessen in Skizze 002: 42 px
   Streifen gegen 273 px vormals; erste Mineralzeile bei 162 px statt 217.
   Foto und Sterne-Canvas entfallen mit dem Hero. verify:fx sichert sie NICHT
   ab — es huetet die getilgten Ambiente-Effekte, den Not-Ausgang und die
   Umschalter-Paritaet; welche Namen das genau sind, steht in
   scripts/verify-fx.mjs und bewusst NICHT hier: dieser Kommentar landet in
   der gebauten Seite, und das Tor sucht die Namen genau dort. Er hat sie
   beim ersten Anlauf prompt gefunden. */
/* Am gebauten Stand bei 1280x720 nachgemessen und danach gekuerzt:
   Polsterung oben stand auf 6,2rem = 111,6 px fuer eine 67 px hohe
   Navigation — 44 px verschenkt. Eyebrow und Untertitel belegten je eine
   eigene Zeile (24 + 50 px). Alles drei steht jetzt in EINER Grundlinien-
   Reihe. Hero dadurch von 247 px auf rund 130 px. */
.hero{min-height:0;justify-content:flex-start;padding-top:4.4rem;padding-bottom:.5rem;
  background:radial-gradient(120% 90% at 78% 12%,rgba(47,191,164,.14),transparent 60%),radial-gradient(90% 80% at 12% 90%,rgba(224,165,38,.10),transparent 55%),var(--bg)}
.hero h1{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:600;letter-spacing:var(--ls-1);color:var(--text);margin:0}
.hero .lead{flex:1 1 24ch;max-width:70ch;font-size:var(--fs-6);color:var(--muted);margin:0}
/* ⚠ Die 4,4rem oben sind auf das Hoehenbudget der Werkbank gerechnet. Die
   Leiste veroeffentlicht ihre wirkliche Hoehe aber als --nav-h und wird mit
   sichtbarer Zurueck-Marke auf schmalen Fenstern 116 px hoch (SiteNav:877) —
   dort lief die Marke deshalb in die Eyebrow-Zeile. Unterhalb von 1180 px
   steht die Werkbank ohnehin einspaltig mit height:auto, das Budget gilt da
   nicht, also bekommt der Hero den Platz, den die Leiste wirklich braucht. */
@media(max-width:1180px){.hero{padding-top:calc(var(--nav-h,116px) + .6rem)}}
.hero__in{max-width:1560px;display:flex;align-items:baseline;gap:.3rem 1rem;flex-wrap:wrap}
.hero__in .eyebrow{order:0;width:auto;flex:0 0 auto}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: "Mining" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: "Mining" }]} />

<main id="main">
  <section class="hero">
    <div class="hero__in">
      <div class="eyebrow">Alpha {verShort}{de ? ' · Live-Daten' : ' · live data'}</div>
      <h1>Mining</h1>
      {/* „Brechbarkeit" stand hier bis 12.08.2026 mit drin. Sie ist mit dem
          Fracturing-Rechner auf /fracturing.html gezogen — eine Zusage, die
          die Seite nicht mehr einlöst, gehört aus dem Untertitel raus. */}
      <p class="lead"><Fragment set:html={de ? 'Erz wählen — Fundorte, Physik, Gesteinsarten und Refinery-Ertrag stehen sofort daneben.' : 'Pick an ore — locations, physics, rock types and refinery yield stand right beside it.'} /></p>
    </div>
  </section>

  <MiningWorkbench lang={de ? 'de' : 'en'} />

</main>

<RelatedTopics topicSlug="mining" />
<Attribution sources={[]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
