---
// „mining" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import MiningWorkbench from '../../components/MiningWorkbench.astro';
import DB from '../../../assets/mining-db.json';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const snap = DB.snapshot_date;
const ver = DB.game_version;
const verShort = ver.split('-')[0]; // "4.9.0-live.12248363" -> "4.9.0"
---
<TopicSeo slug="mining" image="/assets/img-mole.jpg" />
<style is:inline>
:root{--bg:#14181a;--bg-2:#181d1f;--surface:#1e2427;--surface-2:#252c30;--accent:#2FBFA4;--accent-2:#E0A526;--hot:#A970FF;--text:#eaf2f1;--muted:#8fa3a0;--line:rgba(47,191,164,.22);--line-soft:rgba(234,242,241,.10);--glow:0 0 44px rgba(47,191,164,.26);--ink:#0e1214;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fb;--bg-2:#e8eff2;--surface:#fcfefe;--surface-2:#ebf4f9;--text:#1b2120;--muted:#4a5c5a;--accent:#036a5a;--accent-2:#704f00;--hot:#642aaa;--ink:#ffffff;--accent-media:#2FBFA4;--accent-2-media:#E0A526;--line:rgba(43,130,113,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,130,113,.18)}




/* Werkzeugseite, keine Leinwand: der Hero ist ein schmaler Titelstreifen.
   `min-height:0` ist der groesste Hebel — dieselbe Entscheidung wie bei
   `hero--tool` in ItemFinderPage.astro:54. Gemessen in Skizze 002: 42 px
   Streifen gegen 273 px vormals; erste Mineralzeile bei 162 px statt 217.
   Foto und Sterne-Canvas entfallen mit dem Hero. verify:fx sichert sie NICHT
   ab — es huetet die getilgten Ambiente-Effekte, den Not-Ausgang und die
   Umschalter-Paritaet; welche Namen das genau sind, steht in
   scripts/verify-fx.mjs und bewusst NICHT hier: dieser Kommentar landet in
   der gebauten Seite, und das Tor sucht die Namen genau dort. Er hat sie
   beim ersten Anlauf prompt gefunden. */
/* ⚠ Der `.hero`-Block dieser Seite ist am 15.08.2026 ersatzlos entfallen — das
   Gehäuse der Werkbank trägt den Titel jetzt in seinem Kopfband. Was hier
   bleibt, ist allein die Polsterung, die vorher am Hero hing: die
   Navigationsleiste ist fest positioniert, und ohne Hero stünde die Werkbank
   sonst darunter. Die 4,4rem sind wie zuvor auf das Höhenbudget gerechnet;
   unterhalb von 1180 px veröffentlicht die Leiste ihre wirkliche Höhe als
   --nav-h und wird mit sichtbarer Zurück-Marke 116 px hoch (SiteNav:877) —
   dort steht die Werkbank ohnehin einspaltig, das Budget gilt da nicht. */
main > .wb{padding-top:4.4rem}
@media(max-width:1180px){main > .wb{padding-top:calc(var(--nav-h,116px) + .6rem)}}

/* ══════════ EIN BILDSCHIRM, KEIN DOKUMENT ══════════
   Ansage 18.08.2026: „ich will einfach nur das tool haben ohne dass ich nach
   unten scrollen kann". Bis hierher stand die Seite 337 px über dem Fenster —
   und zwar bei JEDER Fenstergröße gleich viel (gemessen 1280×720, 1440×900,
   1920×1080: Überhang immer 337). Der Grund ist nicht das Gerät, sondern die
   Fußzeile: das Gehäuse rechnet sich mit `100vh - --wb-chrome` (132 px) schon
   auf das Fenster, die 364 px hohe `footer.site-attr` steht aber außerhalb
   dieser Rechnung darunter.
   Deshalb NICHT `--wb-chrome` hochsetzen — das hätte das Gerät um die Höhe der
   Fußzeile geschrumpft. Die Seite bekommt stattdessen die Fensterhöhe als
   feste Größe, und das Gehäuse nimmt sich davon den Rest. Es WÄCHST dabei,
   statt zu schrumpfen — gemessen 588 → 616 px bei 720 px Fensterhöhe und
   948 → 976 px bei 1080, weil nur noch die eigene Polsterung
   (70,4 oben für die feste Kopfleiste + 22,4 unten) von ihm abgeht statt der
   pauschalen 132.

   ⚠⚠ NUR im dreispaltigen Betrieb. Unterhalb von 1181 px stapelt die Werkbank
   ihre drei Paneele untereinander (MiningWorkbench.astro, `@media
   max-width:1180`); dort ist die Seite gemessen 1716 px hoch (1100×800) bzw.
   1412 px (390×844). Eine Sperre würde dort zwei Drittel des Werkzeugs
   unerreichbar machen — der Bildlauf bleibt.
   ⚠ Dieselbe Klinke nach unten: unter 560 px Fensterhöhe blättert die Sperre
   sich selbst weg. Vom Fenster gehen 93 px Polsterung, ~42 px Rahmenblech und
   67 px Rig-Leiste ab; bei 560 bleiben dem Raster noch ~350 px, darunter wird
   es zur Sehschlitz-Bedienung. */
@media(min-width:1181px) and (min-height:560px){
  html,body{height:100%;overflow:hidden;overscroll-behavior:none}
  /* Die Fußzeile ist das EINZIGE, was unter dem Werkzeug stand: RelatedTopics
     rendert auf dieser Seite nichts (Mining ist `evergreen` und hängt an
     keinem Patch, s. RelatedTopics.astro), und die Attribution steht genau
     einmal — aus dem Seitenkörper, nicht aus dem Layout. */
  body > footer.site-attr{display:none}
  main{height:100dvh;display:flex;flex-direction:column}
  main > .wb{flex:1;min-height:0}
  /* ⚠ Die höhere Spezifität ist Pflicht, nicht Zierde: `.wb__chassis` rechnet
     seine Höhe selbst, und sein Stilblock steht im Dokument SPÄTER als dieser
     hier (er sitzt im Bauteil, dieser im Seitenkörper). Bei gleicher
     Spezifität gäbe die Reihenfolge den Ausschlag und die eigene Rechnung
     gewänne. `main .wb__chassis` (0,1,1) schlägt `.wb__chassis` (0,1,0)
     unabhängig davon.
     Der Deckel von 1180 px fällt hier bewusst mit weg: auf einem hohen Schirm
     soll das Gerät die Fensterhöhe füllen, sonst stünde unter einer nicht
     scrollbaren Seite ein Streifen Leere. */
  main .wb__chassis{height:auto;flex:1;min-height:0}
}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: "Mining" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: "Mining" }]} />

<main id="main">
  {/* Der Hero ist am 15.08.2026 entfallen: das Kopfband des Werkbank-Gehäuses
      trägt Titel, Vorzeile und Untertitel, und der Hero hätte dieselbe Aussage
      ein zweites Mal gemacht. Der gewonnene Platz ist genau der, den der
      Rahmen kostet. Die <h1> ist NICHT verschwunden — sie steht in
      `.wb__ctitle`, weiterhin genau eine je Seite.
      „Brechbarkeit" stand bis 12.08.2026 im Untertitel; sie ist mit dem
      Fracturing-Rechner auf /fracturing.html gezogen. */}
  {/* ⚠ KEINE Vorzeile mehr (16.08.2026, auf Ansage). Sie lautete „Erz wählen —
      Fundorte, Physik, Gesteinsarten und Refinery-Ertrag stehen sofort
      daneben." und nannte damit zwei Dinge, die es hier seit dem 12.08. nicht
      mehr gibt: Physik und Gesteinsarten sind mit dem Fracturing-Rechner auf
      /fracturing.html gezogen (s. Kommentar oben). Der Satz war also seit vier
      Tagen ein Versprechen ins Leere — und das Kopfband trägt Titel und
      Vorzeile ohnehin schon. */}
  <MiningWorkbench
    lang={de ? 'de' : 'en'}
    title="Mining"
    eyebrow={`Alpha ${verShort}${de ? ' · Live-Daten' : ' · live data'}`} />

</main>

<RelatedTopics topicSlug="mining" />
<Attribution sources={[]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
