---
// „4-2-1-resource-drive" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-2-1-resource-drive" image="/assets/t-rd-1.jpg" />
<style is:inline>

/* Resource-Drive-Theme (4.2.1) — Second Life green / Addison gold */
:root{
  --bg:#0e1620;--bg-2:#16202e;--surface:#1b2838;--surface-2:#22344a;
  --accent:#2E8B57;--accent-2:#E6952A;--hot:#D94A38;
  --text:#eaf1ee;--muted:#9db1b2;
  --line:rgba(46,139,87,.22);--line-soft:rgba(234,241,238,.10);
  --glow:0 0 44px rgba(46,139,87,.30);--ink:#0e1620;
  --maxw:1180px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fe;--bg-2:#e7eef9;--surface:#fcfdff;--surface-2:#ecf3fc;--text:#1c211e;--muted:#4a5c5d;--accent:#056d3d;--accent-2:#794900;--hot:#9c0d01;--ink:#ffffff;--accent-media:#2E8B57;--accent-2-media:#E6952A;--line:rgba(58,131,87,.3);--line-soft:rgba(42,47,44,.12);--glow:0 6px 22px rgba(44,133,83,.18)}



/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10.5rem)}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}
.corp-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0;border-block:1px solid var(--line);background:linear-gradient(90deg,var(--bg-2),var(--surface),var(--bg-2))}
.corp-strip .cc{padding:clamp(1.4rem,3vw,2.2rem) 1.2rem;text-align:center;border-right:1px solid var(--line-soft)}
.corp-strip .cc:last-child{border-right:0}
.corp-strip .nm{font-family:var(--font-display);font-weight:900;font-size:clamp(1rem,2vw,1.45rem);color:var(--accent);line-height:1}
.corp-strip .pl{font-family:var(--font-ui);text-transform:uppercase;letter-spacing:.14em;font-size:.68rem;color:var(--muted);margin-top:.5rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.2.1', href: '/de/patches/sc-4-2-1.html' }, { label: "Resource Drive" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.2.1', href: '/patches/sc-4-2-1.html' }, { label: "Resource Drive" }]} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-rd-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-2-1.html' : '/patches/sc-4-2-1.html'}>Alpha 4.2.1 · Second Life</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Globales Event' : ' &nbsp;·&nbsp; Global Event'} /></div>
      <h1><span class="thin">{de ? 'Das erste globale Event' : 'The first global event'}</span>Resource Drive</h1>
      <p class="lead">{de ? 'Imperator Addison ruft Stantons vier Megakonzerne zum Wettstreit: wer am meisten Material liefert, gewinnt den Forschungsauftrag. Das erste Event, dessen Fortschritt über alle Shards zusammenläuft.' : 'Imperator Addison calls Stanton\'s four megacorporations to compete: whoever delivers the most material wins the research contract. The first event whose progress converges across all shards.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Globales Event' : 'Global Event'}</span><span class="tag">{de ? '4 Megakonzerne' : '4 Megacorporations'}</span><span class="tag">Hauling</span><span class="tag">{de ? 'Konvoi' : 'Convoy'}</span><span class="tag">{de ? 'Event-Tracking' : 'Event Tracking'}</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>RESOURCE DRIVE</span><span class="dot">◆</span><span>HURSTON</span><span class="dot">◆</span><span>CRUSADER</span><span class="dot">◆</span><span>ARCCORP</span><span class="dot">◆</span><span>MICROTECH</span><span class="dot">◆</span><span>GLOBAL EVENT</span><span class="dot">◆</span>
      <span>RESOURCE DRIVE</span><span class="dot">◆</span><span>HURSTON</span><span class="dot">◆</span><span>CRUSADER</span><span class="dot">◆</span><span>ARCCORP</span><span class="dot">◆</span><span>MICROTECH</span><span class="dot">◆</span><span>GLOBAL EVENT</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-2-1-resource-drive" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="4">0</div><div class="c">{de ? 'Konkurrierende Megakonzerne' : 'Competing megacorporations'}</div></div>
    <div class="s"><div class="n count" data-to="337">0</div><div class="c">{de ? 'Mio. SCU · Sieger-Liefermenge' : 'Million SCU · winner\'s delivery total'}</div></div>
    <div class="s"><div class="n count" data-to="5">0</div><div class="c">{de ? 'Belohnungs-Tiers' : 'Reward tiers'}</div></div>
    <div class="s"><div class="n">{de ? 'Shard-übergreifend' : 'Cross-shard'}</div><div class="c">{de ? 'Erstes globales Event-Tracking' : 'First global event tracking'}</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax) — the premise -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/cz-ruin.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Imperator Addisons Aufruf' : 'Imperator Addison\'s call'}</div>
      <div class="big outline">{de ? 'EIN VERSE.' : 'ONE VERSE.'}<br>{de ? 'EIN ZIEL.' : 'ONE GOAL.'}</div>
      <p>{de ? 'Die Second Life Resource Drive ist das erste echte globale Event des Verse: Imperator Addison ruft Stantons vier Megakonzerne — ' : 'The Second Life Resource Drive is the Verse\'s first true global event: Imperator Addison calls Stanton\'s four megacorporations — '}<b style="color:var(--accent-2)">{de ? 'Hurston Dynamics, Crusader Industries, ArcCorp und microTech' : 'Hurston Dynamics, Crusader Industries, ArcCorp and microTech'}</b>{de ? ' — zum Sammeln von Forschungsmaterial. Jeder Pilot wählt eine Seite.' : ' — to gather research material. Every pilot picks a side.'}</p>
    </div>
  </section>

  <!-- CORP STRIP — the four contenders -->
  <div class="corp-strip reveal">
    <div class="cc"><div class="nm">Hurston Dynamics</div><div class="pl">{de ? 'Waffen · Hurston' : 'Weapons · Hurston'}</div></div>
    <div class="cc"><div class="nm">Crusader Industries</div><div class="pl">{de ? 'Raumfahrt · Crusader' : 'Spaceflight · Crusader'}</div></div>
    <div class="cc"><div class="nm">ArcCorp</div><div class="pl">{de ? 'Energie · ArcCorp' : 'Energy · ArcCorp'}</div></div>
    <div class="cc"><div class="nm">microTech</div><div class="pl">{de ? 'Technik · microTech' : 'Technology · microTech'}</div></div>
  </div>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Wer am meisten ' : 'Whoever '}<span class="hl">{de ? 'liefert' : 'delivers'}</span>{de ? ', gewinnt den Forschungsauftrag.' : ' the most wins the research contract.'}</blockquote>
    <cite>Resource Drive · Second Life</cite>
  </section>

  <!-- ROLLEN — Versus trägt den Loop allein. Bewusst KEIN Scrollytelling:
       die vier alten Schritte duplizierten Corp-Strip und Versus 1:1. -->
  <section style="padding:0">
    <div class="wrap" style="padding:clamp(3rem,7vw,5.5rem) clamp(1.25rem,5vw,4rem) 0">
      <div class="sec-head reveal"><span class="num">01</span><h2>{de ? 'So unterstützt du deinen Konzern' : 'How to support your corporation'}</h2><span class="rule"></span></div>
    </div>
    <div class="versus reveal">
      <div class="side a">
        <h3><Fragment set:html={de ? '⚙ Liefern &amp; Bergen' : '⚙ Deliver &amp; Salvage'} /></h3>
        <ul>
          <li>{de ? 'Cargo von den Mining-Basen zur Sammelstelle hauling.' : 'Haul cargo from the mining bases to the collection point.'}</li>
          <li>{de ? 'Verlorene Fracht über Reclaim-Missionen zurückholen.' : 'Recover lost freight through reclaim missions.'}</li>
          <li>{de ? 'Jede SCU zählt direkt auf die Konzern-Gesamtsumme ein.' : 'Every SCU counts directly toward the corporation total.'}</li>
          <li>{de ? 'Routen verlaufen durch Stanton und Pyro.' : 'Routes run through Stanton and Pyro.'}</li>
        </ul>
      </div>
      <div class="vs">&amp;</div>
      <div class="side b">
        <h3><Fragment set:html={de ? '★ Schützen &amp; Eskortieren' : '★ Protect &amp; Escort'} /></h3>
        <ul>
          <li>{de ? 'Konvois deines Konzerns auf den Lieferrouten eskortieren.' : 'Escort your corporation\'s convoys along the delivery routes.'}</li>
          <li>{de ? 'Transporter gegen Angreifer und Plünderer verteidigen.' : 'Defend transports against attackers and raiders.'}</li>
          <li>{de ? 'Sichere Durchfahrt hält den Materialfluss am Laufen.' : 'Safe passage keeps the flow of material moving.'}</li>
          <li>{de ? 'Ohne Eskorte erreicht die Fracht die Sammelstelle nicht.' : 'Without an escort the freight never reaches the collection point.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SPLIT — the single framed section: Global Event Tracking Service -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-rd-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '02 · mobiGlas-Journal' : '02 · mobiGlas journal'}</div>
        <h3>{de ? 'Erstmals: Global Event Tracking Service' : 'A first: the Global Event Tracking Service'}</h3>
        <p>{de ? 'Resource Drive ist die ' : 'Resource Drive is the '}<b>{de ? 'erste Aktivität mit dem neuen Global Event Tracking Service' : 'first activity to use the new Global Event Tracking Service'}</b>{de ? '. Eine vereinte Statusseite im mobiGlas-Journal bündelt den Fortschritt über mehrere Shards hinweg.' : '. A unified status page in the mobiGlas journal consolidates progress across multiple shards.'}</p>
        <p>{de ? 'Statt isolierter Server-Instanzen sehen alle Spieler denselben, zusammenlaufenden Wettstand — und damit zum ersten Mal, wer im gesamten Verse vorne liegt.' : 'Instead of isolated server instances, all players see the same converging standings — and, for the first time, who leads across the entire Verse.'}</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — the winner -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-hh-3.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '03 · Das Ergebnis' : '03 · The result'}</div>
      <div class="big" style="font-size:clamp(2.4rem,9vw,6.5rem)">{de ? 'HURSTON GEWINNT' : 'HURSTON WINS'}</div>
      <p>{de ? 'Hurston Dynamics holte den Forschungsauftrag mit rund ' : 'Hurston Dynamics claimed the research contract with roughly '}<b style="color:var(--accent-2)">{de ? '337 Millionen SCU' : '337 million SCU'}</b>{de ? ' Gesamt-Liefermenge. Der Konzern mit der höchsten Summe am Ende gewinnt — und Hurston lag vorn.' : ' in total deliveries. The corporation with the highest total at the end wins — and Hurston was ahead.'}</p>
    </div>
  </section>

  <!-- BAND — the reward -->
  <section class="band band--center">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/cz-loot.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal" style="text-align:center;margin-inline:auto">
      <div class="kx" style="text-align:center">{de ? 'Tier-5-Belohnung' : 'Tier 5 reward'}</div>
      <div class="big outline" style="font-size:clamp(2rem,7vw,5rem)">STRATA HURSTON BLACK</div>
      <p style="margin-inline:auto">{de ? 'Die höchste Belohnungsstufe brachte eine exklusive ' : 'The highest reward tier delivered an exclusive '}<b style="color:var(--accent-2)">{de ? 'Strata-Hurston-Black-Armor' : 'Strata Hurston Black armor'}</b>{de ? ' — plus 5 % Dauerrabatt für alle, die ihren Konzern bis zum Sieg getragen haben.' : ' — plus a permanent 5% discount for everyone who carried their corporation to victory.'}</p>
    </div>
  </section>

  <!-- CLOSING GALLERY (mixed, full-bleed lead tile) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>{de ? 'Galerie' : 'Gallery'}</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-rd-1.jpg"><img src="/assets/t-rd-1.jpg" alt={de ? 'Resource Drive — Frachter am Container-Depot' : 'Resource Drive — freighters at the container depot'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Hauling-Lauf für den Konzern' : 'Hauling run for the corporation'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-rd-2.jpg"><img src="/assets/t-rd-2.jpg" alt={de ? 'RSI-Schiff im Gefecht im Asteroidenfeld' : 'RSI ship in combat in the asteroid field'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Eskorten-Gefecht · Asteroidenfeld' : 'Escort combat · asteroid field'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-meteor.jpg"><img src="/assets/img-meteor.jpg" alt={de ? 'RSI Meteor — das neue Schiff des Patches' : 'RSI Meteor — the patch\'s new ship'} loading="lazy"><span class="zoomic">⤢</span><figcaption>RSI Meteor</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-ruin.jpg"><img src="/assets/cz-ruin.jpg" alt={de ? 'Zerstörte Stationsruine im Orbit' : 'Destroyed station ruin in orbit'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Stationsruine · Orbit' : 'Station ruin · orbit'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt={de ? 'Aegis Hammerhead als Konvoi-Eskorte' : 'Aegis Hammerhead as convoy escort'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Konvoi-Eskorte' : 'Convoy escort'}</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: Star Citizen Wiki &amp; offizielle Community-Quellen (© Cloud Imperium Games). Fan-Content-Nutzung.' : 'Source: Star Citizen Wiki &amp; official community sources (© Cloud Imperium Games). Fan content use.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-2-1-resource-drive" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
