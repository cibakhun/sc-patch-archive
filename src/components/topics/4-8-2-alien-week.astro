---
// „4-8-2-alien-week" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-8-2-alien-week" image="/assets/t-alien-1.jpg" />
<style is:inline>

/* Strike / Xenotech-Theme (4.8.x) */
:root{--bg:#0c0a16;--bg-2:#140f24;--surface:#1a1330;--surface-2:#231a3e;--accent:#1FB8A6;--accent-2:#E8651E;--hot:#E8651E;--text:#e8f0ef;--muted:#9ab0ad;--line:rgba(31,184,166,.22);--line-soft:rgba(232,240,239,.10);--glow:0 0 44px rgba(31,184,166,.30);--ink:#0c0a16;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f7f6ff;--bg-2:#eeecf8;--surface:#fdfdff;--surface-2:#f2f1fb;--text:#1b2120;--muted:#495d5a;--accent:#046a5f;--accent-2:#8d3601;--hot:#893400;--ink:#ffffff;--accent-media:#1FB8A6;--accent-2-media:#E8651E;--line:rgba(43,129,118,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,129,118,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.xeyebrow{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.8.2', href: '/de/patches/sc-4-8-2.html' }, { label: "Alien Week 2956" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.8.2', href: '/patches/sc-4-8-2.html' }, { label: "Alien Week 2956" }]} />


<main id="main">

  <!-- HERO (full-bleed media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-alien-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-8-2.html' : '/patches/sc-4-8-2.html'}>Alpha 4.8.2 · Gatac &amp; Alien Week</a> &nbsp;·&nbsp; Event</div>
      <h1><span class="thin">First Contact Day 2956</span>Alien Week</h1>
      <p class="lead">{de ? 'Die jährliche Feier der nicht-menschlichen Hersteller: rund um First Contact Day rückt Alien Week Xenotech ins Rampenlicht — mit den Gatac-Schiffen Railen, Syulen und Tyilui als Headliner.' : 'The annual celebration of non-human manufacturers: around First Contact Day, Alien Week puts xenotech in the spotlight — headlined by the Gatac ships Railen, Syulen and Tyilui.'}</p>
      <div class="tags"><span class="tag hot">Event</span><span class="tag">First Contact Day</span><span class="tag">Gatac</span><span class="tag">Aopoa</span><span class="tag">Xenotech</span></div>
      <div class="hero__play" data-lb="yt:Xh35kuWo0a4"><span class="pbtn">▶</span>{de ? 'Trailer ansehen' : 'Watch trailer'}</div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>ALIEN WEEK 2956</span><span class="dot">◆</span><span>GATAC RAILEN</span><span class="dot">◆</span><span>GATAC TYILUI</span><span class="dot">◆</span><span>GATAC SYULEN</span><span class="dot">◆</span><span>FIRST CONTACT DAY</span><span class="dot">◆</span><span>XENOTECH</span><span class="dot">◆</span>
      <span>ALIEN WEEK 2956</span><span class="dot">◆</span><span>GATAC RAILEN</span><span class="dot">◆</span><span>GATAC TYILUI</span><span class="dot">◆</span><span>GATAC SYULEN</span><span class="dot">◆</span><span>FIRST CONTACT DAY</span><span class="dot">◆</span><span>XENOTECH</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AT A GLANCE (data register, uniform) -->
  <TopicFacts topicSlug="4-8-2-alien-week" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">{de ? 'Gatac-Headliner · 2956' : 'Gatac headliners · 2956'}</div></div>
    <div class="s"><div class="n count" data-to="4">0</div><div class="c">{de ? 'Alien-Hersteller im Spotlight' : 'Alien manufacturers in the spotlight'}</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">{de ? 'Flugfertige Railen' : 'Flight-ready Railen'}</div></div>
    <div class="s"><div class="n">Xi'an</div><div class="c">{de ? 'Sprachlektionen zum Event' : 'Language lessons for the event'}</div></div>
  </div>

  <!-- FULL-BLEED BAND #1 (parallax, big text over still) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-alien-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Rund um First Contact Day' : 'Around First Contact Day'}</div>
      <div class="big outline">ALIEN WEEK</div>
      <p>{de ? 'Einmal im Jahr feiert das Verse den ersten Kontakt — und stellt jene Hersteller in den Mittelpunkt, die nicht von Menschenhand stammen. Alien Week ist die Bühne für ' : 'Once a year the Verse celebrates first contact — and puts the spotlight on those manufacturers not made by human hands. Alien Week is the stage for '}<b style="color:var(--accent-2)">{de ? 'Xenotech' : 'xenotech'}</b>.</p>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Eine Woche, in der ' : 'A week in which '}<span class="hl">{de ? 'fremde Technik' : 'alien technology'}</span>{de ? ' die Hauptrolle spielt.' : ' takes the lead role.'}</blockquote>
    <cite>Alien Week · First Contact Day 2956</cite>
  </section>

  <!-- OVERVIEW as the single framed SPLIT -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-alien-3.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '01 · Worum es geht' : '01 · What it\'s about'}</div>
        <h3>{de ? 'Das Fest der nicht-menschlichen Hersteller' : 'The festival of non-human manufacturers'}</h3>
        <p>{de ? 'Alien Week ist das jährliche Event rund um ' : 'Alien Week is the annual event around '}<b>First Contact Day</b>{de ? ', das die nicht-menschlichen bzw. Xenotech-Hersteller von Star Citizen in den Mittelpunkt stellt. Eine Woche lang dreht sich alles um Technik jenseits menschlicher Werften.' : ' that puts Star Citizen\'s non-human, or xenotech, manufacturers front and center. For a whole week, everything revolves around technology beyond human shipyards.'}</p>
        <p>{de ? 'Begleitet wird das Event von Community-Aktivitäten wie ' : 'The event is accompanied by community activities such as '}<b>{de ? 'Alien-Lore-Features' : 'alien lore features'}</b>{de ? ' und ' : ' and '}<b>{de ? 'Xi\'an-Sprachlektionen' : 'Xi\'an language lessons'}</b>{de ? ' — Kontext und Kultur zu den fremden Konstrukteuren, deren Schiffe im Rampenlicht stehen.' : ' — context and culture for the alien builders whose ships are in the spotlight.'}</p>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: How Alien Week works (PROCESS) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>{de ? 'So funktioniert das Event' : 'How the event works'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-alien-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-7.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>First Contact Day</h3><p>{de ? 'Das Event startet rund um First Contact Day — den jährlichen Anlass, der den ersten Kontakt feiert und Xenotech ins Zentrum rückt.' : 'The event kicks off around First Contact Day — the annual occasion that celebrates first contact and puts xenotech at the center.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Pledge-Store-Aktionen' : 'Pledge Store deals'}</h3><p>{de ? 'Zeitlich begrenzte Aktionen im Pledge Store machen Schiffe von Alien-Herstellern wie Gatac Manufacture, Aopoa, Banu und Esperia verfügbar.' : 'Time-limited deals in the Pledge Store make ships from alien manufacturers like Gatac Manufacture, Aopoa, Banu and Esperia available.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Limitierte Ausstattung' : 'Limited gear'}</h3><p>{de ? 'Dazu kommen limitierte Lackierungen und Ausrüstung — fremde Designsprache, die nur in diesem Zeitfenster zu haben ist.' : 'On top of that come limited paints and gear — alien design language available only within this window.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3><Fragment set:html={de ? 'Lore &amp; Sprache' : 'Lore &amp; language'} /></h3><p>{de ? 'Alien-Lore-Features und Xi\'an-Sprachlektionen begleiten die Woche und liefern den kulturellen Hintergrund der Hersteller.' : 'Alien lore features and Xi\'an language lessons accompany the week and provide the cultural background of the manufacturers.'}</p></div>
    </div>
  </div>

  <!-- FULL-BLEED BAND #2 — The 2956 headliners -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/img-railen.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '03 · Headliner 2956' : '03 · Headliners 2956'}</div>
      <div class="big" style="font-size:clamp(2.6rem,9vw,6.5rem)">GATAC</div>
      <p>{de ? 'Für 2956 führen drei Gatac-Schiffe die Woche an: die flugfertige ' : 'For 2956, three Gatac ships lead the week: the flight-ready '}<b style="color:var(--accent-2)">Railen</b>{de ? ', der ' : ', the '}<b style="color:var(--accent-2)">Syulen</b>{de ? '-Starter und der neue ' : ' starter and the new '}<b style="color:var(--accent-2)">Tyilui</b>{de ? '-Träger.' : ' carrier.'}</p>
    </div>
  </section>

  <!-- MANUFACTURERS IN THE SPOTLIGHT — full-bleed flow (no framed cards) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>{de ? 'Hersteller im Spotlight' : 'Manufacturers in the spotlight'}</h2><span class="rule"></span></div>
      <div class="flow reveal">
        <div class="node"><div class="dot">G</div><h3>Gatac Manufacture</h3><p>{de ? 'Headliner 2956: Railen, Syulen und der neue Tyilui-Träger.' : '2956 headliners: Railen, Syulen and the new Tyilui carrier.'}</p></div>
        <div class="node"><div class="dot">A</div><h3>Aopoa</h3><p>{de ? 'Xi\'an-Bauweise — gezeigt mit Schiffen wie Khartu-al und Nox.' : 'Xi\'an craftsmanship — shown with ships like the Khartu-al and Nox.'}</p></div>
        <div class="node"><div class="dot">E</div><h3>Esperia</h3><p>{de ? 'Rekonstruierte Fremdtechnik — vertreten durch den Talon.' : 'Reconstructed alien technology — represented by the Talon.'}</p></div>
        <div class="node"><div class="dot">B</div><h3>Banu</h3><p>{de ? 'Die Banu-Reihe rundet das Aufgebot der Alien-Hersteller ab.' : 'The Banu line rounds out the roster of alien manufacturers.'}</p></div>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND #3 — Xenotech -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/img-tyilui.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Technik, die nicht von uns stammt' : 'Technology that doesn\'t come from us'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">XENOTECH</div>
      <p>{de ? 'Von Aopoas Khartu-al und Nox über Esperias Talon bis zur Banu-Reihe — Alien Week bringt zeitlich begrenzte Store-Aktionen, limitierte Lackierungen und Ausrüstung der fremden Werften.' : 'From Aopoa\'s Khartu-al and Nox to Esperia\'s Talon and the Banu line — Alien Week brings time-limited store deals, limited paints and gear from the alien shipyards.'}</p>
    </div>
  </section>

  <!-- CLOSING: mixed gallery + trailer (full-bleed close) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-alien-1.jpg"><img src="/assets/t-alien-1.jpg" alt={de ? 'Alien Week — Xenotech im Rampenlicht' : 'Alien Week — xenotech in the spotlight'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Alien Week · Xenotech</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-railen.jpg"><img src="/assets/img-railen.jpg" alt="Gatac Railen" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Railen</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-syulen.jpg"><img src="/assets/img-syulen.jpg" alt="Gatac Syulen" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Syulen</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-tyilui.jpg"><img src="/assets/img-tyilui.jpg" alt="Gatac Tyilui" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Tyilui</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-alien-2.jpg"><img src="/assets/t-alien-2.jpg" alt={de ? 'Gatac-Schiff mit Grav-Lev-Antrieb im Asteroidenfeld' : 'Gatac ship with grav-lev drive in an asteroid field'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Gatac · Grav-Lev' : 'Gatac · grav-lev'}</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="Xh35kuWo0a4" style="background-image:url('/assets/vid-railen.jpg')"><span class="vlbl">Gatac &amp; Alien Week — Trailer</span><button class="play" aria-label={de ? 'Trailer abspielen' : 'Play trailer'}>▶</button></div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: offizieller Star-Citizen-YouTube-Kanal &amp; Star Citizen Wiki (© Cloud Imperium Games). · ' : 'Source: official Star Citizen YouTube channel &amp; Star Citizen Wiki (© Cloud Imperium Games). · '} /><a href="https://www.youtube.com/watch?v=Xh35kuWo0a4" target="_blank" rel="noopener">{de ? 'Auf YouTube ansehen ↗' : 'Watch on YouTube ↗'}</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-2-alien-week" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
