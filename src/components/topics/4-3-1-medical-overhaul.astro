---
// „4-3-1-medical-overhaul" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-3-1-medical-overhaul" image="/assets/t-med-1.jpg" />
<style is:inline>

/* Medical-Theme (4.3.1 "Virtue's Descent") */
:root{--bg:#0f2336;--bg-2:#13304a;--surface:#19395a;--surface-2:#21466b;--accent:#1FAA8C;--accent-2:#9bdfce;--hot:#D7263D;--text:#F2F5F7;--muted:#a9c0d4;--line:rgba(31,170,140,.22);--line-soft:rgba(242,245,247,.10);--glow:0 0 44px rgba(31,170,140,.30);--ink:#0f2336;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f2f8fe;--bg-2:#e6eff8;--surface:#fcfdff;--surface-2:#ecf3fc;--text:#1d2021;--muted:#485a6b;--accent:#066b56;--accent-2:#006454;--hot:#9d0223;--ink:#ffffff;--accent-media:#1FAA8C;--accent-2-media:#9bdfce;--line:rgba(44,130,108,.3);--line-soft:rgba(43,46,47,.12);--glow:0 6px 22px rgba(44,130,108,.18)}



/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.vitals{font-family:var(--font-ui);font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--accent-2);font-size:.74rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.3.1', href: '/de/patches/sc-4-3-1.html' }, { label: "Medical Overhaul" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.3.1', href: '/patches/sc-4-3-1.html' }, { label: "Medical Overhaul" }]} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-med-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-3-1.html' : '/patches/sc-4-3-1.html'}>Alpha 4.3.1 · Virtue's Descent</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">{de ? 'Heilung, neu gedacht' : 'Healing, reimagined'}</span>Medical Overhaul</h1>
      <p class="lead">{de ? '4.3.1 baut das Medizin-System um: Wunden, Heilung, Rettung und Wiederbelebung funktionieren neu — angefuehrt vom RSI Apollo und dem MedGel-System.' : '4.3.1 rebuilds the medical system: wounds, healing, rescue and revival work in new ways — led by the RSI Apollo and the MedGel system.'}</p>
      <div class="tags"><span class="tag">Medical</span><span class="tag">MedGel</span><span class="tag">{de ? 'Bett-Stufen' : 'Bed tiers'}</span><span class="tag">RSI Apollo</span><span class="tag">Site B</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>MEDICAL OVERHAUL</span><span class="dot">◆</span><span>MEDGEL</span><span class="dot">◆</span><span>{de ? 'BETT-STUFEN T1-T3' : 'BED TIERS T1-T3'}</span><span class="dot">◆</span><span>RSI APOLLO</span><span class="dot">◆</span><span>SITE B</span><span class="dot">◆</span><span>{de ? 'WIEDERBELEBUNG' : 'REVIVAL'}</span><span class="dot">◆</span>
      <span>MEDICAL OVERHAUL</span><span class="dot">◆</span><span>MEDGEL</span><span class="dot">◆</span><span>{de ? 'BETT-STUFEN T1-T3' : 'BED TIERS T1-T3'}</span><span class="dot">◆</span><span>RSI APOLLO</span><span class="dot">◆</span><span>SITE B</span><span class="dot">◆</span><span>{de ? 'WIEDERBELEBUNG' : 'REVIVAL'}</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-3-1-medical-overhaul" />

  <!-- FULL-BLEED BAND — opening statement over the medbay (parallax) -->
  <section class="band band--center">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/img-apollo.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Ein System, von Grund auf neu' : 'A system rebuilt from the ground up'}</div>
      <div class="big outline">{de ? 'VITALWERTE.' : 'VITALS.'}</div>
      <p>{de ? 'Alpha 4.3.1 ueberarbeitet das Medizin-System grundlegend — wie Wunden entstehen und heilen und wie Spieler gerettet und wiederbelebt werden. Aus einem Randthema wird eine eigene Schleife.' : 'Alpha 4.3.1 fundamentally reworks the medical system — how wounds occur and heal and how players are rescued and revived. What was once a side topic becomes a loop of its own.'}</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">{de ? 'Bett-Stufen · T1 bis T3' : 'Bed tiers · T1 to T3'}</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">{de ? 'Schiff der Stunde · RSI Apollo' : 'Ship of the hour · RSI Apollo'}</div></div>
    <div class="s"><div class="n">MedGel</div><div class="c">{de ? 'Verbrauchsmaterial der Betten' : 'Consumable for the beds'}</div></div>
    <div class="s"><div class="n">Site B</div><div class="c">{de ? 'Onyx-Story · Dr. Jorrits Labor' : 'Onyx story · Dr. Jorrit\'s lab'}</div></div>
  </div>

  <!-- SCROLLYTELLING — die neue Versorgungs-Schleife (full-bleed, process fits) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>{de ? 'Die neue Versorgungs-Schleife' : 'The new care loop'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-med-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-6.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Verwundung' : 'Wounding'}</h3><p>{de ? 'Wunden entstehen jetzt nach neuen Regeln — der erste Baustein des ueberarbeiteten Medizin-Systems bestimmt, wie ein Spieler ueberhaupt zu Schaden kommt.' : 'Wounds now follow new rules — the first building block of the reworked medical system determines how a player takes damage in the first place.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'MedGel-Versorgung' : 'MedGel supply'}</h3><p>{de ? 'Medizin-Betten ziehen MedGel-Ladungen fuer ihre Funktionen. MedGel ist ein Verbrauchsmaterial — ist es leer, steht das Bett still.' : 'Medical beds draw MedGel charges for their functions. MedGel is a consumable — when it runs out, the bed goes idle.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Bett-Stufen T1-T3' : 'Bed tiers T1-T3'}</h3><p>{de ? 'Betten reichen von T1 bis T3 mit angepassten Respawn-Distanzen — T1 etwa das Krankenhaus in New Babbage mit Premium-Versorgung, T3 etwa die Cutlass Red.' : 'Beds range from T1 to T3 with adjusted respawn distances — T1 for instance the hospital in New Babbage with premium care, T3 for instance the Cutlass Red.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3>{de ? 'Wiederbelebung' : 'Revival'}</h3><p>{de ? 'Rettung und Wiederbelebung funktionieren neu — der letzte Schritt der Schleife entscheidet, wo und wie ein Spieler zurueck ins Verse kommt.' : 'Rescue and revival work in new ways — the final step of the loop decides where and how a player returns to the \'verse.'}</p></div>
    </div>
  </div>

  <!-- SPLIT — RSI Apollo (the ONE framed/split section) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/img-apollo2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '02 · Das Schiff der Stunde' : '02 · The ship of the hour'}</div>
        <h3>RSI Apollo — Medivac &amp; Triage</h3>
        <p>{de ? 'Mit dem Medizin-Umbau rueckt der ' : 'With the medical rework, the '}<b>RSI Apollo</b>{de ? ' ins Zentrum: ein dediziertes Sanitaetsschiff in zwei Ausrichtungen — ' : ' moves to center stage: a dedicated medical ship in two variants — '}<b>Medivac</b>{de ? ' fuer die Bergung, ' : ' for retrieval, '}<b>Triage</b>{de ? ' fuer die Versorgung.' : ' for care.'}</p>
        <p>{de ? 'Seine Medizin-Betten erhalten ' : 'Its medical beds gain '}<b>{de ? 'Regenerations-Faehigkeiten' : 'regeneration capabilities'}</b>{de ? ' und machen den Apollo zum fliegenden Stuetzpunkt fuer Teams, die tief im Verse operieren — dort, wo das naechste Krankenhaus weit entfernt ist.' : ' and turn the Apollo into a flying base for teams operating deep in the \'verse — where the nearest hospital is far away.'}</p>
      </div>
    </div>
  </section>

  <!-- VERSUS — die zwei Ausrichtungen des Apollo (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>✚ Medivac</h3>
        <ul>
          <li>{de ? 'Ausgelegt auf die Bergung Verwundeter aus dem Feld.' : 'Built to retrieve the wounded from the field.'}</li>
          <li>{de ? 'Holt gefallene Spieler dorthin, wo sie versorgt werden.' : 'Brings fallen players to where they can be treated.'}</li>
          <li>{de ? 'Eine von zwei medizinischen RSI-Apollo-Varianten.' : 'One of two medical RSI Apollo variants.'}</li>
          <li>{de ? 'Stärke: Verwundete schnell aus dem Feld bergen.' : 'Strength: quickly recover the wounded from the field.'}</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>✚ Triage</h3>
        <ul>
          <li>{de ? 'Ausgelegt auf die Versorgung an Bord.' : 'Built for on-board care.'}</li>
          <li>{de ? 'Medizin-Betten mit Regenerations-Faehigkeiten.' : 'Medical beds with regeneration capabilities.'}</li>
          <li>{de ? 'Fliegender Stuetzpunkt fuer laufende Operationen.' : 'Flying base for ongoing operations.'}</li>
          <li>{de ? 'Volle Versorgung an Bord — ohne Rückflug ins Hospital.' : 'Full care on board — no flight back to the hospital.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Bett-Stufen (parallax, big overlaid text) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-med-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '03 · Bett-Stufen' : '03 · Bed tiers'}</div>
      <div class="big" style="font-size:clamp(2.4rem,8vw,6rem)">T1 → T3</div>
      <p>{de ? 'Medizin-Betten haben Stufen von ' : 'Medical beds have tiers from '}<b style="color:var(--accent-2)">{de ? 'T1 bis T3' : 'T1 to T3'}</b>{de ? ' mit angepassten Respawn-Distanzen. ' : ' with adjusted respawn distances. '}<b style="color:var(--accent-2)">T1</b>{de ? ' steht etwa fuer das Krankenhaus in New Babbage mit Premium-Versorgung, ' : ' stands for instance for the hospital in New Babbage with premium care, '}<b style="color:var(--accent-2)">T3</b>{de ? ' etwa fuer die Cutlass Red — je hoeher die Stufe, desto naeher die Rueckkehr.' : ' for instance for the Cutlass Red — the higher the tier, the closer the return.'}</p>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Wer dich rettet, entscheidet, ' : 'Who rescues you decides '}<span class="hl">{de ? 'wo du wieder aufwachst.' : 'where you wake up again.'}</span></blockquote>
    <cite>Medical Overhaul · Alpha 4.3.1</cite>
  </section>

  <!-- FULL-BLEED BAND — Site B / Onyx-Story (parallax) -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/trailer-4-3-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '04 · Die Onyx-Story geht weiter' : '04 · The Onyx story continues'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">SITE B</div>
      <p>{de ? 'Die Onyx-Story setzt sich mit ' : 'The Onyx story continues with '}<b style="color:var(--accent-2)">Site B</b>{de ? ' fort: ' : ': '}<b style="color:var(--accent-2)">{de ? 'Dr. Jorrits Labor' : 'Dr. Jorrit\'s lab'}</b>{de ? ', in dem Spieler biologische Proben bergen — eine weitere Schicht zum Erkunden, eng verzahnt mit dem medizinischen Thema des Patches.' : ', where players recover biological samples — another layer to explore, tightly woven into the patch\'s medical theme.'}</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery — full-bleed close, no video embed) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/vid-apollo.jpg"><img src="/assets/vid-apollo.jpg" alt={de ? 'RSI Apollo — Medizin-Bay' : 'RSI Apollo — medical bay'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'RSI Apollo · Medizin-Bay' : 'RSI Apollo · Medical bay'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-med-1.jpg"><img src="/assets/t-med-1.jpg" alt={de ? 'Medizinische Versorgung im Med-Bay' : 'Medical care'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Versorgung · Medical Overhaul' : 'Care · Medical Overhaul'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-med-2.jpg"><img src="/assets/t-med-2.jpg" alt={de ? 'Medizin-Bett' : 'Medical bed'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Medizin-Bett · Bett-Stufen' : 'Medical bed · Bed tiers'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-apollo.jpg"><img src="/assets/img-apollo.jpg" alt={de ? 'RSI Apollo im Flug' : 'RSI Apollo in flight'} loading="lazy"><span class="zoomic">⤢</span><figcaption>RSI Apollo</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-apollo2.jpg"><img src="/assets/img-apollo2.jpg" alt="RSI Apollo — Triage" loading="lazy"><span class="zoomic">⤢</span><figcaption>Apollo · Triage</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-3-1.jpg"><img src="/assets/trailer-4-3-1.jpg" alt="Virtue's Descent — Site B" loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Site B · Onyx-Story' : 'Site B · Onyx story'}</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: offizieller Star-Citizen-Kanal &amp; Star Citizen Wiki (© Cloud Imperium Games). Bilder zu Veranschaulichung, Fan-Content-Nutzung.' : 'Source: official Star Citizen channel &amp; Star Citizen Wiki (© Cloud Imperium Games). Images for illustration, fan-content use.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-3-1-medical-overhaul" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
