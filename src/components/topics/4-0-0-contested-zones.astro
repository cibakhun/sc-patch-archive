---
// „4-0-0-contested-zones" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import OnepagerLink from '../../components/OnepagerLink.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-0-0-contested-zones" image="/assets/cz-facility.jpg" />
<style is:inline>

/* Pyro-Theme (geerbt von 4.0.0) */
:root{
  --bg:#120f0c;--bg-2:#1a1714;--surface:#211b16;--surface-2:#2b231b;
  --accent:#ff5a1f;--accent-2:#d9d12a;--hot:#c0271f;
  --text:#f3e9df;--muted:#b6a596;
  --line:rgba(255,90,31,.22);--line-soft:rgba(243,233,223,.10);
  --glow:0 0 44px rgba(255,90,31,.32);--ink:#120f0c;
  --maxw:1180px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#fbf7f2;--bg-2:#f1ede9;--surface:#fefdfc;--surface-2:#f9f1e9;--text:#251e17;--muted:#645547;--accent:#9e2f01;--accent-2:#5c5801;--hot:#9e0004;--ink:#ffffff;--accent-media:#ff5a1f;--accent-2-media:#d9d12a;--line:rgba(163,91,69,.3);--line-soft:rgba(52,44,37,.12);--glow:0 6px 22px rgba(171,85,59,.18)}




/* page-local accents */
.hero h1{font-size:clamp(3.4rem,14vw,11rem)}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.0.0', href: '/de/patches/sc-4-0-0.html' }, { label: "Contested Zones" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.0.0', href: '/patches/sc-4-0-0.html' }, { label: "Contested Zones" }]} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/cz-facility.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-0-0.html' : '/patches/sc-4-0-0.html'}>Alpha 4.0.0 · Destination Pyro</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">{de ? 'Pyros Hochrisiko-Beutezonen' : 'Pyro\'s High-Risk Loot Zones'}</span>Contested Zones</h1>
      <p class="lead">{de ? 'Abgeriegelte Areale tief in Pyros Anlagen, in denen KI-Fraktionen, rivalisierende Spieler und das beste Loot des Verse aufeinandertreffen — und nur überlebt, wer wieder rauskommt.' : 'Sealed-off areas deep inside Pyro\'s facilities, where AI factions, rival players and the best loot in the Verse collide — and only those who make it back out survive.'}</p>
      <div class="tags"><span class="tag hot">PvPvE</span><span class="tag">On-Foot / FPS</span><span class="tag">High-Tier Loot</span><span class="tag">{de ? 'Extraktion' : 'Extraction'}</span><span class="tag">{de ? 'Keine Sicherheitszone' : 'No Safe Zone'}</span></div>
      <div class="hero__play" data-lb="yt:DE3ePRgpUQo"><span class="pbtn">▶</span>{de ? 'Trailer ansehen' : 'Watch trailer'}</div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>PVPVE</span><span class="dot">◆</span><span>{de ? 'EXTRAKTION' : 'EXTRACTION'}</span><span class="dot">◆</span><span>{de ? 'KEIN GESETZ' : 'NO LAW'}</span><span class="dot">◆</span><span>HIGH-TIER LOOT</span><span class="dot">◆</span><span>{de ? 'KI-WACHEN' : 'AI GUARDS'}</span><span class="dot">◆</span><span>{de ? 'TOD = LOOT WEG' : 'DEATH = LOOT GONE'}</span><span class="dot">◆</span><span>RUIN STATION</span><span class="dot">◆</span>
      <span>PVPVE</span><span class="dot">◆</span><span>{de ? 'EXTRAKTION' : 'EXTRACTION'}</span><span class="dot">◆</span><span>{de ? 'KEIN GESETZ' : 'NO LAW'}</span><span class="dot">◆</span><span>HIGH-TIER LOOT</span><span class="dot">◆</span><span>{de ? 'KI-WACHEN' : 'AI GUARDS'}</span><span class="dot">◆</span><span>{de ? 'TOD = LOOT WEG' : 'DEATH = LOOT GONE'}</span><span class="dot">◆</span><span>RUIN STATION</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-0-contested-zones" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="6">0</div><div class="c">{de ? 'Ruinierte Welten · Pyro' : 'Ruined Worlds · Pyro'}</div></div>
    <div class="s"><div class="n count" data-to="500">0</div><div class="c">{de ? 'Spieler pro Shard' : 'Players per Shard'}</div></div>
    <div class="s"><div class="n count" data-to="0">0</div><div class="c">{de ? 'Sicherheitszonen' : 'Safe Zones'}</div></div>
    <div class="s"><div class="n">PvPvE</div><div class="c">{de ? 'Endgame-Premiere im PU' : 'Endgame Debut in the PU'}</div></div>
  </div>

  <!-- OVERVIEW as SPLIT -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/cz-combat.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '01 · Überblick' : '01 · Overview'}</div>
        <h3>{de ? 'Die erste echte PvPvE-Beutezone' : 'The first true PvPvE loot zone'}</h3>
        <p>{de ? 'Mit dem Sprung nach Pyro brachte Alpha 4.0.0 die ' : 'With the jump to Pyro, Alpha 4.0.0 brought the '}<b>Contested Zones</b>{de ? ' — versiegelte Areale innerhalb bestimmter Pyro-Standorte, in denen sich die wertvollste Beute des Spiels findet. Keine Sicherheitszone, keine Garantien.' : ' — sealed areas inside certain Pyro locations, home to the most valuable loot in the game. No safe zone, no guarantees.'}</p>
        <p>{de ? 'Wer eintritt, kämpft sich zu Fuß gegen KI-Fraktionen vor und teilt sich den Raum mit jedem anderen Spieler, der dasselbe will. Es ist die erste richtige ' : 'Whoever enters fights their way through AI factions on foot and shares the space with every other player after the same thing. It\'s the first real '}<b>{de ? 'PvPvE-Endgame-Aktivität' : 'PvPvE endgame activity'}</b>{de ? ' im persistenten Universum — gebaut für genau die gesetzlose Stimmung, die Pyro definiert.' : ' in the persistent universe — built for exactly the lawless mood that defines Pyro.'}</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND (parallax) -->
  <section class="band" style="padding-top:0">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-pyro-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Pyro kennt kein Gesetz' : 'Pyro Knows No Law'}</div>
      <div class="big outline">{de ? 'KEIN NETZ.' : 'NO NET.'}</div>
      <p>{de ? 'Selbst der Trupp, mit dem du eingedrungen bist, kann sich für das Loot gegen dich wenden. Die brüchige Waffenruhe hält nur, solange die Taschen leer sind — kurz vor dem Ausgang, wenn alle voll beladen sind, zerbricht sie zuerst.' : 'Even the crew you broke in with can turn on you for the loot. The fragile ceasefire only holds while pockets are empty — just before the exit, when everyone is fully loaded, it shatters first.'}</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: So läuft ein Run -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>{de ? 'So läuft ein Run' : 'How a run plays out'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-pyro-7.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-loot.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-ruin.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Eindringen' : 'Break in'}</h3><p>{de ? 'Lande an einem Pyro-Standort mit Contested Zone und betritt das gesicherte Areal zu Fuß — ab hier bist du auf dich gestellt.' : 'Land at a Pyro location with a Contested Zone and enter the secured area on foot — from here on, you\'re on your own.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Durchkämpfen' : 'Fight through'}</h3><p>{de ? 'Schalte feindliche KI-Wachen aus und arbeite dich tiefer zu den verschlossenen Loot-Räumen vor — während andere Spieler dasselbe versuchen.' : 'Take out hostile AI guards and push deeper toward the locked loot rooms — while other players attempt the same.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Loot sichern' : 'Secure the loot'}</h3><p>{de ? 'Plündere hochwertige Waffen, Rüstung, Schiffskomponenten und Wertgüter aus den Depots — je tiefer, desto besser.' : 'Plunder high-value weapons, armor, ship components and valuables from the depots — the deeper you go, the better.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3>{de ? 'Lebend raus' : 'Get out alive'}</h3><p>{de ? 'Bring die Beute zurück zum Schiff und fliehe. Stirbst du in der Zone, ist alles, was du trägst, verloren.' : 'Bring the haul back to your ship and escape. Die in the zone and everything you carry is lost.'}</p></div>
    </div>
  </div>

  <!-- VERSUS: Risiko vs Belohnung (full-bleed) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>{de ? '⚠ Risiko' : '⚠ Risk'}</h3>
        <ul>
          <li>{de ? 'Schwer bewaffnete Outlaw-Gang-Wachen verteidigen jedes Depot bis zum letzten Mann.' : 'Heavily armed Outlaw gang guards defend every depot to the last man.'}</li>
          <li>{de ? 'Kein Bett, kein Med-Bay in der Zone — wer fällt, hat keinen schnellen Respawn vor Ort.' : 'No bed, no med-bay in the zone — whoever falls has no quick respawn on site.'}</li>
          <li>{de ? 'Tod bedeutet Verlust der gesamten getragenen Beute an deine Mörder.' : 'Death means losing all carried loot to your killers.'}</li>
          <li>{de ? 'PvPvE-Sozialgefüge: Wackelige Waffenruhen zerbrechen, ein scheinbarer Verbündeter wird zum Verräter.' : 'PvPvE social dynamics: shaky ceasefires shatter, a seeming ally turns traitor.'}</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>{de ? '★ Belohnung' : '★ Reward'}</h3>
        <ul>
          <li>{de ? 'High-Tier-Schiffskomponenten für deine eigene Flotte.' : 'High-tier ship components for your own fleet.'}</li>
          <li>{de ? 'Hochwertige FPS-Waffen und Rüstung aus den verschlossenen Räumen.' : 'High-value FPS weapons and armor from the locked rooms.'}</li>
          <li>{de ? 'Wertvolle Handels- und Schmuggelgüter zum Weiterverkauf.' : 'Valuable trade and contraband goods to resell.'}</li>
          <li>{de ? 'Je tiefer du in die Zone vordringst, desto wertvoller das Loot.' : 'The deeper you push into the zone, the more valuable the loot.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WO IN PYRO — full-bleed band (image as background, design on top) -->
  <section class="band">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-ruin-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '03 · Wo in Pyro?' : '03 · Where in Pyro?'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,7vw,5.5rem)">RUIN STATION</div>
      <p>{de ? 'Contested Zones sitzen in ausgewählten Pyro-Standorten — von Outlaw-Gangs gehaltene Industrie- und Versorgungsanlagen, die als Beutezone versiegelt sind. Typische Schauplätze sind verfallene Bergbau- und Raffinerie-Plattformen sowie aufgegebene Versorgungs- und Lagerdepots, in denen die wertvollste Beute eingeschlossen liegt. Pyros sechs Planeten, sein Asteroidenfeld und Stationen wie ' : 'Contested Zones sit in select Pyro locations — industrial and supply facilities held by Outlaw gangs, sealed off as loot zones. Typical settings are derelict mining and refinery platforms as well as abandoned supply and storage depots, where the most valuable loot lies locked away. Pyro\'s six planets, its asteroid field and stations like '}<b style="color:var(--accent-2)">Ruin Station</b>{de ? ', eine ehemalige Gold-Horizon-Bergbauplattform, bilden die gesetzlose Kulisse.' : ', a former Gold Horizon mining platform, form the lawless backdrop.'}</p>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Plünderst du ' : 'Will you plunder '}<span class="hl">{de ? 'das beste Loot des Verse' : 'the best loot in the Verse'}</span>{de ? ' — oder wirst du selbst zur Beute?' : ' — or become the prey yourself?'}</blockquote>
    <cite>Contested Zones · Pyro</cite>
  </section>

  <!-- MEDIA (mixed gallery + trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-pyro-3.jpg"><img src="/assets/t-pyro-3.jpg" alt={de ? 'Zerborstener, glühender Mond mit Trümmerfeld in Pyro' : 'Shattered, glowing moon with a debris field in Pyro'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Zerborstener Mond · Pyro' : 'Shattered Moon · Pyro'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/cz-facility.jpg"><img src="/assets/cz-facility.jpg" alt={de ? 'Contested Zone — Anlage von innen' : 'Contested Zone — facility interior'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Anlageninneres' : 'Facility Interior'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-loot.jpg"><img src="/assets/cz-loot.jpg" alt="High-Tier Loot" loading="lazy"><span class="zoomic">⤢</span><figcaption>High-Tier Loot</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-pyro-7.jpg"><img src="/assets/t-pyro-7.jpg" alt={de ? 'Patch City — Outlaw-Station in Pyros Asteroidenfeld' : 'Patch City — Outlaw station in Pyro\'s asteroid field'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Patch City · Outlaw-Hafen' : 'Patch City · Outlaw Port'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-ruin-1.jpg"><img src="/assets/t-ruin-1.jpg" alt={de ? 'Ruin Station vor dem Planeten Terminus' : 'Ruin Station in front of the planet Terminus'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Ruin Station · Terminus</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="DE3ePRgpUQo" style="background-image:url('/assets/trailer-4-0-0.jpg')"><span class="vlbl">Destination Pyro — Trailer</span><button class="play" aria-label={de ? 'Trailer abspielen' : 'Play trailer'}>▶</button></div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: offizieller Star-Citizen-YouTube-Kanal &amp; Star Citizen Wiki (© Cloud Imperium Games). · ' : 'Source: official Star Citizen YouTube channel &amp; Star Citizen Wiki (© Cloud Imperium Games). · '} /><a href="https://www.youtube.com/watch?v=DE3ePRgpUQo" target="_blank" rel="noopener">{de ? 'Auf YouTube ansehen ↗' : 'Watch on YouTube ↗'}</a></p>
    </div>
  </section>

  {/* Den Onepager gibt es nur auf Deutsch (public/onepager/) — die EN-Seite
      verlinkte ihn deshalb noch nie und soll das auch nicht anfangen. */}
  {de && (
  <OnepagerLink
    href="/onepager/contested-zones/index.html"
    title="Contested Zones — Visueller Guide"
    note="Eigenständiger Onepager: Station-Karte, Keycards & Loot-Items im Überblick."
  />
  )}

</main>

<RelatedTopics topicSlug="4-0-0-contested-zones" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
