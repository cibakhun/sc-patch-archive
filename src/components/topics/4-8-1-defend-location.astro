---
// „4-8-1-defend-location" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-8-1-defend-location" image="/assets/t-def-1.jpg" />
<style is:inline>

/* Strike-Theme (4.8.x) */
:root{--bg:#0b1014;--bg-2:#111820;--surface:#17202a;--surface-2:#1f2b38;--accent:#36c5d6;--accent-2:#E6952A;--hot:#D94A38;--text:#e8f0f4;--muted:#9bb0ba;--line:rgba(54,197,214,.22);--line-soft:rgba(232,240,244,.10);--glow:0 0 44px rgba(54,197,214,.30);--ink:#0b1014;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f1f9ff;--bg-2:#e6eff9;--surface:#fcfdff;--surface-2:#ecf3fc;--text:#1a2023;--muted:#485b64;--accent:#036771;--accent-2:#794900;--hot:#9c0d01;--ink:#ffffff;--accent-media:#36c5d6;--accent-2-media:#E6952A;--line:rgba(43,127,137,.3);--line-soft:rgba(41,47,50,.12);--glow:0 6px 22px rgba(43,127,137,.18)}




/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.band .big.huge{font-size:clamp(3rem,15vw,11rem)}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.8.1', href: '/de/patches/sc-4-8-1.html' }, { label: "Defend Location" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.8.1', href: '/patches/sc-4-8-1.html' }, { label: "Defend Location" }]} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-def-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-8-1.html' : '/patches/sc-4-8-1.html'}>Alpha 4.8.1 · Gameplay</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Neuer Missionstyp' : ' &nbsp;·&nbsp; New mission type'} /></div>
      <h1><span class="thin">{de ? 'Halte die Stellung' : 'Hold the line'}</span>Defend Location</h1>
      <p class="lead">{de ? 'Der neue wellenbasierte Raumkampf-Missionstyp aus 4.8.1: verteidige Asteroiden-Mining-Basen gegen Bomber-Anfluege — quer ueber 385 Einsatzorte in Stanton und Pyro.' : 'The new wave-based space-combat mission type from 4.8.1: defend asteroid mining bases against bomber runs — across 385 locations in Stanton and Pyro.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Neuer Missionstyp' : 'New mission type'}</span><span class="tag">{de ? '385 Orte' : '385 locations'}</span><span class="tag">{de ? 'Bomber-Abwehr' : 'Bomber defense'}</span><span class="tag">{de ? 'Escort-Hybrid' : 'Escort hybrid'}</span><span class="tag">Blueprints</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>DEFEND LOCATION</span><span class="dot">◆</span><span>{de ? '385 EINSATZORTE' : '385 LOCATIONS'}</span><span class="dot">◆</span><span>{de ? 'BOMBER-ABWEHR' : 'BOMBER DEFENSE'}</span><span class="dot">◆</span><span>{de ? 'ESCORT-HYBRID' : 'ESCORT HYBRID'}</span><span class="dot">◆</span><span>FOXWELL</span><span class="dot">◆</span><span>BLUEPRINTS</span><span class="dot">◆</span>
      <span>DEFEND LOCATION</span><span class="dot">◆</span><span>{de ? '385 EINSATZORTE' : '385 LOCATIONS'}</span><span class="dot">◆</span><span>{de ? 'BOMBER-ABWEHR' : 'BOMBER DEFENSE'}</span><span class="dot">◆</span><span>{de ? 'ESCORT-HYBRID' : 'ESCORT HYBRID'}</span><span class="dot">◆</span><span>FOXWELL</span><span class="dot">◆</span><span>BLUEPRINTS</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AT A GLANCE (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-8-1-defend-location" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="385">0</div><div class="c"><Fragment set:html={de ? 'Einsatzorte · Stanton & Pyro' : 'Locations · Stanton & Pyro'} /></div></div>
    <div class="s"><div class="n count" data-to="149">0</div><div class="c">{de ? 'Verteidigbare Basen' : 'Defendable bases'}</div></div>
    <div class="s"><div class="n count" data-to="6">0</div><div class="c">{de ? 'Schwierigkeitsstufen' : 'Difficulty tiers'}</div></div>
    <div class="s"><div class="n">4.8.1</div><div class="c">{de ? 'Kernfeature des Patches' : 'Core feature of the patch'}</div></div>
  </div>

  <!-- OVERVIEW as FULL-BLEED BAND (image as background, design on top) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-def-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '01 · Das Kernfeature' : '01 · The core feature'}</div>
      <div class="big huge outline">{de ? 'WELLE UM WELLE' : 'WAVE AFTER WAVE'}</div>
      <p><b style="color:var(--accent-2)">Defend Location</b>{de ? ' ist der neue wellenbasierte Raumkampf-Missionstyp und das Kernfeature von Alpha 4.8.1. Spieler verteidigen Asteroiden-Mining-Basen gegen feindliche Bomber — Anflug für Anflug, bis das Feld geräumt ist.' : ' is the new wave-based space-combat mission type and the core feature of Alpha 4.8.1. Players defend asteroid mining bases against enemy bombers — run after run, until the field is cleared.'}</p>
    </div>
  </section>

  <!-- THE TWO TARGETS — VERSUS (two sides fit: Standard vs Escort-Hybrid) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>{de ? '⊕ Standard · Bomber-Abwehr' : '⊕ Standard · Bomber defense'}</h3>
        <ul>
          <li>{de ? 'Feindliche Bomber fliegen Angriffe auf kritische Infrastruktur wie Tanks.' : 'Enemy bombers run attacks on critical infrastructure such as tanks.'}</li>
          <li>{de ? 'Jeder Bomber muss vor dem Abwurf abgefangen werden.' : 'Every bomber must be intercepted before it drops its payload.'}</li>
          <li>{de ? 'Lässt du einen durch, trifft seine Ladung die Basis.' : 'Let one through and its payload hits the base.'}</li>
          <li>{de ? 'Reines Verteidigungsziel: die Anlage muss stehen bleiben.' : 'Pure defense objective: the facility must stay standing.'}</li>
        </ul>
      </div>
      <div class="vs">/</div>
      <div class="side b">
        <h3>{de ? '★ Hybrid · Escort-Element' : '★ Hybrid · Escort element'}</h3>
        <ul>
          <li>{de ? 'Ein befreundetes Schiff startet oder landet an der Basis.' : 'A friendly ship takes off from or lands at the base.'}</li>
          <li>{de ? 'Feindliche Jäger nehmen es ins Visier, während es verwundbar ist.' : 'Enemy fighters target it while it is vulnerable.'}</li>
          <li>{de ? 'Du schützt zugleich die Infrastruktur und das Schiff.' : 'You protect the infrastructure and the ship at the same time.'}</li>
          <li>{de ? 'Beide Ziele müssen erfüllt werden — sonst scheitert der Auftrag.' : 'Both objectives must be met — otherwise the contract fails.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ABLAUF — kompakter Dreischritt. Bewusst KEIN Scrollytelling: eine
       Wellen-Verteidigung ist kein Reiseprozess mit eigenen visuellen
       Stationen; Escort & Belohnung stehen bereits in Versus bzw. Split. -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">02</span><h2>{de ? 'So läuft eine Verteidigung' : 'How a defense plays out'}</h2><span class="rule"></span></div>
      <div class="flow reveal" style="margin-top:2.4rem">
        <div class="node"><div class="dot">1</div><h3>{de ? 'Basis wählen' : 'Pick a base'}</h3><p>{de ? '149 verteidigbare Basen über Stanton und Pyro, sechs Stufen von Very Easy bis Super — die Wahl bestimmt Gegner und Lohn.' : '149 defendable bases across Stanton and Pyro, six tiers from Very Easy to Super — the choice determines the enemies and the reward.'}</p></div>
        <div class="node"><div class="dot">2</div><h3>{de ? 'Stellung beziehen' : 'Take up position'}</h3><p>{de ? 'Erreiche die Asteroiden-Mining-Basis vor dem ersten Anflug. Die Infrastruktur darf nicht fallen — ab jetzt zählt jede Sekunde.' : 'Reach the asteroid mining base before the first run. The infrastructure must not fall — from here on, every second counts.'}</p></div>
        <div class="node"><div class="dot">3</div><h3>{de ? 'Wellen brechen' : 'Break the waves'}</h3><p>{de ? 'Bomber vor dem Abwurf abfangen — Anflug für Anflug, und jede Welle drückt härter als die letzte.' : 'Intercept bombers before they drop — run after run, and every wave pushes harder than the last.'}</p></div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Jeder durchgelassene Bomber ist ' : 'Every bomber let through is '}<span class="hl">{de ? 'ein Krater in der Basis' : 'a crater in the base'}</span>.</blockquote>
    <cite>Defend Location · Alpha 4.8.1</cite>
  </section>

  <!-- AUFTRAGGEBER & BELOHNUNG — the ONE framed/split section -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-hh-3.jpg')"></div></div>
      <div class="split__text">
        <div class="kx"><Fragment set:html={de ? '03 · Auftraggeber & Lohn' : '03 · Contractors & reward'} /></div>
        <h3>{de ? 'Wer ruft — und was es bringt' : 'Who calls — and what it pays'}</h3>
        <p>{de ? 'Die Aufträge kommen von Namen wie ' : 'The contracts come from names like '}<b>Foxwell</b>{de ? ', den ' : ', the '}<b>Head Hunters</b>, <b>CFP</b>{de ? ' und ' : ' and '}<b>Rough and Ready</b>{de ? '. Jede Fraktion stellt ihre eigenen Basen unter deinen Schutz.' : '. Each faction places its own bases under your protection.'}</p>
        <p>{de ? 'Belohnt wird mit ' : 'Rewards come in '}<b>aUEC</b>, <b>Reputation</b>{de ? ' und ' : ' and '}<b>{de ? 'Org-Scrip' : 'Org Scrip'}</b>{de ? ' — und auf den höheren Schwierigkeitsstufen zusätzlich mit begehrten ' : ' — and on the higher difficulty tiers, additionally coveted '}<b>{de ? 'Crafting-Blueprints' : 'crafting blueprints'}</b>.</p>
      </div>
    </div>
  </section>

  <!-- SCALE — full-bleed band (big number, parallax, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-pyro-5.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '04 · Massstab' : '04 · Scale'}</div>
      <div class="big huge">385</div>
      <p>{de ? 'Einsatzorte verteilen sich über Stanton und Pyro — gespeist aus ' : 'Locations spread across Stanton and Pyro — fed from '}<b style="color:var(--accent-2)">{de ? '149 Basen' : '149 bases'}</b>{de ? ' mit sechs Schwierigkeitsstufen von Very Easy bis Super. Der Hybrid-Charakter macht Defend Location zur Brücke zwischen klassischer Bounty- und Escort-Mission.' : ' with six difficulty tiers from Very Easy to Super. Its hybrid character makes Defend Location the bridge between the classic bounty and escort mission.'}</p>
    </div>
  </section>

  <!-- MEDIA — closing mixed gallery (full-bleed close) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-def-1.jpg"><img src="/assets/t-def-1.jpg" alt={de ? 'Defend Location — Raumkampf über einer Mining-Basis' : 'Defend Location — space combat above a mining base'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Stellung halten' : 'Hold the line'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-def-2.jpg"><img src="/assets/t-def-2.jpg" alt={de ? 'Bomber-Anflug auf die Infrastruktur' : 'Bomber run against the infrastructure'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Bomber-Anflug' : 'Bomber run'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt={de ? 'Aegis Hammerhead — schwerer Verteidiger' : 'Aegis Hammerhead — heavy defender'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Schwere Abwehr' : 'Heavy defense'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-idris.jpg"><img src="/assets/img-idris.jpg" alt={de ? 'Aegis Idris im Einsatz' : 'Aegis Idris in action'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Eskorte' : 'Escort'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/cz-ruin.jpg"><img src="/assets/cz-ruin.jpg" alt={de ? 'Verlassene Stationsruine als Schauplatz' : 'Abandoned station as a setting'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Vorposten · Schauplatz' : 'Outpost · setting'}</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: Star Citizen Wiki &amp; Patch-Notes zu Alpha 4.8.1 (© Cloud Imperium Games). Inoffizielle Fan-Aufbereitung.' : 'Source: Star Citizen Wiki &amp; patch notes for Alpha 4.8.1 (© Cloud Imperium Games). Unofficial fan compilation.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-1-defend-location" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
