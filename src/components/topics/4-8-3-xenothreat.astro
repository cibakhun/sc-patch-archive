---
// „4-8-3-xenothreat" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-8-3-xenothreat" image="/assets/t-xeno-1.jpg" />
<style is:inline>

/* Tactical-Strike-Theme (4.8.x) */
:root{--bg:#0d0a16;--bg-2:#140f24;--surface:#1a1330;--surface-2:#231a3e;--accent:#E8651E;--accent-2:#1FB8A6;--hot:#E8651E;--text:#ede9f5;--muted:#a39db5;--line:rgba(232,101,30,.22);--line-soft:rgba(237,233,245,.10);--glow:0 0 44px rgba(232,101,30,.30);--ink:#0d0a16;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f8f6ff;--bg-2:#eeecf8;--surface:#fdfdff;--surface-2:#f2f1fb;--text:#201e26;--muted:#5a546a;--accent:#963a01;--accent-2:#056359;--hot:#893400;--ink:#ffffff;--accent-media:#E8651E;--accent-2-media:#1FB8A6;--line:rgba(162,93,63,.3);--line-soft:rgba(46,44,53,.12);--glow:0 6px 22px rgba(170,87,49,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.kx-tag{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.8.3', href: '/de/patches/sc-4-8-3.html' }, { label: "XenoThreat" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.8.3', href: '/patches/sc-4-8-3.html' }, { label: "XenoThreat" }]} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-xeno-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-8-3.html' : '/patches/sc-4-8-3.html'}>Alpha 4.8.3 · XenoThreat</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Fraktion' : ' &nbsp;·&nbsp; Faction'} /></div>
      <h1><span class="thin">{de ? 'Der Angriff auf Stanton' : 'The Assault on Stanton'}</span>XenoThreat</h1>
      <p class="lead">{de ? 'Eine menschen-suprematistische, anti-alien Outlaw-Fraktion: mit 4.8.3 kehrt ihr Assault-on-Stanton-Event zurück — diesmal nicht als kinoreifer Server-Krieg, sondern als punktebasiertes PvE-Kampf-Event vom 1. bis 15. Juli 2026.' : 'A human-supremacist, anti-alien outlaw faction: with 4.8.3 their Assault-on-Stanton event returns — this time not as a cinematic server-wide war, but as a points-based PvE combat event running July 1–15, 2026.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Outlaw-Fraktion' : 'Outlaw faction'}</span><span class="tag">Assault on Stanton</span><span class="tag">{de ? 'Punkte-Event' : 'Points event'}</span><span class="tag">Foxwell Enforcement</span><span class="tag">{de ? 'Idris-Ziel' : 'Idris objective'}</span></div>
      <div class="hero__play" data-lb="yt:SsOtI2dtvBc"><span class="pbtn">▶</span>{de ? 'Trailer ansehen' : 'Watch trailer'}</div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>XENOTHREAT</span><span class="dot">◆</span><span>ASSAULT ON STANTON</span><span class="dot">◆</span><span>FOXWELL ENFORCEMENT</span><span class="dot">◆</span><span>{de ? '120.000 PUNKTE' : '120,000 POINTS'}</span><span class="dot">◆</span><span>{de ? '5 MISSIONSTYPEN' : '5 MISSION TYPES'}</span><span class="dot">◆</span><span>{de ? 'IDRIS-FREGATTE' : 'IDRIS FRIGATE'}</span><span class="dot">◆</span>
      <span>XENOTHREAT</span><span class="dot">◆</span><span>ASSAULT ON STANTON</span><span class="dot">◆</span><span>FOXWELL ENFORCEMENT</span><span class="dot">◆</span><span>{de ? '120.000 PUNKTE' : '120,000 POINTS'}</span><span class="dot">◆</span><span>{de ? '5 MISSIONSTYPEN' : '5 MISSION TYPES'}</span><span class="dot">◆</span><span>{de ? 'IDRIS-FREGATTE' : 'IDRIS FRIGATE'}</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AT A GLANCE (data register, uniform) -->
  <TopicFacts topicSlug="4-8-3-xenothreat" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="120000">0</div><div class="c">{de ? 'Event-Punkte für die volle Reward-Spur' : 'Event points for the full reward track'}</div></div>
    <div class="s"><div class="n count" data-to="5">0</div><div class="c">{de ? 'Missionstypen sammeln Punkte' : 'Mission types earn points'}</div></div>
    <div class="s"><div class="n">{de ? '1.–15. JULI' : 'JULY 1–15'}</div><div class="c">{de ? 'Event-Fenster 2026' : 'Event window 2026'}</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax) — who is XenoThreat -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-xeno-3.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Aus den Ruinen von Pyro' : 'From the ruins of Pyro'}</div>
      <div class="big outline">{de ? 'VERRAT.' : 'BETRAYAL.'}</div>
      <p>{de ? 'XenoThreat ist eine menschen-suprematistische, alien-feindliche Outlaw-Gruppe aus Pyro — grösstenteils ehemalige ' : 'XenoThreat is a human-supremacist, alien-hostile outlaw group out of Pyro — mostly former '}<b style="color:var(--accent-2)">{de ? 'UEE-Navy-Mitglieder' : 'UEE Navy members'}</b>{de ? ', die die Koexistenz der UEE mit fremden Spezies als Verrat an der Menschheit sehen. Weil Stanton diese Koexistenz stützt, greift XenoThreat das System an.' : ' who see the UEE\'s coexistence with alien species as a betrayal of humanity. Because Stanton upholds that coexistence, XenoThreat attacks the system.'}</p>
    </div>
  </section>

  <!-- OVERVIEW as SPLIT (the one framed/split section) -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-hh-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '01 · Wer sie sind' : '01 · Who they are'}</div>
        <h3>{de ? 'Deserteure mit einer Doktrin' : 'Deserters with a doctrine'}</h3>
        <p>{de ? 'Was XenoThreat von gewöhnlichen Outlaws unterscheidet, ist die Überzeugung. Es sind ausgebildete Soldaten, die ihre Loyalität zur UEE aufgekündigt haben — überzeugt davon, dass das Bündnis mit fremden Spezies die Menschheit verrät.' : 'What sets XenoThreat apart from ordinary outlaws is conviction. These are trained soldiers who have renounced their loyalty to the UEE — convinced that the alliance with alien species betrays humanity.'}</p>
        <p>{de ? 'Aus den gesetzlosen Tiefen Pyros heraus formen sie keine bloße Bande, sondern eine ' : 'Out of the lawless depths of Pyro they form not a mere gang, but a '}<b>{de ? 'paramilitärische Fraktion' : 'paramilitary faction'}</b>{de ? ' mit Schiffen, Disziplin und einem Ziel: Stanton dort zu treffen, wo es die Alien-Koexistenz am offensten lebt.' : ' with ships, discipline and a single goal: to hit Stanton where it most openly lives alien coexistence.'}</p>
      </div>
    </div>
  </section>

  <!-- HISTORY — full-bleed band (image as background, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/cz-ruin.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '02 · Der historische Auftakt (2951)' : '02 · The historical opening (2951)'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">STANTON 2951</div>
      <p>{de ? 'Schon 2951 überfiel XenoThreat einen zivilen Konvoi in Stanton auf dem Weg nach Terra — alle Schiffe zerstört, die Crews hingerichtet. Die UEE-Navy mobilisierte die ' : 'Back in 2951 XenoThreat ambushed a civilian convoy in Stanton bound for Terra — all ships destroyed, the crews executed. The UEE Navy mobilized the '}<b style="color:var(--accent-2)">Civilian Defense Force</b>{de ? '; nach elf Tagen Gefechten zog sich XenoThreat zurück nach Pyro. 4.8.3 lässt sie zurückkehren.' : '; after eleven days of fighting XenoThreat withdrew to Pyro. 4.8.3 brings them back.'}</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: The five mission types -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>{de ? 'Fünf Wege, Punkte zu sammeln' : 'Five ways to earn points'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-xeno-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-hammerhead.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-hh-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-def-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-idris.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Alien-Schiffe verteidigen' : 'Defend alien-built ships'}</h3><p>{de ? 'Von Aliens gebaute Schiffe geraten unter Beschuss der Isolationisten — Spieler halten sie frei.' : 'Alien-made ships come under fire from isolationist forces — players keep them clear.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Anti-Alien-Jäger ausschalten' : 'Clear anti-alien fighters'}</h3><p>{de ? 'Xenophobe Jäger-Wellen treffen ein und müssen abgefangen werden.' : 'Waves of xenophobic fighters arrive and have to be intercepted.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Verbände abfangen' : 'Intercept squadrons'}</h3><p>{de ? 'Eintreffende ausgrenzende Elitisten werden aufgespürt und vernichtet.' : 'Incoming exclusionary elitists are hunted down and destroyed.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3>{de ? 'Lieutenants herauslocken' : 'Draw out lieutenants'}</h3><p>{de ? 'Xenophobe Anführer werden herausgelockt und besiegt, um die Kommandostruktur zu schwächen.' : 'Xenophobic leaders are lured out and defeated to weaken the command structure.'}</p></div>
      <div class="sstep"><div class="sn">05</div><h3>{de ? 'Idris-Fregatte' : 'Idris frigate'}</h3><p>{de ? 'Das Kapitalschiff-Ziel: die Idris entweder zerstören oder ihren Piloten ausschalten — der anspruchsvollste Auftrag der Spur.' : 'The capital-ship objective: destroy the Idris or kill its pilot — the toughest contract on the track.'}</p></div>
    </div>
  </div>

  <!-- REWARD BAND -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/cz-loot.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '04 · Die Reward-Spur' : '04 · The reward track'}</div>
      <div class="big">{de ? '120.000 PUNKTE' : '120,000 POINTS'}</div>
      <p>{de ? '4.8.3 ist ein Combat-Point-Farm: Der Fortschritt wird im Journal getrackt, Standard-Missionen geben grob 4.000 Punkte. Wer sich zur vollen Spur von ' : '4.8.3 is a combat point farm: progress is tracked in your journal, and standard missions grant roughly 4,000 points. Work up to the full track of '}<b style="color:var(--accent-2)">{de ? '120.000 Event-Punkten' : '120,000 event points'}</b>{de ? ' hocharbeitet, schaltet ' : ' and you unlock '}<b style="color:var(--accent-2)">{de ? 'einzigartige Blueprints' : 'unique blueprints'}</b>{de ? ' frei, die über künftige Updates hinweg bestehen bleiben.' : ' that persist across future updates.'}</p>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Fünf Fronten, ein Ziel: die ' : 'Five fronts, one goal: the '}<span class="hl">Idris</span>{de ? ' fällt — oder Stanton beugt sich der Xenophobie.' : ' falls — or Stanton bends to xenophobia.'}</blockquote>
    <cite>XenoThreat · Assault on Stanton (4.8.3)</cite>
  </section>

  <!-- MEDIA (mixed gallery + trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-xeno-1.jpg"><img src="/assets/t-xeno-1.jpg" alt={de ? 'XenoThreat-Streitkräfte über Stanton' : 'XenoThreat forces over Stanton'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'XenoThreat · Streitkräfte' : 'XenoThreat · Forces'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-xeno-2.jpg"><img src="/assets/t-xeno-2.jpg" alt={de ? 'XenoThreat im Gefecht' : 'XenoThreat in combat'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Im Gefecht' : 'In combat'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-idris.jpg"><img src="/assets/img-idris.jpg" alt={de ? 'Idris-Fregatte als Kapitalschiff-Ziel' : 'Idris frigate as the capital-ship objective'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Idris · Kapitalschiff-Ziel' : 'Idris · Capital-ship objective'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt={de ? 'Hammerhead-Gunship' : 'Hammerhead gunship'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Hammerhead-Gunship' : 'Hammerhead gunship'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-xeno-3.jpg"><img src="/assets/t-xeno-3.jpg" alt={de ? 'XenoThreat-Propagandaübertragung vor versammelter Menge' : 'XenoThreat propaganda broadcast in front of a gathered crowd'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Propaganda-Übertragung' : 'Propaganda broadcast'}</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="SsOtI2dtvBc" style="background-image:url('/assets/t-hh-1.jpg')"><span class="vlbl">XenoThreat — Assault on Stanton</span><button class="play" aria-label={de ? 'Trailer abspielen' : 'Play trailer'}>▶</button></div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: offizieller Star-Citizen-YouTube-Kanal &amp; Star Citizen Wiki (© Cloud Imperium Games). · ' : 'Source: official Star Citizen YouTube channel &amp; Star Citizen Wiki (© Cloud Imperium Games). · '} /><a href="https://www.youtube.com/watch?v=SsOtI2dtvBc" target="_blank" rel="noopener">{de ? 'Auf YouTube ansehen ↗' : 'Watch on YouTube ↗'}</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-3-xenothreat" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
