---
// „4-1-1-hunt-the-polaris" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-1-1-hunt-the-polaris" image="/assets/img-polaris.jpg" />
<style is:inline>

/* Fleet-Week-Theme (Invictus-Orange / Korvettengrau) */
:root{--bg:#0c1422;--bg-2:#111c30;--surface:#16243c;--surface-2:#1d3050;--accent:#ff7a1a;--accent-2:#7d8b9a;--hot:#FF7A1A;--text:#f2f4f8;--muted:#9fb0c2;--line:rgba(255,122,26,.22);--line-soft:rgba(242,244,248,.10);--glow:0 0 44px rgba(255,122,26,.30);--ink:#0c1422;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f8fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#1e1f22;--muted:#4b5a6a;--accent:#914000;--accent-2:#485767;--hot:#843a00;--ink:#ffffff;--accent-media:#ff7a1a;--accent-2-media:#7d8b9a;--line:rgba(160,94,58,.3);--line-soft:rgba(45,46,49,.12);--glow:0 6px 22px rgba(168,89,42,.18)}




/* page-local accents */
.hero h1{font-size:clamp(2.1rem,13vw,10.5rem)}
/* ⚠ GEMESSEN 31.08.2026 — QUERFORMAT: die Formel oben rechnet nur in vw.
   Bei 932x430 ergab das 121 px Schrift auf 430 px Bildschirm, und die
   letzte Titelzeile lag unter der Kante („Tactical Strike Gro…").
   Ueber 560 px Fensterhoehe aendert diese Regel nichts. */
@media(max-height:560px){.hero h1{font-size:12vh}}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;color:var(--accent-2);font-size:var(--fs-6)}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.1.1', href: '/de/patches/sc-4-1-1.html' }, { label: "Hunt The Polaris" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.1.1', href: '/patches/sc-4-1-1.html' }, { label: "Hunt The Polaris" }]} />


<main id="main">

  <!-- HERO (full-bleed lead) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/img-polaris.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-1-1.html' : '/patches/sc-4-1-1.html'}>Alpha 4.1.1 · Balancing &amp; Fleet Week</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Server-Event' : ' &nbsp;·&nbsp; Server Event'} /></div>
      <h1><span class="thin">Fleet Week 2955</span>Hunt The Polaris</h1>
      <p class="lead">{de ? 'Waehrend der Fleet Week stehlen die Frontier Fighters eine RSI Polaris — und der ganze Server jagt sie quer durch Stanton bis zum letzten Gefecht an einem fluechtigen Wurmloch.' : 'During Fleet Week the Frontier Fighters steal an RSI Polaris — and the whole server hunts it across Stanton to a final showdown at a fleeting wormhole.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Server-weites Event' : 'Server-wide event'}</span><span class="tag">Fleet Week</span><span class="tag">RSI Polaris</span><span class="tag">Frontier Fighters</span><span class="tag">{de ? 'Geteilte Belohnung' : 'Shared reward'}</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>HUNT THE POLARIS</span><span class="dot">◆</span><span>FLEET WEEK 2955</span><span class="dot">◆</span><span>RSI POLARIS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>INVICTUS</span><span class="dot">◆</span><span>RECOIL-SYSTEM</span><span class="dot">◆</span>
      <span>HUNT THE POLARIS</span><span class="dot">◆</span><span>FLEET WEEK 2955</span><span class="dot">◆</span><span>RSI POLARIS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>INVICTUS</span><span class="dot">◆</span><span>RECOIL-SYSTEM</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-1-1-hunt-the-polaris" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">{de ? 'Gestohlene RSI Polaris' : 'Stolen RSI Polaris'}</div></div>
    <div class="s"><div class="n"><span class="count" data-to="1">0</span></div><div class="c">{de ? 'Stanton · ein Jagdrevier' : 'Stanton · one hunting ground'}</div></div>
    <div class="s"><div class="n count" data-to="2955">0</div><div class="c">Fleet Week · Invictus</div></div>
    <div class="s"><div class="n">SERVER</div><div class="c">{de ? 'Alle jagen · alle teilen' : 'Everyone hunts · everyone shares'}</div></div>
  </div>

  <!-- FULL-BLEED BAND — Intro über einer Polaris-Aufnahme -->
  <section class="band band--center" style="padding-block:clamp(3rem,8vw,7rem)">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/t-polaris-5.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Invictus 2955 · Die Jagd beginnt' : 'Invictus 2955 · The hunt begins'}</div>
      <div class="big outline">{de ? 'GESTOHLEN.' : 'STOLEN.'}</div>
      <p>{de ? 'Mitten in der Flottenparade greifen die ' : 'In the middle of the fleet parade the '}<b style="color:var(--accent-2)">Frontier Fighters</b>{de ? ' nach dem grössten Preis am Himmel — einer kompletten ' : ' reach for the greatest prize in the sky — an entire '}<b>RSI Polaris</b>{de ? '. Was als Fleier beginnt, wird zur server-weiten Hetzjagd durch ganz Stanton.' : '. What starts as a heist becomes a server-wide chase across all of Stanton.'}</p>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Eine Korvette flieht. ' : 'One corvette flees. '}<span class="hl">{de ? 'Ein ganzer Server' : 'An entire server'}</span>{de ? ' jagt.' : ' hunts.'}</blockquote>
    <cite>Hunt The Polaris · Fleet Week 2955</cite>
  </section>

  <!-- SCROLLYTELLING — So läuft die Jagd (full-bleed process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>{de ? 'So läuft die Jagd' : 'How the hunt unfolds'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-polaris-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-hammerhead.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-1.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Der Raub' : 'The heist'}</h3><p>{de ? 'Während der Fleet Week reissen die Frontier Fighters eine RSI Polaris an sich — eine Kapital-Korvette von Roberts Space Industries — und brechen mit ihr aus der Flottenschau aus.' : 'During Fleet Week the Frontier Fighters seize an RSI Polaris — a capital corvette from Roberts Space Industries — and break away with it from the fleet show.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Die Hetzjagd' : 'The chase'}</h3><p>{de ? 'Die gestohlene Polaris flieht quer durch Stanton. Der ganze Server schliesst auf — Jäger aus jedem Winkel des Systems nehmen die Korvette ins Visier.' : 'The stolen Polaris flees across Stanton. The whole server closes in — hunters from every corner of the system take aim at the corvette.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Das letzte Gefecht' : 'The final showdown'}</h3><p>{de ? 'Die Flucht endet an einem flüchtigen Wurmloch. Hier kommt es zur entscheidenden Schlacht um die Polaris, bevor das Tor sich wieder schliesst.' : 'The escape ends at a fleeting wormhole. Here the decisive battle for the Polaris plays out, before the gate closes again.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3>{de ? 'Geteilte Beute' : 'Shared spoils'}</h3><p>{de ? 'Fällt die Korvette, wird die Belohnung unter allen Beteiligten geteilt. Wer mitgejagt hat, bekommt seinen Anteil — die Jagd lohnt sich für den ganzen Server.' : 'If the corvette falls, the reward is shared among everyone involved. Whoever joined the hunt gets their cut — the hunt pays off for the whole server.'}</p></div>
    </div>
  </div>

  <!-- VERSUS: Jäger vs Beute (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚑ Frontier Fighters</h3>
        <ul>
          <li>{de ? 'Stehlen mitten in der Fleet Week eine ganze RSI Polaris.' : 'Steal an entire RSI Polaris in the middle of Fleet Week.'}</li>
          <li>{de ? 'Fliehen mit der Kapital-Korvette quer durch Stanton.' : 'Flee with the capital corvette across Stanton.'}</li>
          <li>{de ? 'Steuern auf ein flüchtiges Wurmloch als Fluchtweg zu.' : 'Head for a fleeting wormhole as their escape route.'}</li>
          <li>{de ? 'Müssen das letzte Gefecht überstehen, um zu entkommen.' : 'Must survive the final showdown to get away.'}</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>{de ? '★ Der Server' : '★ The server'}</h3>
        <ul>
          <li>{de ? 'Jeder Spieler im Shard kann sich der Jagd anschliessen.' : 'Every player in the shard can join the hunt.'}</li>
          <li>{de ? 'Die Verfolgung zieht sich durch das ganze System Stanton.' : 'The pursuit stretches across the entire Stanton system.'}</li>
          <li>{de ? 'Am Wurmloch fällt die Entscheidung über die Polaris.' : 'At the wormhole the fate of the Polaris is decided.'}</li>
          <li>{de ? 'Die Belohnung wird unter allen Beteiligten aufgeteilt.' : 'The reward is split among everyone involved.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Recoil-System -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-hh-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '02 · Parallel zur Jagd' : '02 · Alongside the hunt'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">{de ? 'RÜCKSTOSS.' : 'RECOIL.'}</div>
      <p>{de ? 'Alpha 4.1.1 brachte ein neues ' : 'Alpha 4.1.1 brought a new '}<b style="color:var(--accent-2)">{de ? 'Recoil-System' : 'recoil system'}</b>{de ? ' für Schiffs- und Fahrzeugwaffen — mit sichtbaren Effekten beim Feuern. Jeder Schuss in der Jagd auf die Polaris fühlt sich jetzt schwerer und greifbarer an.' : ' for ship and vehicle weapons — with visible effects when firing. Every shot in the hunt for the Polaris now feels heavier and more tangible.'}</p>
    </div>
  </section>

  <!-- SPLIT (the single framed section) — Turret-Munition -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-polaris-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '03 · Mehr Feuerkraft' : '03 · More firepower'}</div>
        <h3>{de ? 'Volle Magazine für die Türme' : 'Full magazines for the turrets'}</h3>
        <p>{de ? 'Mit 4.1.1 wurde die ' : 'With 4.1.1 the '}<b>{de ? 'Turret-Munition' : 'turret ammunition'}</b>{de ? ' vieler Schiffe stark erhöht. Wer in der Hetzjagd die Geschütztürme bemannt, muss seltener nachladen und hält länger im Gefecht.' : ' of many ships was greatly increased. Whoever mans the gun turrets during the chase reloads less often and lasts longer in the fight.'}</p>
        <p>{de ? 'Die ' : 'The '}<b>RSI Polaris</b>{de ? ' selbst ist ausdrücklich unter den betroffenen Schiffen — die Korvette im Zentrum der Jagd profitiert direkt vom aufgestockten Munitionsvorrat ihrer Türme.' : ' itself is explicitly among the affected ships — the corvette at the centre of the hunt benefits directly from the boosted ammo supply of its turrets.'}</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Fleet Week Rahmen -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/img-idris.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Eingebettet ins grosse Spektakel' : 'Embedded in the grand spectacle'}</div>
      <div class="big">FLEET WEEK</div>
      <p>{de ? 'Hunt The Polaris ist eine server-weite Mission aus Alpha 4.1.1, eingebettet in die ' : 'Hunt The Polaris is a server-wide mission from Alpha 4.1.1, embedded in '}<b style="color:var(--accent-2)">Fleet Week / Invictus 2955</b>{de ? ' — das jährliche Flottenfest des Verse, bei dem die grössten Schiffe der UEE Seite an Seite stehen.' : ' — the Verse\'s annual fleet festival, where the greatest ships of the UEE stand side by side.'}</p>
    </div>
  </section>

  <!-- MEDIA — closing mixed gallery (no official video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>{de ? 'Galerie' : 'Gallery'}</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/img-polaris.jpg"><img src="/assets/img-polaris.jpg" alt={de ? 'RSI Polaris im Flug' : 'RSI Polaris in flight'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'RSI Polaris · Kapital-Korvette' : 'RSI Polaris · Capital corvette'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-polaris-5.jpg"><img src="/assets/t-polaris-5.jpg" alt={de ? 'Polaris entlässt eine Gladius aus der Jägerbucht' : 'Polaris releasing a Gladius from the hangar bay'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Auf der Flucht durch Stanton' : 'On the run through Stanton'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-polaris-2.jpg"><img src="/assets/t-polaris-2.jpg" alt={de ? 'Polaris Geschütztürme' : 'Polaris gun turrets'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Aufgestockte Türme' : 'Boosted turrets'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt={de ? 'Hammerhead im Verfolgergeschwader' : 'Hammerhead in the pursuit squadron'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Jäger des Servers' : 'Hunters of the server'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-idris.jpg"><img src="/assets/img-idris.jpg" alt={de ? 'Aegis Idris — Großschiff der Fleet Week' : 'Aegis Idris — Fleet Week capital ship'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Fleet Week · Invictus 2955</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: Star Citizen Wiki &amp; offizielle Patch-Notes zu Alpha 4.1.1 (© Cloud Imperium Games). · Inoffizielles Fan-Projekt.' : 'Source: Star Citizen Wiki &amp; official patch notes for Alpha 4.1.1 (© Cloud Imperium Games). · Unofficial fan project.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-1-1-hunt-the-polaris" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
