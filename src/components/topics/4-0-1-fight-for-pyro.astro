---
// „4-0-1-fight-for-pyro" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-0-1-fight-for-pyro" image="/assets/t-ffp-1.jpg" />
<style is:inline>

/* 4.0.1 "Stabilitaet & Save Stanton II" — Konsolen-Blau (geerbt vom Patch) */
:root{--bg:#0c1320;--bg-2:#101a2b;--surface:#152237;--surface-2:#1c2d46;--accent:#36c5d8;--accent-2:#f0a32a;--hot:#36c5d8;--text:#e6f0fa;--muted:#8ba3bd;--line:rgba(54,197,216,.22);--line-soft:rgba(230,240,250,.10);--glow:0 0 44px rgba(54,197,216,.30);--ink:#0c1320;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f8fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#192027;--muted:#4a5a6b;--accent:#026772;--accent-2:#754b03;--hot:#055e68;--ink:#ffffff;--accent-media:#36c5d8;--accent-2-media:#f0a32a;--line:rgba(42,127,138,.3);--line-soft:rgba(39,47,54,.12);--glow:0 6px 22px rgba(42,127,138,.18)}




/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem;max-width:var(--maxw);margin:0 auto}
@media(max-width:860px){.trio{grid-template-columns:1fr}}
.fcard{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:10px;min-height:340px;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem 1.4rem;isolation:isolate}
.fcard .fbg{position:absolute;inset:0;z-index:-2;background-size:cover;background-position:center;transition:transform .8s;filter:saturate(.9)}
.fcard:hover .fbg{transform:scale(1.07)}
.fcard::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,var(--veil-2),var(--veil-2) 45%,var(--veil))}
.fcard .fk{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-17);text-transform:uppercase;font-size:var(--fs-4);color:var(--accent-2)}
.fcard h3{font-family:var(--font-display);font-weight:800;font-size:clamp(1.2rem,2.2vw,1.6rem);line-height:1.05;color:var(--text);margin:.35rem 0 .5rem}
.fcard p{color:var(--text);font-size:var(--fs-9);opacity:.92}
.fcard .ftag{margin-top:.8rem;display:inline-flex;align-self:flex-start;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-11);text-transform:uppercase;font-size:var(--fs-3);padding:.3rem .7rem;border:1px solid var(--line);border-radius:50px;color:var(--accent)}
.reward{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.1rem}
.reward .chip{font-family:var(--font-ui);font-weight:600;font-size:var(--fs-6);color:var(--text);padding:.45rem .85rem;border:1px solid var(--line);border-radius:6px;background:var(--veil)}
.reward .chip b{color:var(--accent-2)}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.0.1', href: '/de/patches/sc-4-0-1.html' }, { label: "Fight for Pyro" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.0.1', href: '/patches/sc-4-0-1.html' }, { label: "Fight for Pyro" }]} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-ffp-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-0-1.html' : '/patches/sc-4-0-1.html'}>Alpha 4.0.1 · Save Stanton II</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Dynamisches Event' : ' &nbsp;·&nbsp; Dynamic Event'} /></div>
      <h1><span class="thin">{de ? 'Save Stanton · Kapitel 2' : 'Save Stanton · Chapter 2'}</span>Fight for Pyro</h1>
      <p class="lead">{de ? 'Der Krieg verlagert sich nach Pyro: in Kapitel 2 der Save-Stanton-Kampagne schwörst du dich dauerhaft einer von drei Fraktionen zu und entscheidest mit, wem das gesetzlose System gehört.' : 'The war moves to Pyro: in Chapter 2 of the Save Stanton campaign you pledge yourself permanently to one of three factions and help decide who owns the lawless system.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Dynamisches Event' : 'Dynamic Event'}</span><span class="tag">{de ? '3 Fraktionen' : '3 Factions'}</span><span class="tag">{de ? 'Permanente Wahl' : 'Permanent Choice'}</span><span class="tag">Ripper SMG</span><span class="tag">Pyro</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>FIGHT FOR PYRO</span><span class="dot">◆</span><span>SAVE STANTON</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>RIPPER SMG</span><span class="dot">◆</span>
      <span>FIGHT FOR PYRO</span><span class="dot">◆</span><span>SAVE STANTON</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>RIPPER SMG</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-1-fight-for-pyro" />

  <!-- FULL-BLEED BAND — der Krieg zieht nach Pyro -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-pyro-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Kapitel 2 · Der Krieg zieht weiter' : 'Chapter 2 · The war moves on'}</div>
      <div class="big outline">{de ? 'NACH PYRO.' : 'TO PYRO.'}</div>
      <p>{de ? 'Nach dem Angriff auf Stanton folgt die Handlung dem Konflikt ins gesetzlose ' : 'After the attack on Stanton, the story follows the conflict into the lawless '}<b style="color:var(--accent-2)">Pyro</b>{de ? '. Wo kein Recht gilt, ringen drei Fraktionen um Kontrolle — und du entscheidest mit, auf welcher Seite du stehst.' : '. Where no law applies, three factions wrestle for control — and you help decide which side you stand on.'}</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">{de ? 'Kapitel der Save-Stanton-Kampagne' : 'Chapter of the Save Stanton campaign'}</div></div>
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">{de ? 'Fraktionen zur Auswahl' : 'Factions to choose from'}</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">{de ? 'Wahl · und sie ist endgültig' : 'Choice · and it is final'}</div></div>
    <div class="s"><div class="n">Pyro</div><div class="c">{de ? 'Schauplatz · gesetzloses System' : 'Setting · lawless system'}</div></div>
  </div>

  <!-- DREI FRAKTIONEN (image-backed trio, design on top) -->
  <section>
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>{de ? 'Wähle deine Seite' : 'Choose your side'}</h2><span class="rule"></span></div>
      <p class="lead-p reveal" style="margin-bottom:1.6rem">{de ? 'Drei Fraktionen kämpfen um Pyro. Mit deiner ersten Mission bekennst du Farbe — danach sind deine Missionen reputationsgebunden.' : 'Three factions fight for Pyro. With your first mission you show your colors — after that your missions are reputation-bound.'}</p>
    </div>
    <div class="trio reveal">
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/cz-facility.jpg')"></div>
        <div class="fk">{de ? 'Fraktion 01' : 'Faction 01'}</div>
        <h3>Citizens for Prosperity</h3>
        <p>{de ? 'Kämpfe für ein Pyro, das mehr sein will als Chaos — Ordnung und Wohlstand im gesetzlosen System.' : 'Fight for a Pyro that wants to be more than chaos — order and prosperity in the lawless system.'}</p>
        <span class="ftag">{de ? 'Reputationsgebunden' : 'Reputation-bound'}</span>
      </div>
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/cz-combat.jpg')"></div>
        <div class="fk">{de ? 'Fraktion 02' : 'Faction 02'}</div>
        <h3>Headhunters</h3>
        <p>{de ? 'Kopfgeld, Stahl und harte Hand: stell dich auf die Seite derer, die in Pyro nach eigenen Regeln jagen.' : 'Bounty, steel and a hard hand: side with those who hunt in Pyro by their own rules.'}</p>
        <span class="ftag">{de ? 'Reputationsgebunden' : 'Reputation-bound'}</span>
      </div>
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/t-ffp-2.jpg')"></div>
        <div class="fk">{de ? 'Fraktion 03' : 'Faction 03'}</div>
        <h3>Frontier Fighters</h3>
        <p>{de ? 'Die freie Grenze verteidigen — für jene, die Pyro als letzte unabhängige Front begreifen.' : 'Defend the free frontier — for those who see Pyro as the last independent front.'}</p>
        <span class="ftag">{de ? 'Reputationsgebunden' : 'Reputation-bound'}</span>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING — so legst du dich fest (process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>{de ? 'So legst du dich fest' : 'How you commit'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-pyro-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-facility.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-3.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Nach Pyro' : 'To Pyro'}</h3><p>{de ? 'Folge der Save-Stanton-Kampagne in Kapitel 2 ins gesetzlose Pyro-System, wo der Konflikt um die Vorherrschaft entbrannt ist.' : 'Follow the Save Stanton campaign into Chapter 2 in the lawless Pyro system, where the conflict for supremacy has flared up.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Die erste Mission' : 'The first mission'}</h3><p>{de ? 'Citizens for Prosperity, Headhunters oder Frontier Fighters: deine erste Mission entscheidet, für wen du in Pyro kämpfst.' : 'Citizens for Prosperity, Headhunters or Frontier Fighters: your first mission decides who you fight for in Pyro.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Festgelegt' : 'Committed'}</h3><p>{de ? 'Nach der ersten Mission ist die Wahl dauerhaft. Es gibt kein Zurück — ab jetzt sind alle Missionen an die Reputation deiner Fraktion gebunden.' : 'After the first mission the choice is permanent. There is no going back — from now on all missions are bound to your faction\'s reputation.'}</p></div>
      <div class="sstep"><div class="sn">04</div><h3>{de ? 'Bis zum Abschluss' : 'Through to completion'}</h3><p>{de ? 'Arbeite die Kette deiner Fraktion ab und schließe Fight for Pyro ab — der Zeitpunkt entscheidet über deine Belohnung.' : 'Work through your faction\'s chain and complete Fight for Pyro — the timing decides your reward.'}</p></div>
    </div>
  </div>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Eine Mission. Eine Fraktion. ' : 'One mission. One faction. '}<span class="hl">{de ? 'Keine zweite Wahl.' : 'No second choice.'}</span></blockquote>
    <cite>{de ? 'Fight for Pyro · Save Stanton Kapitel 2' : 'Fight for Pyro · Save Stanton Chapter 2'}</cite>
  </section>

  <!-- SPLIT (the ONE framed section) — permanente Wahl -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-pyro-5.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '03 · Permanente Wahl' : '03 · Permanent Choice'}</div>
        <h3>{de ? 'Eine Entscheidung, die bleibt' : 'A decision that stays'}</h3>
        <p>{de ? 'Anders als bei vielen Events ist deine Fraktionswahl in Fight for Pyro ' : 'Unlike many events, your faction choice in Fight for Pyro is '}<b>{de ? 'dauerhaft' : 'permanent'}</b>{de ? ': Sobald die erste Mission abgeschlossen ist, bist du festgelegt. Es gibt keinen Wechsel mehr zur Gegenseite.' : ': once the first mission is completed, you are committed. There is no switching to the other side.'}</p>
        <p>{de ? 'Von da an sind deine Missionen ' : 'From then on your missions are '}<b>{de ? 'reputationsgebunden' : 'reputation-bound'}</b>{de ? ' — du verdienst dir das Vertrauen deiner Fraktion und kämpfst ihre Schlachten bis zum Ende der Kampagne.' : ' — you earn your faction\'s trust and fight their battles to the end of the campaign.'}</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Belohnungen / Ripper SMG -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-ffp-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? '04 · Was du verdienst' : '04 · What you earn'}</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">RIPPER SMG</div>
      <p>{de ? 'Wer Fight for Pyro ' : 'Anyone who completed Fight for Pyro '}<b style="color:var(--accent-2)">{de ? 'vor dem Start von 4.0.2' : 'before the start of 4.0.2'}</b>{de ? ' abschloss, sicherte sich die exklusive Pyro-Ripper-SMG — eine Belohnung nur für jene, die rechtzeitig für ihre Fraktion kämpften.' : ' secured the exclusive Pyro Ripper SMG — a reward only for those who fought for their faction in time.'}</p>
      <div class="reward">
        <span class="chip"><b>{de ? 'Exklusiv' : 'Exclusive'}</b>{de ? ' · Pyro-Ripper-SMG' : ' · Pyro Ripper SMG'}</span>
        <span class="chip">{de ? 'nur vor Start von ' : 'only before the start of '}<b>4.0.2</b></span>
      </div>
    </div>
  </section>

  <!-- LACKIERUNGEN (data over surface, no image card) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>{de ? 'Fraktions-Lackierungen' : 'Faction Paints'}</h2><span class="rule"></span></div>
      <p class="lead-p reveal">{de ? 'Wer ' : 'Anyone who completed '}<b>{de ? 'Save Stanton Kapitel 1' : 'Save Stanton Chapter 1'}</b> <i>{de ? 'und' : 'and'}</i> <b>{de ? 'Fight for Pyro Kapitel 2' : 'Fight for Pyro Chapter 2'}</b>{de ? ' abschloss, verdiente sich fraktionsspezifische Schiffs-Lackierungen — Farben, die zeigen, für wen du in Pyro gekämpft hast.' : ' earned faction-specific ship paints — colors that show who you fought for in Pyro.'}</p>
      <div class="reward reveal" style="margin-top:1.4rem">
        <span class="chip">Anvil <b>C8R Pisces</b></span>
        <span class="chip">Anvil <b>Carrack</b></span>
        <span class="chip">Drake <b>Cutter</b></span>
        <span class="chip">RSI <b>Zeus Mk II</b></span>
      </div>
    </div>
  </section>

  <!-- CLOSING — mixed full-bleed gallery (no official video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>{de ? 'Bildergalerie' : 'Image Gallery'}</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-ffp-1.jpg"><img src="/assets/t-ffp-1.jpg" alt={de ? 'Fight for Pyro — Kampf um Pyro' : 'Fight for Pyro — battle for Pyro'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Fight for Pyro</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-pyro-7.jpg"><img src="/assets/t-pyro-7.jpg" alt={de ? 'Patch City — Outlaw-Station in Pyros Asteroidenfeld' : 'Patch City — outlaw station in Pyro\'s asteroid field'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Patch City · Outlaw-Hafen' : 'Patch City · Outlaw Port'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-ruin-1.jpg"><img src="/assets/t-ruin-1.jpg" alt={de ? 'Ruin Station vor dem Planeten Terminus' : 'Ruin Station in front of the planet Terminus'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Ruin Station · Terminus</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-cutlass.jpg"><img src="/assets/img-cutlass.jpg" alt={de ? 'Drake Cutlass über Pyro' : 'Drake Cutlass over Pyro'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Drake Cutlass</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-pyro-6.jpg"><img src="/assets/t-pyro-6.jpg" alt={de ? 'Leuchtende Vegetation zwischen Felsnadeln auf einer Pyro-Welt' : 'Glowing vegetation between rock spires on a Pyro world'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Pyros Wildnis' : 'Pyro\'s Wilderness'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-0-0.jpg"><img src="/assets/trailer-4-0-0.jpg" alt="Destination Pyro" loading="lazy"><span class="zoomic">⤢</span><figcaption>Destination Pyro</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: Star Citizen Wiki &amp; offizielle Community-Quellen (© Cloud Imperium Games). Bilder zu Illustrationszwecken.' : 'Source: Star Citizen Wiki &amp; official community sources (© Cloud Imperium Games). Images for illustrative purposes.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-0-1-fight-for-pyro" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
