---
// „4-3-2-frontier-fighters" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
---
<TopicSeo slug="4-3-2-frontier-fighters" image="/assets/t-front-1.jpg" />
<style is:inline>

/* Fractured-Frontiers-Theme (4.3.2) */
:root{--bg:#16181b;--bg-2:#1d2024;--surface:#23272b;--surface-2:#2c3137;--accent:#B5642A;--accent-2:#E4B400;--hot:#8E1F1F;--text:#ede6db;--muted:#a89d8e;--line:rgba(181,100,42,.22);--line-soft:rgba(237,230,219,.10);--glow:0 0 44px rgba(181,100,42,.30);--ink:#16181b;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f8fc;--bg-2:#eaeef4;--surface:#fcfeff;--surface-2:#edf3fb;--text:#231e16;--muted:#605649;--accent:#8d4402;--accent-2:#6a5200;--hot:#9a1118;--ink:#ffffff;--accent-media:#B5642A;--accent-2-media:#E4B400;--line:rgba(159,96,54,.3);--line-soft:rgba(50,45,37,.12);--glow:0 6px 22px rgba(166,91,37,.18)}



/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.phasetag{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.78rem}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.3.2', href: '/de/patches/sc-4-3-2.html' }, { label: "Frontier Fighters" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.3.2', href: '/patches/sc-4-3-2.html' }, { label: "Frontier Fighters" }]} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-front-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href={de ? '/de/patches/sc-4-3-2.html' : '/patches/sc-4-3-2.html'}>Alpha 4.3.2 · Fractured Frontiers</a><Fragment set:html={de ? ' &nbsp;·&nbsp; Finale-Event' : ' &nbsp;·&nbsp; Finale event'} /></div>
      <h1><span class="thin">{de ? 'Das Finale · Pyro Must Burn' : 'The Finale · Pyro Must Burn'}</span>Frontier Fighters</h1>
      <p class="lead">{de ? 'Das grosse Finale von 4.3.2: Headhunters und Citizens for Prosperity verbuenden sich, um Amelia Boyds Frontier Fighters ueber drei Phasen quer durch Stanton und Pyro zur Strecke zu bringen.' : 'The grand finale of 4.3.2: Headhunters and Citizens for Prosperity join forces to bring down Amelia Boyd\'s Frontier Fighters across three phases, all the way through Stanton and Pyro.'}</p>
      <div class="tags"><span class="tag hot">{de ? 'Finale-Event' : 'Finale event'}</span><span class="tag">{de ? '3 Phasen' : '3 phases'}</span><span class="tag">Headhunters + CFP</span><span class="tag">Amelia Boyd</span><span class="tag">{de ? 'Polaris-Takedown' : 'Polaris takedown'}</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">{de ? 'Scrollen ↓' : 'Scroll ↓'}</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>PYRO MUST BURN</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>AMELIA BOYD</span><span class="dot">◆</span><span>{de ? '3 PHASEN' : '3 PHASES'}</span><span class="dot">◆</span>
      <span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>PYRO MUST BURN</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>AMELIA BOYD</span><span class="dot">◆</span><span>{de ? '3 PHASEN' : '3 PHASES'}</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-3-2-frontier-fighters" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">{de ? 'Phasen bis zum Takedown' : 'Phases to the takedown'}</div></div>
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">{de ? 'Verbuendete Fraktionen' : 'Allied factions'}</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">{de ? 'Gejagte Polaris' : 'Polaris hunted'}</div></div>
    <div class="s"><div class="n">FINALE</div><div class="c">{de ? 'Endkapitel der Pyro-Story' : 'Final chapter of the Pyro story'}</div></div>
  </div>

  <!-- FULL-BLEED BAND — Auftakt / Überblick als Riesentext über Standbild -->
  <section class="band band--center" style="padding-top:0">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/cz-ruin.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">{de ? 'Das Endkapitel von 4.3.2' : 'The final chapter of 4.3.2'}</div>
      <div class="big outline">PYRO MUST BURN.</div>
      <p>{de ? 'Das Frontier-Fighters-Finale ist das narrative Schlusskapitel von Alpha 4.3.2 — der Hoehepunkt der ' : 'The Frontier Fighters finale is the narrative closing chapter of Alpha 4.3.2 — the climax of the '}<b style="color:var(--accent-2)">{de ? 'Pyro-Must-Burn' : 'Pyro Must Burn'}</b>{de ? '-Story, der sich quer durch Stanton und Pyro entfaltet und das gesamte Verse in eine einzige Jagd zieht.' : ' story, unfolding across Stanton and Pyro and pulling the entire \'verse into a single hunt.'}</p>
    </div>
  </section>

  <!-- MANIFESTO — early pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>{de ? 'Diesmal jagt ' : 'This time '}<span class="hl">{de ? 'der ganze Server' : 'the whole server'}</span>{de ? ' dasselbe Ziel.' : ' hunts the same target.'}</blockquote>
    <cite>Frontier Fighters · Finale 4.3.2</cite>
  </section>

  <!-- VERSUS: Die Allianz vs. die Frontier Fighters (full-bleed) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>{de ? '⚔ Die Frontier Fighters' : '⚔ The Frontier Fighters'}</h3>
        <ul>
          <li>{de ? 'Outlaw-Fraktion im Zentrum des 4.3.2-Finales.' : 'Outlaw faction at the heart of the 4.3.2 finale.'}</li>
          <li>{de ? 'Gefuehrt von ' : 'Led by '}<b>Amelia Boyd</b>.</li>
          <li>{de ? 'Operieren von Stanton bis tief nach Pyro.' : 'Operate from Stanton deep into Pyro.'}</li>
          <li>{de ? 'Stehlen in der Eskalation eine ganze Polaris.' : 'Steal an entire Polaris as the escalation peaks.'}</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>{de ? '★ Die Allianz' : '★ The Alliance'}</h3>
        <ul>
          <li>{de ? 'Headhunters und Citizens for Prosperity — hier Verbuendete.' : 'Headhunters and Citizens for Prosperity — allies here.'}</li>
          <li>{de ? 'Gemeinsame Jagd auf Boyds Fighters.' : 'Joint hunt for Boyd\'s Fighters.'}</li>
          <li>{de ? 'Koordinieren ueber alle drei Phasen hinweg.' : 'Coordinate across all three phases.'}</li>
          <li>{de ? 'Treiben das Verse zum finalen Takedown.' : 'Drive the \'verse toward the final takedown.'}</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: Die drei Phasen als Eskalations-Prozess -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>{de ? 'Drei Phasen bis zum Takedown' : 'Three phases to the takedown'}</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-ffp-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-facility.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-1.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">00</div><h3>{de ? 'Eine Allianz formiert sich' : 'An alliance forms'}</h3><p>{de ? 'Headhunters und Citizens for Prosperity legen ihre Differenzen beiseite und schliessen sich zusammen, um die Frontier Fighters um Amelia Boyd ins Visier zu nehmen.' : 'Headhunters and Citizens for Prosperity set aside their differences and band together to target the Frontier Fighters under Amelia Boyd.'}</p></div>
      <div class="sstep"><div class="sn">01</div><h3>{de ? 'Phase Eins · Aufklaerung' : 'Phase One · Reconnaissance'}</h3><p>{de ? 'Der Auftakt der Eskalation: Die Allianz spuert die Bewegungen der Frontier Fighters quer durch Stanton und Pyro auf und steckt das Schlachtfeld ab.' : 'The opening of the escalation: the Alliance tracks the Frontier Fighters\' movements across Stanton and Pyro and stakes out the battlefield.'}</p></div>
      <div class="sstep"><div class="sn">02</div><h3>{de ? 'Phase Zwei · Belagerung' : 'Phase Two · Siege'}</h3><p>{de ? 'Die Jagd verdichtet sich. Aus Aufklaerung wird Druck — die Verbuendeten setzen Boyds Fighters an ihren Stuetzpunkten zu und treiben sie in die Enge.' : 'The hunt tightens. Reconnaissance turns into pressure — the allies close in on Boyd\'s Fighters at their strongholds and corner them.'}</p></div>
      <div class="sstep"><div class="sn">03</div><h3>{de ? 'Phase Drei · Der Takedown' : 'Phase Three · The Takedown'}</h3><p>{de ? 'In der finalen Phase jagt der ganze Server gemeinsam die eine Polaris, die die Frontier Fighters gestohlen haben — der Hoehepunkt des gesamten Finales.' : 'In the final phase, the whole server hunts together for the one Polaris the Frontier Fighters have stolen — the climax of the entire finale.'}</p></div>
    </div>
  </div>

  <!-- FULL-BLEED BAND — Der Polaris-Takedown -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/img-polaris.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="phasetag">{de ? 'Phase Drei · Server-Event' : 'Phase Three · Server event'}</div>
      <div class="big" style="font-size:clamp(2.4rem,8vw,6rem)">{de ? 'EINE POLARIS.' : 'ONE POLARIS.'}<br>{de ? 'EIN SERVER.' : 'ONE SERVER.'}</div>
      <p>{de ? 'Die Frontier Fighters haben eine ganze Polaris gestohlen — und im Finale zaehlt nur noch eines: das gesamte Verse jagt dieses eine Schiff gemeinsam. Der servuerweite Takedown setzt den Schlusspunkt unter die Pyro-Must-Burn-Story.' : 'The Frontier Fighters have stolen an entire Polaris — and in the finale only one thing matters: the whole \'verse hunts this one ship together. The server-wide takedown puts the closing punctuation on the Pyro Must Burn story.'}</p>
    </div>
  </section>

  <!-- SPLIT — der EINE gerahmte Abschnitt: weitere 4.3.2-Inhalte (Paladin, Yormandi, Salvage) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/img-paladin.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">{de ? '02 · Was 4.3.2 sonst noch brachte' : '02 · What else 4.3.2 brought'}</div>
        <h3>{de ? 'Mehr als nur das Finale' : 'More than just the finale'}</h3>
        <p>{de ? 'Rund um das Frontier-Fighters-Event lieferte Alpha ' : 'Around the Frontier Fighters event, Alpha '}<b>4.3.2 "Fractured Frontiers"</b>{de ? ' spuerbar mehr: Headliner-Schiff des Patches ist die ' : ' delivered noticeably more: the patch\'s headliner ship is the '}<b>Anvil Paladin</b>.</p>
        <p>{de ? 'Dazu kam der ' : 'It also added the '}<b>{de ? 'Yormandi-Boss' : 'Yormandi boss'}</b>{de ? ' in den Onyx-Hoehlen auf ' : ' in the Onyx caves on '}<b>ASD Site B</b>{de ? ' sowie ein umfassendes ' : ', as well as a comprehensive '}<b>{de ? 'Salvage- und Refining-Rework' : 'salvage and refining rework'}</b>{de ? ' — Inhalte, die ueber das Finale hinaus Bestand haben.' : ' — content that endures beyond the finale.'}</p>
      </div>
    </div>
  </section>

  <!-- CLOSING — full-bleed mixed gallery (kein offizielles Video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">03</span><h2>{de ? 'Bildergalerie' : 'Image gallery'}</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-front-1.jpg"><img src="/assets/t-front-1.jpg" alt={de ? 'Frontier Fighters — Finale-Event' : 'Frontier Fighters — finale event'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Frontier Fighters · Finale</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-pyro.jpg"><img src="/assets/img-pyro.jpg" alt={de ? 'Das Pyro-System — Schauplatz der Jagd' : 'The Pyro system — setting of the hunt'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Pyro · Schauplatz' : 'Pyro · Setting'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-combat.jpg"><img src="/assets/cz-combat.jpg" alt={de ? 'Gefecht waehrend der Jagd' : 'Firefight during the hunt'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Belagerung' : 'Siege'}</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-facility.jpg"><img src="/assets/cz-facility.jpg" alt={de ? 'Anlage in Pyro' : 'Facility in Pyro'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Aufklaerung' : 'Reconnaissance'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-polaris.jpg"><img src="/assets/img-polaris.jpg" alt={de ? 'Die gestohlene Polaris' : 'The stolen Polaris'} loading="lazy"><span class="zoomic">⤢</span><figcaption>{de ? 'Die gestohlene Polaris' : 'The stolen Polaris'}</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-paladin.jpg"><img src="/assets/img-paladin.jpg" alt={de ? 'Anvil Paladin — Headliner-Schiff' : 'Anvil Paladin — headliner ship'} loading="lazy"><span class="zoomic">⤢</span><figcaption>Anvil Paladin · Headliner</figcaption></figure>
      </div>
      <p class="src reveal"><Fragment set:html={de ? 'Quelle: Star Citizen Wiki &amp; offizielle Community-Quellen (© Cloud Imperium Games). Bilder zu Illustrationszwecken.' : 'Source: Star Citizen Wiki &amp; official community sources (© Cloud Imperium Games). Images for illustration purposes.'} /></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-3-2-frontier-fighters" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label={de ? 'Schließen' : 'Close'}>✕</button><div class="lb__content"></div></div></div>

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
