---
// „crafting" — EIN Körper für DE und EN.
// Muster und Begründung: siehe components/topics/4-5-0-engineering.astro.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben —
// Astro 5.18 verschluckt sonst dessen schließendes Tag (siehe Sprungmarke).
import SiteNav from '../../components/SiteNav.astro';
import TopicFacts from '../../components/TopicFacts.astro';
import RelatedTopics from '../../components/RelatedTopics.astro';
import Attribution from '../../components/Attribution.astro';
import CraftingApp from '../../components/CraftingApp.astro';
import DB from '../../../assets/crafting-db.json';
import TopicSeo from '../../components/dossier/TopicSeo.astro';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath } from '../../i18n/ui';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const total = DB.counts.blueprints;
const nRes = DB.counts.resources;
const snap = DB.snapshot_date;
const ver = DB.version;
// Patch label derived from the database version ("LIVE-4.9.0-12232306" -> "4.9")
// so title/breadcrumbs follow every regeneration automatically.
const patch = (ver.match(/(\d+\.\d+)/) ?? [])[1] ?? '4.9';
const patchHref = de ? `/de/patches/sc-${patch.replace(/\./g, '-')}-0.html` : `/patches/sc-${patch.replace(/\./g, '-')}-0.html`;
---
<TopicSeo slug="crafting" image="/assets/t-craft-1.jpg" />
<style is:inline>
:root{--bg:#16161a;--bg-2:#1d1d22;--surface:#232329;--surface-2:#2c2c34;--accent:#FF5E1A;--accent-2:#1FA2FF;--hot:#FF5E1A;--text:#eef1f5;--muted:#9ba2ae;--line:rgba(255,94,26,.22);--line-soft:rgba(238,241,245,.10);--glow:0 0 44px rgba(255,94,26,.28);--ink:#16161a;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f7f7fd;--bg-2:#ededf4;--surface:#fdfdff;--surface-2:#f1f1fc;--text:#1d1f22;--muted:#525863;--accent:#9b3302;--accent-2:#045991;--hot:#8f2d00;--ink:#ffffff;--accent-media:#FF5E1A;--accent-2-media:#1FA2FF;--line:rgba(163,92,67,.3);--line-soft:rgba(44,46,49,.12);--glow:0 6px 22px rgba(171,86,56,.18)}

.hero{background:radial-gradient(120% 90% at 78% 12%,rgba(255,94,26,.16),transparent 60%),radial-gradient(90% 80% at 12% 90%,rgba(31,162,255,.12),transparent 55%),var(--bg)}
.hero__in{max-width:var(--maxw)}
/* Werkzeugseite, keine Leinwand: der 92svh-Hero schrumpft auf ein schmales
   Kopfband, damit Werkzeugleiste UND erste Blueprint-Karte bei 1280x720 ohne
   Scrollen dastehen. `min-height:0` ist der groesste Hebel — derselbe Griff
   wie `hero--tool` in ItemFinderPage.astro:54 (dort gemessen: 273 px statt
   662). Lead, Kennzahlen und Hinweis sind mit nach unten gewandert; im Band
   steht nur noch der Titel.
   Der Standard-Schleier (.hero__photo::after aus detail.css) bleibt bewusst
   UNVERAENDERT: er rechnet in Bruchteilen der Box, nicht in Pixeln, sein
   helles Fenster liegt rechts oben — und der Titel steht hier weiterhin
   LINKS, also im dunklen Teil. Der Item Finder musste ihn ueberschreiben,
   weil sein Titel zentriert ist; hier waere das ein neuer, ungemessener
   Verlauf ohne Anlass (verify:layers, Zusicherung 5 / Eintrag D1). */
/* Die Polsterung oben ist KEIN fester Wert: SiteNav veroeffentlicht mit
   --nav-h den Freiraum unter der oberen Kante, und der waechst mit der
   sichtbaren Zurueck-Marke (68 / 104 / unter 1180 px 116 px, SiteNav:946).
   Erster Anlauf hatte hier 5rem fuer Schmalschirme stehen — bei 390 px lief
   die Marke „← ALPHA 4.9" damit quer durch die Zeile „Blueprint-Datenbank".
   Am Bild gesehen, nicht gerechnet. */
/* Unten knapp: die 1,2rem sind gemessen, nicht gewaehlt. Beim ERSTEN Besuch
   klappt die Werkzeug-Hilfe von selbst auf (assets/tool-help.js) und schiebt
   die Liste um 280 px nach unten — mit 1,8rem stand die erste Karte dann bei
   729 px, also neun Pixel unter der Falz von 720. */
.hero--tool{min-height:0;justify-content:flex-start;padding:calc(var(--nav-h,104px) + .6rem) clamp(1.25rem,5vw,4rem) 1.2rem}
.hero--tool h1{font-size:clamp(1.9rem,4.4vw,3.2rem)}
.hero--tool .hero__in{text-align:center}
/* Der Standard-Schleier (.hero__photo::after, detail.css) hat sein helles
   Sichtfenster fest bei 78 % x / 18 % y — gebaut fuer den hohen Hero mit
   Titel unten LINKS. Unter einem zentrierten Titel im Band macht genau das
   den Fehler sichtbar: die linke Haelfte wird toter schwarzer Streifen, die
   rechte bleibt offen, und der Titel landet auf der unruhigsten Stelle des
   Fotos. Hier deshalb symmetrisch um die Mitte — gleiche Bauart wie beim
   Item Finder (ItemFinderPage.astro:80), aber ohne dessen Duoton — das
   Motiv bleibt farbig, es wird nur mittig geoeffnet.
   ⚠ Geaendert wird das radiale Sichtfenster (78/18 -> 50/40) UND die Tiefe
   des senkrechten Schleiers (scrim-4 -> scrim-5 ab 50 %).
   Der senkrechte Schleier behaelt Token und Stopps aus detail.css: ein
   erster Anlauf mit eigenen color-mix-Werten war 20 Prozentpunkte heller
   und drueckte das orangene Wort auf 2,45:1 — unter den Grenzwert.
   ⚠ Ein zweiter Anlauf loeste dasselbe per filter:brightness(.68) am Foto.
   Optisch gleichwertig (0,68 x 0,42 Durchlass ~ scrim-5), aber fuer
   verify:layers UNSICHTBAR: die Registry kennt nur Schleier-Token, kein
   filter. Ein Regler, den das Tor nicht sehen kann, ist hier der falsche —
   deshalb steckt die Abdunklung jetzt im Schleier, nicht im Bild.
   Registry-Eintrag D6 in scripts/lib/layer-registry.mjs. */
.hero--tool .hero__photo::after{background:linear-gradient(180deg,var(--scrim-2),var(--scrim-5) 50%,var(--scrim-5) 90%,var(--bg)),radial-gradient(120% 130% at 50% 40%,transparent,var(--bg) 88%)}
@media (max-width:700px){.hero--tool h1{font-size:clamp(1.7rem,7.4vw,2.2rem)}}
/* „Worum geht es hier" — steht UNTER dem Werkzeug, gleiche Anordnung wie
   .uf-about im Item Finder. Bewusst nicht display:none und nicht
   ausgeklappt-versteckt: Google indexiert mobil-zuerst, der Text soll
   gefunden werden. Er soll nur niemanden aufhalten, der bauen will.
   Rahmen wie `.cdb` in CraftingApp.astro, damit die Spalte unter dem
   Werkzeug auf derselben Kante steht. */
.cr-about{max-width:var(--maxw);margin:2rem auto 0;padding:1.4rem clamp(1rem,4vw,2rem) 0;border-top:1px solid var(--line-soft);display:flex;flex-direction:column;gap:1rem}
.cr-about__lead{margin:0;max-width:74ch;color:var(--muted);font-size:var(--fs-9);line-height:1.55}
.qbar{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-12);text-transform:uppercase;font-size:var(--fs-5);color:var(--muted)}
.qbar b{color:var(--accent-2)}
/* „Patch 4.9" traegt jetzt den Verweis auf die Patchseite, den vorher der
   Eyebrow im Kopf trug — er war der einzige echte <a> von hier dorthin
   (SiteNav rendert die Brotkrume nur als JSON-LD). Farbe erbt von .qbar b,
   damit die Leiste eine Zeile bleibt. */
.qbar a{color:inherit;text-decoration:none;border-bottom:1px solid var(--line)}
.qbar a:hover{border-color:var(--accent-2)}
.cr-note{margin:0;display:flex;align-items:flex-start;gap:.75rem;border:1px solid var(--accent-2);border-left-width:3px;background:color-mix(in srgb,var(--accent-2) 8%,transparent);padding:.9rem 1.1rem;border-radius:4px;color:var(--text);font-size:var(--fs-8);line-height:1.55}
.cr-note b{color:var(--text)}
.cr-note a{color:var(--accent-2);border-bottom:1px solid var(--line);white-space:nowrap}
.cr-browse{margin:0;display:flex;flex-wrap:wrap;gap:.6rem 1.6rem;font-weight:700;font-size:var(--fs-8)}
.cr-browse a{color:var(--accent);text-decoration:none;border-bottom:1px solid var(--line)}
.cr-browse a:hover{color:var(--accent-2);border-color:var(--accent-2)}</style>
<a class="skip" href="#main" set:text={de ? 'Zum Inhalt springen' : 'Skip to content'} />

<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: `Alpha ${patch}`, href: patchHref }, { label: "Crafting" }] : [{ label: 'Archive', href: '/archiv.html' }, { label: `Alpha ${patch}`, href: patchHref }, { label: "Crafting" }]} />

<main id="main">
  {/* Kopfband statt Hero (17.08.2026): das Werkzeug stand vorher bei 1297 px,
      die erste Blueprint-Karte bei 1930 — man scrollte fast drei Bilder weit,
      bevor die Datenbank ueberhaupt anfing. Im Band steht nur noch der Titel.
      Der Eyebrow ist raus wie beim Item Finder; sein Patch-Verweis lebt unten
      in den Kennzahlen weiter, denn SiteNav rendert die Brotkrume nur als
      JSON-LD — sonst faende sich von hier kein Weg mehr zur Patchseite.
      Die Scroll-Marke ist mit dem hohen Hero entfallen: sie zeigte auf etwas,
      das jetzt ohnehin im Bild steht. */}
  <section class="hero hero--tool">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-craft-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <h1><span class="thin">{de ? 'Blueprint-Datenbank' : 'Blueprint database'}</span>Crafting</h1>
    </div>
  </section>

  <CraftingApp lang={de ? 'de' : 'en'} />

  {/* Unter dem Werkzeug, nicht davor: Lead, Kennzahlen, Volatilitaets-/
      Speicherhinweis und die beiden Verzeichnis-Verweise. Nichts davon
      braucht man zum Bedienen — der Speicherhinweis steht als `title` schon
      an der Sync-Anzeige in der Werkzeugleiste. Alles bleibt sichtbarer Text
      bzw. echtes <a href> im statischen HTML; die Verweise sind der
      krabbelbare Weg in die Verzeichnisse, ihre Position im Dokument ist
      dafuer egal, ihr Vorhandensein nicht. */}
  <aside class="cr-about">
    <p class="cr-about__lead">{de ? 'Blueprints, Zutaten, Qualitäts-Simulator, Fabricator-Planer.' : 'Blueprints, ingredients, quality simulator, fabricator planner.'}</p>
    <div class="qbar"><span>Blueprints <b>{total}</b></span><span>{de ? 'Ressourcen ' : 'Resources '}<b>{nRes}</b></span><span>Patch <a href={patchHref}><b>{patch}</b></a></span><span>{de ? 'Stand ' : 'As of '}<b>{snap}</b></span></div>
    <div class="cr-note">
      <span>Patch <b>{ver}</b>{de ? ', Stand ' : ', as of '}<b>{snap}</b> — <b>{de ? 'patch-volatil, ingame prüfen' : 'patch-volatile, verify in-game'}</b><Fragment set:html={de ? '. „Im Besitz"-Markierungen &amp; der Planer werden im Konto gespeichert, wenn du angemeldet bist — sonst nur lokal in diesem Browser.' : '. “Owned” marks &amp; the planner are saved to your account when you’re signed in — otherwise only locally in this browser.'} /></span>
    </div>
    {/* Statischer Einstieg in dieselbe Datenschicht — der Planer selbst rendert
        Zutaten & Missionen erst im Browser. */}
    <p class="cr-browse">
      <a href={de ? '/de/crafting.html' : '/crafting.html'}>{de ? 'Blueprint-Verzeichnis →' : 'Blueprint directory →'}</a>
      <a href={de ? '/de/items.html' : '/items.html'}>{de ? 'Item-Verzeichnis →' : 'Item directory →'}</a>
    </p>
  </aside>

  <TopicFacts topicSlug="crafting" />
</main>

<RelatedTopics topicSlug="crafting" />
<Attribution sources={["RSI"]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
