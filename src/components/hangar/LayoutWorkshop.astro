---
// Die Layout-Werkstatt, EIN Koerper fuer DE und EN: die Vorgabe der Tafel
// rechts ueber der Buehne (unter 760 px zwischen Buehne und Dock); der
// Schalter darueber (HangarPage.astro) wechselt zu den Schiffsdaten. Gebaut steht nur das
// Geruest mit jedem festen Wort; Slots, Auswahllisten und die gespeicherten
// Layouts zeichnet assets/hangar-layouts.js aus /hangar-layouts.json
// (src/lib/hangar/layouts.ts). Seine Woerter liest es aus #hgl-msg, eines je
// data-m, damit audit:site und verify:sync sie sehen.
//
// Welche Tafel steht und welches Layout darin, sagt der Zustand des
// Controllers (assets/hangar-overview.js, Schluessel pane und lo, URL-Form
// ?pane=ship und ?layout=).
import { layoutT, type LayoutKey } from '../../i18n/layoutText';
import { hangarT, type HangarKey } from '../../i18n/hangarText';
import { useHelp } from '../../i18n/help';
import type { Locale } from '../../i18n/ui';
import { layoutDataHref } from '../../lib/hangar/layouts';

interface Props { lang: Locale }
const { lang } = Astro.props;
const l = layoutT(lang);
const t = hangarT(lang);
const h = useHelp(lang);

// Vorlagen fuer den Client: Werkstatt-Woerter und die geteilten Woerter der Bucht.
const LAYOUT_MSG: LayoutKey[] = [
  'name.placeholder', 'name.fun', 'state.stock', 'state.changed.one', 'state.changed.other', 'state.unsaved', 'state.saved',
  'slot.swap', 'slot.stock', 'slot.fitted', 'slot.was', 'slot.revert', 'slot.unknown',
  'pick.search', 'pick.searchLabel', 'pick.empty', 'pick.count.one', 'pick.count.other', 'pick.price', 'pick.noshop',
  'dt.p', 'dt.e', 'dt.d',
  'msg.saved', 'msg.copied', 'msg.copyFallback', 'msg.reset', 'msg.fitted', 'msg.deleted', 'msg.undo',
  'msg.dropped.one', 'msg.dropped.other', 'msg.full',
  'saved.empty', 'saved.here', 'saved.open', 'saved.share', 'saved.delete', 'saved.deleteLabel', 'saved.stock', 'noslots',
  'grp.paint', 'paint.stock', 'paint.pattern',
];
const BAY_MSG: HangarKey[] = [
  'grp.pilot', 'grp.manned', 'grp.remote', 'grp.power', 'grp.cooler', 'grp.shield', 'grp.quantum', 'grp.radar',
  'cls.military', 'cls.civilian', 'cls.industrial', 'cls.stealth', 'cls.competition', 'grade',
  'unit.power', 'unit.cooling', 'unit.sensitivity',
];
const dice = 'M7.5 3.5h9a4 4 0 014 4v9a4 4 0 01-4 4h-9a4 4 0 01-4-4v-9a4 4 0 014-4z';
---
<style is:inline>
/* Die Werkstatt fuellt die Spalte der Tafel (.hg-side in HangarPage.astro)
   bis zum Buehnenfuss. Die Insel-Variablen (--hg-*) setzt .hg-stagewrap. */
.hgl{position:relative;flex:1 1 auto;min-height:0;display:flex;flex-direction:column;background:var(--hg-panel);border:1px solid var(--hg-hair);border-radius:8px;backdrop-filter:blur(10px);color:var(--hg-on);overflow:hidden;box-shadow:0 18px 50px -20px var(--shadow-color)}
.hgl[hidden]{display:none}
.hgl-head{padding:.85rem 1rem .6rem;border-bottom:1px solid var(--hg-hair)}
.hgl-namebox{display:flex;align-items:center;gap:.4rem}
.hgl-name{flex:1;min-width:0;font:inherit;font-family:var(--font-display);font-size:var(--fs-10);font-weight:800;color:var(--hg-on);background:transparent;border:1px solid transparent;border-bottom-color:var(--hg-hair);border-radius:4px 4px 0 0;padding:.3rem .4rem;transition:border-color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.hgl-name::placeholder{color:color-mix(in srgb,var(--hg-on) 45%,transparent);font-weight:600}
.hgl-name:hover{border-bottom-color:color-mix(in srgb,var(--hg-amber) 60%,transparent)}
.hgl-name:focus-visible{outline:0;border-color:var(--hg-amber);background:color-mix(in srgb,var(--bg) 40%,transparent)}
.hgl-dice{appearance:none;flex:0 0 auto;width:2.3rem;height:2.3rem;display:inline-grid;place-items:center;border:1px solid var(--hg-hair);border-radius:8px;background:none;color:var(--hg-on);cursor:pointer;transition:transform var(--dur-fast) var(--ease-ui),border-color var(--dur-fast)}
.hgl-dice:hover,.hgl-dice:focus-visible{border-color:var(--hg-amber);color:var(--hg-amber)}
.hgl-dice.is-roll{animation:hgl-roll .5s var(--ease-ui)}
@keyframes hgl-roll{0%{transform:rotate(0)}60%{transform:rotate(250deg) scale(1.15)}100%{transform:rotate(360deg)}}
.hgl-state{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;margin:.5rem 0 0;font-size:var(--fs-6);color:var(--hg-dim)}
.hgl-state b{font-weight:600;color:var(--hg-on)}
.hgl-state .is-saved{color:var(--hg-amber)}
.hgl-dot{width:.45rem;height:.45rem;border-radius:50%;background:var(--hg-dim)}
.hgl-state[data-s="changed"] .hgl-dot{background:var(--hg-amber);box-shadow:0 0 8px var(--hg-amber)}
.hgl-state[data-s="saved"] .hgl-dot{background:none;width:auto;height:auto;color:var(--hg-amber)}
.hgl-state[data-s="saved"] .hgl-dot::before{content:"✓";font-style:normal;font-weight:700}
.hgl-shared{margin:.55rem 0 0;padding:.4rem .6rem;border-radius:6px;background:color-mix(in srgb,var(--hg-amber) 14%,transparent);border:1px solid color-mix(in srgb,var(--hg-amber) 45%,transparent);font-size:var(--fs-6)}
.hgl-shared[hidden]{display:none}
.hgl-views{display:flex;gap:.25rem;margin:.7rem 0 -.6rem}
.hgl-views button{appearance:none;flex:1;background:none;border:0;border-bottom:2px solid transparent;padding:.45rem .2rem .5rem;color:var(--hg-dim);font:inherit;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;cursor:pointer;font-variant-numeric:tabular-nums}
.hgl-views button:hover,.hgl-views button:focus-visible{color:var(--hg-on)}
.hgl-views button[aria-selected="true"]{color:var(--hg-on);border-bottom-color:var(--hg-amber)}
.hgl-scroll{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:.75rem .7rem .5rem}
.hgl-msgline{margin:.4rem .3rem;font-size:var(--fs-7);color:var(--hg-dim)}
.hgl-msgline[hidden],.hgl-pane[hidden]{display:none}
/* Die Reiter kleben oben, nur die Liste darunter rollt (lange Systemlisten);
   top gleicht das obere Polster von .hgl-scroll aus.
   Deckender Grund, sonst scheinen die Zeilen beim Rollen durch. */
.hgl-cats{position:sticky;top:-.75rem;z-index:2;display:flex;gap:.3rem;margin:0 0 .8rem;padding:.2rem;border-radius:8px;background:var(--bg);border:1px solid var(--hg-hair);box-shadow:0 6px 14px -8px var(--shadow-color)}
.hgl-cats[hidden],.hgl-cats button[hidden],.hgl-grp[hidden]{display:none}
.hgl-cats button{appearance:none;flex:1;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:2.1rem;border:0;border-radius:6px;background:none;color:var(--hg-dim);font:inherit;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;letter-spacing:var(--ls-6);text-transform:uppercase;cursor:pointer;transition:background var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui)}
.hgl-cats button:hover,.hgl-cats button:focus-visible{color:var(--hg-on)}
.hgl-cats button[aria-selected="true"]{background:var(--hg-amber);color:var(--ink)}
.hgl-cats i{font-style:normal;min-width:1.15rem;padding:0 .3rem;border-radius:9px;background:var(--hg-amber);color:var(--ink);font-size:var(--fs-5);line-height:1.15rem;font-variant-numeric:tabular-nums}
.hgl-cats i:empty{display:none}
.hgl-cats button[aria-selected="true"] i{background:var(--ink);color:var(--hg-amber)}
/* Lackierungen: drei Toene (Haupt, Zweit, Akzent) als Farbfeld, die gewaehlte mit Haken */
.hgl-paints{margin:0;padding:0;list-style:none}
.hgl-paint{appearance:none;display:grid;grid-template-columns:3.1rem minmax(0,1fr) 1rem;gap:.65rem;align-items:center;width:100%;margin:0 0 .35rem;padding:.5rem .6rem;border:1px solid var(--hg-hair);border-radius:8px;background:color-mix(in srgb,var(--bg) 35%,transparent);color:inherit;font:inherit;font-size:var(--fs-7);text-align:left;cursor:pointer;transition:border-color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.hgl-paint:hover,.hgl-paint:focus-visible{border-color:color-mix(in srgb,var(--hg-amber) 60%,transparent);outline:0}
.hgl-paint[aria-pressed="true"]{border-color:var(--hg-amber);background:color-mix(in srgb,var(--hg-amber) 9%,color-mix(in srgb,var(--bg) 35%,transparent))}
.hgl-sw{display:flex;height:1.6rem;border-radius:5px;overflow:hidden;box-shadow:0 0 0 1px color-mix(in srgb,var(--hg-on) 18%,transparent)}
.hgl-sw i:first-child{flex:2}
.hgl-sw i{flex:1}
.hgl-tick{width:1rem;height:1rem;border-radius:50%;border:2px solid var(--hg-hair)}
.hgl-paint[aria-pressed="true"] .hgl-tick{border-color:var(--hg-amber);background:radial-gradient(circle,var(--hg-amber) 0 45%,transparent 50%)}
.hgl-grp{margin:0 0 1rem}
.hgl-grp h3{display:flex;align-items:baseline;gap:.5rem;margin:0 .3rem .35rem;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-dim)}
.hgl-grp h3 span{flex:1;letter-spacing:var(--ls-6);text-transform:uppercase}
.hgl-grp h3 b{color:var(--hg-on);font-variant-numeric:tabular-nums}
.hgl-gd{font-style:normal;font-size:var(--fs-5);font-variant-numeric:tabular-nums}
.hgl-gd.is-up{color:var(--hg-amber)}
.hgl-gd.is-down{color:color-mix(in srgb,var(--hot) 60%,var(--hg-on))}
.hgl-grp ul,.hgl-opts,.hgl-list{margin:0;padding:0;list-style:none}
.hgl-slot{margin:0 0 .35rem;border:1px solid var(--hg-hair);border-radius:8px;background:color-mix(in srgb,var(--bg) 35%,transparent);transition:border-color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.hgl-slot[data-changed]{border-color:color-mix(in srgb,var(--hg-amber) 55%,transparent);background:color-mix(in srgb,var(--hg-amber) 7%,color-mix(in srgb,var(--bg) 35%,transparent))}
.hgl-slot.is-open{border-color:var(--hg-amber)}
.hgl-slot.is-flash{animation:hgl-flash .7s var(--ease-ui)}
@keyframes hgl-flash{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--hg-amber) 70%,transparent)}100%{box-shadow:0 0 0 12px transparent}}
.hgl-slot__btn{appearance:none;display:grid;grid-template-columns:2.1rem minmax(0,1fr) auto 1rem;gap:.6rem;align-items:center;width:100%;margin:0;padding:.5rem .55rem;background:none;border:0;border-radius:8px;color:inherit;font:inherit;font-size:var(--fs-7);text-align:left;cursor:pointer}
.hgl-slot__btn:focus-visible{outline:2px solid var(--hg-amber);outline-offset:-2px}
.hgl-sz{display:inline-grid;place-items:center;height:2.1rem;border-radius:6px;background:color-mix(in srgb,var(--hg-on) 8%,transparent);font-family:var(--font-ui);font-size:var(--fs-6);font-weight:800;color:var(--hg-on)}
.hgl-slot[data-type="gun"] .hgl-sz{background:color-mix(in srgb,var(--hg-amber) 20%,transparent);color:var(--hg-amber)}
.hgl-nm{line-height:1.3;min-width:0}
.hgl-nm strong{display:block;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hgl-nm small{display:block;color:var(--hg-dim);font-size:var(--fs-5);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hgl-nm .hgl-was{color:color-mix(in srgb,var(--hg-amber) 70%,var(--hg-dim))}
.hgl-fig{text-align:right;font-variant-numeric:tabular-nums;font-weight:700;white-space:nowrap;line-height:1.2}
.hgl-fig small{display:block;color:var(--hg-dim);font-size:var(--fs-5);font-weight:400}
.hgl-chev{color:var(--hg-dim);transition:transform var(--dur-fast) var(--ease-ui)}
.hgl-slot.is-open .hgl-chev{transform:rotate(90deg);color:var(--hg-amber)}
.hgl-pick{padding:0 .55rem .6rem}
.hgl-pick[hidden]{display:none}
.hgl-pickbar{display:flex;align-items:center;gap:.5rem;margin:0 0 .4rem}
.hgl-q{flex:1;min-width:0;font:inherit;font-size:var(--fs-6);background:color-mix(in srgb,var(--bg) 55%,transparent);color:var(--hg-on);border:1px solid var(--hg-hair);border-radius:6px;padding:.4rem .55rem}
.hgl-q:focus-visible{outline:0;border-color:var(--hg-amber)}
.hgl-n{font-size:var(--fs-5);color:var(--hg-dim);white-space:nowrap;font-variant-numeric:tabular-nums}
.hgl-opts{position:relative;max-height:min(320px,42vh);overflow-y:auto;overscroll-behavior:contain;margin:0 -.2rem;padding:0 .2rem}
.hgl-opt{appearance:none;position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto 3.6rem;gap:.15rem .6rem;align-items:center;width:100%;margin:0 0 2px;padding:.4rem .5rem .55rem;background:none;border:1px solid transparent;border-radius:6px;color:inherit;font:inherit;font-size:var(--fs-6);text-align:left;cursor:pointer;overflow:hidden}
.hgl-opt:hover,.hgl-opt:focus-visible{border-color:var(--hg-hair);background:color-mix(in srgb,var(--hg-on) 5%,transparent);outline:0}
.hgl-opt[aria-pressed="true"]{border-color:var(--hg-amber);background:color-mix(in srgb,var(--hg-amber) 10%,transparent)}
.hgl-opt__nm{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hgl-opt__nm em{margin-left:.35rem;padding:0 .35rem;border:1px solid var(--hg-hair);border-radius:999px;font-style:normal;font-size:var(--fs-5);font-weight:600;color:var(--hg-dim)}
.hgl-opt[aria-pressed="true"] .hgl-opt__nm em.is-fit{border-color:var(--hg-amber);color:var(--hg-amber)}
.hgl-opt__sub{grid-column:1;font-size:var(--fs-5);line-height:1.35;color:var(--hg-dim)}
.hgl-opt__fig{grid-row:1/3;grid-column:2;text-align:right;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.hgl-opt__d{grid-row:1/3;grid-column:3;text-align:right;font-size:var(--fs-5);font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
.hgl-opt__d.is-up{color:var(--hg-amber)}
.hgl-opt__d.is-down{color:color-mix(in srgb,var(--hot) 60%,var(--hg-on))}
.hgl-opt__d.is-flat{color:var(--hg-dim)}
.hgl-opt__bar{position:absolute;left:.5rem;right:.5rem;bottom:.2rem;height:2px;border-radius:1px;background:var(--line-soft)}
.hgl-opt__bar i{display:block;height:100%;width:var(--w,0%);border-radius:1px;background:color-mix(in srgb,var(--hg-amber) 75%,transparent)}
.hgl-revert{appearance:none;margin:.45rem 0 0;padding:0;border:0;background:none;color:var(--hg-amber);font:inherit;font-size:var(--fs-6);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.hgl-revert[hidden]{display:none}
.hgl-note{margin:.4rem .3rem .2rem;font-size:var(--fs-5);color:var(--hg-dim)}
/* Gespeicherte Layouts */
.hgl-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem .6rem;align-items:center;margin:0 0 .4rem;padding:.6rem .7rem;border:1px solid var(--hg-hair);border-radius:8px;background:color-mix(in srgb,var(--bg) 35%,transparent)}
.hgl-card.is-here{border-color:color-mix(in srgb,var(--hg-amber) 50%,transparent)}
.hgl-card.is-current{border-color:var(--hg-amber);background:color-mix(in srgb,var(--hg-amber) 9%,transparent)}
.hgl-card h4{margin:0;font-family:var(--font-ui);font-size:var(--fs-8);font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hgl-card p{grid-column:1;margin:0;font-size:var(--fs-5);color:var(--hg-dim)}
.hgl-card p b{color:var(--hg-on);font-weight:600}
.hgl-card__tag{display:inline-block;vertical-align:.1em;margin-left:.45rem;padding:0 .35rem;border-radius:999px;background:color-mix(in srgb,var(--hg-amber) 20%,transparent);color:var(--hg-amber);font-size:var(--fs-5);font-weight:700}
.hgl-card__acts{grid-row:1/3;grid-column:2;display:flex;gap:.3rem}
.hgl-mini{appearance:none;padding:.3rem .55rem;border:1px solid var(--hg-hair);border-radius:6px;background:none;color:var(--hg-on);font:inherit;font-size:var(--fs-5);font-weight:600;cursor:pointer;white-space:nowrap}
.hgl-mini:hover,.hgl-mini:focus-visible{border-color:var(--hg-amber);color:var(--hg-amber)}
.hgl-mini.is-main{background:var(--hg-amber);border-color:var(--hg-amber);color:var(--ink)}
.hgl-mini.is-main:hover,.hgl-mini.is-main:focus-visible{background:color-mix(in srgb,var(--hg-amber) 82%,var(--text));color:var(--ink)}
.hgl-mini[data-del]{padding:.3rem .45rem}
.hgl-empty{margin:1.2rem .5rem;text-align:center;font-size:var(--fs-7);color:var(--hg-dim)}
/* Fuss: Speichern ist der Weg, Teilen der Spass, Serie die Notbremse. */
.hgl-foot{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;padding:.65rem .8rem .75rem;border-top:1px solid var(--hg-hair);background:color-mix(in srgb,var(--bg) 55%,transparent)}
.hgl-btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.55rem .85rem;border:1px solid var(--hg-hair);border-radius:6px;background:none;color:var(--hg-on);font:inherit;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;cursor:pointer;white-space:nowrap;transition:transform var(--dur-fast) var(--ease-ui),background var(--dur-fast),border-color var(--dur-fast)}
.hgl-btn:hover,.hgl-btn:focus-visible{border-color:var(--hg-amber)}
.hgl-btn:active{transform:scale(.97)}
.hgl-btn.is-main{flex:1;background:var(--hg-amber);border-color:var(--hg-amber);color:var(--ink)}
.hgl-btn.is-main:hover,.hgl-btn.is-main:focus-visible{background:color-mix(in srgb,var(--hg-amber) 82%,var(--text))}
.hgl-btn:disabled{opacity:.5;cursor:default;transform:none}
.hgl-btn.is-done{border-color:var(--hg-amber);box-shadow:0 0 0 3px color-mix(in srgb,var(--hg-amber) 35%,transparent)}
.hgl-ghost{margin-left:auto;padding-inline:.5rem;border-color:transparent;color:var(--hg-dim);font-weight:600}
.hgl-copyfield{flex-basis:100%;min-width:0;font:inherit;font-size:var(--fs-5);background:color-mix(in srgb,var(--bg) 55%,transparent);color:var(--hg-on);border:1px solid var(--hg-hair);border-radius:6px;padding:.35rem .5rem}
.hgl-copyfield[hidden]{display:none}
/* Meldung ueber dem Fuss */
.hgl-toast{position:absolute;left:.8rem;right:.8rem;bottom:4.4rem;display:flex;align-items:center;gap:.6rem;padding:.55rem .75rem;border-radius:8px;background:var(--bg-2);border:1px solid var(--hg-amber);box-shadow:0 10px 30px -10px var(--shadow-color);font-size:var(--fs-6);color:var(--hg-on);transform:translateY(8px);opacity:0;pointer-events:none;transition:opacity var(--dur-fast) var(--ease-ui),transform var(--dur-fast) var(--ease-ui)}
.hgl-toast.is-on{opacity:1;transform:none;pointer-events:auto}
.hgl-toast span{flex:1}
.hgl-toast button{appearance:none;border:0;background:none;padding:0;color:var(--hg-amber);font:inherit;font-weight:700;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.hgl-toast button[hidden]{display:none}
/* Im Werkstatt-Modus markiert die Buehne nur den Slot unter dem Zeiger oder
   in der Auswahl; die Hardpoints mit Slot im gewaehlten Reiter (Waffen oder
   Systeme) und ihre getauschten Teile samt Namen setzt paintMods in
   #hgl-mods darueber. Raketen und Fracht haben hier keinen Slot. */
.hg[data-pane="layout"] .hgx-mk{display:none}
.hg[data-pane="layout"] .hgx-mk.is-hot[data-tab],.hg[data-pane="layout"] .hgx-mk.is-sel[data-tab]{display:block}
/* Getauschte Hardpoints: Marker und Name des neuen Teils setzt
   assets/hangar-layouts.js als Regeln in #hgl-mods (content je Port). */
.hg[data-pane="layout"] .hgx-mk::after{position:absolute;left:calc(100% + 6px);top:50%;transform:translateY(-50%);padding:.15rem .45rem;border-radius:3px;background:var(--hg-amber);color:var(--ink);font-size:var(--fs-5);font-weight:700;white-space:nowrap;pointer-events:none}
/* mobile-ux.css setzt unter 820 px jeden button auf inline-flex und schlaegt damit hidden. */
.hgl button[hidden]{display:none}
@media (min-width:761px) and (max-height:820px){
  .hgl-head{padding:.6rem .9rem .5rem}
  .hgl-name{font-size:var(--fs-9)}
  .hgl-opts{max-height:min(240px,34vh)}
}
@media (max-width:760px){
  .hgl{position:static;width:auto;border-radius:0;border-width:1px 0 0;background:var(--bg-2);backdrop-filter:none;box-shadow:none;overflow:visible}
  .hgl-scroll{overflow:visible}
  .hgl-cats{top:var(--nav-h,68px);background:var(--bg-2);backdrop-filter:none}
  .hgl-foot{position:sticky;bottom:0;z-index:2}
  .hgl-toast{position:fixed;bottom:5.2rem;z-index:5}
  .hgl-opts{max-height:50vh}
}
@media (prefers-reduced-motion:reduce){.hgl-dice.is-roll,.hgl-slot.is-flash{animation:none}.hgl-toast,.hgl-chev,.hgl-slot,.hgl-btn{transition:none}}
</style>

<aside class="hgl" id="hgl" role="tabpanel" aria-labelledby="hg-pane-layout" data-lang={lang} data-src={layoutDataHref()}>
  <div class="hgl-head">
    <div class="hgl-namebox" data-help={h('hangar.ctl.layoutName')}>
      <input class="hgl-name" id="hgl-name" type="text" maxlength="60" autocomplete="off" spellcheck="false" aria-label={l('name.label')} />
      <button type="button" class="hgl-dice" id="hgl-dice" aria-label={l('name.dice')} title={l('name.dice')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={dice} fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="9" cy="9" r="1.4" fill="currentColor" /><circle cx="15" cy="9" r="1.4" fill="currentColor" /><circle cx="12" cy="12" r="1.4" fill="currentColor" /><circle cx="9" cy="15" r="1.4" fill="currentColor" /><circle cx="15" cy="15" r="1.4" fill="currentColor" /></svg>
      </button>
    </div>
    <p class="hgl-state" id="hgl-state" data-s="stock" aria-live="polite"><i class="hgl-dot" aria-hidden="true"></i><b id="hgl-state-txt">{l('state.stock')}</b><span id="hgl-state-sub"></span></p>
    <p class="hgl-shared" id="hgl-shared" hidden>{l('shared')}</p>
    <div class="hgl-views" role="tablist" aria-label={l('title')}>
      <button type="button" role="tab" id="hgl-v-build" aria-controls="hgl-build" aria-selected="true">{l('view.build')}</button>
      <button type="button" role="tab" id="hgl-v-saved" aria-controls="hgl-saved" aria-selected="false" tabindex="-1">{l('view.saved')} (<span id="hgl-count">0</span>)</button>
    </div>
  </div>
  <div class="hgl-scroll" id="hgl-scroll">
    <div class="hgl-pane" id="hgl-build" role="tabpanel" aria-labelledby="hgl-v-build" data-help={h('hangar.ctl.layoutSlots')}>
      <p class="hgl-msgline" id="hgl-loading">{l('loading')}</p>
      <p class="hgl-msgline" id="hgl-failed" role="alert" hidden>{l('failed')} <button type="button" class="hgl-revert" id="hgl-retry">{l('retry')}</button></p>
      <div class="hgl-cats" id="hgl-cats" role="tablist" aria-label={l('cat.label')} hidden>
        <button type="button" role="tab" id="hgl-c-weapons" data-cat="weapons" aria-selected="true" aria-controls="hgl-slots">{t('tab.weapons')}<i data-cat-n="weapons"></i></button>
        <button type="button" role="tab" id="hgl-c-systems" data-cat="systems" aria-selected="false" aria-controls="hgl-slots" tabindex="-1">{t('tab.systems')}<i data-cat-n="systems"></i></button>
        <button type="button" role="tab" id="hgl-c-paint" data-cat="paint" aria-selected="false" aria-controls="hgl-slots" tabindex="-1" hidden>{l('cat.paint')}<i data-cat-n="paint"></i></button>
      </div>
      <div id="hgl-slots"></div>
      <p class="hgl-note">{l('note')}</p>
    </div>
    <div class="hgl-pane" id="hgl-saved" role="tabpanel" aria-labelledby="hgl-v-saved" hidden>
      <ul class="hgl-list" id="hgl-list"></ul>
    </div>
  </div>
  <div class="hgl-foot" data-help={h('hangar.ctl.layoutSave')}>
    <button type="button" class="hgl-btn is-main" id="hgl-save">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      <span>{l('act.save')}</span>
    </button>
    <button type="button" class="hgl-btn" id="hgl-share">
      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      <span>{l('act.share')}</span>
    </button>
    <button type="button" class="hgl-btn hgl-ghost" id="hgl-reset">{l('act.reset')}</button>
    <input class="hgl-copyfield" id="hgl-copyfield" type="text" readonly hidden aria-label={l('act.share')} />
  </div>
  <div class="hgl-toast" id="hgl-toast" role="status"><span id="hgl-toast-txt"></span><button type="button" id="hgl-undo" hidden>{l('msg.undo')}</button></div>
  <div id="hgl-msg" hidden>
    {LAYOUT_MSG.map((k) => <span data-m={k}>{l(k)}</span>)}
    {BAY_MSG.map((k) => <span data-m={k}>{t(k)}</span>)}
  </div>
</aside>
