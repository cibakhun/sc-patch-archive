---
// Die Oberflaeche um die Szene, EIN Koerper fuer DE und EN (D-12): Titel,
// Kennwerte und Ausstattung in Tabs, Werkzeuge, Dock und der Controller
// (assets/hangar-overview.js). Die Szene ist HangarApp.astro (Sache der
// Szenen-Sitzung); sie stellt in ihrer Buehne einen <slot /> bereit, darin
// stehen Titel und Werkzeuge im selben Kasten wie #hg-canvas. Modell-URLs,
// Viewer und Szenen-Optionen liest der Controller aus #hg-stage
// (src/lib/hangar/stage.ts), nie aus dieser Datei.
//
// Ohne Abruf bekommt der Besucher das Dock mit allen 227 Schiffen und die
// ganze Bucht des Startschiffs (Kopf und vier Tabs), gerendert von derselben
// ShipBay-Komponente wie /hangar-bay/<id>.html. Jedes andere Schiff kostet
// einen Abruf seines Buchtdokuments; die Seite waechst nicht mit den Loadouts.
import SiteNav from '../SiteNav.astro';
import HangarApp from './HangarApp.astro';
import ShipBay from './ShipBay.astro';
import { localeFromPath, href } from '../../i18n/ui';
import { hangarT } from '../../i18n/hangarText';
import { versioned } from '../../lib/assetVersion';
import { HANGAR_IDS, HANGAR_DEFAULT_SHIP, STATS, shipFacts } from '../../lib/hangar/catalog';
import { buildBay, TABS } from '../../lib/hangar/bay';

const lang = localeFromPath(Astro.url.pathname);
const loc = lang === 'de' ? 'de-DE' : 'en-US';
const t = hangarT(lang);

const ships = HANGAR_IDS.map((id) => shipFacts(id, lang)).sort((a, b) => a.name.localeCompare(b.name, loc));
// Filterschlüssel ist der deutsche Typ (in beiden Sprachen derselbe), damit
// beide Seiten dieselbe Zahl Optionen tragen (verify:sync, Strukturgleichheit):
// die englischen Beschriftungen fassen teils zwei deutsche Typen zusammen.
const types = [...new Map(ships.filter((s) => s.typeKey).map((s) => [s.typeKey, s.typeLabel || s.typeKey])).entries()]
  .map(([key, label]) => ({ key, label }))
  .sort((a, b) => a.label.localeCompare(b.label, loc));
const makers = [...new Set(ships.map((s) => s.maker).filter(Boolean))].sort((a, b) => a.localeCompare(b, loc));
const bay = buildBay(HANGAR_DEFAULT_SHIP, lang);
// Gueltige Sortierschluessel fuer den URL-Zustand, aus dem Kennwert-Verzeichnis.
const sorts = ['name', ...STATS.filter((s) => s.sortable).map((s) => s.key)].join(' ');
const count = t(new Intl.PluralRules(loc).select(ships.length) === 'one' ? 'msg.count.one' : 'msg.count.other', { n: ships.length.toLocaleString(loc) });
const controller = versioned('assets/hangar-overview.js', '/assets/hangar-overview.js');
---
<style is:inline>
/* Die Bühne ist eine dunkle Insel (data-media-surface, theme.css): im
   Hellmodus bleibt sie Halle, nur das Karussell darunter wird Papier. */
.hg{display:block}
/* Auf der Insel selbst deklariert, nicht an .hg: eine Variable, die auf
   var(--text) verweist, loest dort auf, wo sie steht — an .hg waere das
   noch der Papierwert, nicht der Inselwert. */
.hg-stagewrap{--hg-top:76px;--hg-amber:var(--accent);--hg-on:var(--text);--hg-dim:var(--muted);--hg-panel:color-mix(in srgb,var(--bg) 74%,transparent);--hg-hair:var(--line)}
.hg-stagewrap{position:relative}
.hg-title{position:absolute;left:clamp(16px,3vw,40px);top:calc(var(--hg-top) + 12px);max-width:min(520px,60%);pointer-events:none}
.hg-title h1{margin:0 0 .4rem;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-amber)}
.hg-maker{margin:0;font-family:var(--font-ui);font-size:var(--fs-7);color:var(--hg-dim)}
.hg-name{margin:.1rem 0 .3rem;font-family:var(--font-display);font-weight:900;font-size:clamp(2rem,5vw,3.6rem);line-height:1.02;color:var(--hg-on);text-shadow:0 2px 18px var(--shadow-color)}
.hg-role{margin:0;font-size:var(--fs-7);color:var(--hg-dim)}
/* über heller Halle lesbar bleiben: Schatten statt Fläche */
.hg-maker,.hg-role{color:color-mix(in srgb,var(--hg-on) 82%,transparent);text-shadow:0 1px 3px var(--bg),0 0 14px var(--bg)}
.hg-title.is-swap{animation:hg-swap var(--dur-slow) var(--ease-ui)}
@keyframes hg-swap{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.hg-stats{position:absolute;right:clamp(16px,3vw,40px);top:calc(var(--hg-top) + 12px);width:min(360px,34vw);max-height:calc(100% - var(--hg-top) - 28px);display:flex;flex-direction:column;background:var(--hg-panel);border:1px solid var(--hg-hair);border-radius:6px;padding:.3rem 1.1rem 1rem;backdrop-filter:blur(8px)}
.hgx-stats{margin:0;display:grid;gap:.55rem}
.hg-row{display:grid;grid-template-columns:1fr auto;gap:.15rem .6rem;font-size:var(--fs-7)}
.hg-row dt{color:var(--hg-dim)}
.hg-row dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;color:var(--hg-on);font-weight:600}
.hg-bar{grid-column:1/-1;height:4px;background:var(--line-soft);border-radius:2px;overflow:hidden}
.hg-bar i{display:block;height:100%;width:var(--w,0%);background:var(--hg-amber);transition:width var(--dur-slow) var(--ease-ui)}
.hg-row.is-na dd{color:var(--hg-dim);font-weight:400}
.hg-note{margin:.8rem 0 0;font-size:var(--fs-5);color:var(--hg-dim)}
.hg-sheet{display:flex;justify-content:center;margin-top:.9rem;padding:.65rem 1rem;background:var(--hg-amber);color:var(--ink);font-family:var(--font-ui);font-weight:700;border-radius:4px;text-decoration:none}
.hg-sheet:hover,.hg-sheet:focus-visible{background:color-mix(in srgb,var(--hg-amber) 82%,var(--text))}
.hg-tools{position:absolute;left:clamp(16px,3vw,40px);bottom:16px;display:flex;gap:.6rem;align-items:center}
.hg-btn{appearance:none;border:1px solid var(--hg-hair);background:var(--hg-panel);color:var(--hg-on);font:inherit;font-size:var(--fs-6);padding:.45rem .8rem;border-radius:4px;cursor:pointer}
.hg-btn:hover,.hg-btn:focus-visible{border-color:var(--hg-amber)}
.hg-hint{font-size:var(--fs-5);color:color-mix(in srgb,var(--hg-on) 80%,transparent);background:var(--hg-panel);border-radius:4px;padding:.3rem .55rem;backdrop-filter:blur(6px)}
/* Aktionen unter dem Titel; der Titel selbst laesst Klicks zur Leinwand durch. */
.hgx-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.85rem;pointer-events:auto}
.hgx-act.is-done{border-color:var(--hg-amber);color:var(--hg-amber)}
.hgx-copyfield{width:min(320px,100%);min-width:0;font:inherit;font-size:var(--fs-6);background:var(--hg-panel);color:var(--hg-on);border:1px solid var(--hg-hair);border-radius:4px;padding:.4rem .55rem}
.hg-title.is-busy .hgx-head,.hgx-scroll[aria-busy="true"] .hgx-tps{opacity:.45;transition:opacity var(--dur-fast) var(--ease-ui)}
/* Tabs nach dem WAI-ARIA-Muster; der aktive traegt die Akzentkante. */
.hgx-tabs{display:flex;margin:0 -.5rem .75rem;border-bottom:1px solid var(--hg-hair)}
.hgx-tabs button{flex:1 1 0;min-width:0;appearance:none;background:none;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;padding:.6rem .2rem .45rem;color:var(--hg-dim);font:inherit;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;cursor:pointer;transition:color var(--dur-fast) var(--ease-ui),border-color var(--dur-fast) var(--ease-ui)}
.hgx-tabs button:hover,.hgx-tabs button:focus-visible{color:var(--hg-on)}
.hgx-tabs button[aria-selected="true"]{color:var(--hg-on);border-bottom-color:var(--hg-amber)}
.hgx-scroll{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;margin-right:-.6rem;padding-right:.6rem}
.hgx-grp{margin:0 0 .9rem}
.hgx-grp h3{display:flex;justify-content:space-between;align-items:baseline;gap:.6rem;margin:0 0 .3rem;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-amber)}
.hgx-grp h3 b{color:var(--hg-on);font-variant-numeric:tabular-nums;white-space:nowrap}
.hgx-grp ul{margin:0;padding:0;list-style:none}
.hgx-slot__btn{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;gap:.55rem;align-items:center;width:100%;margin:0;padding:.3rem .35rem;appearance:none;background:none;border:1px solid transparent;border-radius:4px;color:var(--hg-on);font:inherit;font-size:var(--fs-7);text-align:left;cursor:pointer;transition:border-color var(--dur-fast) var(--ease-ui)}
.hgx-slot__btn:hover,.hgx-slot__btn:focus-visible{border-color:var(--hg-hair)}
.hgx-slot__btn[aria-expanded="true"]{border-color:var(--hg-amber)}
.hgx-sz{font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-dim)}
.hgx-nm{line-height:1.3}
.hgx-nm small{display:block;color:var(--hg-dim);font-size:var(--fs-5)}
.hgx-v{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap;line-height:1.2}
.hgx-v small{display:block;color:var(--hg-dim);font-size:var(--fs-5);font-weight:400}
.hgx-d{padding:.25rem .35rem .65rem 2.9rem;font-size:var(--fs-6)}
.hgx-d dl{display:grid;grid-template-columns:auto 1fr;gap:.15rem .8rem;margin:0}
.hgx-d dt{color:var(--hg-dim);white-space:nowrap}
.hgx-d dd{margin:0;text-align:right;font-variant-numeric:tabular-nums}
.hgx-links{display:flex;flex-wrap:wrap;gap:.25rem 1rem;margin:.5rem 0 0}
.hgx-links a{color:var(--hg-amber)}
.hgx-empty{margin:.3rem 0;color:var(--hg-dim);font-size:var(--fs-7)}
/* Der Weg zum Datenblatt bleibt am Fuss der Tafel stehen, auch wenn eine
   lange Ausstattung darueber scrollt. */
.hgx-foot{position:sticky;bottom:0;margin:0}
.hgx-stats+.hgx-grp{margin-top:.9rem}
.hgx-err{font-size:var(--fs-7);color:var(--hg-on)}
.hgx-err p{margin:.3rem 0 .7rem}
.hgx-modelerr{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);width:min(360px,80%);margin:0;padding:.6rem .8rem;border-radius:6px;background:var(--hg-panel);color:var(--hg-on);font-size:var(--fs-7);text-align:center;backdrop-filter:blur(6px)}
.hgx-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
/* Hardpoint-Marker ueber der Leinwand: der Controller setzt sie je Bild per
   transform auf die Projektion ihres Punkts. Nur der aktive Ausstattungs-Tab
   zeigt seine Marker; hinter der Rumpfmitte dimmen sie. */
.hgx-marks{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.hgx-marks:not([data-live]) .hgx-mk{visibility:hidden}
.hgx-mk{position:absolute;left:0;top:0;width:16px;height:16px;margin:-8px 0 0 -8px;border:2px solid var(--hg-amber);border-radius:50%;background:color-mix(in srgb,var(--hg-amber) 30%,transparent);box-shadow:0 0 0 1px color-mix(in srgb,var(--bg) 55%,transparent);pointer-events:auto;cursor:pointer;transition:opacity var(--dur-fast) var(--ease-ui)}
.hgx-mk[data-tab="systems"]{border-color:var(--accent-2);background:color-mix(in srgb,var(--accent-2) 30%,transparent)}
.hgx-mk.is-far{opacity:.35}
.hgx-mk.is-hot,.hgx-mk.is-sel{z-index:1;width:22px;height:22px;margin:-11px 0 0 -11px;opacity:1;background:color-mix(in srgb,var(--hg-amber) 55%,transparent)}
.hgx-mk b{display:none;position:absolute;left:calc(100% + 6px);top:50%;transform:translateY(-50%);padding:.15rem .45rem;border-radius:3px;background:var(--hg-panel);color:var(--hg-on);font-size:var(--fs-5);font-weight:600;white-space:nowrap;pointer-events:none;backdrop-filter:blur(6px)}
.hgx-mk.is-hot b,.hgx-mk.is-sel b,.hgx-mk:hover b{display:block}
.hg:not([data-tab-active="weapons"]) .hgx-mk[data-tab="weapons"],.hg:not([data-tab-active="systems"]) .hgx-mk[data-tab="systems"],.hg:not([data-tab-active="cargo"]) .hgx-mk[data-tab="cargo"]{display:none}

.hg-dock{background:linear-gradient(180deg,var(--bg-2),var(--bg));border-top:1px solid color-mix(in srgb,var(--accent) 40%,transparent);padding:.9rem clamp(16px,3vw,40px) 1.2rem;color:var(--text)}
.hg-filter{display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;margin-bottom:.8rem}
.hg-filter input,.hg-filter select{font:inherit;font-size:var(--fs-7);background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:4px;padding:.45rem .6rem;min-width:0}
.hg-filter input{flex:1 1 200px;max-width:320px}
.hg-count{margin-left:auto;font-size:var(--fs-6);color:var(--muted);font-variant-numeric:tabular-nums}
.hg-rail{position:relative;display:flex;align-items:stretch;gap:.5rem}
.hg-strip{display:flex;gap:.6rem;overflow-x:auto;scroll-snap-type:x proximity;scroll-behavior:smooth;padding:.45rem .3rem .7rem;margin:0;list-style:none;flex:1;min-width:0;overscroll-behavior-x:contain}
.hg-strip li{flex:0 0 auto;scroll-snap-align:start}
.hg-strip li[hidden]{display:none}
/* Kacheln wie im Hangar-Menü eines Spiels: Bild füllt die Kachel, Name
   auf einem Verlauf am unteren Rand, gewählte Kachel leuchtet. */
.hg-card{position:relative;display:block;width:176px;height:100px;padding:0;background:var(--surface-2);border:1px solid var(--line);border-radius:3px;overflow:hidden;color:var(--text);text-decoration:none;cursor:pointer;font:inherit;text-align:left;transition:transform var(--dur-fast) var(--ease-ui),border-color var(--dur-fast),box-shadow var(--dur-fast)}
.hg-card:hover,.hg-card:focus-visible{border-color:color-mix(in srgb,var(--accent) 70%,transparent);transform:translateY(-2px)}
.hg-card[aria-current="true"]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 0 18px color-mix(in srgb,var(--accent) 40%,transparent);transform:translateY(-3px)}
.hg-card img,.hg-card .hg-noimg{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;background:var(--surface-2);filter:saturate(.8) brightness(.72);transition:filter var(--dur-fast)}
.hg-card:hover img,.hg-card[aria-current="true"] img{filter:none}
.hg-card span{position:absolute;left:0;right:0;bottom:0;padding:1.3rem .55rem .35rem;background:linear-gradient(transparent,color-mix(in srgb,var(--bg) 94%,transparent) 70%);font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;letter-spacing:var(--ls-6);text-transform:uppercase;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hg-card small{position:absolute;top:.35rem;left:.4rem;max-width:calc(100% - .8rem);padding:.05rem .35rem;background:color-mix(in srgb,var(--bg) 78%,transparent);border-radius:2px;font-size:var(--fs-5);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hg-arrow{flex:0 0 auto;width:2.4rem;border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:6px;font-size:var(--fs-12);cursor:pointer}
.hg-arrow:hover,.hg-arrow:focus-visible{border-color:var(--accent)}
.hg-empty{color:var(--muted);font-size:var(--fs-7);padding:1rem 0}
.hg-empty[hidden]{display:none}

/* Flache Fenster (1280x720): Ueberblick und Datenblatt-Knopf passen ohne
   Bildlauf in die Buehne. */
@media (min-width:761px) and (max-height:820px){
  .hgx-tabs{margin-bottom:.45rem}
  .hgx-tabs button{padding:.45rem .2rem .35rem}
  .hgx-stats{gap:.25rem}
  .hg-note{margin-top:.35rem}
  .hg-sheet{margin-top:.45rem;padding:.5rem 1rem}
}
@media (max-width:760px){
  .hg-title{max-width:calc(100% - 32px)}
  .hg-stats{position:static;width:auto;max-height:none;border-radius:0;border-width:1px 0 0;background:var(--bg-2);color:var(--text);backdrop-filter:none}
  .hgx-scroll{overflow:visible;margin-right:0;padding-right:0}
  .hgx-foot{position:static}
  .hgx-mk{width:12px;height:12px;margin:-6px 0 0 -6px}
  .hg-hint{display:none}
  .hg-arrow{display:none}
  .hg-count{margin-left:0;width:100%}
}
@media (prefers-reduced-motion:reduce){.hg-card{transition:none;transform:none!important}.hg-strip{scroll-behavior:auto}.hg-bar i{transition:none}.hg-title.is-swap{animation:none}.hgx-tabs button,.hgx-slot__btn,.hgx-mk{transition:none}}</style>

<SiteNav crumbs={lang === 'de' ? [{ label: 'Schiffe', href: '/de/schiffe.html' }, { label: 'Hangar' }] : [{ label: 'Ships', href: '/schiffe.html' }, { label: 'Hangar' }]} hasEn={true} />

<main class="hg" id="main" data-loc={loc} data-default-ship={HANGAR_DEFAULT_SHIP} data-bay-base={href('/hangar-bay/', lang)} data-tab-active="overview">
  <div class="hg-stagewrap" data-media-surface>
    <HangarApp>
      <ShipBay bay={bay} region="marks" />
      <header class="hg-title">
        <h1>Hangar</h1>
        <ShipBay bay={bay} region="head" />
        <div class="hgx-actions" role="group" aria-label={t('act.group')}>
          <span data-slot="fleet-action" hidden></span>
          <button type="button" class="hg-btn hgx-act" id="hgx-copy">{t('act.copy')}</button>
          <input class="hgx-copyfield" id="hgx-copyfield" type="text" readonly hidden aria-label={t('act.copyField')} />
        </div>
      </header>
      <p class="hgx-modelerr" id="hgx-modelerr" role="status" hidden>{t('model.failed')}</p>
      <div class="hg-tools">
        <button type="button" class="hg-btn" id="hg-reset">{t('act.reset')}</button>
        <span class="hg-hint">{t('act.hint')}</span>
      </div>
    </HangarApp>
    <div data-slot="stagebar" hidden></div>
    <aside class="hg-stats" aria-label={t('panel.label')}>
      <div class="hgx-tabs" role="tablist" aria-label={t('panel.tabs')}>
        {TABS.map((k) => (
          <button type="button" role="tab" id={`hgx-tab-${k}`} data-tab={k} aria-controls={`hgx-tp-${k}`} aria-selected={k === 'overview' ? 'true' : 'false'} tabindex={k === 'overview' ? '0' : '-1'}>{t(`tab.${k}`)}</button>
        ))}
      </div>
      <div class="hgx-scroll" id="hgx-panelhost" aria-busy="false">
        <ShipBay bay={bay} region="panel" />
        <div class="hgx-err" id="hgx-bayerr" role="alert" hidden>
          <p>{t('bay.failed')}</p>
          <button type="button" class="hg-btn" id="hgx-bayretry">{t('bay.retry')}</button>
        </div>
      </div>
    </aside>
  </div>

  <section class="hg-dock" data-media-surface aria-label={t('dock.label')}>
    <div class="hg-filter">
      <input id="hg-q" type="search" placeholder={t('dock.search')} aria-label={t('dock.searchLabel')} autocomplete="off" />
      <select id="hg-type" aria-label={t('dock.type')}>
        <option value="">{t('dock.typeAll')}</option>
        {types.map((ty) => <option value={ty.key}>{ty.label}</option>)}
      </select>
      <select id="hg-maker-f" aria-label={t('dock.maker')}>
        <option value="">{t('dock.makerAll')}</option>
        {makers.map((m) => <option value={m}>{m}</option>)}
      </select>
      <span class="hg-count" id="hg-count" aria-live="polite">{count}</span>
    </div>
    <div class="hg-rail">
      <button type="button" class="hg-arrow" id="hg-prev" aria-label={t('dock.prev')}>‹</button>
      <ul class="hg-strip" id="hg-strip" data-sorts={sorts}>
        {ships.map((s) => (
          <li data-id={s.id} data-t={s.typeKey} data-mk={s.maker} data-q={`${s.name} ${s.maker} ${s.makerCode}`.toLowerCase()}>
            {/* href = Datenblatt: ohne Skript (oder per Mittelklick) führt die Karte
                dorthin; mit Skript fängt der Klick ab und stellt das Schiff in die Halle. */}
            <a class="hg-card" href={href(s.sheetPath, lang)} data-id={s.id} aria-current={s.id === bay.id ? 'true' : 'false'}>
              {s.thumb ? <img src={s.thumb} alt="" loading="lazy" decoding="async" width="156" height="88" /> : <i class="hg-noimg"></i>}
              <span>{s.name}</span>
              <small>{s.maker}</small>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="hg-arrow" id="hg-next" aria-label={t('dock.next')}>›</button>
    </div>
    <p class="hg-empty" id="hg-empty" hidden>{t('dock.empty')}</p>
  </section>

  <p class="hgx-sr" id="hgx-live" aria-live="polite"></p>
  <div id="hgx-msg" hidden>
    <span data-msg="count" data-one={t('msg.count.one')} data-other={t('msg.count.other')}></span>
    <span data-msg="copy" data-ok={t('msg.copy.ok')} data-fallback={t('msg.copy.fallback')}></span>
  </div>
</main>

<script type="module" is:inline set:html={`import { boot } from '${controller}'; boot(document);`}></script>
