---
// Die Oberflaeche um die Szene, EIN Koerper fuer DE und EN (D-12): Titel mit
// Aktionen (Flotte, Vergleichen, Link), Kennwerte und Ausstattung in Tabs,
// die Leiste am Buehnenfuss (Werkzeuge, Flottenzeile, Korb des Vergleichs),
// der Vergleichsdialog, das Dock mit Werkzeug-Hilfe und der Controller
// (assets/hangar-overview.js). Die Szene ist HangarApp.astro (Sache der
// Szenen-Sitzung); sie stellt in ihrer Buehne einen <slot /> bereit, darin
// stehen Titel und Marker im selben Kasten wie #hg-canvas. Die Leiste steht
// dahinter, damit sie unter 760 px zwischen Buehne und Tafel fliessen kann.
// Modell-URLs, Viewer und Szenen-Optionen liest der Controller aus #hg-stage
// (src/lib/hangar/stage.ts), nie aus dieser Datei.
//
// Ohne Abruf bekommt der Besucher das Dock mit allen 227 Schiffen und die
// ganze Bucht des Startschiffs (Kopf und vier Tabs), gerendert von derselben
// ShipBay-Komponente wie /hangar-bay/<id>.html. Jedes andere Schiff kostet
// einen Abruf seines Buchtdokuments; die Seite waechst nicht mit den Loadouts.
import SiteNav from '../SiteNav.astro';
import ToolHelp from '../ToolHelp.astro';
import HangarApp from './HangarApp.astro';
import ShipBay from './ShipBay.astro';
import LayoutWorkshop from './LayoutWorkshop.astro';
import { layoutT } from '../../i18n/layoutText';
import { localeFromPath, href, useTranslations } from '../../i18n/ui';
import { useHelp } from '../../i18n/help';
import { hangarT } from '../../i18n/hangarText';
import { versioned } from '../../lib/assetVersion';
import { HANGAR_IDS, HANGAR_DEFAULT_SHIP, STATS, dockFigures, shipFacts } from '../../lib/hangar/catalog';
import { buildBay, TABS } from '../../lib/hangar/bay';

const lang = localeFromPath(Astro.url.pathname);
const loc = lang === 'de' ? 'de-DE' : 'en-US';
const t = hangarT(lang);
// Die Flotte spricht ueberall dieselben Woerter wie der Datenblatt-Stern.
const ui = useTranslations(lang);
const h = useHelp(lang);

const ships = HANGAR_IDS.map((id) => shipFacts(id, lang)).sort((a, b) => a.name.localeCompare(b.name, loc));
// Filterschlüssel ist der deutsche Typ (in beiden Sprachen derselbe), damit
// beide Seiten dieselbe Zahl Optionen tragen (verify:sync, Strukturgleichheit):
// die englischen Beschriftungen fassen teils zwei deutsche Typen zusammen.
const types = [...new Map(ships.filter((s) => s.typeKey).map((s) => [s.typeKey, s.typeLabel || s.typeKey])).entries()]
  .map(([key, label]) => ({ key, label }))
  .sort((a, b) => a.label.localeCompare(b.label, loc));
const makers = [...new Set(ships.map((s) => s.maker).filter(Boolean))].sort((a, b) => a.localeCompare(b, loc));
const bay = buildBay(HANGAR_DEFAULT_SHIP, lang);
const count = t(new Intl.PluralRules(loc).select(ships.length) === 'one' ? 'msg.count.one' : 'msg.count.other', { n: ships.length.toLocaleString(loc) });
const controller = versioned('assets/hangar-overview.js', '/assets/hangar-overview.js');
// defer wie account-lite.js in SiteNav: verzoegerte Skripte laufen in
// Dokumentfolge, fleet.js findet VBAccount vor und steht vor boot() bereit.
const fleetSrc = versioned('assets/fleet.js', '/assets/fleet.js');
// Die Werkstatt laedt der Controller erst bei Bedarf, ueber diese URL.
const layoutSrc = versioned('assets/hangar-layouts.js', '/assets/hangar-layouts.js');
const lt = layoutT(lang);
const star = 'M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z';
const link = 'M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1';
const funnel = 'M4 5h16l-6 7.5V19l-4-2v-4.5z';
const dice = 'M7.5 3.5h9a4 4 0 014 4v9a4 4 0 01-4 4h-9a4 4 0 01-4-4v-9a4 4 0 014-4z';
---
<style is:inline>
/* Die Bühne ist eine dunkle Insel (data-media-surface, theme.css): im
   Hellmodus bleibt sie Halle, nur das Karussell darunter wird Papier. */
.hg{display:block}
/* Ab 761 px ist die Seite genau ein Fenster hoch und scrollt nicht: kein
   Seitenfuss (footer={false} in pages/hangar.astro), die Buehne nimmt, was
   das Dock uebrig laesst, auch wenn es aufklappt oder die Hilfe darin offen
   steht. Impressum und Datenschutz stehen dafuer am Ende der Dockzeile
   (.hg-legal). Erst unter 540 px Fensterhoehe scrollt die Seite wieder,
   kleiner wird die Tafel unbedienbar. Schmal bleibt sie eine lange Seite:
   die Tafel steht dort unter der Buehne. */
@media (min-width:761px){
  .hg{display:flex;flex-direction:column;height:100vh;height:100dvh;min-height:540px}
  .hg-stagewrap{flex:1 1 auto;min-height:0;display:flex;flex-direction:column}
  .hg-dock{flex:none}
}
/* Auf der Insel selbst deklariert, nicht an .hg: eine Variable, die auf
   var(--text) verweist, loest dort auf, wo sie steht — an .hg waere das
   noch der Papierwert, nicht der Inselwert. */
.hg-stagewrap{--hg-top:76px;--hg-amber:var(--accent);--hg-on:var(--text);--hg-dim:var(--muted);--hg-panel:color-mix(in srgb,var(--bg) 90%,transparent);--hg-hair:var(--line)}
/* Keine Unschaerfe hinter Tafel und Knoepfen: backdrop-filter ueber der
   WebGL-Leinwand kostet die Grafikkarte in jedem Bild. Die Flaechen sind
   dafuer fast deckend. Ein Lichtsaum oben gibt ihnen Kante statt Glas. */
.hg-stagewrap{--hg-rim:inset 0 1px 0 color-mix(in srgb,var(--hg-on) 9%,transparent);--hg-lift:0 18px 44px -22px var(--shadow-color)}
/* Rand und Tafelbreite einmal: die Leiste am Buehnenfuss spart genau die Spalte der Tafel aus. */
.hg-stagewrap{--hg-gut:clamp(16px,3vw,40px);--hg-panelw:min(400px,36vw)}
.hg-stagewrap{position:relative}
.hg-title{position:absolute;left:clamp(16px,3vw,40px);top:calc(var(--hg-top) + 12px);max-width:min(520px,60%);pointer-events:none}
/* Die Ueberschrift „Hangar“ nur fuer Vorleser und Suche: als Zeile ueber dem
   Namen sagte sie nichts (Krisz 25.10.2026: „wofuer steht hangar da?“, „kann
   raus“); das Hologramm traegt dort das Herstellerlogo. */
.hg-title h1{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
.hg-maker{margin:0;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:600;letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--hg-dim)}
.hg-name{margin:.1rem 0 .3rem;font-family:var(--font-display);font-weight:900;font-size:clamp(2rem,5vw,3.6rem);line-height:1.02;color:var(--hg-on);text-shadow:0 2px 18px var(--shadow-color)}
.hg-role{margin:0;font-size:var(--fs-7);color:var(--hg-dim)}
/* Lange Namen eine oder zwei Stufen kleiner (bay.ts nameStep), statt in zwei
   grossen Zeilen ueber der Halle zu stehen. */
.hg-name.is-long{font-size:clamp(1.7rem,3.6vw,2.6rem)}
.hg-name.is-longer{font-size:clamp(1.45rem,2.8vw,2.1rem)}
/* über heller Halle lesbar bleiben: Schatten statt Fläche */
.hg-maker,.hg-role{color:color-mix(in srgb,var(--hg-on) 82%,transparent);text-shadow:0 1px 3px var(--bg),0 0 14px var(--bg)}
.hg-title.is-swap{animation:hg-swap var(--dur-slow) var(--ease-ui)}
@keyframes hg-swap{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
/* Steht der Name als Hologramm ueber dem Fahrzeug (hangar-viewer.js,
   buildHolo), bleibt vom Titelblock nur die Knopfreihe im Bild; Titel und
   Name bleiben fuer Vorleser im Dokument. Ohne 3D-Ansicht bleibt er, wie er ist. */
.hg[data-holo="on"] .hg-title .hgx-head{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
/* Die Spalte rechts: Schalter oben, darunter die gewaehlte Tafel. Werkstatt
   fuellt sie bis zum Buehnenfuss, die Schiffsdaten nur so weit wie ihr Inhalt;
   wo die Spalte leer ist, gehen Klicks zur Leinwand durch. */
.hg-side{position:absolute;right:var(--hg-gut);top:calc(var(--hg-top) + 12px);bottom:16px;width:var(--hg-panelw);display:flex;flex-direction:column;pointer-events:none}
.hg-side>*{pointer-events:auto}
/* Der Schalter ist der Kopf der Tafel, eine Karte statt zweier. Gewaehlt
   heisst Unterstrich: Bernstein als Flaeche bleibt den Reitern der Werkstatt
   und dem Speichern, sonst stehen zwei gelbe Balken uebereinander. */
.hg-pane{flex:0 0 auto;display:flex;gap:.3rem;padding:.45rem;border:1px solid var(--hg-hair);border-bottom:0;border-radius:12px 12px 0 0;background:var(--hg-panel);box-shadow:var(--hg-rim)}
.hg-pane button{appearance:none;flex:1 1 0;min-width:0;display:inline-flex;align-items:center;justify-content:center;gap:.45rem;padding:.55rem .6rem;border:0;border-radius:8px;background:none;color:var(--hg-dim);font:inherit;font-family:var(--font-ui);font-size:var(--fs-7);font-weight:700;cursor:pointer;transition:color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.hg-pane button:hover,.hg-pane button:focus-visible{color:var(--hg-on)}
.hg-pane button:focus-visible{outline:2px solid var(--hg-amber);outline-offset:-2px}
.hg-pane button:hover{background:color-mix(in srgb,var(--hg-on) 5%,transparent)}
.hg-pane button[aria-selected="true"]{color:var(--hg-on);background:color-mix(in srgb,var(--hg-on) 10%,transparent)}
.hg-pane button[aria-selected="true"] svg{color:var(--hg-amber)}
.hg-pane svg{flex:0 0 auto}
.hg[data-pane="layout"] .hg-stats,.hg[data-pane="ship"] .hgl{display:none}
.hg-stats{position:relative;flex:0 1 auto;min-height:0;display:flex;flex-direction:column;background:var(--hg-panel);border:1px solid var(--hg-hair);border-radius:0 0 12px 12px;padding:.3rem 1.1rem 1rem;box-shadow:var(--hg-lift)}
.hgx-stats{margin:0;display:grid;gap:.55rem}
.hg-row{display:grid;grid-template-columns:1fr auto;gap:.15rem .6rem;font-size:var(--fs-7)}
.hg-row dt{color:var(--hg-dim)}
.hg-row dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;color:var(--hg-on);font-weight:600}
.hg-bar{grid-column:1/-1;height:3px;background:var(--line-soft);border-radius:2px;overflow:hidden}
.hg-bar i{display:block;height:100%;width:var(--w,0%);border-radius:2px;background:linear-gradient(90deg,color-mix(in srgb,var(--hg-amber) 55%,transparent),var(--hg-amber));transition:width var(--dur-slow) var(--ease-ui)}
.hg-row.is-na dd{color:var(--hg-dim);font-weight:400}
.hg-note{margin:.8rem 0 0;font-size:var(--fs-5);color:var(--hg-dim)}
.hg-sheet{display:flex;justify-content:center;margin-top:.9rem;padding:.65rem 1rem;background:var(--hg-amber);color:var(--ink);font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;border-radius:8px;text-decoration:none}
.hg-sheet:hover,.hg-sheet:focus-visible{background:color-mix(in srgb,var(--hg-amber) 82%,var(--text))}
.hg-btn{appearance:none;border:1px solid var(--hg-hair);background:var(--hg-panel);color:var(--hg-on);font:inherit;font-size:var(--fs-6);padding:.45rem .8rem;border-radius:4px;cursor:pointer}
.hg-btn:hover,.hg-btn:focus-visible{border-color:var(--hg-amber)}
/* Knopf als Zeichen: das Wort steht als Blase daneben (.hgx-tip). Die Blase
   bleibt im Baum (Deckkraft, nicht display), sie ist der Name des Knopfs. */
.hgx-ico{position:relative;display:inline-flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;padding:0;border-radius:10px;box-shadow:var(--hg-rim),0 6px 16px -10px var(--shadow-color);transition:border-color var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.hgx-ico:hover,.hgx-ico:focus-visible{background:var(--bg-2)}
.hgx-ico:hover,.hgx-ico:focus-visible{color:var(--hg-amber,var(--accent))}
.hgx-tip{position:absolute;left:0;top:calc(100% + 6px);z-index:3;transform:translateY(-3px);padding:.2rem .55rem;border:1px solid var(--line);border-radius:4px;background:var(--bg-2);color:var(--text);font-family:var(--font-ui);font-size:var(--fs-6);font-weight:600;line-height:1.35;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity var(--dur-fast) var(--ease-ui),transform var(--dur-fast) var(--ease-ui)}
.hgx-ico:is(:hover,:focus-visible,:focus-within) .hgx-tip{opacity:1;transform:none}
/* Linksbuendig am Knopf: die Knoepfe stehen am linken Rand, mittig liefe die
   Blase des ersten aus der Buehne. Unten auf der Buehne steht sie darueber. */
.hg-tools .hgx-tip,.hgx-rand .hgx-tip{top:auto;bottom:calc(100% + 6px);transform:translateY(3px)}
/* Am Zeilenende liefe sie aus dem Fenster: dort rechtsbuendig (hangar-overview.js, fitTips) */
.hgx-tip.is-end{left:auto;right:0}
.hg-tools{position:absolute;left:var(--hg-gut);bottom:16px;z-index:2;display:flex;gap:.4rem}
.hgx-gfx[hidden],.hgx-snd[hidden]{display:none}
.hgx-snd[aria-pressed="true"] .hgx-snd__off,.hgx-snd[aria-pressed="false"] .hgx-snd__on{display:none}
.hgx-snd[aria-pressed="false"]{color:var(--hg-dim)}
/* var(--fs-8) = 16,2 px: iOS Safari zoomt in jedes Formularfeld unter 16 px. */
.hgx-gfx select{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;border:0;opacity:0;font-size:var(--fs-8);cursor:pointer}
.hgx-gfx select option{background:var(--bg-2);color:var(--text)}
.hgx-gfx:focus-within{border-color:var(--hg-amber)}
/* Bedienhinweis neben den drei Zeichen der Ansicht, bis zum ersten Anfassen. */
.hg-hint{position:absolute;left:calc(var(--hg-gut) + 9.4rem);bottom:22px;margin:0;max-width:calc(100% - 2 * var(--hg-gut) - var(--hg-panelw) - 16px - 9.9rem);padding:.3rem .7rem;border-radius:999px;background:var(--hg-panel);font-size:var(--fs-5);color:color-mix(in srgb,var(--hg-on) 85%,transparent);text-align:center;pointer-events:none;transition:opacity var(--dur-slow) var(--ease-ui),visibility 0s linear var(--dur-slow)}
.hg[data-hint="seen"] .hg-hint{opacity:0;visibility:hidden}
/* Steht der Korb des Vergleichs unten, macht der Hinweis ihm Platz. */
.hg:has(#hgx-tray:not([hidden])) .hg-hint{display:none}
/* Aktionen unter dem Titel; der Titel selbst laesst Klicks zur Leinwand durch. */
.hgx-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;margin-top:.85rem;pointer-events:auto}
.hgx-act.is-done,.hgx-act[aria-pressed="true"]{border-color:var(--hg-amber);color:var(--hg-amber)}
.hgx-act svg,.hgx-chip svg{flex:0 0 auto}
.hgx-act[aria-pressed="true"] path,.hgx-chip[aria-pressed="true"] path{fill:currentColor}
/* Leiste am Buehnenfuss, nur fuer den Korb des Vergleichs. Sie spart links
   die Zeichen der Ansicht (.hg-tools) und rechts die Spalte der Tafel aus;
   unter 760 px steht sie zwischen Buehne und Tafel. */
.hgx-stagebar{position:absolute;left:calc(var(--hg-gut) + 6.5rem);right:calc(var(--hg-gut) + var(--hg-panelw) + 16px);bottom:16px;display:flex;justify-content:flex-end;pointer-events:none}
.hgx-stagebar[hidden]{display:none}
/* Die Flottenzeile steht im Dock (eigene Insel): dieselben Insel-Woerter dort. */
.hg-dock{--hg-amber:var(--accent);--hg-on:var(--text);--hg-dim:var(--muted);--hg-hair:var(--line)}
.hgx-fleetline{display:flex;flex-wrap:wrap;align-items:center;gap:.3rem .9rem;margin:-.25rem 0 .7rem;font-size:var(--fs-6);color:var(--hg-on)}
.hgx-fleetline[hidden]{display:none}
.hgx-fleetsum{font-variant-numeric:tabular-nums}
.hgx-fleetsum b{margin-right:.35rem;font-family:var(--font-ui);font-weight:700;color:var(--hg-amber)}
.hgx-fleetsync{color:var(--hg-dim)}
.hgx-fleetsync a{color:var(--hg-amber)}
.hgx-retry{appearance:none;border:0;background:none;padding:0;color:var(--hg-on);font:inherit;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.hgx-merged{flex-basis:100%;display:flex;align-items:center;gap:.6rem;margin:0;color:var(--hg-on)}
.hgx-x{appearance:none;border:1px solid var(--hg-hair);border-radius:3px;background:none;color:var(--hg-on);font:inherit;line-height:1;padding:.15rem .45rem;cursor:pointer}
.hgx-x:hover,.hgx-x:focus-visible{border-color:var(--hg-amber)}
/* Korb des Vergleichs, rechts in der Leiste. */
.hgx-tray{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .6rem;max-width:100%;margin-left:auto;padding:.35rem .5rem .35rem .65rem;border:1px solid var(--hg-hair);border-radius:10px;background:var(--hg-panel);box-shadow:var(--hg-rim);font-size:var(--fs-6);color:var(--hg-on);pointer-events:auto}
.hgx-tray__title{font-family:var(--font-ui);font-weight:700;color:var(--hg-amber)}
.hgx-tray__list{display:flex;flex-wrap:wrap;gap:.35rem;margin:0;padding:0;list-style:none}
.hgx-tray__list li{display:inline-flex;align-items:center;gap:.35rem;padding:.1rem .15rem .1rem .55rem;border:1px solid var(--hg-hair);border-radius:999px;white-space:nowrap}
.hgx-tray__list .hgx-x{border-radius:999px;padding:.1rem .4rem}
.hgx-tray__hint{color:var(--hg-dim)}
.hgx-tray__msg{flex-basis:100%;margin:0;color:color-mix(in srgb,var(--hot) 55%,var(--hg-on))}
/* mobile-ux.css setzt unter 820 px jeden button auf inline-flex und schlaegt damit hidden. */
.hgx-fleetsum[hidden],.hgx-retry[hidden],.hgx-merged[hidden],.hgx-tray[hidden],.hgx-tray__open[hidden],#hg-reset[hidden]{display:none}
/* Vergleich: eine Spalte je Schiff, Zeilen aus dem Kennwert-Verzeichnis. Die
   Abweichung zur Basis traegt den Ton nach der Richtung von "besser". */
.hgx-cmp{width:min(1000px,calc(100% - 2 * var(--hg-gut)));max-width:none;max-height:calc(100dvh - var(--hg-top) - 24px);margin:calc(var(--hg-top) + 8px) auto 16px;padding:0;overflow:hidden;border:1px solid var(--hg-hair);border-radius:6px;background:var(--bg-2);color:var(--hg-on)}
.hgx-cmp[open]{display:flex;flex-direction:column}
.hgx-cmp::backdrop{background:var(--overlay-backdrop)}
.hgx-cmp__head{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1rem;padding:.9rem 1.1rem .7rem;border-bottom:1px solid var(--hg-hair)}
.hgx-cmp__head h2{margin:0;font-family:var(--font-ui);font-size:var(--fs-11);font-weight:700;color:var(--hg-amber)}
.hgx-cmp__note{flex:1 1 18rem;margin:0;font-size:var(--fs-6);color:var(--hg-dim)}
.hgx-cmp__scroll{flex:1 1 auto;min-height:0;overflow:auto;overscroll-behavior:contain}
.hgx-cmp__table{width:100%;border-collapse:collapse;font-size:var(--fs-7);font-variant-numeric:tabular-nums}
.hgx-cmp__table th,.hgx-cmp__table td{padding:.5rem .8rem;border-bottom:1px solid var(--line-soft);text-align:right;vertical-align:top}
.hgx-cmp__table tbody th{text-align:left;font-weight:400;color:var(--hg-dim);white-space:nowrap}
.hgx-cmp__table thead th{position:sticky;top:0;z-index:1;background:var(--bg-2);vertical-align:bottom;font-weight:400}
.hgx-cmp__table .is-base{background:color-mix(in srgb,var(--hg-amber) 8%,var(--bg-2))}
.hgx-cmp__name{appearance:none;border:0;background:none;padding:0;color:var(--hg-on);font:inherit;font-family:var(--font-ui);font-size:var(--fs-9);font-weight:700;text-align:right;cursor:pointer}
.hgx-cmp__name:hover,.hgx-cmp__name:focus-visible,.hgx-cmp__name[aria-pressed="true"]{color:var(--hg-amber)}
.hgx-cmp__maker{display:block;color:var(--hg-dim);font-size:var(--fs-5)}
.hgx-cmp__badge{display:inline-block;margin-top:.25rem;padding:0 .45rem;border:1px solid var(--hg-amber);border-radius:999px;color:var(--hg-amber);font-size:var(--fs-5)}
.hgx-cmp__acts{display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:.3rem .6rem;margin-top:.4rem}
.hgx-linkbtn{appearance:none;border:0;background:none;padding:0;color:var(--hg-amber);font:inherit;font-size:var(--fs-6);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.hgx-cmp__v{display:block;font-weight:600;white-space:nowrap}
.hgx-delta{display:block;font-size:var(--fs-5);white-space:nowrap}
.hgx-delta.is-up{color:var(--hg-amber)}
.hgx-delta.is-down{color:color-mix(in srgb,var(--hot) 55%,var(--hg-on))}
.hgx-delta.is-flat{color:var(--hg-dim)}
.hgx-copyfield{width:min(320px,100%);min-width:0;font:inherit;font-size:var(--fs-6);background:var(--hg-panel);color:var(--hg-on);border:1px solid var(--hg-hair);border-radius:4px;padding:.4rem .55rem}
.hg-title.is-busy .hgx-head,.hgx-scroll[aria-busy="true"] .hgx-tps{opacity:.45;transition:opacity var(--dur-fast) var(--ease-ui)}
/* Tabs nach dem WAI-ARIA-Muster; der aktive traegt die Akzentkante. */
.hgx-tabs{display:flex;margin:.35rem -.5rem .8rem;border-bottom:1px solid var(--hg-hair)}
.hgx-tabs button{flex:1 1 0;min-width:0;appearance:none;background:none;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;padding:.6rem .2rem .45rem;color:var(--hg-dim);font:inherit;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;letter-spacing:var(--ls-6);text-transform:uppercase;cursor:pointer;transition:color var(--dur-fast) var(--ease-ui),border-color var(--dur-fast) var(--ease-ui)}
.hgx-tabs button:hover,.hgx-tabs button:focus-visible{color:var(--hg-on)}
.hgx-tabs button[aria-selected="true"]{color:var(--hg-amber);border-bottom-color:var(--hg-amber)}
.hgx-scroll{flex:1 1 auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;margin-right:-.6rem;padding-right:.6rem}
.hgx-grp{margin:0 0 .9rem}
.hgx-grp h3{display:flex;justify-content:space-between;align-items:baseline;gap:.6rem;margin:0 0 .3rem;font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-amber)}
.hgx-grp h3 b{color:var(--hg-on);font-variant-numeric:tabular-nums;white-space:nowrap}
.hgx-grp ul{margin:0;padding:0;list-style:none}
.hgx-slot__btn{display:grid;grid-template-columns:2rem minmax(0,1fr) auto;gap:.55rem;align-items:center;width:100%;margin:0;padding:.3rem .35rem;appearance:none;background:none;border:1px solid transparent;border-radius:4px;color:var(--hg-on);font:inherit;font-size:var(--fs-7);text-align:left;cursor:pointer;transition:border-color var(--dur-fast) var(--ease-ui)}
.hgx-slot__btn:hover,.hgx-slot__btn:focus-visible{border-color:var(--hg-hair)}
.hgx-slot__btn[aria-expanded="true"]{border-color:var(--hg-amber)}
.hgx-sz{font-family:var(--font-ui);font-size:var(--fs-6);font-weight:700;color:var(--hg-dim)}
.hgx-nm{line-height:1.3}
.hgx-nm small{display:block;color:var(--hg-dim);font-size:var(--fs-5)}
.hgx-v{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap;line-height:1.2}
.hgx-v small{display:block;color:var(--hg-dim);font-size:var(--fs-5);font-weight:400}
.hgx-d{padding:.25rem .35rem .65rem 2.9rem;font-size:var(--fs-6)}
.hgx-d dl{display:grid;grid-template-columns:auto 1fr;gap:.15rem .8rem;margin:0}
.hgx-d dt{color:var(--hg-dim);white-space:nowrap}
.hgx-d dd{margin:0;text-align:right;font-variant-numeric:tabular-nums}
.hgx-links{display:flex;flex-wrap:wrap;gap:.25rem 1rem;margin:.5rem 0 0}
.hgx-links a{color:var(--hg-amber)}
.hgx-empty{margin:.3rem 0;color:var(--hg-dim);font-size:var(--fs-7)}
/* Der Weg zum Datenblatt bleibt am Fuss der Tafel stehen, auch wenn eine
   lange Ausstattung darueber scrollt. */
.hgx-foot{position:sticky;bottom:0;margin:0}
/* Zeilen, die unter den Fuss rollen, blenden aus statt halb ueber dem Knopf
   zu stehen; sein Abstand ist zugleich die Luft unter der letzten Zeile. */
.hgx-foot{--hg-air:.9rem;padding-top:var(--hg-air);background:linear-gradient(transparent,color-mix(in srgb,var(--bg) 90%,transparent) var(--hg-air))}
.hgx-foot .hg-sheet{margin-top:0}
.hgx-stats+.hgx-grp{margin-top:.9rem}
.hgx-err{font-size:var(--fs-7);color:var(--hg-on)}
.hgx-err p{margin:.3rem 0 .7rem}
/* Der Rueckfall der Szene (#hg-fallback, ohne 3D) steht wie die Modellmeldung
   zwischen Titel und Tafel; ganzflaechig zentriert lief er unter beide. Mitte
   und Breite sind die des freien Streifens links der Tafel (wie .hgx-stagebar):
   auf der Buehnenmitte lag bei 1100 px das letzte Drittel unter der Tafel. */
.hgx-modelerr,.hg-stagewrap .hg-fallback{inset:auto;position:absolute;left:calc((100% - var(--hg-panelw) - 16px) / 2);top:58%;transform:translate(-50%,-50%);width:min(360px,calc(100% - 2 * var(--hg-gut) - var(--hg-panelw) - 16px));margin:0;padding:.6rem .8rem;border-radius:6px;background:var(--hg-panel);color:var(--hg-on);font-size:var(--fs-7);text-align:center}
.hgx-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
/* Hardpoint-Marker ueber der Leinwand: der Controller setzt sie je Bild per
   transform auf die Projektion ihres Punkts. Nur der aktive Ausstattungs-Tab
   zeigt seine Marker; hinter der Rumpfmitte dimmen sie. Der dunkle Ring
   haelt beide Toene auf hellem Rumpf lesbar, der blasse Systemton zuerst. */
.hgx-marks{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.hgx-marks:not([data-live]) .hgx-mk{visibility:hidden}
.hgx-mk{position:absolute;left:0;top:0;width:16px;height:16px;margin:-8px 0 0 -8px;border:2px solid var(--hg-amber);border-radius:50%;background:color-mix(in srgb,var(--hg-amber) 30%,transparent);box-shadow:0 0 0 2px color-mix(in srgb,var(--bg) 88%,transparent);pointer-events:auto;cursor:pointer;transition:opacity var(--dur-fast) var(--ease-ui)}
.hgx-mk[data-tab="systems"]{border-color:var(--accent-2);background:color-mix(in srgb,var(--accent-2) 30%,transparent)}
.hgx-mk.is-far{opacity:.35}
.hgx-mk.is-hot,.hgx-mk.is-sel{z-index:1;width:22px;height:22px;margin:-11px 0 0 -11px;opacity:1;background:color-mix(in srgb,var(--hg-amber) 55%,transparent)}
.hgx-mk b{display:none;position:absolute;left:calc(100% + 6px);top:50%;transform:translateY(-50%);padding:.15rem .45rem;border-radius:3px;background:var(--hg-panel);color:var(--hg-on);font-size:var(--fs-5);font-weight:600;white-space:nowrap;pointer-events:none}
.hgx-mk.is-hot b,.hgx-mk.is-sel b,.hgx-mk:hover b{display:block}
.hg:not([data-tab-active="weapons"]) .hgx-mk[data-tab="weapons"],.hg:not([data-tab-active="systems"]) .hgx-mk[data-tab="systems"],.hg:not([data-tab-active="cargo"]) .hgx-mk[data-tab="cargo"]{display:none}

.hg-dock{--dk-a:var(--accent);background:linear-gradient(180deg,var(--bg-2),var(--bg));border-top:1px solid color-mix(in srgb,var(--dk-a) 40%,transparent);box-shadow:0 -1px 0 color-mix(in srgb,var(--dk-a) 12%,transparent),0 -14px 30px -18px color-mix(in srgb,var(--dk-a) 30%,transparent);padding:.7rem clamp(16px,3vw,40px) .55rem;color:var(--text)}
/* Eine ruhige Werkzeugzeile: Suche als breites Feld mit Lupe, alles andere
   runde Knoepfe in einer Hoehe. Die Anzahl steht leise im Klappschalter. */
.hg-filter{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:.35rem}
.hg-filter input,.hg-filter select{font:inherit;font-size:var(--fs-7);background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:999px;padding:.45rem .8rem;min-width:0}
.hg-filter select{appearance:none;padding-right:2rem;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 1.05rem) 55%,calc(100% - .75rem) 55%;background-size:.3rem .3rem;background-repeat:no-repeat}
.hg-filter select:hover,.hg-filter select:focus-visible{border-color:var(--dk-a)}
/* Der Umbruch rechnet mit der Basis, nicht mit der Mindestbreite: eine kleine
   Basis laesst die Suche erst wachsen, wenn die Zeile Platz hat. */
.hgx-search{position:relative;flex:0 1 240px;min-width:7rem;display:flex;align-items:center}
.hgx-search svg{position:absolute;left:.85rem;color:var(--muted);pointer-events:none}
.hg-filter .hgx-search input{flex:1;height:2.3rem;padding-left:2.3rem;background:color-mix(in srgb,var(--text) 5%,var(--bg));border-color:transparent;transition:border-color var(--dur-fast),background var(--dur-fast)}
.hg-filter .hgx-search input:hover{border-color:var(--line)}
.hg-filter .hgx-search input:focus{outline:none;border-color:var(--dk-a);background:var(--bg);box-shadow:0 0 0 3px color-mix(in srgb,var(--dk-a) 18%,transparent)}
.hg-filter .hgx-search input::placeholder{color:var(--muted);opacity:.8}
.hg-count{font-size:var(--fs-6);color:var(--muted);font-variant-numeric:tabular-nums}
/* Die Leiste: Karten laufen unter weich ausgeblendete Raender, die Pfeile
   schweben rund darueber, statt je eine Spalte zu belegen. */
.hg-rail{position:relative}
.hg-strip{display:flex;gap:.7rem;overflow-x:auto;scroll-behavior:smooth;padding:.55rem 2.6rem .7rem;margin:0 -.4rem;list-style:none;min-width:0;overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--dk-a) 60%,transparent) color-mix(in srgb,var(--text) 6%,transparent);cursor:grab;-webkit-mask-image:linear-gradient(90deg,transparent,#000 2.4rem,#000 calc(100% - 2.4rem),transparent);mask-image:linear-gradient(90deg,transparent,#000 2.4rem,#000 calc(100% - 2.4rem),transparent)}
.hg-strip li{flex:0 0 auto}
.hg-strip.is-drag{scroll-behavior:auto;cursor:grabbing}
.hg-strip.is-drag .hg-card{cursor:grabbing;pointer-events:none}
.hg-strip li[hidden]{display:none}
/* Kacheln wie im Hangar-Menue eines Spiels: das Bild fuellt die Kachel,
   nur der Name steht auf einem Verlauf am unteren Rand, in normaler Schrift
   und bis zu zwei Zeilen. Der Hersteller bleibt fuer Vorleser und den Kopf. */
.hg-card{position:relative;display:flex;flex-direction:column;justify-content:flex-end;width:196px;height:112px;padding:0;background:var(--surface-2);border:1px solid color-mix(in srgb,var(--text) 10%,transparent);border-radius:12px;overflow:hidden;color:var(--text);text-decoration:none;cursor:pointer;font:inherit;text-align:left;transition:transform var(--dur-fast) var(--ease-ui),border-color var(--dur-fast),box-shadow var(--dur-fast)}
.hg-card:hover,.hg-card:focus-visible{border-color:color-mix(in srgb,var(--dk-a) 65%,transparent);transform:translateY(-2px);box-shadow:0 8px 18px -10px #000}
.hg-card:focus-visible{outline:none}
.hg-card[aria-current="true"]{border:3px solid var(--dk-a);box-shadow:0 0 14px -2px color-mix(in srgb,var(--dk-a) 55%,transparent);transform:none}
.hg-card img,.hg-card .hg-noimg{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;background:radial-gradient(120% 90% at 50% 30%,var(--surface-2),var(--bg));filter:saturate(.9) brightness(.86);transition:filter var(--dur-fast),transform var(--dur-slow) var(--ease-ui)}
.hg-card:hover img,.hg-card[aria-current="true"] img{filter:none}
.hg-card:hover img{transform:scale(1.04)}
.hg-card small{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.hg-card span{position:relative;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;padding:2rem .7rem .55rem;background:linear-gradient(transparent,color-mix(in srgb,var(--bg) 92%,transparent) 75%);font-family:var(--font-ui);font-size:var(--fs-7);font-weight:700;line-height:1.15;overflow-wrap:anywhere;text-shadow:0 1px 3px var(--bg)}
.hg-card[aria-current="true"] span{color:var(--dk-a)}
.hg-arrow{position:absolute;top:50%;z-index:2;width:2.3rem;height:2.3rem;margin-top:-1.15rem;display:grid;place-items:center;padding:0 0 .15rem;border:1px solid var(--line);border-radius:999px;background:color-mix(in srgb,var(--bg-2) 92%,transparent);color:var(--text);font-size:var(--fs-10);line-height:1;cursor:pointer;box-shadow:0 4px 14px -6px #000;transition:border-color var(--dur-fast),color var(--dur-fast),transform var(--dur-fast) var(--ease-ui)}
#hg-prev{left:-.4rem}
#hg-next{right:-.4rem}
.hg-arrow:hover,.hg-arrow:focus-visible{border-color:var(--dk-a);color:var(--dk-a);transform:scale(1.08)}
.hg-empty{color:var(--muted);font-size:var(--fs-7);padding:1rem 0}
.hg-empty[hidden]{display:none}
/* "Meine Flotte" filtert das Dock; die Zahl steht als Marke im Knopf. Der
   Stern markiert Karten der Flotte, sein Wort haengt per aria-describedby
   an der Karte (#hgx-fleet-mark). */
.hgx-chip{appearance:none;display:inline-flex;align-items:center;gap:.45rem;height:2.3rem;font:inherit;font-size:var(--fs-7);background:transparent;color:var(--text);border:1px solid var(--line);border-radius:999px;padding:0 .9rem;cursor:pointer;font-variant-numeric:tabular-nums;transition:border-color var(--dur-fast),color var(--dur-fast),background var(--dur-fast)}
.hgx-chip svg{color:var(--muted);transition:color var(--dur-fast)}
.hgx-chip:hover,.hgx-chip:focus-visible{border-color:var(--dk-a)}
.hgx-chip:hover svg,.hgx-chip:focus-visible svg{color:var(--dk-a)}
.hgx-chip[aria-pressed="true"]{border-color:var(--dk-a);color:var(--dk-a);background:color-mix(in srgb,var(--dk-a) 12%,transparent)}
.hgx-chip[aria-pressed="true"] svg{color:var(--dk-a);fill:currentColor}
.hgx-chip.hgx-ico{width:2.3rem;height:2.3rem;padding:0;justify-content:center;border-radius:999px;box-shadow:none}
.hgx-chip:disabled{opacity:.5;cursor:default;border-color:var(--line)}
.hgx-chipn{min-width:1.35rem;padding:0 .35rem;border-radius:999px;background:color-mix(in srgb,var(--text) 10%,transparent);color:var(--muted);font-size:var(--fs-6);font-weight:700;line-height:1.35rem;text-align:center}
.hgx-chip[aria-pressed="true"] .hgx-chipn{background:var(--dk-a);color:var(--bg)}
.hgx-filters:not([hidden]){display:contents}
.hgx-filters #hg-type{display:none}
/* Unter 1600 px tragen Filter und Flotte nur ihr Zeichen (das Wort bleibt
   fuer Vorleser), damit die Rollen-Reiter Platz haben. */
@media (max-width:1599px){
  .hgx-chip .hgx-lbl{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .hgx-filtertog,#hgx-fleetonly{padding:0 .75rem}
}
/* Rollen-Reiter: laufen bei schmaler Zeile waagerecht weiter, das Mausrad
   schiebt sie; die gewaehlte Rolle ist eine volle Amber-Pille. */
.hgx-roles{flex:1 1 0;min-width:8rem;display:flex;gap:.25rem;overflow-x:auto;scrollbar-width:none;padding:2px 1rem 2px 0;-webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 1.6rem),transparent);mask-image:linear-gradient(90deg,#000 calc(100% - 1.6rem),transparent)}
.hgx-roles::-webkit-scrollbar{display:none}
.hgx-roles button{flex:0 0 auto;height:2.1rem;padding:0 .85rem;border:1px solid transparent;border-radius:999px;background:transparent;color:var(--muted);font:inherit;font-size:var(--fs-7);font-weight:600;cursor:pointer;white-space:nowrap;transition:background var(--dur-fast),color var(--dur-fast)}
.hgx-roles button:hover{color:var(--text);background:color-mix(in srgb,var(--text) 7%,transparent)}
.hgx-roles button:focus-visible{outline:none;border-color:var(--dk-a);color:var(--text)}
.hgx-roles button[aria-pressed="true"]{background:var(--dk-a);color:var(--bg);font-weight:700}
.hgx-filtertog[aria-expanded="true"]{border-color:var(--dk-a);color:var(--dk-a)}
.hgx-filtertog[aria-expanded="true"] svg{color:var(--dk-a)}
.hgx-filtern{min-width:1.2rem;padding:0 .3rem;border-radius:999px;background:var(--dk-a);color:var(--bg);font-size:var(--fs-6);font-weight:800;text-align:center}
.hgx-filtern[hidden]{display:none}
.hg-strip li.is-fleet .hg-card::after{content:"★";position:absolute;top:.4rem;right:.45rem;z-index:1;display:grid;place-items:center;width:1.4rem;height:1.4rem;border-radius:999px;background:color-mix(in srgb,var(--bg) 70%,transparent);color:var(--dk-a);font-size:var(--fs-6);line-height:1}
/* Ab 2K wachsen die Karten mit: bei 2560 px wirkten sie sonst wie Briefmarken. */
@media (min-width:2200px) and (min-height:1200px){.hg-card{width:236px;height:132px}.hg-card span{font-size:var(--fs-8)}}
.hg-btn:disabled{opacity:.5;cursor:default;border-color:var(--hg-hair)}
/* Die Filterzeile bleibt ab 1280 px einzeilig, sonst rutschen die Karten
   unter die Falz: die Herstellerliste ist sonst so breit wie ihr laengster Name. */
.hg-filter select{max-width:10rem}
/* Werkzeug-Hilfe als erstes Element im Filter: zu ein Knopf in der Zeile,
   offen eine eigene Zeile. Eine volle Zeile auch im Ruhezustand schoebe die
   Karten bei 1440x900 unter die Falz. */
.hg-filter .tool-help{flex:0 1 auto;margin:0;border-radius:4px}
.hg-filter .tool-help[open]{flex-basis:100%}
.hg-filter .tool-help__summary{padding:.42rem .8rem;font-size:var(--fs-7)}
/* Zu ist die Hilfe ein rundes Fragezeichen wie die Chips daneben; ihr Satz
   bleibt der Name fuer Vorleser und steht wieder da, sobald sie offen ist. */
.hg-filter .tool-help:not([open]){border-radius:999px}
.hg-filter .tool-help:not([open]) .tool-help__summary{width:2.3rem;height:2.3rem;padding:0;justify-content:center;gap:0;font-size:0}
.hg-filter .tool-help:not([open]) .tool-help__summary::before{content:'?';font-size:var(--fs-8);font-weight:800;line-height:1}
/* Ab 761 px klappt die Hilfe als Tafel ueber der Halle auf, links neben der
   Tafel der Werkstatt: im Dock zoege sie die Buehne um 320 px zusammen, die
   Seite ist dort ein Fenster hoch. Das Fragezeichen bleibt in der Zeile und
   traegt den Akzent, solange sie offen ist. */
@media (min-width:761px){
  .hg-dock{position:relative}
  .hg-filter .tool-help{overflow:visible}
  .hg-filter .tool-help[open]{flex-basis:auto;border-radius:999px;border-color:var(--accent)}
  .hg-filter .tool-help[open] .tool-help__summary{width:2.3rem;height:2.3rem;padding:0;justify-content:center;gap:0;font-size:0}
  .hg .hg-dock .hg-filter .tool-help[open] .tool-help__summary::before{content:'?';font-size:var(--fs-8);font-weight:800;line-height:1;transform:none}
  .hg-filter .tool-help__body{position:absolute;left:clamp(16px,3vw,40px);bottom:calc(100% + 10px);z-index:4;width:min(720px,calc(100% - 2 * clamp(16px,3vw,40px) - min(400px,36vw) - 16px));max-height:min(460px,calc(100dvh - 390px));overflow-y:auto;overscroll-behavior:contain;padding:.2rem 1.1rem 1rem;border:1px solid var(--line);border-radius:10px;background:var(--bg-2);box-shadow:0 18px 44px -22px var(--shadow-color)}
  /* Ihre Oberkante bleibt unter den Knoepfen des Titels (bis 300 px), was
     nicht passt, rollt in der Tafel; offen ist das Dock 155 px hoeher. */
  .hg:not([data-dock="closed"]) .hg-filter .tool-help__body{max-height:max(150px,min(460px,calc(100dvh - 545px)))}
}
/* Zugeklappt bleibt vom Dock eine Zeile: Hilfe und Schalter. Ab 761 px waechst
   die Buehne um den Rest (sie fuellt die Spalte, siehe .hg oben); schmal
   steht das Dock unter der Tafel und kuerzt dort nur die Seite. Offen nennt
   der Schalter nur noch die Anzahl, sein Wort bleibt fuer Vorleser stehen. */
.hgx-docktog svg{transition:transform var(--dur-fast) var(--ease-ui)}
.hg:not([data-dock="closed"]) .hgx-docktog svg{transform:rotate(180deg)}
.hg:not([data-dock="closed"]) .hgx-docktog__lbl{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.hg:not([data-dock="closed"]) .hgx-docktog{padding-inline:.6rem}
.hg:not([data-dock="closed"]) .hgx-docktog .hg-count{color:inherit}
.hg[data-dock="closed"] .hg-dock{padding-block:.5rem}
.hg[data-dock="closed"] .hgx-docktog{padding-inline:.9rem}
.hg[data-dock="closed"] .hg-filter{margin-bottom:0}
.hg[data-dock="closed"] .hg-filter>:is(.hgx-search,.hgx-roles,select,.hgx-filters,.hgx-chip:not(.hgx-docktog,.hgx-rand)),.hg[data-dock="closed"] .hg-rail,.hg[data-dock="closed"] .hg-dock .hg-empty,.hg[data-dock="closed"] .hgx-fleetline:not(.is-alert){display:none}
.hg[data-dock="closed"] .hgx-fleetline{margin:.5rem 0 0}
/* Die Pflichtlinks des fehlenden Seitenfusses: leise am Zeilenende, auch bei
   zugeklapptem Dock. */
.hg-legal{display:flex;align-items:center;gap:.5rem;margin-left:auto;font-size:var(--fs-5);color:var(--muted)}
.hg-legal a{color:var(--muted);text-decoration:none}
.hg-legal a:hover,.hg-legal a:focus-visible{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
/* Nach einem Kennwert sortiert, traegt jede Karte ihren Wert oben links. */
.hg-card[data-sv]::before{content:attr(data-sv);position:absolute;left:.45rem;top:.4rem;z-index:1;padding:.1rem .45rem;border-radius:999px;background:color-mix(in srgb,var(--bg) 78%,transparent);color:var(--dk-a);font-family:var(--font-ui);font-size:var(--fs-5);font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}

/* Flache Fenster (1280x720): Ueberblick und Datenblatt-Knopf passen ohne
   Bildlauf in die Buehne. */
@media (min-width:761px) and (max-height:820px){
  .hgx-tabs{margin-bottom:.45rem}
  .hgx-tabs button{padding:.45rem .2rem .35rem}
  .hgx-stats{gap:.25rem}
  .hg-note{margin-top:.35rem}
  .hg-sheet{margin-top:.45rem;padding:.5rem 1rem}
  .hgx-foot{--hg-air:.45rem}
}
@media (max-width:760px){
  .hg-title{max-width:calc(100% - 32px)}
  /* Die Aktionen brechen hier in zwei Zeilen um: Meldungen an den Buehnenfuss. */
  .hgx-modelerr,.hg-stagewrap .hg-fallback{left:50%;top:auto;bottom:16px;transform:translateX(-50%);width:calc(100% - 32px)}
  .hg-side{position:static;width:auto;display:block}
  .hg-pane{margin:0;padding:.5rem 16px;border-width:1px 0 0;border-radius:0;background:var(--bg-2);box-shadow:none}
  .hg-stats{position:static;width:auto;max-height:none;border-radius:0;border-width:1px 0 0;background:var(--bg-2);color:var(--text);box-shadow:none}
  .hgx-scroll{overflow:visible;margin-right:0;padding-right:0}
  .hgx-foot{position:static;background:none}
  .hgx-mk{width:12px;height:12px;margin:-6px 0 0 -6px}
  .hgx-stagebar{position:static;justify-content:flex-start;padding:.8rem 16px;background:var(--bg-2);border-top:1px solid var(--hg-hair)}
  .hgx-tray{margin-left:0}
  .hg-tools{left:16px;bottom:12px}
  .hgx-cmp{width:100%;height:100dvh;max-height:none;margin:0;border:0;border-radius:0}
  /* Drei Spalten muessen auf 390 px passen: Beschriftung und Werte duerfen umbrechen. */
  .hgx-cmp__table{font-size:var(--fs-6)}
  .hgx-cmp__table th,.hgx-cmp__table td{padding:.45rem .3rem}
  .hgx-cmp__table tbody th,.hgx-cmp__v,.hgx-delta{white-space:normal}
  .hgx-cmp__name{font-size:var(--fs-7)}
  .hg-hint{display:none}
  .hg-arrow{display:none}
  .hgx-search{order:4;flex:1 1 100%;max-width:none}
  .hgx-roles{order:5;flex-basis:100%}
  .hg-legal{order:6}
  /* Die Dockzeile bricht hier je nach Sprache anders um: das Zufallsschiff
     steht mal am rechten, mal am linken Rand, und seine Blase ragte (auch
     unsichtbar) aus dem Fenster, die Seite scrollte waagerecht. Ohne Maus
     zeigt sie ohnehin nie; den Namen traegt aria-label. */
  .hgx-rand .hgx-tip{display:none}
}
@media (prefers-reduced-motion:reduce){.hg-card{transition:none;transform:none!important}.hg-strip{scroll-behavior:auto}.hg-bar i{transition:none}.hg-title.is-swap{animation:none}.hgx-tabs button,.hgx-slot__btn,.hgx-mk,.hgx-docktog svg{transition:none}}</style>

<SiteNav crumbs={lang === 'de' ? [{ label: 'Schiffe', href: '/de/schiffe.html' }, { label: 'Hangar' }] : [{ label: 'Ships', href: '/schiffe.html' }, { label: 'Hangar' }]} hasEn={true} />

<main class="hg" id="main" data-loc={loc} data-default-ship={HANGAR_DEFAULT_SHIP} data-bay-base={href('/hangar-bay/', lang)} data-layout-js={layoutSrc} data-tab-active="overview" data-pane="layout">
  {/* Das Dock ist zu, bis jemand es aufklappt; die Halle bekommt seinen Platz.
      Vor der Buehne entschieden, damit ihre Hoehe nicht nach dem ersten Bild
      springt. Ohne Skript bleibt es offen. Ebenso vorab: ob der Bedienhinweis
      schon gesehen ist, damit er nicht erst aufblitzt. */}
  <script is:inline>(function(m){try{if(localStorage.getItem('hg-dock')!=='open')m.dataset.dock='closed';if(localStorage.getItem('hg-hint'))m.dataset.hint='seen'}catch(e){m.dataset.dock='closed'}})(document.currentScript.parentElement)</script>
  <div class="hg-stagewrap" data-media-surface>
    <HangarApp>
      <ShipBay bay={bay} region="marks" />
      <header class="hg-title">
        <h1>Hangar</h1>
        <ShipBay bay={bay} region="head" />
        {/* Drei Zeichen statt drei beschrifteter Knoepfe; das Wort steht als
            Blase am Knopf (.hgx-tip) und ist zugleich sein Name fuer Vorleser. */}
        <div class="hgx-actions" role="group" aria-label={t('act.group')}>
          {/* Folgt dem gewaehlten Schiff: der Controller tauscht data-fleet-ship
              und data-fleet-label, aria-pressed setzt assets/fleet.js. */}
          <button type="button" class="hg-btn hgx-act hgx-ico" id="hgx-fleet" data-help={h('hangar.ctl.fleet')} data-fleet-ship={bay.id} data-fleet-label={bay.head.name} data-fleet-on={ui('fleet.in')} data-fleet-off={ui('fleet.add')} aria-pressed="false">
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={star} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
            <span class="hgx-tip js-fleet-txt">{ui('fleet.add')}</span>
          </button>
          <button type="button" class="hg-btn hgx-act hgx-ico" id="hgx-cmp-toggle" aria-pressed="false" data-help={h('hangar.ctl.compare')}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M5 20V11M12 20V4M19 20v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <span class="hgx-tip">{t('act.compare')}</span>
          </button>
          <button type="button" class="hg-btn hgx-act hgx-ico" id="hgx-copy" data-help={h('hangar.ctl.copy')}>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={link} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            <span class="hgx-tip">{t('act.copy')}</span>
          </button>
          <input class="hgx-copyfield" id="hgx-copyfield" type="text" readonly hidden aria-label={t('act.copyField')} />
        </div>
      </header>
      <p class="hgx-modelerr" id="hgx-modelerr" role="status" hidden>{t('model.failed')}</p>
      {/* Unten links auf der Buehne nur, was die Ansicht selbst betrifft:
          zuruecksetzen, die Grafikstufe und der Ton, alle als Zeichen. Der Zufall
          steht beim Dock, die Flottenzeile im Dock. Der Bedienhinweis steht,
          bis jemand die Halle zum ersten Mal anfasst (data-hint, gemerkt
          unter hg-hint). */}
      <div class="hg-tools" id="hg-tools">
        <button type="button" class="hg-btn hgx-ico" id="hg-reset">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 102.2-5.3M4.5 4.5v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="hgx-tip">{t('act.reset')}</span>
        </button>
        {/* Die Auswahl liegt unsichtbar ueber dem Zeichen: ein Klick oeffnet die Liste des Browsers. */}
        <label class="hg-btn hgx-ico hgx-gfx" id="hgx-gfx-wrap" data-help={h('hangar.ctl.gfx')} hidden>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="15" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="9" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          <span class="hgx-tip">{t('gfx.label')}: <span id="hgx-gfx-now">{t('gfx.auto')}</span></span>
          <select id="hgx-gfx">
            <option value="auto">{t('gfx.auto')}</option>
            <option value="hoch">{t('gfx.hoch')}</option>
            <option value="mittel">{t('gfx.mittel')}</option>
            <option value="niedrig">{t('gfx.niedrig')}</option>
          </select>
        </label>
        {/* Geraeusche von Plattform, Tor und Dampf (hangar-viewer.js, hangarSound);
            gemerkt unter hg-ton, sichtbar, sobald die Buehne Ton kann; Vorgabe aus. */}
        <button type="button" class="hg-btn hgx-ico hgx-snd" id="hgx-snd" aria-pressed="false" data-help={h('hangar.ctl.snd')} data-on={t('snd.on')} data-off={t('snd.off')} hidden>
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /><path class="hgx-snd__on" d="M15.5 9a4.2 4.2 0 010 6M18 6.5a8 8 0 010 11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path class="hgx-snd__off" d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <span class="hgx-tip">{t('snd.label')}: <span id="hgx-snd-now">{t('snd.off')}</span></span>
        </button>
      </div>
      <p class="hg-hint" id="hg-hint">{t('act.hint')}</p>
    </HangarApp>
    {/* Die Leiste am Buehnenfuss traegt nur noch den Korb des Vergleichs; sie
        laesst links den Platz der beiden Zeichen frei. */}
    <div class="hgx-stagebar" id="hgx-stagebar">
      {/* Der Korb des Vergleichs; das erste Schiff ist die Basis. */}
      <div class="hgx-tray" id="hgx-tray" role="group" aria-labelledby="hgx-tray-title" data-help={h('hangar.ctl.tray')} hidden>
        <b class="hgx-tray__title" id="hgx-tray-title">{t('cmp.tray')}</b>
        <ul class="hgx-tray__list" id="hgx-tray-list"></ul>
        <span class="hgx-tray__hint" id="hgx-tray-hint" hidden>{t('cmp.hint')}</span>
        <button type="button" class="hg-btn hgx-tray__open" id="hgx-cmp-open" hidden>{t('msg.cmp.open', { n: '2' })}</button>
        <p class="hgx-tray__msg" id="hgx-tray-msg" hidden>{t('cmp.full')}</p>
      </div>
    </div>
    {/* Die Tafel rechts: oben der Schalter, darunter Werkstatt (Vorgabe) oder
        Schiffsdaten. Ohne Skript gibt es nur die Schiffsdaten (noscript unten). */}
    <div class="hg-side">
    <div class="hg-pane" role="tablist" aria-label={lt('pane.label')} data-help={h('hangar.ctl.layout')}>
      <button type="button" role="tab" id="hg-pane-layout" data-pane-to="layout" aria-controls="hgl" aria-selected="true">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M14.7 6.3a4 4 0 00-5.4 5.2L3.6 17.2a1.5 1.5 0 002.1 2.1l5.7-5.7a4 4 0 005.2-5.4l-2.4 2.4-2.1-.4-.4-2.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span>{lt('pane.layout')}</span>
      </button>
      <button type="button" role="tab" id="hg-pane-ship" data-pane-to="ship" aria-controls="hg-stats" aria-selected="false" tabindex="-1">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 20V11M12 20V4M19 20v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>{lt('pane.ship')}</span>
      </button>
    </div>
    <aside class="hg-stats" id="hg-stats" aria-label={t('panel.label')}>
      <div class="hgx-tabs" role="tablist" aria-label={t('panel.tabs')} data-help={h('hangar.ctl.tabs')}>
        {TABS.map((k) => (
          <button type="button" role="tab" id={`hgx-tab-${k}`} data-tab={k} aria-controls={`hgx-tp-${k}`} aria-selected={k === 'overview' ? 'true' : 'false'} tabindex={k === 'overview' ? '0' : '-1'}>{t(`tab.${k}`)}</button>
        ))}
      </div>
      <div class="hgx-scroll" id="hgx-panelhost" aria-busy="false">
        <ShipBay bay={bay} region="panel" />
        <div class="hgx-err" id="hgx-bayerr" role="alert" hidden>
          <p>{t('bay.failed')}</p>
          <button type="button" class="hg-btn" id="hgx-bayretry">{t('bay.retry')}</button>
        </div>
      </div>
    </aside>
    <LayoutWorkshop lang={lang} />
    </div>
    <noscript><style>.hg .hg-stats{display:flex!important}.hg .hgl,.hg .hg-pane,.hg .hgx-docktog,.hg .hgx-filtertog{display:none!important}</style></noscript>
    {/* Modal ueber der Buehne (showModal: Fokus bleibt drin, Escape ist "cancel").
        Zeilen aus dem Kennwert-Verzeichnis, Spalten setzt der Controller aus
        den Dock-Daten, ohne eine Bucht zu holen. In der Insel, damit er auch
        im Hellmodus dunkel bleibt wie die Halle darunter. */}
    <dialog class="hgx-cmp" id="hgx-cmp" aria-labelledby="hgx-cmp-title">
      <div class="hgx-cmp__head">
        <h2 id="hgx-cmp-title">{t('cmp.title')}</h2>
        <p class="hgx-cmp__note">{t('cmp.note')}</p>
        <button type="button" class="hg-btn" id="hgx-cmp-close">{t('cmp.close')}</button>
      </div>
      <div class="hgx-cmp__scroll">
        <table class="hgx-cmp__table" id="hgx-cmp-table">
          <thead><tr><th scope="col"><span class="hgx-sr">{t('cmp.stat')}</span></th></tr></thead>
          <tbody>
            {STATS.filter((s) => s.comparable).map((s) => (
              <tr data-k={s.key} data-u={s.unit} data-d={s.digits} data-better={s.better}><th scope="row">{t(`stat.${s.key}`)}</th></tr>
            ))}
          </tbody>
        </table>
      </div>
      <span id="hgx-cmp-basedesc" hidden>{t('cmp.makeBase')}</span>
    </dialog>
  </div>

  <section class="hg-dock" data-media-surface aria-label={t('dock.label')}>
    <div class="hg-filter">
      <ToolHelp tool="hangar" lang={lang} steps={5} />
      {/* Hinter der Hilfe: tool-help.js laesst sie beim Erstbesuch nur offen,
          wenn das naechste Bedienelement im Bild bleibt, und zugeklappt ist
          das dieser Schalter. */}
      {/* Traegt die Anzahl: so kostet er die offene Zeile kaum Breite, und die
          bleibt ab 1280 px einzeilig. */}
      <button type="button" class="hgx-chip hgx-docktog" id="hgx-docktog" aria-expanded="true" aria-controls="hg-strip" data-help={h('hangar.ctl.dock')}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="hgx-docktog__lbl">{t('dock.label')}</span>
        <span class="hg-count" id="hg-count" aria-live="polite">{count}</span>
      </button>
      {/* Bleibt auch zugeklappt stehen: der Zufall zieht aus den sichtbaren Karten. */}
      <button type="button" class="hgx-chip hgx-ico hgx-rand" id="hgx-random" aria-label={t('dock.random')} data-help={h('hangar.ctl.random')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={dice} fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="9" cy="9" r="1.4" fill="currentColor" /><circle cx="15" cy="15" r="1.4" fill="currentColor" /><circle cx="12" cy="12" r="1.4" fill="currentColor" /></svg>
        <span class="hgx-tip">{t('dock.random')}</span>
      </button>
      <label class="hgx-search">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M16 16l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="hg-q" type="search" placeholder={t('dock.search')} aria-label={t('dock.searchLabel')} autocomplete="off" data-help={h('hangar.ctl.search')} />
      </label>
      {/* Die Rollen als Reiter: ein Klick statt einer Liste hinter "Filter".
          Sie stellen #hg-type, das fuer Adresse und Zustand bleibt. */}
      <div class="hgx-roles" id="hgx-roles" role="group" aria-label={t('dock.type')} data-help={h('hangar.ctl.select')}>
        <button type="button" data-role="" aria-pressed="true">{t('dock.all')}</button>
        {types.map((ty) => <button type="button" data-role={ty.key} aria-pressed="false">{ty.label}</button>)}
      </div>
      {/* Rolle, Hersteller und Sortierung hinter einem Knopf: drei Listen
          weniger in der Zeile. Die Zahl nennt, wie viele vom Normalfall
          abweichen, damit ein Filter nicht unsichtbar weiterwirkt. */}
      <button type="button" class="hgx-chip hgx-filtertog" id="hgx-filtertog" aria-expanded="false" aria-controls="hgx-filters" title={t('dock.filter')} data-help={h('hangar.ctl.filters')}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d={funnel} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span class="hgx-lbl">{t('dock.filter')}</span>
        <span class="hgx-filtern" id="hgx-filtern" hidden></span>
      </button>
      <span class="hgx-filters" id="hgx-filters" hidden>
      <select id="hg-type" aria-label={t('dock.type')} data-help={h('hangar.ctl.select')}>
        <option value="">{t('dock.typeAll')}</option>
        {types.map((ty) => <option value={ty.key}>{ty.label}</option>)}
      </select>
      <select id="hg-maker-f" aria-label={t('dock.maker')} data-help={h('hangar.ctl.select')}>
        <option value="">{t('dock.makerAll')}</option>
        {makers.map((m) => <option value={m}>{m}</option>)}
      </select>
      {/* Aus dem Kennwert-Verzeichnis; die Optionen sind zugleich die gueltigen Werte von ?sort=. */}
      <select id="hgx-sort" aria-label={t('dock.sort')} data-help={h('hangar.ctl.sort')}>
        <option value="name">{t('dock.sortName')}</option>
        {STATS.filter((s) => s.sortable).map((s) => <option value={s.key}>{t(`stat.${s.key}`)}</option>)}
      </select>
      </span>
      <button type="button" class="hgx-chip" id="hgx-fleetonly" aria-pressed="false" title={t('dock.fleet')} data-help={h('hangar.ctl.fleetFilter')}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d={star} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        <span class="hgx-lbl">{t('dock.fleet')}</span> <span class="hgx-chipn" id="hgx-fleetn">0</span>
      </button>
      {/* Statt des Seitenfusses (die Seite ist ein Fenster hoch): Impressum
          und Datenschutz bleiben einen Klick entfernt. */}
      <nav class="hg-legal" aria-label={ui('footer.pageNav')}>
        <a href={href('/impressum.html', lang)}>{ui('footer.imprint')}</a>
        <span aria-hidden="true">·</span>
        <a href={href('/datenschutz.html', lang)}>{ui('footer.privacy')}</a>
      </nav>
    </div>
    {/* Summen der Flotte und wo sie liegt: steht, solange das Dock nur die
        Flotte zeigt, und von selbst bei einer Uebernahme oder einem Fehler
        im Abgleich (paintFleet), dann auch bei zugeklapptem Dock. */}
    <div class="hgx-fleetline" id="hgx-fleetline" data-help={h('hangar.ctl.fleetLine')} hidden>
      <span class="hgx-fleetsum" id="hgx-fleetsum" hidden><b>{t('dock.fleet')}</b> <span id="hgx-fleetsum-txt"></span></span>
      <span class="hgx-fleetsync" id="hgx-fleetsync" hidden>
        <span data-when="local">{t('fleet.local')} <a id="hgx-login" href={href('/account/login.html', lang)}>{t('fleet.signin')}</a></span>
        <span data-when="syncing" hidden>{t('fleet.syncing')}</span>
        <span data-when="synced" hidden>{t('fleet.synced')}</span>
        <button type="button" class="hgx-retry" data-fleet-retry data-fleet-unsaved={ui('fleet.retry')} data-fleet-unsynced={ui('fleet.resync')} hidden>{ui('fleet.retry')}</button>
      </span>
      <p class="hgx-merged" id="hgx-merged" hidden>
        <span id="hgx-merged-txt"></span>
        <button type="button" class="hgx-x" id="hgx-merged-x" aria-label={t('fleet.dismiss')}>×</button>
      </p>
    </div>
    <div class="hg-rail">
      <button type="button" class="hg-arrow" id="hg-prev" aria-label={t('dock.prev')}>‹</button>
      {/* data-v: Kennwerte je Karte in der Folge von data-stats (catalog.ts dockFigures). */}
      <ul class="hg-strip" id="hg-strip" data-stats={STATS.map((s) => s.key).join(' ')}>
        {ships.map((s) => (
          <li data-id={s.id} data-t={s.typeKey} data-mk={s.maker} data-q={`${s.name} ${s.maker} ${s.makerCode}`.toLowerCase()} data-fam={s.families.join(' ')} data-v={dockFigures(s)}>
            {/* href = Datenblatt: ohne Skript (oder per Mittelklick) führt die Karte
                dorthin; mit Skript fängt der Klick ab und stellt das Schiff in die Halle. */}
            <a class="hg-card" href={href(s.sheetPath, lang)} data-id={s.id} aria-current={s.id === bay.id ? 'true' : 'false'}>
              {s.thumb ? <img src={s.thumb} alt="" loading="lazy" decoding="async" width="156" height="88" /> : <i class="hg-noimg"></i>}
              <span>{s.name}</span>
              <small>{s.maker}</small>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="hg-arrow" id="hg-next" aria-label={t('dock.next')}>›</button>
    </div>
    <p class="hg-empty" id="hg-empty" hidden>{t('dock.empty')}</p>
    <p class="hg-empty" id="hgx-empty-fleet" hidden>{t('fleet.empty')}</p>
  </section>

  <p class="hgx-sr" id="hgx-live" aria-live="polite"></p>
  <span id="hgx-fleet-mark" hidden>{ui('fleet.in')}</span>
  <div id="hgx-msg" hidden>
    <span data-msg="count" data-one={t('msg.count.one')} data-other={t('msg.count.other')}></span>
    <span data-msg="copy" data-ok={t('msg.copy.ok')} data-fallback={t('msg.copy.fallback')}></span>
    <span data-msg="fleet-ships" data-one={t('msg.fleet.ships.one')} data-other={t('msg.fleet.ships.other')}></span>
    <span data-msg="fleet-scu" data-other={t('msg.fleet.scu')}></span>
    <span data-msg="fleet-crew" data-one={t('msg.fleet.crew.one')} data-other={t('msg.fleet.crew.other')}></span>
    <span data-msg="fleet-roles" data-one={t('msg.fleet.roles.one')} data-other={t('msg.fleet.roles.other')}></span>
    <span data-msg="fleet-merged" data-one={t('msg.fleet.merged.one')} data-other={t('msg.fleet.merged.other')}></span>
    <span data-msg="fleet-note" data-added={t('msg.fleet.added')} data-removed={t('msg.fleet.removed')}></span>
    <span data-msg="cmp-open" data-other={t('msg.cmp.open')}></span>
