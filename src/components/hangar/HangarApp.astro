---
// HANGAR — EIN Körper für DE und EN (D-12). Ein Schiff steht in einer 3D-
// Halle (assets/hangar-viewer.js), der Besucher dreht es und wechselt über
// das Karussell am Fuß, daneben die Kennwerte mit Balken im Flottenvergleich
// und der Weg zum Datenblatt. Vorbild ist der Garagen-Bildschirm aus World of
// Tanks: das Fahrzeug ist der Bildschirm, alles andere rahmt es.
//
// Die Modelle sind dieselben wie im Holo-Viewer der Datenblätter
// (src/data/holo-meshes.json -> /holo/*.glb), hier aber als massiver
// Metallrumpf unter Hallenlicht.
//
// Diese Datei ist nur die SZENE: Leinwand, Laden, Rueckfall,
// Modellpolitik (HOLD, Halle, Crew), Seitenpalette und Import-Map. Titel,
// Kennwerte, Werkzeuge, Dock und Controller stehen in HangarPage.astro und
// liegen ueber den <slot /> im selben Kasten wie #hg-canvas. Vertrag:
// src/lib/hangar/stage.ts und .planning/notes/hangar-naht.md.
import holoMeshes from '../../data/holo-meshes.json';
import hangarAssets from '../../data/hangar-assets.json';
import { localeFromPath } from '../../i18n/ui';
import { versioned } from '../../lib/assetVersion';
import { HANGAR_IDS, shipFacts } from '../../lib/hangar/catalog';
import type { StageConfig } from '../../lib/hangar/stage';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';

const meshes = (holoMeshes as { meshes: Record<string, { url: string; v?: string }> }).meshes;
// Echte Modelle (scripts/build-hangar-assets.mjs): Schiffe mit Werkslack, die
// Halle. Fehlt ein Schiff dort, bekommt es die Geometrie-Fassung mit Shader-Lack.
type Asset = { url: string; v?: string; room?: unknown };
const real = hangarAssets as unknown as { ships: Record<string, Asset>; hall: Record<string, Asset>; npc?: Record<string, Asset> };
const withV = (a: Asset) => (a.v ? `${a.url}?v=${a.v}` : a.url);
// Werkslack-Fassungen, die zurückgehalten werden, jeweils mit Anlass. Das
// Schiff zeigt solange die Geometrie-Fassung.
const HOLD: Record<string, string> = {
  'misc-freelancer': 'Rumpf als schwarz glänzende, verlaufene Flächen; die Lackschichten löst der Export nicht auf',
  'rsi-constellation-andromeda': 'Rumpf nach Neuexport sauber, aber fast schwarzbraun; Freigabe ist Sichturteil des Betreibers',
};
const hallAsset = Object.values(real.hall ?? {})[0];
const hall = hallAsset?.room ? { url: withV(hallAsset), room: hallAsset.room } : null;
const crewAsset = Object.values(real.npc ?? {})[0];
const crew = crewAsset ? { url: withV(crewAsset) } : null;

const viewerSrc = versioned('assets/hangar-viewer.js', '/assets/hangar-viewer.js');
// `<` maskiert: der Block steht in einem <script>, ein Schiffsname mit
// "</script>" darf ihn nicht beenden.
const stage = {
  viewer: viewerSrc,
  opts: { hall, crew },
  models: Object.fromEntries(HANGAR_IDS.map((id) => [id, [
    withV(meshes[id]),
    real.ships?.[id] && !HOLD[id] ? withV(real.ships[id]) : null,
    shipFacts(id, lang).makerCode,
  ] as const])),
} satisfies StageConfig;
const payload = JSON.stringify(stage).replace(/</g, '\\u003c');
---
<style is:inline>
/* theme.css bringt die --font-*-Tokens nicht mit (jede Seite ihren Stapel,
   vgl. assets/data-page.css); derselbe Stapel wie dort. */
:root{--font-display:'Orbitron','Rajdhani',system-ui,sans-serif;--font-ui:'Rajdhani','Barlow',system-ui,sans-serif;--font-body:'Barlow',system-ui,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.5;-webkit-font-smoothing:antialiased}
.hg *,.hg *::before,.hg *::after{box-sizing:border-box}
:root{--bg:#0b0d12;--bg-2:#11141b;--surface:#151922;--surface-2:#1c212c;--accent:#f5a623;--accent-2:#9aa6bd;--hot:#ff5b6e;--text:#e9edf5;--muted:#9aa6bd;--line:rgba(233,237,245,.16);--line-soft:rgba(233,237,245,.08);--ink:#0a0d16}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f7fe;--bg-2:#e9eef8;--surface:#fdfdff;--surface-2:#eef2fc;--text:#1c1f25;--muted:#4e586c;--accent:#7c5104;--accent-2:#49556d;--hot:#9c002c;--ink:#ffffff;--accent-media:#f5a623;--accent-2-media:#9aa6bd;--line:rgba(148,104,38,.3);--line-soft:rgba(43,46,52,.12)}
.hg-stage{position:relative;height:clamp(520px,calc(100svh - 190px),940px);background:var(--bg);overflow:hidden;color:var(--hg-on);isolation:isolate}
.hg-canvas{position:absolute;inset:0}
.hg-canvas::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 55%,transparent 50%,color-mix(in srgb,var(--bg) 55%,transparent) 100%)}
.hg-canvas canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
.hg-canvas canvas:active{cursor:grabbing}
.hg-load{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);width:min(260px,60%);text-align:center;font-size:var(--fs-6);color:var(--hg-dim);pointer-events:none}
.hg-load[hidden]{display:none}
.hg-load b{display:block;height:3px;margin-top:.5rem;background:var(--line-soft);border-radius:2px;overflow:hidden}
.hg-load b i{display:block;height:100%;width:var(--p,0%);background:var(--hg-amber)}
.hg-fallback{position:absolute;inset:0;display:grid;place-items:center;padding:2rem;text-align:center;color:var(--hg-dim)}
.hg-fallback[hidden]{display:none}
@media (max-width:760px){
  .hg-stage{height:clamp(360px,62svh,560px)}
  /* Senkrecht wischen scrollt die Seite, waagerecht ziehen dreht das Schiff.
     OrbitControls setzt touch-action:none als Inline-Stil, nur !important
     schlaegt ihn. */
  .hg-canvas canvas{touch-action:pan-y!important}
}</style>

    <section class="hg-stage" data-hg-stage aria-label={de ? '3D-Hangar' : '3D hangar'}>
      <div class="hg-canvas" id="hg-canvas"></div>
      <div class="hg-load" id="hg-load" hidden>{de ? 'Schiff wird hereingerollt …' : 'Rolling the ship in …'}<b><i></i></b></div>
      <div class="hg-fallback" id="hg-fallback" hidden>{de ? 'Dein Browser kann die 3D-Ansicht nicht darstellen. Die Werte und das Datenblatt stehen trotzdem bereit.' : 'Your browser cannot show the 3D view. The figures and the data sheet are still available.'}</div>
      <slot />
    </section>
<script type="application/json" id="hg-stage" set:html={payload}></script>
<script type="importmap" is:inline>
{"imports":{"three":"/vendor/three/three.module.min.js","three/addons/":"/vendor/three/addons/"}}
</script>
