---
// Sprachumschalter (DE | EN | HU). Rein Build-Zeit, kein JS/Cookie: jede
// Sprachoption verlinkt via pathForLocale() auf DIESELBE Seite in der anderen
// Sprache — bleibt also auf der aktuellen Seite und wechselt nur die Sprache.
// Die Liste kommt aus LOCALES; eine weitere Sprache erscheint hier von selbst.
// Palette-agnostisch (nutzt die --accent/--line/--text-Variablen der Seite).
import {
  LOCALES,
  LOCALE_SHORT,
  LOCALE_LABEL,
  localeFromPath,
  pathForLocale,
  href,
  useTranslations,
  type Locale,
} from '../i18n/ui';

interface Props {
  /**
   * Existieren für DIESE Seite die übersetzten Gegenstücke? Alle redaktionellen
   * Seiten sind vollständig dreisprachig, also true. Steht es auf false (Seite
   * nur in einer Sprache vorhanden), zeigen die anderen Sprachoptionen auf ihre
   * jeweilige Startseite statt ins 404.
   */
  translated?: boolean;
}
const { translated = false } = Astro.props;

const current = Astro.url.pathname;
const lang = localeFromPath(current);
const t = useTranslations(lang);

function targetFor(l: Locale): string {
  // Ohne Übersetzung dieser Seite: Startseite der Zielsprache statt 404.
  if (!translated) return href('/index.html', l);
  return pathForLocale(current, l);
}
---
<div class="langsw" role="group" aria-label={t('nav.langSwitch')}>
  {LOCALES.map((l, i) => (
    <>
      {i > 0 && <span class="langsw__sep" aria-hidden="true">/</span>}
      {l === lang ? (
        <span class="langsw__cur" lang={l} aria-current="true">{LOCALE_SHORT[l]}</span>
      ) : (
        <a class="langsw__opt" href={targetFor(l)} lang={l} hreflang={l} aria-label={LOCALE_LABEL[l]}>{LOCALE_SHORT[l]}</a>
      )}
    </>
  ))}
</div>

<style>
  .langsw {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.55rem;border:1px solid var(--line, var(--line-soft));
  }
  /* Die aktive Sprache steht in der Textfarbe, nicht im Akzent: sie ist der
     Ist-Zustand, kein Angebot. Der Akzent gehört der anklickbaren Option
     beim Hover — sonst leuchtet im Header wieder alles gleichzeitig. */
  .langsw__cur {
    color: var(--text, #e8eefc);
  }
  .langsw__opt {
    color: var(--muted, #8a99b8);
    transition: color 0.15s;
  }
  .langsw__opt:hover,
  .langsw__opt:active {
    color: var(--accent, #2dd4ff);
  }
  /* Auf schmalen Schirmen ist der Umschalter aus der Kopfleiste ausgeblendet
     und steht NUR noch im Menü-Fuß — dort war die anklickbare Fläche 18x23 px.
     Früher lag darüber ein unsichtbares 44-px-Pseudoelement. Das ging auf,
     solange nur EINE Option ein Link war (die aktive Sprache ist ein <span>
     ohne ::after). Bei drei Sprachen sind ZWEI Optionen Links, und zwei
     44 px breite Flächen im Abstand von ~24 px überlappen — die vordere hätte
     die hintere verdeckt. Darum jetzt echtes Padding: die Fläche ist die des
     Elements selbst, kann also grundsätzlich nicht mit der Nachbarfläche
     kollidieren. Im Menü-Fuß ist der Platz dafür da. */
  @media (max-width: 860px) {
    .langsw {
      gap: 0;
    }
    .langsw__opt,
    .langsw__cur {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      line-height: 1;
    }
  }
  .langsw__sep {
    color: var(--muted, #8a99b8);
    opacity: 0.5;
  }</style>
