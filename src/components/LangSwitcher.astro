---
// Sprachumschalter (DE | EN). Rein Build-Zeit, kein JS/Cookie: jede Sprach-
// option verlinkt via pathForLocale() auf DIESELBE Seite in der anderen
// Sprache — bleibt also auf der aktuellen Seite und wechselt nur die Sprache.
// Palette-agnostisch (nutzt die --accent/--line/--text-Variablen der Seite).
import {
  LOCALES,
  LOCALE_SHORT,
  LOCALE_LABEL,
  localeFromPath,
  pathForLocale,
  useTranslations,
  type Locale,
} from '../i18n/ui';
import { twinExists } from '../lib/routeTwins';

interface Props {
  /**
   * @deprecated Wird nicht mehr gebraucht und nur noch als Notbremse gelesen.
   *
   * Frueher trug jede Seite hier von Hand ein, ob sie ein EN-Gegenstueck hat.
   * Das war halb: fuer die Gegenrichtung (EN -> DE) gab es keine Flagge, sie
   * galt pauschal als vorhanden. /account/preview.html hatte kein DE-Pendant
   * und der Umschalter zeigte trotzdem darauf — ein 404 im Kopf jeder Seite.
   * Die Existenz kommt jetzt aus der Routenliste (lib/routeTwins.ts). Ein
   * ausdrueckliches `false` schaltet die Option weiterhin ab; `true` kann die
   * Ableitung NICHT ueberstimmen, sonst waere der 404 nur anders benannt.
   */
  hasEn?: boolean;
  /** Gegenstueck zu hasEn, gleiche Regel. Ebenfalls nur als `false` wirksam. */
  hasDe?: boolean;
}
const { hasEn, hasDe } = Astro.props;
const veto: Record<Locale, boolean | undefined> = { en: hasEn, de: hasDe };

const current = Astro.url.pathname;
const lang = localeFromPath(current);
const t = useTranslations(lang);

/** Startseite der Zielsprache — der Auffang, wenn es kein Gegenstueck gibt. */
const HOME: Record<Locale, string> = { en: '/index.html', de: '/de.html' };

function targetFor(l: Locale): string {
  if (veto[l] === false) return HOME[l];
  return twinExists(current, l, pathForLocale) ? pathForLocale(current, l) : HOME[l];
}
---
<div class="langsw" role="group" aria-label={t('nav.langSwitch')}>
  {LOCALES.map((l, i) => (
    <>
      {i > 0 && <span class="langsw__sep" aria-hidden="true">/</span>}
      {l === lang ? (
        <span class="langsw__cur" lang={l} aria-current="true">{LOCALE_SHORT[l]}</span>
      ) : (
        <a class="langsw__opt" href={targetFor(l)} lang={l} hreflang={l} aria-label={LOCALE_LABEL[l]}>{LOCALE_SHORT[l]}</a>
      )}
    </>
  ))}
</div>

<style>
  .langsw {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui, sans-serif);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 0.55rem;border:1px solid var(--line, var(--line-soft));
  }
  /* Die aktive Sprache steht in der Textfarbe, nicht im Akzent: sie ist der
     Ist-Zustand, kein Angebot. Der Akzent gehört der anklickbaren Option
     beim Hover — sonst leuchtet im Header wieder alles gleichzeitig. */
  .langsw__cur {
    color: var(--text, #e8eefc);
  }
  .langsw__opt {
    color: var(--muted, #8a99b8);
    transition: color 0.15s;
  }
  .langsw__opt:hover,
  .langsw__opt:active {
    color: var(--accent, #2dd4ff);
  }
  /* Auf schmalen Schirmen ist der Umschalter aus der Kopfleiste ausgeblendet
     und steht NUR noch im Menü-Fuß — dort war die anklickbare Fläche 18x23 px.
     Statt den Kasten optisch aufzublähen bekommen beide Sprachkürzel eine
     unsichtbare 44-px-Fläche; das Erscheinungsbild bleibt identisch. */
  @media (max-width: 860px) {
    .langsw__opt,
    .langsw__cur {
      position: relative;
      display: inline-block;
      line-height: 1;
    }
    .langsw__opt::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      min-width: 44px;
      width: 100%;
      height: 44px;
      transform: translate(-50%, -50%);
    }
  }
  .langsw__sep {
    color: var(--muted, #8a99b8);
    opacity: 0.5;
  }</style>
