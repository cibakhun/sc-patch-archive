---
// Partikel-Effekte-Umschalter (Sterne/Embers/Staub). Baulich verwandt mit
// ThemeToggle.astro, aber ausdruecklich OHNE dessen Rollen-Gatter fuer den
// Farbmodus (FX-04/D-06) — die Wahl steht ALLEN Besuchern offen.
//
// Der Anfangszustand steht NICHT im HTML — er entsteht erst zur Laufzeit
// (gespeicherte Wahl, siehe Layout.astro). aria-pressed wird deshalb dort
// gesetzt; hier steht nur ein Platzhalter. Anders als ThemeToggle startet
// der Platzhalter auf "false": Partikel sind per Vorgabe AUS (FX-02/D-04).
//
// GESTALT (bewusst anders als ThemeToggle): ein Symbol und daneben ein echter
// Kippschalter. Der Vorgaenger stellte ZWEI fast gleiche Funken nebeneinander,
// deren Unterschied nur ein duenner Schraegstrich war — bei 13 px nicht
// lesbar, und der weiche Kreis dahinter las sich als Fleck. Jetzt trennen sich
// die beiden Fragen sauber:
//   * WAS  — das Symbol (Funken = Effekte)
//   * OB   — die Schaltwippe, deren Punkt sichtbar wandert
// Die Form sagt damit schon „hier wird etwas ein- und ausgeschaltet", bevor
// jemand das Symbol deutet. Das Symbol braucht deshalb keinen Schraegstrich
// mehr; der Zustand steht in Position UND Farbe, nicht nur in Farbe.
//
// Was der Schalter tut, sagt zusaetzlich ein Tooltip: er klappt nach kurzem
// Verweilen auf, nennt den aktuellen Zustand und was ein Klick bewirkt. Er
// haengt an CSS, nicht an JS — der Zustandssatz wechselt mit [data-fx] mit.
import { localeFromPath, useTranslations } from '../i18n/ui';

interface Props {
  /**
   * Wo der Schalter steht. Steuert zwei Dinge: die eindeutige id des Tooltips
   * (die Leiste und der Menuefuss zeigen BEIDE einen Schalter — doppelte ids
   * waeren ungueltig) und die Richtung, in die er aufklappt. Im Menuefuss nach
   * oben, sonst stuende er unter dem Bildrand.
   */
  place?: 'bar' | 'deck';
}
const { place = 'bar' } = Astro.props;
const t = useTranslations(localeFromPath(Astro.url.pathname));
const tipId = `fxsw-tip-${place}`;
---

<span class:list={['fxsw-wrap', `fxsw-wrap--${place}`]}>
  <button
    class="fxsw js-fx-toggle"
    type="button"
    aria-pressed="false"
    aria-label={t('nav.fx')}
    aria-describedby={tipId}
  >
    <svg class="fxsw__ic" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.6 5.4 11 10.2 15.8 11.6 11 13 9.6 17.8 8.2 13 3.4 11.6 8.2 10.2z" />
      <path d="M17.6 14.4 18.2 16.4 20.2 17 18.2 17.6 17.6 19.6 17 17.6 15 17 17 16.4z" />
    </svg>
    <span class="fxsw__sw" aria-hidden="true"><i class="fxsw__dot"></i></span>
  </button>

  <span class="fxsw__tip" id={tipId} role="tooltip">
    <b class="fxsw__tiph">{t('nav.fx')}</b>
    <span>{t('nav.fx.what')}</span>
    <span class="fxsw__tipstate fxsw__tipstate--on">{t('nav.fx.state.on')}</span>
    <span class="fxsw__tipstate fxsw__tipstate--off">{t('nav.fx.state.off')}</span>
  </span>
</span>

<style>
  .fxsw-wrap {
    position: relative;
    display: inline-flex;
  }

  .fxsw {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.42rem 0.3rem 0.5rem;border:1px solid var(--line, var(--line-soft));
    background: none;
    color: inherit;
    cursor: pointer;
    line-height: 0;
  }
  .fxsw:hover {
    border-color: var(--accent, #2dd4ff);
  }
  .fxsw:focus-visible {
    outline: 2px solid var(--accent-2, var(--accent, #2dd4ff));
    outline-offset: 3px;
  }

  /* Das Symbol beantwortet WAS, nicht OB — es traegt deshalb keinen
     Schraegstrich mehr, sondern wird im Aus-Zustand nur ruhig. */
  .fxsw__ic {
    display: block;
    color: var(--muted, #8a99b8);
    transition: color 0.18s;
  }

  /* Die Wippe beantwortet OB. Position des Punktes ist das Hauptsignal, Farbe
     nur die Verstaerkung — so bleibt der Zustand auch ohne Farbsehen ablesbar. */
  .fxsw__sw {
    position: relative;
    flex: 0 0 auto;
    width: 28px;
    height: 15px;
    border-radius: 99px;
    background: var(--surface-2, #1b2230);
    border: 1px solid var(--line, var(--line-soft));
    transition: background 0.18s, border-color 0.18s;
  }
  .fxsw__dot {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--muted, #8a99b8);
    transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1), background 0.18s;
  }

  /* Haengt bewusst nur an [data-fx] — keine Rollen-Klasse (FX-04/D-06). */
  :global(html[data-fx='on']) .fxsw__ic {
    color: var(--accent, #2dd4ff);
  }
  :global(html[data-fx='on']) .fxsw__sw {
    background: color-mix(in srgb, var(--accent, #2dd4ff) 22%, transparent);
    border-color: var(--accent, #2dd4ff);
  }
  :global(html[data-fx='on']) .fxsw__dot {
    transform: translateX(13px);
    background: var(--accent, #2dd4ff);
  }

  /* ---------- Tooltip ---------------------------------------------------- */
  .fxsw__tip {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.5rem);
    /* Linksbuendig statt zentriert: der Schalter sitzt links in der Leiste und
       links im Menuefuss — ein zentrierter Kasten haette dort nach links aus
       dem Bild geragt. Die Breite ist zusaetzlich auf das Bild begrenzt. */
    left: 0;
    display: grid;
    gap: 0.2rem;
    width: max-content;
    max-width: min(15rem, calc(100vw - 2rem));
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line, var(--line-soft));
    background: var(--surface, #14121c);
    color: var(--text, #e8eefc);
    font-family: var(--font-ui, system-ui, sans-serif);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.01em;
    text-align: left;
    text-transform: none;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
    /* Nicht anfassbar: der Tooltip darf den Zeiger nicht vom Knopf nehmen. */
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }
  .fxsw__tiph {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.68rem;
    color: var(--accent, #2dd4ff);
  }
  /* Der Zustandssatz wechselt mit dem Schalter — ohne JS. */
  :global(html[data-fx='on']) .fxsw__tipstate--off,
  :global(html:not([data-fx='on'])) .fxsw__tipstate--on {
    display: none;
  }
  .fxsw__tipstate {
    color: var(--muted, #8a99b8);
  }

  /* Mit der Maus: erst nach kurzem Verweilen — ein Tooltip, der beim
     Vorbeifahren aufblitzt, ist Störung, keine Hilfe. */
  .fxsw-wrap:hover .fxsw__tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.16s ease 0.45s, transform 0.16s ease 0.45s, visibility 0s linear 0.45s;
  }
  /* Mit der Tastatur: sofort. Wer hierher tabbt, hat sich schon entschieden.
     Steht NACH der Hover-Regel, damit sie bei beidem gewinnt. */
  .fxsw:focus-visible + .fxsw__tip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 0.12s ease, transform 0.12s ease, visibility 0s;
  }

  /* Im Menuefuss nach OBEN aufklappen — unten waere er aus dem Bild. */
  .fxsw-wrap--deck .fxsw__tip {
    top: auto;
    bottom: calc(100% + 0.5rem);
  }

  /* Die wandernde Hero-Wortmarke der Startseite liegt mit z-index 9601 UEBER
     der Kopfleiste (9600) — sie muss dort landen koennen. Der Tooltip steckt
     im Stapelkontext der Leiste (position:fixed + backdrop-filter) und kann
     die Marke deshalb mit KEINEM z-index der Welt ueberholen: er lag hinter
     dem "Ve" und war unlesbar.
     Also hebt sich die Leiste selbst an — nur solange der Tooltip zu sehen
     ist, also fuer den Moment des Verweilens. Die Marke ist dann kurz hinter
     der (ohnehin halbtransparenten) Leiste; das faellt niemandem auf, ein
     abgeschnittener Hilfetext schon. */
  :global(.snav:has(.fxsw-wrap:hover)),
  :global(.snav:has(.fxsw:focus-visible)) {
    z-index: 9602;
  }

  /* Auf schmalen Schirmen die Breite des Bildschirms nicht sprengen. */
  @media (max-width: 420px) {
    .fxsw__tip {
      max-width: 11rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fxsw__dot,
    .fxsw__tip {
      transition: none;
    }
    .fxsw-wrap:hover .fxsw__tip,
    .fxsw:focus-visible + .fxsw__tip {
      transform: none;
      /* Die Verzoegerung bleibt: sie ist kein Effekt, sondern Absicht. */
      transition: visibility 0s linear 0.45s;
    }
  }
</style>
