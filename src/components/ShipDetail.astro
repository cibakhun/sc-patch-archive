---
// Schiff-Datenblatt — geteilte, locale-bewusste Ansicht (DE + EN).
// Aus src/pages/schiffe/[slug].astro extrahiert, damit DE und EN dieselbe
// Vorlage teilen (alle 226 Seiten pro Sprache).
//
// i18n-Stand (Stufe 2, vollständig): Template-Chrome + alle Daten-Row-Labels
// (src/lib via t()), Freitext (Beschreibung/Foci/Typ/Größe/Status via
// vehicleText) und Zahlenformat (loc = de-DE / en-US) sind lokalisiert.
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import Layout from '../layouts/Layout.astro';
import SiteNav from './SiteNav.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import vehiclesSnapshot from '../data/vehicles.json';
import { buildArmament, buildArmStats, crewFmt } from '../lib/shipFacts';
import { buildVisuals } from '../lib/shipVisuals';
import type { Visuals } from '../lib/shipVisuals';
import { pickHero } from '../lib/shipRenders';
import {
  priceInfo, aUEC, pricesFetchedAt,
  extrasInfo, extrasFetchedAt,
  shipVideo, shipLocalVideo, shipGallery,
} from '../lib/shipExtras';
import type { SimilarShip, ShipExtras, ProfileBar } from '../lib/shipExtras';
import { useTranslations, href, type Locale, DEFAULT_LOCALE } from '../i18n/ui';
import { vRole, vSize, vStatus, vDesc } from '../i18n/vehicleText';
import holoMeshesSnapshot from '../data/holo-meshes.json';
import shipHardpointsSnapshot from '../data/ship-hardpoints.json';
import shipLoadoutsSnapshot from '../data/ship-loadouts.json';
// Hersteller-Logos (game-sourced aus Data.p4k, self-hosted unter /assets/manufacturers/).
// Manifest: exakter Herstellername -> { file, w, h }. Kein Treffer -> Text-Fallback.
import manufacturerLogos from '../data/manufacturer-logos.json';
import { itemInfo } from '../lib/holoItems';
import { HOLO_GRP_ICON, HOLO_ICON } from '../lib/holoIcons';

interface Props {
  d: CollectionEntry<'vehicles'>['data'];
  id: string;
  similar: SimilarShip[];
  profile: ProfileBar[];
  viz: Visuals;
  lang?: Locale;
  /** DE↔EN-Gegenstück existiert -> hreflang ausgeben */
  hasEn?: boolean;
}
const { d, id, similar, profile, viz, lang = DEFAULT_LOCALE, hasEn = false } = Astro.props;

const t = useTranslations(lang);
const L = (p: string) => href(p, lang);
const loc = lang === 'en' ? 'en-US' : 'de-DE';

const hero = pickHero(d);
// Echtes Marken-Logo, wenn der Hersteller im Manifest steht; sonst Text-Eyebrow.
const makerLogo =
  (d.manufacturer && (manufacturerLogos as Record<string, { file: string; w: number; h: number; full?: boolean }>)[d.manufacturer]) ||
  null;
// Kopf-Medien: Video (selbst-gehostet ODER YouTube-Commercial) + Bild-Galerie.
// localVid (stummer <video>-Loop, kein Player-Chrome) hat Vorrang; sonst YouTube.
const localVid = shipLocalVideo(id);
const videoId = localVid ? null : shipVideo(id);
const hasVideo = !!(localVid || videoId);
const gallery = shipGallery(id, d);
// Cache-Busting: /assets/holo-viewer.js hat eine feste URL und wird vom CDN
// (Cloudflare, 4h) gecached -> nach einem Deploy sonst die ALTE Datei. Ein
// Content-Hash im Query erzwingt bei Änderung eine neue URL (Cache-Miss).
let holoViewerVer = 'x';
try { holoViewerVer = createHash('sha1').update(readFileSync('assets/holo-viewer.js')).digest('hex').slice(0, 8); } catch { /* dev-Fallback */ }
const holoViewerSrc = `/assets/holo-viewer.js?v=${holoViewerVer}`;
const prices = priceInfo(id);
const buyMin = prices?.buy[0] ?? null;
const rentMin = prices?.rent[0] ?? null;
const MAX_ROWS = 6;

const extras: ShipExtras = extrasInfo(id);

// Anzeigeform der Spielversion: aus "sc-alpha-4.9.0@12326004" wird "Alpha 4.9.0".
// `split('-')[0]` stand hier vorher und ergab das nichtssagende "sc" — das fiel
// nur niemandem auf, solange davor noch ein Wort stand.
const alphaLabelOf = (v) => {
  const m = /alpha-([\d.]+)/i.exec(v ?? '');
  return m ? `Alpha ${m[1]}` : null;
};
const shipAlphaLabel = alphaLabelOf(d.gameVersion);
const holoUrl = extras?.holo ?? null;
const paints = extras?.paints ?? [];
const variants = (extras?.variants ?? []).filter((v) => v.id !== id);
const loaners = (extras?.loaners ?? []).filter((v) => v.id !== id);

// patch-spine: version -> codename/page
const patches = await getCollection('patches');
const spine = d.patches
  .map((v) => patches.find((p) => p.data.version === v))
  .filter(Boolean);

const armament = buildArmament(d, lang);
const armStats = buildArmStats(d, lang);
// Turm-DPS-Summe als ZUSAETZLICHE Zelle nur bei MEHR als einer Turmgruppe
// (14-UI-SPEC.md Detailvertrag Punkt 4) — bei genau einer Turmgruppe steht
// derselbe Wert bereits als arm__gval in deren eigener Zeile, eine zweite
// Zelle waere die Doppelung, die D-03 verbietet.
const turretDpsTotal =
  d.turrets.length > 1 && d.turretDps ? Math.round(d.turretDps).toLocaleString(loc) : null;
const desc = vDesc(d, lang);
// FleetYards liefert vereinzelt "<= PLACEHOLDER =>" als Komponentennamen
// (z. B. Javelin, ROC-DS) — solche Einträge tragen keine Information und
// werden ausgefiltert statt gerendert.
const realName = (it: { name: string }) => !/placeholder|<=|=>|\bTBD\b/i.test(it.name ?? '');
const slots: [string, { name: string; size: number | null; count: number }[]][] = (
  [
    [t('ship.slot.generators'), (d.components?.powerPlants ?? []).filter(realName)],
    [t('ship.slot.shields'), (d.components?.shields ?? []).filter(realName)],
    [t('ship.slot.coolers'), (d.components?.coolers ?? []).filter(realName)],
    [t('ship.slot.quantum'), (d.components?.quantumDrives ?? []).filter(realName)],
    [t('ship.slot.radar'), (d.components?.radars ?? []).filter(realName)],
  ] as [string, { name: string; size: number | null; count: number }[]][]
).filter(([, a]) => a.length > 0);

/* ⚠ Die Pruefung war `!= null` — und traf damit die 0 nicht. Zwei Fahrzeuge
   fuehren 0 statt fehlender Masse (aegs-javelin, argo-moth, gemessen ueber
   src/data/vehicles.json), und ihre Seiten zeigten "L 0 M · B 0 M · H 0 M"
   und "LAENGE 0 m". Eine Null ist hier kein Messwert, sondern ein
   fehlender Wert in Zahlengestalt — und damit schlechter als der
   Gedankenstrich, denn sie sieht aus wie eine Aussage.
   NUR fuer Masse und Tempo: 0 SCU Fracht ist bei 124 Fahrzeugen ECHT (ein
   Jaeger hat keinen Frachtraum) und bleibt deshalb unangetastet. */
const dims = [d.lengthM, d.widthM, d.heightM].every((x) => x != null && x > 0)
  ? `${t('ship.abbr.l')} ${d.lengthM} m · ${t('ship.abbr.w')} ${d.widthM} m · ${t('ship.abbr.h')} ${d.heightM} m`
  : null;
const stageStats: { label: string; value: string }[] = [
  // 0 m ist kein Schiff — siehe Begruendung an `dims` oben.
  { label: t('ship.stage.length'), value: d.lengthM != null && d.lengthM > 0 ? `${d.lengthM.toLocaleString(loc)} m` : '—' },
  { label: t('ship.stage.crew'), value: crewFmt(d) },
  { label: t('ship.stage.cargo'), value: d.cargoSCU != null ? `${d.cargoSCU.toLocaleString(loc)} SCU` : '—' },
  { label: t('ship.stage.scm'), value: d.scmSpeed != null ? `${d.scmSpeed} m/s` : '—' },
  {
    label: buyMin ? t('ship.stage.priceIngame') : t('ship.stage.pledge'),
    value: buyMin ? aUEC(buyMin.price, lang) : d.msrpUSD != null ? `$${d.msrpUSD.toLocaleString('en-US')}` : '—',
  },
];

// Kapitelliste (EINZIGE Quelle fuer Sprungleiste + Kapitelkoepfe, D-01).
// Jeder Eintrag traegt die stabile, NICHT uebersetzte Kennung, den vollen
// Kapiteltitel, das Kurzlabel fuer die Sprungleisten-Pille und die
// Bedingung, unter der das Kapitel ueberhaupt rendert. Welle 3 verlaengert
// diese Liste um drei Eintraege (ch-profile, ch-gear, ch-context) — sie
// baut sie nicht um. Diese Liste ist die EINZIGE Quelle: eine Pille
// entsteht nur zu einem Eintrag, der auch sein Element rendert; jede
// Entkopplung erzeugt einen toten Anker, und tote Anker sind bei
// `audit:site` ein FEHLER. Die Kapitelnummer wird aus der gefilterten
// Liste fortlaufend abgeleitet, nicht aus einer festen Zuordnung — eine
// Seite mit drei Kapiteln zeigt 01, 02, 03, nicht 01, 03, 04.
// Wurzelbedingungen der drei neuen Kapitel — wortgleich die ODER-Verknuepfung
// ihrer Unterabschnitts-Bedingungen weiter unten im Markup (nicht neu
// formuliert, siehe Task-1-Anweisung). Vorgezogen, damit die Sprungleiste sie
// kennt, bevor das Kapitel selbst gerendert wird.
const gearDims = viz.dims != null || viz.cargo != null || viz.fuel.length > 0;
const gearFlight = viz.speeds.length > 0 || viz.agility.length > 0 || viz.quantum.length > 0;
// 16-03-PLAN.md SCHRITT 4: Bewaffnung (vormals gearArms) und die
// Bauteilliste (vormals Teil von gearComp) wandern VOLLSTAENDIG aus dem
// Kapitel in die Konsole — sie tragen darum nicht mehr zur
// Kapitel-Sichtbarkeit bei. Nur die Widerstandswerte (Huelle/Schild,
// aggregierte Ganzschiff-Kennzahlen ohne Einbauort) bleiben im Kapitel.
const gearDefense = viz.defense.length > 0;
const hasGear = gearDims || gearFlight || gearDefense;
const hasContext = viz.insurance.length > 0 || paints.length > 0 || variants.length > 0 || loaners.length > 0 || spine.length > 0;
// Umfeld-Kopfzeile: FleetYards-Stand nur, wenn tatsaechlich FleetYards-Inhalt
// (Lackierungen ODER Varianten/Loaner) im Kapitel steht — sonst die
// bestehende Standard-Angabe des Versicherungs-Panels (14-UI-SPEC.md Punkt 7).
const ctxHasFleetYards = paints.length > 0 || variants.length > 0 || loaners.length > 0;
const ctxCode = ctxHasFleetYards
  ? `${t('ship.code.ctx')} // FleetYards · ${t('ship.asof')} ${extrasFetchedAt}`
  : `${t('ship.code.ctx')} // ${t('ship.code.uee')}`;

// Die frueheren vier Kapitel (CHAPTERS_SOURCE/chapters/chapterNum) sind mit
// D-01 entfallen: ihre Koerper stehen jetzt als Inhaltsgruppen IN der Konsole
// (CONTENT_GROUPS_SOURCE weiter unten), die Sprungleiste hat die Rail ersetzt.
// Damit ist auch die durchlaufende Kapitelnummer weg — die Rail nummeriert
// nicht, sie beschriftet.

// ---------- Interaktives Komponenten-Hologramm ----------
// Positionsquelle ist das echte Spielmesh (src/data/holo-meshes.json): das
// gerenderte Mesh und die Hardpoints (ship-hardpoints.json, COMPILED_BONES)
// teilen denselben Raum -> Marker EXAKT, nur feste Achsvertauschung
// cry->glTF (x, z, -y). P-3 (16-01-PLAN.md, Variante C): drei der vier
// Triebwerksarten (thruster_main/retro/vtol) umgehen den Stock-Loadout-Join
// unten und bekommen IMMER einen Marker, auch ohne Stock-Item — Triebwerke
// sind Geometrie, kein Ausruestungsplatz, es gibt fuer sie kein Stock-Item,
// das der Join finden koennte. thruster_mav (die vielen kleinen Manoevrier-
// triebwerke) bleibt aussen vor: unter Variante C waere ihre Einzelgruppe
// (40 Marker am dichtesten Schiff, drak-corsair) ueber der am Bildpunkt
// belegten 20er-Obergrenze aus Task 1/2 dieses Plans.
type HoloPort = {
  k: string; g: string; p: number[];
  label: string | null; size: number | null;
  /** lab: dauerhaft sichtbare Beschriftung (nur Kern-Komponenten) */
  lab?: string;
  /** Item-Finder-Anreicherung (Kategorie / günstigster Preis / Kauforte / Item-ID) */
  cat?: string; price?: number; shops?: number; iid?: string;
  /** np: nicht physicalisiert · est: Position geschätzt · dim: gedämpfter Marker-Stil */
  np?: boolean; est?: boolean; dim?: boolean;
  /** badge: Vorbehalt, den der Callout selbst trägt (np/est) — ohne Klick lesbar */
  badge?: string;
};
// Alle Hardpoint-Ebenen sind verfügbar; standardmäßig sichtbar sind nur
// Komponenten + Bewaffnung, den Rest (Antrieb, Sonstiges) schaltet der Nutzer
// per Filter selbst zu — nichts wird künstlich entfernt.
const HOLO_GRP: Record<string, string> = {
  power: 'core', shield: 'core', cooler: 'core', quantum: 'core', radar: 'core',
  turret: 'arms', missile: 'arms', weapon: 'arms',
  thruster_main: 'prop', thruster_retro: 'prop', thruster_vtol: 'prop', thruster_mav: 'prop',
  fuel: 'other', countermeasure: 'other',
};
const HOLO_GRP_ORDER = ['core', 'arms', 'prop', 'other'] as const;
const HOLO_DEFAULT_ON = ['core', 'arms'];
// P-3 (16-01-PLAN.md Task 1, Variante C — gemessen gegen das ausgelieferte
// holodata gegengeprueft, 908 Schiff-Gruppen-Paare, 0 Abweichungen): diese
// Triebwerksarten umgehen unten den Stock-Loadout-Join und bekommen IMMER
// einen Marker, auch ohne Stock-Item. thruster_mav bleibt aussen vor, siehe
// Kommentar am Kopf dieses Abschnitts.
const HOLO_BYPASS_STOCK_JOIN = new Set(['thruster_main', 'thruster_retro', 'thruster_vtol']);
const gameMesh = (holoMeshesSnapshot as any).meshes?.[id] ?? null;
const gameHp = gameMesh ? ((shipHardpointsSnapshot as any).ships?.[id] ?? null) : null;
const hasHolo = !!(gameMesh && gameHp);

let holoData: {
  url: string | null; mesh: { c: number[]; s: number[] } | null; ax: number[] | null;
  ports: HoloPort[]; groups: readonly string[]; defaultOn: string[]; kinds: Record<string, string>;
  grpLabels: Record<string, string>; icons: Record<string, string>; loc: string; finder: string;
} | null = null;

if (hasHolo) {
  // Loadout-Pools (Name/Größe je Kategorie), von beiden Quellen geteilt
  const expand = (list: { name: string; size: number | null; count: number }[]) =>
    list.filter(realName).flatMap((it) => Array.from({ length: it.count }, () => it));
  const pools: Record<string, { name: string; size: number | null }[]> = {
    power: expand(d.components?.powerPlants ?? []),
    shield: expand(d.components?.shields ?? []),
    cooler: expand(d.components?.coolers ?? []),
    quantum: expand(d.components?.quantumDrives ?? []),
    radar: expand(d.components?.radars ?? []),
    missile: expand(d.missileRacks ?? []),
    turret: (d.turrets ?? []).flatMap((tu) => {
      const guns = tu.weapons.filter(realName);
      return Array.from({ length: tu.stations }, () => ({
        name: guns.length ? guns.map((w) => `${w.count}× ${w.name}`).join(', ') : tu.label,
        size: tu.sizes[0]?.size ?? null,
      }));
    }),
    weapon: (d.fixedWeapons ?? []).filter(realName).flatMap((w) =>
      Array.from({ length: w.count }, () => ({ name: w.name, size: null }))
    ),
  };
  // Gemischte Loadouts (mehrere VERSCHIEDENE Komponenten derselben Art):
  // Bone- und API-Reihenfolge sind unabhängig -> keine geratene 1:1-Zuordnung,
  // stattdessen ehrlich alle Namen am Marker zeigen.
  const mixedLabel: Record<string, string | null> = {};
  for (const [k, pool] of Object.entries(pools)) {
    const names = [...new Set(pool.map((it) => it.name))];
    mixedLabel[k] = names.length > 1 ? names.join(' / ') : null;
  }

  // Positionsquelle: das Spielmesh, die einzige verbliebene Quelle.
  let meshUrl: string | null = null;
  let meshBox: { c: number[]; s: number[] } | null = null;
  let srcPorts: { k: string; p: number[]; n?: string }[] = [];
  if (gameMesh && gameHp) {
    // ?v=<Content-Hash> aus dem Manifest: nginx cached /holo/ 1 Jahr — der
    // Buster laesst Patch-Re-Exporte sofort durchschlagen (vgl. holoViewerSrc)
    meshUrl = gameMesh.v ? `${gameMesh.url}?v=${gameMesh.v}` : gameMesh.url;
    const hull = gameHp.hull ?? gameHp.bbox; // cry-AABB
    // cry -> glTF: (x, z, -y) — feste Achsvertauschung, keine Kalibrierung
    meshBox = {
      c: [(hull[0][0] + hull[1][0]) / 2, (hull[0][2] + hull[1][2]) / 2, -((hull[0][1] + hull[1][1]) / 2)],
      s: [Math.abs(hull[1][0] - hull[0][0]), Math.abs(hull[1][2] - hull[0][2]), Math.abs(hull[1][1] - hull[0][1])],
    };
    srcPorts = (gameHp.hp as { k: string; p: number[]; n: string }[])
      .filter((h) => HOLO_GRP[h.k])
      .map((h) => ({ k: h.k, n: h.n, p: [h.p[0], h.p[2], -h.p[1]] }));
  }

  // Item-Finder-Anreicherung: Kategorie/Preis/Kauforte für einen Item-Namen
  const enrich = (name: string | null | undefined) => {
    const info = itemInfo(name);
    if (!info) return {};
    return { cat: info.cat, shops: info.shops, iid: info.id, ...(info.price != null ? { price: info.price } : {}) };
  };
  // Echtes Stock-Loadout aus dem DataCore: itemPortName -> verbautes Item.
  // itemPortName == Bone-Name -> exakter Join per Namen (keine Reihenfolge-
  // Raterei). Fehlt fuer ein Schiff der Stock-Loadout-Join, greift der
  // Reihenfolge-Fallback ueber die Pools (siehe unten).
  type StockItem = { name: string | null; size: number | null; cat: string; cls: string; count: number };
  const stock: Record<string, StockItem[]> | null =
    (gameMesh && gameHp) ? ((shipLoadoutsSnapshot as any).ships?.[id] ?? null) : null;

  // Marker -> Loadout joinen
  const holoPorts: HoloPort[] = [];
  const taken: Record<string, number> = {};
  const coreKindsSeen = new Set<string>(); // Kern-Arten, die einen echten Marker bekamen
  for (const hp of srcPorts) {
    const g = HOLO_GRP[hp.k];
    if (stock) {
      // DataCore-Pfad: Marker NUR, wenn der Bone ein echtes Stock-Item trägt —
      // AUSSER die Art umgeht den Join (P-3, HOLO_BYPASS_STOCK_JOIN oben).
      // Bones ohne Item UND ohne Bypass (Controller, Regen-Pools, Waffen-
      // schränke, Phantom-Bones geteilter Varianten-Geometrie) fallen weg —
      // kein namenloser/gestapelter Müll mehr.
      const items = hp.n ? stock[hp.n.toLowerCase()] : undefined;
      if ((!items || !items.length) && !HOLO_BYPASS_STOCK_JOIN.has(hp.k)) continue;
      if (g === 'core') coreKindsSeen.add(hp.k);
      if (items && items.length) {
        // Name aus den Spieldateien; fehlt die Lokalisierung (z.B. fest verbaute
        // Capital-Ship-Komponenten ohne Shop-Namen), auf das Art-Label ausweichen
        // statt den internen Klassennamen (COOL_AEGS_S04_…) zu zeigen.
        const label = items.map((it) => (it.count > 1 ? `${it.count}× ` : '') + (it.name || t(`holo.kind.${hp.k}` as any))).join(' / ');
        const sizes = new Set(items.map((it) => it.size));
        const single = items.length === 1 ? items[0] : null;
        holoPorts.push({
          k: hp.k, g, p: hp.p,
          label,
          size: sizes.size === 1 ? (items[0].size ?? null) : null,
          ...(single?.name ? enrich(single.name) : {}),
          ...(g === 'core' ? { lab: t(`holo.kind.${hp.k}` as any) } : {}),
        });
      } else {
        // Bypass-Fall: kein Stock-Item fuer diesen Triebwerks-Bone (erwartet —
        // Triebwerke sind Geometrie, kein Ausruestungsplatz). Marker traegt nur
        // die Art als Text, keine Item-Finder-Anreicherung (kein Item-Name).
        holoPorts.push({
          k: hp.k, g, p: hp.p,
          label: t(`holo.kind.${hp.k}` as any),
          size: null,
        });
      }
    } else {
      // Kein DataCore-Loadout fuer diesen Bone: alte Reihenfolge-Zuordnung als Fallback.
      const pool = pools[hp.k];
      const item = pool ? pool[(taken[hp.k] = (taken[hp.k] ?? 0) + 1) - 1] : undefined;
      const mixed = mixedLabel[hp.k];
      if (g === 'core') coreKindsSeen.add(hp.k);
      holoPorts.push({
        k: hp.k, g, p: hp.p,
        label: mixed ?? item?.name ?? null,
        size: mixed ? null : item?.size ?? null,
        ...(!mixed ? enrich(item?.name) : {}),
        ...(g === 'core' ? { lab: t(`holo.kind.${hp.k}` as any) } : {}),
      });
    }
  }
  // Kern-Komponente ganz ohne physisches Hardpoint -> schematisch mittig + Vermerk
  if (meshBox) {
    const mc = meshBox.c, ms = meshBox.s;
    let stackI = 0;
    for (const k of Object.keys(HOLO_GRP).filter((x) => HOLO_GRP[x] === 'core')) {
      const pool = pools[k] ?? [];
      if (!pool.length || coreKindsSeen.has(k)) continue;
      const off = (stackI++ - 1) * 0.08;
      holoPorts.push({
        k, g: 'core',
        p: [mc[0] + off * ms[0] * 0.3, mc[1], mc[2] + off * ms[2] * 0.3].map((x) => Math.round(x * 100) / 100),
        label: mixedLabel[k] ?? pool[0].name, size: mixedLabel[k] ? null : pool[0].size,
        ...(!mixedLabel[k] ? enrich(pool[0].name) : {}),
        lab: t(`holo.kind.${k}` as any),
        np: true, dim: true, badge: t('holo.badge.np' as any),
      });
    }
  }
  // Ko-lozierte Marker leicht auffächern: einige Schiffe legen mehrere echte
  // Komponenten auf EINEN Maschinenraum-Bone-Punkt (Spielgeometrie, z.B.
  // Hammerhead 7×). Ohne Versatz lägen Sprites + Leader exakt übereinander ->
  // kleiner Ring (leichte Helix) um den Originalpunkt, Radius an die Hülle
  // gekoppelt. Betrifft real nur ~5 Schiffe.
  if (meshBox) {
    const groups = new Map<string, HoloPort[]>();
    for (const p of holoPorts) {
      const key = p.p.map((x) => Math.round(x * 100) / 100).join(',');
      const arr = groups.get(key); if (arr) arr.push(p); else groups.set(key, [p]);
    }
    const r = Math.min(2.2, Math.max(0.35, Math.max(...meshBox.s) * 0.02));
    for (const grp of groups.values()) {
      if (grp.length < 2) continue;
      const c = [...grp[0].p];
      grp.forEach((p, i) => {
        const a = (i / grp.length) * Math.PI * 2;
        p.p = [
          c[0] + Math.cos(a) * r,
          c[1] + (i - (grp.length - 1) / 2) * r * 0.3,
          c[2] + Math.sin(a) * r,
        ].map((x) => Math.round(x * 1000) / 1000);
      });
    }
  }

  if (holoPorts.length) {
    const present = new Set(holoPorts.map((p2) => p2.g));
    holoData = {
      url: meshUrl,
      mesh: meshBox,
      // ax: gehoert zum Vertrag mit assets/holo-viewer.js (Achsvertauschung
      // fuer kalibrierte Fremdmeshes). Die einzige verbliebene Quelle ist das
      // Spielmesh, das keine eigene Kalibrierung braucht -> immer null.
      ax: null,
      ports: holoPorts,
      groups: HOLO_GRP_ORDER.filter((gr) => present.has(gr)),
      defaultOn: HOLO_DEFAULT_ON.filter((gr) => present.has(gr)),
      kinds: Object.fromEntries([...new Set(holoPorts.map((p2) => p2.k))].map((k) => [k, t(`holo.kind.${k}` as any)])),
      grpLabels: Object.fromEntries(HOLO_GRP_ORDER.map((g) => [g, t(`holo.grp.${g}` as any)])),
      icons: Object.fromEntries([...new Set(holoPorts.map((p2) => p2.k))].filter((k) => HOLO_ICON[k]).map((k) => [k, HOLO_ICON[k]])),
      loc,
      finder: L('/item-finder.html'),
    };
  }
}

// ---------- Systemabschnitte der Konsole (16-03-PLAN.md Task 1, SCHRITT 2) ----------
// Zaehlung + Gruppierung fuer den Gruppen-Zustand jedes Systemabschnitts.
// arms uebernimmt armStats/armament UNVERAENDERT (siehe Markup), core
// uebernimmt slots UNVERAENDERT — beide sind bereits vorhandene
// Aggregationen derselben Aussage und werden hier NICHT verdoppelt. prop
// und other bekommen dieselbe FORMEL wie armStats (Ports nach Bauteilart
// buendeln, Anzahl + t('holo.kind.<k>')), zum ersten Mal ausgeschrieben.
type SysKindCount = { k: string; label: string; n: number };
const sysKindCounts = (gr: string): SysKindCount[] => {
  const counts = new Map<string, number>();
  for (const p of holoData?.ports ?? []) {
    if (p.g !== gr) continue;
    counts.set(p.k, (counts.get(p.k) ?? 0) + 1);
  }
  return [...counts.entries()]
    .map(([k, n]) => ({ k, n, label: t(`holo.kind.${k}` as any) }))
    .sort((a, b) => b.n - a.n);
};
const sysPortCount = (gr: string): number => holoData?.ports.filter((p) => p.g === gr).length ?? 0;
// Portgruppen = die Gruppen MIT Markern auf der Buehne. Die Trennung von den
// Inhaltsgruppen (CONTENT_GROUPS_SOURCE, weiter unten) ist keine Kosmetik: nur
// fuer diese hier darf der Client viewer.setFilter() aufrufen.
const portGroups = holoData?.groups ?? [];

// Belastbarkeit der gezeigten Positionen — steuert die Herkunfts-Zeile unter dem
// Titel. Wenn KEIN Marker verortet ist (Schiffe ohne Hardpoints im Mesh bzw.
// conf:low), darf dort nicht "Positionen aus den Spieldateien" stehen.
const holoNp = holoData?.ports.filter((p) => p.np).length ?? 0;
const holoAllNp = !!holoData && holoData.ports.length > 0 && holoNp === holoData.ports.length;

const shipCode = d.manufacturer ?? d.makerCode ?? t('ship.code.ship');
// Kopf-Modi (Umschalter): Video (kuratiertes Commercial) · Bilder (Slideshow) · Holo (3D)
// holoAvail deckt sich mit der Bedingung, unter der das Holodata-Script unten ausgegeben wird.
const holoAvail = !!(holoData || holoUrl);
const hasGallery = gallery.length > 0;
const stageModeCount = (hasVideo ? 1 : 0) + (hasGallery ? 1 : 0) + (holoAvail ? 1 : 0);
// 16-04-PLAN.md Task 3, AENDERUNG 2 (16-UI-SPEC.md Detailvertrag Punkt 7/8):
// das Mesh ist IMMER der Standardmodus, sobald es fuer ein Schiff vorliegt --
// haengt nicht mehr an Video-/Bildverfuegbarkeit. Begruendung (Planungsnotizen
// dieses Plans): Erfolgskriterium 1 verlangt, dass man auf JEDER Schiffsseite
// ein System waehlt und am gerenderten Schiff sieht, wo es sitzt -- startete
// die Buehne im Videomodus, zeigte die Konsole beim ersten Blick ein Video
// statt das Schiff, und die Rail zeigte auf nichts. Der Umschalter
// Video/Bilder/3D BLEIBT bestehen (siehe .holo__toggle unten) -- das
// kuratierte Marketing-Video ist einen Klick entfernt, kein Datenverlust.
const defaultMode: 'video' | 'img' | 'holo' = holoAvail ? 'holo' : hasVideo ? 'video' : hasGallery ? 'img' : 'holo';
const metaDesc = t('ship.meta.desc')
  .replace('%name%', d.name)
  .replace('%maker%', d.manufacturer ?? t('ship.maker.unknown'));
// Alt-Texte: jede Galerie-Kachel benennt, WAS sie zeigt (A11y + Bilder-SEO) —
// Lacke mit Namen, Hero/Store-Bild generisch. Astro würde alt={''} als nacktes
// `alt` ohne Wert rendern, deshalb nie leer lassen.
const altView = t('ship.img.view').replace('%name%', d.name);
const altPaint = (paint: string) => t('ship.img.paint').replace('%name%', d.name).replace('%paint%', paint);

// Icon-Pfade (24×24, stroke)
const IC: Record<string, string> = {
  handel: 'M12 4a8 8 0 100 16 8 8 0 000-16z M14.8 9.2c-.9-.9-4.2-1.1-4.6.8-.4 2 4.9 1 4.5 3.1-.4 1.8-3.8 1.7-4.8.7 M12 6.6v1.6 M12 15.8v1.6',
  datenblatt: 'M7 3h7l4 4v14H7z M14 3v4h4 M10 12h6 M10 16h6',
  bewaffnung: 'M12 5a7 7 0 100 14 7 7 0 000-14z M12 3v4 M12 17v4 M3 12h4 M17 12h4',
  verteidigung: 'M12 3l7 3v6c0 4.4-2.9 7.6-7 9-4.1-1.4-7-4.6-7-9V6z',
  flug: 'M5 17a8 8 0 0114 0 M12 16l4.2-5.6 M12 16a1.4 1.4 0 100 .01',
  quantum: 'M12 9.4a2.6 2.6 0 100 5.2 2.6 2.6 0 000-5.2z M3.5 15.5C6 18 18 12 20.5 8.5 M3.5 8.5C6 6 18 12 20.5 15.5',
  kern: 'M8 8h8v8H8z M10 3v3 M14 3v3 M10 18v3 M14 18v3 M3 10h3 M3 14h3 M18 10h3 M18 14h3',
  versicherung: 'M12 3l7 3v6c0 4.4-2.9 7.6-7 9-4.1-1.4-7-4.6-7-9V6z M9 11.6l2.2 2.2 4-4.2',
  profil: 'M5 20v-8 M10 20V5 M15 20v-6 M20 20V9',
  paints: 'M12 3.5s5.6 6.8 5.6 10.4a5.6 5.6 0 11-11.2 0C6.4 10.3 12 3.5 12 3.5z',
  varianten: 'M6 6a2 2 0 100-.01 M6 18a2 2 0 100-.01 M18 8a2 2 0 100-.01 M6 8v8 M6 12c7 0 5-3.4 10-3.9',
  aehnlich: 'M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z',
  masse: 'M3 9h18v6H3z M7 9v3 M11 9v4 M15 9v3',
};

/* ---------- Inhaltsgruppen der Konsole (D-01, Nacharbeit zu Phase 16) ----------
   D-01 lautete "die Konsole ersetzt die Kapitel". Geliefert war bis hierher die
   Konsole ZUSAETZLICH: Bewaffnung und Bauteilliste waren in Welle 3 umgezogen,
   Handel, Rang, Technik und Kontext standen weiterhin als .sd__chapter darunter.
   Am gebauten dist/de/schiffe/anvl-carrack.html gemessen: Konsole 16.000
   Zeichen, Kapitelteil 61.800 — zwei Navigationen, zwei Layoutsprachen.

   Diese vier Gruppen sind KEINE Portgruppen: sie tragen keine Marker auf der
   Buehne. showGroup() darf fuer sie viewer.setFilter() deshalb NICHT aufrufen,
   sonst leert ein Klick auf "Handel" das Schiff. Der Client unterscheidet sie
   an cfg.groups (nur Portgruppen) — siehe Skript unten.

   Huelle und Klassen sind bewusst dieselben wie bei den Portgruppen
   (.holo__sys, data-g, id="sys-<id>"), damit das Umhaengen in die Auslesung
   ohne Sonderfall funktioniert.

   Die Codezeile jedes frueheren Kapitels (Quelle + Stand) zieht als
   .holo__sys-ct mit um: sie ist Herkunftsangabe, kein Schmuck. Reihenfolge
   folgt der frueheren Kapitelfolge — Technik, Handel, Rang, Kontext. */
/* `label` steht im Abschnittskopf, `rail` im Rail-Eintrag. Meist dasselbe —
   getrennt nur, wo der volle Titel die 220px-Spalte sprengt (gemessen:
   "Leistungsprofil" braucht 207px Eintrag bei 191px Platz, und als EIN Wort
   ohne Trennstelle kann es nicht umbrechen). Dieselbe Trennung fuehrte schon
   die abgeloeste Sprungleiste (ship.jump.* gegen ship.*.title). */
const CONTENT_GROUPS_SOURCE: {
  id: string; label: string; rail: string; icon: string; code: string; count: number; renders: boolean;
}[] = [
  {
    // Das Ausstattungs-Kapitel trug bewusst KEIN Icon: kein Pfad vertrat die
    // drei Themen als Ganzes (Kommentar an seiner alten Stelle). Die Rail
    // erzwingt nun eines je Eintrag. IC.datenblatt ist der Datenblatt-Bogen,
    // seit Phase 14 ungenutzt, und vertritt "technische Daten" als Ganzes —
    // IC.masse waere doppelt, das traegt schon die Unterrubrik "Masse & Fracht".
    id: 'spec', label: t('ship.ch.gear'), rail: t('ship.ch.gear'), icon: IC.datenblatt,
    code: `${t('ship.code.spec')} // ${shipCode}`,
    count: [gearDims, gearFlight, gearDefense].filter(Boolean).length,
    renders: hasGear,
  },
  {
    id: 'trade', label: t('ship.buy.title'), rail: t('ship.rail.trade'), icon: IC.handel,
    code: `${t('ship.code.trade')} // UEX · ${t('ship.asof')} ${pricesFetchedAt}`,
    count: (prices?.buy.length ?? 0) + (prices?.rent.length ?? 0),
    renders: true,
  },
  {
    id: 'rank', label: t('ship.profile.title'), rail: t('ship.rail.rank'), icon: IC.profil,
    code: `${t('ship.code.rank')} // ${t('ship.profile.rank')} (${vehiclesSnapshot.count} ${t('ship.unit.ships')})`,
    count: profile.length,
    renders: profile.length > 0,
  },
  {
    id: 'context', label: t('ship.ch.context'), rail: t('ship.ch.context'), icon: IC.versicherung,
    code: ctxCode,
    count: [
      viz.insurance.length > 0,
      paints.length > 0,
      variants.length > 0 || loaners.length > 0,
      spine.length > 0,
    ].filter(Boolean).length,
    renders: hasContext,
  },
];
const contentGroups = CONTENT_GROUPS_SOURCE.filter((g) => g.renders);
// Zugriff fuer die Kopfzeilen im Markup. Bewusst auf der UNGEFILTERTEN Liste:
// jeder Abschnitt steht ohnehin schon in seiner eigenen renders-Bedingung, und
// so kann der Zugriff nie undefined liefern.
const cgOf = (gid: string) => CONTENT_GROUPS_SOURCE.find((g) => g.id === gid)!;
---
<Layout
  title={`${d.name} — ${t('ship.title.suffix')} | VerseBase`}
  description={metaDesc}
  themeColor="#05070d"
  footer={true}
  translated={hasEn}
  ogImage={hero?.src}
  itemPage={{ modified: vehiclesSnapshot.fetchedAt }}
>
<style is:inline>
:root{
  --bg:#05070d;--bg-2:#0a0e18;--surface:#0f1524;--surface-2:#141c30;
  --accent:#2dd4ff;--accent-2:#6ea8ff;--gold:#d4af37;
  --text:#e8eefc;--muted:#8a99b8;--line:rgba(110,168,255,.16);
  --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;
  --maxw:1100px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f7fe;--bg-2:#e9eef9;--surface:#fdfdff;--surface-2:#eef2fc;--text:#1b1f29;--muted:#4e586c;--accent:#05657c;--accent-2:#0850ad;--gold:#685301;--ink:#ffffff;--accent-media:#2dd4ff;--accent-2-media:#6ea8ff;--line:rgba(43,125,148,.3)}






*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ic{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;vertical-align:-3px;margin-right:.5rem;flex:none}

/* ============ HANGAR-BÜHNE ============ */
/* Layout: Info links, interaktive Holo-Bühne rechts (Grid). Das Hologramm
   ist eingebettet (kein Popup-Toggle mehr) und lädt lazy beim Scrollen. */
/* SCHRITT 1 (16-03-PLAN.md Task 1): .holo muss mit den Systemabschnitten
   UND der Rail wachsen duerfen -- Hoehe und Beschnitt wandern deshalb auf
   .holo__wrap (die Buehne selbst, unten). Bleiben sie hier, schneidet
   .holo die neuen Abschnitte ab. */
.holo{position:relative;margin-top:56px;background:radial-gradient(120% 90% at 50% 8%,var(--media-void) 0%,var(--bg) 62%),var(--bg);
  border-bottom:1px solid var(--line);
  display:grid;grid-template-columns:1fr}
/* 16-05-PLAN.md (Kollisionsbehebung, 1280px): margin-top:56px reicht nur,
   solange keine Zurueck-Marke ueber der Buehne schwebt. Ist sie sichtbar
   (SiteNav.astro Zeile 947/949, --nav-h waechst von 68 auf 104/116px), lag
   die Marke bisher auf der ERSTEN RAIL-ZEILE ("KOMPONENTEN 8") -- vorher war
   das unbedenklich, weil an dieser Stelle nur Hintergrund/HUD-Text stand,
   inzwischen liegt dort ein klickbares Bedienelement. Zusatz exakt in Hoehe
   des --nav-h-Zuwachses (104-68=36px, 116-68=48px), nicht auf einen neuen
   Absolutwert geraten. */
:root:has(.snav__back:not([hidden])) .holo{margin-top:92px}
@media(max-width:860px){
  :root:has(.snav__back:not([hidden])) .holo{margin-top:104px}
}
/* 16-04-PLAN.md Task 1, SCHRITT 1 (16-UI-SPEC.md Detailvertrag Punkt 1):
   drei feste Grid-Spalten, Breiten UND Bruchkanten UNVERAENDERT aus dem
   UI-SPEC uebernommen (220px/320px/1100px/760px). Explizite Platzierung
   statt Dokumentreihenfolge, weil die Rail (nav.holo__rail) im Markup NACH
   der Buehne (.holo__wrap) steht -- D-02 verlangt genau diese
   Lesereihenfolge fuer den No-JS-Fall (erst das Schiff, dann die
   Sprungliste) -- aber optisch LINKS von ihr stehen muss.
   .holo__sys-Abschnitte (No-JS-Restbestand: bleiben Kind von .holo, bis ein
   Skript sie in die Auslesung verschiebt) spannen die volle Breite und
   stapeln sich als eigene Zeilen darunter, unabhaengig von der Spaltenzahl. */
/* ===== PHASE 17 „HANGAR": aus drei Spalten wird EIN RAUM ======================
   Bis hierher standen Rail (220px), Bühne (1fr) und Auslesung (320px)
   nebeneinander. Damit blieb der Bühne bei 1280px genau 740px, und die
   Beschriftungen im Raum hatten keine Randspalte, in die sie ausweichen
   konnten — sie lagen auf dem Rumpf (Sichtbefund 20.08.2026).

   Jetzt: die Bühne nimmt die volle Breite, die Rail liegt als Blende ÜBER
   ihrem unteren Rand, und die Auslesung wandert als Streifen DARUNTER.
   Die Lesereihenfolge im Markup bleibt unverändert (D-02: erst das Schiff,
   dann die Liste) — verschoben wird nur optisch, per Grid-Platzierung. */
.holo__wrap{grid-column:1/-1;grid-row:1;min-width:0}
.holo__rail{grid-column:1/-1;grid-row:1;min-width:0;align-self:start;z-index:6}
.holo__sys{grid-column:1/-1}
/* Die früheren Bruchkanten 1099px und 760px hingen ausschließlich am
   Drei-Spalten-Raster: sie schoben die Auslesung aus der dritten Spalte in
   eine eigene Zeile und die Rail unter die Bühne. Mit dem Raum (Phase 17)
   steht die Bühne auf JEDER Breite über die volle Breite, die Blende liegt in
   ihr, die Auslesung darunter — es gibt nichts mehr umzusortieren. Die
   Regelsätze sind deshalb ersatzlos entfallen und nicht etwa vergessen
   worden. */
.holo__grid{position:absolute;left:-24%;right:-24%;bottom:-4%;height:56%;pointer-events:none;
  transform:perspective(760px) rotateX(63deg);transform-origin:50% 100%;
  background:
    repeating-linear-gradient(90deg,rgba(45,212,255,.13) 0 1px,transparent 1px 44px),
    repeating-linear-gradient(0deg,rgba(45,212,255,.13) 0 1px,transparent 1px 44px);
  -webkit-mask-image:linear-gradient(0deg,rgba(0,0,0,.85),transparent 82%);
  mask-image:linear-gradient(0deg,rgba(0,0,0,.85),transparent 82%)}
.holo__pad{position:absolute;bottom:7%;left:62%;transform:translateX(-50%);width:min(42%,520px);height:5%;pointer-events:none;
  border-radius:50%;background:radial-gradient(50% 50% at 50% 50%,rgba(45,212,255,.4),rgba(45,212,255,.1) 55%,transparent 72%);
  filter:blur(5px);transition:opacity .5s}
.is-3d-active .holo__pad{background:radial-gradient(50% 50% at 50% 50%,rgba(45,212,255,.55),rgba(45,212,255,.16) 55%,transparent 72%)}
/* Vollbreite: Bühne randlos über die ganze Hero-Breite -> Modell mittig,
   groß, und bis zum Bildschirmrand verschiebbar. Titel liegt als Overlay auf. */
/* SCHRITT 1 (16-03-PLAN.md Task 1): traegt jetzt die feste Hoehe UND den
   Beschnitt, die vorher an .holo hingen (siehe Kommentar dort) -- die
   Buehne selbst bleibt dadurch unveraendert gross, waechst aber nicht mit
   der Rail/den Systemabschnitten darunter mit.
   16-04-PLAN.md Task 3 (Fuellgrad-Klinke haelt bei den NEUEN, schmaleren
   Buehnenbreiten): der urspruengliche Hoehenwert (540-760px, aus der Zeit
   VOR Rail+Auslesung, als .holo noch die volle Seitenbreite war) ergab nach
   Task 1 ein zu QUADRATISCHES Seitenverhaeltnis (z.B. 740x666 bei 1280px
   statt vorher 1280x666) -- fitCamera() (holo-viewer.js) haelt die
   VERTIKALE Sichtfeldweite konstant, ein schmaleres Seitenverhaeltnis gibt
   ihr deshalb WENIGER Zoom-Spielraum, bevor die laengere Kante (bei einem
   elongierten Schiff meist die Breite) am harten Bildrand ankommt --
   gemessen brach die Carrack/Ironclad-Fuellgrad-Klinke dadurch NEU bei
   1440/1280/1100/860px, die bei Welle 1 dort noch hielt (nur 860/414/360
   fielen damals durch). Fix: die Hoehe schrumpft mit der (jetzt schmaleren)
   Buehnenbreite mit, um ein grosszuegigeres Seitenverhaeltnis
   wiederherzustellen -- am gerenderten Bildpunkt gegengeprueft (siehe
   16-04-SUMMARY.md), nicht geschaetzt. */
/* D-01-Nacharbeit 20.08.2026, NUR die Untergrenze: 380px -> 440px.
   Die Rail traegt seit D-01 acht Eintraege statt vier und misst ungekuerzt
   gemessene 434px. Blieb die Untergrenze bei 380, ragte sie als Stufe unter
   der Buehne heraus — genau der Zustand bei 1280x720 (Rail 434, Buehne 380).
   Die Obergrenze 450px bleibt unangetastet, und zwar aus einem gemessenen
   Grund:

   ⚠ SCHRITT 3 DER UEBERGABE ("der Konsole die ganze Flaeche geben") IST HIER
   NICHT UMGESETZT — er widerspricht P-1 aus Welle 1. Einmal gebaut und
   gemessen: mit height:calc(100dvh - 182px) misst die Buehne bei 1440x900
   870x718 Bildpunkte, das Schiff spannt darin 836x392, und
   scripts/probes/schiffskonsole-messung.mjs meldet
   [d-fuellgrad] FEHLT — Ist 54,6%, Soll >=70%.
   Ursache: P-1 misst den Fuellgrad entlang der KUERZEREN Buehnenkante. Wird
   die Buehne hoeher als breit, ist das die Hoehe — und ein 2,13:1 flaches
   Schiff wie die Carrack kann sie nie zu 70% fuellen, egal wie gross es
   skaliert. Bei 1280x900 bestand die Messung mit 93,1% nur, weil die Hoehe
   (718) zufaellig acht Bildpunkte GROESSER war als die Breite (710); bei
   1280x880 waere auch sie durchgefallen. Der Widerspruch ist strukturell,
   nicht kosmetisch, und die Aufloesung (Buehne P-1-treu lassen und nur
   Rail/Auslesung die volle Hoehe geben — oder P-1 neu fassen) ist ein
   Sichturteil fuer den Betreiber, kein Skriptbefund. Als benannter Punkt in
   .planning/WINDOWS.md. */
/* PHASE 17: der Raum bekommt das Fenster.
   Beide Abzugswerte sind gemessen, nicht geschätzt: die Konsole beginnt bei
   y=92 (margin-top 56px plus sichtbare Zurück-Marke) und die Kennwerte-Leiste
   darunter ist 90px hoch — 100dvh − 182px lässt Raum UND Kennwerte genau auf
   dem ersten Bildschirm enden.

   ⚠ Das reißt P-1 in seiner alten Fassung, und zwar unvermeidbar: P-1 misst
   den Füllgrad entlang der KÜRZEREN Bühnenkante; wird die Bühne höher als
   breit, ist das die Höhe, und ein 2,13:1 flaches Schiff kann sie nie zu 70 %
   füllen. P-1 ist dafür aber auch nie gedacht gewesen — der Anlass aus Welle 1
   war „die Marker sind 2–3px und nicht auffindbar", gemessen wurde ersatzweise
   der Füllgrad. Diese Vertretung ist mit den bildschirmfesten Markern
   (holo-viewer.js, konstante Zielgröße in Bildpunkten) gegenstandslos
   geworden: Auffindbarkeit hängt nicht mehr an der Schiffsgröße. Die Sonde
   misst seither beides getrennt — Rahmung an der LÄNGEREN Kante,
   Auffindbarkeit an der gezeichneten Marke. */
/* Zweite Grenze, nur fuer HOCHFORMATIGE Fenster: der Raum darf nicht viel
   hoeher werden als er breit ist. Gemessen bei 768x1024 stand das Schiff in
   einer 768x820-Buehne und fuellte davon 92,9 % der BREITE, aber nur rund ein
   Drittel der Hoehe — darueber und darunter blieb je ein leeres Band. Das
   Schiff wird durch mehr Hoehe nicht groesser (es ist breitenbegrenzt), nur
   die Leere. 0,72 x Breite haelt am Schreibtisch nichts auf: bei 1280x900
   waeren das 922px gegen die 718px, die die Fensterhoehe ohnehin vorgibt. */
.holo__wrap{position:relative;z-index:2;width:100%;overflow:hidden;
  height:clamp(460px,min(calc(100vh - 182px),calc(100vw * 0.72)),820px);
  height:clamp(460px,min(calc(100dvh - 182px),calc(100vw * 0.72)),820px)}
/* min-height war 360px (aeltere Vorsichtsgrenze aus der Zeit vor dieser
   Klinken-Reparatur) -- blockierte bei 1100px (Buehnenbreite 560px) die
   oben noetige kleinere Hoehe. 160px bleibt als Schutz gegen eine
   entartete Buehne bei extremen Randfaellen stehen, bindet bei keiner der
   hier gemessenen Breiten. */
.holo__stage{position:absolute;inset:0;min-height:160px}
/* Bilder fuellen die Buehne randlos wie das Video (cover statt contain) —
   User-Feedback "Bild nicht ueber die ganze Breite". Volle Ansichten ohne
   Beschnitt liefert weiterhin die Galerie-Sektion darunter. */
.holo__ship{position:absolute;inset:0;display:grid;grid-template:100%/100%;place-items:center;min-height:0}
.holo__ship img{width:100%;height:100%;object-fit:cover;transition:opacity .6s}
.holo__3d{position:absolute;inset:0;opacity:0;pointer-events:none;cursor:grab;transition:opacity .6s}
.holo__3d:active{cursor:grabbing}
.holo__stage.is-3d .holo__ship img{opacity:0}
.holo__stage.is-3d .holo__3d{opacity:1;pointer-events:auto}
.holo__status{position:absolute;left:50%;bottom:12%;transform:translateX(-50%);z-index:5;white-space:nowrap;
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-8);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--accent)}
/* Status (Lade-%/Fehler) nur zeigen, solange geladen wird oder 3D aktiv ist —
   ein stiller Auto-Start-Fehlschlag darf das Foto nicht dauerhaft überlagern */
.holo__stage:not(.is-3d):not(.is-loading) .holo__status{display:none}
/* .holo__activate/#holoact (16-04-PLAN.md Task 3, D-04) sind ERSATZLOS
   ENTFERNT -- der Knopf war bereits vor dieser Welle inert (hidden,
   deferred-items.md), und ein Ladeausloeser per Knopf widerspricht D-04
   ohnehin ("wenn das Schiff die Navigation IST, darf es nicht hinter einem
   Knopf liegen"). Das Laden loest jetzt ausschliesslich der
   IntersectionObserver weiter unten aus. */
/* ⚠ bottom war 2 % — seit die Blende (Phase 17) am unteren Bühnenrand liegt,
   lag die Hinweiszeile darunter und wurde von ihr verdeckt (gemessen: auf
   ALLEN vier Desktop-Breiten überlappt). Fester Abstand statt Prozent: die
   Blende ist ~46px hoch plus 1,15rem Abstand, das sind rund 67px — 84px lässt
   Luft, ohne dass die Zeile in die Bühnenmitte rutscht. */
/* ⚠ Stand mittig (left:50%) und damit GENAU im hellsten Teil des
   Projektorstrahls — die Zeile war dort am Bildpunkt nicht mehr zu lesen. Sie
   beschreibt ohnehin die Bedienung der Bühne und gehört zu deren Umschalter:
   rechts, unmittelbar über ihm. Unter 760px rückt sie zurück in die Mitte,
   weil der Umschalter dort die volle Breite nimmt. */
.holo__hintline{position:absolute;right:clamp(1rem,3vw,2.5rem);bottom:106px;z-index:4;pointer-events:none;white-space:nowrap;text-align:right;
  font-family:var(--font-ui);font-weight:600;font-size:var(--fs-4);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted);opacity:0;transition:opacity .6s}
.holo__stage.is-3d .holo__hintline{opacity:.75}
/* ===== Bilder-Slideshow: alle Slides liegen im selben Grid-Feld, langsames Crossfade ===== */
.holo__ship img{opacity:0;transition:opacity 1.2s ease}
.holo__ship img.is-active{opacity:1}
/* Bilder-Backdrop im Video-Modus DAUERHAFT sichtbar (kein opacity:0): der
   Bilder-Layer ist der "Boden", der strukturell nie schwarz ist. Das Video
   liegt darueber und DECKT das Bild mit echten Pixeln, sobald es rendert; tut
   es das nicht (Autoplay-Verzoegerung, Stall, Style-Invalidierungs-Quirk bei
   is-playing), scheint das Bild durch die transparente Video-Box durch statt
   Schwarz. Nur is-3d blendet die Bilder aus. */
.holo__stage.is-3d .holo__ship img{opacity:0}
/* dezente Slide-Zähler-Punkte unten */
.holo__dots{position:absolute;left:50%;bottom:2.4%;transform:translateX(-50%);z-index:5;display:flex;gap:.4rem;pointer-events:none;opacity:0;transition:opacity .4s}
.holo__stage:not(.is-video):not(.is-3d) .holo__dots{opacity:.9}
.holo__dots i{width:6px;height:6px;border-radius:50%;background:var(--muted);opacity:.4;transition:opacity var(--dur-slow) var(--ease-ui),background var(--dur-slow) var(--ease-ui)}
.holo__dots i.on{background:var(--accent);opacity:1}
/* ===== Selbst-gehostetes Loop-Video (Basher) ===== */
/* Randloses <video> (cover) mit eigenem poster (Schiffsbild) — kein Player-
   Chrome, kein Start-Icon. Nur im Video-Modus sichtbar; poster deckt bis zum
   ersten Frame, der Bild-Boden dahinter fängt einen Ladefehler auf -> nie
   schwarz. Kein is-playing nötig: das <video> zeigt selbst poster->Frame. */
.holo__localvid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:5;
  opacity:0;pointer-events:none;transition:opacity .5s;background:transparent}
.holo__stage.is-video .holo__localvid{opacity:1}
/* ===== Video-Layer (Commercial): Facade -> YouTube-Embed on demand ===== */
/* Video randlos bis zum Bildschirmrand (Hero ist full-bleed). Die Ebene wird
   erst mit is-playing sichtbar — bis dahin traegt der Bilder-Backdrop. */
.holo__video{position:absolute;inset:0;z-index:5;opacity:0;pointer-events:none;transition:opacity .5s;overflow:hidden}
.holo__stage.is-video.is-playing .holo__video{opacity:1;pointer-events:auto}
/* Poster deckt den Player anfangs voll ab (Schiffsbild) und blendet erst kurz
   NACH Abspielstart aus -> YouTubes kurzes Pause/Play-Symbol beim Start bleibt
   darunter verborgen. z-index über iframe UND Schutzschicht. */
.holo__videoposter{position:absolute;inset:0;z-index:6;background:var(--media-void) center/cover no-repeat;opacity:1;transition:opacity .9s ease}
.holo__videoposter::after{content:"";position:absolute;inset:0;background:radial-gradient(65% 65% at 50% 42%,transparent,var(--scrim-4))}
.holo__playertarget{position:absolute;inset:0;width:100%;height:100%;z-index:2}
/* Videobild FÜLLT den Hero (cover, keine schwarzen Balken): 16:9-iframe so
   groß, dass es Breite UND Höhe deckt, zentriert, Überstand wird geclippt */
.holo__video iframe{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  --hh:clamp(540px,74vh,760px);
  width:max(100vw,calc(var(--hh) * 16 / 9));
  height:max(calc(100vw * 9 / 16),var(--hh));
  border:0;background:var(--media-void)}
/* Schutzschicht: fängt Hover/Klick ab -> keine YouTube-Leiste/-Chrome sichtbar,
   wirkt wie ein natives Hintergrund-Video (bei reduce-motion per JS deaktiviert) */
.holo__videoshield{position:absolute;inset:0;z-index:4;cursor:default}
@media(prefers-reduced-motion:reduce){.holo__ship img{transition:none}}
/* ===== Rail — reine Anker-Liste, ersetzt den schwebenden Ebenen-Kasten =====
   SCHRITT 3 (16-03-PLAN.md Task 1): funktioniert vollstaendig ohne Skript,
   exakt das Muster von .sd__jump (Kapitel-Sprungleiste, Phase 14) — bare
   <a>, Styling ausschliesslich ueber den Nachfahren-Selektor. Farbzuordnung
   je Gruppe (--gc) UNVERAENDERT aus dem fruehereren .holo__layer[data-g]
   uebernommen — keine neue Farbe.
   Seit 16-04-PLAN.md Task 1 ist .holo__rail die erste Grid-Spalte (220px,
   siehe .holo-Basisregel oben) — flex-direction:column macht daraus
   verlaesslich eine SENKRECHTE Liste (bei nur vier kurzen Labels wuerde
   flex-wrap allein zwar meist ebenfalls umbrechen, aber nicht garantiert).
   Bei <=760px (D-03) wird daraus wieder eine WAAGERECHTE Chip-Reihe unter
   der Buehne — siehe Medienabfrage weiter unten, die flex-direction
   zurueck auf row stellt. */
/* Blende (Phase 17): waagerecht, mittig, ÜBER dem unteren Bühnenrand — sie
   schaltet Ebenen um, sie führt nicht weg. Deshalb keine eigene Spalte mehr,
   keine trennende Kante, sondern eine schwebende Leiste auf dunklem Glas:
   sie gehört zum Raum, nicht zum Seitenrahmen. */
/* Breite gemessen, nicht geschätzt: mit den ursprünglichen Werten brauchten
   die acht Einträge 1315px und passten NUR bei 1440 — bei 1280 lief der
   letzte („Umfeld") aus dem Bild. Enger gesetzt sind es rund 1000px; darunter
   bricht die Leiste in eine zweite Reihe statt seitwärts wegzuscrollen, denn
   ein Eintrag, den man erst scrollen muss, ist in einer Blende unsichtbar. */
.holo__rail{position:relative;z-index:6;display:flex;flex-direction:row;flex-wrap:wrap;gap:0;
  /* OBEN, nicht unten: der untere Bühnenrand trägt bereits Titelblock,
     Merken-Knopf, Hinweiszeile und Modus-Umschalter — dort gemessen kollidiert
     die Blende mit allen vieren. Der obere Rand trägt nur die Herkunftszeile
     und die Maßangabe und hat Platz. Als Registerleiste am Kopf liest sie sich
     ohnehin eher als Ebenenwahl denn als Fußnavigation. */
  justify-self:center;justify-content:center;margin-top:3.1rem;
  max-width:min(calc(100% - 1.5rem),1240px);
  /* KEIN Kasten. Ein umrandetes Feld am Kopf der Bühne schneidet den Rumpf an
     (Sichtbefund: die Nase der Carrack lag hinter der Kastenkante und las sich
     als Beschnitt). Eine Leiste ohne Rahmen, nur mit Grundlinie, schwebt über
     dem Hologramm statt es zu zerteilen — und ist die Form, die ein
     Visier-Umschalter ohnehin hat. */
  background:none;border:0;box-shadow:inset 0 -1px 0 0 color-mix(in srgb,var(--accent) 22%,transparent);
  /* ⚠ Die Leiste liegt ÜBER der Bühne. Ihr Kasten fing damit Zeigerereignisse
     auch dort ab, wo sie durchsichtig ist — ein Marker unter der Leiste war
     nicht mehr anzufassen (gemessen an argo-csv-cargo/414: Marker[0] lag bei
     y=181, die Leiste bei 144–190, der Kasten blieb leer). Nur die Felder
     selbst nehmen Zeiger an, die Zwischenräume lassen durch. */
  pointer-events:none}
.holo__rail a{pointer-events:auto}
/* Ein Eintrag der Blende: keine eigene Kachel mehr, sondern ein Feld in einer
   durchgehenden Leiste — getrennt nur durch eine Haarlinie, markiert durch
   eine Unterkante in der Gruppenfarbe. Das ist die Form eines Visier-Umschalters
   und nicht die einer Navigationsliste. */
/* ⚠ Die Felder trennte eine border-left, mit :first-child als Ausnahme. Das
   haelt nur in EINER Reihe: bei 768px bricht die Leiste um, und die Trennlinie
   stand als verirrter Strich links am ersten Feld der zweiten Reihe (am Bild
   gefunden). Ein Abstand bricht sauber um, eine Kante nicht. */
.holo__rail a{--gc:var(--accent);display:inline-flex;align-items:center;gap:.45rem;flex:none;
  border:0;margin:1px;
  background:color-mix(in srgb,var(--media-void) 62%,transparent);backdrop-filter:blur(7px);
  padding:.54rem .62rem;box-shadow:inset 0 -2px 0 0 transparent;
  text-shadow:0 1px 4px var(--on-media-shadow);
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-10);text-transform:uppercase;color:var(--on-media-dim);
  transition:color var(--dur-fast) var(--ease-ui),box-shadow var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui)}
.holo__rail a:hover,.holo__rail a:focus-visible{color:var(--on-media);background:color-mix(in srgb,var(--accent) 8%,transparent)}
.holo__rail a[aria-current="true"]{color:var(--on-media);background:color-mix(in srgb,var(--gc) 12%,transparent);
  box-shadow:inset 0 -2px 0 0 var(--gc)}
/* Zäsur zwischen den beiden Arten von Einträgen (siehe Markup): ein Abstand
   plus eine Haarlinie. Bewusst KEINE zweite Akzentfarbe — die Blende führt
   ohnehin schon vier Gruppenfarben, eine fünfte Bedeutungsebene in Farbe wäre
   nicht mehr lesbar. Bricht die Leiste um, verschwindet die Linie mit ihr;
   der Abstand allein trägt die Aussage dann weiter. */
.holo__rail a.is-schnitt{margin-left:1.15rem;position:relative}
.holo__rail a.is-schnitt::before{content:"";position:absolute;left:-.62rem;top:20%;bottom:20%;
  width:1px;background:color-mix(in srgb,var(--accent) 26%,transparent)}
/* Die Inhaltsgruppen tragen ein leiseres Zählwerk: ihre Zahl ist eine
   Abschnittszahl, keine Markerzahl am Rumpf. */
.holo__rail a[data-kind="inhalt"] .holo__rail-ct{color:var(--on-media-dim);opacity:.8}
.holo__rail a[data-kind="inhalt"][aria-current="true"] .holo__rail-ct{color:var(--gc);opacity:1}
.holo__rail a[data-g="arms"]{--gc:var(--gold)}
.holo__rail a[data-g="prop"]{--gc:var(--accent-2)}
.holo__rail a[data-g="other"]{--gc:#a78bfa}
.holo__rail-ic{width:16px;height:16px;flex:none;stroke:var(--gc);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
/* D-01-Nacharbeit 20.08.2026: white-space:nowrap stand hier, solange die Rail
   VIER kurze Gruppennamen trug. Mit acht Eintraegen — darunter "Performance
   profile" und "Buy in the 'verse" — zwang nowrap die Mindestbreite eines
   Eintrags auf gemessene 245px, waehrend die 220px-Spalte nur 191px Inhalt
   bot: die Kaesten liefen 39px in die Buehne hinein und deckten dort das "H"
   von HANGAR zu (Sichtbefund am englischen Bildschirmfoto; Deutsch lief mit
   2px ebenfalls ueber, nur unauffaellig). Zweisprachig heisst zweimal
   gemessen — eine Spaltenbreite, die nur fuer die kuerzere Sprache reicht,
   ist keine.
   Umbruch erlaubt (an der Leerstelle, NICHT im Wort: kein break-word, sonst
   entstuende dasselbe SCHILDGENERA|TOREN-Problem in der Rail), und die Spalte
   waechst von 220 auf 250px. Beides zusammen, weil keines allein reicht:
   Umbruch loest EN ("Performance"/"profile"), die Spaltenbreite loest das
   deutsche Einzelwort "Leistungsprofil", das nirgends umbrechen kann.

   ⚠ Die 30px kommen NICHT von der Buehne, sondern aus der Auslesung
   (320 -> 290px, Basisregel oben). Erster Versuch nahm sie der Buehne — und
   riss damit P-1: bei 1280 fiel der Fuellgrad auf gemessene 69,7% (Klinke
   70%), weil die Buehne von 740 auf 710px schrumpfte und das Schiff mit ihr.
   Drei Zehntel Prozent, aber eine Klinke ist eine Klinke. Mit 290px steht die
   Buehne wieder auf exakt ihren alten Breiten (1440:900, 1280:740, 1100:560),
   und die Auslesung hat trotzdem Luft: seit die Bauteilkarten einspaltig
   stehen, braucht das laengste Label 144px von rund 248 verfuegbaren. */
/* Waagerechte Blende: die Beschriftung bleibt einzeilig. Der Umbruch war die
   Antwort auf eine 220px-SPALTE, und die gibt es seit Phase 17 nicht mehr —
   in einer Leiste würde er die Höhe treiben, ohne Platz zu sparen. Die kurzen
   Rail-Beschriftungen (ship.rail.*) bleiben trotzdem: sie halten die Leiste
   auch bei acht Einträgen unter der Fensterbreite. */
.holo__rail-lb{white-space:nowrap}
/* 16-05-PLAN.md Task 2: die Mischung war 80% --gc/20% --muted -- fuer die
   Gruppe "Antrieb" (--accent-2, Stahlblau) im dunklen Farbmodus reichte das
   nicht: gemessen 4,43:1 gegen die 4,5:1-Marke (argo-atls, einziges
   Pruefschiff mit NUR dieser Gruppe in der Rail, dadurch bislang von keiner
   Messung getroffen). Anheben auf 95% brachte nur 4,54:1 -- kaum Reserve,
   die letzten Prozent Beimischung tragen fast nichts mehr zur Helligkeit
   bei. Reine --gc-Farbe (kein Mix mehr) statt eines weiteren Prozentwerts:
   dieselbe Farbe, die auch Icon und Rahmen der Gruppe schon tragen (siehe
   .holo__rail-ic direkt darueber), 4,60:1 im dunklen Modus gemessen (0,10
   Reserve statt einer Punktlandung bei exakt der Marke). Kein zweiter, gruppenspezifischer Wert -- gilt fuer
   alle vier Gruppen gleich, die drei anderen lagen ohnehin komfortabel
   darueber und bleiben es. */
.holo__rail-ct{font-variant-numeric:tabular-nums;color:var(--gc);
  background:color-mix(in srgb,var(--gc) 16%,transparent);padding:.08rem .4rem;min-width:1.4rem;text-align:center}

/* Dauerhafte Komponenten-Beschriftungen: entzerrte HUD-Callouts. Gestapelt als
   Leader-Linien (unten) · Text-Chips (Mitte) · Positions-Knoten (oben) — so
   verdeckt kein Chip je den Punkt, der das Bauteil markiert. */
.holo-lbllayer{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:4}
.holo-leaders,.holo-nodes{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
/* Leader müssen auf dem HELLEN Hologramm UND im dunklen Raum lesbar sein ->
   heller Strich mit dunklem Halo (Kontrast überall) + Cyan-Glow. */
.holo-leaders line{stroke:var(--accent);stroke-width:1.5;filter:drop-shadow(0 0 1.5px var(--on-media-shadow)) drop-shadow(0 0 4px color-mix(in srgb,var(--accent) 60%,transparent));
  transition:stroke var(--dur-fast) var(--ease-ui),stroke-width var(--dur-fast) var(--ease-ui)}
.holo-leaders line.is-active{stroke:var(--on-media);stroke-width:2.2}
/* Knoten = exakter Bauteil-Punkt. Muss auf dem hellen, leuchtenden Hologramm
   ablesbar bleiben -> weißer Kern + kräftiger dunkler Ring (Kontrast) + WEISSER
   Glow (Cyan-Glow ginge im Cyan-Holo unter) + harte Dunkelkante. Liegt über den
   Chips -> immer sichtbar. */
.holo-nodes circle{fill:var(--on-media);stroke:var(--media-void);stroke-width:2.2;paint-order:stroke;filter:drop-shadow(0 0 1.5px var(--on-media-shadow)) drop-shadow(0 0 5px rgba(216,246,255,.95));transition:r var(--dur-fast) var(--ease-ui)}
/* Der aktive Hardpoint-Marker liegt auf der dunklen Holo-Ansicht: dunkler
   Saum zur Abgrenzung, heller Schein darüber — in beiden Modi gleich. */
.holo-nodes circle.is-active{stroke:var(--accent-media);
  filter:drop-shadow(0 0 2px var(--on-media-shadow)) drop-shadow(0 0 8px var(--on-media))}
.holo-lbl{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--on-media-dim);
  padding:.22rem .5rem .22rem .62rem;background:linear-gradient(180deg,var(--scrim-6),var(--scrim-6));
  border:1px solid color-mix(in srgb,var(--accent) 34%,transparent);border-left:2px solid var(--accent);box-shadow:0 4px 16px var(--on-media-shadow),inset 0 0 14px color-mix(in srgb,var(--accent) 9%,transparent);
  backdrop-filter:blur(4px);text-shadow:0 1px 4px var(--on-media-shadow);
  clip-path:polygon(0 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%);
  transition:border-color var(--dur-fast) var(--ease-ui),box-shadow var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui);will-change:left,top}
.holo-lbl.is-active{border-color:var(--accent);color:var(--on-media);box-shadow:0 4px 18px var(--on-media-shadow),0 0 16px color-mix(in srgb,var(--accent) 42%,transparent),inset 0 0 14px color-mix(in srgb,var(--accent) 14%,transparent)}
/* --- Dauer-Beschriftung im Raum (Phase 17 „Hangar") ---------------------------
   Der Art-Vertreter steht STAENDIG da (höchstens fünf gleichzeitig, gemessen
   über alle 227 Schiffe). Er darf deshalb nicht so laut sein wie der Callout,
   den man selbst aufgerufen hat — sonst gewinnt der Dauerzustand gegen die
   eigene Handlung, und genau das war die Ursache der alten Label-Leiter.
   Leiser: kein Rahmen ringsum, nur die Akzentkante links; Fläche flacher;
   kein Schein. Der aktive Kasten (.is-active) bleibt unverändert laut und
   sticht dadurch heraus. */
.holo-lbl.is-art{border-color:transparent;border-left-color:color-mix(in srgb,var(--accent) 70%,transparent);
  background:linear-gradient(180deg,var(--scrim-4),var(--scrim-4));
  box-shadow:none;color:var(--on-media-dim)}
.holo-lbl.is-art.is-active{border-color:var(--accent)}

/* --- Vorbehalt am Callout selbst ---------------------------------------------
   Ein normaler Chip behauptet "Bauteil sitzt HIER". Zwei Abstufungen, bewusst
   NICHT gleich laut — sonst stumpft die laute ab:

   is-np  (Bauteil hat gar keinen Einbauort im Mesh, Marker frei erfunden):
     Gold + gestrichelt + ausgeschriebenes Badge. Selten (24 Schiffe) und die
     einzige Stelle, an der Gold "diese Position ist keine Messung" bedeutet.
   is-est (echter Hardpoint, nur ungefähr auf ein Fremdmesh gemappt):
     bleibt Cyan (es sind echte Daten), nur gestrichelt + hohler Knoten. Betrifft
     83 Schiffe komplett — ein Badge an jedem Chip wäre Lärm, kein Signal. */
.holo-lbl.is-np{border-style:dashed;
  border-color:color-mix(in srgb,var(--gold) 46%,transparent);
  border-left:2px dashed var(--gold);color:#f6e7c4;box-shadow:0 4px 16px var(--on-media-shadow),inset 0 0 14px color-mix(in srgb,var(--gold) 8%,transparent)}
.holo-lbl.is-np.is-active{border-color:var(--gold);color:var(--on-media-dim);box-shadow:0 4px 18px var(--on-media-shadow),0 0 16px color-mix(in srgb,var(--gold) 40%,transparent),inset 0 0 14px color-mix(in srgb,var(--gold) 13%,transparent)}
.holo-lbl.is-est{border-style:dashed;border-left:2px dashed color-mix(in srgb,var(--accent) 75%,transparent)}
.holo-lbl__b{display:inline-block;margin-left:.2rem;padding:0 .3rem;font-style:normal;font-size:.86em;
  font-weight:800;letter-spacing:var(--ls-9);color:var(--ink-media);background:var(--gold);border-radius:2px;vertical-align:baseline}
/* Leader/Knoten tragen denselben Vorbehalt: gestrichelte Linie (keine feste
   Zuordnung) und ein HOHLER Knoten — der gefüllte Punkt bleibt der exakten
   Position vorbehalten. */
.holo-leaders line.is-np{stroke:var(--gold);stroke-dasharray:5 5;stroke-width:1.4;filter:drop-shadow(0 0 1.5px var(--on-media-shadow)) drop-shadow(0 0 4px color-mix(in srgb,var(--gold) 55%,transparent))}
.holo-leaders line.is-np.is-active{stroke:#ffe9a8;stroke-width:2}
.holo-leaders line.is-est{stroke-dasharray:5 5}
.holo-nodes circle.is-np{fill:none;stroke:var(--gold);stroke-width:2.4;filter:drop-shadow(0 0 1.5px var(--on-media-shadow)) drop-shadow(0 0 5px color-mix(in srgb,var(--gold) 75%,transparent))}
.holo-nodes circle.is-np.is-active{stroke:#ffe9a8;filter:drop-shadow(0 0 2px var(--on-media-shadow)) drop-shadow(0 0 8px var(--gold))}
.holo-nodes circle.is-est{fill:none;stroke:#dff6ff;stroke-width:2.2}

/* ===== Komponenten-Detail-Karte (Bord-MFD, gruppenfarbig) =====
   16-04-PLAN.md Task 2 (16-UI-SPEC.md Detailvertrag Punkt 4): der
   Einzel-Zustand der Auslesung. Verliert seine absolute Overlay-Position
   und wird per appendChild (Skriptpfad, wie die Systemabschnitte) zum
   normalen Block-Kind von .holo__readout -- position/right/top/z-index/
   width sind deshalb entfallen (die Breite kommt jetzt von der Grid-Spalte
   selbst). Optik (Rahmenoberkante/Eck-Klammer/Scanlines/Farbzuordnung je
   Gruppe) UNVERAENDERT. */
/* Detailkarte IM RAUM (Phase 17): bleibt sie Kind der Bühne, schwebt sie als
   Glaskarte am rechten Rand — dort, wo bei einem querformatigen Schiff am
   wenigsten Rumpf liegt. Der Selektor greift NUR, solange die Karte in .holo
   steht; auf schmalen Geräten hängt das Skript sie in die Auslesung um, und
   dann gilt wieder die Blockform darunter. */
.holo .holo__panel{position:absolute;z-index:7;right:clamp(1rem,2.4vw,2rem);top:50%;
  transform:translateY(-50%);width:min(340px,34%);max-height:calc(100% - 7rem);overflow:auto}
.holo .holo__panel[hidden]{display:none}
.holo__panel{--gc:var(--accent);position:relative;background:linear-gradient(180deg,var(--scrim-6),var(--scrim-6));backdrop-filter:blur(8px);
  border:1px solid color-mix(in srgb,var(--gc) 42%,transparent);box-shadow:0 14px 44px var(--on-media-shadow),0 0 26px color-mix(in srgb,var(--gc) 14%,transparent);
  clip-path:polygon(0 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%)}
.holo__panel[data-g="arms"]{--gc:var(--gold)}
.holo__panel[data-g="prop"]{--gc:var(--accent-2)}
.holo__panel[data-g="other"]{--gc:#a78bfa}
.holo__panel .hp__head{position:relative;padding:.62rem .8rem .6rem;border-top:2px solid var(--gc);
  background:linear-gradient(180deg,color-mix(in srgb,var(--gc) 16%,transparent),transparent)}
.holo__panel .hp__eyebrow{font:700 .6rem/1 var(--font-ui);letter-spacing:var(--ls-16);text-transform:uppercase;
  color:color-mix(in srgb,var(--gc) 78%,var(--muted))}
.holo__panel .hp__eyebrow:empty{display:none}
.holo__panel .hp__x{position:absolute;top:.4rem;right:.45rem;appearance:none;border:0;background:transparent;color:color-mix(in srgb,var(--gc) 75%,var(--on-media));cursor:pointer;font-size:var(--fs-12);line-height:1;padding:0 .2rem}
.holo__panel .hp__x:hover{color:var(--on-media)}
.holo__panel .hp__title{display:flex;align-items:center;gap:.55rem;margin:.2rem 1.2rem .05rem 0}
.holo__panel .hp__icon{width:27px;height:27px;flex:none;stroke:var(--gc);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;
  filter:drop-shadow(0 0 7px color-mix(in srgb,var(--gc) 45%,transparent))}
.holo__panel .hp__kind{font:800 1.15rem/1.1 var(--font-ui);letter-spacing:var(--ls-6);text-transform:uppercase;color:var(--on-media);
  text-shadow:0 0 18px color-mix(in srgb,var(--gc) 40%,transparent)}
.holo__panel .hp__name{font:600 .9rem/1.25 var(--font-body);color:color-mix(in srgb,var(--gc) 82%,var(--on-media))}
.holo__panel .hp__name:empty{display:none}
.holo__panel dl{margin:0;padding:.15rem .8rem .1rem;display:flex;flex-direction:column}
.holo__panel dl>div{display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:.4rem 0;border-bottom:1px solid var(--on-media-line)}
.holo__panel dl>div:last-child{border-bottom:0}
.holo__panel dt{font:600 .72rem/1 var(--font-ui);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--muted)}
.holo__panel dd{margin:0;font:700 .9rem/1 var(--font-ui);color:var(--text);font-variant-numeric:tabular-nums;text-align:right}
.holo__panel .hp__price{color:var(--gold)}
.holo__panel .hp__link{display:flex;align-items:center;gap:.4rem;margin:.55rem .8rem .7rem;padding:.5rem .65rem;
  font:700 .72rem/1 var(--font-ui);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--gc);
  border:1px solid color-mix(in srgb,var(--gc) 40%,transparent);background:color-mix(in srgb,var(--gc) 9%,transparent);
  transition:background var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui)}
.holo__panel .hp__link:hover{background:color-mix(in srgb,var(--gc) 20%,transparent);color:var(--on-media)}
/* Vorbehalt in der Detailkarte: getönter Block statt Fußnote — er schränkt die
   Kernaussage der Karte ein ("Bauteil sitzt hier") und darf nicht überlesen
   werden. Gold + gestrichelt = dieselbe Sprache wie Marker und Callout. */
.holo__panel .hp__note{margin:0;padding:.5rem .8rem .6rem 2rem;font-size:var(--fs-5);line-height:1.45;color:#f6e7c4;
  background:color-mix(in srgb,var(--gold) 12%,transparent);
  border-top:1px dashed color-mix(in srgb,var(--gold) 45%,transparent);text-transform:none;letter-spacing:var(--ls-3)}
.holo__panel .hp__note::before{content:"!";position:absolute;margin-left:-1.35rem;margin-top:.02rem;
  width:.95rem;height:.95rem;line-height:.95rem;text-align:center;font-weight:900;font-size:var(--fs-4);color:var(--ink-media);background:var(--gold);border-radius:50%}
/* Diegetische HUD-Details: Eck-Klammer + MFD-Scanlines. Bezog frueher auch
   .holo__layers (den schwebenden Ebenen-Kasten) mit ein — die Rail
   (16-03-PLAN.md Task 1, SCHRITT 3) ist eine flache Zeile, keine MFD-Kachel
   mehr, und traegt diese Eck-Klammer deshalb nicht. */
.holo__panel::before{content:"";position:absolute;top:5px;left:5px;width:12px;height:12px;
  border-top:2px solid var(--accent);border-left:2px solid var(--accent);pointer-events:none}
.holo__panel::before{border-color:var(--gc)}
.holo__panel::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(0deg,transparent 0 3px,color-mix(in srgb,var(--gc) 7%,transparent) 3px 4px)}
.holo__frame{position:absolute;inset:14px;pointer-events:none;
  background:
    linear-gradient(90deg,var(--accent) 0 22px,transparent 22px) top left/44px 2px no-repeat,
    linear-gradient(180deg,var(--accent) 0 22px,transparent 22px) top left/2px 44px no-repeat,
    linear-gradient(270deg,var(--accent) 0 22px,transparent 22px) bottom right/44px 2px no-repeat,
    linear-gradient(0deg,var(--accent) 0 22px,transparent 22px) bottom right/2px 44px no-repeat;
  opacity:.6}

/* ===== Systemabschnitte — SCHRITT 2, 16-03-PLAN.md Task 1 (D-02) =====
   Grundzustand OHNE Skript: gestapelte, sichtbare <section>-Elemente in
   Dokumentreihenfolge unter der Rail, kein Versteck-Attribut, keine
   Vorlagenhuelle (16-UI-SPEC.md Detailvertrag Punkt 6.1). Farbzuordnung je
   Gruppe (--gc) UNVERAENDERT aus .holo__panel/.holo__layer uebernommen.
   Seit 16-04-PLAN.md Task 1 (SCHRITT 1) traegt .holo__sys zusaetzlich
   grid-column:1/-1 (siehe .holo-Basisregel oben) -- das betrifft nur den
   No-JS-Restbestand (direktes Kind von .holo); sobald ein Skript die
   Abschnitte in .holo__readout verschiebt, gilt dort die schmalere,
   scoped Innenraster-Regel weiter unten. */
.holo__sys{--gc:var(--accent);position:relative;z-index:3;max-width:var(--maxw);margin:0 auto;
  padding:1.3rem clamp(1rem,3vw,2.5rem) 1.6rem;border-top:1px solid var(--line);
  /* ⚠ Ohne Skript ist jeder Blenden-Eintrag ein echter Anker (D-02), und der
     Sprung landet unter der KLEBENDEN Kopfleiste — die Ueberschrift des
     Abschnitts stand dahinter (am Bild nachgeprueft). --nav-h ist die
     gemessene Hoehe dieser Leiste (SiteNav.astro), plus etwas Luft. */
  scroll-margin-top:calc(var(--nav-h) + 12px)}
.holo__sys[data-g="arms"]{--gc:var(--gold)}
.holo__sys[data-g="prop"]{--gc:var(--accent-2)}
.holo__sys[data-g="other"]{--gc:#a78bfa}
.holo__sys-h{display:flex;align-items:center;gap:.55rem;margin-bottom:.2rem;
  font-family:var(--font-ui);font-weight:800;font-size:var(--fs-11);letter-spacing:var(--ls-6);text-transform:uppercase;color:var(--gc)}
.holo__sys-h svg{width:22px;height:22px;flex:none;stroke:var(--gc);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.holo__sys-ct{margin:0 0 .8rem;font-size:var(--fs-7);color:var(--muted)}
/* prop/other: neue, aber strukturgleiche Stueckzahl-Liste (dieselbe Formel
   wie arm__scell, nur ohne dessen Bewaffnungs-spezifischen Klassennamen). */
.holo__sys-list{display:flex;flex-wrap:wrap;gap:.5rem}
.holo__sys-row{display:flex;align-items:baseline;gap:.45rem;padding:.5rem .75rem;
  background:var(--bg-2);border:1px solid var(--line)}
.holo__sys-row b{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-14);line-height:1.1;color:var(--gc);font-variant-numeric:tabular-nums}
.holo__sys-row span{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--muted)}

/* ===== Auslesung (.holo__readout) — dritte Grid-Spalte, 16-04-PLAN.md
   Task 1 (16-UI-SPEC.md Detailvertrag Punkt 1/4) =====
   Im ausgelieferten HTML LEER (aria-label traegt den neuen Schluessel
   ship.console.readout.aria); ihren Inhalt bekommt sie ausschliesslich
   durchs Umhaengen im Skriptpfad (SCHRITT 2 unten, appendChild statt
   Kopie). Hoehe/Beschnitt spiegeln .holo__wrap, damit die Auslesung nicht
   die Grid-Zeile aufblaeht, wenn ihr Inhalt (dichteste Gruppe, z.B.
   Carrack-Bewaffnung) hoeher waere als die Buehne -- ob das je eintritt,
   misst Task 3 (Backstop "overflow E4"); die Absicherung steht defensiv
   bereits hier. */
/* Spiegelt .holo__wrap (auch dessen neue 440px-Untergrenze) — beide sitzen in
   derselben Grid-Zeile, jede Abweichung waere sofort eine Stufe.
   ⚠ Die Leiste dieses Kastens ist ab dem 20.08.2026 SICHTBAR:
   assets/mobile-ux.css 5d blendet site-weit JEDE Bildlaufleiste per
   !important aus, .holo__readout steht dort seither namentlich dagegen (plus
   die weiche Unterkante ueber SEL_VFADE in assets/scroll-affordance.js).
   Ohne diese zwei Eintraege lagen hier gemessen 109 Bildpunkte verborgen,
   ohne jedes Anzeichen — im Bildschirmfoto sah es nach einer abgeschnittenen
   Karte aus, nicht nach einem scrollbaren Kasten. */
/* Phase 17: kein Seitenstreifen mehr, sondern die Zeile UNTER dem Raum. Damit
   entfällt die Höhenbindung an die Bühne (sie standen in derselben Grid-Zeile)
   und mit ihr der eigene Bildlauf — der Abschnitt darf so hoch sein, wie sein
   Inhalt ist. Breite wie der übrige Fließtext der Seite, damit die Liste nicht
   über die volle Fensterbreite ausfranst. */
.holo__readout{max-width:var(--maxw);margin:0 auto;width:100%;padding:0 clamp(1rem,3vw,2.5rem) 1.6rem}
/* 16-04-PLAN.md Task 3: spiegelt .holo__wrap's Fuellgrad-Klinken-Reparatur
   (siehe dortiger Kommentar an der .holo__wrap-Basisregel) -- dieselbe
   dritte Stufe fuer die schmale 3-Spalten-Untergrenze bei 1100px
   (Buehnenbreite dort nur 560px, braucht eine kleinere Hoehe als bei
   1280/1440px, sonst reisst die Klinke genau dort). */
/* (Die Höhendeckel der Auslesung sind mit der Spalte entfallen — sie stand in
   derselben Grid-Zeile wie die Bühne und durfte diese nicht aufblähen. Als
   Zeile DARUNTER darf sie so hoch sein wie ihr Inhalt.) */
/* Phase-14-Lektion (14-04-SUMMARY.md Deviation 2/3) auf die neue, noch
   schmalere ~272px-Nutzbreite (320px Spalte minus Innenabstand)
   uebertragen: Innenraster mit automatischer Spaltenzahl brechen dort in
   mehr Zeilen um und werden dadurch HOEHER statt kuerzer; zusammengesetzte
   Woerter koennen ueber die Zellgrenze laufen. Werte kleiner als die
   14-04-Werte (dort ~469px Spaltenbreite) -- am Bildschirmfoto
   gegengeprueft (16-04-SUMMARY.md). */
.holo__readout .arm__sum{grid-template-columns:repeat(auto-fit,minmax(110px,1fr))}
/* .sd__slots stand hier bis zum 20.08.2026 mit derselben 110px-Formel; sie
   ist der einspaltigen Regel weiter unten gewichen (Begruendung dort). */
.holo__readout .arm__scell span,
.holo__readout .sd__slot .t,
.holo__readout .sd__slot .n,
.holo__readout .arm__name,
.holo__readout .hp__name,
.holo__readout .hp__kind{hyphens:auto;overflow-wrap:break-word}
/* 16-05-PLAN.md (Kollisionsbehebung, 1280px): .sd__slot .t (Kategorie-Label,
   z.B. "SCHILDGENERATOREN") fehlte in der obigen Liste -- ein einzelnes
   zusammengesetztes Wort ohne Leerstelle kann ohne overflow-wrap NICHT
   umbrechen und lief bei 110px-Mindestspaltenbreite ueber die Kartenkante
   hinaus, sichtbar abgeschnitten am rechten Seitenrand (Sichtbefund
   `deferred-items.md` 20.08.2026). Dieselbe Behandlung wie .n direkt
   darunter, keine neue Regel-Familie. */
/* NACHTRAG 20.08.2026 (D-01-Nacharbeit): overflow-wrap hat den Ueberlauf
   beseitigt und dafuer einen Bruch MITTEN IM WORT eingehandelt —
   "SCHILDGENERA / TOREN", so auch in der Uebergabe als offene Kollision
   protokolliert. hyphens:auto oben hilft nicht: am laufenden Chrome
   nachgemessen steht KEINE deutsche Silbentrennung zur Verfuegung (Kontrolle:
   dasselbe Wort in einem 60px-Kasten mit hyphens:auto und ohne break-word
   bleibt einzeilig und laeuft ueber — es wird also keine Trennstelle
   gefunden). Eine Loesung, die auf Silbentrennung baut, waere geraten.

   Die Ursache ist die Spaltenzahl, nicht der Sperrsatz. Gemessen:
   "SCHILDGENERATOREN" braucht bei 12,6px/700/--ls-14 volle 144px; bei ZWEI
   Karten nebeneinander bleiben im 320px-Streifen (abzueglich 32px Polster,
   Spalt und der jetzt sichtbaren Bildlaufleiste) nur rund 126px. Ein
   Zwischenwert am Sperrsatz verschob den Bruch bloss von SCHILDGENERA|TOREN
   auf SCHILDGENERAT|OREN — Symptomkur, einmal ausprobiert und verworfen.
   EINE Spalte gibt dem Label die vollen ~288px; kein Label der Auslesung
   kommt dem nahe. Der Platz dafuer ist da, seit die Konsole dem Fenster
   folgt: die Auslesung misst bei 1280x900 jetzt 718px statt 380.

   NACHTRAG Phase 17 („Hangar"): die Einspaltigkeit war die Antwort auf eine
   320px breite SPALTE. Die Auslesung ist jetzt die Zeile UNTER dem Raum und
   rund 1000px breit — dort standen fünf Karten untereinander mit je gut
   800px Leerraum daneben (am Bild nachgeprüft). Zurück zum mitwachsenden
   Raster, aber mit 220px Mindestbreite statt der ursprünglichen 110: das
   längste Label braucht gemessene 144px, und unterhalb davon fängt genau der
   Wortbruch wieder an, gegen den die Einspaltigkeit einmal antrat. */
.holo__readout .sd__slots{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.holo__readout .holo__sys{max-width:none;margin:0;padding:.9rem 1rem 1.1rem;border-top:0}

/* arms/core uebernehmen ihre Unterabschnitts-Ueberschrift (.sd__sub) UND ihren
   Koerper (arm__sum/arm__list bzw. sd__slots) aus dem Kapitel-Umzug
   UNVERAENDERT -- keine eigene Farbregel noetig: .holo traegt
   data-media-surface (theme.css "Dunkle Inseln"), das setzt --text/--muted/
   --line/--bg-2/--surface fuer ALLE Nachfahren bereits korrekt, auch im
   Hellmodus, ohne dass hier etwas ueberschrieben werden muss. */
/* HUD/Dims: z-index ueber .holo__wrap (z2) -> auch ueber Video und Bildern
   sichtbar (User-Wunsch: Titel-Chrome auch im Video-Modus). pointer-events:
   none (16-01-PLAN.md Task 2 — vorgefunden, nicht neu eingefuehrt): reines
   Wasserzeichen-Chrome, aber ohne dieses Attribut schluckt es Zeigerereignisse
   fuer alles darunter. Sichtbar wurde das erst durch die neue Sonde: bei
   414px sitzt .holo__hud (top:18px/left:16px) exakt ueber einem Marker
   nahe dem Bug (argo-csv-cargo), der Marker war per Maus-simulation nicht
   erreichbar (elementFromPoint traf .holo__hud statt den Canvas). */
.holo__hud{position:absolute;top:26px;left:30px;z-index:3;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);
  letter-spacing:var(--ls-17);text-transform:uppercase;color:var(--muted);pointer-events:none}
.holo__hud b{color:var(--accent);font-weight:700}
.holo__dims{position:absolute;top:26px;right:30px;z-index:3;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);
  letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted);text-align:right;pointer-events:none}
/* Die urspruengliche Begruendung hier ("die freie Zurueck-Marke haengt an
   .holo, HUD/Dims ruecken deshalb als Paar 26->58px nach unten") ist mit
   16-05-PLAN.md ueberholt: .holo selbst traegt jetzt den vollen
   Zurueck-Marken-Zuschlag (siehe :root:has(...) .holo{margin-top:...} an
   der .holo-Basisregel oben) -- HUD und Dims sitzen als Kind von
   .holo__wrap bereits IN diesem verschobenen Block und muessten sich sonst
   ein zweites Mal nach unten schieben (26+32=58 zusaetzlich zu den bereits
   verschobenen 92/104px .holo-margin -- zu weit). Keine eigene Regel mehr
   noetig, die vormalige Ueberschneidung mit der Zurueck-Marke ist bereits
   durch die .holo-Verschiebung behoben. */
.holo__toggle{position:absolute;right:26px;bottom:24px;z-index:6;display:flex;border:1px solid var(--line);background:var(--scrim-5);backdrop-filter:blur(4px)}
.holo__toggle button{appearance:none;border:0;background:transparent;color:var(--muted);cursor:pointer;
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-14);text-transform:uppercase;padding:.5rem .95rem}
.holo__toggle button[aria-pressed="true"]{background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--accent)}
/* z6: ueber der Video-Ebene (z5) — Schiffsname/Logo/Chips/Save bleiben in
   ALLEN Modi lesbar (User-Wunsch). pointer-events:none laesst Drag/Hover fuers
   Holo durch; nur der Save-Button faengt Klicks (siehe .holo__fav). */
.holo__title{position:absolute;left:clamp(18px,3.5vw,46px);bottom:clamp(18px,4vh,40px);z-index:6;
  max-width:min(56%,600px);pointer-events:none;display:flex;flex-direction:column}
.holo__title .sd__maker{margin-bottom:.15rem}
.holo__title h1{font-family:var(--font-display);font-weight:900;font-size:clamp(2rem,4.5vw,3.2rem);line-height:1.02;color:var(--on-media);text-shadow:0 2px 26px var(--on-media-shadow),0 0 44px rgba(45,212,255,.22)}
.holo__chips{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem}
.holo__chips span{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-12);text-transform:uppercase;
  color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 40%,transparent);background:var(--scrim-4);padding:.28rem .6rem}
/* Herkunftszeile bei Inhaltsgruppen: UNSICHTBAR, nicht entfernt.
   ⚠ Zwei Fallen hintereinander, beide am Bild gefunden:
   (1) `hidden` allein wirkte nicht — display:flex schlaegt das Attribut.
   (2) Mit display:none wirkte es, aber der Titelblock sprang beim Umschalten
       um 32px nach oben. Ein Wechsel der Gruppe darf das Schiff nicht
       verruecken. visibility haelt den Platz. */
.holo__src.is-off{visibility:hidden}
.holo__src{margin-top:.7rem;display:flex;flex-direction:column;gap:.28rem;
  font-family:var(--font-ui);font-weight:600;font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--muted);opacity:.8}
/* Vorbehalt zur Herkunft: gold wie die betroffenen Marker/Chips, damit die Zeile
   und die Callouts im Modell als dieselbe Aussage lesbar sind. */
.holo__caveat{color:var(--gold);opacity:.95;letter-spacing:var(--ls-10);text-transform:none;font-size:var(--fs-5);
  padding-left:.5rem;border-left:2px dashed color-mix(in srgb,var(--gold) 55%,transparent)}
.holo__none{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;color:var(--muted);opacity:.6}
/* Hinweis nur auf der leeren Bilder-Bühne — nie über Video oder 3D-Holo */
.holo__stage.is-video .holo__none,.holo__stage.is-3d .holo__none{display:none}
@media(max-width:900px){
  /* .holo__panel-Override entfallen (16-04-PLAN.md Task 2): die Karte ist
     seit Task 2 kein absolut positioniertes Overlay mehr, sondern ein
     normaler Block-Kind von .holo__readout -- ihre Breite kommt von der
     Grid-Spalte selbst, es gibt kein right/bottom mehr zu verschieben. */
  .holo__title{max-width:74%}
}
/* 16-04-PLAN.md Task 3 (Fuellgrad-Klinke): dritte Hoehenstufe fuer die
   schmale 3-Spalten-Untergrenze (Buehnenbreite bei 1100px nur 560px, siehe
   Kommentar an der .holo__wrap-Basisregel) -- ohne diese Stufe reisst die
   Klinke genau dort (Carrack/Ironclad gemessen 55,7%/53,9% mit der
   Basisregel allein, 72,6%/75,7% mit dieser Stufe). */
/* (Die 1279er-Höhenstufe ist mit dem Drei-Spalten-Raster entfallen. Sie
   drückte die Bühne dort auf 300–360px, weil ihr zwischen Rail und Auslesung
   nur 560–660px Breite blieben und ein zu hoher Rahmen den Füllgrad riss.
   Im Raum ist die Bühne auf JEDER Breite so breit wie das Fenster — gemessen
   bei 1024px: Füllgrad 93,2 % bei voller Höhe. Die Stufe hätte die Bühne nur
   noch grundlos auf ein Drittel gestutzt.) */
/* D-01-Nacharbeit: die Rail traegt hier acht Eintraege statt vier und misst
   ungekuerzt 434px — in eine 300-360px hohe Zeile passt das nicht, gemessen
   bei 1200x800 ragte sie 134px unter der Buehne heraus, sichtbar als Stufe.
   Die BUEHNE darf dagegen nicht wachsen: der Kommentar direkt darueber haelt
   fest, dass ohne diese Hoehenstufe der Fuellgrad auf 55,7%/53,9% faellt und
   die 70%-Klinke (P-1) reisst. Also schrumpft die Rail, nicht die Buehne —
   dieselben Stellschrauben wie in der waagerechten Fassung unter 900px
   (Polster, Spalt, Symbolgroesse), nur in der senkrechten Form. */
/* Untere Grenze 761px, nicht 901: dort uebernimmt die WAAGERECHTE Fassung
   (Regel im 760px-Block), ab da bestimmt nicht mehr die Zeilenzahl die Hoehe.
   Gemessen bei 860x900 mit der ungekuerzten Rail: 434px gegen 378px Buehne,
   also 56px Stufe. */
/* (Die senkrechte Kompaktfassung für 761–1279px ist mit Phase 17 entfallen:
   die Blende ist auf JEDER Breite waagerecht, ihre Höhe hängt nicht mehr an
   der Zahl der Einträge, und die Stufe unter der Bühne kann damit nicht mehr
   entstehen.) */
@media(max-width:640px){
  .holo__rail a{padding:.5rem .7rem;font-size:var(--fs-4);gap:.35rem}
  .holo__rail-ic{width:13px;height:13px}
}
/* Die Hinweiszeile ("ZIEHEN · RECHTSKLICK · SCROLLEN") ist rund 400px lang und
   rechtsbuendig. Unter 900px reicht sie damit bis in die Buehnenmitte und
   kreuzt den Projektorstrahl (Sichtbefund bei 768px). Sie beschreibt ausserdem
   Maus-Bedienung, die auf einem Geraet dieser Breite oft gar nicht vorliegt —
   also weg, statt sie zu quetschen. */
@media(max-width:899px){.holo__hintline{display:none}}
/* Tablet-Portrait: Hero nicht ganz so wuchtig (steht VOR der 760er-Query,
   damit Handys unten die noch flachere Variante behalten) */
/* SCHRITT 1 (16-03-PLAN.md Task 1): Ziel ist jetzt .holo__wrap statt .holo
   (siehe Kommentar an dessen Basisregel oben) — dieselben Werte. */
/* (Ebenso die 900er-Stufe — gleicher Grund, gleiche Herkunft.) */
@media(max-width:760px){
  /* D-05 (18.08.2026, Betreiber; 16-04-PLAN.md Task 3, AENDERUNG 3): bei
     schmalen Breiten wird die Buehne HOCHFORMATIG statt querformatig.
     Ursache des Befunds (WINDOWS.md id 21, Ausgangsmarke 55,4%/53,5%/76,4%
     bei 360px): NICHT .holo__wrap selbst (das ist mit height:522px bei
     width:360px schon rechnerisch hochformatig), sondern .holo__3d
     darunter, das per bottom:44% nur die OBERE 56% dieser Hoehe fuer das
     Canvas nutzte (522*0,56=292px) -- ein 360x292-Canvas ist trotz
     hochformatigem Aussenrahmen selbst QUERFORMATIG, und genau DAS misst
     fitCamera() (holo-viewer.js, W()/H() = die tatsaechliche Canvas-Groesse,
     nicht die des .holo__wrap). Fix: .holo__wrap waechst UND .holo__3d
     bekommt mehr Anteil davon (bottom:44% -> 30%) -- die Kamera braucht
     KEINE eigene Aenderung, fitCamera() waehlt die kuerzere Kante bereits
     dynamisch aus W()/H() (kein Azimut, EINE Kamera fuer alle Schiffe,
     Konkrete Vorgabe D-05). Kosten bewusst in Kauf genommen (D-05): die
     Buehne nimmt mehr senkrechten Platz, die Auslesung rueckt entsprechend
     nach unten. */
  /* NACHTRAG Phase 17: 86vh (gemessen 726px Rahmen, 508px Leinwand) waren
     nötig, solange der Füllgrad die einzige Sicherung gegen unauffindbare
     Marker war — je höher die Leinwand, desto eher ist die BREITE die kürzere
     Kante, und desto besser fällt die Messung aus. Seit die Marker eine feste
     Bildschirmgröße haben (holo-viewer.js), ist das gegenstandslos: die
     Auffindbarkeit hängt nicht mehr am Rahmen.
     Sichtbefund bei 390×844: das Schiff ist breitenbegrenzt (360 von 390px)
     und nur ~170px hoch — zwei Drittel der 508px-Leinwand blieben leer. Der
     Rahmen rückt deshalb ans Schiff heran; das Schiff wird dadurch nicht
     kleiner, nur die Leere. */
  .holo__wrap{height:clamp(400px,58vh,540px)}
  /* Holo: 3D-Modell bekommt einen groesseren Anteil der (jetzt groesseren)
     Buehnenhoehe; der Titel behaelt seine untere Zone, nur schmaler
     bemessen (siehe .holo__title unten). Viewer skaliert per
     ResizeObserver mit. */
  /* 30 % war der Titelzone zugeschlagen, als der Rahmen 726px hoch war (das
     sind 218px). Bei jetzt ~490px braucht dieselbe Titelzone einen größeren
     Anteil, sonst rutscht sie in die Leinwand: 44 % von 490 sind 216px —
     derselbe absolute Platz, nur am kleineren Rahmen gemessen. */
  .holo__3d{bottom:44%}
  /* Toggle volle Breite unten (größere Tap-Ziele) */
  .holo__toggle{left:14px;right:14px;bottom:14px}
  .holo__toggle button{flex:1}
  /* Titel kompakt in die freie untere Zone (über dem Toggle); Hersteller weg
     (steht bereits im HUD oben) */
  .holo__title{left:14px;right:14px;max-width:none;bottom:64px}
  .holo__title .sd__maker,.holo__title .sd__makerlogo{display:none}
  .holo__title h1{font-size:var(--fs-15)}
  .holo__chips{gap:.35rem;margin-top:.4rem}
  .holo__chips span{font-size:var(--fs-3);padding:.2rem .48rem}
  .holo__hud{left:16px;top:18px}.holo__dims{display:none}
  /* Der vormalige mobile Zuschlag (top:18->56px bei sichtbarer Zurueck-Marke,
     44-px-Fingerkuppe, --nav-h 116px) ist mit 16-05-PLAN.md ueberholt: .holo
     traegt den Zuschlag jetzt selbst (@media(max-width:860px) an der
     .holo-Basisregel, deckt auch diese engere 760px-Kante ab) -- ein
     zweiter Zuschlag an .holo__hud wuerde die HUD-Zeile ein zweites Mal
     verschieben. Siehe Begruendung an der urspruenglichen, jetzt entfernten
     Desktop-Fassung dieser Regel weiter oben. */
  /* Rail (16-03-PLAN.md Task 1, SCHRITT 3): kein eingeklappter Zustand mehr
     -- bei hoechstens vier Eintraegen in einer eigenen Zeile ist nichts
     mehr einzuklappen, der gesparte Platz war nur noetig, solange die Rail
     ueber dem Modell SCHWEBTE. Kompaktere Chips reichen.
     16-04-PLAN.md Task 1/3 (D-03): unter der Buehne wird die Rail wieder
     eine WAAGERECHTE Chip-Reihe -- flex-direction zurueck auf row (die
     Basisregel oben macht sie fuer die Spalten-Breiten column), kein
     Umbruch (nowrap) plus eigener waagerechter Bildlauf, falls vier Chips
     nicht nebeneinander passen (D-05 macht die Buehne hier hochformatig,
     das kostet Rail-Breite nicht mehr, sie stand ohnehin schon unter der
     vollen Buehnenbreite). Ob der Bildlauf-Kasten die
     Sechs-Stellen-Ausnahmeliste braucht, misst Task 3. */
  /* Die Blende ist seit Phase 17 auf JEDER Breite waagerecht und liegt am
     Kopf der Bühne — hier bleibt nur die engere Typografie. Die frühere
     220px-Spalte ist mit dem Drei-Spalten-Raster entfallen; sie stand hier
     noch und hat die Bühne auf 220px eingeschnürt (gemessen bei 390px:
     Bühne 220×508 statt 390 breit). */
  .holo__rail a{padding:.42rem .55rem;font-size:var(--fs-4);flex:none}
  .holo__rail-ic{width:14px;height:14px}
  /* Umbruch war die richtige Antwort am Schreibtisch und die falsche hier:
     gemessen bei 390px braucht die Blende VIER Reihen und frisst den halben
     Bildschirm. Eine Registerleiste darf seitwärts laufen — das ist auf einem
     Telefon die erwartete Form, und der Kasten bleibt einzeilig. */
  .holo__rail{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;
    max-width:100%;margin-top:0}
  /* Kein Überlagern mehr, sobald die Bühne kurz wird: bei 414px ist sie nur
     292px hoch, und eine 46px-Leiste nimmt davon ein Sechstel — Marker darunter
     wären selbst mit Durchlass schwer zu treffen. Hier bekommt die Blende eine
     eigene Zeile ÜBER der Bühne. Am Schreibtisch (718px Bühne, leerer Himmel
     oben) bleibt sie eine schwebende Leiste. */
  .holo{grid-template-rows:auto 1fr}
  .holo__rail{grid-row:1;align-self:auto;position:relative;
    background:color-mix(in srgb,var(--media-void) 72%,transparent)}
  .holo__wrap{grid-row:2}
  /* ⚠ Die Hinweiszeile nennt ZIEHEN, RECHTSKLICK und SCROLLEN — drei Dinge,
     die es auf einem Touchgerät nicht gibt. Sie lief hier zusätzlich über
     beide Ränder hinaus (nowrap bei 390px). Nicht umbrechen, sondern weg:
     sie beschreibt eine Bedienung, die hier niemand hat. */
  .holo__hintline{display:none}
  .holo__ship{inset:0}
}

/* Kennwerte-Leiste */
.holo__bar{border-bottom:1px solid var(--line);background:var(--bg-2)}
.holo__bar dl{max-width:var(--maxw);margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:0;padding:0 clamp(1rem,3vw,2.5rem)}
.holo__bar .kv{padding:.85rem 1rem .9rem;border-left:1px solid var(--line)}
.holo__bar .kv:first-child{border-left:0}
.holo__bar dt{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-5);letter-spacing:var(--ls-15);text-transform:uppercase;color:var(--muted)}
.holo__bar dd{margin:.1rem 0 0;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-12);font-variant-numeric:tabular-nums;color:var(--text)}
.holo__bar .kv--price dd{color:var(--gold)}
/* 761–899px: fuenf Zellen zu je 140px brauchen 700px, bei 768px abzueglich
   Innenabstand bleibt der letzten zu wenig — "34.398.000 aUEC" brach in zwei
   Zeilen (am Bild gefunden). Mit 165px Mindestbreite bricht die LEISTE sauber
   in zwei Reihen, statt einen Wert zu zerreissen.
   ⚠ Muss NACH der Basisregel stehen: die erste Fassung stand davor und wurde
   von ihr ueberschrieben — gleiche Spezifitaet, spaeter gewinnt. */
@media(min-width:761px) and (max-width:899px){
  .holo__bar dl{grid-template-columns:repeat(3,1fr)}
  /* Beim Umbruch traegt jede Zelle oben eine Linie statt links einer — sonst
     haengt die zweite Reihe ohne Trennung unter der ersten. Dieselbe Loesung
     wie im 760er-Block darunter. */
  .holo__bar .kv{border-left:0;border-top:1px solid var(--line)}
}
@media(max-width:760px){.holo__bar dl{grid-template-columns:repeat(2,1fr)}.holo__bar .kv{border-left:0;border-top:1px solid var(--line)}}
/* sehr schmal: kompaktere Kennwerte, damit lange aUEC-Werte einzeilig passen */
@media(max-width:560px){.holo__bar .kv{padding:.6rem .7rem .65rem}.holo__bar dd{font-size:var(--fs-10)}.holo__bar dt{font-size:var(--fs-4);letter-spacing:var(--ls-12)}}

.sd{max-width:var(--maxw);margin:0 auto;padding:1.8rem clamp(1rem,3vw,2.5rem) 4rem}
.sd__maker{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-7);letter-spacing:var(--ls-17);text-transform:uppercase;color:var(--accent)}
/* Echtes Hersteller-Logo (weiß-auf-transparent -> sichtbar auf
   dunklem Grund). Höhe fix, Breite proportional; leichter Glow für Trennung. */
/* Höhe treibt die Größe (einheitliche Zeile), Breite proportional; max-width
   nur als Sicherheitsnetz (kein Logo wird bei dieser Höhe so breit). */
.sd__makerlogo{display:block;align-self:flex-start;height:clamp(28px,3.4vw,44px);width:auto;max-width:min(240px,56vw);margin-bottom:.5rem;object-fit:contain;filter:drop-shadow(0 1px 3px var(--shadow-color))}
/* Volle Marken-Logos (Emblem + Wortmarke) höher, damit der Schriftzug lesbar bleibt */
.sd__makerlogo--full{height:clamp(46px,6vw,72px);max-width:min(340px,70vw)}
/* Sanftes Scrollen fuer Seitenanker rein ueber CSS, kein JS-scrollIntoView. */
@media(prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}

/* Handel */
.sd__pricehero{display:flex;flex-wrap:wrap;align-items:baseline;gap:.6rem 1rem;margin-bottom:1rem}
.sd__pricehero .val{font-family:var(--font-ui);font-weight:700;font-size:clamp(1.7rem,4vw,2.4rem);color:var(--gold);font-variant-numeric:tabular-nums}
.sd__pricehero .at{font-size:var(--fs-10);color:var(--muted)}
.sd__shoprows{display:flex;flex-direction:column}
.sd__shoprow{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) auto;gap:.3rem 1.2rem;align-items:baseline;
  padding:.5rem 0;border-bottom:1px solid var(--line-soft)}
.sd__shoprow:last-child{border-bottom:0}
.sd__shopname{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-9);letter-spacing:var(--ls-9);color:var(--text)}
.sd__shopwhere{color:var(--muted);font-size:var(--fs-9)}
.sd__shopprice{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--text)}
.sd__more{margin-top:.6rem}
.sd__more summary{cursor:pointer;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--accent)}
.sd__nobuy{color:var(--muted);font-size:var(--fs-10);margin-bottom:.6rem}
.sd__pledgerow{margin-top:.9rem;padding-top:.8rem;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:.5rem 1.2rem;align-items:baseline}
.sd__pledgerow .p{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11);color:var(--text)}
.sd__pledgerow a{color:var(--accent);text-decoration:underline}
.sd__pledgerow a:hover{color:var(--text)}
.sd__hint{margin-top:.9rem;font-size:var(--fs-7);color:var(--muted)}
@media(max-width:640px){.sd__shoprow{grid-template-columns:1fr auto}.sd__shopwhere{grid-column:1 / -1;margin-top:-.2rem}}

/* Leistungsprofil */
.sd__prof{display:flex;flex-direction:column;gap:.65rem}
.sd__profrow{display:grid;grid-template-columns:150px minmax(0,1fr) auto;gap:.9rem;align-items:center}
.sd__proflabel{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted)}
.sd__proftrack{position:relative;height:10px;background:var(--veil-hi);border:1px solid var(--line);overflow:hidden}
.sd__proftrack::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--veil-hi)}
.sd__proffill{height:100%;background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 45%,transparent),var(--accent))}
.sd__profval{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);font-variant-numeric:tabular-nums;color:var(--text);white-space:nowrap}
.sd__profval i{font-style:normal;color:var(--muted);font-size:var(--fs-6);margin-left:.45rem}
/* Drei Metriken zeigen keinen Rohwert mehr (14-UI-SPEC.md Detailvertrag
   Punkt 6) — das Perzentil-Element ist dort das ERSTE (einzige) Kind von
   .sd__profval; der fuer den Normalfall gedachte linke Abstand haenge sonst
   ins Leere. */
.sd__profval i:first-child{margin-left:0}
/* Mobil: Label + Wert in eine Zeile (Label links, Wert rechts), der Balken
   darunter über die volle Breite — so überlappt der Text NIE den Balken und
   längere EN-Labels haben Platz (keine feste, auf DE getunte Label-Spalte). */
@media(max-width:640px){
  .sd__profrow{grid-template-columns:1fr auto;column-gap:.8rem;row-gap:.3rem;align-items:baseline}
  .sd__proflabel{grid-column:1;grid-row:1}
  .sd__profval{grid-column:2;grid-row:1;justify-self:end;margin-top:0}
  .sd__proftrack{grid-column:1 / -1;grid-row:2;margin-top:.15rem}
}

/* Lackierungen */
.sd__paints{display:grid;grid-auto-flow:column;grid-auto-columns:172px;gap:.7rem;overflow-x:auto;padding-bottom:.5rem;
  scrollbar-width:thin;scrollbar-color:var(--accent) transparent}
.sd__paint{border:1px solid var(--line);background:var(--bg-2)}
.sd__paint .im{aspect-ratio:16/10;overflow:hidden;background:var(--veil-2)}
.sd__paint img{width:100%;height:100%;object-fit:cover}
.sd__paint .nm{padding:.45rem .6rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-7);color:var(--text);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* Varianten & Loaner */
.sd__reflist{display:flex;flex-wrap:wrap;gap:.55rem}
.sd__ref{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--line);background:var(--bg-2);
  padding:.42rem .75rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-8)}
a.sd__ref{transition:border-color var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui)}
a.sd__ref:hover{border-color:var(--accent);color:var(--accent)}
a.sd__ref::after{content:"→";color:var(--muted)}
a.sd__ref:hover::after{color:var(--accent)}
span.sd__ref{color:var(--muted)}

.sd__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.7rem 1.4rem;margin:0}
.sd__item{border-left:1px solid var(--line);padding-left:.8rem}
.sd__item dt{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted)}
.sd__item dd{margin:.15rem 0 0;font-weight:500;font-size:var(--fs-11);line-height:1.35;font-variant-numeric:tabular-nums;color:var(--text)}
.sd__sub{display:flex;align-items:center;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted);
  margin:1.6rem 0 .8rem;padding-bottom:.4rem;border-bottom:1px solid var(--line)}

/* Kapitelinterne Zweispaltigkeit (14-04-PLAN.md Task 1, UI-SPEC Punkt 9) —
   traegt 957px des Hoehenbudgets, ohne die 4.200px rechnerisch unerreichbar
   sind. .sd__ch2col umschliesst die Unterabschnitte EINES Kapitels
   (Ausstattung: 4 Zellen, Umfeld: 4 Zellen), .sd__chsec je einen einzelnen
   Unterabschnitt (Ueberschrift + Koerper). Unter 1100px: unveraendert
   gegenueber Welle 3, einspaltig ohne eigenen Zeilenabstand — die
   bestehenden sd__sub-Aussenabstaende tragen dort weiterhin den Rhythmus.
   Ab 1100px (dieselbe lokale Hoechstbreite --maxw, NICHT die site-weiten
   1280px): zwei gleich breite, schrumpfbare Spalten (minmax(0,1fr) haelt
   lange Inhalte vom Aufblaehen der Zelle ab); Spalten- UND Zeilenabstand
   uebernehmen denselben 1.6rem-Wert, den sd__sub schon als oberen
   Aussenabstand traegt -- keine neue Zahl. Die erste Ueberschrift jeder
   Zelle verliert dabei ihren oberen Aussenabstand, sonst waere die
   Zeilen-Luecke des Rasters UND der sd__sub-Aussenabstand gleichzeitig
   wirksam und die Zellen begaennen nicht buendig oben. */
.sd__ch2col{display:grid;grid-template-columns:1fr}
.sd__chsec{min-width:0}
@media(min-width:1100px){
  .sd__ch2col{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:1.6rem;row-gap:1.6rem}
  .sd__ch2col .sd__chsec > .sd__sub:first-child{margin-top:0}
  /* Vorweggenommene Annahme aus Task 1 GEMESSEN widerlegt (Task 2): das
     Grundriss-Raster (sd__dims) sollte wegen seiner FENSTERBREITEN-
     Medienabfrage vorsorglich einspaltig gesetzt werden. Die Schlussmessung
     zeigt: Bewaffnung (arm__list, inhaltsgetrieben durch die Zahl der
     Turmgruppen) ist in der Ausstattung-Zeile 1 IMMER die groessere Zelle
     als Masse & Fracht — ob dims ein- oder zweispaltig steht, aendert die
     Zeilenhoehe deshalb NICHT (Zeile 1 haengt an Bewaffnung, nicht an
     Masse & Fracht). Zweispaltig gemessen 76px KUERZER (513px statt 590px
     eigene Zellenhoehe) und am Bildpunkt angesehen nicht gequetscht
     (Frachtwuerfel + Grundriss-Kasten bleiben bei ~220px Spaltenbreite
     lesbar) -- deshalb bewusst NICHT einspaltig, die urspruengliche
     Befuerchtung war eine Annahme, keine Messung. */
  .sd__ch2col .sd__dims{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  /* GEMESSENER zweiter Bruch (14-04-PLAN.md Task 2, Verdaechtiger 2 der
     Schlussmessung): die uebrigen "selbstregelnden" Innenraster
     (sd__grid/sd__qgrid/sd__slots/sd__inscards) nutzen repeat(auto-fit,
     minmax(…)) mit einer Mindestbreite, die auf die VOLLE Kapitelbreite
     (~1023px) kalibriert ist. In der halbierten ~469px-Spalte lassen
     dieselben Mindestbreiten nur noch 2 statt 3-5 Spalten zu — die Zeilen
     brechen um, die Zelle wird HOEHER als bei voller Breite (Gegenteil des
     Ziels dieses Plans). Am gerenderten Bildpunkt der Carrack gemessen:
     Flugleistung 380px -> 547px, Komponenten 251px -> 547px, Versicherung
     202px -> 298px — zusammen der Grossteil der anfaenglichen 264px
     Ueberschreitung ueber die 4.200px-Klinke. Fix: dieselbe Spaltenzahl wie
     bei voller Breite auch in der halbierten Spalte erreichen, per
     kleinerer (nicht site-weiter, nur hier per Spezifitaet
     ueberschriebener) Mindestbreite -- keine neue Bauform, dieselben
     Grid-Regeln bleiben site-weit unveraendert wirksam. Jeder Wert per
     Bildschirmfoto GEGENGEPRUEFT, nicht nur gemessen: ein zu kleiner Wert
     liess einzelne lange, ungetrennte Woerter (z. B. "SCHILDGENERATOREN")
     ueber die Zellgrenze hinauslaufen statt umzubrechen -- deshalb bleiben
     die Werte hier bewusst groesser als das rechnerische Minimum. */
  .sd__ch2col .sd__grid{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
  .sd__ch2col .sd__qgrid{grid-template-columns:repeat(auto-fit,minmax(90px,1fr))}
  .sd__ch2col .sd__slots{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}
  .sd__ch2col .sd__inscards{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}
  /* arm__sum (Bewaffnung-Kennzahlen): hier NICHT die Spaltenzahl der vollen
     Breite halten, sondern bewusst halbieren. Am Bildpunkt gemessen: der
     Container ist in der halben Spalte 469px breit, "Gegenmaßnahmen" misst
     ungetrennt 147px und braucht mit der Zellpolsterung 176px. Vier Spalten
     geben jeder Zelle 87px — das Wort passt in keiner Aufteilung, und
     overflow-wrap:anywhere hat es dann strichlos mitten durchgeschnitten
     ("GEGENMASSN / AHMEN", "TURMSTATIO / NEN"). Ein frueherer Kommentar an
     dieser Stelle behauptete, hyphens:auto erzeuge dabei einen Trennstrich —
     das Bildschirmfoto zeigt keinen: bei 87px erreicht die Silbentrennung nie
     eine zulaessige Trennstelle.
     anywhere war dabei doppelt schaedlich, weil es zusaetzlich die
     Mindestbreite verkleinert, mit der auto-fit rechnet, und die zu schmalen
     Spalten damit ueberhaupt erst einlaedt. break-word bricht nur, wenn ein
     Wort allein auf seiner Zeile nicht passt, und bleibt als Sicherheitsnetz.
     minmax(180px) ergibt bei 469px genau zwei Spalten -> 2x2 statt 1x4, alle
     vier Labels einzeilig. Kosten: 10px Seitenhoehe (4.179 -> 4.189), die
     Klinke von 4.200px haelt. Bei 1100px Ansichtsbreite ist der Container
     ~403px und ergibt dieselben zwei Spalten. */
  .sd__ch2col .arm__scell span{hyphens:auto;overflow-wrap:break-word}
  .sd__ch2col .arm__sum{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
}
/* ---------------- Bewaffnung: Hardpoint-Ledger ----------------
   Eine Zeile je Waffenart statt einer Reihe nackter Zahlen. Jede Zeile ist
   für sich lesbar: Stückzahl · Größenklasse (mit maßstäblichem Balken) ·
   Name · Schadensart · Hardpoint-Reserve. Die Größen-Chips bilden eine
   linksbündige Spalte -> das Kaliberprofil ist senkrecht abscanbar. */
.arm__sum{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  background:var(--line);border:1px solid var(--line);margin-bottom:1.2rem}
.arm__scell{background:var(--bg-2);padding:.6rem .8rem;display:flex;flex-wrap:wrap;align-items:baseline;gap:.05rem .45rem}
.arm__scell b{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-14);line-height:1.1;color:var(--accent);
  font-variant-numeric:tabular-nums}
.arm__scell span{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-12);
  text-transform:uppercase;color:var(--muted)}
.arm__scell i{flex-basis:100%;font-style:normal;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-5);
  letter-spacing:var(--ls-9);color:var(--text);opacity:.75;font-variant-numeric:tabular-nums}
.arm__scell--g b{color:var(--gold)}

.arm__list{display:flex;flex-direction:column;gap:1.1rem}
.arm__grp{border-left:2px solid color-mix(in srgb,var(--accent) 55%,transparent);padding-left:.9rem}
.arm__grp--g{border-left-color:color-mix(in srgb,var(--gold) 60%,transparent)}
.arm__ghead{display:flex;flex-wrap:wrap;align-items:baseline;gap:.3rem .7rem;
  padding-bottom:.45rem;border-bottom:1px solid var(--line-soft);margin-bottom:.5rem}
.arm__glabel{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-7);letter-spacing:var(--ls-13);
  text-transform:uppercase;color:var(--text)}
.arm__gmeta{font-family:var(--font-ui);font-weight:600;font-size:var(--fs-5);letter-spacing:var(--ls-9);color:var(--muted)}
.arm__gval{margin-left:auto;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);color:var(--text);
  font-variant-numeric:tabular-nums;white-space:nowrap}
.arm__grp--g .arm__gval{color:var(--gold)}

.arm__lines{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.3rem}
.arm__line{display:grid;grid-template-columns:2.6rem 54px minmax(0,1fr) auto;align-items:center;gap:.7rem}
.arm__n{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);color:var(--text);
  font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.arm__n i{font-style:normal;font-size:var(--fs-6);color:var(--muted);margin-left:.06rem}
/* Größen-Chip: fixe Breite (Spalte bleibt bündig), Füllbalken = Klasse
   maßstäblich (S1 fast leer … S10+ voll) — dieselbe Sprache wie die Gauges */
.arm__size{position:relative;display:grid;place-items:center;height:26px;overflow:hidden;
  border:1px solid color-mix(in srgb,var(--accent) 45%,transparent);background:var(--veil-hi)}
.arm__size::before{content:"";position:absolute;left:0;top:0;bottom:0;width:calc(100% * min(var(--s,1) / 10, 1));
  background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 22%,transparent),color-mix(in srgb,var(--accent) 48%,transparent))}
.arm__size em{position:relative;font-style:normal;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-7);
  line-height:1;color:var(--accent);font-variant-numeric:tabular-nums}
.arm__size--n{border-style:dashed;border-color:var(--line)}
.arm__size--n em{color:var(--muted)}
.arm__grp--g .arm__size{border-color:color-mix(in srgb,var(--gold) 50%,transparent)}
.arm__grp--g .arm__size::before{background:linear-gradient(90deg,color-mix(in srgb,var(--gold) 20%,transparent),color-mix(in srgb,var(--gold) 45%,transparent))}
.arm__grp--g .arm__size em{color:var(--gold)}
.arm__name{min-width:0;font-size:var(--fs-10);color:var(--text)}
.arm__anon{color:var(--muted)}
.arm__bdg{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-10);text-transform:uppercase;
  color:var(--muted);white-space:nowrap}
.arm__bdg--up{color:var(--accent);border:1px solid color-mix(in srgb,var(--accent) 40%,transparent);
  background:color-mix(in srgb,var(--accent) 8%,transparent);padding:.14rem .4rem}
.arm__note{margin:.5rem 0 0;font-size:var(--fs-8);color:var(--muted);line-height:1.5}
.arm__note span{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-11);
  text-transform:uppercase;margin-right:.4rem}
@media(max-width:640px){
  .arm__line{grid-template-columns:2.2rem 48px minmax(0,1fr);row-gap:.15rem}
  .arm__bdg{grid-column:3;justify-self:start}
  .arm__gval{margin-left:0;flex-basis:100%}
}

/* white-space:pre-line: vDesc() wandelt die woertlichen "\n"-Folgen der
   Spieltexte in echte Zeilenumbrueche (01.4-05, D-07) — ohne dieses Attribut
   wuerden Browser sie zu Leerzeichen zusammenfalten. */
.sd__desc{max-width:78ch;margin:0 0 1.6rem;font-size:var(--fs-11);line-height:1.65;color:var(--text);opacity:.92;white-space:pre-line}
.sd__spine{margin-bottom:1.6rem;border:1px solid var(--line);border-left:3px solid var(--gold);background:var(--bg-2);padding:1rem 1.2rem}
.sd__spine h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-15);text-transform:uppercase;color:var(--gold);margin-bottom:.5rem}
.sd__spine a{display:block;padding:.3rem 0;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10)}
.sd__spine a:hover{color:var(--gold);text-decoration:underline}
.sd__spine span{color:var(--muted);font-weight:600}

.sd__simgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.8rem}
.sd__sim{border:1px solid var(--line);background:var(--surface);transition:border-color var(--dur-fast) var(--ease-ui),background var(--dur-fast) var(--ease-ui);display:flex;flex-direction:column}
.sd__sim:hover{border-color:color-mix(in srgb,var(--accent) 55%,transparent);background:var(--surface-2)}
.sd__sim .im{aspect-ratio:16/9;background:var(--veil-2);display:grid;place-items:center;overflow:hidden}
.sd__sim .im img{width:100%;height:100%;object-fit:cover}
.sd__sim .im span{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-16);color:var(--muted);font-size:var(--fs-4)}
.sd__sim .tx{padding:.6rem .8rem .7rem}
.sd__sim .nm{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);color:var(--text)}
.sd__sim .mt{font-size:var(--fs-7);color:var(--muted)}

.sd__links{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.6rem}
.sd__links a{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-7);letter-spacing:var(--ls-11);text-transform:uppercase;
  border:1px solid var(--line);padding:.45rem .9rem;transition:border-color var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui)}
.sd__links a:hover{border-color:var(--accent);color:var(--accent)}
.sd__src{margin-top:1.4rem;font-size:var(--fs-7);color:var(--muted)}
.sd__src a{text-decoration:underline}
.sd__src a:hover{color:var(--accent)}

/* Die generische Gauge-Bauform (Zeile, Spur, Fuellung, Wert — Praefix
   sd__g-*) samt ihrer 640px-Medienabfrage ist mit Task 2 dieser Phase
   entfallen — alle sechs Fundstellen sind entweder ersatzlos weg (D-02)
   oder zu Zahlen im sd__grid/sd__item-Raster geworden. sd__glabel BLEIBT:
   es traegt weiterhin die beiden Ueberschriften "Top view" / "Cargo hold"
   in Maße & Fracht. */
.sd__glabel{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted)}

/* Maße & Fracht */
.sd__dims{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:1.6rem}
@media(max-width:760px){.sd__dims{grid-template-columns:1fr}}
.sd__footbox{border:1px dashed color-mix(in srgb,var(--accent) 55%,transparent);background:color-mix(in srgb,var(--accent) 6%,transparent);
  min-width:56px;max-width:100%;margin:.5rem 0 .45rem;position:relative}
.sd__footbox::after{content:"";position:absolute;left:12%;right:12%;top:50%;height:1px;background:color-mix(in srgb,var(--accent) 35%,transparent)}
.sd__footcap{font-size:var(--fs-7);color:var(--muted)}
.sd__cargonum{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-15);color:var(--gold);font-variant-numeric:tabular-nums}
.sd__cubes{display:flex;flex-wrap:wrap;gap:4px;margin:.55rem 0 .35rem}
.sd__cube{width:15px;height:15px;background:color-mix(in srgb,var(--gold) 30%,transparent);border:1px solid color-mix(in srgb,var(--gold) 75%,transparent)}

/* Hardpoint-Slots (Komponenten-Abschnitt) */
.sd__hp{display:inline-grid;place-items:center;height:24px;min-width:calc(15px + var(--hs,1)*4px);padding:0 .3rem;
  border:1px solid var(--accent);background:color-mix(in srgb,var(--accent) 10%,transparent);color:var(--accent);
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);line-height:1}
.sd__hpmore{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);color:var(--muted);align-self:center}
.sd__hprow{display:flex;flex-wrap:wrap;gap:6px;align-items:center}

/* Komponenten-Slots */
.sd__slots{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.7rem}
.sd__slot{border:1px solid var(--line);background:var(--bg-2);padding:.6rem .8rem}
.sd__slot .t{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted)}
.sd__slot .n{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);color:var(--text);margin:.15rem 0 .3rem}

/* Quantum-Chips */
.sd__qgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.7rem 1.4rem}

/* Versicherung */
.sd__inscards{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.7rem}
.sd__ins{border:1px solid var(--line);background:var(--bg-2);padding:.7rem .9rem}
.sd__ins .t{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted)}
.sd__ins .v{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-13);font-variant-numeric:tabular-nums;color:var(--text);margin-top:.15rem}
.sd__ins--gold .v{color:var(--gold)}

/* System-Chips (Kauforte) */
.sd__sys{display:inline-block;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;
  border:1px solid rgba(110,168,255,.4);color:var(--accent-2);padding:.1rem .4rem;margin-left:.5rem;vertical-align:1px}
.sd__sys.sys-pyro{border-color:rgba(255,138,80,.45);color:#ff8a50}
.sd__sys.sys-nyx{border-color:rgba(192,154,255,.45);color:#c09aff}

/* Favoriten-Stern (Konto-Feature; /assets/account-lite.js toggelt .is-fav).
   pointer-events:auto hebt das pointer-events:none des Titels auf — sonst
   kaeme kein Klick am Button an. */
.holo__fav{margin-top:.7rem;pointer-events:auto}
.favbtn{display:inline-flex;align-items:center;gap:.45rem;background:var(--veil);border:1px solid var(--line);color:var(--muted);
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-5);letter-spacing:var(--ls-11);text-transform:uppercase;padding:.42rem .85rem;cursor:pointer;
  transition:color var(--dur-fast) var(--ease-ui),border-color var(--dur-fast) var(--ease-ui),background-color var(--dur-fast) var(--ease-ui)}
.favbtn:hover{color:var(--accent);border-color:var(--accent);background:color-mix(in srgb,var(--accent) 7%,transparent)}
.favbtn.is-fav{color:var(--accent-2);border-color:color-mix(in srgb,var(--accent-2) 60%,transparent);background:color-mix(in srgb,var(--accent-2) 10%,transparent)}
.favbtn.is-fav .favbtn__star path{fill:currentColor}
/* Hell-Entsprechungen — erzeugt von scripts/build-light-overrides.mjs. Nicht von Hand ändern. */
:root[data-theme="light"] .sd__sys.sys-pyro{border-color:rgba(192,81,3,.63);color:#903a00}
:root[data-theme="light"] .sd__sys.sys-nyx{border-color:rgba(136,92,198,.63);color:#6a36a8}
</style>

<SiteNav
  crumbs={[
    { label: t('crumbs.archive'), href: L('/index.html') },
    { label: t('crumbs.ships'), href: L('/schiffe.html') },
    { label: d.name },
  ]}
  hasEn={hasEn}
/>

<main>
  <!-- HANGAR-BÜHNE: Info links, interaktives Komponenten-Hologramm rechts -->
  {/* data-media-surface: die Bühne zeigt Hologramm, Renderbilder und Video —
      sie bleibt in beiden Modi dunkel. Siehe „Dunkle Inseln" in theme.css. */}
  <section class="holo" id="holo" data-media-surface aria-label={`${d.name} — Visual`}>
    <div class="holo__wrap">
      {/* SCHRITT 1 (16-03-PLAN.md Task 1): .holo__grid/.holo__pad sind
          bottom-verankert (bottom:-4%/7%) -- an .holo direkt haengend
          wuerden sie an den Fuss des jetzt gewachsenen GESAMTBLOCKS rutschen
          statt unter das Modell zu bleiben. Sie wandern deshalb in denselben
          Container wie die Buehne (.holo__wrap), der seine feste Hoehe
          behaelt.
          16-05-PLAN.md (Kollisionsbehebung, 1280px): .holo__frame/
          .holo__hud/.holo__dims standen bis hierher noch AUSSEN, mit der
          Begruendung, sie rahmten/beschrifteten den GESAMTEN Konsolen-Block.
          Das war die Annahme aus der Zeit VOR Rail und Auslesung als eigene
          Grid-Spalten (16-04-PLAN.md Task 1) und stimmt seither nicht mehr:
          alle drei sind bei fehlenden grid-column/-row weiterhin relativ zum
          GESAMTEN .holo positioniert (CSS Grid: ein abs.-positioniertes
          Grid-Kind ohne Linienangabe spannt per Spezifikation den vollen
          Grid-Bereich) -- die HUD-Zeile links liegt dadurch auf der Rail,
          die Massanzeige rechts auf der Auslesung, und der Eckenrahmen
          markiert eine Ecke irgendwo im Auslesungsinhalt statt die Buehne zu
          rahmen (Sichtbefund `deferred-items.md` 20.08.2026). Alle drei
          rahmen/beschriften jetzt nur noch die BUEHNE (dieselbe Aufgabe wie
          zuvor gemeint, nur auf den tatsaechlich noch vorhandenen
          Vollbild-Bereich bezogen) -- deshalb Kind von .holo__wrap, dessen
          eigene position:relative sie exakt dort haelt. */}
      <div class="holo__frame" aria-hidden="true"></div>
      <div class="holo__hud">{t('ship.code.hangar')}&nbsp;//&nbsp;<b>{d.manufacturer ?? d.makerCode ?? t('ship.code.ship')}</b></div>
      {dims && <div class="holo__dims">{dims}</div>}
      <div class="holo__grid" aria-hidden="true"></div>
      <div class="holo__pad" aria-hidden="true"></div>
      <header class="holo__title">
        {makerLogo ? (
          <img
            class:list={['sd__makerlogo', makerLogo.full && 'sd__makerlogo--full']}
            src={`/assets/manufacturers/${makerLogo.file}`}
            alt={d.manufacturer}
            width={makerLogo.w}
            height={makerLogo.h}
            loading="eager"
            decoding="async"
          />
        ) : (
          d.manufacturer && <div class="sd__maker">{d.manufacturer}</div>
        )}
        <h1>{d.name}</h1>
        <div class="holo__chips">
          {vRole(d, lang) && <span>{vRole(d, lang)}</span>}
          {vSize(d, lang) && <span>{vSize(d, lang)}</span>}
          {vStatus(d, lang) && <span>{vStatus(d, lang)}</span>}
        </div>
        <div class="holo__fav">
          <button
            type="button"
            class="favbtn"
            data-fav
            data-fav-kind="ship"
            data-fav-slug={id}
            data-fav-label={d.name}
            data-fav-on={t('fav.saved')}
            data-fav-off={t('fav.save')}
            aria-pressed="false"
            aria-label={t('fav.aria')}
            title={t('fav.aria')}
          >
            <svg class="favbtn__star" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span class="js-fav-txt">{t('fav.save')}</span>
          </button>
        </div>
        {/* id: das Skript blendet diese Zeile aus, sobald eine INHALTSgruppe
            gewaehlt ist. Sie behauptet "Komponenten-Positionen spielgetreu" —
            bei "Kaufen" oder "Rang" wird gar keine Position gezeigt, und die
            Zeile stuende als Behauptung ueber einem blanken Rumpf. */}
        {holoData && holoData.ports.length > 0 && (
          <div class="holo__src" id="holosrc">
            <span class={holoAllNp ? 'holo__caveat' : undefined}>{holoAllNp ? t('holo.src.none' as any) : t('holo.src')}</span>
            {holoNp > 0 && !holoAllNp && <span class="holo__caveat">{t('holo.legend.np' as any)}</span>}
          </div>
        )}
      </header>
      <div
        class={`holo__stage${defaultMode === 'video' ? ' is-video' : ''}`}
        id="holostage"
        data-default={defaultMode}
        data-holo-src={holoViewerSrc}
        data-loading={t('ship.holo.loading')}
        data-error={t('ship.holo.error')}
        data-novisual={t('ship.novisual')}
      >
        <figure class="holo__ship" id="shipfig">
          {hasGallery ? (
            gallery.map((g, i) => (
              <img
                src={i === 0 ? g.src : undefined}
                data-src={i === 0 ? undefined : g.src}
                data-fb={g.fb}
                class={i === 0 ? 'is-active' : undefined}
                alt={g.paint ? altPaint(g.paint) : altView}
                referrerpolicy="no-referrer"
                onerror="if(this.dataset.fb){this.src=this.dataset.fb;this.removeAttribute('data-fb')}else{this.dataset.bad='1';this.style.display='none'}"
              />
            ))
          ) : (
            <span class="holo__none">{t('ship.novisual')}</span>
          )}
        </figure>
        {localVid && (
          /* Selbst-gehosteter, stummer Loop: KEIN Player-Chrome, kein Start-Icon.
             poster = Schiffs-Standbild (deckt bis zum ersten Frame ab); der
             Bild-Boden dahinter fängt einen Ladefehler auf -> nie schwarz. */
          <video
            class="holo__localvid"
            id="hololocalvid"
            src={localVid}
            poster={gallery[0]?.src}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
          ></video>
        )}
        {videoId && (
          <div class="holo__video" id="holovideo" data-vid={videoId}>
            {/* Schneller Videostart: Verbindungen zu den YouTube-Hosts schon
                beim Parsen aufbauen und die IFrame-API parallel zum Seiten-
                aufbau laden — loadYT() findet das Script per id und wartet
                nur noch auf ready, statt die Ladekette seriell zu starten */}
            <link rel="preconnect" href="https://www.youtube.com" />
            <link rel="preconnect" href="https://www.youtube-nocookie.com" />
            <link rel="preconnect" href="https://i.ytimg.com" />
            <script is:inline id="yt-iframe-api" src="https://www.youtube.com/iframe_api" async></script>
            {/* Poster IMMER rendern (ohne Galerie-Bild dunkel) — es verdeckt
                YouTubes Start-Chrome; fehlte es (Schiffe ohne Bilder, z. B.
                Basher), blitzte die Player-UI beim Start nackt durch */}
            <span class="holo__videoposter" style={gallery[0] ? `background-image:url('${gallery[0].src}')` : undefined} aria-hidden="true"></span>
            <div class="holo__playertarget" id="holoplayer"></div>
            <span class="holo__videoshield" id="holovideoshield" aria-hidden="true"></span>
          </div>
        )}
        {gallery.length > 1 && (
          <div class="holo__dots" id="holodots" aria-hidden="true">
            {gallery.map((_, i) => <i class={i === 0 ? 'on' : undefined}></i>)}
          </div>
        )}
        <div class="holo__3d" id="holo3d" aria-label={t('ship.holo.drag')}></div>
        <div class="holo__status" id="holostatus" role="status"></div>
        {/* #holoact ("Hologramm aktivieren") ersatzlos entfernt (16-04-PLAN.md
            Task 3, D-04) -- war bereits vor dieser Welle inert (hidden, siehe
            deferred-items.md), und ein Ladeausloeser per Knopf widerspricht
            D-04: wenn das Schiff die Navigation IST, darf es nicht hinter
            einem Knopf liegen. Laden loest jetzt ausschliesslich der
            IntersectionObserver im Skriptblock unten aus. */}
        <div class="holo__hintline" aria-hidden="true">{t('holo.hint')}</div>
        {/* Der schwebende Ebenen-Kasten (#holofilters/.holo__layers) ist
            entfallen (16-03-PLAN.md Task 1, SCHRITT 3) -- ersetzt durch die
            Rail (nav.holo__rail), die als eigener Block NACH der Buehne
            steht (siehe unten, ausserhalb von .holo__wrap). */}
        <aside class="holo__panel" id="holopanel" hidden data-np={t('holo.panel.notPhys')} data-est={t('holo.panel.estimated')} data-auec={t('holo.panel.auec')}>
          <div class="hp__head">
            <span class="hp__eyebrow" id="hpgrp"></span>
            <button type="button" class="hp__x" id="holopclose" aria-label={t('holo.panel.close')}>×</button>
            <div class="hp__title">
              <svg class="hp__icon" id="hpicon" viewBox="0 0 24 24" aria-hidden="true"><path /></svg>
              <div class="hp__kind" id="hpkind"></div>
            </div>
            <div class="hp__name" id="hpname"></div>
          </div>
          <dl>
            <div><dt>{t('holo.panel.size')}</dt><dd id="hpsize"></dd></div>
            <div class="hp__row" id="hpcatrow" hidden><dt>{t('holo.panel.cat')}</dt><dd id="hpcat"></dd></div>
            <div class="hp__row" id="hppricerow" hidden><dt>{t('holo.panel.price')}</dt><dd class="hp__price" id="hpprice"></dd></div>
            <div class="hp__row" id="hpshopsrow" hidden><dt>{t('holo.panel.shops')}</dt><dd id="hpshops"></dd></div>
          </dl>
          <a class="hp__link" id="hplink" hidden><span>{t('holo.panel.finder')}</span></a>
          <p class="hp__note" id="hpnote" hidden></p>
        </aside>
      </div>
      {/* .holo__toggle ist bottom-verankert (bottom:24px) -- gehoert seit
          SCHRITT 1 (16-03-PLAN.md Task 1) in .holo__wrap, sonst rutscht der
          Umschalter an den Fuss des gewachsenen GESAMTBLOCKS statt am
          unteren Rand der Buehne zu bleiben (derselbe Fund wie bei
          .holo__grid/.holo__pad oben, hier per Bildpunkt-Audit ergaenzt). */}
      {stageModeCount > 1 && (
        <div class="holo__toggle" role="group" aria-label={t('ship.view.switch')}>
          {hasVideo && <button type="button" id="btnvid" aria-pressed={String(defaultMode === 'video')}>{t('ship.view.video')}</button>}
          {hasGallery && <button type="button" id="btnimg" aria-pressed={String(defaultMode === 'img')}>{t('ship.view.img')}</button>}
          {holoAvail && <button type="button" id="btn3d" aria-pressed={String(defaultMode === 'holo')}>{t('ship.view.3d')}</button>}
        </div>
      )}
    </div>

    {/* ===== Rail — reine Anker-Liste, funktioniert ohne Skript.
        Ersetzt den frueheren schwebenden Ebenen-Kasten; steht in
        Dokumentreihenfolge NACH der Buehne (D-02 verlangt "erst das Schiff,
        dann die Liste" ohne Skript), optisch aber die erste Grid-Spalte
        (16-04-PLAN.md Task 1, SCHRITT 1). Bedingung wie frueher am alten
        Kasten "mindestens eine Gruppe" statt "mehr als eine" -- der
        eingeklappte Zustand entfaellt ersatzlos (16-03-PLAN.md SCHRITT 3).
        aria-current serverseitig auf dem ERSTEN Eintrag (Detailvertrag
        Punkt 2, Vorbelegung ohne Klick) -- das Skript unten haelt es beim
        Umschalten synchron; Punkt 6 des Vertrags gewinnt gegen den
        aelteren aria-pressed-Wortlaut (siehe Planungsnotizen). */}
    {(portGroups.length + contentGroups.length) > 0 && (
      <nav class="holo__rail" id="holorail" aria-label={t('ship.console.rail.aria')}>
        {portGroups.map((gr, i) => (
          <a href={`#sys-${gr}`} data-g={gr} aria-current={i === 0 ? 'true' : undefined}>
            <svg class="holo__rail-ic" viewBox="0 0 24 24" aria-hidden="true"><path d={HOLO_GRP_ICON[gr]} /></svg>
            <span class="holo__rail-lb">{t(`holo.grp.${gr}` as any)}</span>
            <span class="holo__rail-ct">{sysPortCount(gr)}</span>
          </a>
        ))}
        {/* Inhaltsgruppen (D-01): dieselbe Anker-Form, eigene Beschriftung und
            eigenes Symbol. Die Vorbelegung bleibt beim ersten PORT-Eintrag —
            faellt die Buehne ganz weg (kein Mesh), erbt sie der erste
            Inhaltseintrag, damit nie NULL Eintraege aria-current tragen. */}
        {/* data-kind + is-schnitt: die Blende fuehrt ZWEI Arten von Eintraegen.
            Portgruppen markieren Stellen AM RUMPF, Inhaltsgruppen oeffnen
            einen Text — sie sahen bis hierher identisch aus, obwohl ein Klick
            voellig Verschiedenes tut. Eine Zaesur vor dem ersten
            Inhaltseintrag sagt das, ohne ein Wort zu kosten. */}
        {contentGroups.map((cg, i) => (
          <a href={`#sys-${cg.id}`} data-g={cg.id} data-kind="inhalt"
            class={i === 0 && portGroups.length > 0 ? 'is-schnitt' : undefined}
            aria-current={portGroups.length === 0 && i === 0 ? 'true' : undefined}>
            <svg class="holo__rail-ic" viewBox="0 0 24 24" aria-hidden="true"><path d={cg.icon} /></svg>
            <span class="holo__rail-lb">{cg.rail}</span>
            <span class="holo__rail-ct">{cg.count}</span>
          </a>
        ))}
      </nav>
    )}

    {/* ===== Auslesung — SCHRITT 1/2, 16-04-PLAN.md Task 1 (16-UI-SPEC.md
        Detailvertrag Punkt 1/4): dritte Grid-Spalte, im ausgelieferten HTML
        LEER. Ihren Inhalt bekommt sie AUSSCHLIESSLICH durchs Umhaengen im
        Skriptpfad (appendChild, keine Kopie) -- ohne Skript bleibt sie leer
        und unsichtbar, der gestapelte No-JS-Zustand aus Welle 3 bleibt
        dadurch unveraendert (die Systemabschnitte stehen weiterhin direkt
        in .holo, siehe unten). */}
    {/* (Der Behälter selbst steht seit Phase 17 NACH der Kennwerte-Leiste,
        siehe dort — die Kennwerte gehören unmittelbar unter den Raum, die
        Bauteilliste erst darunter. Die Systemabschnitte bleiben unverändert
        Kinder von .holo: D-02 verlangt sie im ausgelieferten HTML, und
        verify:shipconsole prüft genau das am statischen Artefakt.) */}

    {/* ===== Systemabschnitte — SCHRITT 2 + 4, D-02: JEDES vorhandene System
        steht als eigener, sichtbarer <section> im ausgelieferten HTML, ohne
        JavaScript, ohne Versteck-Attribut, ohne Vorlagenhuelle. arms/core
        uebernehmen ihren Koerper UNVERAENDERT aus dem fruehereren
        Ausstattungs-Kapitel (SCHRITT 4 -- der Umzug, keine zweite
        Aggregation derselben Aussage); prop/other bekommen die neue, aber
        strukturgleiche Stueckzahl-Liste (sysKindCounts). */}
    {holoData && holoData.groups.map((gr) => (
      <section class="holo__sys" id={`sys-${gr}`} data-g={gr} aria-label={t(`holo.grp.${gr}` as any)}>
        <h2 class="holo__sys-h">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={HOLO_GRP_ICON[gr]} /></svg>
          {t(`holo.grp.${gr}` as any)}
        </h2>
        <p class="holo__sys-ct">{t('ship.console.count').replace('%n%', String(sysPortCount(gr)))}</p>

        {gr === 'arms' && (
          <>
            {armStats.length > 0 && (
              <div class="arm__sum">
                {armStats.map((s) => (
                  <div class={`arm__scell${s.gold ? ' arm__scell--g' : ''}`}>
                    <b>{s.n}</b>
                    <span>{s.label}</span>
                    {s.range && <i>{s.range}</i>}
                  </div>
                ))}
                {turretDpsTotal && (
                  <div class="arm__scell">
                    <b>{turretDpsTotal} DPS</b>
                    <span>{t('arm.stat.totalDps')}</span>
                  </div>
                )}
              </div>
            )}
            <div class="arm__list">
              {armament.map((r) => (
                <div class={`arm__grp${r.gold ? ' arm__grp--g' : ''}`}>
                  <div class="arm__ghead">
                    <span class="arm__glabel">{r.label}</span>
                    {r.meta && <span class="arm__gmeta">{r.meta}</span>}
                    {r.value && <span class="arm__gval">{r.value}</span>}
                  </div>
                  {r.lines.length > 0 && (
                    <ul class="arm__lines">
                      {r.lines.map((l) => (
                        <li class="arm__line">
                          <span class="arm__n">{l.count}<i>×</i></span>
                          {l.size != null ? (
                            <span class="arm__size" style={`--s:${l.size}`}
                                  title={`${t('arm.sizeTip')} ${l.size}`}>
                              <em>S{l.size}</em>
                            </span>
                          ) : (
                            <span class="arm__size arm__size--n"><em>?</em></span>
                          )}
                          <span class="arm__name">
                            {l.name ?? <span class="arm__anon">{t('arm.weapon')}</span>}
                          </span>
                          {l.mount != null && l.size != null && (
                            l.mount > l.size ? (
                              <span class="arm__bdg arm__bdg--up"
                                    title={`${t('arm.mountTip')} S${l.mount} · ${t('arm.fittedTip')} S${l.size}`}>
                                {t('arm.upgrade')} S{l.mount}
                              </span>
                            ) : (
                              <span class="arm__bdg" title={`${t('arm.mountTip')} S${l.mount} · ${t('arm.fittedTip')} S${l.size}`}>
                                {t('arm.maxed')}
                              </span>
                            )
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                  {r.note && (
                    <p class="arm__note"><span>{t('arm.loadout')}</span>{r.note}</p>
                  )}
                </div>
              ))}
            </div>
            <p class="sd__hint">{t('ship.arms.hint')}</p>
          </>
        )}

        {gr === 'core' && slots.length > 0 && (
          <div class="sd__slots">
            {slots.map(([label, items]) =>
              items.map((it) => (
                <div class="sd__slot">
                  <div class="t">{label}</div>
                  <div class="n">{it.name}</div>
                  <span class="sd__hprow">
                    {it.size != null && <i class="sd__hp" style={`--hs:${it.size}`}>{it.size}</i>}
                    {it.count > 1 && <span class="sd__hpmore">×{it.count}</span>}
                  </span>
                </div>
              ))
            )}
          </div>
        )}

        {(gr === 'prop' || gr === 'other') && (
          <div class="holo__sys-list">
            {sysKindCounts(gr).map((kc) => (
              <div class="holo__sys-row">
                <b>{kc.n}×</b>
                <span>{kc.label}</span>
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    {/* ===== Inhaltsgruppen (D-01) — vormals .sd__chapter unterhalb der
        Konsole. Sie stehen jetzt in derselben Huelle wie die Portgruppen
        und damit im selben Behaelter: EINE Navigation, EINE Layoutsprache.
        Der Koerper jedes Abschnitts ist UNVERAENDERT uebernommen — nur die
        Kapitelkopfzeile (Nummer + sd__code) wurde zur Konsolenkopfzeile
        (holo__sys-h + holo__sys-ct). */}
    <!-- AUSSTATTUNG — traegt seit 16-03-PLAN.md SCHRITT 4 nur noch DREI statt
         vier Unterabschnitte (Masse & Fracht, Flugleistung, Verteidigung):
         Bewaffnung und die Bauteilliste sind vollstaendig in die Konsole
         gewandert. Jeder verbliebene Unterabschnitt behaelt seine eigene
         Bedingung einzeln (siehe gearDims/gearFlight/gearDefense oben) — ein
         karges Schiff zeigt weiterhin nur, wofuer es Daten gibt. Kein
         Kapitel-Icon: es gibt keinen bestehenden Icon-Pfad, der die
         zusammengefassten Themen als Ganzes vertritt (UI-SPEC fuehrt fuer
         diese Phase keine neuen Icons ein). -->
    {hasGear && (
      <section class="holo__sys" id="sys-spec" data-g="spec" aria-label={t('ship.ch.gear')}>
        <h2 class="holo__sys-h">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cgOf('spec').icon} /></svg>
          {cgOf('spec').label}
        </h2>
        <p class="holo__sys-ct">{cgOf('spec').code}</p>

    <!-- Kapitelinterne Zweispaltigkeit ab 1100px (14-04-PLAN.md Task 1):
         vier Unterabschnitte als 2x2-Raster, unter 1100px unveraendert
         einspaltig. Jede Bedingung bleibt UNVERAENDERT an ihrer Stelle --
         faellt eine weg, faellt ihre Zelle mit, die Platzierung rueckt nach. -->
    <div class="sd__ch2col">
    <!-- MASSE & FRACHT -->
    {gearDims && (
      <div class="sd__chsec">
        <h3 class="sd__sub"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={IC.masse} /></svg>{t('ship.dims.title')}</h3>
        <div class="sd__dims">
          <div>
            {viz.dims && (
              <>
                <div class="sd__glabel">{t('ship.dims.top')}</div>
                <div class="sd__footbox" style={`width:${viz.dims.footWidthPct}%;aspect-ratio:${viz.dims.footAspect}`} role="img"
                  aria-label={t('ship.dims.aria').replace('%l%', String(viz.dims.l)).replace('%w%', String(viz.dims.w))}></div>
                <div class="sd__footcap">{t('ship.abbr.l')} {viz.dims.l.toLocaleString(loc)} m · {t('ship.abbr.w')} {viz.dims.w.toLocaleString(loc)} m · {t('ship.abbr.h')} {viz.dims.h.toLocaleString(loc)} m</div>
                <!-- Die drei Masse-Balken (Laenge/Breite/Hoehe) entfallen ERSATZLOS
                     (D-02): ein Balken, der drei Groessen gegeneinanderstellt, die
                     nichts miteinander zu tun haben, vergleicht nichts — und
                     dieselben drei Zahlen stehen bereits als Text in der
                     Bildunterschrift direkt darueber (sd__footcap oben). Sie zu
                     Zahlen zu machen erzeugte genau die Doppelung, die D-03
                     verbietet. -->
              </>
            )}
          </div>
          <div>
            {viz.cargo && (
              <>
                <div class="sd__glabel">{t('ship.dims.cargo')}</div>
                <div class="sd__cargonum">{viz.cargo.scu.toLocaleString(loc)} SCU</div>
                <div class="sd__cubes">
                  {Array.from({ length: viz.cargo.cubes }).map(() => <span class="sd__cube"></span>)}
                </div>
                <div class="sd__footcap">■ = {viz.cargo.cubeVal} SCU{viz.cargo.ore && ` · ${t('ship.dims.oreExtra')}: ${viz.cargo.ore.toLocaleString(loc)} SCU`}</div>
              </>
            )}
            {viz.fuel.length > 0 && (
              <dl class="sd__grid" style={viz.cargo ? 'margin-top:1.2rem' : ''}>
                {viz.fuel.map((b) => (
                  <div class="sd__item">
                    <dt>{b.label}</dt>
                    <dd>{b.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      </div>
    )}

    <!-- BEWAFFNUNG ist VOLLSTAENDIG in die Konsole gewandert (16-03-PLAN.md
         SCHRITT 4, System "Bewaffnung", section.holo__sys[data-g="arms"]
         oben) -- steht ab jetzt nur noch an dieser einen Stelle der Seite.
         verify:shipcard Zusicherung 6 (Entdopplungs-Scan) sieht seit
         16-02-PLAN.md in BEIDE Bloecke (div.sd UND section.holo) und wuerde
         einen versehentlich hier belassenen Rest melden. -->

    <!-- FLUGLEISTUNG & QUANTUM -->
    {gearFlight && (
      <div class="sd__chsec">
        <h3 class="sd__sub"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={IC.flug} /></svg>{t('ship.flight.title')}</h3>
        {viz.speeds.length > 0 && (
          <dl class="sd__grid">
            {viz.speeds.map((b) => (
              <div class="sd__item">
                <dt>{b.label}</dt>
                <dd>{b.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {viz.agility.length > 0 && (
          <>
            <h4 class="sd__sub">{t('ship.flight.agility')}</h4>
            <dl class="sd__grid">
              {viz.agility.map((b) => (
                <div class="sd__item">
                  <dt>{b.label}</dt>
                  <dd>{b.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
        {viz.quantum.length > 0 && (
          <>
            <h4 class="sd__sub"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={IC.quantum} /></svg>{t('ship.flight.quantum')}</h4>
            <dl class="sd__qgrid">
              {viz.quantum.map((q) => (
                <div class="sd__item">
                  <dt>{q.label}</dt>
                  <dd>{q.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
      </div>
    )}

    <!-- VERTEIDIGUNG — vormals "Komponenten & Verteidigung"; die Bauteilliste
         (slots) ist VOLLSTAENDIG in die Konsole gewandert (System
         "Komponenten", section.holo__sys[data-g="core"] oben). Huelle/Schild
         sind aggregierte GANZSCHIFF-Kennzahlen ohne Einbauort und bleiben
         deshalb hier — sie verlieren dabei ihre bisherige, geteilte
         Ueberschrift und bekommen eine eigene (ship.defense.title,
         16-03-PLAN.md SCHRITT 4). Bleibt ein gewoehnliches Wertraster
         (sd__grid), KEINE Balkenspur — sonst reisst verify:shipcard
         Zusicherung 5 ("Balken nur, wo sie vergleichen"). -->
    {gearDefense && (
      <div class="sd__chsec">
        <h3 class="sd__sub"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d={IC.verteidigung} /></svg>{t('ship.defense.title')}</h3>
        <dl class="sd__grid">
          {viz.defense.map((b) => (
            <div class="sd__item">
              <dt>{b.label}</dt>
              <dd>{b.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
    </div>
      </section>
    )}
    <!-- KAUFEN IM VERSE -->
    <section class="holo__sys" id="sys-trade" data-g="trade" aria-label={t('ship.buy.title')}>
      <h2 class="holo__sys-h">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cgOf('trade').icon} /></svg>
        {cgOf('trade').label}
      </h2>
      <p class="holo__sys-ct">{cgOf('trade').code}</p>
      {buyMin ? (
        <>
          <div class="sd__pricehero">
            <span class="val">{aUEC(buyMin.price)}</span>
            <span class="at">{t('ship.buy.cheapest')} {buyMin.shop}, {buyMin.where}{buyMin.system && ` · ${buyMin.system}`}</span>
          </div>
          <div class="sd__shoprows">
            {prices!.buy.slice(0, MAX_ROWS).map((b) => (
              <div class="sd__shoprow">
                <span class="sd__shopname">{b.shop}</span>
                <span class="sd__shopwhere">{b.where}{b.system && <span class={`sd__sys sys-${b.system.toLowerCase()}`}>{b.system}</span>}</span>
                <span class="sd__shopprice">{aUEC(b.price)}</span>
              </div>
            ))}
          </div>
          {prices!.buy.length > MAX_ROWS && (
            <details class="sd__more">
              <summary>+{prices!.buy.length - MAX_ROWS} {t('ship.buy.more')}</summary>
              <div class="sd__shoprows">
                {prices!.buy.slice(MAX_ROWS).map((b) => (
                  <div class="sd__shoprow">
                    <span class="sd__shopname">{b.shop}</span>
                    <span class="sd__shopwhere">{b.where}{b.system && <span class={`sd__sys sys-${b.system.toLowerCase()}`}>{b.system}</span>}</span>
                    <span class="sd__shopprice">{aUEC(b.price)}</span>
                  </div>
                ))}
              </div>
            </details>
          )}
        </>
      ) : (
        <p class="sd__nobuy">{t('ship.buy.none')}</p>
      )}
      {rentMin && (
        <>
          <h3 class="sd__sub">{t('ship.rent.title')}</h3>
          <div class="sd__shoprows">
            {prices!.rent.slice(0, 4).map((r) => (
              <div class="sd__shoprow">
                <span class="sd__shopname">{r.shop}</span>
                <span class="sd__shopwhere">{r.where}{r.system && <span class={`sd__sys sys-${r.system.toLowerCase()}`}>{r.system}</span>}</span>
                <span class="sd__shopprice">{aUEC(r.price)} {t('ship.rent.perDay')}</span>
              </div>
            ))}
          </div>
        </>
      )}
      {d.msrpUSD != null && (
        <div class="sd__pledgerow">
          <span class="p">{t('ship.pledge')} ${d.msrpUSD.toLocaleString('en-US')}</span>
          {d.pledgeUrl && <a href={d.pledgeUrl} target="_blank" rel="noopener">{t('ship.pledge.store')}</a>}
        </div>
      )}
      <p class="sd__hint">{t('ship.buy.hint')}</p>
    </section>
    <!-- LEISTUNG -->
    {profile.length > 0 && (
      <section class="holo__sys" id="sys-rank" data-g="rank" aria-label={t('ship.profile.title')}>
        <h2 class="holo__sys-h">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={cgOf('rank').icon} /></svg>
          {cgOf('rank').label}
        </h2>
        <p class="holo__sys-ct">{cgOf('rank').code}</p>
        <div class="sd__prof">
          {profile.map((p) => (
            <div class="sd__profrow">
              <span class="sd__proflabel">{p.label}</span>
