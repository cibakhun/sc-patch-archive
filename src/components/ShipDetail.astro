<script type="importmap" is:inline>
{"imports":{"three":"/vendor/three/three.module.min.js","three/addons/":"/vendor/three/addons/"}}
</script>
<script is:inline>
// Kopf-Bühne mit drei Modi: Video (kuratiertes Commercial, YouTube on demand),
// Bilder (langsame Crossfade-Slideshow aus Hero + Paints) und Holo (3D-
// Komponenten-Hologramm, lazy). Der Umschalter unten rechts wählt den Modus;
// das Holo lädt erst bei Klick auf "3D-Holo" (bzw. wenn es der einzige Modus ist).
(function () {
  var stage = document.getElementById('holostage');
  if (!stage) return;
  var holoSec = document.getElementById('holo');
  var fig = document.getElementById('shipfig');
  var btnVid = document.getElementById('btnvid');
  var btnImg = document.getElementById('btnimg');
  var btn3d = document.getElementById('btn3d');
  var videoBox = document.getElementById('holovideo');
  var videoPoster = videoBox ? videoBox.querySelector('.holo__videoposter') : null;
  var localVideo = document.getElementById('hololocalvid'); // selbst-gehosteter Loop (Basher), sonst null
  var dots = document.getElementById('holodots');
  var status = document.getElementById('holostatus');
  var slides = fig ? [].slice.call(fig.querySelectorAll('img')) : [];
  var defaultMode = stage.getAttribute('data-default') || 'img';
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var mode = defaultMode;
  var viewer = null, loading = false;
  var showPanel = null; // vom Holo-Block gesetzt, sonst null

  // ---------- Modus-Umschaltung ----------
  function setPressed() {
    if (btnVid) btnVid.setAttribute('aria-pressed', String(mode === 'video'));
    if (btnImg) btnImg.setAttribute('aria-pressed', String(mode === 'img'));
    if (btn3d) btn3d.setAttribute('aria-pressed', String(mode === 'holo'));
  }
  function applyMode() {
    stage.classList.toggle('is-video', mode === 'video');
    stage.classList.toggle('is-3d', mode === 'holo');
    if (holoSec) holoSec.classList.toggle('is-3d-active', mode === 'holo');
    // Die Rail (nav.holo__rail, 16-03-PLAN.md Task 1) ist serverseitig immer
    // gerendert und braucht kein Ein-/Ausblenden je Modus mehr -- anders als
    // der fruehere schwebende Ebenen-Kasten, der nur ueber der Buehne Sinn
    // ergab. Der vormalige #holofilters-Sichtbarkeitsschalter ist deshalb
    // ersatzlos entfallen.
    if (mode === 'img') startSlideshow();
    // Video-Modus: selbst-gehostetes <video> (stummer Loop, kein Chrome) hat
    // Vorrang; sonst der YouTube-Pfad. Beim Verlassen jeweils pausieren.
    if (localVideo) {
      if (mode === 'video') { localVideo.muted = true; var p = localVideo.play(); if (p && p.catch) p.catch(function () {}); }
      else localVideo.pause();
    } else {
      if (mode === 'video') initVideo(); else pauseVideo();
    }
    setPressed();
  }
  function showVideo() { mode = 'video'; applyMode(); }
  function showImg() {
    mode = 'img'; applyMode();
    if (!loading) { stage.classList.remove('is-loading'); if (status) status.textContent = ''; }
    if (showPanel) showPanel(null);
    // Bühne darf nach dem Umschalten nicht dunkel sein: aktives Bild tot,
    // hängend oder gar keins intakt -> auf das erste fertige Bild wechseln
    // bzw. weiter eskalieren (Holo/Hinweis)
    if (slides.length && readyIdx() !== slideIdx) showFirstReady();
  }
  function showHolo() { mode = 'holo'; applyMode(); }
  if (btnVid) btnVid.addEventListener('click', showVideo);
  if (btnImg) btnImg.addEventListener('click', showImg);

  // ---------- Bilder-Slideshow (langsames Crossfade) ----------
  // GRUNDREGEL (User-Vorgabe): Die Bühne zeigt NUR Bilder, die WIRKLICH geladen
  // sind. Punkte UND Rotation richten sich nach den geladenen Bildern — NICHT
  // nach der optimistischen Server-Liste. Die Paints sind grosse FleetYards-
  // Blobs, die einzeln nachladen und teils fehlen; bis dahin dürfen sie weder
  // einen Punkt bekommen noch angeblendet werden. Effekt: 1 geladenes Bild ->
  // 1 Punkt (bzw. Punktleiste aus), kein Wechsel, NIE schwarz; weitere Punkte
  // erscheinen erst, sobald ihr Bild tatsächlich da ist.
  var slideTimer = null, slideIdx = 0;
  // data-src -> src erst bei Bedarf (sonst feuern alle Blobs gleichzeitig gegen
  // FleetYards und haengen); pro Tick wird genau EINES nachgezogen.
  function ensureLoaded(i) {
    var im = slides[i];
    if (im && !im.getAttribute('src') && im.dataset.src) im.src = im.dataset.src;
  }
  // Indizes der WIRKLICH geladenen, intakten Slides (DOM-Reihenfolge).
  function liveSlides() {
    var out = [];
    for (var i = 0; i < slides.length; i++) {
      var im = slides[i];
      if (!im.dataset.bad && im.getAttribute('src') && im.complete && im.naturalWidth > 0) out.push(i);
    }
    return out;
  }
  // Punkte spiegeln exakt die geladenen Bilder: ein Punkt je geladenes Bild,
  // aktiver markiert. < 2 geladene -> Punktleiste ganz aus (1 Bild = keine Show).
  function syncDots() {
    if (!dots) return;
    var live = liveSlides();
    for (var k = 0; k < dots.children.length; k++) {
      dots.children[k].style.display = live.indexOf(k) >= 0 ? '' : 'none';
      dots.children[k].classList.toggle('on', k === slideIdx);
    }
    dots.style.display = live.length >= 2 ? '' : 'none';
  }
  function paint(i) {
    for (var k = 0; k < slides.length; k++) slides[k].classList.toggle('is-active', k === i);
    syncDots();
    ensureLoaded(i); ensureLoaded((i + 1) % slides.length);
  }
  // Sobald ein Bild fertig lädt, wächst die Punktzahl mit — genau um die real
  // angekommenen Bilder.
  slides.forEach(function (im) { im.addEventListener('load', syncDots); });
  function startSlideshow() {
    ensureLoaded(slideIdx); ensureLoaded((slideIdx + 1) % slides.length);
    syncDots();
    if (slideTimer || reduce) return;
    slideTimer = setInterval(function () {
      if (mode !== 'img' || document.hidden) return;
      var r = stage.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return; // offscreen -> pausieren
      // Nächstes noch ungeladenes intaktes Bild anstossen (lazy, kein Hammer):
      // so wächst die Show, ohne alle Blobs gleichzeitig zu ziehen.
      for (var j = 1; j <= slides.length; j++) {
        var c = (slideIdx + j) % slides.length;
        if (!slides[c].dataset.bad && !slides[c].getAttribute('src') && slides[c].dataset.src) { ensureLoaded(c); break; }
      }
      // NUR unter geladenen Bildern weiterschalten -> nie auf ein leeres/ladendes.
      var live = liveSlides();
      if (live.length < 2) return; // nur 1 Bild -> nichts zu wechseln, bleibt stehen
      var pos = live.indexOf(slideIdx);
      var next = pos < 0 ? live[0] : live[(pos + 1) % live.length];
      if (next === slideIdx) return;
      slideIdx = next; paint(slideIdx);
    }, 6000);
  }

  // ---------- Kaputte Bilder: Kette Ersatz-Thumb -> nächstes Bild -> Holo -> Hinweis ----------
  // Externe Bild-URLs (Wiki/FleetYards) können jederzeit sterben. Der inline-
  // onerror am <img> probiert erst data-fb (kleineres Wiki-Thumb) und markiert
  // das Bild sonst als bad+unsichtbar. Hier die Stufen danach — eine dauerhaft
  // schwarze Bühne darf es nicht geben.
  var autoHolo = null; // wird im Holo-Block auf start() gesetzt, wenn 3D verfügbar
  var holoTried = false; // Schleifen-Schutz: Holo-Fehlschlag -> showImg -> nicht erneut Holo
  function goodSlides() {
    return slides.filter(function (im) { return !im.dataset.bad; });
  }
  function escalateNoImages() {
    if (viewer) { showHolo(); return; }
    if (autoHolo && !holoTried) { holoTried = true; autoHolo(false); return; }
    // Kein Holo -> ehrlicher Hinweis. Video-/3D-Modus MUSS verlassen werden,
    // sonst versteckt .holo__stage.is-video .holo__none{display:none} den Text
    // (bildloses Schiff mit totem Video, z. B. Basher -> sonst schwarz).
    stage.classList.remove('is-video', 'is-playing');
    if (holoSec) holoSec.classList.remove('is-3d-active');
    if (btnVid) btnVid.style.display = 'none';
    mode = 'img';
    if (fig && !fig.querySelector('.holo__none')) {
      var sp = document.createElement('span');
      sp.className = 'holo__none';
      sp.textContent = stage.getAttribute('data-novisual') || '';
      fig.appendChild(sp);
    }
  }
  // Erstes Bild, das intakt UND fertig geladen ist — nur auf solche wird
  // gewechselt. is-active auf einem noch leeren lazy-Bild = schwarze Bühne
  // (FleetYards-Blobs können zudem lange hängen), genau das darf nie passieren.
  function readyIdx() {
    for (var i = 0; i < slides.length; i++) {
      var im = slides[i];
      if (!im.dataset.bad && im.getAttribute('src') && im.complete && im.naturalWidth > 0) return i;
    }
    return -1;
  }
  // Läuft im Bilder-Modus (volle Kette bis Holo/Hinweis) UND im Video-Modus
  // (nur painten — die Bilder sind dort der Backdrop bis zum Playstart, das
  // Video bleibt zuständig, es wird nie weg-eskaliert). Holo: nichts zu tun.
  var waitTimer = null;
  function showFirstReady() {
    if (mode === 'holo') return;
    var good = goodSlides();
    if (!good.length) { if (mode === 'img') escalateNoImages(); return; }
    var r = readyIdx();
    if (r >= 0) { slideIdx = r; paint(r); return; }
    // Nichts fertig: Laden der intakten anstoßen und kurz nachhalten; kommt
    // binnen 8 s keins an (tote/hängende Quellen), weiter zu Holo/Hinweis.
    good.slice(0, 2).forEach(function (im) { ensureLoaded(slides.indexOf(im)); });
    if (waitTimer) return;
    var t0 = Date.now();
    waitTimer = setInterval(function () {
      if (mode === 'holo') { clearInterval(waitTimer); waitTimer = null; return; }
      var i = readyIdx();
      if (i >= 0) { clearInterval(waitTimer); waitTimer = null; slideIdx = i; paint(i); return; }
      if (!goodSlides().length || Date.now() - t0 > 8000) {
        clearInterval(waitTimer); waitTimer = null;
        if (mode === 'img') escalateNoImages();
      }
    }, 400);
  }
  function slideFailed(im) {
    if (mode === 'holo') return; // 3D läuft sichtbar weiter; showImg() heilt beim Umschalten
    // Totes Hintergrund-Bild stört nicht, solange das aktive intakt ist
    if (!im.classList.contains('is-active') && goodSlides().length) return;
    showFirstReady();
  }
  slides.forEach(function (im) {
    im.addEventListener('error', function () {
      // Der inline-Handler lief zuerst: entweder hat er den Ersatz-Thumb
      // eingesetzt (kein bad -> neuer Ladeversuch läuft) oder bad gesetzt.
      if (im.dataset.bad) slideFailed(im);
    });
  });
  // Letzte, SELBSTSTÄNDIGE Verteidigungslinie gegen JEDEN dunklen Bühnenzustand
  // — unabhängig davon, ob YouTube-Events/Fallback-Timer wie erwartet feuern
  // (die tun es nicht immer, s. Basher/A1). Alle 2 s wird geprüft, ob WIRKLICH
  // etwas Sichtbares auf der Bühne ist. Drei gültige Sicht-Quellen:
  //   • ein fertig geladenes aktives Bild (Video-Modus hat einen Bild-Boden),
  //   • ein Video mit BESTÄTIGT laufenden Frames (posterFaded — nicht die bloße
  //     is-playing-Klasse, die auch bei schwarz hängendem Player gesetzt wird),
  //   • ein TATSÄCHLICH sichtbarer Hinweis (Existenz reicht nicht: im Video-
  //     Modus ist .holo__none per CSS display:none).
  // Fehlt alles: Bild-Schiffe sofort auf das erste fertige Bild heilen; bildlose
  // Video-Schiffe erst nach ~8 s Kulanz (Video darf laden) zu Holo/Hinweis
  // eskalieren — escalateNoImages verlässt dafür den Video-Modus.
  var darkTicks = 0;
  setInterval(function () {
    if (document.hidden) return;
    if (mode === 'holo') return;
    var a = slides[slideIdx];
    var imgOk = !!(a && a.classList.contains('is-active') && !a.dataset.bad &&
      a.getAttribute('src') && a.complete && a.naturalWidth > 0);
    var videoOk = mode === 'video' && posterFaded;
    var none = fig && fig.querySelector('.holo__none');
    var hintOk = !!(none && getComputedStyle(none).display !== 'none');
    if (imgOk || videoOk || hintOk) { darkTicks = 0; return; }
    darkTicks++;
    if (goodSlides().length) showFirstReady();
    else if (darkTicks >= 4) escalateNoImages();
  }, 2000);

  // ---------- Video: YouTube-IFrame-API -> stummes Autoplay im Video-Modus ----------
  // Der rohe iframe-Embed scheiterte auf localhost mit "Fehler 153"
  // (fehlender origin). Die offizielle IFrame-API konfiguriert den Player
  // korrekt, erlaubt browser-konformes Muted-Autoplay und meldet Fehler sauber.
  var ytPlayer = null, ytLoading = false, ytReady = false, playStarted = false;
  // posterFaded = das Standbild wurde weggeblendet, WEIL das Video nachweislich
  // Frames liefert. Erst dann gilt die Bühne im Video-Modus als "sichtbar"
  // (Dunkelheits-Wächter oben). Bloßes is-playing reicht nicht — es wird laut
  // A1 Spirit auch bei schwarz hängendem Player gesetzt.
  var posterFaded = false, confirmTimer = null;
  function fadePoster() {
    if (videoPoster) { videoPoster.style.opacity = '0'; videoPoster.style.pointerEvents = 'none'; }
  }
  // Poster (Schiffs-Standbild) NUR wegblenden, wenn ZWEI Dinge zutreffen:
  //  1. getCurrentTime läuft wirklich vorwärts (ct > startT+0.4) — der einzige
  //     verlässliche Beleg für echte Frames; ein PLAYING, das dann schwarz
  //     hängt (YouTube-Flakiness, A1 Spirit), hält so das Standbild oben.
  //  2. seit dem Abspielstart sind ~5 s vergangen (ticks >= 20 × 250 ms) —
  //     YouTubes Start-Chrome (Play-Icon, Titel-Einblendung oben) hält je nach
  //     Browser/Netz unterschiedlich lange; bei 3 s fing der 0,9-s-Poster-Fade
  //     es noch ein (User sah das Icon ~0,5 s). 5 s gibt sicheren Abstand — das
  //     Standbild ist ein Schiffsbild, für ein Ambient-Loop unkritisch. Es gibt
  //     KEIN verlässliches "Chrome weg"-Signal, daher zeitbasiert grosszügig.
  // Kommt binnen ~10 s kein Fortschritt, taugt das Video nicht -> Bilder/Holo.
  function confirmThenFadePoster() {
    if (posterFaded || confirmTimer) return;
    var startT = -1, ticks = 0;
    confirmTimer = setInterval(function () {
      ticks++;
      var ct = 0, ps = -1;
      try { ct = ytPlayer.getCurrentTime(); ps = ytPlayer.getPlayerState(); } catch (e) {}
      if (startT < 0 && ps === 1) startT = ct;
      if (startT >= 0 && ps === 1 && ct > startT + 0.4 && ticks >= 20) {
        // Belegt: echte Frames laufen UND ~5 s vorbei (Chrome weg) -> Poster weg
        clearInterval(confirmTimer); confirmTimer = null; posterFaded = true; fadePoster();
      } else if (ticks >= 40 && !goodSlides().length) {
        // NUR bildlose Schiffe: Video liefert nach ~8 s keine Frames und es gibt
        // kein Standbild -> zu Holo/Hinweis ausweichen statt Schwarz. Schiffe MIT
        // Bild lassen das Standbild einfach oben (nie schwarz); der Timer läuft
        // weiter und blendet, falls das Video doch noch Frames liefert.
        clearInterval(confirmTimer); confirmTimer = null;
        stage.classList.remove('is-playing');
        if (btnVid) btnVid.style.display = 'none';
        escalateNoImages();
      }
    }, 250);
  }
  function loadYT() {
    return new Promise(function (res) {
      if (window.YT && window.YT.Player) return res();
      var prev = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = function () { if (prev) { try { prev(); } catch (e) {} } res(); };
      if (!document.getElementById('yt-iframe-api')) {
        var s = document.createElement('script');
        s.id = 'yt-iframe-api';
        s.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(s);
      }
    });
  }
  function initVideo() {
    if (!videoBox) return;
    if (ytPlayer) { if (ytReady) { try { ytPlayer.mute(); ytPlayer.playVideo(); } catch (e) {} } return; }
    if (ytLoading) return;
    var vid = videoBox.getAttribute('data-vid');
    if (!vid) return;
    // Poster-Preflight: das Poster ist ein CSS-Background OHNE onerror — eine
    // tote URL würde beim Playstart-Übergang 3 s lang dunkel übers Video legen.
    if (videoPoster) {
      var bg = ((videoPoster.style.backgroundImage || '').match(/url\(["']?(.+?)["']?\)/) || [])[1];
      if (bg) {
        var probe = new Image();
        probe.onerror = function () { videoPoster.style.background = 'transparent'; };
        probe.src = bg;
      }
    }
    var shield = document.getElementById('holovideoshield');
    ytLoading = true;
    loadYT().then(function () {
      ytPlayer = new YT.Player('holoplayer', {
        videoId: vid,
        host: 'https://www.youtube-nocookie.com',
        playerVars: {
          // Ambient-Video: IMMER stummes Autoplay ohne jede Player-UI — auch
          // bei prefers-reduced-motion (frueher gab es dort einen Player MIT
          // Controls; genau diese Icons sollen nie zu sehen sein — der Modus
          // bleibt ueber die Umschalter abwaehlbar). KEIN programmatisches
          // playVideo() -> YouTube zeigt keinen bleibenden Play/Pause-Button;
          // das kurze Start-Symbol liegt unter dem Poster.
          autoplay: 1, mute: 1, playsinline: 1,
          controls: 0, disablekb: 1, fs: 0, iv_load_policy: 3,
          rel: 0, modestbranding: 1, start: 4, origin: location.origin,
        },
        events: {
          onReady: function (e) {
            ytReady = true;
            // Nur Stummschaltung sicherstellen; Start/Position macht das native
            // Autoplay + start-Param. Kein playVideo()/seekTo() -> kein Button.
            try { e.target.mute(); } catch (er) {}
            // Nahtlos-Loop: kurz VOR dem Ende zurueckspringen, damit YouTubes
            // Endscreen (Vorschlags-Kacheln) nie aufblitzt. Der ENDED-Zweig in
            // onStateChange bleibt als Fallback, falls ein Tick das Fenster
            // verpasst (Tab gedrosselt o. ae.).
            setInterval(function () {
              try {
                if (!ytPlayer || ytPlayer.getPlayerState() !== 1) return;
                var d = ytPlayer.getDuration();
                if (d > 0 && ytPlayer.getCurrentTime() > d - 0.9) ytPlayer.seekTo(3.8, true);
              } catch (er) {}
            }, 500);
          },
          onStateChange: function (e) {
            // Poster (Standbild) NICHT mehr zeitbasiert wegblenden, sondern erst
            // wenn getCurrentTime nachweislich vorwärtsläuft (confirmThenFadePoster).
            // Das YouTube-Start-Chrome liegt bis dahin unter dem Poster; ein
            // schwarz hängendes PLAYING (A1 Spirit) blendet das Standbild NIE weg.
            if (e.data === 1) { playStarted = true; stage.classList.add('is-playing'); confirmThenFadePoster(); }
            // Endlosschleife OHNE playlist-Param (der sonst Zurück/Weiter-Buttons zeigt):
            // am Ende (0) einfach zurück an 3,8 s und weiterspielen
            else if (e.data === 0) { try { e.target.seekTo(3.8, true); e.target.playVideo(); } catch (er) {} }
          },
          onError: function (e) {
            // Video nicht abspielbar (Region/Embed/Netz) -> auf Bilder ausweichen,
            // damit kein YouTube-Fehlerbildschirm stehen bleibt; ganz ohne
            // Bilder weiter zu Holo/Hinweis (escalateNoImages) statt Schwarz
            console.warn('YT player error', e && e.data);
            // is-playing-Latch loesen: ein totes Video darf nie als "sichtbar"
            // gelten (sonst haelt es den Dunkelheits-Waechter still)
            stage.classList.remove('is-playing');
            fadePoster();
            if (btnVid) btnVid.style.display = 'none';
            showImg();
            if (!slides.length) escalateNoImages();
          },
        },
      });
      // Fallback: bleibt Autoplay wider Erwarten blockiert, NICHT den Player
      // samt YouTube-UI freischalten (es soll nie Player-Chrome zu sehen sein),
      // sondern auf die Bilder-Galerie ausweichen; ganz ohne Bilder zu Holo/
      // Hinweis (escalateNoImages) statt den nackten schwarzen Player zu zeigen.
      setTimeout(function () {
        if (playStarted) return;
        stage.classList.remove('is-playing');
        if (btnVid) btnVid.style.display = 'none';
        fadePoster();
        showImg();
        if (!slides.length) escalateNoImages();
      }, 7000);
    });
  }
  function pauseVideo() {
    if (ytPlayer && ytReady) { try { ytPlayer.pauseVideo(); } catch (e) {} }
  }
  // Tab-Rueckkehr: YouTube pausiert Videos in Hintergrund-Tabs — beim
  // Sichtbarwerden laeuft das Ambient-Video im Video-Modus sonst nicht wieder
  // an und es bliebe ein Standbild stehen (API-play zeigt kein Overlay-Icon,
  // anders als ein Klick auf den Player).
  document.addEventListener('visibilitychange', function () {
    if (document.hidden || mode !== 'video') return;
    if (localVideo) { localVideo.muted = true; var p = localVideo.play(); if (p && p.catch) p.catch(function () {}); }
    else if (ytPlayer && ytReady) { try { ytPlayer.mute(); ytPlayer.playVideo(); } catch (e) {} }
  });

  // ---------- Holo (nur wenn Holodaten vorhanden) ----------
  var dataEl = document.getElementById('holodata');
  if (dataEl) {
    var cfg = JSON.parse(dataEl.textContent);
    var wrap = document.getElementById('holo3d');
    var panel = document.getElementById('holopanel');
    var pclose = document.getElementById('holopclose');
    var loadingTpl = stage.getAttribute('data-loading') || '3D-Modell lädt … %p% %';
    var errorTxt = stage.getAttribute('data-error') || '3D-Modell konnte nicht geladen werden.';
    var debug = /[?&]holodebug/.test(location.search);
    // Messhandle fuer scripts/probes/schiffskonsole-messung.mjs (16-01-PLAN.md
    // Task 2) — ausdruecklich NICHT an holodebug gehaengt: dessen Zweig haengt
    // einen AxesHelper an rig VOR der Bildung von fitSphere (holo-viewer.js
    // Z. 609 f.), wer darueber misst, misst eine andere Kamera als der
    // Besucher sieht. Eigene Adressmarke, keine Geometrie.
    var metricsMode = /[?&]holometrics/.test(location.search);

    // ---------- Konsole: Rail-Einfachauswahl + Umhaengen ohne Dopplung
    // (16-04-PLAN.md Task 1, SCHRITT 2/3) ----------
    var railEl = document.getElementById('holorail');
    var readoutEl = document.getElementById('holoreadout');
    var sysEls = [].slice.call(document.querySelectorAll('.holo__sys'));
    // Portgruppe = traegt Marker auf der Buehne. cfg.groups ist dafuer die
    // einzige Quelle; die Inhaltsgruppen (D-01) stehen bewusst NICHT darin,
    // damit dieser Test sie ohne eigene Liste erkennt.
    var isPortGroup = function (gr) {
      return !!cfg.groups && cfg.groups.indexOf(gr) !== -1;
    };
    // Vorbelegung bleibt die erste PORTgruppe. Nur wenn es gar keine gibt
    // (Schiff ohne Mesh), uebernimmt der erste vorhandene Abschnitt — sonst
    // stuende die Auslesung beim Laden leer da.
    var activeGroup = (cfg.groups && cfg.groups[0])
      || (sysEls.length ? sysEls[0].getAttribute('data-g') : null);
    var showGroup = null;
    if (railEl && readoutEl && sysEls.length) {
      // VERSCHIEBEN, nicht kopieren: appendChild entfernt den Knoten aus
      // seiner alten Position (Kind von .holo bzw. .holo__stage) und haengt
      // ihn an die neue (Kind von .holo__readout) — derselbe Knoten, kein
      // zweiter im DOM. Kein Bauteiltext steht danach zweimal (Detailvertrag
      // Punkt 6.2). Die Detailkarte (panel, Task 2) wandert mit — beide
      // Zustaende der Auslesung leben ab jetzt in EINEM Behaelter.
      for (var si = 0; si < sysEls.length; si++) readoutEl.appendChild(sysEls[si]);
      /* ⚠ Die DETAILKARTE wandert NICHT mit in die Auslesung.
         Bis Phase 17 lagen Auslesung und Buehne nebeneinander, die Karte war
         also neben dem Schiff sichtbar. Im Raum liegt die Auslesung UNTER der
         Buehne — gemessen oeffnete ein Klick auf einen Marker die Karte bei
         y=901 in einem 900px hohen Fenster, also ausserhalb des Bildes. Die
         Antwort auf einen Klick darf nicht unsichtbar sein.
         Ab genuegend breiter Leinwand bleibt sie deshalb IM Raum und schwebt
         als Glaskarte am rechten Rand (CSS .holo .holo__panel). Auf schmalen
         Geraeten, wo eine schwebende Karte den halben Rumpf deckte, wandert
         sie weiterhin in die Auslesung — dieselbe Schwelle wie bei den
         Dauer-Beschriftungen. */
      var karteImRaum = (function () {
        var c = document.querySelector('#holo3d canvas');
        return c ? c.getBoundingClientRect().width >= 900 : window.innerWidth >= 900;
      })();
      if (panel && !karteImRaum) readoutEl.appendChild(panel);
      showGroup = function (gr) {
        activeGroup = gr;
        for (var i = 0; i < sysEls.length; i++) {
          sysEls[i].hidden = sysEls[i].getAttribute('data-g') !== gr;
        }
        var links = railEl.querySelectorAll('a');
        for (var j = 0; j < links.length; j++) {
          if (links[j].getAttribute('data-g') === gr) links[j].setAttribute('aria-current', 'true');
          else links[j].removeAttribute('aria-current');
        }
        // Ein Gruppenwechsel faellt immer auf den Gruppen-Zustand zurueck
        // (Detailvertrag Punkt 4b) — unabhaengig davon, ob der Viewer schon
        // geladen ist. viewer.setFilter() wuerde das ohnehin ueber seinen
        // eigenen onSelect(null)-Rueckruf erledigen, aber NUR wenn der
        // Viewer schon existiert; hier steht es deshalb explizit und
        // bedingungslos, nicht als Nebenwirkung eines anderen Aufrufs.
        if (panel) panel.hidden = true;
        // Genau EIN Gruppenname (16-UI-SPEC.md Detailvertrag Punkt 3.1) —
        // die Buehne zeigt danach nie mehr als eine Gruppe gleichzeitig.
        // viewer kann noch null sein (D-04: laedt erst beim Scrollen);
        // start() unten holt die aktuelle Auswahl nach, sobald es soweit ist.
        //
        // Portgruppe -> genau ihre Marker. Inhaltsgruppe -> GAR KEINE.
        //
        // ⚠ Bis Phase 17 liess eine Inhaltsgruppe die Buehne unangetastet —
        // wer "Kaufen" waehlte, sah weiterhin die Marker der zuvor gewaehlten
        // Portgruppe samt Beschriftung (gemessen: 5 Marker, 2 Kaesten aus
        // "Sonstiges"). Das Schiff behauptete damit etwas, das mit der Frage
        // nichts zu tun hat. Zu "Kaufen" gibt es kein Bauteil, auf das man
        // zeigen koennte — also zeigt der Raum den blanken Rumpf, und die
        // Antwort steht in der Auslesung darunter.
        // (Das Schiff selbst verschwindet dabei NICHT: setFilter betrifft nur
        // die Marker-Sprites, nicht das Modell.)
        if (viewer) viewer.setFilter(isPortGroup(gr) ? [gr] : []);
        // Herkunftszeile nur, wo ueberhaupt Positionen gezeigt werden.
        var srcEl = document.getElementById('holosrc');
        if (srcEl) srcEl.classList.toggle('is-off', !isPortGroup(gr));
      };
      railEl.addEventListener('click', function (ev) {
        var a = ev.target.closest ? ev.target.closest('a[data-g]') : null;
        if (!a) return;
        ev.preventDefault();
        var gr = a.getAttribute('data-g');
        if (gr !== activeGroup) showGroup(gr);
      });
      // Vorbelegung (Detailvertrag Punkt 2) ist bereits serverseitig
      // sichtbar (erstes System ungefiltert, Rail-Eintrag traegt schon
      // aria-current="true") — hier nur den JS-Zustand synchron dazu setzen,
      // damit ein spaeterer Klick auf denselben Eintrag korrekt no-opt.
      if (activeGroup) showGroup(activeGroup);
    }

    var row = function (id, val) {
      var r = document.getElementById(id + 'row'), d = document.getElementById(id);
      if (!r || !d) return;
      if (val == null || val === '') { r.hidden = true; }
      else { d.textContent = val; r.hidden = false; }
    };
    // Auslesung, Einzel-Zustand (16-04-PLAN.md Task 2, 16-UI-SPEC.md
    // Detailvertrag Punkt 4b) — der Rueckweg in den Gruppen-Zustand:
    // den aktuell aktiven Systemabschnitt (activeGroup, von showGroup
    // gepflegt) wieder sichtbar machen. Kein eigener Knopf noetig — der
    // Viewer ruft diesen Rueckruf bereits mit i=null bei Klick auf freie
    // Buehnenflaeche UND bei setFilter(), wenn der gewaehlte Marker aus der
    // sichtbaren Gruppe faellt (holo-viewer.js showGroup()/setFilter()).
    var showGroupState = function () {
      if (!activeGroup) return;
      for (var gi = 0; gi < sysEls.length; gi++) {
        sysEls[gi].hidden = sysEls[gi].getAttribute('data-g') !== activeGroup;
      }
    };
    showPanel = function (i) {
      if (i == null || !cfg.ports[i]) {
        panel.hidden = true;
        showGroupState();
        if (viewer) viewer.select(null);
        return;
      }
      var p = cfg.ports[i];
      var kind = cfg.kinds[p.k] || p.k;
      panel.setAttribute('data-g', p.g);
      var grpEl = document.getElementById('hpgrp');
      if (grpEl) grpEl.textContent = (cfg.grpLabels && cfg.grpLabels[p.g]) || '';
      var iconPath = document.querySelector('#hpicon path');
      if (iconPath) iconPath.setAttribute('d', (cfg.icons && cfg.icons[p.k]) || '');
      document.getElementById('hpkind').textContent = kind;
      var nameEl = document.getElementById('hpname');
      nameEl.textContent = (p.label && p.label !== kind) ? p.label : '';
      nameEl.hidden = !nameEl.textContent;
      document.getElementById('hpsize').textContent = p.size != null ? 'S' + p.size : '—';
      row('hpcat', p.cat || null);
      row('hpprice', p.price != null ? p.price.toLocaleString(cfg.loc) + ' ' + (panel.getAttribute('data-auec') || 'aUEC') : null);
      row('hpshops', p.shops ? String(p.shops) : null);
      var link = document.getElementById('hplink');
      if (p.iid && cfg.finder) {
        link.href = cfg.finder + '?item=' + encodeURIComponent(p.iid);
        link.hidden = false;
      } else link.hidden = true;
      var note = document.getElementById('hpnote');
      var noteTxt = p.np ? panel.getAttribute('data-np') : (p.est ? panel.getAttribute('data-est') : '');
      note.textContent = noteTxt;
      note.hidden = !noteTxt;
      // Einzel-Zustand: der Gruppen-Zustand tritt zurueck (Detailvertrag
      // Punkt 4b) — alle Systemabschnitte verstecken, nur die Karte zeigen.
      for (var hi = 0; hi < sysEls.length; hi++) sysEls[hi].hidden = true;
      panel.hidden = false;
      if (viewer) viewer.select(i);
    };

    var start = function (explicit) {
      if (viewer || loading) return;
      loading = true;
      stage.classList.add('is-loading');
      status.textContent = loadingTpl.replace('%p%', '0');
      import(stage.getAttribute('data-holo-src') || '/assets/holo-viewer.js')
        .then(function (m) {
          return m.initHolo(wrap, {
            url: cfg.url, ports: cfg.ports, mesh: cfg.mesh, ax: cfg.ax,
            defaultOn: cfg.defaultOn, debug: debug, kinds: cfg.kinds,
            onProgress: function (p) { status.textContent = loadingTpl.replace('%p%', p); },
            onSelect: showPanel,
          });
        })
        .then(function (v) {
          viewer = v; loading = false;
          if (metricsMode) window.__holoViewer = v;
          status.textContent = '';
          stage.classList.remove('is-loading');
          showHolo();
          // Konsole (16-04-PLAN.md Task 1): initHolo() selbst kennt nur den
          // server-berechneten cfg.defaultOn (Mehrfachauswahl, alter Stand).
          // Die Rail kann laengst umgeschaltet haben, waehrend der Viewer
          // noch lud (D-04 laedt erst beim Scrollen) — hier den tatsaechlich
          // aktiven Rail-Stand nachholen, damit die Buehne von Anfang an nur
          // GENAU eine Gruppe zeigt, nie die alte Mehrfachauswahl.
          // Dieselbe Einschraenkung wie in showGroup(): steht gerade eine
          // Inhaltsgruppe (D-01) offen, waehrend der Viewer fertig laedt,
          // darf sein Erstfilter die Buehne nicht leeren.
          if (activeGroup && isPortGroup(activeGroup)) viewer.setFilter([activeGroup]);
          // Mobil: die Beschriftungsschicht bleibt AN (Kurskorrektur, 15-01-
          // PLAN.md Task 2 — der vorherige Kommentar an dieser Stelle wollte
          // sie per setLabels(false) ganz abschalten, mit der Begruendung,
          // ein einzelner Auswahl-Kasten koenne mit dem Ebenen-Panel
          // ueberlappen). Das widersprach P-2 (16-UI-SPEC.md § 3a): P-2 gilt
          // "fuer ALLE Gruppen einschliesslich core" OHNE Ausnahme fuer
          // schmale Buehnen, und Messgruppe f-dauerlabels der Sonde prueft
          // GENAU DAS bei 414px und 360px mit — mit setLabels(false) blieb
          // der Kasten nach Antippen/Ueberfahren leer (0 statt 1 sichtbarer
          // Kasten, gemessen bei allen drei Pruefschiffen). Da seit P-2 nie
          // mehr als EIN Kasten gleichzeitig sichtbar ist, ist die
          // Ueberfuellungs-Sorge von damals (viele Dauer-Labels auf kleinem
          // Bildschirm) gegenstandslos. Der fruehere, hier ANSCHLIESSENDE
          // mobile Einklapp-Zweig fuer den Ebenen-Kasten (#holofilters) ist
          // mit dessen Ersetzung durch die Rail entfallen (16-03-PLAN.md
          // Task 1, SCHRITT 3) — die Rail hat keinen eingeklappten Zustand.
        })
        .catch(function (e) {
          console.error(e);
          loading = false;
          showImg();
          if (explicit) { stage.classList.add('is-loading'); status.textContent = errorTxt; }
        });
    };

    autoHolo = start; // Eskalationsziel, wenn alle Galerie-Bilder tot sind
    // #btn3d bleibt als Modusumschaltung aktiv, DARF weiterhin laden, aber
    // ist ab jetzt ein Rueckfallweg, kein Hauptweg mehr (16-04-PLAN.md Task
    // 3, AENDERUNG 1): wer auf Video/Bilder umgeschaltet hatte und dann
    // explizit "3D-Holo" drueckt, bevor der Beobachter unten ausgeloest hat,
    // soll nicht auf den naechsten Scroll warten muessen.
    if (btn3d) btn3d.addEventListener('click', function () { viewer ? showHolo() : start(true); });
    if (pclose) pclose.addEventListener('click', function () { showPanel(null); });
    // Der fruehere Klick-Handler auf #holofilters (Mehrfachauswahl ->
    // viewer.setFilter()) ist mit dem Ebenen-Kasten selbst entfallen
    // (16-03-PLAN.md Task 1, SCHRITT 3). Die Rail ist in dieser Welle eine
    // reine Anker-Liste ohne Skript-Interaktion; die Einfachauswahl mit
    // Buehnen-Umschaltung ist Welle 4 (16-UI-SPEC.md Detailvertrag Punkt 5).

    // ---------- Laden beim Scrollen, kein Startknopf (16-04-PLAN.md Task 3,
    // AENDERUNG 1 -- D-04, Erfolgskriterium 5) ----------
    // GENAU EIN Beobachter auf .holo (dem Rasterbehaelter, nicht nur der
    // Buehne) loest start() GENAU EINMAL aus, sobald die Konsole in den
    // sichtbaren Bereich scrollt -- dasselbe Beobachter-Muster, das
    // holo-viewer.js bereits fuer die Render-Loop-Pause benutzt (dort
    // threshold 0.02, pausiert/setzt fort; hier threshold 0.1, feuert
    // einmal und trennt sich sofort). Die Zeile, die bisher sofort laedt,
    // wenn Holo der einzige Modus ist ("if (defaultMode === 'holo')
    // start(false)"), ist ERSATZLOS entfallen -- sie verletzte
    // Erfolgskriterium 5 fuer jedes Schiff ohne Video/Galerie (das war die
    // grosse Mehrheit): 0 Byte Netzverkehr beim Seitenaufruf war fuer diese
    // Schiffe vorher nie erreichbar.
    if (holoSec && typeof IntersectionObserver !== 'undefined') {
      var loadObserver = new IntersectionObserver(
        function (entries) {
          for (var oi = 0; oi < entries.length; oi++) {
            if (entries[oi].isIntersecting) {
              start(false);
              loadObserver.disconnect();
              break;
            }
          }
        },
        { threshold: 0.1 }
      );
      loadObserver.observe(holoSec);
    } else {
      // Kein IntersectionObserver im Browser: sofortiges Laden ist besser
      // als ein dauerhaft leerer Rumpf, den niemand je fuellt.
      start(false);
    }
  }

  // Start-Watchdog (autoHolo ist ab hier gesetzt): das aktive Bild kann schon
  // vor diesem Script gestorben sein (nur der inline-onerror lief) ODER es
  // hängt einfach (kein error-Event!) — beides deckt derselbe Check ab: ist
  // das aktive Bild nicht das erste fertige, zeigt showFirstReady das erste,
  // das ankommt, und eskaliert im Bilder-Modus notfalls zu Holo/Hinweis.
  if (slides.length && readyIdx() !== slideIdx) showFirstReady();
  applyMode();
})();
</script>
</Layout>
