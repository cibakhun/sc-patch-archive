---
// Freunde, Anfragen und Vorschläge — echte Daten aus Supabase.
//
// Tabellen: friends (eine Zeile je Freundschaft, beide Seiten sehen sie per RLS)
// und friend_requests (pending; Clients legen an und löschen, ändern nie).
// Anzeige-Profile kommen aus der View social_profiles (nur Profile MIT Handle,
// nur für eingeloggte Nutzer; Präsenz und Aktivität nur unter Freunden,
// Discord-Rang nur mit verknüpftem Konto auf dem Server).
// presence ist dort null, wenn der andere seinen Status diesem Nutzer nicht
// zeigt (profiles.presence_visibility, Vorgabe nur Freunde): dann kein Punkt.
// Annehmen läuft über die SECURITY-DEFINER-Funktion accept_friend_request(),
// damit Status-Update und Freundschaft atomar zusammen passieren.
//
// Runde D (29.10.2026): eine Kopfzeile (Titel, Unterbereiche als Chips,
// Hinzufügen mit Vorschlagsliste beim Tippen), kompakte Karten mit
// Rang-Abzeichen und Zeichen-Knöpfen, Vorschläge (gleiche Org, auch auf dem
// Discord-Server, gleiche Rolle), Hinweise als Meldung unten statt Text oben.
interface Props {
  lang: 'de' | 'en';
  title: string;
}

const { lang, title } = Astro.props;

const COPY = {
  de: {
    tabFriends: 'Freunde',
    tabRequests: 'Anfragen',
    tabSuggest: 'Vorschläge',
    addPh: 'Pilot hinzufügen: @handle',
    addLbl: 'Pilot per Handle oder Name suchen und anfragen',
    send: 'Anfrage senden',
    filterPh: 'Freunde filtern',
    online: 'Online',
    offline: 'Offline',
    incoming: 'Eingehend',
    outgoing: 'Gesendet',
    emptyFriends: 'Noch keine Freunde',
    emptyHint: 'Oben ein Handle eingeben',
    emptyToSuggest: 'Vorschläge ansehen',
    emptyFiltered: 'Kein Freund passt zu diesem Filter.',
    emptyRequests: 'Keine offenen Anfragen',
    emptySuggest: 'Gerade keine Vorschläge',
    noMatch: 'Kein Pilot gefunden',
    needHandle: 'Ohne Handle findet dich niemand.',
    setHandle: 'Handle setzen',
    loading: 'Lade dein Netzwerk …',
  },
  en: {
    tabFriends: 'Friends',
    tabRequests: 'Requests',
    tabSuggest: 'Suggestions',
    addPh: 'Add pilot: @handle',
    addLbl: 'Find a pilot by handle or name and send a request',
    send: 'Send request',
    filterPh: 'Filter friends',
    online: 'Online',
    offline: 'Offline',
    incoming: 'Incoming',
    outgoing: 'Sent',
    emptyFriends: 'No friends yet',
    emptyHint: 'Enter a handle above',
    emptyToSuggest: 'See suggestions',
    emptyFiltered: 'No friend matches this filter.',
    emptyRequests: 'No pending requests',
    emptySuggest: 'No suggestions right now',
    noMatch: 'No pilot found',
    needHandle: 'Without a handle nobody can find you.',
    setHandle: 'Set handle',
    loading: 'Loading your network …',
  },
}[lang];

// Kurze Texte für das Skript (Knöpfe, Meldungen, Gründe)
const JS = {
  de: {
    accept: 'Annehmen', decline: 'Ablehnen', withdraw: 'Zurückziehen', remove: 'Entfernen', removeQ: 'Entfernen?',
    profile: 'Profil', chat: 'Nachricht', request: 'Anfragen', requested: 'Angefragt', friend: 'Freund',
    sent: 'Gesendet', got: 'Angefragt', since: 'Freunde seit',
    rsOrg: 'Gleiche Org', rsRole: 'Gleiche Rolle',
    errSelf: 'Das bist du selbst.',
    errNotFound: 'Kein Pilot mit diesem Handle.',
    errNet: 'Das hat nicht geklappt. Bitte erneut versuchen.',
    okSent: 'Anfrage an %name% gesendet',
    isFriend: '%name% ist schon dein Freund',
    isPending: 'Anfrage an %name% läuft schon',
    okAccepted: '%name% ist jetzt dein Freund',
    okRemoved: '%name% entfernt',
    okWithdrawn: 'Anfrage zurückgezogen',
    okDeclined: 'Anfrage abgelehnt',
  },
  en: {
    accept: 'Accept', decline: 'Decline', withdraw: 'Withdraw', remove: 'Remove', removeQ: 'Remove?',
    profile: 'Profile', chat: 'Message', request: 'Request', requested: 'Requested', friend: 'Friend',
    sent: 'Sent', got: 'Requested', since: 'Friends since',
    rsOrg: 'Same org', rsRole: 'Same role',
    errSelf: 'That is you.',
    errNotFound: 'No pilot with this handle.',
    errNet: 'That did not work. Please try again.',
    okSent: 'Request sent to %name%',
    isFriend: '%name% is already your friend',
    isPending: 'Request to %name% is already pending',
    okAccepted: '%name% is now your friend',
    okRemoved: '%name% removed',
    okWithdrawn: 'Request withdrawn',
    okDeclined: 'Request declined',
  },
}[lang];

const pilotBase = lang === 'de' ? '/de/pilot/' : '/pilot/';
---

<div class="friends-manager fm" data-lang={lang} data-pilot-base={pilotBase} data-copy={JSON.stringify(JS)}>
  <div class="sv-bar fm-bar">
    <h2 class="sv-h">{title}</h2>
    <div class="sv-filter fm-seg" role="tablist">
      <button type="button" class="sv-chip" id="fmTabBtnFriends" role="tab" aria-selected="true" aria-pressed="true">{COPY.tabFriends}<b id="fmBadgeFriends">0</b></button>
      <button type="button" class="sv-chip" id="fmTabBtnRequests" role="tab" aria-selected="false" aria-pressed="false">{COPY.tabRequests}<b id="fmBadgeRequests" class="fm-hot" hidden>0</b></button>
      <button type="button" class="sv-chip" id="fmTabBtnSuggest" role="tab" aria-selected="false" aria-pressed="false" hidden>{COPY.tabSuggest}<b id="fmBadgeSuggest">0</b></button>
    </div>
    <form id="fmAddForm" class="fm-add" role="search" novalidate>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-user-plus"/></svg>
      <input
        type="text"
        id="fmHandleInput"
        class="inp"
        placeholder={COPY.addPh}
        aria-label={COPY.addLbl}
        maxlength="32"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="fmLookup"
      />
      <button type="submit" class="fm-add__go" id="fmAddBtn" aria-label={COPY.send} title={COPY.send}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-plus"/></svg>
      </button>
      <ul class="fm-lookup" id="fmLookup" role="listbox" aria-label={COPY.addLbl} hidden></ul>
      <p class="fm-lookup__none" id="fmLookupNone" hidden>{COPY.noMatch}</p>
    </form>
  </div>

  <p class="fm-nohandle" id="fmNoHandle" hidden>
    <span>{COPY.needHandle}</span>
    <button type="button" class="fm-btn fm-btn--primary" id="fmSetHandle">{COPY.setHandle}</button>
  </p>

  <p class="acx-hint" id="fmLoading">{COPY.loading}</p>

  <div id="fmPanelFriends" class="fm-panel" role="tabpanel" aria-labelledby="fmTabBtnFriends" hidden>
    <label class="sv-search fm-filter" id="fmFilterWrap" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-search"/></svg>
      <input type="search" id="fmFilterInput" class="inp" placeholder={COPY.filterPh} aria-label={COPY.filterPh} autocomplete="off" spellcheck="false" />
    </label>
    <section class="sv-sec" id="fmOnSec" hidden>
      <h3 class="sv-sh"><span>{COPY.online}</span><b id="fmOnN"></b></h3>
      <ul class="fm-grid" id="fmOnline"></ul>
    </section>
    <section class="sv-sec" id="fmOffSec" hidden>
      <h3 class="sv-sh"><span>{COPY.offline}</span><b id="fmOffN"></b></h3>
      <ul class="fm-grid" id="fmOffline"></ul>
    </section>
    <p class="sv-none" id="fmNoneFiltered" hidden>{COPY.emptyFiltered}</p>
    <div class="ck-empty sv-empty fm-empty" id="fmFriendsEmpty" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-users"/></svg>
      <p><b>{COPY.emptyFriends}</b><br/>{COPY.emptyHint}</p>
      <button type="button" class="btn sm" id="fmEmptySuggest" hidden>{COPY.emptyToSuggest}</button>
    </div>
  </div>

  <div id="fmPanelRequests" class="fm-panel" role="tabpanel" aria-labelledby="fmTabBtnRequests" hidden>
    <section class="sv-sec" id="fmInSec" hidden>
      <h3 class="sv-sh"><span>{COPY.incoming}</span><b id="fmIncomingCount"></b></h3>
      <ul class="fm-grid" id="fmIncomingList"></ul>
    </section>
    <section class="sv-sec" id="fmOutSec" hidden>
      <h3 class="sv-sh"><span>{COPY.outgoing}</span><b id="fmOutgoingCount"></b></h3>
      <ul class="fm-grid" id="fmOutgoingList"></ul>
    </section>
    <div class="ck-empty sv-empty fm-empty" id="fmRequestsEmpty" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-mail"/></svg>
      <p><b>{COPY.emptyRequests}</b></p>
    </div>
  </div>

  <div id="fmPanelSuggest" class="fm-panel" role="tabpanel" aria-labelledby="fmTabBtnSuggest" hidden>
    <ul class="fm-grid" id="fmSuggestList"></ul>
    <div class="ck-empty sv-empty fm-empty" id="fmSuggestEmpty" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-users"/></svg>
      <p><b>{COPY.emptySuggest}</b></p>
    </div>
  </div>

  <div class="sv-toast" id="fmToast" role="status" aria-live="polite" hidden><span id="fmToastMsg"></span></div>
</div>

<script>
  import { supabase } from '../../lib/supabase';
  import { STATUS_STATES, CITIZEN_ROLES } from '../../lib/profilePresets';
  import { resolveStatusKey, formatActivity } from '../../lib/presence';
  import { rankBadge } from '../../lib/rankBadge';

  const fmWrap = document.querySelector('.friends-manager') as HTMLElement | null;
  if (fmWrap) {
    const lang = fmWrap.dataset.lang === 'de' ? 'de' : 'en';
    const loc = lang === 'de' ? 'de-DE' : 'en-US';
    const pilotBase = fmWrap.dataset.pilotBase || '/pilot/';
    const C: Record<string, string> = JSON.parse(fmWrap.dataset.copy || '{}');

    const $ = (id: string) => document.getElementById(id)!;
    const NS = 'http://www.w3.org/2000/svg';
    const icon = (id: string) => {
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('aria-hidden', 'true');
      const use = document.createElementNS(NS, 'use');
      use.setAttribute('href', '#' + id);
      svg.appendChild(use);
      return svg;
    };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    };

    const loadingEl = $('fmLoading');
    const noHandleEl = $('fmNoHandle');
    const tabs = {
      friends: { btn: $('fmTabBtnFriends'), panel: $('fmPanelFriends') },
      requests: { btn: $('fmTabBtnRequests'), panel: $('fmPanelRequests') },
      suggest: { btn: $('fmTabBtnSuggest'), panel: $('fmPanelSuggest') },
    };
    type TabKey = keyof typeof tabs;
    let active: TabKey = 'friends';
    const filterInput = $('fmFilterInput') as HTMLInputElement;
    const addForm = $('fmAddForm') as HTMLFormElement;
    const handleInput = $('fmHandleInput') as HTMLInputElement;
    const addBtn = $('fmAddBtn') as HTMLButtonElement;
    const lookup = $('fmLookup');
    const lookupNone = $('fmLookupNone');

    type Prof = {
      id: string; handle: string; display_name: string | null;
      avatar_url: string | null; avatar_icon: string | null; avatar_color: string | null;
      role: string | null; status_state: string | null; status_text: string | null; presence: string | null;
      rsi_verified: boolean | null; activity?: string | null; org_name?: string | null;
      discord_level?: number | null; discord_rank?: string | null; discord_prestige?: number | null;
    };
    type Req = { reqId: string; at: string; p: Prof };
    type Sug = { p: Prof; score: number; why: Array<{ ic: string; t: string }> };

    let me = '';
    let myHandle: string | null = null;
    let myOrg = '';
    let myRole = '';
    let loaded = false;
    let friends: Array<{ rowId: string; since: string; p: Prof }> = [];
    let incoming: Req[] = [];
    let outgoing: Req[] = [];
    let suggestions: Sug[] = [];

    /* --------------------------------------------------------- Meldung --- */
    let toastTimer = 0;
    const toast = (msg: string) => {
      $('fmToastMsg').textContent = msg;
      $('fmToast').hidden = false;
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { $('fmToast').hidden = true; }, 3200);
    };
    const nameOf = (p: Prof) => p.display_name || p.handle || '—';
    const fill = (tpl: string, p: Prof) => tpl.replace('%name%', nameOf(p));
    const day = (iso: string) => {
      const t = Date.parse(iso);
      return t ? new Date(t).toLocaleDateString(loc, { day: 'numeric', month: 'short' }) : '';
    };
    const roleLabel = (id: string | null | undefined) => {
      const r = CITIZEN_ROLES.find((x) => x.id === id);
      return r ? (lang === 'de' ? r.labelDe : r.labelEn) : '';
    };

    /* ---------------------------------------------------------- Präsenz --- */
    const ST = STATUS_STATES as Record<string, { color: string; labelDe: string; labelEn: string; pulse?: boolean }>;
    const presOf = (p: Prof) => (p.presence === 'online' || p.presence === 'away' ? p.presence : 'offline');
    const stOf = (p: Prof) => ST[resolveStatusKey(presOf(p), p.status_state)] || ST.offline;
    const labelOf = (p: Prof) => { const st = stOf(p); return lang === 'de' ? st.labelDe : st.labelEn; };
    // Wie im Dock: was der Freund gerade auf der Seite macht, vor seinem
    // Statustext, vor dem reinen Präsenz-Wort.
    const subOf = (p: Prof): { text: string; act: boolean } => {
      if (presOf(p) === 'offline') return { text: labelOf(p), act: false };
      const act = formatActivity(p.activity, lang);
      if (act) return { text: act, act: true };
      return { text: p.status_text || labelOf(p), act: false };
    };
    // presence null = Status nicht freigegeben: Punkt ausblenden statt
    // "Offline" zu behaupten (z. B. bei Anfragen von Nicht-Freunden).
    const applyDot = (dot: HTMLElement, p: Prof) => {
      const shown = p.presence === 'online' || p.presence === 'away' || p.presence === 'offline';
      dot.hidden = !shown;
      if (!shown) { dot.title = ''; return; }
      const st = stOf(p);
      dot.style.background = st.color;
      dot.title = labelOf(p);
    };

    /* ----------------------------------------------------------- Karten --- */
    const avatarNode = (p: Prof, dot = true) => {
      const box = el('span', 'fm-av');
      const col = p.avatar_color || '#2dd4ff';
      box.style.setProperty('--ac', col);
      if (p.avatar_url) {
        const img = document.createElement('img');
        img.src = p.avatar_url;
        img.alt = '';
        img.loading = 'lazy';
        box.appendChild(img);
      } else {
        box.textContent = p.avatar_icon || nameOf(p).charAt(0).toUpperCase();
      }
      if (dot) {
        const d = el('i', 'fm-dot');
        d.dataset.uid = p.id;
        applyDot(d, p);
        box.appendChild(d);
      }
      return box;
    };

    const nameLine = (p: Prof, compact = false) => {
      const line = el('span', 'fm-name');
      line.appendChild(el('b', '', nameOf(p)));
      if (p.rsi_verified) {
        const v = el('span', 'fm-ver');
        v.title = 'RSI ✓';
        v.appendChild(icon('ic-check'));
        line.appendChild(v);
      }
      const rk = rankBadge(p, compact);
      if (rk) line.appendChild(rk);
      return line;
    };

    const iconBtn = (ic: string, label: string, cls = '') => {
      const b = el('button', 'fm-ib' + (cls ? ' ' + cls : '')) as HTMLButtonElement;
      b.type = 'button';
      b.title = label;
      b.setAttribute('aria-label', label);
      b.appendChild(icon(ic));
      return b;
    };
    const textBtn = (label: string, cls: string, fn: () => Promise<void> | void) => {
      const b = el('button', 'fm-btn ' + cls, label) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', async () => {
        b.disabled = true;
        try { await fn(); } finally { b.disabled = false; }
      });
      return b;
    };
    const profileLink = (p: Prof) => {
      const a = el('a', 'fm-ib') as HTMLAnchorElement;
      a.href = pilotBase + encodeURIComponent(p.handle);
      a.title = C.profile;
      a.setAttribute('aria-label', `${nameOf(p)} — ${C.profile}`);
      a.appendChild(icon('ic-id'));
      return a;
    };

    // Bis 820 px blendet das CSS den Profil-Knopf aus; dann ist der Avatar
    // der Weg zum Profil und muss per Tab erreichbar sein.
    const narrow = matchMedia('(max-width: 820px)');
    narrow.addEventListener('change', () => {
      fmWrap.querySelectorAll<HTMLAnchorElement>('a.fm-avlink').forEach((a) => { a.tabIndex = narrow.matches ? 0 : -1; });
    });

    /** Karte: Avatar, Name + Abzeichen, Unterzeile, Aktionen rechts. */
    // compact: Rang nur als Zeichen + Level (Karten mit Textknopf rechts).
    const card = (p: Prof, sub: HTMLElement, acts: HTMLElement[], off = false, compact = false) => {
      const li = el('li', 'fm-card' + (off ? ' is-off' : ''));
      li.dataset.id = p.id;
      const av = p.handle ? (el('a', 'fm-avlink') as HTMLAnchorElement) : el('span', 'fm-avlink');
      if (p.handle) {
        (av as HTMLAnchorElement).href = pilotBase + encodeURIComponent(p.handle);
        av.setAttribute('aria-label', `${nameOf(p)} — ${C.profile}`);
        av.tabIndex = narrow.matches ? 0 : -1;
      }
      av.appendChild(avatarNode(p, true));
      const main = el('span', 'fm-main');
      main.append(nameLine(p, compact), sub);
      main.title = p.handle ? '@' + p.handle : '';
      const box = el('span', 'fm-acts');
      box.append(...acts);
      li.append(av, main, box);
      return li;
    };

    const friendCard = (f: { rowId: string; since: string; p: Prof }) => {
      const p = f.p;
      // Offline steht schon über der Gruppe: dort lieber seit wann ihr befreundet seid.
      const so = presOf(p) === 'offline' ? { text: `${C.since} ${day(f.since)}`, act: false } : subOf(p);
      const sub = el('small', 'fm-sub' + (so.act ? ' is-act' : ''), so.text);
      const chat = iconBtn('ic-chat', `${C.chat}: ${nameOf(p)}`, 'fm-ib--chat');
      // Chat öffnet in der Freundesleiste (FriendsDock), auf dem Handy als volle Fläche.
      chat.addEventListener('click', () => document.dispatchEvent(new CustomEvent('vb:chat-open', { detail: p.id })));
      const acts: HTMLElement[] = [chat];
      if (p.handle) acts.push(profileLink(p));
      // Entfernen ohne Dialog: erster Klick fragt im Knopf selbst nach,
      // zweiter Klick (binnen 4 s) entfernt. Rückgängig ginge nicht, weil
      // Freundschaften nur über eine angenommene Anfrage entstehen.
      const rm = iconBtn('ic-x', `${C.remove}: ${nameOf(p)}`, 'fm-ib--rm');
      const q = el('span', 'fm-ib__q', C.removeQ);
      rm.appendChild(q);
      let armed = 0;
      rm.addEventListener('click', async () => {
        if (!armed) {
          rm.classList.add('is-armed');
          armed = window.setTimeout(() => {
            armed = 0;
            rm.classList.remove('is-armed');
            // Was der Präsenz-Takt währenddessen zurückgehalten hat, jetzt zeigen.
            if (presenceStale) repaint();
          }, 4000);
          return;
        }
        clearTimeout(armed);
        rm.disabled = true;
        await removeFriend(f);
      });
      acts.push(rm);
      return card(p, sub, acts, presOf(p) === 'offline');
    };

    const reqCard = (r: Req, kind: 'in' | 'out') => {
      const sub = el('small', 'fm-sub', `${kind === 'in' ? C.got : C.sent} · ${day(r.at)}`);
      const acts: HTMLElement[] = [];
      if (kind === 'in') {
        acts.push(textBtn(C.accept, 'fm-btn--primary', () => acceptReq(r)));
        const no = iconBtn('ic-x', `${C.decline}: ${nameOf(r.p)}`, 'fm-ib--rm');
        no.addEventListener('click', async () => { no.disabled = true; await dropReq(r, C.okDeclined); });
        acts.push(no);
      } else {
        if (r.p.handle) acts.push(profileLink(r.p));
        const no = iconBtn('ic-x', `${C.withdraw}: ${nameOf(r.p)}`, 'fm-ib--rm');
        no.addEventListener('click', async () => { no.disabled = true; await dropReq(r, C.okWithdrawn); });
        acts.push(no);
      }
      return card(r.p, sub, acts, false, kind === 'in');
    };

    const sugCard = (s: Sug) => {
      if (!s.why.length) return card(s.p, el('small', 'fm-sub', '@' + s.p.handle), sugActs(s), false, true);
      const sub = el('small', 'fm-sub fm-why');
      for (const w of s.why) {
        const chip = el('span', 'fm-why__c');
        chip.append(icon(w.ic), w.t);
        sub.appendChild(chip);
      }
      return card(s.p, sub, sugActs(s), false, true);
    };
    function sugActs(s: Sug): HTMLElement[] {
      const acts: HTMLElement[] = [];
      if (s.p.handle) acts.push(profileLink(s.p));
      acts.push(textBtn(C.request, 'fm-btn--primary', () => sendTo(s.p)));
      return acts;
    }

    /* --------------------------------------------------------- Aktionen --- */
    const relation = (id: string): 'friend' | 'out' | 'in' | '' => {
      if (friends.some((f) => f.p.id === id)) return 'friend';
      if (outgoing.some((r) => r.p.id === id)) return 'out';
      if (incoming.some((r) => r.p.id === id)) return 'in';
      return '';
    };

    const sendTo = async (p: Prof) => {
      if (!myHandle) { noHandleEl.hidden = false; return; }
      if (p.id === me) { toast(C.errSelf); return; }
      const rel = relation(p.id);
      if (rel === 'friend' || rel === 'out') { toast(fill(rel === 'friend' ? C.isFriend : C.isPending, p)); return; }
      if (rel === 'in') { await acceptReq(incoming.find((r) => r.p.id === p.id)!); return; }
      const { error } = await supabase.from('friend_requests').insert({ sender_id: me, receiver_id: p.id });
      if (error) { toast(C.errNet); return; }
      toast(fill(C.okSent, p));
      await loadAll();
    };

    const removeFriend = async (f: { rowId: string; p: Prof }) => {
      const { error } = await supabase.from('friends').delete().eq('id', f.rowId);
      if (error) { toast(C.errNet); render(); return; }
      // Alte Anfragen zwischen beiden entfernen, damit man sich später erneut
      // anfragen kann (unique(sender,receiver) würde sonst blockieren).
      if (f.p.id) {
        await supabase.from('friend_requests').delete()
          .or(`and(sender_id.eq.${me},receiver_id.eq.${f.p.id}),and(sender_id.eq.${f.p.id},receiver_id.eq.${me})`);
      }
      toast(fill(C.okRemoved, f.p));
      await loadAll();
    };

    const acceptReq = async (r: Req) => {
      const { error } = await supabase.rpc('accept_friend_request', { req_id: r.reqId });
      if (error) { toast(C.errNet); return; }
      toast(fill(C.okAccepted, r.p));
      await loadAll();
    };

    const dropReq = async (r: Req, okMsg: string) => {
      const { error } = await supabase.from('friend_requests').delete().eq('id', r.reqId);
      if (error) { toast(C.errNet); render(); return; }
      toast(okMsg);
      await loadAll();
    };

    /* ------------------------------------------------------------ Laden --- */
    const fallback = (id: string): Prof => ({
      id, handle: '', display_name: null, avatar_url: null, avatar_icon: null,
      avatar_color: null, role: null, status_state: null, status_text: null, presence: null, rsi_verified: null,
    });

    const loadAll = async () => {
      const { data: u } = await supabase.auth.getUser();
      if (!u?.user) return;
      me = u.user.id;

      const { data: myProf } = await supabase
        .from('profiles').select('handle, org_name, role').eq('id', me).maybeSingle();
      const mp = (myProf || {}) as { handle?: string; org_name?: string; role?: string };
      myHandle = mp.handle || null;
      myOrg = (mp.org_name || '').trim();
      myRole = mp.role || '';
      noHandleEl.hidden = !!myHandle;

      const [{ data: fRows }, { data: rRows }] = await Promise.all([
        supabase.from('friends').select('id, user_id, friend_id, created_at'),
        supabase.from('friend_requests')
          .select('id, sender_id, receiver_id, created_at').eq('status', 'pending'),
      ]);
      const fr = (fRows || []) as Array<{ id: string; user_id: string; friend_id: string; created_at: string }>;
      const rr = (rRows || []) as Array<{ id: string; sender_id: string; receiver_id: string; created_at: string }>;

      const ids = new Set<string>();
      fr.forEach((r) => ids.add(r.user_id === me ? r.friend_id : r.user_id));
      rr.forEach((r) => ids.add(r.sender_id === me ? r.receiver_id : r.sender_id));
      let byId = new Map<string, Prof>();
      if (ids.size) {
        const { data: profs } = await supabase.from('social_profiles').select('*').in('id', [...ids]);
        byId = new Map(((profs || []) as Prof[]).map((p) => [p.id, p]));
      }

      friends = fr.map((r) => {
        const other = r.user_id === me ? r.friend_id : r.user_id;
        return { rowId: r.id, since: r.created_at, p: byId.get(other) || fallback(other) };
      });
      incoming = rr.filter((r) => r.receiver_id === me)
        .map((r) => ({ reqId: r.id, at: r.created_at, p: byId.get(r.sender_id) || fallback(r.sender_id) }));
      outgoing = rr.filter((r) => r.sender_id === me)
        .map((r) => ({ reqId: r.id, at: r.created_at, p: byId.get(r.receiver_id) || fallback(r.receiver_id) }));

      loaded = true;
      loadingEl.hidden = true;
      render();
      loadSuggest().catch(() => {});
    };

    // Vorschläge: Piloten mit Handle, die man noch nicht kennt. Gründe:
    // gleiche Org (stärkster Grund), auch auf dem Discord-Server (die View
    // zeigt den Rang nur dann), gleiche Rolle. Drei kleine Abfragen statt
    // einer Liste aller Konten.
    const SUG_COLS = 'id, handle, display_name, avatar_url, avatar_icon, avatar_color, role, org_name, rsi_verified, discord_level, discord_rank, discord_prestige';
    const loadSuggest = async () => {
      const qs = [
        supabase.from('social_profiles').select(SUG_COLS).not('discord_level', 'is', null).order('discord_level', { ascending: false }).limit(24),
        myOrg ? supabase.from('social_profiles').select(SUG_COLS).eq('org_name', myOrg).limit(24) : null,
        myRole ? supabase.from('social_profiles').select(SUG_COLS).eq('role', myRole).limit(24) : null,
      ];
      const res = await Promise.all(qs.map((q) => (q ? q : Promise.resolve({ data: [] }))));
      const all = new Map<string, Prof>();
      for (const r of res) for (const p of ((r as { data: Prof[] | null }).data || [])) all.set(p.id, p);
      const out: Sug[] = [];
      for (const p of all.values()) {
        if (!p.handle || p.id === me || relation(p.id)) continue;
        const why: Sug['why'] = [];
        let score = 0;
        if (myOrg && (p.org_name || '').trim().toLowerCase() === myOrg.toLowerCase()) { score += 3; why.push({ ic: 'ic-org', t: p.org_name || C.rsOrg }); }
        // Auf dem Server zeigt schon das Rang-Abzeichen: kein eigener Grund-Chip.
        if (p.discord_level != null) score += 2 + Math.min(p.discord_level, 100) / 100;
        if (myRole && p.role === myRole) { score += 1; why.push({ ic: 'ic-hex', t: roleLabel(p.role) || C.rsRole }); }
        if (p.rsi_verified) score += 0.3;
        if (score > 0) out.push({ p, score, why });
      }
      suggestions = out.sort((a, b) => b.score - a.score || nameOf(a.p).localeCompare(nameOf(b.p))).slice(0, 12);
      render();
    };

    /* ----------------------------------------------------------- Malen --- */
    // Die Freundesleiste rechts (FriendsDock) zeigt dieselben Daten: sie hört
    // auf dieses Ereignis statt selbst zu laden, damit beide nie auseinander-
    // laufen (Annehmen/Entfernen/Präsenz kommen sofort rechts an).
    const announce = () => {
      document.dispatchEvent(new CustomEvent('vb:friends', { detail: { friends, incoming, outgoing, myHandle } }));
    };
    const presRank = (p: Prof) => (presOf(p) === 'online' ? 0 : presOf(p) === 'away' ? 1 : 2);

    const render = () => {
      const q = (filterInput.value || '').trim().toLowerCase();
      const shown = friends
        .filter((f) => !q || [f.p.display_name, f.p.handle, roleLabel(f.p.role), f.p.status_text].some((v) => (v || '').toLowerCase().includes(q)))
        .sort((a, b) => presRank(a.p) - presRank(b.p) || nameOf(a.p).localeCompare(nameOf(b.p)));
      const on = shown.filter((f) => presOf(f.p) !== 'offline');
      const off = shown.filter((f) => presOf(f.p) === 'offline');

      $('fmBadgeFriends').textContent = String(friends.length);
      const nReq = incoming.length + outgoing.length;
      const badgeReq = $('fmBadgeRequests');
      badgeReq.textContent = String(nReq);
      badgeReq.hidden = nReq === 0;
      badgeReq.classList.toggle('fm-hot', incoming.length > 0);
      $('fmBadgeSuggest').textContent = String(suggestions.length);
      tabs.suggest.btn.hidden = suggestions.length === 0 && active !== 'suggest';

      $('fmOnline').replaceChildren(...on.map(friendCard));
      $('fmOffline').replaceChildren(...off.map(friendCard));
      $('fmOnN').textContent = String(on.length);
      $('fmOffN').textContent = String(off.length);
      $('fmOnSec').hidden = !on.length;
      $('fmOffSec').hidden = !off.length;
      $('fmFilterWrap').hidden = friends.length < 8 && !q;
      $('fmNoneFiltered').hidden = !(friends.length && !shown.length);
      $('fmFriendsEmpty').hidden = !(loaded && friends.length === 0);
      $('fmEmptySuggest').hidden = suggestions.length === 0;

      $('fmIncomingList').replaceChildren(...incoming.map((r) => reqCard(r, 'in')));
      $('fmOutgoingList').replaceChildren(...outgoing.map((r) => reqCard(r, 'out')));
      $('fmIncomingCount').textContent = String(incoming.length);
      $('fmOutgoingCount').textContent = String(outgoing.length);
      $('fmInSec').hidden = !incoming.length;
      $('fmOutSec').hidden = !outgoing.length;
      $('fmRequestsEmpty').hidden = !(loaded && nReq === 0);

      const sug = suggestions.filter((s) => !relation(s.p.id));
      $('fmSuggestList').replaceChildren(...sug.map(sugCard));
      $('fmSuggestEmpty').hidden = !(loaded && sug.length === 0);
      announce();
    };

    /* ------------------------------------------------- Unterbereiche --- */
    const showTab = (which: TabKey) => {
      active = which;
      (Object.keys(tabs) as TabKey[]).forEach((k) => {
        const on = k === which;
        tabs[k].btn.setAttribute('aria-selected', String(on));
        tabs[k].btn.setAttribute('aria-pressed', String(on));
        tabs[k].panel.hidden = !on || !loaded;
      });
      if (which === 'suggest') tabs.suggest.btn.hidden = false;
    };
    (Object.keys(tabs) as TabKey[]).forEach((k) => tabs[k].btn.addEventListener('click', () => showTab(k)));
    $('fmEmptySuggest').addEventListener('click', () => showTab('suggest'));
    document.addEventListener('vb:friends-show', (e) => {
      const w = (e as CustomEvent).detail === 'requests' ? 'requests' : 'friends';
      showTab(w);
      if (w === 'friends' && myHandle) handleInput.focus();
    });
    filterInput.addEventListener('input', render);
    $('fmSetHandle').addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('vb:tab', { detail: { tab: 'profile', el: 'pfHandle' } })));
    // Handle im Profil gesetzt: Hinweis weg, Hinzufügen frei.
    document.addEventListener('vb:profile-check', (e) => {
      const items = ((e as CustomEvent).detail || []) as Array<{ k: string; ok: boolean }>;
      const h = items.find((i) => i.k === 'handle');
      if (loaded && h && h.ok !== !!myHandle) loadAll().catch(() => {});
    });

    /* ---------------------------------------- Hinzufügen mit Vorschlägen --- */
    // Beim Tippen: bis zu 6 Piloten, deren Handle oder Name so beginnt.
    // Ein Klick (oder Enter) fragt an; Freunde und offene Anfragen zeigen
    // ihren Stand statt eines Knopfs.
    let hits: Prof[] = [];
    let cursor = -1;
    let lookTimer = 0;
    let lookSeq = 0;
    const closeLookup = () => {
      lookup.hidden = true;
      lookupNone.hidden = true;
      handleInput.setAttribute('aria-expanded', 'false');
      handleInput.removeAttribute('aria-activedescendant');
      cursor = -1;
    };
    const paintLookup = () => {
      lookup.replaceChildren(...hits.map((p, i) => {
        const li = el('li', 'fm-hit' + (i === cursor ? ' is-cur' : ''));
        li.id = 'fmHit' + i;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === cursor));
        li.appendChild(avatarNode(p, false));
        const t = el('span', 'fm-main');
        t.append(nameLine(p, true), el('small', 'fm-sub', '@' + p.handle));
        li.appendChild(t);
        const rel = relation(p.id);
        const state = rel === 'friend' ? C.friend : rel === 'out' ? C.requested : rel === 'in' ? C.accept : C.request;
        li.appendChild(el('span', 'fm-hit__st' + (rel === 'friend' || rel === 'out' ? ' is-done' : ''), state));
        li.addEventListener('mousedown', (e) => e.preventDefault());
        li.addEventListener('click', () => pick(p));
        return li;
      }));
      lookup.hidden = !hits.length;
      handleInput.setAttribute('aria-expanded', String(!!hits.length));
      if (cursor >= 0) handleInput.setAttribute('aria-activedescendant', 'fmHit' + cursor);
      else handleInput.removeAttribute('aria-activedescendant');
    };
    const pick = async (p: Prof) => {
      closeLookup();
      handleInput.value = '';
      await sendTo(p);
    };
    const runLookup = async () => {
      const raw = handleInput.value.trim().replace(/^@/, '');
      // Nur Buchstaben, Ziffern, Leer, _ und -; % und \ wären in ILIKE Platzhalter.
      const q = raw.replace(/[^\p{L}\p{N} _-]/gu, '').slice(0, 24);
      if (q.length < 2) { hits = []; closeLookup(); return; }
      const seq = ++lookSeq;
      const pat = q.replace(/_/g, '\\_') + '%'; // _ ist in ILIKE „ein Zeichen"
      // Zwei einfache Abfragen statt or(): Handle zuerst, dann Name.
      const [byHandle, byName] = await Promise.all([
        supabase.from('social_profiles').select(SUG_COLS).ilike('handle', pat).neq('id', me).limit(6),
        supabase.from('social_profiles').select(SUG_COLS).ilike('display_name', pat).neq('id', me).limit(6),
      ]);
      if (seq !== lookSeq) return;
      const seen = new Map<string, Prof>();
      for (const p of [...((byHandle.data || []) as Prof[]), ...((byName.data || []) as Prof[])]) if (p.handle && !seen.has(p.id)) seen.set(p.id, p);
      hits = [...seen.values()].slice(0, 6);
      cursor = hits.length ? 0 : -1;
      paintLookup();
      lookupNone.hidden = hits.length > 0;
    };
    handleInput.addEventListener('input', () => {
      clearTimeout(lookTimer);
      lookTimer = window.setTimeout(() => { runLookup().catch(() => {}); }, 180);
    });
    handleInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeLookup(); return; }
      if (!hits.length || lookup.hidden) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); cursor = (cursor + 1) % hits.length; paintLookup(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); cursor = (cursor - 1 + hits.length) % hits.length; paintLookup(); }
    });
    handleInput.addEventListener('blur', () => setTimeout(closeLookup, 120));
    handleInput.addEventListener('focus', () => { if (hits.length) paintLookup(); });

    // Enter / Plus: gewählter Treffer, sonst exakt das getippte Handle.
    addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!myHandle) { noHandleEl.hidden = false; return; }
      if (cursor >= 0 && hits[cursor] && !lookup.hidden) { await pick(hits[cursor]); return; }
      const h = handleInput.value.trim().toLowerCase().replace(/^@/, '');
      if (!h) { handleInput.focus(); return; }
      if (h === (myHandle || '').toLowerCase()) { toast(C.errSelf); return; }
      addBtn.disabled = true;
      try {
        const { data } = await supabase.from('social_profiles').select(SUG_COLS).eq('handle', h).maybeSingle();
        if (!data) { toast(C.errNotFound); return; }
        handleInput.value = '';
        closeLookup();
        await sendTo(data as Prof);
      } catch {
        toast(C.errNet);
      } finally {
        addBtn.disabled = false;
      }
    });

    loadAll().then(() => showTab(active)).catch(() => { loadingEl.hidden = true; toast(C.errNet); });

    // Live-Präsenz: alle 40 s die Präsenz der angezeigten Profile neu abfragen.
    // Der Wechsel nach offline entsteht durch Zeitablauf (kein DB-Ereignis),
    // daher Abfragen statt Realtime. Danach neu malen (Gruppen Online/Offline).
    let presenceStale = false;
    const pollPresence = async () => {
      const ids = [...new Set([...friends, ...incoming, ...outgoing].map((x) => x.p && x.p.id).filter(Boolean) as string[])];
      if (!ids.length) return;
      // '*' statt fester Spalten: neue Felder (Aktivität, Rang) kommen so mit.
      const { data } = await supabase.from('social_profiles').select('*').in('id', ids);
      if (!data) return;
      const map = new Map((data as Prof[]).map((r) => [r.id, r]));
      const all = [...friends, ...incoming, ...outgoing];
      const before = JSON.stringify(all.map((x) => x.p));
      const upd = (x: { p: Prof }) => { const r = map.get(x.p.id); if (r) Object.assign(x.p, r); };
      all.forEach(upd);
      if (JSON.stringify(all.map((x) => x.p)) === before && !presenceStale) return;
      // Während „Entfernen?" scharf ist, nicht neu malen (der Knopf ginge
      // verloren); die Nachfrage malt nach, sobald sie abläuft.
      if (fmWrap.querySelector('.fm-ib--rm.is-armed')) { presenceStale = true; announce(); return; }
      repaint();
    };
    // Neu malen ersetzt die Karten: den Fokus auf denselben Knopf derselben
    // Karte zurücksetzen (Tastaturbedienung).
    const repaint = () => {
      presenceStale = false;
      const f = document.activeElement as HTMLElement | null;
      const cardEl = f && fmWrap.contains(f) ? f.closest<HTMLElement>('.fm-card') : null;
      const key = cardEl?.dataset.id;
      const idx = cardEl ? [...cardEl.querySelectorAll('a,button')].indexOf(f!) : -1;
      render();
      if (key && idx >= 0) {
        const again = fmWrap.querySelector<HTMLElement>(`.fm-card[data-id="${CSS.escape(key)}"]`);
        (again?.querySelectorAll<HTMLElement>('a,button')[idx])?.focus({ preventScroll: true });
      }
    };
    setInterval(pollPresence, 40000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) pollPresence(); });
  }
</script>
