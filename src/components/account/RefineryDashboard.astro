<script>
  import { supabase } from '../../lib/supabase';
  import { clearAccountTraces, browserStores } from '../../lib/account-cleanup';
  import {
    REFINERY, estimateValue, fmtCountdown, fmtDuration, fmtAuec, fmtScu, rankStations, bonusAt, stationByName, oreByName,
    type RefineryJob, type RefineryItem,
  } from '../../lib/refinery';
  import { refineryValue, refinerySpark, jobValue } from '../../lib/refineryJobs';

  const root = document.getElementById('rf') as HTMLElement | null;
  if (root) {
    const lang: 'de' | 'en' = root.dataset.lang === 'de' ? 'de' : 'en';
    const C: any = JSON.parse(document.getElementById('rfd-copy')!.textContent || '{}');
    const locale = lang === 'de' ? 'de-DE' : 'en-US';
    const $ = (id: string) => document.getElementById(id)!;

    const el = (tag: string, cls?: string, txt?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (txt != null) n.textContent = txt;
      return n;
    };
    const pct = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '±') + Math.abs(n) + ' %';
    const oreLink = (name: string) => {
      const u = C.oreHref?.[name];
      if (!u) return el('b', undefined, name);
      const a = el('a', undefined, name) as HTMLAnchorElement;
      a.href = u;
      return a;
    };

    // ---- Ertragsvergleich (öffentlich) ------------------------------------
    const yieldSel = $('rf-yield-ore') as HTMLSelectElement;
    const yieldLink = $('rf-yield-link') as HTMLAnchorElement;
    function renderRank(ore: string) {
      const list = $('rf-rank');
      list.textContent = '';
      for (const { station, bonus } of rankStations(ore)) {
        const li = el('li', bonus > 0 ? 'is-pos' : bonus < 0 ? 'is-neg' : 'is-zero');
        const bar = el('span', 'rf-rank__bar');
        const fill = el('i');
        fill.style.width = Math.min(100, Math.abs(bonus) / 13 * 100) + '%';
        bar.appendChild(fill);
        const b = el('b', 'tnum', pct(bonus));
        li.append(el('span', 'rf-rank__n', station.name), el('span', 'rf-rank__s', station.system), bar, b);
        list.appendChild(li);
      }
      yieldLink.textContent = ore;
      yieldLink.href = C.oreHref?.[ore] || '#erze';
    }
    function pickOre(ore: string, scroll: boolean) {
      if (!oreByName.has(ore)) return;
      yieldSel.value = ore;
      renderRank(ore);
      if (scroll) $('ertrag').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    yieldSel.addEventListener('change', () => pickOre(yieldSel.value, false));
    document.querySelectorAll<HTMLButtonElement>('.rf-pick').forEach((b) =>
      b.addEventListener('click', () => pickOre(b.dataset.ore || '', true)));
    // Tieflink ?erz=<Name> aus der Mining-Datenbank: Vergleich für genau dieses Erz.
    try {
      const want = new URLSearchParams(location.search).get('erz') || new URLSearchParams(location.search).get('ore');
      const hit = want && REFINERY.ores.find((o) => o.name.toLowerCase() === want.trim().toLowerCase());
      if (hit) pickOre(hit.name, !location.hash);
    } catch { /* ohne gültigen Parameter bleibt die Vorauswahl */ }

    // ---- Zurück-Leiste nach Sprüngen innerhalb der Seite ------------------
    // Die Leiste (SiteNav, back-link.js) zeigt, woher man auf die Seite kam.
    // Nach einem Sprung zu Erze/Ertrag/Methoden fuehrt sie zuerst an die
    // Stelle der Seite zurueck, von der man gesprungen ist.
    const back = document.querySelector<HTMLAnchorElement>('.snav__back');
    if (back) {
      const backLbl = back.querySelector('[data-back-label]');
      const orig = { href: back.getAttribute('href'), label: backLbl?.textContent ?? '', aria: back.getAttribute('aria-label'), hidden: back.hidden };
      let jumps = Number(history.state?.rfJump) || 0;
      const paint = () => {
        const inPage = jumps > 0;
        back.hidden = inPage ? false : orig.hidden;
        back.setAttribute('href', inPage ? location.pathname + location.search : orig.href ?? '');
        if (!inPage && orig.href == null) back.removeAttribute('href');
        if (backLbl) backLbl.textContent = inPage ? C.title : orig.label;
        if (inPage) back.setAttribute('aria-label', (back.dataset.backAria || '') + ' ' + C.title);
        else if (orig.aria == null) back.removeAttribute('aria-label');
        else back.setAttribute('aria-label', orig.aria);
        document.documentElement.classList.toggle('vb-has-back', !back.hidden);
      };
      root.addEventListener('click', (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        const hash = a?.getAttribute('href') || '';
        if (hash.length <= 1 || hash === location.hash) return;
        // Die Tiefe steht im History-Eintrag: Chrome feuert popstate auch beim
        // Sprung selbst, ein blosser Zaehler wuerde dabei gleich wieder sinken.
        const next = jumps + 1;
        setTimeout(() => {
          history.replaceState({ ...(history.state || {}), rfJump: next }, '');
          jumps = next;
          paint();
        }, 0);
      });
      addEventListener('popstate', () => { jumps = Number(history.state?.rfJump) || 0; paint(); });
      if (jumps) paint();
      // Capture: vor dem Klick-Hoerer aus back-link.js, der sonst die Seite verlaesst.
      back.addEventListener('click', (e) => {
        if (!jumps || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        history.back();
      }, true);
    }

    // ---- Tracker -----------------------------------------------------------
    const loadingEl = $('rfd-loading');
    const outEl = $('rfd-out');
    const tracker = $('rfd');

    const fmtReadyAt = (iso: string) => {
      const d = new Date(iso);
      const time = d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
      return d.toDateString() === new Date().toDateString() ? time : d.toLocaleDateString(locale, { day: '2-digit', month: 'short' }) + ' ' + time;
    };
    const fmtDate = (iso: string) => new Date(iso).toLocaleDateString(locale, { day: '2-digit', month: 'short', year: 'numeric' });

    let jobs: RefineryJob[] = [];

    // Alles, was hier ins DOM geht, läuft als Text (textContent/append), nie als
    // HTML: Methode, Station, Erze und Notiz kommen aus refinery_jobs, also vom Konto.
    const fig = (k: string, v: string, cls?: string) => {
      const d = el('div');
      d.append(el('dt', undefined, k), el('dd', cls, v));
      return d;
    };
    const orePills = (items: RefineryItem[]) => {
      const w = el('div', 'rf-job__ores');
      for (const it of items) {
        const p = el('span', 'rf-pill');
        p.append(oreLink(String(it.ore ?? '')), ' ' + fmtScu(it.yieldScu || it.rawScu, lang) + ' ' + C.scu);
        w.appendChild(p);
      }
      return w;
    };

    function renderStats() {
      const active = jobs.filter((j) => j.status === 'active');
      const now = Date.now();
      const { total } = refineryValue(jobs);
      $('rfd-st-active').textContent = String(active.length);
      $('rfd-st-ready').textContent = String(active.filter((j) => new Date(j.ready_at).getTime() <= now).length);
      $('rfd-st-pipe').textContent = fmtScu(active.reduce((s, j) => s + Number(j.yield_scu || 0), 0), lang);
      $('rfd-st-value').textContent = fmtAuec(total, lang);
      $('rfd-st-sub').textContent = active.length === 0 ? C.subNoActive : active.length === 1 ? C.subActive1 : C.subActive.replace('%n', String(active.length));
      $('rfd-spark').innerHTML = refinerySpark(jobs, 'rfd-sparkg');

      const done = jobs.filter((j) => j.status === 'done');
      const life = $('rfd-life');
      life.textContent = '';
      life.hidden = done.length === 0;
      if (done.length) {
        const value = done.reduce((s, j) => s + jobValue(j), 0);
        const cost = done.reduce((s, j) => s + Number(j.cost || 0), 0);
        const profit = value - cost;
        life.append(
          fig(C.lDone, String(done.length)),
          fig(C.lRefined, fmtScu(done.reduce((s, j) => s + Number(j.yield_scu || 0), 0), lang)),
          fig(C.lCost, fmtAuec(cost, lang) + ' aUEC'),
          fig(C.lProfit, fmtAuec(profit, lang) + ' aUEC', profit > 0 ? 'rf-pos' : profit < 0 ? 'rf-neg' : ''),
        );
      }
    }

    function jobCard(j: RefineryJob) {
      const card = el('article', 'rf-job');
      card.dataset.started = j.started_at;
      card.dataset.ready = j.ready_at;

      const st = stationByName.get(j.station);
      const head = el('div', 'rf-job__head');
      head.append(el('span', 'rf-job__station', st?.name || j.station), el('span', 'rf-job__sys', st?.system || ''), el('span', 'rf-chip', j.method));
      const badge = el('span', 'rf-badge', C.readyNow);
      badge.hidden = true;
      badge.dataset.role = 'badge';
      head.appendChild(badge);
      card.appendChild(head);
      if (j.items?.length) card.appendChild(orePills(j.items));

      const prog = el('div', 'rf-prog');
      const bar = el('i');
      bar.dataset.role = 'bar';
      prog.appendChild(bar);
      card.appendChild(prog);

      const meta = el('div', 'rf-job__meta');
      const cd = el('div', 'rf-cd');
      cd.dataset.role = 'cd';
      const figs = el('dl', 'rf-figs');
      figs.appendChild(fig(C.yieldLbl, `${fmtScu(Number(j.yield_scu), lang)} ${C.scu}`));
      if (j.est_value != null) figs.appendChild(fig(C.valueLbl, fmtAuec(j.est_value, lang), 'rf-gold'));
      meta.append(cd, figs);
      card.appendChild(meta);
      if (j.note) card.appendChild(el('p', 'rf-job__note', j.note));

      const act = el('div', 'rf-job__act');
      const collectBtn = el('button', 'btn sm ok', C.collect) as HTMLButtonElement;
      collectBtn.type = 'button';
      collectBtn.addEventListener('click', () => collect(j.id, collectBtn));
      const delBtn = el('button', 'btn sm ghost', C.del) as HTMLButtonElement;
      delBtn.type = 'button';
      delBtn.addEventListener('click', () => del(j.id));
      act.append(collectBtn, delBtn);
      card.appendChild(act);

      tickCard(card);
      return card;
    }

    function renderActive() {
      const active = jobs
        .filter((j) => j.status === 'active')
        .sort((a, b) => new Date(a.ready_at).getTime() - new Date(b.ready_at).getTime());
      const wrap = $('rfd-active');
      wrap.textContent = '';
      $('rfd-active-empty').hidden = active.length > 0;
      const n = $('rfd-active-n');
      n.hidden = active.length === 0;
      n.textContent = String(active.length);
      for (const j of active) wrap.appendChild(jobCard(j));
    }

    function histRow(j: RefineryJob) {
      const row = el('div', 'rf-hrow');
      const main = el('div');
      const top = el('div', 'rf-hrow__top');
      top.append(
        el('span', 'rf-job__station', stationByName.get(j.station)?.name || j.station),
        el('span', 'rf-chip', j.method),
        el('span', 'rf-hrow__date', C.collectedOn + ' ' + fmtDate(j.collected_at || j.created_at)),
      );
      main.appendChild(top);
      if (j.items?.length) {
        const ores = orePills(j.items);
        ores.className = 'rf-hrow__ores';
        main.appendChild(ores);
      }
      const soldWrap = el('div', 'rf-sold');
      main.appendChild(soldWrap);

      const val = jobValue(j);
      const profit = val - Number(j.cost || 0);
      const figs = el('dl', 'rf-figs');
      figs.append(
        fig(C.yieldLbl, fmtScu(Number(j.yield_scu), lang)),
        fig(j.sold_value != null ? C.soldFor : C.valueLbl, fmtAuec(val, lang), 'rf-gold'),
        fig(C.profit, fmtAuec(profit, lang), profit >= 0 ? 'rf-pos' : 'rf-neg'),
      );

      const act = el('div', 'rf-hrow__act');
      const soldBtn = el('button', 'rf-mini', C.setSold) as HTMLButtonElement;
      soldBtn.type = 'button';
      soldBtn.addEventListener('click', () => {
        const inp = el('input', 'inp rf-num') as HTMLInputElement;
        inp.type = 'number'; inp.min = '0'; inp.placeholder = 'aUEC';
        inp.value = j.sold_value != null ? String(j.sold_value) : '';
        const ok = el('button', 'btn sm primary', C.save) as HTMLButtonElement; ok.type = 'button';
        const cancel = el('button', 'btn sm ghost', C.cancel) as HTMLButtonElement; cancel.type = 'button';
        soldWrap.textContent = ''; soldWrap.append(inp, ok, cancel); inp.focus();
        ok.addEventListener('click', async () => {
          const v = parseFloat(inp.value);
          await update(j.id, { sold_value: isFinite(v) && v >= 0 ? v : null });
        });
        cancel.addEventListener('click', () => { soldWrap.textContent = ''; });
      });
      const delBtn = el('button', 'rf-mini rf-mini--rm', C.del) as HTMLButtonElement;
      delBtn.type = 'button';
      delBtn.addEventListener('click', () => del(j.id));
      act.append(soldBtn, delBtn);

      const right = el('div', 'rf-hrow__right');
      right.append(figs, act);
      row.append(main, right);
      return row;
    }

    function renderHistory() {
      const done = jobs
        .filter((j) => j.status === 'done')
        .sort((a, b) => new Date(b.collected_at || b.created_at).getTime() - new Date(a.collected_at || a.created_at).getTime());
      const wrap = $('rfd-history');
      wrap.textContent = '';
      $('rfd-history-empty').hidden = done.length > 0;
      for (const j of done) wrap.appendChild(histRow(j));
    }

    const renderAll = () => { renderStats(); renderActive(); renderHistory(); };

    function tickCard(card: HTMLElement) {
      const started = new Date(card.dataset.started!).getTime();
      const ready = new Date(card.dataset.ready!).getTime();
      const now = Date.now();
      const remaining = ready - now;
      const bar = card.querySelector('[data-role="bar"]') as HTMLElement;
      const cd = card.querySelector('[data-role="cd"]') as HTMLElement;
      const badge = card.querySelector('[data-role="badge"]') as HTMLElement;
      bar.style.width = Math.max(0, Math.min(100, ((now - started) / Math.max(1, ready - started)) * 100)) + '%';
      const isReady = remaining <= 0;
      card.classList.toggle('is-ready', isReady);
      badge.hidden = !isReady;
      cd.textContent = isReady ? C.readyNow : fmtCountdown(remaining / 1000);
      cd.appendChild(el('small', undefined, isReady ? `${C.readyAt} ${fmtReadyAt(card.dataset.ready!)}` : `${C.remaining} · ${C.readyAt} ${fmtReadyAt(card.dataset.ready!)}`));
    }
    setInterval(() => {
      $('rfd-active').querySelectorAll<HTMLElement>('.rf-job').forEach(tickCard);
      if (!tracker.hidden) {
        const now = Date.now();
        $('rfd-st-ready').textContent = String(jobs.filter((j) => j.status === 'active' && new Date(j.ready_at).getTime() <= now).length);
      }
    }, 1000);

    // Konto-Knopf (account-lite.js) zaehlt fertige Auftraege; er soll Abholen sofort sehen.
    const tellNav = () => document.dispatchEvent(new Event('vb:refinery'));

    async function collect(id: number, btn: HTMLButtonElement) {
      btn.disabled = true; btn.textContent = '…';
      const at = new Date().toISOString();
      const { error } = await supabase.from('refinery_jobs').update({ status: 'done', collected_at: at }).eq('id', id);
      if (error) { btn.disabled = false; btn.textContent = C.collect; return; }
      const j = jobs.find((x) => x.id === id);
      if (j) { j.status = 'done'; j.collected_at = at; }
      renderAll();
      tellNav();
    }
    async function del(id: number) {
      if (!confirm(C.confirmDel)) return;
      const { error } = await supabase.from('refinery_jobs').delete().eq('id', id);
      if (error) return;
      jobs = jobs.filter((x) => x.id !== id);
      renderAll();
      tellNav();
    }
    async function update(id: number, patch: Partial<RefineryJob>) {
      const { error } = await supabase.from('refinery_jobs').update(patch).eq('id', id);
      if (error) return;
      const j = jobs.find((x) => x.id === id);
      if (j) Object.assign(j, patch);
      renderAll();
    }

    // ---- Neuer-Auftrag-Formular -------------------------------------------
    const form = $('rfd-form') as HTMLFormElement;
    const oresBox = $('rfd-ores');
    const oreTpl = $('rfd-ore-tpl') as HTMLTemplateElement;
    const stationSel = $('rfd-station') as HTMLSelectElement;
    const methodSel = $('rfd-method') as HTMLSelectElement;
    const mtags = $('rfd-mtags');
    const hoursEl = $('rfd-hours') as HTMLInputElement;
    const minsEl = $('rfd-mins') as HTMLInputElement;
    const costEl = $('rfd-cost') as HTMLInputElement;

    function currentItems(): RefineryItem[] {
      const items: RefineryItem[] = [];
      oresBox.querySelectorAll('.rf-ore').forEach((row) => {
        const ore = (row.querySelector('[data-role="ore"]') as HTMLSelectElement).value;
        const rawScu = parseFloat((row.querySelector('[data-role="raw"]') as HTMLInputElement).value) || 0;
        const yieldScu = parseFloat((row.querySelector('[data-role="yield"]') as HTMLInputElement).value) || 0;
        if (ore && (rawScu > 0 || yieldScu > 0)) items.push({ ore, rawScu, yieldScu });
      });
      return items;
    }

    function updatePreview() {
      const items = currentItems();
      const val = estimateValue(items);
      $('rfd-pv-yield').textContent = `${fmtScu(items.reduce((s, it) => s + it.yieldScu, 0), lang)} ${C.scu}`;
      $('rfd-pv-value').textContent = val > 0 ? `${fmtAuec(val, lang)} aUEC` : '—';
      const mins = (parseInt(hoursEl.value) || 0) * 60 + (parseInt(minsEl.value) || 0);
      $('rfd-pv-ready').textContent = mins > 0
        ? `${fmtReadyAt(new Date(Date.now() + mins * 60000).toISOString())} (${fmtDuration(mins * 60)})`
        : '—';
    }

    // Erz-Hinweis: Preis, Aufschlag der gewählten Station, beste Station(en).
    function oreHint(row: HTMLElement) {
      const hint = row.querySelector('[data-role="hint"]') as HTMLElement;
      const ore = oreByName.get((row.querySelector('[data-role="ore"]') as HTMLSelectElement).value);
      hint.textContent = '';
      if (!ore) { hint.hidden = true; return; }
      const sep = () => hint.append(' · ');
      if (ore.sell != null) hint.append(C.hintPrice.replace('%p', fmtAuec(ore.sell, lang)));
      const ranked = rankStations(ore.name);
      const top = ranked[0]?.bonus ?? 0;
      const st = stationByName.get(stationSel.value);
      if (st) {
        const b = bonusAt(st, ore.name);
        if (hint.childNodes.length) sep();
        const [pre, post] = C.hintHere.split('%b');
        hint.append(pre, el('span', b > 0 ? 'rf-pos' : b < 0 ? 'rf-neg' : '', pct(b)), post);
        if (top > 0 && b === top) { sep(); hint.append(C.hintBestHere); }
      }
      if (top > 0 && !(st && bonusAt(st, ore.name) === top)) {
        if (hint.childNodes.length) sep();
        const names = ranked.filter((r) => r.bonus === top).map((r) => r.station.short).join(', ');
        const [pre, post] = C.hintBest.replace('%s', names).split('%b');
        hint.append(pre, el('span', 'rf-pos', pct(top)), post);
      }
      hint.hidden = !hint.childNodes.length;
    }

    function wireOreRow(row: HTMLElement) {
      const sel = row.querySelector('[data-role="ore"]') as HTMLSelectElement;
      sel.addEventListener('change', () => { oreHint(row); updatePreview(); });
      row.querySelector('[data-role="raw"]')!.addEventListener('input', updatePreview);
      row.querySelector('[data-role="yield"]')!.addEventListener('input', updatePreview);
      row.querySelector('[data-role="remove"]')!.addEventListener('click', () => {
        if (oresBox.querySelectorAll('.rf-ore').length > 1) row.remove();
        else {
          sel.value = '';
          (row.querySelector('[data-role="raw"]') as HTMLInputElement).value = '';
          (row.querySelector('[data-role="yield"]') as HTMLInputElement).value = '';
          oreHint(row);
        }
        updatePreview();
      });
    }
    function addOreRow() {
      const row = (oreTpl.content.cloneNode(true) as DocumentFragment).querySelector('.rf-ore') as HTMLElement;
      oresBox.appendChild(row);
      wireOreRow(row);
    }
    $('rfd-addore').addEventListener('click', addOreRow);
    stationSel.addEventListener('change', () => oresBox.querySelectorAll<HTMLElement>('.rf-ore').forEach(oreHint));

    methodSel.addEventListener('change', () => {
      const m = REFINERY.methods.find((x) => x.name === methodSel.value);
      mtags.textContent = '';
      mtags.hidden = !m;
      if (!m) return;
      const tag = (k: string, v: string) => { const s = el('span'); s.append(el('b', undefined, k + ':'), ' ' + v); return s; };
      mtags.append(tag(C.tagYield, C.lvl[m.yield] || m.yield), tag(C.tagSpeed, C.lvl[m.speed] || m.speed), tag(C.tagCost, C.lvl[m.cost] || m.cost));
    });
    [hoursEl, minsEl, costEl].forEach((e) => e.addEventListener('input', updatePreview));

    const formStatus = $('rfd-form-status');
    const submitBtn = $('rfd-submit') as HTMLButtonElement;
    const submitTxt = $('rfd-submit-txt');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formStatus.hidden = true;
      const station = stationSel.value;
      const method = methodSel.value;
      const items = currentItems();
      const mins = (parseInt(hoursEl.value) || 0) * 60 + (parseInt(minsEl.value) || 0);
      const cost = parseFloat(costEl.value) || 0;
      const note = ($('rfd-note') as HTMLInputElement).value.trim();
      if (!station || !method || !items.length || mins <= 0) {
        formStatus.textContent = C.errForm; formStatus.hidden = false; return;
      }
      const est = estimateValue(items);
      const started = new Date();

      submitBtn.disabled = true; submitTxt.textContent = C.submitBusy;
      const { data, error } = await supabase.from('refinery_jobs').insert({
        station, method, items,
        input_scu: items.reduce((s, it) => s + it.rawScu, 0),
        yield_scu: items.reduce((s, it) => s + it.yieldScu, 0),
        cost,
        est_value: est > 0 ? est : null,
        started_at: started.toISOString(),
        ready_at: new Date(started.getTime() + mins * 60000).toISOString(),
        status: 'active',
        note: note || null,
      }).select().single();
      submitBtn.disabled = false; submitTxt.textContent = C.submit;
      if (error || !data) { formStatus.textContent = C.errNet; formStatus.hidden = false; return; }

      jobs.unshift(data as RefineryJob);
      renderAll();
      tellNav();
      form.reset();
      mtags.hidden = true;
      oresBox.textContent = ''; addOreRow();
      updatePreview();
      $('rfd-active-col').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // ---- Benachrichtigungen (notification_settings) -----------------------
    // Keine Zeile = Vorgabe: Seite an, Discord aus. Geschrieben wird per
    // UPDATE, und nur ohne Zeile per INSERT (die Rechte erlauben kein Upsert).
    // Discord geht nur mit verbundenem Discord; der Bot findet das Konto
    // ueber discord_role_state.
    async function initNotify(uid: string) {
      const site = $('rfd-n-site') as HTMLInputElement;
      const dc = $('rfd-n-dc') as HTMLInputElement;
      const hint = $('rfd-n-hint');
      const status = $('rfd-n-status');
      const [{ data: prefs, error: prefErr }, { data: dcRow }] = await Promise.all([
        supabase.from('notification_settings').select('refinery_site, refinery_discord').maybeSingle(),
        supabase.from('discord_role_state').select('discord_user_id').maybeSingle(),
      ]);
      if (prefErr) {
        status.textContent = C.nUnavailable; status.hidden = false;
        return;
      }
      const linked = !!dcRow?.discord_user_id;
      site.checked = prefs ? prefs.refinery_site !== false : true;
      dc.checked = !!prefs?.refinery_discord && linked;
      site.disabled = false;
      dc.disabled = !linked;

      const showHint = () => {
        hint.textContent = '';
        if (!linked) {
          const a = el('a', 'btn sm', C.nDcLinkBtn) as HTMLAnchorElement;
          a.href = root.dataset.account || '#';
          hint.append(C.nDcLink + ' ', a);
        } else if (dc.checked) hint.append(C.nDcHow);
        hint.hidden = !hint.childNodes.length;
      };
      showHint();

      let exists = !!prefs;
      const save = async () => {
        status.hidden = true;
        const row = { refinery_site: site.checked, refinery_discord: dc.checked, lang };
        site.disabled = dc.disabled = true;
        let error: unknown = null;
        if (exists) {
          const r = await supabase.from('notification_settings').update(row).eq('user_id', uid).select('user_id');
          error = r.error;
          if (!r.error && !r.data?.length) exists = false;
        }
        if (!exists && !error) {
          const r = await supabase.from('notification_settings').insert(row);
          error = r.error;
          if (!error) exists = true;
        }
        site.disabled = false; dc.disabled = !linked;
        status.className = error ? 'acx-status' : 'acx-status acx-status--ok';
        status.textContent = error ? C.errNet : C.nSaved;
        status.hidden = false;
        showHint();
        if (!error) tellNav();
      };
      site.addEventListener('change', save);
      dc.addEventListener('change', save);
    }

    // ---- Start: angemeldet → Tracker, sonst Anmelde-Knopf -----------------
    const showOut = () => {
      ($('rfd-login') as HTMLAnchorElement).href = root.dataset.login + '?next=' + encodeURIComponent(location.pathname + '#tracker');
      loadingEl.hidden = true; outEl.hidden = false;
    };
    const init = async () => {
      const { data } = await supabase.auth.getSession();
      if (!data.session) { showOut(); return; }
      const { data: userData, error: userErr } = await supabase.auth.getUser();
      if (userErr) {
        const st = (userErr as { status?: number }).status;
        if (st !== 401 && st !== 403) throw userErr;
      }
      if (userErr || !userData.user) {
        clearAccountTraces(data.session.user.id, 'signout', browserStores());
        await supabase.auth.signOut({ scope: 'local' });
        showOut();
        return;
      }

      const { data: rows, error } = await supabase.from('refinery_jobs').select('*').order('ready_at', { ascending: true });
      if (error) throw error;
      jobs = (rows || []) as RefineryJob[];

      addOreRow();
      renderAll();
      updatePreview();
      loadingEl.hidden = true;
      tracker.hidden = false;
      initNotify(userData.user.id).catch((e) => {
        console.error('refinery notify init failed', e);
        const status = $('rfd-n-status');
        status.textContent = C.nUnavailable; status.hidden = false;
      });
    };

    init().catch((e) => {
      console.error('refinery dashboard init failed', e);
      const box = loadingEl.querySelector('.ck-empty')!;
      box.textContent = '';
      const retry = el('button', 'btn sm', C.retry) as HTMLButtonElement;
      retry.type = 'button';
      retry.addEventListener('click', () => location.reload());
      box.append(el('p', undefined, C.loadError), retry);
    });
  }
</script>
