---
// Refinery-Seite: öffentlicher Wissensteil (Erze, Ertrag je Raffinerie,
// Methoden) plus kontogebundener Tracker. Design = Konto-Cockpit
// (account-dossier.css, .dsr/.ck-*), damit Kacheln, Knöpfe und leere
// Zustände dieselben sind wie im Konto.
// Tracker: exakt, kein Schätzmodell. Der Nutzer trägt die Zahlen ein, die
// ihm das Ingame-Terminal zeigt; die Refinery-Ökonomie ist serverseitig.
// Ohne Anmeldung bleibt der Wissensteil sichtbar, der Tracker zeigt einen
// Anmelde-Knopf statt umzuleiten.
import { href } from '../../i18n/ui';
import { useHelp } from '../../i18n/help';
import ToolHelp from '../ToolHelp.astro';
import { REFINERY, stationsBySystem, rankStations, dataPatch } from '../../lib/refinery';
import { miningLink } from '../../lib/miningLinks';
import { jsonForScript } from '../../lib/safeJson';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;
const de = lang === 'de';
const h = useHelp(lang);
const loc = de ? 'de-DE' : 'en-US';

const stationGroups = stationsBySystem();
const methods = REFINERY.methods;
const ores = REFINERY.ores;
const patch = dataPatch();

const COPY = {
  de: {
    title: 'Raffinerie',
    lead: 'Ertrag aller %s Raffinerien je Erz, die %m Methoden und dein Tracker.',
    leadData: 'Spielstand %v, Preise von %u vom %d.',
    loading: 'Lade deine Refinery-Aufträge …',
    loadError: 'Konnte deine Aufträge nicht laden. Bitte Verbindung prüfen.',
    retry: 'Neu laden',
    outTitle: 'Dein Refinery-Tracker',
    outText: 'Melde dich an, um Aufträge mit Countdown zu verfolgen. Der Wert erscheint auch in deinem Konto.',
    login: 'Anmelden', register: 'Konto erstellen',
    stActive: 'Aktive Aufträge', stReady: 'Fertig zum Abholen', stPipe: 'SCU in Arbeit', stValue: 'Refinery-Wert',
    subActive: '%n aktiv', subActive1: '1 aktiv', subNoActive: 'keine aktiv',
    activeTitle: 'Aktive Aufträge',
    activeEmpty: 'Keine aktiven Aufträge. Trag einen neuen Auftrag ein, um das Tracking zu starten.',
    readyNow: 'Fertig zum Abholen', remaining: 'übrig', readyAt: 'fertig',
    yieldLbl: 'Ausbeute', valueLbl: 'gesch. Wert',
    collect: 'Abholen', del: 'Löschen', confirmDel: 'Diesen Auftrag löschen?',
    newTitle: 'Neuer Auftrag',
    fromTerminal: 'Trag die Werte aus dem Ingame-Terminal ein.',
    fStation: 'Raffinerie', pickStation: 'Raffinerie wählen',
    fMethod: 'Methode', pickMethod: 'Methode wählen',
    tagYield: 'Ausbeute', tagSpeed: 'Tempo', tagCost: 'Kosten',
    lvl: { vlow: 'sehr niedrig', low: 'niedrig', mid: 'mittel', high: 'hoch' } as Record<string, string>,
    fOresLbl: 'Erze', pickOre: 'Erz wählen',
    fRaw: 'Roh-SCU', fYield: 'Ausbeute-SCU', addOre: 'Erz hinzufügen', removeOre: 'Entfernen',
    hintPrice: '≈ %p aUEC/SCU', hintHere: 'hier %b', hintBest: 'am besten: %s (%b)', hintBestHere: 'beste Station',
    fDuration: 'Bearbeitungszeit', hLbl: 'Std', mLbl: 'Min',
    fCost: 'Kosten (aUEC)', fCostPh: 'z. B. 4200',
    fNote: 'Notiz', fNotePh: 'optional',
    pvYield: 'Ausbeute gesamt', pvValue: 'gesch. Verkaufswert', pvReady: 'Fertig um',
    submit: 'Tracking starten', submitBusy: 'Speichere …',
    errForm: 'Wähle Raffinerie, Methode, mindestens ein Erz mit Roh-SCU und eine Bearbeitungszeit über 0.',
    errNet: 'Das hat nicht geklappt. Bitte erneut versuchen.',
    notifyTitle: 'Benachrichtigungen',
    nSite: 'Mitteilung auf VerseBase.',
    nSiteSub: 'Der Konto-Knopf zeigt fertige Aufträge auf jeder Seite, und ein Hinweis erscheint, sobald einer fertig wird.',
    nDc: 'Discord-Nachricht vom Verse-Bot.',
    nDcSub: 'Der Bot schreibt dir privat, wenn ein Auftrag fertig ist.',
    nDcHow: 'Dafür musst du auf dem VerseBase-Discord sein und Direktnachrichten von Servermitgliedern erlauben.',
    nDcLink: 'Verbinde zuerst Discord in deinem Konto, dann kannst du die Discord-Nachricht anschalten.',
    nDcLinkBtn: 'Discord verbinden',
    nSaved: 'Gespeichert.',
    nUnavailable: 'Benachrichtigungen sind gerade nicht verfügbar.',
    histTitle: 'Historie',
    histEmpty: 'Noch nichts hier. Abgeholte Aufträge erscheinen hier.',
    lDone: 'abgeschlossen', lRefined: 'SCU raffiniert', lCost: 'Kosten', lProfit: 'Netto-Gewinn',
    profit: 'Gewinn', soldFor: 'Verkauft für', setSold: 'Erlös eintragen',
    collectedOn: 'abgeholt',
    save: 'Speichern', cancel: 'Abbrechen',
    scu: 'SCU',
    oresTitle: 'Raffinierbare Erze',
    oresNote: 'Ø Verkaufspreis laut UEX, Stand %d. Der Erzname führt zur Mining-Datenbank.',
    thOre: 'Erz', thKind: 'Art', thRarity: 'Seltenheit', thPrice: 'Ø aUEC/SCU', thBest: 'Beste Raffinerie', thSystems: 'Vorkommen',
    kind: { Metal: 'Metall', Mineral: 'Mineral', Ice: 'Eis' } as Record<string, string>,
    rarity: { common: 'häufig', uncommon: 'ungewöhnlich', rare: 'selten', epic: 'episch', legendary: 'legendär' } as Record<string, string>,
    noBonus: 'überall ±0 %',
    yieldTitle: 'Ertrag je Raffinerie',
    yieldLead: 'Aufschlag jeder Station auf die Ausbeute, je Erz.',
    yieldOre: 'Erz', showTable: 'Alle Aufschläge als Tabelle',
    tblStation: 'Station',
    methodsTitle: 'Methoden',
    methodsLead: 'Ausbeute, Tempo und Kosten je Methode als Stufen. Genaue Werte zeigt das Terminal.',
    thMethod: 'Methode',
    priceNote: 'Verkaufswerte auf Basis von UEX-Durchschnittspreisen (%d). Nur eine Schätzung, deinen echten Erlös trägst du in der Historie ein.',
  },
  en: {
    title: 'Refinery',
    lead: 'Yield of all %s refineries per ore, the %m methods, and your tracker.',
    leadData: 'Game version %v, prices from %u as of %d.',
    loading: 'Loading your refinery orders …',
    loadError: 'Could not load your orders. Please check your connection.',
    retry: 'Reload',
    outTitle: 'Your refinery tracker',
    outText: 'Sign in to track orders with a countdown. The value also shows up in your account.',
    login: 'Sign in', register: 'Create account',
    stActive: 'Active orders', stReady: 'Ready to collect', stPipe: 'SCU refining', stValue: 'Refinery value',
    subActive: '%n active', subActive1: '1 active', subNoActive: 'none active',
    activeTitle: 'Active work orders',
    activeEmpty: 'No active work orders. Log a new one to start tracking.',
    readyNow: 'Ready to collect', remaining: 'left', readyAt: 'ready',
    yieldLbl: 'Yield', valueLbl: 'est. value',
    collect: 'Collect', del: 'Delete', confirmDel: 'Delete this work order?',
    newTitle: 'New work order',
    fromTerminal: 'Enter the figures from the in-game terminal.',
    fStation: 'Refinery', pickStation: 'Select refinery',
    fMethod: 'Method', pickMethod: 'Select method',
    tagYield: 'Yield', tagSpeed: 'Speed', tagCost: 'Cost',
    lvl: { vlow: 'very low', low: 'low', mid: 'mid', high: 'high' } as Record<string, string>,
    fOresLbl: 'Ores', pickOre: 'Select ore',
    fRaw: 'Raw SCU', fYield: 'Yield SCU', addOre: 'Add ore', removeOre: 'Remove',
    hintPrice: '≈ %p aUEC/SCU', hintHere: 'here %b', hintBest: 'best: %s (%b)', hintBestHere: 'best station',
    fDuration: 'Processing time', hLbl: 'h', mLbl: 'min',
    fCost: 'Cost (aUEC)', fCostPh: 'e.g. 4200',
    fNote: 'Note', fNotePh: 'optional',
    pvYield: 'Total yield', pvValue: 'est. sell value', pvReady: 'Ready at',
    submit: 'Start tracking', submitBusy: 'Saving …',
    errForm: 'Pick a refinery, a method, at least one ore with raw SCU, and a processing time above 0.',
    errNet: 'That did not work. Please try again.',
    notifyTitle: 'Notifications',
    nSite: 'Notice on VerseBase.',
    nSiteSub: 'The account button shows finished orders on every page, and a notice pops up the moment one is done.',
    nDc: 'Discord message from Verse-Bot.',
    nDcSub: 'The bot messages you privately when an order is done.',
    nDcHow: 'You need to be on the VerseBase Discord and allow direct messages from server members.',
    nDcLink: 'Link Discord in your account first, then you can switch on the Discord message.',
    nDcLinkBtn: 'Link Discord',
    nSaved: 'Saved.',
    nUnavailable: 'Notifications are not available right now.',
    histTitle: 'History',
    histEmpty: 'Nothing here yet. Collected orders show up here.',
    lDone: 'completed', lRefined: 'SCU refined', lCost: 'Cost', lProfit: 'Net profit',
    profit: 'Profit', soldFor: 'Sold for', setSold: 'Record sale',
    collectedOn: 'collected',
    save: 'Save', cancel: 'Cancel',
    scu: 'SCU',
    oresTitle: 'Refinable ores',
    oresNote: 'Average sell price from UEX, as of %d. The ore name links to the mining database.',
    thOre: 'Ore', thKind: 'Type', thRarity: 'Rarity', thPrice: 'Avg aUEC/SCU', thBest: 'Best refinery', thSystems: 'Found in',
    kind: { Metal: 'Metal', Mineral: 'Mineral', Ice: 'Ice' } as Record<string, string>,
    rarity: { common: 'common', uncommon: 'uncommon', rare: 'rare', epic: 'epic', legendary: 'legendary' } as Record<string, string>,
    noBonus: '±0 % everywhere',
    yieldTitle: 'Yield by refinery',
    yieldLead: 'Each station’s bonus or penalty on yield, per ore.',
    yieldOre: 'Ore', showTable: 'All bonuses as a table',
    tblStation: 'Station',
    methodsTitle: 'Methods',
    methodsLead: 'Yield, speed and cost per method as levels. The terminal shows the exact numbers.',
    thMethod: 'Method',
    priceNote: 'Sell values based on UEX average prices (%d). An estimate only, record your actual proceeds in the history.',
  },
}[lang];

const priceDate = REFINERY.meta.priceDate ? new Date(REFINERY.meta.priceDate + 'T12:00:00Z').toLocaleDateString(loc, { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
const loginHref = href('/account/login.html', lang);
const registerHref = href('/account/register.html', lang);
const pct = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '±') + Math.abs(n) + ' %';
const fmtPrice = (n: number | null) => (n == null ? '—' : Math.round(n).toLocaleString(loc));
const LVL = { vlow: 1, low: 2, mid: 3, high: 4 } as Record<string, number>;
const methodRows = methods.map((m) => ({ ...m, y: LVL[m.yield], s: LVL[m.speed], c: LVL[m.cost] }));

const oreRows = ores
  .map((o) => {
    const ranked = rankStations(o.name);
    const top = ranked[0]?.bonus ?? 0;
    return { o, top, best: top > 0 ? ranked.filter((r) => r.bonus === top).map((r) => r.station) : [], link: miningLink(o.name, lang) };
  })
  .sort((a, b) => (b.o.sell ?? -1) - (a.o.sell ?? -1));

// Vorauswahl im Ertragsvergleich: das wertvollste Erz mit einem echten Unterschied zwischen den Stationen.
const defaultOre = oreRows.find((r) => r.top > 0)?.o.name ?? ores[0]?.name;
const SYSTEM_TOPIC: Record<string, string> = { Pyro: '/topics/4-0-0-pyro-system.html', Nyx: '/topics/4-4-0-nyx-system.html' };
const systemHref = (s: string) => (SYSTEM_TOPIC[s] ? href(SYSTEM_TOPIC[s], lang) : null);
const oreHref = Object.fromEntries(oreRows.map((r) => [r.o.name, r.link]));
// leadData: Text um die beiden Links (Spielstand, UEX) herum.
const leadData = (() => { const [a, rest] = COPY.leadData.replace('%d', priceDate).split('%v'); const [b, c] = rest.split('%u'); return [a, b, c]; })();
---

<div class="dsr rf" id="rf" data-lang={lang} data-login={loginHref} data-account={href('/account.html', lang) + '#security'}>
  <script type="application/json" id="rfd-copy" is:inline set:html={jsonForScript({ ...COPY, oreHref })} />
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <g id="rf-ic-refinery" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v6l-5.2 9.2A2 2 0 0 0 5.6 21h12.8a2 2 0 0 0 1.8-2.8L15 9V3"/><path d="M8 3h8M7 14.5h10"/></g>
      <g id="rf-ic-hex" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l8.2 4.7v9.6L12 21.5l-8.2-4.7V7.2z"/></g>
      <g id="rf-ic-check" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></g>
      <g id="rf-ic-gem" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3L6 9l6 12 6-12-3-6"/></g>
      <g id="rf-ic-lock" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/><path d="M12 14.5v2.5"/></g>
      <g id="rf-ic-plus" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></g>
    </defs>
  </svg>

  <div class="rf-in ck">
    <header class="rf-head">
      <h1>{COPY.title}</h1>
      <p>
        {COPY.lead.replace('%s', String(REFINERY.stations.length)).replace('%m', String(methods.length))}
        {' '}{leadData[0]}{patch ? <a href={href(patch.path, lang)}>{patch.label}</a> : '—'}{leadData[1]}<a href="https://uexcorp.space/commodities" target="_blank" rel="noopener">UEX</a>{leadData[2]}
      </p>
    </header>

    <!-- ===== Tracker ===== -->
    <section id="tracker" class="rf-sec">
      <ToolHelp tool="refinerytracker" lang={lang} steps={4} />
      <div id="rfd-loading" class="ck-col"><div class="ck-empty"><p>{COPY.loading}</p></div></div>

      <div id="rfd-out" class="ck-col" hidden>
        <h2 class="ck-h">{COPY.outTitle}</h2>
        <div class="ck-empty">
          <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-lock"/></svg>
          <p>{COPY.outText}</p>
          <div class="rf-acts">
            <a class="btn primary" id="rfd-login" href={loginHref}>{COPY.login}</a>
            <a class="btn" href={registerHref}>{COPY.register}</a>
          </div>
        </div>
      </div>

      <div id="rfd" class="rf-tracker" hidden>
        <div class="ck-strip rf-strip" data-help={h('refinerytracker.ctl.stats')}>
          <a class="ck-stat" href="#rfd-active-col">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-hex"/></svg><b class="tnum" id="rfd-st-active">0</b><span>{COPY.stActive}</span>
          </a>
          <a class="ck-stat" href="#rfd-active-col">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-check"/></svg><b class="tnum" id="rfd-st-ready">0</b><span>{COPY.stReady}</span>
          </a>
          <a class="ck-stat" href="#rfd-active-col">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-gem"/></svg><b class="tnum" id="rfd-st-pipe">0</b><span>{COPY.stPipe}</span>
          </a>
          <a class="ck-stat ck-stat--gold" href="#rfd-hist-col">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-refinery"/></svg><b class="tnum" id="rfd-st-value">—</b><span>{COPY.stValue}</span><em id="rfd-st-sub"></em>
            <svg class="ck-spark" id="rfd-spark" viewBox="0 0 120 26" preserveAspectRatio="none" aria-hidden="true"></svg>
          </a>
        </div>

        <section class="ck-col" id="rfd-notify" aria-labelledby="rfd-notify-h" data-help={h('refinerytracker.ctl.notify')}>
          <h2 class="ck-h" id="rfd-notify-h">{COPY.notifyTitle}</h2>
          <div class="rf-pad rf-notify">
            <label class="pf-check"><input type="checkbox" id="rfd-n-site" disabled /><span><b>{COPY.nSite}</b> {COPY.nSiteSub}</span></label>
            <label class="pf-check"><input type="checkbox" id="rfd-n-dc" disabled /><span><b>{COPY.nDc}</b> {COPY.nDcSub}</span></label>
            <p class="rf-src" id="rfd-n-hint" hidden></p>
            <p class="acx-status" id="rfd-n-status" role="status" aria-live="polite" hidden></p>
          </div>
        </section>

        <div class="rf-cols">
          <section class="ck-col" id="rfd-active-col" aria-labelledby="rfd-active-h">
            <h2 class="ck-h" id="rfd-active-h">{COPY.activeTitle}<span class="rf-n" id="rfd-active-n" hidden></span></h2>
            <div id="rfd-active" class="rf-jobs" data-help={h('refinerytracker.ctl.active')}></div>
            <div id="rfd-active-empty" class="ck-empty" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-refinery"/></svg>
              <p>{COPY.activeEmpty}</p>
            </div>
          </section>

          <section class="ck-col" aria-labelledby="rfd-new-h">
            <h2 class="ck-h" id="rfd-new-h">{COPY.newTitle}</h2>
            <form id="rfd-form" class="rf-form" novalidate>
              <p class="rf-note">{COPY.fromTerminal}</p>
              <div class="rf-grid2">
                <div class="field">
                  <label for="rfd-station">{COPY.fStation}</label>
                  <select class="inp ctrl" id="rfd-station" name="station" required data-help={h('refinerytracker.ctl.station')}>
                    <option value="" selected disabled>{COPY.pickStation}</option>
                    {stationGroups.map((g) => (
                      <optgroup label={g.system}>
                        {g.stations.map((s) => (<option value={s.name}>{s.name}</option>))}
                      </optgroup>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="rfd-method">{COPY.fMethod}</label>
                  <select class="inp ctrl" id="rfd-method" name="method" required data-help={h('refinerytracker.ctl.method')}>
                    <option value="" selected disabled>{COPY.pickMethod}</option>
                    {methods.map((m) => (<option value={m.name}>{m.name}</option>))}
                  </select>
                  <div class="rf-mtags" id="rfd-mtags" hidden></div>
                </div>
              </div>

              <div class="field">
                <label>{COPY.fOresLbl}</label>
                <div id="rfd-ores" class="rf-ores" data-help={h('refinerytracker.ctl.ores')}></div>
                <button type="button" class="btn sm ghost rf-addore" id="rfd-addore"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-plus"/></svg>{COPY.addOre}</button>
              </div>

              <div class="rf-grid3">
                <div class="field">
                  <label for="rfd-hours">{COPY.fDuration}</label>
                  <div class="rf-dur" data-help={h('refinerytracker.ctl.duration')}>
                    <input class="inp rf-num" id="rfd-hours" name="hours" type="number" min="0" max="240" step="1" inputmode="numeric" placeholder="0" />
                    <span>{COPY.hLbl}</span>
                    <input class="inp rf-num" id="rfd-mins" name="mins" type="number" min="0" max="59" step="1" inputmode="numeric" placeholder="0" />
                    <span>{COPY.mLbl}</span>
                  </div>
                </div>
                <div class="field">
                  <label for="rfd-cost">{COPY.fCost}</label>
                  <input class="inp rf-num" id="rfd-cost" name="cost" type="number" min="0" step="1" inputmode="numeric" placeholder={COPY.fCostPh} />
                </div>
                <div class="field">
                  <label for="rfd-note">{COPY.fNote} <span class="hint">{COPY.fNotePh}</span></label>
                  <input class="inp" id="rfd-note" name="note" type="text" maxlength="500" autocomplete="off" />
                </div>
              </div>

              <dl class="rf-preview" id="rfd-preview" aria-live="polite" data-help={h('refinerytracker.ctl.preview')}>
                <div><dt>{COPY.pvYield}</dt><dd id="rfd-pv-yield">— {COPY.scu}</dd></div>
                <div><dt>{COPY.pvValue}</dt><dd class="rf-gold" id="rfd-pv-value">—</dd></div>
                <div><dt>{COPY.pvReady}</dt><dd id="rfd-pv-ready">—</dd></div>
              </dl>

              <div class="rf-acts">
                <button class="btn primary" type="submit" id="rfd-submit"><span id="rfd-submit-txt">{COPY.submit}</span></button>
              </div>
              <p class="acx-status" id="rfd-form-status" role="status" aria-live="polite" hidden></p>
              <p class="rf-src">{COPY.priceNote.replace('%d', priceDate)}</p>
            </form>
          </section>
        </div>

        <section class="ck-col" id="rfd-hist-col" aria-labelledby="rfd-hist-h">
          <h2 class="ck-h" id="rfd-hist-h">{COPY.histTitle}</h2>
          <dl class="rf-life" id="rfd-life" hidden></dl>
          <div id="rfd-history" class="rf-hist" data-help={h('refinerytracker.ctl.history')}></div>
          <div id="rfd-history-empty" class="ck-empty" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#rf-ic-check"/></svg>
            <p>{COPY.histEmpty}</p>
          </div>
        </section>
      </div>
    </section>

    <!-- ===== Erze ===== -->
    <section id="erze" class="ck-col rf-sec" aria-labelledby="rf-ores-h">
      <h2 class="ck-h" id="rf-ores-h">{COPY.oresTitle}<span class="rf-n">{ores.length}</span></h2>
      <div class="rf-scroll">
        <table class="rf-table">
          <thead><tr><th scope="col">{COPY.thOre}</th><th scope="col">{COPY.thKind}</th><th scope="col">{COPY.thRarity}</th><th scope="col" class="num">{COPY.thPrice}</th><th scope="col">{COPY.thBest}</th><th scope="col">{COPY.thSystems}</th></tr></thead>
          <tbody>
            {oreRows.map(({ o, top, best, link }) => (
              <tr>
                <th scope="row">{link ? <a href={link}>{o.name}</a> : o.name}{o.code && <small>{o.code}</small>}</th>
                <td>{(o.kind && COPY.kind[o.kind]) || o.kind || '—'}</td>
                <td>{o.rarity ? <span class={`rf-rar rf-rar--${o.rarity}`}>{COPY.rarity[o.rarity] || o.rarity}</span> : '—'}</td>
                <td class="num tnum">{fmtPrice(o.sell)}</td>
                <td>
                  {best.length
                    ? <button type="button" class="rf-pick" data-ore={o.name}><b class="rf-pos">{pct(top)}</b> {best.map((s) => s.short).join(', ')}</button>
                    : <span class="rf-mut">{COPY.noBonus}</span>}
                </td>
                <td>{o.systems.length ? o.systems.map((s, i) => { const sh = systemHref(s); return <>{i > 0 && ', '}{sh ? <a href={sh}>{s}</a> : s}</>; }) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="rf-src rf-pad">{COPY.oresNote.replace('%d', priceDate)}</p>
    </section>

    <!-- ===== Ertrag je Raffinerie ===== -->
    <section id="ertrag" class="ck-col rf-sec" aria-labelledby="rf-yield-h">
      <h2 class="ck-h" id="rf-yield-h">{COPY.yieldTitle}<span class="rf-n">{REFINERY.stations.length}</span></h2>
      <div class="rf-pad">
        <p class="rf-lead">{COPY.yieldLead}</p>
        <div class="field rf-oresel">
          <label for="rf-yield-ore">{COPY.yieldOre}</label>
          <select class="inp ctrl" id="rf-yield-ore">
            {ores.map((o) => (<option value={o.name} selected={o.name === defaultOre}>{o.name}</option>))}
          </select>
          <a class="rf-orelink" id="rf-yield-link" href={oreHref[defaultOre] ?? '#'}>{defaultOre}</a>
        </div>
        <ol class="rf-rank" id="rf-rank">
          {rankStations(defaultOre).map(({ station, bonus }) => (
            <li class={bonus > 0 ? 'is-pos' : bonus < 0 ? 'is-neg' : 'is-zero'}>
              <span class="rf-rank__n">{station.name}</span>
              <span class="rf-rank__s">{station.system}</span>
              <span class="rf-rank__bar"><i style={`width:${Math.min(100, Math.abs(bonus) / 13 * 100)}%`}></i></span>
              <b class="tnum">{pct(bonus)}</b>
            </li>
          ))}
        </ol>
        <details class="rf-matrix">
          <summary>{COPY.showTable}</summary>
          <div class="rf-scroll">
            <table class="rf-table rf-table--matrix">
              <thead><tr><th scope="col">{COPY.tblStation}</th>{ores.map((o) => <th scope="col" class="num" title={o.name}>{o.code || o.name}</th>)}</tr></thead>
              <tbody>
                {stationGroups.map((g) => (
                  <>
                    <tr class="rf-sys"><th scope="rowgroup" colspan={ores.length + 1}>{systemHref(g.system) ? <a href={systemHref(g.system)!}>{g.system}</a> : g.system}</th></tr>
                    {g.stations.map((s) => (
                      <tr>
                        <th scope="row">{s.name}</th>
                        {ores.map((o) => { const b = s.bonus[o.name] ?? 0; return <td class={`num tnum ${b > 0 ? 'rf-pos' : b < 0 ? 'rf-neg' : 'rf-mut'}`}>{b ? (b > 0 ? '+' : '−') + Math.abs(b) : '·'}</td>; })}
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </section>

    <!-- ===== Methoden ===== -->
    <section id="methoden" class="ck-col rf-sec" aria-labelledby="rf-meth-h">
      <h2 class="ck-h" id="rf-meth-h">{COPY.methodsTitle}<span class="rf-n">{methods.length}</span></h2>
      <p class="rf-lead rf-pad">{COPY.methodsLead}</p>
      <div class="rf-scroll">
        <table class="rf-table rf-table--meth">
          <thead><tr><th scope="col">{COPY.thMethod}</th><th scope="col">{COPY.tagYield}</th><th scope="col">{COPY.tagSpeed}</th><th scope="col">{COPY.tagCost}</th></tr></thead>
          <tbody>
            {methodRows.map((m) => (
              <tr>
                <th scope="row">{m.name}</th>
                {([[m.y, m.yield, ''], [m.s, m.speed, ''], [m.c, m.cost, ' rf-meter--cost']] as const).map(([n, k, cls]) => (
                  <td><span class={'rf-meter' + cls} data-n={n}><i></i><i></i><i></i><i></i></span> {COPY.lvl[k]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>

<!-- Vorlage einer Erz-Zeile (Optionen serverseitig gerendert, der Klon behält sie) -->
