  <div class="dsr">

    <!-- ===== Konto-Rahmen (wie Discord): links du + Discord + Bereiche,
         Mitte der gewählte Bereich, rechts die Freundesliste. Breite Schirme
         zeigen alles auf einem Bildschirm; nur Listen scrollen in ihrem
         Kasten. Die ov*-IDs füllt account-dashboard.ts (live beim Tippen). ===== -->
    <div class="acc">
    <aside class="acc-side">
      <div class="acc-id">
        <div class="acc-id__banner" id="ovBanner" aria-hidden="true"></div>
        <div class="acc-id__row">
          <div class="ph__av acc-id__av" id="ovAvatarBox"><span id="ovAvatarText">◆</span><img id="ovAvatarImg" src="" alt="" hidden /><span class="ph__avdot" id="ovStatusDot" aria-hidden="true"></span></div>
          <div class="acc-id__who">
            <h1 class="acc-id__name" id="ovName">Citizen</h1>
            <span class="acc-id__handle" id="ovHandle">@citizen</span>
          </div>
        </div>
        <div class="acc-id__status" id="ovStatusPill"><span id="ovStatusLabel"></span></div>
        <div class="acc-id__chips">
          <span class="acc-chip ok" id="ovVerified" hidden title={lang === 'de' ? 'RSI verifiziert' : 'RSI verified'}><svg viewBox="0 0 24 24"><use href="#ic-check"/></svg> RSI</span>
          <span class="acc-chip" id="ovRolePill" hidden><b id="ovRoleText"></b></span>
          <span class="acc-chip" id="ovOrgPill" hidden><svg viewBox="0 0 24 24"><use href="#ic-org"/></svg> <span id="ovOrgText"></span></span>
        </div>
        <p class="acc-id__bio" id="ovLede" hidden></p>
        <div class="acc-id__soc" id="ovSocials" hidden></div>
        <span class="acc-id__since">{COPY.memberSince} <span id="idSince">—</span><span id="ovRegId" hidden>VB-••••••••</span></span>
      </div>

      <!-- Discord-Verbindung: vorne statt unter "Sicherheit". Der Freitext
           "Discord Tag" im Profil ist nur eine Behauptung; HIER entsteht der
           Nachweis (linkIdentity -> Trigger sync_discord_identity ->
           discord_role_state), an dem der Bot das Konto findet. -->
      <div class="acc-dc" id="discordLinkCard" title={COPY.dcLinkDesc}>
        <span class="acc-dc__logo" id="dcLogo" aria-hidden="true"><svg viewBox="0 0 127.14 96.36"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21H.55A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg></span>
        <img class="acc-dc__av" id="dcAvatar" src="" alt="" hidden />
        <div class="acc-dc__txt">
          <b>Discord</b>
          <span id="dcLinkState">{COPY.dcLinkNone}</span>
        </div>
        <button type="button" class="btn ok sm" id="btnDiscordLink" data-idle={COPY.dcLinkBtn} data-busy={COPY.dcLinkBusy}>{COPY.dcLinkBtn}</button>
        <button type="button" class="acc-dc__off" id="btnDiscordUnlink" data-idle={COPY.dcUnlinkBtn} data-busy={COPY.dcUnlinkBusy} hidden>{COPY.dcUnlinkBtn}</button>
        <p class="acx-status" id="dcLinkStatus" role="status" aria-live="polite" hidden></p>
      </div>

      <nav class="acc-nav" role="tablist" aria-label={lang === 'de' ? 'Konto-Bereiche' : 'Account sections'} aria-orientation="vertical">
        <button type="button" class="tab" role="tab" aria-selected="true" data-tab="overview"><svg viewBox="0 0 24 24"><use href="#ic-hex"/></svg><span class="lbl">{lang === 'de' ? 'Übersicht' : 'Overview'}</span></button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-tab="profile"><svg viewBox="0 0 24 24"><use href="#ic-edit"/></svg><span class="lbl">{COPY.tabProfile}</span></button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-tab="favs"><svg viewBox="0 0 24 24"><use href="#ic-star"/></svg><span class="lbl">{COPY.tabFavs}</span><span class="badge" id="navFavCount" hidden>0</span></button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-tab="friends"><svg viewBox="0 0 24 24"><use href="#ic-users"/></svg><span class="lbl">{COPY.tabFriends}</span><span class="badge" id="navFriendCount" hidden>0</span><span class="badge badge--chat" id="navChatUnread" hidden>0</span></button>
        <button type="button" class="tab" role="tab" aria-selected="false" data-tab="security"><svg viewBox="0 0 24 24"><use href="#ic-shield"/></svg><span class="lbl">{COPY.tabSecurity}</span></button>
      </nav>

      <div class="acc-side__foot">
        <button type="button" class="btn sm" id="ovBtnShare"><svg viewBox="0 0 24 24"><use href="#ic-id"/></svg> {lang === 'de' ? 'Öffentliches Profil' : 'Public profile'}</button>
        <button type="button" class="logout" id="btnLogout" title={COPY.logout} aria-label={COPY.logout}><svg viewBox="0 0 24 24"><use href="#ic-power"/></svg> <span>{COPY.logout}</span></button>
      </div>
    </aside>

    <div class="acc-main dpanels">

      <!-- ============================ ÜBERSICHT ============================ -->
      <section id="tab-panel-overview" class="acx-tab-panel"
        data-l-pending={COPY.ovPending} data-l-pending1={COPY.ovPending1} data-l-nopending={COPY.ovNoPending}
        data-l-active={COPY.ovActive} data-l-active1={COPY.ovActive1} data-l-noactive={COPY.ovNoActive}
        data-l-missing={COPY.ovMissing} data-l-missing1={COPY.ovMissing1} data-l-complete={COPY.ovComplete}
        data-l-rsi-yes={COPY.ovRsiYes} data-l-rsi-no={COPY.ovRsiNo}
        data-l-act-fav={COPY.ovActFav} data-l-act-req={COPY.ovActReq} data-l-act-job={COPY.ovActJob} data-l-act-empty={COPY.ovActEmpty}>
        <div class="ck" id="ck" data-copy={JSON.stringify(CK)} data-invite={DISCORD.invite} data-lang={lang}>

          <div class="ck-top">
            <!-- Discord-Rang: Stand kommt vom Rang-Bot (discord_role_state) -->
            <article class="ck-rank" id="ckRank" data-state="loading" style="--rc:var(--accent)">
              <div class="ck-rank__badge" aria-hidden="true"><span id="ckRankIns">◆</span><svg viewBox="0 0 127.14 96.36"><use href="#ic-discord"/></svg></div>
              <div class="ck-rank__main">
                <div class="ck-k"><svg viewBox="0 0 127.14 96.36" aria-hidden="true"><use href="#ic-discord"/></svg>{CK.rank}</div>
                <div class="ck-rank__title"><b id="ckRankName">—</b><span class="ck-lv" id="ckRankLv" hidden></span><span class="ck-pres" id="ckPrestige" hidden></span></div>
                <div class="ck-rank__live" id="ckRankLive">
                  <div class="ck-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="ckBarWrap"><i id="ckBar"></i></div>
                  <div class="ck-rank__row"><span id="ckXp"></span><span id="ckNext"></span></div>
                  <ol class="ck-ladder" id="ckLadder" aria-hidden="true"></ol>
                </div>
                <div class="ck-rank__cta" id="ckRankCta" hidden>
                  <p id="ckRankMsg"></p>
                  <a class="btn sm ok" id="ckRankBtn" href="#" target="_blank" rel="noopener"></a>
                </div>
              </div>
              <dl class="ck-rank__stats" id="ckRankStats">
                <div><dt>{CK.pos}</dt><dd id="ckPos">—</dd></div>
                <div><dt>{CK.msgs}</dt><dd id="ckMsgs">—</dd></div>
                <div><dt>{CK.voice}</dt><dd id="ckVoice">—</dd></div>
              </dl>
            </article>

            <!-- Profil-Check: Ring + was noch fehlt (Klick springt hin) -->
            <article class="ck-check" id="ckCheck">
              <div class="ck-ring" role="button" tabindex="0" data-tab-jump="profile" aria-label={COPY.ovTComplete}>
                <svg width="76" height="76" viewBox="0 0 58 58" aria-hidden="true">
                  <circle cx="29" cy="29" r="18" fill="none" stroke="var(--line)" stroke-width="5"/>
                  <circle id="ovRing" cx="29" cy="29" r="18" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="113" transform="rotate(-90 29 29)"/>
                </svg>
                <b id="ovComplete">0%</b>
              </div>
              <div class="ck-check__body">
                <div class="ck-k">{CK.profile}</div>
                <p class="ck-check__sub" id="ovCompleteSub"></p>
                <ul class="ck-todo" id="ckTodo"></ul>
                <div class="ck-rsi" role="button" tabindex="0" data-tab-jump="security" aria-label={COPY.ovTRsi}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-shield"/></svg>
                  <span>RSI</span><b id="ovRsi">—</b><span class="ck-rsi__h" id="ovRsiSub"></span>
                </div>
              </div>
            </article>
          </div>

          <div class="ck-strip">
            <div class="ck-stat" role="button" tabindex="0" data-tab-jump="favs" aria-label={COPY.ovTFavs}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-star"/></svg><b class="tnum" id="ovStatFavs">0</b><span>{COPY.ovTFavs}</span>
            </div>
            <div class="ck-stat" role="button" tabindex="0" data-tab-jump="friends" aria-label={COPY.ovTFriends}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-users"/></svg><b class="tnum" id="ovStatFriends">0</b><span>{COPY.ovTFriends}</span><em id="ovFriendsSub"></em>
            </div>
            <a class="ck-stat" href={hangarHref} aria-label={CK.loadouts}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-hex"/></svg><b class="tnum" id="ckStatLayouts">0</b><span>{CK.loadouts}</span>
            </a>
            <a class="ck-stat ck-stat--gold" href={refineryHref} aria-label={COPY.ovTRefValue}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-refinery"/></svg><b class="tnum" id="ovRefValue">—</b><span>{COPY.ovTRefValue}</span><em id="ovRefSub"></em>
              <svg class="ck-spark" id="ovRefSpark" viewBox="0 0 120 26" preserveAspectRatio="none" aria-hidden="true"></svg>
            </a>
          </div>

          <div class="ck-cols">
            <section class="ck-col" aria-labelledby="ckChatsH">
              <h3 class="ck-h" id="ckChatsH">{CK.chats}<span class="ck-h__n" id="ckChatsN" hidden></span></h3>
              <ul class="ck-list" id="ckChats"></ul>
              <div class="ck-empty" id="ckChatsEmpty" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-users"/></svg>
                <p>{CK.chatsEmpty}</p>
                <button type="button" class="btn sm" data-tab-jump="friends">{CK.chatsCta}</button>
              </div>
            </section>
            <section class="ck-col" aria-labelledby="ckFavsH">
              <h3 class="ck-h" id="ckFavsH">{CK.saved}</h3>
              <ul class="ck-tiles" id="ckFavs"></ul>
              <div class="ck-empty" id="ckFavsEmpty" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-star"/></svg>
                <p>{CK.savedEmpty}</p>
                <a class="btn sm" href={hangarHref}>{CK.savedCta}</a>
              </div>
            </section>
            <section class="ck-col" aria-labelledby="ckActH">
              <h3 class="ck-h" id="ckActH">{COPY.ovRecent}</h3>
              <div class="card log ck-log" id="ovActivity"></div>
              <div class="ck-empty" id="ovActEmpty" hidden>
                <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-hex"/></svg>
                <p>{COPY.ovActEmpty}</p>
              </div>
            </section>
          </div>

        </div>
      </section>

      <!-- ============================ PROFIL ============================ -->
      <section id="tab-panel-profile" class="acx-tab-panel" hidden>
        <div class="dsec"><h2>{COPY.secProfile}</h2></div>
        <div class="form2">
          <div>
            <form id="profileForm" novalidate>
              <div class="subpanel sp-id">
                <h3 class="subhead">{lang === 'de' ? 'Öffentliche Identität' : 'Public Identity'}</h3>
                <div class="field">
                  <label for="pfName">{COPY.name}</label>
                  <input class="inp" id="pfName" name="display_name" type="text" maxlength="60" autocomplete="nickname" placeholder={COPY.namePh} />
                </div>
                <div class="field">
                  <label for="pfHandle">{COPY.handle} <span class="hint">{COPY.optional}</span></label>
                  <div class="inp-affix"><span class="pre">@</span><input class="inp mono" id="pfHandle" name="handle" type="text" maxlength="24" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder={COPY.handlePh} /></div>
                </div>
                <div class="field" style="margin-bottom:0">
                  <label for="pfBio">{COPY.bio}</label>
                  <textarea class="inp" id="pfBio" name="bio" rows="3" maxlength="500" placeholder={COPY.bioPh}></textarea>
                </div>
              </div>

              <div class="subpanel sp-design">
                <h3 class="subhead">{COPY.secDesign}</h3>
                <div class="field">
                  <label>{COPY.bannerSelect}</label>
                  <div class="banner-grid-picker" id="bannerGridPicker">
                    {BANNER_PRESETS.map((b, idx) => (
                      <button type="button" class={`banner-thumb-card ${idx === 0 ? 'selected' : ''}`} data-banner-url={b.url} style={`background-image: url('${b.thumb}')`}>
                        <span class="banner-thumb-title">{b.name}</span>
                      </button>
                    ))}
                  </div>
                  <div class="acx-upload" data-kind="banner">
                    <input type="file" id="pfBannerFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                    <button type="button" class="acx-upload__btn" id="pfBannerUploadBtn"><span class="acx-upload__ico" aria-hidden="true">⬆</span> <span>{COPY.uploadBanner}</span></button>
                    <button type="button" class="acx-upload__remove" id="pfBannerRemove" hidden>{COPY.uploadRemove}</button>
                    <span class="acx-upload__status" id="pfBannerUploadStatus" role="status" aria-live="polite"></span>
                  </div>
                  <!-- Datenträger für die Banner-URL (Picker/Upload schreiben rein); nicht sichtbar -->
                  <input type="hidden" id="pfBannerUrl" />
                </div>

                <div class="field" style="margin-bottom:0;margin-top:1.2rem">
                  <div class="pf-avatar-row">
                    <div>
                      <label>{COPY.avatarSelect}</label>
                      <div class="avatar-grid-picker" id="avatarGridPicker">
                        {AVATAR_PRESETS.map((a, idx) => (
                          <button type="button" class={`avatar-thumb-card ${idx === 0 ? 'selected' : ''}`} data-avatar-icon={a.symbol} data-avatar-color={a.defaultColor} title={a.name}>
                            <span>{a.symbol}</span>
                          </button>
                        ))}
                      </div>
                      <div class="acx-upload" data-kind="avatar">
                        <input type="file" id="pfAvatarFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                        <button type="button" class="acx-upload__btn" id="pfAvatarUploadBtn"><span class="acx-upload__ico" aria-hidden="true">⬆</span> <span>{COPY.uploadAvatar}</span></button>
                        <button type="button" class="acx-upload__btn acx-upload__dc" id="pfAvatarDiscord" hidden><img id="pfAvatarDiscordImg" src="" alt="" /> <span>{COPY.avatarDiscord}</span></button>
                        <button type="button" class="acx-upload__remove" id="pfAvatarRemove" hidden>{COPY.uploadRemove}</button>
                        <span class="acx-upload__status" id="pfAvatarUploadStatus" role="status" aria-live="polite"></span>
                      </div>
                      <!-- Datenträger für die Avatar-URL (Picker/Upload schreiben rein); nicht sichtbar -->
                      <input type="hidden" id="pfAvatarUrl" />
                    </div>
                    <div>
                      <label>{COPY.avatarColorSelect}</label>
                      <div class="color-grid-picker" id="colorGridPicker">
                        {ACCENT_COLORS.map((c, idx) => (
                          <button type="button" class={`color-swatch ${idx === 0 ? 'selected' : ''}`} data-color={c.hex} style={`background: ${c.hex}; color: ${c.hex}`} title={c.name}></button>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="subpanel sp-status">
                <h3 class="subhead">{COPY.secRoleStatus}</h3>
                <div class="pf-grid2">
                  <div class="field">
                    <label for="pfStatusState">{lang === 'de' ? 'Aktivität' : 'Activity'} <span class="hint">{lang === 'de' ? 'Online/Abwesend/Offline automatisch' : 'Online/Away/Offline are automatic'}</span></label>
                    <select class="ctrl" id="pfStatusState">
                      <option value="">{lang === 'de' ? '— Automatisch (Präsenz) —' : '— Automatic (presence) —'}</option>
                      <option value="ingame">{lang === 'de' ? STATUS_STATES.ingame.labelDe : STATUS_STATES.ingame.labelEn}</option>
                      <option value="mission">{lang === 'de' ? STATUS_STATES.mission.labelDe : STATUS_STATES.mission.labelEn}</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="pfStatusText">{COPY.statusText}</label>
                    <input class="inp" id="pfStatusText" type="text" maxlength="60" placeholder={COPY.statusTextPh} />
                  </div>
                  <div class="field">
                    <label for="pfRole">{COPY.roleLabel}</label>
                    <select class="ctrl" id="pfRole">
                      <option value="">{COPY.roleNone}</option>
                      {CITIZEN_ROLES.map(r => (
                        <option value={r.id}>{r.symbol} {lang === 'de' ? r.labelDe : r.labelEn}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field">
                    <label for="pfDiscord">{COPY.discordTag}</label>
                    <input class="inp" id="pfDiscord" type="text" maxlength="40" placeholder={COPY.discordPh} />
                  </div>
                  <div class="field">
                    <label for="pfOrg">{COPY.orgName}</label>
                    <input class="inp" id="pfOrg" type="text" maxlength="60" placeholder={COPY.orgPh} />
                  </div>
                </div>
                <label class="pf-check">
                  <input type="checkbox" id="pfShareActivity" checked />
                  <span>{COPY.shareActivity}</span>
                </label>
                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
                  <button class="btn primary" type="submit" id="pfBtn"><svg viewBox="0 0 24 24"><use href="#ic-check"/></svg> <span id="pfBtnTxt">{COPY.saveProfile}</span></button>
                </div>
                <p class="acx-status" id="pfStatus" role="status" aria-live="polite" hidden></p>
              </div>

              <!-- Testpilot-Zustimmungsschalter (D-22) — nur sichtbar fuer
                   Konten mit is_tester=true; per JS ein/ausgeblendet, siehe
                   account-dashboard.ts. Standard AUS (DB-Vorgabewert). -->
              <div class="subpanel sp-social">
                <h3 class="subhead">Socials</h3>
                <div class="field">
                  <label for="pfTwitch" class="pf-soc-l pf-soc-l--tw"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.3 3 3 6.4v13.1h4.5V22h2.5l2.4-2.5h3.6L21 14.6V3H4.3Zm14.9 10.7-2.8 2.8h-4.5l-2.4 2.4v-2.4H5.7V4.8h13.5v8.9ZM16.4 7.6h-1.8v5.1h1.8V7.6Zm-4.9 0H9.7v5.1h1.8V7.6Z"/></svg> Twitch</label>
                  <div class="inp-affix"><span class="pre">twitch.tv/</span><input class="inp mono" id="pfTwitch" type="text" maxlength="60" autocapitalize="off" spellcheck="false" /></div>
                </div>
                <div class="field">
                  <label for="pfYoutube" class="pf-soc-l pf-soc-l--yt"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg> YouTube</label>
                  <div class="inp-affix"><span class="pre">youtube.com/@</span><input class="inp mono" id="pfYoutube" type="text" maxlength="80" autocapitalize="off" spellcheck="false" /></div>
                </div>
                <div class="field" style="margin-bottom:0">
                  <label for="pfX" class="pf-soc-l pf-soc-l--x"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.2 2.3h3.4l-7.4 8.4 8.7 11.5h-6.8l-5.3-7-6.1 7H1.3l7.9-9L.8 2.3h7l4.8 6.4 5.6-6.4Zm-1.2 17.9h1.9L7 4.2H5l12 16Z"/></svg> X</label>
                  <div class="inp-affix"><span class="pre">x.com/</span><input class="inp mono" id="pfX" type="text" maxlength="60" autocapitalize="off" spellcheck="false" /></div>
                </div>
              </div>

              <div class="subpanel sp-tester" id="pfTesterPanel" hidden>
                <h3 class="subhead">{COPY.secTester}</h3>
                <div class="field" style="margin-bottom:0">
                  <label style="display:flex;align-items:center;gap:0.55rem;font-weight:400">
                    <input type="checkbox" id="pfTesterCredit" />
                    <span>{COPY.testerConsent}</span>
                  </label>
                  <span class="hint">{COPY.testerConsentHint}</span>
                </div>
              </div>
            </form>
          </div>

          <aside class="livecard">
            <div class="lp-cap">{lang === 'de' ? 'Live-Vorschau deiner Karte' : 'Live preview of your card'}</div>
            <ProfileCard lang={lang} editable={true} />
          </aside>
        </div>
      </section>

      <!-- ============================ FAVORITEN ============================ -->
      <section id="tab-panel-favs" class="acx-tab-panel" hidden>
        <div class="sv" id="sv" data-copy={JSON.stringify(SV)} data-kinds={JSON.stringify(COPY.kind)} data-lang={lang}>
          <div class="sv-bar">
            <h2 class="sv-h">{SV.title}</h2>
            <div class="sv-filter" id="svFilter" role="group" aria-label={SV.filter}></div>
            <label class="sv-search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-search"/></svg>
              <input class="inp" id="svSearch" type="search" placeholder={SV.search} aria-label={SV.search} autocomplete="off" spellcheck="false" />
            </label>
          </div>
          <div class="sv-body" id="svBody">
            <section class="sv-sec" id="svLoSec" aria-labelledby="svLoH" hidden>
              <h3 class="sv-sh" id="svLoH"><span>{SV.loadouts}</span><b id="svLoN"></b><em class="sv-sync" id="svSync" hidden>{SV.syncErr}</em></h3>
              <ul class="sv-grid" id="svLoadouts"></ul>
            </section>
            <section class="sv-sec" id="svFavSec" aria-labelledby="svFavH" hidden>
              <h3 class="sv-sh" id="svFavH"><span>{SV.favs}</span><b id="svFavN"></b></h3>
              <ul class="sv-grid" id="favList"></ul>
            </section>
            <div class="ck-empty sv-empty" id="favEmpty" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-star"/></svg>
              <p><b>{SV.empty}</b><br/>{SV.emptyHint}</p>
              <a class="btn sm" href={hangarHref}>{SV.toHangar}</a>
            </div>
            <p class="sv-none" id="svNone" hidden>{SV.none}</p>
          </div>
          <div class="sv-toast" id="svToast" role="status" aria-live="polite" hidden><span id="svToastMsg"></span><button type="button" id="svUndo" hidden>{SV.undo}</button></div>
        </div>
      </section>

      <!-- ============================ FREUNDE ============================ -->
      <section id="tab-panel-friends" class="acx-tab-panel" hidden>
        <FriendsManager lang={lang} title={COPY.tabFriends} />
      </section>

      <!-- ============================ SICHERHEIT ============================ -->
      <section id="tab-panel-security" class="acx-tab-panel" hidden>
        <div class="sec" id="sec" data-lang={lang} data-home={homeHref} data-copy={JSON.stringify(SEC.js)}>
          <div class="sv-bar"><h2 class="sv-h">{COPY.tabSecurity}</h2></div>
          <p class="acx-status" id="seReauthStatus" role="status" aria-live="polite" hidden></p>
          <div class="sec-grid">

            <div class="sec-card">
              <h3 class="sec-h"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-lock"/></svg>{SEC.login}</h3>
              <div class="sec-row">
                <span class="sec-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#ic-mail"/></svg></span>
                <span class="sec-kv"><span class="sec-k">{SEC.email}</span><span class="sec-v mono" id="idEmail">—</span></span>
                <button type="button" class="sec-btn" data-sec-open="emailForm" aria-controls="emailForm" aria-expanded="false">{SEC.change}</button>
              </div>
              <form id="emailForm" class="sec-form" novalidate hidden>
                <input class="inp mono" id="seEmail" name="email" type="email" autocomplete="email" placeholder={COPY.emailPh} aria-label={SEC.newEmail} />
                <input class="inp" id="seEmailCur" name="current_password" type="password" autocomplete="current-password" placeholder={COPY.curPassPh} aria-label={COPY.curPass} data-reauth="pw" />
                <div class="sec-reauth" data-reauth="dc" hidden><p class="sec-note">{COPY.reauthDcHint}</p><button type="button" class="sec-btn js-reauth-dc" data-busy={COPY.reauthDcBusy} data-idle={COPY.reauthDcBtn}>{COPY.reauthDcBtn}</button></div>
                <button class="sec-btn sec-btn--go" type="submit" id="seEmailBtn" data-busy={COPY.emailBusy} data-idle={SEC.send}>{SEC.send}</button>
                <p class="acx-status" id="seEmailStatus" role="status" aria-live="polite" hidden></p>
              </form>
              <div class="sec-row" id="secPassRow">
                <span class="sec-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#ic-lock"/></svg></span>
                <span class="sec-kv"><span class="sec-k">{SEC.pass}</span><span class="sec-v" id="secPassVal">••••••••</span></span>
                <button type="button" class="sec-btn" id="secPassBtn" data-sec-open="passForm" aria-controls="passForm" aria-expanded="false">{SEC.change}</button>
              </div>
              <form id="passForm" class="sec-form" novalidate hidden>
                <input class="inp" id="sePassCur" name="current_password" type="password" autocomplete="current-password" placeholder={COPY.curPassPh} aria-label={COPY.curPass} data-reauth="pw" />
                <div class="sec-reauth" data-reauth="dc" hidden><p class="sec-note">{COPY.reauthDcHint}</p><button type="button" class="sec-btn js-reauth-dc" data-busy={COPY.reauthDcBusy} data-idle={COPY.reauthDcBtn}>{COPY.reauthDcBtn}</button></div>
                <input class="inp" id="sePass" name="password" type="password" minlength={MIN_PASS} autocomplete="new-password" placeholder={COPY.passPh} aria-label={COPY.pass} />
                <input class="inp" id="sePass2" name="password2" type="password" minlength={MIN_PASS} autocomplete="new-password" placeholder={COPY.pass2Ph} aria-label={COPY.pass2} />
                <button class="sec-btn sec-btn--go" type="submit" id="sePassBtn" data-busy={COPY.passBusy} data-idle={SEC.save}>{SEC.save}</button>
                <p class="acx-status" id="sePassStatus" role="status" aria-live="polite" hidden></p>
              </form>
            </div>

            <div class="sec-card">
              <h3 class="sec-h"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-link"/></svg>{SEC.linked}</h3>
              <div class="sec-row" id="secDc">
                <span class="sec-ic sec-ic--dc" aria-hidden="true"><svg viewBox="0 0 127.14 96.36"><use href="#ic-discord"/></svg></span>
                <span class="sec-kv"><span class="sec-k">Discord</span><span class="sec-v" id="secDcVal">—</span></span>
                <button type="button" class="sec-btn sec-btn--go" id="secDcLink" hidden>{SEC.connect}</button>
                <button type="button" class="sec-btn" id="secDcUnlink" hidden>{SEC.unlink}</button>
              </div>
              <p class="acx-status sec-msg" id="secDcMsg" role="status" aria-live="polite" hidden></p>
              <div class="sec-row" id="secRsi">
                <span class="sec-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#ic-shield"/></svg></span>
                <span class="sec-kv"><span class="sec-k">RSI</span><span class="sec-v" id="secRsiVal">{SEC.rsiNone}</span></span>
                <button type="button" class="sec-btn" id="secRsiBtn" data-sec-open="secRsiForm" aria-controls="secRsiForm" aria-expanded="false">{SEC.rsiOpen}</button>
              </div>
              <div class="sec-form" id="secRsiForm" hidden>
                <div class="rsi-row">
                  <div class="inp-affix"><span class="pre">@</span><input class="inp mono" id="pfRsiHandle" type="text" maxlength="32" placeholder={COPY.rsiPh} aria-label={COPY.rsiHandle} /></div>
                  <button type="button" class="sec-btn sec-btn--go" id="btnRsiVerifyModal"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-check"/></svg> {COPY.rsiVerifyBtn}</button>
                </div>
                <div id="rsiVerifiedStatus" class="rsi-verified-indicator" hidden>
                  <span>✓ {COPY.rsiVerifiedText}</span>
                  <button type="button" id="btnResetRsiVerify">({COPY.rsiReset})</button>
                </div>
              </div>
            </div>

            <div class="sec-card">
              <h3 class="sec-h"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-power"/></svg>{SEC.sessions}</h3>
              <div class="sec-row">
                <span class="sec-ic sec-ic--ok" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#ic-monitor"/></svg></span>
                <span class="sec-kv"><span class="sec-k">{SEC.device}</span><span class="sec-v" id="secDevice">—</span></span>
                <span class="sec-live" aria-hidden="true"></span>
              </div>
              <dl class="sec-facts">
                <div><dt>{SEC.last}</dt><dd id="secLast">—</dd></div>
                <div><dt>{SEC.since}</dt><dd id="secSince">—</dd></div>
              </dl>
              <div class="sec-acts">
                <button type="button" class="sec-btn" id="secOthers">{SEC.others}</button>
                <button type="button" class="sec-btn sec-btn--hot" id="secAll"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-power"/></svg> {SEC.all}</button>
              </div>
            </div>

            <div class="sec-card">
              <h3 class="sec-h"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-download"/></svg>{SEC.data}</h3>
              <ul class="sec-incl">{SEC.incl.map((x) => <li>{x}</li>)}</ul>
              <div class="sec-acts">
                <button type="button" class="sec-btn sec-btn--go" id="secExport"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-download"/></svg> {SEC.dl}</button>
                <span class="sec-fmt mono">JSON</span>
              </div>
            </div>

            <!-- Testpiloten-Uebersicht (D-13) — nur fuer admin-Konten; der Aufruf
                 von tester_overview() wird fuer alle anderen gar nicht erst
                 abgesetzt (siehe account-dashboard.ts). -->
            <div class="sec-card sec-card--wide" id="testerOverviewCard" hidden>
              <h3 class="sec-h"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#ic-users"/></svg>{COPY.secTesterOverview}</h3>
              <div class="sec-scroll" id="testerOverviewBody"></div>
            </div>

            <div class="sec-card sec-card--wide sec-danger">
              <div class="sec-row">
                <span class="sec-ic sec-ic--hot" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#ic-trash"/></svg></span>
                <span class="sec-kv"><span class="sec-k">{COPY.secDanger}</span><span class="sec-v">{SEC.dangerShort}</span></span>
                <button type="button" class="sec-btn sec-btn--hot" data-sec-open="deleteForm" aria-controls="deleteForm" aria-expanded="false">{SEC.del}</button>
              </div>
              <form id="deleteForm" class="sec-form" novalidate hidden>
                <p class="sec-note">{COPY.dangerBody}</p>
                <input class="inp" id="delCur" name="current_password" type="password" autocomplete="current-password" placeholder={COPY.curPassPh} aria-label={COPY.curPass} data-reauth="pw" />
                <div class="sec-reauth" data-reauth="dc" hidden><p class="sec-note">{COPY.reauthDcHint}</p><button type="button" class="sec-btn js-reauth-dc" data-busy={COPY.reauthDcBusy} data-idle={COPY.reauthDcBtn}>{COPY.reauthDcBtn}</button></div>
                <input class="inp mono" id="delConfirm" name="confirm" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={COPY.dangerWord} aria-label={COPY.dangerConfirmLabel} />
                <button class="sec-btn sec-btn--hot" type="submit" id="delBtn" disabled data-busy={COPY.dangerBusy} data-idle={COPY.dangerBtn}>{COPY.dangerBtn}</button>
                <p class="acx-status" id="delStatus" role="alert" aria-live="assertive" hidden></p>
              </form>
            </div>

          </div>
          <div class="sv-toast" id="secToast" role="status" aria-live="polite" hidden><span id="secToastMsg"></span></div>
        </div>
      </section>

    </div>

    <aside class="acc-dock" aria-label={COPY.tabFriends}>
      <FriendsDock lang={lang} />
    </aside>
    </div>
  </div>

  <!-- ===== Modals (außerhalb .dsr) ===== -->
  <!-- RSI Verification Wizard Modal -->
  <dialog id="rsiModal" class="acx-modal">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◆</span>
        <h3>{COPY.rsiModalTitle}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:1rem">
        {COPY.rsiModalIntroPre} <strong id="rsiModalTargetHandle">@...</strong> {COPY.rsiModalIntroPost}
      </p>

      <div class="rsi-steps">
        <div class="rsi-step">
          <span class="step-num">1</span>
          <div class="step-txt">
            <span>{COPY.rsiStep1}</span>
            <div class="rsi-code-box" style="margin-top:0.4rem">
              <code id="rsiVerifyCode">VERSEBASE-VERIFY-LOADING</code>
              <button type="button" class="acx-btn-copy" id="btnCopyRsiCode">{COPY.rsiCopy}</button>
            </div>
          </div>
        </div>

        <div class="rsi-step" style="margin-top:0.8rem">
          <span class="step-num">2</span>
          <div class="step-txt">
            <span>{COPY.rsiStep2Pre} <a id="rsiModalProfileLink" href="https://robertsspaceindustries.com/account/profile" target="_blank" rel="noopener noreferrer" style="color:var(--accent);text-decoration:underline">{COPY.rsiStep2Link}</a> {COPY.rsiStep2Post}</span>
          </div>
        </div>

        <div class="rsi-step" style="margin-top:0.8rem">
          <span class="step-num">3</span>
          <div class="step-txt">
            <span>{COPY.rsiStep3}</span>
          </div>
        </div>
      </div>

      <div class="acx-actions" style="margin-top:1.4rem">
        <button type="button" class="acx-submit" id="btnCheckRsiNow">{COPY.rsiCheckNow}</button>
        <button type="button" class="acx-submit acx-submit--ghost" id="btnCloseRsiModal">{COPY.rsiClose}</button>
      </div>
      <p id="rsiVerifyMsg" class="acx-status" hidden style="margin-top:1rem"></p>
    </div>
  </dialog>

  <!-- Public Profile Preview Modal (Read-only-Rendition der Karte) -->
  <dialog id="previewModal" class="acx-modal acx-modal--preview">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◈</span>
        <h3>{COPY.modalTitle}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:1rem">{COPY.previewHint}</p>

      <div class="pv-card">
        <div class="pv-banner" id="pvBanner"></div>
        <div class="pv-body">
          <div class="pv-avatar-row">
            <div class="pv-avatar-box" id="pvAvatarBox">
              <span id="pvAvatarText">◆</span>
              <img id="pvAvatarImg" src="" alt="" hidden />
            </div>
            <span class="pv-registry" id="pvRegistryId">VB-••••••••</span>
          </div>

          <div class="pv-name-row">
            <h4 class="pv-name" id="pvName">Citizen</h4>
            <span class="pv-verified" id="pvVerified" hidden>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              RSI VERIFIED
            </span>
          </div>
          <div class="pv-handle" id="pvHandle">@citizen</div>

          <div class="pv-meta">
            <span class="pv-role" id="pvRole" hidden></span>
            <span class="pv-status" id="pvStatus"></span>
          </div>

          <p class="pv-bio" id="pvBio"></p>

          <div class="pv-chips">
            <a class="pv-chip" id="pvChipRsi" href="#" target="_blank" rel="noopener noreferrer" hidden></a>
            <span class="pv-chip" id="pvChipDiscord" hidden></span>
            <span class="pv-chip" id="pvChipOrg" hidden></span>
          </div>
        </div>
      </div>

      <div class="pv-public" id="pvPublicRow" hidden>
        <span class="pv-public__label">{COPY.publicPageLabel}</span>
        <a class="pv-public__link" id="pvPublicLink" href="#" target="_blank" rel="noopener noreferrer"></a>
        <button
          type="button"
          class="pv-public__copy"
          id="pvPublicCopy"
          data-label={COPY.publicPageCopy}
          data-done={COPY.publicPageCopied}
        >{COPY.publicPageCopy}</button>
      </div>
      <p class="acx-hint" id="pvPublicNoHandle" hidden>{COPY.publicPageNoHandle}</p>

      <div class="acx-actions" style="margin-top:1.2rem">
        <button type="button" class="acx-submit acx-submit--ghost" id="btnClosePreviewModal">{COPY.closeModal}</button>
      </div>
    </div>
  </dialog>

  <!-- Bild-Zuschnitt: Vorschau + Ausschnitt/Zoom vor dem Upload -->
  <dialog id="cropModal" class="acx-modal acx-modal--crop">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◈</span>
        <h3 id="cropTitle">{COPY.cropTitleAvatar}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:0.9rem">{COPY.cropHint}</p>

      <div class="crop-layout">
        <div class="crop-stage" id="cropStage" data-shape="circle">
          <img id="cropImg" alt="" draggable="false" />
          <div class="crop-grid" id="cropGrid" aria-hidden="true"></div>
          <div class="crop-frame" aria-hidden="true"></div>
        </div>

        <aside class="crop-side">
          <div class="crop-side__label">{COPY.cropPreview}</div>
          <div class="crop-previews" id="cropPreviews">
            <figure class="crop-pv">
              <canvas id="cropPvLg"></canvas>
            </figure>
            <figure class="crop-pv crop-pv--sm">
              <canvas id="cropPvSm"></canvas>
            </figure>
          </div>

          <dl class="crop-info">
            <div><dt>{COPY.cropSource}</dt><dd id="cropInfoSrc">—</dd></div>
            <div><dt>{COPY.cropOutput}</dt><dd id="cropInfoOut">—</dd></div>
            <div><dt>{COPY.cropEstSize}</dt><dd id="cropInfoSize">—</dd></div>
          </dl>

          <p class="crop-warn" id="cropWarn" hidden>{COPY.cropLowRes}</p>
        </aside>
      </div>

      <div class="crop-controls">
        <button type="button" class="crop-btn" id="cropZoomOut" aria-label="Zoom −">−</button>
        <input type="range" id="cropZoom" min="1" max="4" step="0.01" value="1" aria-label={COPY.cropZoom} />
        <button type="button" class="crop-btn" id="cropZoomIn" aria-label="Zoom +">+</button>
        <span class="crop-zoomval" id="cropZoomVal">100%</span>
      </div>

      <div class="crop-tools">
        <button type="button" class="crop-btn" id="cropRotL" title={COPY.cropRotateLeft} aria-label={COPY.cropRotateLeft}>↺</button>
        <button type="button" class="crop-btn" id="cropRotR" title={COPY.cropRotateRight} aria-label={COPY.cropRotateRight}>↻</button>
        <button type="button" class="crop-btn" id="cropFlip" title={COPY.cropFlip} aria-label={COPY.cropFlip}>⇄</button>
        <button type="button" class="acx-upload__remove" id="cropReset">{COPY.cropReset}</button>
      </div>

      <div class="acx-actions" style="margin-top:1.1rem">
        <button type="button" class="acx-submit" id="cropApply">{COPY.cropApply}</button>
        <button type="button" class="acx-submit acx-submit--ghost" id="cropCancel">{COPY.cropCancel}</button>
      </div>
    </div>
  </dialog>
</div>

<script>
import '../../scripts/account-dashboard';
import '../../scripts/account-cockpit';
import '../../scripts/account-saved';
import '../../scripts/account-security';
</script>

