      <g id="ic-mail" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="1"/><path d="M3.5 7l8.5 6 8.5-6"/></g>
      <g id="ic-trash" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13M10 11v6M14 11v6"/></g>
      <g id="ic-id" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="1"/><path d="M7 10h4M7 14h7"/><circle cx="16.5" cy="10" r="1.6"/></g>
      <g id="ic-org" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V6l6-2.5V21"/><path d="M10 8h8a2 2 0 0 1 2 2v11"/><path d="M13 12h3M13 16h3"/></g>
      <g id="ic-power" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5v8"/><path d="M6.4 6.9a8 8 0 1 0 11.2 0"/></g>
    </defs>
  </svg>

  <div class="dsr">

    <!-- ===== cinematic pilot hero (echte Daten via ov*) ===== -->
    <header class="phero">
      <div class="ph__img" id="ovBanner" aria-hidden="true"></div>
      <div class="ph__scrim" aria-hidden="true"></div>
      <div class="dwrap ph__in">
        <span class="ph__kicker">{lang === 'de' ? 'UEE Citizen Registry · Piloten-Dossier' : 'UEE Citizen Registry · Pilot Dossier'}</span>
        <div class="ph__row">
          <div class="ph__av" id="ovAvatarBox"><span id="ovAvatarText">◆</span><img id="ovAvatarImg" src="" alt="" hidden /><span class="ph__avdot" id="ovStatusDot" aria-hidden="true"></span></div>
          <h1 class="ph__name" id="ovName">Citizen</h1>
        </div>
        <div class="ph__chips">
          <span class="ph__handle" id="ovHandle">@citizen</span>
          <span class="ph__chip ok" id="ovVerified" hidden><svg viewBox="0 0 24 24"><use href="#ic-check"/></svg> {lang === 'de' ? 'RSI verifiziert' : 'RSI Verified'}</span>
          <span class="ph__chip" id="ovRolePill" hidden><svg viewBox="0 0 24 24"><use href="#ic-hex"/></svg> <b id="ovRoleText"></b></span>
          <span class="ph__chip" id="ovStatusPill"><span id="ovStatusLabel"></span></span>
          <span class="ph__chip" id="ovOrgPill" hidden><svg viewBox="0 0 24 24"><use href="#ic-org"/></svg> <span id="ovOrgText"></span></span>
        </div>
        <p class="ph__lede" id="ovLede" hidden></p>
        <div class="ph__meta">
          <span><b>{COPY.memberSince}</b> <span id="idSince">—</span></span>
          <span><b>{lang === 'de' ? 'Registrierung' : 'Registry'}</b> <span id="ovRegId">VB-••••••••</span></span>
        </div>
        <div class="ph__acts">
          <button type="button" class="btn primary" id="ovBtnShare"><svg viewBox="0 0 24 24"><use href="#ic-id"/></svg> {lang === 'de' ? 'Öffentliches Profil' : 'Public Profile'}</button>
          <button type="button" class="btn" data-tab-jump="profile"><svg viewBox="0 0 24 24"><use href="#ic-edit"/></svg> {COPY.ovJProfile}</button>
        </div>
      </div>
    </header>

    <!-- ===== tabs ===== -->
    <nav class="fullbleed tabsbar" aria-label={lang === 'de' ? 'Konto-Bereiche' : 'Account sections'}>
      <div class="dwrap" style="padding-inline:0">
        <div class="tabs" role="tablist">
          <button type="button" class="tab" role="tab" aria-selected="true" data-tab="overview"><span class="lbl">{lang === 'de' ? 'Übersicht' : 'Overview'}</span></button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-tab="profile"><span class="lbl">{COPY.tabProfile}</span></button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-tab="favs"><span class="lbl">{COPY.tabFavs}</span><span class="badge" id="navFavCount" hidden>0</span></button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-tab="friends"><span class="lbl">{COPY.tabFriends}</span><span class="badge" id="navFriendCount" hidden>0</span></button>
          <button type="button" class="tab" role="tab" aria-selected="false" data-tab="security"><span class="lbl">{COPY.tabSecurity}</span></button>
          <div class="tabs__acct">
            <div class="who"><b id="navWho">—</b><span id="idEmail">—</span></div>
            <div class="mini" id="idAvatar">◆</div>
            <button type="button" class="logout" id="btnLogout" title={COPY.logout} aria-label={COPY.logout}><svg viewBox="0 0 24 24"><use href="#ic-power"/></svg> <span>{COPY.logout}</span></button>
          </div>
        </div>
      </div>
    </nav>

    <div class="dwrap dpanels">

      <!-- ============================ ÜBERSICHT ============================ -->
      <section id="tab-panel-overview" class="acx-tab-panel"
        data-l-pending={COPY.ovPending} data-l-pending1={COPY.ovPending1} data-l-nopending={COPY.ovNoPending}
        data-l-active={COPY.ovActive} data-l-active1={COPY.ovActive1} data-l-noactive={COPY.ovNoActive}
        data-l-missing={COPY.ovMissing} data-l-missing1={COPY.ovMissing1} data-l-complete={COPY.ovComplete}
        data-l-rsi-yes={COPY.ovRsiYes} data-l-rsi-no={COPY.ovRsiNo}
        data-l-act-fav={COPY.ovActFav} data-l-act-req={COPY.ovActReq} data-l-act-job={COPY.ovActJob} data-l-act-empty={COPY.ovActEmpty}>
        <div class="stack">

          <div>
            <div class="dsec"><h2>{COPY.ovAtAGlance}</h2></div>
            <div class="metrics">
              <div class="metric" role="button" tabindex="0" data-tab-jump="favs" aria-label={COPY.ovTFavs}>
                <div class="mlabel"><span class="k">{COPY.ovTFavs}</span><span class="micon"><svg viewBox="0 0 24 24"><use href="#ic-star"/></svg></span></div>
                <div class="big tnum" id="ovStatFavs">0</div>
              </div>
              <div class="metric" role="button" tabindex="0" data-tab-jump="friends" aria-label={COPY.ovTFriends}>
                <div class="mlabel"><span class="k">{COPY.ovTFriends}</span><span class="micon"><svg viewBox="0 0 24 24"><use href="#ic-users"/></svg></span></div>
                <div class="big tnum" id="ovStatFriends">0</div>
                <div class="sub" id="ovFriendsSub"></div>
              </div>
              <a class="metric" href={refineryHref} aria-label={COPY.ovTRefValue}>
                <div class="mlabel"><span class="k">{COPY.ovTRefValue}</span><span class="micon" style="color:var(--gold)"><svg viewBox="0 0 24 24"><use href="#ic-refinery"/></svg></span></div>
                <div class="big gold tnum" id="ovRefValue" style="font-size:44px">—</div>
                <div class="spark" aria-hidden="true"><svg id="ovRefSpark" viewBox="0 0 120 26" preserveAspectRatio="none"></svg></div>
                <div class="sub" id="ovRefSub"></div>
              </a>
              <div class="metric" role="button" tabindex="0" data-tab-jump="profile" aria-label={COPY.ovTComplete}>
                <div class="mlabel"><span class="k">{COPY.ovTComplete}</span><span class="micon"><svg viewBox="0 0 24 24"><use href="#ic-id"/></svg></span></div>
                <div class="ringwrap">
                  <svg width="58" height="58" viewBox="0 0 58 58" aria-hidden="true">
                    <circle cx="29" cy="29" r="18" fill="none" stroke="var(--line)" stroke-width="5"/>
                    <circle id="ovRing" cx="29" cy="29" r="18" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" stroke-dasharray="113" stroke-dashoffset="113" transform="rotate(-90 29 29)"/>
                  </svg>
                  <div class="rmeta"><b id="ovComplete">0%</b><br/><span id="ovCompleteSub"></span></div>
                </div>
              </div>
              <div class="metric" role="button" tabindex="0" data-tab-jump="security" aria-label={COPY.ovTRsi}>
                <div class="mlabel"><span class="k">{COPY.ovTRsi}</span><span class="micon" style="color:var(--ok)"><svg viewBox="0 0 24 24"><use href="#ic-shield"/></svg></span></div>
                <div class="verline" id="ovRsi">—</div>
                <div class="versub" id="ovRsiSub"></div>
              </div>
            </div>
          </div>

          <div class="ov-cols">
            <div>
              <div class="dsec"><h2>{COPY.ovQuick}</h2></div>
              <div class="qgrid">
                <button type="button" class="qcard" data-tab-jump="profile"><span class="qi"><svg viewBox="0 0 24 24"><use href="#ic-edit"/></svg></span><span><span class="qt">{COPY.ovJProfile}</span><span class="qd">{COPY.ovJProfileSub}</span></span></button>
                <button type="button" class="qcard" data-tab-jump="favs"><span class="qi"><svg viewBox="0 0 24 24"><use href="#ic-star"/></svg></span><span><span class="qt">{COPY.ovJFavs}</span><span class="qd">{COPY.ovJFavsSub}</span></span></button>
                <button type="button" class="qcard" data-tab-jump="friends"><span class="qi"><svg viewBox="0 0 24 24"><use href="#ic-users"/></svg></span><span><span class="qt">{COPY.ovJFriends}</span><span class="qd">{COPY.ovJFriendsSub}</span></span></button>
                <button type="button" class="qcard" id="ovBtnShare2"><span class="qi"><svg viewBox="0 0 24 24"><use href="#ic-share"/></svg></span><span><span class="qt">{COPY.ovJShare}</span><span class="qd">{COPY.ovJShareSub}</span></span></button>
                <button type="button" class="qcard" data-tab-jump="security"><span class="qi"><svg viewBox="0 0 24 24"><use href="#ic-shield"/></svg></span><span><span class="qt">{COPY.ovJSecurity}</span><span class="qd">{COPY.ovJSecuritySub}</span></span></button>
              </div>
            </div>
            <div>
              <div class="dsec"><h2>{COPY.ovRecent}</h2></div>
              <div class="card log" id="ovActivity">
                <p class="acx-hint" id="ovActEmpty" style="padding:14px 8px;margin:0">{COPY.ovActEmpty}</p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ============================ PROFIL ============================ -->
      <section id="tab-panel-profile" class="acx-tab-panel" hidden>
        <div class="dsec"><h2>{COPY.secProfile}</h2></div>
        <div class="form2">
          <div>
            <form id="profileForm" novalidate>
              <div class="subpanel">
                <h3 class="subhead">{lang === 'de' ? 'Öffentliche Identität' : 'Public Identity'}</h3>
                <div class="field">
                  <label for="pfName">{COPY.name}</label>
                  <input class="inp" id="pfName" name="display_name" type="text" maxlength="60" autocomplete="nickname" placeholder={COPY.namePh} />
                </div>
                <div class="field">
                  <label for="pfHandle">{COPY.handle} <span class="hint">{COPY.optional}</span></label>
                  <div class="inp-affix"><span class="pre">@</span><input class="inp mono" id="pfHandle" name="handle" type="text" maxlength="24" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder={COPY.handlePh} /></div>
                </div>
                <div class="field" style="margin-bottom:0">
                  <label for="pfBio">{COPY.bio}</label>
                  <textarea class="inp" id="pfBio" name="bio" rows="3" maxlength="500" placeholder={COPY.bioPh}></textarea>
                </div>
              </div>

              <div class="subpanel">
                <h3 class="subhead">{COPY.secDesign}</h3>
                <div class="field">
                  <label>{COPY.bannerSelect}</label>
                  <div class="banner-grid-picker" id="bannerGridPicker">
                    {BANNER_PRESETS.map((b, idx) => (
                      <button type="button" class={`banner-thumb-card ${idx === 0 ? 'selected' : ''}`} data-banner-url={b.url} style={`background-image: url('${b.thumb}')`}>
                        <span class="banner-thumb-title">{b.name}</span>
                      </button>
                    ))}
                  </div>
                  <div class="acx-upload" data-kind="banner">
                    <input type="file" id="pfBannerFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                    <button type="button" class="acx-upload__btn" id="pfBannerUploadBtn"><span class="acx-upload__ico" aria-hidden="true">⬆</span> <span>{COPY.uploadBanner}</span></button>
                    <button type="button" class="acx-upload__remove" id="pfBannerRemove" hidden>{COPY.uploadRemove}</button>
                    <span class="acx-upload__status" id="pfBannerUploadStatus" role="status" aria-live="polite"></span>
                  </div>
                  <!-- Datenträger für die Banner-URL (Picker/Upload schreiben rein); nicht sichtbar -->
                  <input type="hidden" id="pfBannerUrl" />
                </div>

                <div class="field" style="margin-bottom:0;margin-top:1.2rem">
                  <div class="pf-avatar-row">
                    <div>
                      <label>{COPY.avatarSelect}</label>
                      <div class="avatar-grid-picker" id="avatarGridPicker">
                        {AVATAR_PRESETS.map((a, idx) => (
                          <button type="button" class={`avatar-thumb-card ${idx === 0 ? 'selected' : ''}`} data-avatar-icon={a.symbol} data-avatar-color={a.defaultColor} title={a.name}>
                            <span>{a.symbol}</span>
                          </button>
                        ))}
                      </div>
                      <div class="acx-upload" data-kind="avatar">
                        <input type="file" id="pfAvatarFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden />
                        <button type="button" class="acx-upload__btn" id="pfAvatarUploadBtn"><span class="acx-upload__ico" aria-hidden="true">⬆</span> <span>{COPY.uploadAvatar}</span></button>
                        <button type="button" class="acx-upload__remove" id="pfAvatarRemove" hidden>{COPY.uploadRemove}</button>
                        <span class="acx-upload__status" id="pfAvatarUploadStatus" role="status" aria-live="polite"></span>
                      </div>
                      <!-- Datenträger für die Avatar-URL (Picker/Upload schreiben rein); nicht sichtbar -->
                      <input type="hidden" id="pfAvatarUrl" />
                    </div>
                    <div>
                      <label>{COPY.avatarColorSelect}</label>
                      <div class="color-grid-picker" id="colorGridPicker">
                        {ACCENT_COLORS.map((c, idx) => (
                          <button type="button" class={`color-swatch ${idx === 0 ? 'selected' : ''}`} data-color={c.hex} style={`background: ${c.hex}; color: ${c.hex}`} title={c.name}></button>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="subpanel">
                <h3 class="subhead">{COPY.secRoleStatus}</h3>
                <div class="pf-grid2">
                  <div class="field">
                    <label for="pfStatusState">{COPY.statusState}</label>
                    <select class="ctrl" id="pfStatusState">
                      {Object.entries(STATUS_STATES).map(([key, st]) => (
                        <option value={key}>{lang === 'de' ? st.labelDe : st.labelEn}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field">
                    <label for="pfStatusText">{COPY.statusText}</label>
                    <input class="inp" id="pfStatusText" type="text" maxlength="60" placeholder={COPY.statusTextPh} />
                  </div>
                  <div class="field">
                    <label for="pfRole">{COPY.roleLabel}</label>
                    <select class="ctrl" id="pfRole">
                      <option value="">{COPY.roleNone}</option>
                      {CITIZEN_ROLES.map(r => (
                        <option value={r.id}>{r.symbol} {lang === 'de' ? r.labelDe : r.labelEn}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field">
                    <label for="pfDiscord">{COPY.discordTag}</label>
                    <input class="inp" id="pfDiscord" type="text" maxlength="40" placeholder={COPY.discordPh} />
                  </div>
                  <div class="field">
                    <label for="pfOrg">{COPY.orgName}</label>
                    <input class="inp" id="pfOrg" type="text" maxlength="60" placeholder={COPY.orgPh} />
                  </div>
                </div>
                <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
                  <button class="btn primary" type="submit" id="pfBtn"><svg viewBox="0 0 24 24"><use href="#ic-check"/></svg> <span id="pfBtnTxt">{COPY.saveProfile}</span></button>
                </div>
                <p class="acx-status" id="pfStatus" role="status" aria-live="polite" hidden></p>
              </div>
            </form>
          </div>

          <aside class="livecard">
            <div class="lp-cap">{lang === 'de' ? 'Live-Vorschau deiner Karte' : 'Live preview of your card'}</div>
            <ProfileCard lang={lang} editable={true} />
          </aside>
        </div>
      </section>

      <!-- ============================ FAVORITEN ============================ -->
      <section id="tab-panel-favs" class="acx-tab-panel" hidden>
        <div class="dsec"><h2>{COPY.secFavs}</h2></div>
        <ul class="acx-favs favgrid" id="favList"></ul>
        <div id="favEmpty" hidden>
          <p class="acx-hint">{COPY.favsEmpty}</p>
          <div class="acx-links"><a href={shipsHref}>{COPY.favsShips}</a></div>
        </div>
      </section>

      <!-- ============================ FREUNDE ============================ -->
      <section id="tab-panel-friends" class="acx-tab-panel" hidden>
        <div class="dsec"><h2>{COPY.tabFriends}</h2></div>
        <FriendsManager lang={lang} />
      </section>

      <!-- ============================ SICHERHEIT ============================ -->
      <section id="tab-panel-security" class="acx-tab-panel" hidden>
        <div class="dsec"><h2>{COPY.secSecurity}</h2></div>
        <div class="seccols">

          <div class="seccard" style="grid-column:1/-1">
            <div class="sc-h"><span class="sci"><svg viewBox="0 0 24 24"><use href="#ic-shield"/></svg></span><h3>{COPY.secRsi}</h3></div>
            <p class="sc-desc">{lang === 'de' ? 'Verknüpfe dein RSI-Citizen-Handle mit diesem Konto. Die Prüfung läuft serverseitig über deine RSI-Bio.' : 'Link your RSI citizen handle to this account. Verification runs server-side against your RSI bio.'}</p>
            <div class="field" style="margin-bottom:0">
              <label for="pfRsiHandle">{COPY.rsiHandle}</label>
              <div class="rsi-row">
                <div class="inp-affix" style="flex:1;min-width:200px"><span class="pre">@</span><input class="inp mono" id="pfRsiHandle" type="text" maxlength="32" placeholder={COPY.rsiPh} /></div>
                <button type="button" class="btn ok" id="btnRsiVerifyModal"><svg viewBox="0 0 24 24"><use href="#ic-check"/></svg> {COPY.rsiVerifyBtn}</button>
              </div>
              <div id="rsiVerifiedStatus" class="rsi-verified-indicator" hidden>
                <span>✓ {COPY.rsiVerifiedText}</span>
                <button type="button" id="btnResetRsiVerify">({COPY.rsiReset})</button>
              </div>
            </div>
          </div>

          <div class="seccard">
            <div class="sc-h"><span class="sci"><svg viewBox="0 0 24 24"><use href="#ic-mail"/></svg></span><h3>{COPY.email}</h3></div>
            <p class="sc-desc">{lang === 'de' ? 'Für Konto-Wiederherstellung und Benachrichtigungen. Erfordert Bestätigung auf beiden Adressen.' : 'Used for account recovery and notifications. Requires confirmation on both addresses.'}</p>
            <form id="emailForm" novalidate>
              <div class="field"><label for="seEmail">{COPY.email}</label><input class="inp mono" id="seEmail" name="email" type="email" autocomplete="email" placeholder={COPY.emailPh} /></div>
              <div class="sc-foot"><button class="btn" type="submit" id="seEmailBtn" data-busy={COPY.emailBusy} data-idle={COPY.emailBtn}>{COPY.emailBtn}</button></div>
              <p class="acx-status" id="seEmailStatus" role="status" aria-live="polite" hidden></p>
            </form>
          </div>

          <div class="seccard">
            <div class="sc-h"><span class="sci"><svg viewBox="0 0 24 24"><use href="#ic-lock"/></svg></span><h3>{COPY.pass}</h3></div>
            <p class="sc-desc">{lang === 'de' ? 'Wähle eine starke Passphrase. Andere Sitzungen bleiben angemeldet.' : 'Choose a strong passphrase.'}</p>
            <form id="passForm" novalidate>
              <div class="field"><label for="sePass">{COPY.pass}</label><input class="inp" id="sePass" name="password" type="password" minlength="8" autocomplete="new-password" placeholder={COPY.passPh} /></div>
              <div class="field"><label for="sePass2">{COPY.pass2}</label><input class="inp" id="sePass2" name="password2" type="password" minlength="8" autocomplete="new-password" placeholder={COPY.pass2Ph} /></div>
              <div class="sc-foot"><button class="btn" type="submit" id="sePassBtn" data-busy={COPY.passBusy} data-idle={COPY.passBtn}>{COPY.passBtn}</button></div>
              <p class="acx-status" id="sePassStatus" role="status" aria-live="polite" hidden></p>
            </form>
          </div>

          <div class="danger-card" style="grid-column:1/-1">
            <div class="dz-hazard"></div>
            <span class="stamp">{lang === 'de' ? 'Unwiderruflich' : 'Irreversible'}</span>
            <div class="dz-body">
              <div>
                <h3><svg viewBox="0 0 24 24" style="width:18px;height:18px"><use href="#ic-trash"/></svg> {COPY.secDanger}</h3>
                <p>{COPY.dangerBody}</p>
                <form id="deleteForm" novalidate>
                  <div class="dz-input">
                    <input class="inp mono" id="delConfirm" name="confirm" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={COPY.dangerWord} />
                    <button class="btn danger" type="submit" id="delBtn" disabled data-busy={COPY.dangerBusy} data-idle={COPY.dangerBtn}>{COPY.dangerBtn}</button>
                  </div>
                  <p class="acx-status" id="delStatus" role="alert" aria-live="assertive" hidden></p>
                </form>
              </div>
            </div>
          </div>

        </div>
      </section>

    </div>
  </div>

  <!-- ===== Modals (außerhalb .dsr) ===== -->
  <!-- RSI Verification Wizard Modal -->
  <dialog id="rsiModal" class="acx-modal">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◆</span>
        <h3>{COPY.rsiModalTitle}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:1rem">
        {COPY.rsiModalIntroPre} <strong id="rsiModalTargetHandle">@...</strong> {COPY.rsiModalIntroPost}
      </p>

      <div class="rsi-steps">
        <div class="rsi-step">
          <span class="step-num">1</span>
          <div class="step-txt">
            <span>{COPY.rsiStep1}</span>
            <div class="rsi-code-box" style="margin-top:0.4rem">
              <code id="rsiVerifyCode">VERSEBASE-VERIFY-LOADING</code>
              <button type="button" class="acx-btn-copy" id="btnCopyRsiCode">{COPY.rsiCopy}</button>
            </div>
          </div>
        </div>

        <div class="rsi-step" style="margin-top:0.8rem">
          <span class="step-num">2</span>
          <div class="step-txt">
            <span>{COPY.rsiStep2Pre} <a id="rsiModalProfileLink" href="https://robertsspaceindustries.com/account/profile" target="_blank" rel="noopener noreferrer" style="color:var(--accent);text-decoration:underline">{COPY.rsiStep2Link}</a> {COPY.rsiStep2Post}</span>
          </div>
        </div>

        <div class="rsi-step" style="margin-top:0.8rem">
          <span class="step-num">3</span>
          <div class="step-txt">
            <span>{COPY.rsiStep3}</span>
          </div>
        </div>
      </div>

      <div class="acx-actions" style="margin-top:1.4rem">
        <button type="button" class="acx-submit" id="btnCheckRsiNow">{COPY.rsiCheckNow}</button>
        <button type="button" class="acx-submit acx-submit--ghost" id="btnCloseRsiModal">{COPY.rsiClose}</button>
      </div>
      <p id="rsiVerifyMsg" class="acx-status" hidden style="margin-top:1rem"></p>
    </div>
  </dialog>

  <!-- Public Profile Preview Modal (Read-only-Rendition der Karte) -->
  <dialog id="previewModal" class="acx-modal acx-modal--preview">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◈</span>
        <h3>{COPY.modalTitle}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:1rem">{COPY.previewHint}</p>

      <div class="pv-card">
        <div class="pv-banner" id="pvBanner"></div>
        <div class="pv-body">
          <div class="pv-avatar-row">
            <div class="pv-avatar-box" id="pvAvatarBox">
              <span id="pvAvatarText">◆</span>
              <img id="pvAvatarImg" src="" alt="" hidden />
            </div>
            <span class="pv-registry" id="pvRegistryId">VB-••••••••</span>
          </div>

          <div class="pv-name-row">
            <h4 class="pv-name" id="pvName">Citizen</h4>
            <span class="pv-verified" id="pvVerified" hidden>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              RSI VERIFIED
            </span>
          </div>
          <div class="pv-handle" id="pvHandle">@citizen</div>

          <div class="pv-meta">
            <span class="pv-role" id="pvRole" hidden></span>
            <span class="pv-status" id="pvStatus"></span>
          </div>

          <p class="pv-bio" id="pvBio"></p>

          <div class="pv-chips">
            <a class="pv-chip" id="pvChipRsi" href="#" target="_blank" rel="noopener noreferrer" hidden></a>
            <span class="pv-chip" id="pvChipDiscord" hidden></span>
            <span class="pv-chip" id="pvChipOrg" hidden></span>
          </div>
        </div>
      </div>

      <div class="pv-public" id="pvPublicRow" hidden>
        <span class="pv-public__label">{COPY.publicPageLabel}</span>
        <a class="pv-public__link" id="pvPublicLink" href="#" target="_blank" rel="noopener noreferrer"></a>
        <button
          type="button"
          class="pv-public__copy"
          id="pvPublicCopy"
          data-label={COPY.publicPageCopy}
          data-done={COPY.publicPageCopied}
        >{COPY.publicPageCopy}</button>
      </div>
      <p class="acx-hint" id="pvPublicNoHandle" hidden>{COPY.publicPageNoHandle}</p>

      <div class="acx-actions" style="margin-top:1.2rem">
        <button type="button" class="acx-submit acx-submit--ghost" id="btnClosePreviewModal">{COPY.closeModal}</button>
      </div>
    </div>
  </dialog>

  <!-- Bild-Zuschnitt: Vorschau + Ausschnitt/Zoom vor dem Upload -->
  <dialog id="cropModal" class="acx-modal acx-modal--crop">
    <div class="acx-modal-content">
      <div class="acx-modal-head">
        <span class="acx-modal-icon">◈</span>
        <h3 id="cropTitle">{COPY.cropTitleAvatar}</h3>
      </div>

      <p class="acx-hint" style="margin-bottom:0.9rem">{COPY.cropHint}</p>

      <div class="crop-layout">
        <div class="crop-stage" id="cropStage" data-shape="circle">
          <img id="cropImg" alt="" draggable="false" />
          <div class="crop-grid" id="cropGrid" aria-hidden="true"></div>
          <div class="crop-frame" aria-hidden="true"></div>
        </div>

        <aside class="crop-side">
          <div class="crop-side__label">{COPY.cropPreview}</div>
          <div class="crop-previews" id="cropPreviews">
            <figure class="crop-pv">
              <canvas id="cropPvLg"></canvas>
            </figure>
            <figure class="crop-pv crop-pv--sm">
              <canvas id="cropPvSm"></canvas>
            </figure>
          </div>

          <dl class="crop-info">
            <div><dt>{COPY.cropSource}</dt><dd id="cropInfoSrc">—</dd></div>
            <div><dt>{COPY.cropOutput}</dt><dd id="cropInfoOut">—</dd></div>
            <div><dt>{COPY.cropEstSize}</dt><dd id="cropInfoSize">—</dd></div>
          </dl>

          <p class="crop-warn" id="cropWarn" hidden>{COPY.cropLowRes}</p>
        </aside>
      </div>

      <div class="crop-controls">
        <button type="button" class="crop-btn" id="cropZoomOut" aria-label="Zoom −">−</button>
        <input type="range" id="cropZoom" min="1" max="4" step="0.01" value="1" aria-label={COPY.cropZoom} />
        <button type="button" class="crop-btn" id="cropZoomIn" aria-label="Zoom +">+</button>
        <span class="crop-zoomval" id="cropZoomVal">100%</span>
      </div>

      <div class="crop-tools">
        <button type="button" class="crop-btn" id="cropRotL" title={COPY.cropRotateLeft} aria-label={COPY.cropRotateLeft}>↺</button>
        <button type="button" class="crop-btn" id="cropRotR" title={COPY.cropRotateRight} aria-label={COPY.cropRotateRight}>↻</button>
        <button type="button" class="crop-btn" id="cropFlip" title={COPY.cropFlip} aria-label={COPY.cropFlip}>⇄</button>
        <button type="button" class="acx-upload__remove" id="cropReset">{COPY.cropReset}</button>
      </div>

      <div class="acx-actions" style="margin-top:1.1rem">
        <button type="button" class="acx-submit" id="cropApply">{COPY.cropApply}</button>
        <button type="button" class="acx-submit acx-submit--ghost" id="cropCancel">{COPY.cropCancel}</button>
      </div>
    </div>
  </dialog>
</div>

<script>
import '../../scripts/account-dashboard';
</script>

