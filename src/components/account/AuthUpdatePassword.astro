---
// Neues Passwort setzen — Landeseite des Recovery-Links aus der Mail.
//
// Angenommen wird NUR eine Sitzung aus dem Link selbst, und die lebt in einem
// eigenen Client ohne Speicher (linkClient() in lib/supabase.ts):
//  - ?token_hash=…&type=recovery (neue Mailvorlage) -> verifyOtp()
//  - #access_token=…&refresh_token=… (alte Vorlage; lib/auth-url.ts hat das
//    Fragment schon aus der Adresse genommen und hält die Werte nur hier im
//    Speicher) -> setSession(). ÜBERGANG: entfällt, sobald die Vorlage
//    „Reset password" auf token_hash steht und alte Links (1 h) verfallen
//    sind.
// Eine schon bestehende Anmeldung in diesem Browser öffnet das Formular
// NICHT: wer angemeldet ist, ändert sein Passwort im Konto, mit dem alten
// Passwort. Nach dem Speichern endet die Link-Sitzung, angemeldet wird neu.
// Hat das Konto einen bestätigten Authenticator, verlangt das neue Passwort
// zusätzlich den Code (die Link-Sitzung steht wie jede Anmeldung auf aal1).
import { href } from '../../i18n/ui';
import MfaCodeDialog from './MfaCodeDialog.astro';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;

// Mindestlänge: gleich im Konto (AccountDashboard.astro) und in der
// Registrierung; die verbindliche Grenze setzt Supabase (Auth -> Passwords).
const MIN_PASS = 12;

const COPY = {
  de: {
    pass: 'Neues Passwort', passPh: `Mindestens ${MIN_PASS} Zeichen`,
    pass2: 'Passwort wiederholen', pass2Ph: 'Nochmal dasselbe Passwort',
    forAccount: 'Für das Konto %e%',
    submit: 'Passwort speichern', busy: 'Speichere …',
    checking: 'Prüfe deinen Link …',
    invalidTitle: 'Link ungültig oder abgelaufen',
    invalidBody: 'Der Wiederherstellungs-Link ist nicht (mehr) gültig. Fordere einfach einen neuen an.',
    invalidCta: 'Neuen Link anfordern',
    doneTitle: 'Passwort geändert!',
    doneBody: 'Melde dich jetzt mit deinem neuen Passwort an.',
    doneCta: 'Zur Anmeldung',
    errShort: `Das Passwort braucht mindestens ${MIN_PASS} Zeichen.`,
    errMatch: 'Die Passwörter stimmen nicht überein.',
    errSame: 'Das neue Passwort muss sich vom alten unterscheiden.',
    errWeak: 'Dieses Passwort ist zu schwach — bitte wähle ein anderes.',
    errNet: 'Das hat nicht geklappt — bitte erneut versuchen.',
    errMfa: 'Für dieses Konto braucht das neue Passwort zusätzlich den Code aus der Authenticator-App.',
  },
  en: {
    pass: 'New password', passPh: `At least ${MIN_PASS} characters`,
    pass2: 'Repeat password', pass2Ph: 'Same password again',
    forAccount: 'For the account %e%',
    submit: 'Save password', busy: 'Saving …',
    checking: 'Checking your link …',
    invalidTitle: 'Link invalid or expired',
    invalidBody: 'This recovery link is no longer valid. Just request a new one.',
    invalidCta: 'Request a new link',
    doneTitle: 'Password changed!',
    doneBody: 'Sign in with your new password now.',
    doneCta: 'Go to sign-in',
    errShort: `The password needs at least ${MIN_PASS} characters.`,
    errMatch: 'The passwords do not match.',
    errSame: 'The new password must differ from the old one.',
    errWeak: 'This password is too weak — please choose another one.',
    errNet: 'That did not work — please try again.',
    errMfa: 'For this account the new password also needs the code from your authenticator app.',
  },
}[lang];

const resetHref = href('/account/reset.html', lang);
const loginHref = href('/account/login.html', lang);
---

<div class="acx-card reveal">
  <p class="acx-hint" id="upChecking">{COPY.checking}</p>

  <form id="upForm" hidden novalidate
    data-min={MIN_PASS}
    data-for={COPY.forAccount}
    data-msg-short={COPY.errShort}
    data-msg-match={COPY.errMatch}
    data-msg-same={COPY.errSame}
    data-msg-weak={COPY.errWeak}
    data-msg-net={COPY.errNet}
    data-msg-mfa={COPY.errMfa}
    data-busy={COPY.busy}
    data-submit={COPY.submit}
  >
    <p class="acx-hint" id="upFor" hidden></p>
    <div class="acx-field">
      <label class="acx-label" for="upPass">{COPY.pass} <span class="reqm">*</span></label>
      <input class="acx-input" id="upPass" name="password" type="password" required minlength={MIN_PASS} autocomplete="new-password" placeholder={COPY.passPh} />
    </div>
    <div class="acx-field">
      <label class="acx-label" for="upPass2">{COPY.pass2} <span class="reqm">*</span></label>
      <input class="acx-input" id="upPass2" name="password2" type="password" required minlength={MIN_PASS} autocomplete="new-password" placeholder={COPY.pass2Ph} />
    </div>
    <div class="acx-actions">
      <button class="acx-submit" type="submit" id="upBtn"><span id="upBtnTxt">{COPY.submit}</span></button>
    </div>
    <p class="acx-status" id="upStatus" role="alert" aria-live="assertive" hidden></p>
  </form>

  <div class="acx-done" id="upInvalid" hidden>
    <h2 tabindex="-1">{COPY.invalidTitle}</h2>
    <p>{COPY.invalidBody}</p>
    <div class="acx-links" style="justify-content:center">
      <a href={resetHref}>{COPY.invalidCta}</a>
    </div>
  </div>

  <div class="acx-done" id="upDone" hidden>
    <div class="acx-done__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h2 tabindex="-1">{COPY.doneTitle}</h2>
    <p>{COPY.doneBody}</p>
    <div class="acx-links" style="justify-content:center">
      <a href={loginHref}>{COPY.doneCta}</a>
    </div>
  </div>
</div>
<MfaCodeDialog lang={lang} />

<script>
  import type { User } from '@supabase/supabase-js';
  import { supabase, linkClient, AUTH_URL } from '../../lib/supabase';
  import { needsCode, needsAal2Error } from '../../lib/mfa';
  import { askCode } from '../../lib/mfa-dialog';

  const form = document.getElementById('upForm') as HTMLFormElement | null;
  if (form) {
    const D = form.dataset;
    const checking = document.getElementById('upChecking')!;
    const invalid = document.getElementById('upInvalid')!;
    const doneEl = document.getElementById('upDone')!;
    const forEl = document.getElementById('upFor')!;
    const status = document.getElementById('upStatus')!;
    const btn = document.getElementById('upBtn') as HTMLButtonElement;
    const btnTxt = document.getElementById('upBtnTxt')!;
    const minLen = Number(D.min) || 12;
    const rc = linkClient();

    // Sitzung NUR aus dem Link, nur im Speicher dieser Seite. Abgelaufene
    // Links kommen mit ?error=…&error_code=otp_expired (oder alt im Fragment).
    const fromLink = async (): Promise<User | null> => {
      if (AUTH_URL.error) return null;
      try {
        if (AUTH_URL.tokenHash) {
          if (AUTH_URL.type !== 'recovery') return null;
          const { data, error } = await rc.auth.verifyOtp({ token_hash: AUTH_URL.tokenHash, type: 'recovery' });
          return error || !data.session ? null : data.session.user;
        }
        if (AUTH_URL.legacy) {
          const { data, error } = await rc.auth.setSession(AUTH_URL.legacy);
          return error || !data.session ? null : data.session.user;
        }
      } catch { /* wie ungültig */ }
      return null;
    };

    let linkUser: User | null = null;
    fromLink().then((u) => {
      linkUser = u;
      checking.hidden = true;
      if (!u) { invalid.hidden = false; return; }
      // Für wen das Passwort gilt: ein fremder Link wäre so sofort zu sehen.
      if (u.email) {
        forEl.textContent = (D.for || '').replace('%e%', u.email);
        forEl.hidden = false;
      }
      form.hidden = false;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      if (!linkUser) return;
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;
      const password2 = (form.elements.namedItem('password2') as HTMLInputElement).value;
      const setStatus = (m: string) => { status.textContent = m; status.hidden = false; };

      if (password.length < minLen) { setStatus(D.msgShort!); return; }
      if (password !== password2) { setStatus(D.msgMatch!); return; }

      btn.disabled = true;
      btnTxt.textContent = D.busy!;
      try {
        // Zweiter Faktor: erst der Code, dann das neue Passwort (Supabase
        // nimmt es fuer ein Konto mit Faktor nur aus einer aal2-Sitzung).
        if ((await needsCode(rc)) && !(await askCode(rc))) { setStatus(D.msgMfa!); return; }
        let { error } = await rc.auth.updateUser({ password });
        if (error && needsAal2Error(error)) {
          if (!(await askCode(rc))) { setStatus(D.msgMfa!); return; }
          ({ error } = await rc.auth.updateUser({ password }));
        }
        if (error) {
          const code = (error as { code?: string }).code || '';
          setStatus(code === 'same_password' ? D.msgSame! : code === 'weak_password' ? D.msgWeak! : D.msgNet!);
          return;
        }
        // Link-Sitzung beenden. Supabase meldet beim Passwortwechsel die
        // übrigen Sitzungen dieses Kontos ab; eine eigene, nun stumpfe
        // Sitzung in diesem Browser gleich mit räumen. Eine Sitzung eines
        // ANDEREN Kontos bleibt unangetastet.
        try { await rc.auth.signOut({ scope: 'local' }); } catch { /* verfällt ohnehin */ }
        try {
          const { data } = await supabase.auth.getSession();
          if (data.session && data.session.user.id === linkUser.id) await supabase.auth.signOut({ scope: 'local' });
        } catch { /* egal */ }
        form.hidden = true;
        doneEl.hidden = false;
      } catch {
        setStatus(D.msgNet!);
      } finally {
        btn.disabled = false;
        btnTxt.textContent = D.submit!;
      }
    });
  }
</script>
