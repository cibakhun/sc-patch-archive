---
// Login-Form — geteilt DE/EN (Muster FeedbackForm). Behandelt außerdem:
//  - #access_token im Fragment (Bestätigungs-Link): supabase-js übernimmt die
//    Session automatisch -> direkter Sprung ins Dashboard
//  - ?confirmed=1 (Register-Redirect ohne Auto-Login): Erfolgsbanner
//  - ?next=/… (nur relative Pfade): Rücksprungziel nach Login
import { href } from '../../i18n/ui';

interface Props {
  lang: 'de' | 'en';
}
const { lang } = Astro.props;

const COPY = {
  de: {
    email: 'E-Mail', emailPh: 'du@beispiel.de',
    pass: 'Passwort', passPh: 'Dein Passwort',
    submit: 'Anmelden', busy: 'Anmelden …',
    confirmed: 'E-Mail bestätigt — du kannst dich jetzt anmelden.',
    errCreds: 'E-Mail oder Passwort ist falsch.',
    errUnconfirmed: 'Bitte bestätige zuerst deine E-Mail-Adresse — wir haben dir einen Link geschickt.',
    errRate: 'Zu viele Versuche — bitte kurz warten und erneut probieren.',
    errNet: 'Netzwerkfehler — bitte später erneut versuchen.',
    toRegister: 'Neu hier? Konto erstellen',
    toReset: 'Passwort vergessen?',
    discordBtn: 'Mit Discord anmelden',
    // Seit 29.10.2026 legt der Discord-Knopf ein Konto an, wenn es noch
    // keines gibt (D-02 aufgehoben, supabase/migrations/
    // 20261029120000_allow_discord_signup.sql). Scheitert das Anlegen doch,
    // ist der haeufigste Grund eine E-Mail-Adresse, die schon einem Konto
    // gehoert -- dann fuehrt der Weg ueber dieses Konto.
    errDiscordBlocked: 'Mit Discord hat es nicht geklappt. Hast du schon ein Konto mit derselben E-Mail? Dann melde dich mit E-Mail an und verbinde Discord im Konto.',
    errOauth: 'Discord-Anmeldung fehlgeschlagen — bitte versuche es erneut oder melde dich mit E-Mail und Passwort an.',
  },
  en: {
    email: 'E-mail', emailPh: 'you@example.com',
    pass: 'Password', passPh: 'Your password',
    submit: 'Sign in', busy: 'Signing in …',
    confirmed: 'E-mail confirmed — you can sign in now.',
    errCreds: 'Wrong e-mail or password.',
    errUnconfirmed: 'Please confirm your e-mail address first — we sent you a link.',
    errRate: 'Too many attempts — please wait a moment and try again.',
    errNet: 'Network error — please try again later.',
    toRegister: 'New here? Create an account',
    toReset: 'Forgot your password?',
    discordBtn: 'Sign in with Discord',
    errDiscordBlocked: 'Discord did not work. Do you already have an account with the same e-mail? Then sign in with e-mail and connect Discord in your account.',
    errOauth: 'Discord sign-in failed — please try again, or sign in with e-mail and password.',
  },
}[lang];

const dashboardHref = href('/account.html', lang);
const registerHref = href('/account/register.html', lang);
const resetHref = href('/account/reset.html', lang);
---

<div class="acx-card reveal">
  <p class="acx-status acx-status--ok" id="loginOk" hidden></p>
  <form id="loginForm" novalidate
    data-dash={dashboardHref}
    data-msg-confirmed={COPY.confirmed}
    data-msg-creds={COPY.errCreds}
    data-msg-unconfirmed={COPY.errUnconfirmed}
    data-msg-rate={COPY.errRate}
    data-msg-net={COPY.errNet}
    data-busy={COPY.busy}
    data-submit={COPY.submit}
    data-msg-discord-blocked={COPY.errDiscordBlocked}
    data-msg-oauth={COPY.errOauth}
  >
    <div class="acx-field">
      <label class="acx-label" for="loEmail">{COPY.email} <span class="reqm">*</span></label>
      <input class="acx-input" id="loEmail" name="email" type="email" required autocomplete="email" placeholder={COPY.emailPh} />
    </div>
    <div class="acx-field">
      <label class="acx-label" for="loPass">{COPY.pass} <span class="reqm">*</span></label>
      <input class="acx-input" id="loPass" name="password" type="password" required autocomplete="current-password" placeholder={COPY.passPh} />
    </div>
    <div class="acx-actions">
      <button class="acx-submit" type="submit" id="loBtn"><span id="loBtnTxt">{COPY.submit}</span></button>
    </div>
    <p class="acx-status" id="loginStatus" role="alert" aria-live="assertive" hidden></p>
  </form>
  <hr class="acx-divider" />
  <button type="button" class="acx-submit acx-discord" id="discordBtn">
    <svg class="acx-discord__logo" viewBox="0 0 127.14 96.36" aria-hidden="true"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21H.55A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/></svg>
    <span id="discordBtnTxt">{COPY.discordBtn}</span>
  </button>
  <div class="acx-links">
    <a href={registerHref}>{COPY.toRegister}</a>
    <a href={resetHref}>{COPY.toReset}</a>
  </div>
</div>

<style>
  /* D-01: gleichrangig neben E-Mail/Passwort — volle Breite wie der Submit-
     Knopf des Formulars, kein Kleingedrucktes. */
  .acx-discord { width: 100%; justify-content: center; margin-top: 1.5rem; gap: 10px; background: #4752c4; border-color: transparent; color: #fff; }
  .acx-discord:hover { background: #5865f2; }
  .acx-discord__logo { width: 22px; height: 17px; fill: currentColor; flex: none; }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('loginForm') as HTMLFormElement | null;
  if (form) {
    const D = form.dataset;
    const status = document.getElementById('loginStatus')!;
    const ok = document.getElementById('loginOk')!;
    const btn = document.getElementById('loBtn') as HTMLButtonElement;
    const btnTxt = document.getElementById('loBtnTxt')!;

    // Nur SAME-ORIGIN-Rücksprungziele akzeptieren (kein offener Redirect).
    // Naiver startsWith('/')-Check reichte NICHT: „/\evil.com" beginnt mit
    // genau einem Slash, der Browser normalisiert „\" aber zu „/" -> protokoll-
    // relativ -> Fremd-Origin. Robust: gegen die eigene Origin auflösen und
    // die Origin vergleichen; nur den normalisierten Pfad weiterverwenden.
    const params = new URLSearchParams(location.search);
    const rawNext = params.get('next') || '';
    const safeNext = (raw: string): string => {
      if (!raw) return D.dash!;
      try {
        const u = new URL(raw, location.origin);
        if (u.origin !== location.origin) return D.dash!;
        return u.pathname + u.search + u.hash;
      } catch {
        return D.dash!;
      }
    };
    const next = safeNext(rawNext);

    const go = () => location.replace(next);

    // Discord-OAuth-Rücksprung mit Fehler (D-02): bei flowType 'implicit'
    // kommt eine Absage als #error=…&error_description=… im Fragment
    // zurück, NICHT als ?-Parameter. GoTrue verpackt die im Trigger
    // geworfene Ausnahme mancherorts generisch ("Database error saving new
    // user", error_code "unexpected_failure") statt den eigenen Text
    // durchzureichen — offener Punkt .planning/WINDOWS.md id 16, darum wird
    // auf BEIDE Formen reagiert. Der Rohtext aus error_description wird nie
    // angezeigt — nur der handgeschriebene Hinweis.
    const hashParams = new URLSearchParams(location.hash.startsWith('#') ? location.hash.slice(1) : '');
    const oauthError = hashParams.get('error');
    if (oauthError) {
      const desc = (hashParams.get('error_description') || '').toLowerCase();
      const code = (hashParams.get('error_code') || '').toLowerCase();
      const looksBlocked =
        desc.includes('kein konto auf verse-base.com') ||
        desc.includes('database error saving new user') ||
        code === 'unexpected_failure';
      status.textContent = looksBlocked ? D.msgDiscordBlocked! : D.msgOauth!;
      status.hidden = false;
      // Fragment sofort entfernen (T-14-23): kein Fehlertext im Verlauf/Screenshot.
      history.replaceState(null, '', location.pathname + location.search);
    }

    if (params.get('confirmed') === '1') {
      ok.textContent = D.msgConfirmed!;
      ok.hidden = false;
    }

    // Bereits eingeloggt (oder Session frisch aus dem Discord-Rücksprung /
    // E-Mail-Link von supabase-js' detectSessionInUrl übernommen)?
    supabase.auth.getSession().then(({ data }) => {
      if (data.session) go();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;
      if (!email || !password) return;

      btn.disabled = true;
      btnTxt.textContent = D.busy!;
      try {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (!error) {
          go();
          return;
        }
        const code = (error as { code?: string }).code || '';
        status.textContent =
          code === 'email_not_confirmed' ? D.msgUnconfirmed!
          : code === 'over_request_rate_limit' ? D.msgRate!
          : D.msgCreds!;
        status.hidden = false;
      } catch {
        status.textContent = D.msgNet!;
        status.hidden = false;
      } finally {
        btn.disabled = false;
        btnTxt.textContent = D.submit!;
      }
    });

    const discordBtn = document.getElementById('discordBtn') as HTMLButtonElement | null;
    if (discordBtn) {
      discordBtn.addEventListener('click', async () => {
        discordBtn.disabled = true;
        status.hidden = true;
        // Keine zusätzlichen Scopes: identify+email ist die Provider-Vorgabe
        // und reicht (D-03) — Rollenfragen beantwortet der Bot-Token
        // server-zu-server, nicht das Nutzertoken.
        //
        // redirectTo zeigt bewusst auf DIESE Login-Seite selbst, nicht auf
        // /account/ (Dashboard): das Dashboard-Skript (account-dashboard.ts)
        // leitet ohne Sitzung sofort per location.replace() zu dieser Seite
        // weiter — dabei ginge ein #error=…-Fragment aus einer abgewiesenen
        // Anmeldung verloren, bevor es je gelesen werden könnte. Der
        // Rücksprung auf sich selbst behandelt Erfolg (supabase-js liest die
        // Session aus dem Fragment, der bestehende getSession()-Zweig oben
        // leitet dann weiter) UND Fehler (Block oben) an derselben Stelle.
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'discord',
          options: { redirectTo: location.origin + location.pathname + location.search },
        });
        if (error) {
          status.textContent = D.msgOauth!;
          status.hidden = false;
          discordBtn.disabled = false;
        }
        // Kein error: der Browser navigiert bereits zu Discord weg.
      });
    }
  }
</script>
