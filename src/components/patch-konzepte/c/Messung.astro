---
// Vorher/Nachher-Balken: der groessere Wert fuellt die Spur, der kleinere
// steht als Marke darin. Die Zahlen stehen daneben im Text, der Balken ist
// nur fuer das Auge.
interface Props {
  vorher: number | null;
  nachher: number;
  /** gemeinsame Skala mehrerer Balken; ohne: der groessere der beiden Werte */
  max?: number;
  /** zweiter Balken in Grau statt Vorher-Marke (Vergleich zweier Schiffe) */
  vergleich?: boolean;
}
const { vorher, nachher, max, vergleich = false } = Astro.props;
const skala = (max ?? Math.max(vorher ?? 0, nachher)) || 1;
const anteil = (x: number) => Math.min(1, Math.max(0, x / skala)).toFixed(3);
---
<span class:list={['kc-gauge', { 'kc-gauge--vs': vergleich }]} aria-hidden="true">
  <i class="kc-gauge__ist" style={`--w:${anteil(nachher)}`}></i>
  {vorher != null && <i class="kc-gauge__was" style={`--w:${anteil(vorher)}`}></i>}
</span>
