---
// Scharfschaltweite der Torpedos: Ringe um den Abschusspunkt, 700 m hervorgehoben.
interface Props { label: string; class?: string }
const { label, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 225" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
  <g fill="none" stroke="#9aa1ad" stroke-width="1" opacity=".35">
    <circle cx="60" cy="150" r="70" />
    <circle cx="60" cy="150" r="140" />
    <circle cx="60" cy="150" r="280" />
  </g>
  <circle cx="60" cy="150" r="210" fill="none" stroke="#e0563f" stroke-width="2.5" stroke-dasharray="10 6" />
  <text x="262" y="56" fill="#e0563f" font-family="Teko, sans-serif" font-size="34" font-weight="600">700 m</text>
  <g transform="translate(60 150) rotate(-24)">
    <rect x="0" y="-6" width="120" height="12" rx="6" fill="#f2eee6" />
    <path d="M120 -6 L138 0 L120 6 Z" fill="#f2eee6" />
    <path d="M4 -6 L-8 -16 L14 -6 Z M4 6 L-8 16 L14 6 Z" fill="#9aa1ad" />
  </g>
  <circle cx="60" cy="150" r="5" fill="#8fb8d8" />
</svg>
