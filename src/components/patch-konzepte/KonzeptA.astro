<script is:inline src={versioned('assets/a11y.js', '/assets/a11y.js')}></script>

<script>
  const tb = document.getElementById('topbar');
  if (tb) addEventListener('scroll', () => tb.classList.toggle('scrolled', scrollY > 40), { passive: true });

  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const reel of document.querySelectorAll<HTMLElement>('[data-reel]')) {
    const spur = reel.querySelector<HTMLElement>('.reel')!;
    const dias = [...spur.children] as HTMLElement[];
    const zahl = reel.querySelector<HTMLElement>('[data-zahl]')!;
    const knoepfe = [...reel.querySelectorAll<HTMLButtonElement>('[data-dir]')];
    let jetzt = 0;
    const geh = (i: number) => {
      const ziel = dias[Math.max(0, Math.min(dias.length - 1, i))];
      spur.scrollTo({ left: ziel.offsetLeft - dias[0].offsetLeft, behavior: ruhig ? 'auto' : 'smooth' });
    };
    knoepfe.forEach((b) => b.addEventListener('click', () => geh(jetzt + Number(b.dataset.dir))));
    spur.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      geh(jetzt + (e.key === 'ArrowRight' ? 1 : -1));
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      jetzt = dias.indexOf(e.target as HTMLElement);
      zahl.textContent = String(jetzt + 1);
      knoepfe[0].disabled = jetzt === 0;
      knoepfe[1].disabled = jetzt === dias.length - 1;
    }), { root: spur, threshold: 0.6 });
    dias.forEach((d) => io.observe(d));
  }
</script>

