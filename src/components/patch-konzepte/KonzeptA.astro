---
// Entwurf A „Kino“ der 4.10.3-Seite: jede Neuerung eine Szene mit großem
// Bild. Die Rahmen im Breitbild (2,39 : 1) folgen den RSI-Motiven, die
// selbst fast so breit sind. Inhalt nur aus src/lib/patch-4-10-3/inhalt.ts.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben,
// Astro 5.18 verschluckt sonst dessen schließendes Tag.
import { getEntry } from 'astro:content';
import SiteNav from '../SiteNav.astro';
import PatchDossier from '../dossier/PatchDossier.astro';
import Bild from '../patch-blocks/Bild.astro';
import Text from '../patch-blocks/Text.astro';
import Mauler from './a/Mauler.astro';
import Torpedo from './a/Torpedo.astro';
import Skarnov from './a/Skarnov.astro';
import Camo from './a/Camo.astro';
import { href, localeFromPath } from '../../i18n/ui';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { patchInhalt, type Bild as BildT, type BildArt, type Text as TextT } from '../../lib/patch-4-10-3/inhalt';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const T = (d: string, e: string) => (de ? d : e);
const n = (x: number) => x.toLocaleString(de ? 'de-DE' : 'en-US');
const L = (h: string) => (h.startsWith('https://') || h.startsWith('#') ? h : href(h, lang));
const entry = await getEntry('patches', '4-10-3');
if (!entry) throw new Error('KonzeptA: Patch-Daten 4-10-3 fehlen in src/data/patches/');
const patch = mergePatchEn('4-10-3', entry.data, lang);
const I = await patchInhalt(lang);

const bild = (thema: string, art: BildArt): BildT => {
  const b = I.bilder.find((x) => x.thema === thema && x.art === art);
  if (!b) throw new Error(`KonzeptA: Bild ${thema}/${art} fehlt`);
  return b;
};
/** Fließtext in Sätze teilen, damit je Abschnitt höchstens zwei als Fließtext stehen. */
const saetze = (t: TextT | string): TextT[] => {
  const out: TextT[] = [[]];
  for (const s of typeof t === 'string' ? [t] : t) {
    if (typeof s !== 'string') { out[out.length - 1].push(s); continue; }
    s.split(/(?<=\.)\s+(?=[A-ZÄÖÜ„"])/).forEach((p, i) => {
      if (i > 0) out.push([]);
      if (p) out[out.length - 1].push(p);
    });
  }
  return out.filter((x) => x.length > 0);
};
const zahlAus = (s: string) => Number(s.replace(/[^\d]/g, '')) || 0;
const stand = (f: string) => `${T('Stand', 'Data')} ${f}`;
const W = Object.fromEntries(I.werte.map((g) => [g.id, g]));
const K = Object.fromEntries(I.ausruestung.karten.map((k) => [k.id, k]));
const SALVAGE_MAX = Math.max(...W.salvage.zeilen.map((r) => r.nachher.zahl ?? 0));
const datum = (iso: string) => new Date(iso).toLocaleDateString(de ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const kopfBild = bild('vanduul-incursion', 'rsi');
const mauler = T('Umriss eines Vanduul Mauler', 'Outline of a Vanduul Mauler');
const GRUPPEN_BILD: (BildT | null)[] = [bild('vncl-scythe', 'rsi'), null, bild('vncl-blade', 'rsi'), bild('vncl-glaive', 'rsi')];
const SCHIFF_BILDER = I.neueSchiffe.map((s) => ({
  gross: s.bilder.find((b) => b.art === 'rsi')!,
  neben: s.bilder.filter((b) => b.art !== 'rsi').slice(0, 2),
  lead: saetze(s.text),
  max: s.vergleich.werte.map((w) => Math.max(zahlAus(w.dieses), zahlAus(w.jenes)) || 1),
}));
const auftragsLead = saetze(I.auftraege.lead);
const WERT_BILD = { radar: bild('anvl-carrack', 'render'), salvage: bild('aegs-reclaimer', 'render'), vanguard: bild('aegs-vanguard', 'render') };
const kampfGross = W.kampf.zeilen[0];
const kampfRest = W.kampf.zeilen.slice(1);
const iaeBild = I.bilder.find((b) => b.key === 'iae-2956-halle')!;
const stadtBild = I.bilder.find((b) => b.key === 'iae-2956-stadt')!;
const logoBild = I.bilder.find((b) => b.key === 'iae-2956-logo')!;
const polaris = bild('rsi-polaris', 'render');
const namenBild = K.namen.bilder[0];
---
<style is:global>
  :root{
    --bg:#06070a;--bg-2:#0d0f14;--surface:#13161d;--surface-2:#1b1f28;
    --accent:#e0563f;--accent-2:#8fb8d8;--hot:#8fb8d8;
    --text:#f2eee6;--muted:#a1a8b4;
    --line:rgba(224,86,63,.28);--line-soft:rgba(242,238,230,.10);--line-ice:rgba(143,184,216,.28);
    --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;--font-mono:'Share Tech Mono',monospace;
    --font-poster:'Teko','Rajdhani',sans-serif;
    --maxw:1360px;--gut:clamp(1rem,5vw,5rem);
  }
  body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.55;-webkit-font-smoothing:antialiased;margin:0}
</style>

<a class="skip" href="#main">{T('Zum Inhalt springen', 'Skip to content')}</a>
<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.10.3' }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.10.3' }]} />

<main id="main" class="ka">

  <section class="hero" aria-labelledby="ka-titel">
    <div class="bg kb"><Bild bild={kopfBild} sizes="100vw" eager /></div>
    <div class="hero__in">
      <p class="credit">{I.kopf.eyebrow}</p>
      <h1 id="ka-titel"><span class="sr-only">Star Citizen Alpha </span>{I.kopf.titel}</h1>
      <p class="hero__code"><Text text={I.kopf.codename} /></p>
      <p class="hero__satz">{I.kopf.satz}</p>
      <nav aria-label={T('Abschnitte', 'Sections')}>
        <ul class="jump">{I.abschnitte.map((j) => <li><a href={`#${j.id}`}>{j.t}</a></li>)}</ul>
      </nav>
    </div>
  </section>

  <section class="glance" aria-label={T('Auf einen Blick', 'At a glance')}>
    <h2 class="sr-only">{T('Auf einen Blick', 'At a glance')}</h2>
    <ul class="tiles">
      {I.kacheln.map((g) => (
        <li class="tile">
          <div class="bg">
            {g.bilder[0] ? <Bild bild={g.bilder[0]} sizes="(max-width: 760px) 50vw, 25vw" />
              : g.link?.h.includes('mauler') ? <Mauler label={mauler} class="art" />
              : g.ziel === 'ausruestung' ? <Camo label={T('Muster Raider Camo', 'Raider Camo pattern')} class="art art--fill" />
              : <Torpedo label={T('Torpedo mit Scharfschaltring bei 700 m', 'Torpedo with its arming ring at 700 m')} class="art" />}
          </div>
          <a class="tile__go" href={`#${g.ziel}`}>
            <span class="tile__k">{g.k}</span>
            <span class="tile__v">{g.v}</span>
            <span class="tile__s">{g.s}</span>
          </a>
          <p class="tile__foot">
            {g.link && <a href={L(g.link.h)}>{g.link.t} →</a>}
            <span class="ka-stand">{stand(g.stand)}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="scene" id="auftraege">
    <div class="frame">
      <div class="bg"><Bild bild={bild('vanduul-incursion', 'szene')} sizes="100vw" /></div>
      <div class="cap">
        <p class="credit">{T('Auftraggeber', 'Contractor')} · {I.auftraege.auftraggeber}</p>
        <h2 class="title">{I.auftraege.titel}</h2>
      </div>
    </div>
    <div class="wrap">
      <div class="lead-row">
        <p class="lead">{auftragsLead.slice(0, 2).map((s) => <><Text text={s} /> </>)}</p>
        <ul class="chips">{auftragsLead.slice(2).map((s) => <li><Text text={s} /></li>)}</ul>
      </div>
      <div class="ops">
        {I.auftraege.gruppen.map((m, gi) => (
          <article class="op">
            <div class="op__pic">
              {GRUPPEN_BILD[gi] ? <Bild bild={GRUPPEN_BILD[gi]!} sizes="(max-width: 900px) 100vw, 50vw" /> : <Mauler label={mauler} class="art" />}
              <p class="op__typ">{m.typ}</p>
            </div>
            <div class="op__in">
              <h3>{m.titel}</h3>
              <p>{m.text}</p>
              <ol>
                {m.auftraege.map((x) => (
                  <li>
                    <a href={L(x.link.h)}>{x.titel}</a>
                    <span class="rank">{T('ab', 'from')} {x.rang}</span>
                    {x.belohnung && <a class="reward" href={L(x.belohnung.h)}>{x.belohnung.t}</a>}
                  </li>
                ))}
              </ol>
              <p class="ka-stand">{stand(m.auftraege[0].stand)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ships" id="schiffe" aria-label={T('Neue Schiffe', 'New ships')}>
    {I.neueSchiffe.map((s, si) => (
      <article class="ship">
        <div class="frame frame--ship">
          <div class="bg"><Bild bild={SCHIFF_BILDER[si].gross} sizes="100vw" /></div>
          <div class="cap">
            <p class="credit">{T('Neues Schiff', 'New ship')} · {s.hersteller}</p>
            <h2 class="title title--xl"><a href={L(s.link.h)}>{s.name}</a></h2>
          </div>
        </div>
        <div class="wrap ship__body">
          <div class="ship__text">
            <p class="lead">{SCHIFF_BILDER[si].lead[0]}</p>
            <ul class="facts">{SCHIFF_BILDER[si].lead.slice(1).map((t) => <li><Text text={t} /></li>)}</ul>
            {s.module.length > 0 && <ul class="parts">{s.module.map((p) => <li><a href={L(p.h)}>{p.t}</a></li>)}</ul>}
            <a class="more" href={L(s.link.h)}>{T('Zum Datenblatt', 'Full data sheet')} →</a>
          </div>
          <dl class="readout">
            {s.werte.map((r) => <div><dt>{r.k}</dt><dd><Text text={r.v} /></dd></div>)}
            <div class="stand-row"><dt>{T('Datenstand', 'Data')}</dt><dd>{s.stand}</dd></div>
          </dl>
          <figure class="vs">
            <figcaption>{s.name} <span>{T('gegen', 'vs')}</span> <a href={L(s.vergleich.schiff.h)}>{s.vergleich.schiff.t}</a></figcaption>
            <dl>
              {s.vergleich.werte.map((w, wi) => (
                <div>
                  <dt>{w.k}</dt>
                  <dd>
                    <span class="vs__bar vs__bar--a" style={`--w:${zahlAus(w.dieses) / SCHIFF_BILDER[si].max[wi]}`}><b>{w.dieses}</b></span>
                    <span class="vs__bar vs__bar--b" style={`--w:${zahlAus(w.jenes) / SCHIFF_BILDER[si].max[wi]}`}><b>{w.jenes}</b></span>
                  </dd>
                </div>
              ))}
            </dl>
          </figure>
          <div class="ship__stills">
            {SCHIFF_BILDER[si].neben.map((b) => <figure class="still"><Bild bild={b} sizes="(max-width: 900px) 100vw, 26vw" /></figure>)}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="auec" id="auec" data-reel>
    <div class="wrap auec__head">
      <div>
        <p class="credit">{T('Kaufpreis im Spiel', 'In-game purchase price')} · {T('Preise vom', 'Prices from')} {datum(I.auec.schiffe[0].preiseVom)} · {stand(I.auec.schiffe[0].stand)}</p>
        <h2 class="title">{I.auec.titel}</h2>
        <p class="lead"><Text text={I.auec.lead} /></p>
      </div>
      <div class="reel__ctl">
        <button type="button" data-dir="-1" aria-label={T('Vorheriges Schiff', 'Previous ship')}>←</button>
        <span class="reel__count" aria-live="polite"><b data-zahl>1</b> / {I.auec.schiffe.length}</span>
        <button type="button" data-dir="1" aria-label={T('Nächstes Schiff', 'Next ship')}>→</button>
      </div>
    </div>
    <ul class="reel" tabindex="0" aria-label={T('Acht Schiffe für aUEC, mit Pfeiltasten blättern', 'Eight ships for aUEC, browse with arrow keys')}>
      {I.auec.schiffe.map((s) => (
        <li class="slide">
          <div class="slide__pic">
            <Bild bild={s.bilder.find((b) => b.art === 'rsi') ?? s.bilder[0]} sizes="(max-width: 760px) 86vw, min(78vw, 1100px)" />
            <p class="slide__maker">{s.hersteller}</p>
            <h3 class="slide__name"><a href={L(s.link.h)}>{s.name}</a></h3>
          </div>
          <dl class="slide__buy">
            {s.angebote.map((o) => (
              <div><dt><b>{o.haendler}</b>{o.ort}</dt><dd>{n(o.preis)}<small>aUEC</small></dd></div>
            ))}
          </dl>
        </li>
      ))}
    </ul>
  </section>

  <section class="werte" id="werte">
    <div class="wrap werte__head">
      <h2 class="title">{T('Geänderte Werte', 'Changed values')}</h2>
      <p class="credit">4.10.2 → 4.10.3 · <a href={I.notes.h} target="_blank" rel="noopener">{I.notes.t}</a></p>
    </div>

    <section class="band" id="radar">
      <div class="band__pic"><Bild bild={WERT_BILD.radar} sizes="(max-width: 900px) 100vw, 50vw" /></div>
      <div class="band__in">
        <p class="credit">{W.radar.titel} · {W.radar.zeilen[0].vorherStand} → {W.radar.zeilen[0].stand}</p>
        <p class="big">{W.radar.tag}</p>
        <ul class="rows">
          {W.radar.zeilen.map((r) => (
            <li>
              <span class="rows__k">{r.schiffe.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}</span>
              <span class="rows__v">{r.vorher ? <span class="was"><Text text={r.vorher.v} /></span> : <span class="was">{T('schon', 'already')}</span>}<span class="ist"><Text text={r.nachher.v} /></span></span>
            </li>
          ))}
        </ul>
        <p class="note"><Text text={W.radar.notiz} /></p>
      </div>
    </section>

    <section class="band band--flip" id="salvage">
      <div class="band__pic"><Bild bild={WERT_BILD.salvage} sizes="(max-width: 900px) 100vw, 50vw" /></div>
      <div class="band__in">
        <p class="credit">{W.salvage.titel} · {W.salvage.zeilen[0].vorherStand} → {W.salvage.zeilen[0].stand}</p>
        <p class="big">{n(W.salvage.zeilen[0].vorher?.zahl ?? 0)} → {n(W.salvage.zeilen[0].nachher.zahl ?? 0)} <small>{W.salvage.einheit}</small></p>
        <ul class="bars">
          {W.salvage.zeilen.map((r) => (
            <li>
              <a href={L(r.schiffe[0].h)}>{r.schiffe[0].t}</a>
              <span class="bars__n">{r.vorher?.zahl} → <b>{r.nachher.zahl}</b> SCU</span>
              <i aria-hidden="true" style={`--a:${(r.vorher?.zahl ?? 0) / SALVAGE_MAX};--b:${(r.nachher.zahl ?? 0) / SALVAGE_MAX}`}></i>
            </li>
          ))}
        </ul>
        <p class="note"><Text text={W.salvage.notiz} /></p>
      </div>
    </section>

    <section class="band band--art" id="kampf">
      <div class="band__pic"><Mauler label={mauler} class="art" /></div>
      <div class="band__in">
        <p class="credit">{W.kampf.titel} · {W.kampf.tag} · {kampfGross.vorherStand} → {kampfGross.stand}</p>
        <p class="big">{n(kampfGross.vorher?.zahl ?? 0)} → {n(kampfGross.nachher.zahl ?? 0)}</p>
        <p class="big__k"><Text text={kampfGross.was} /> · +{kampfGross.delta} %</p>
        <ul class="rows">
          {kampfRest.map((c) => (
            <li>
              <span class="rows__k"><Text text={c.was} /></span>
              <span class="rows__v">{c.vorher && <span class="was"><Text text={c.vorher.v} /></span>}<span class={c.vorher ? 'ist' : 'ist only'}><Text text={c.nachher.v} /></span></span>
            </li>
          ))}
        </ul>
        <figure class="torp"><Torpedo label={T('Torpedo mit Scharfschaltring bei 700 m', 'Torpedo with its arming ring at 700 m')} /></figure>
        <p class="note"><Text text={W.kampf.notiz} /></p>
      </div>
    </section>

    <section class="band band--flip" id="vanguard">
      <div class="band__pic"><Bild bild={WERT_BILD.vanguard} sizes="(max-width: 900px) 100vw, 50vw" /></div>
      <div class="band__in">
        <p class="credit">{W.vanguard.titel} · <span class="off">{W.vanguard.tag}</span> · {W.vanguard.zeilen[0].vorherStand} → {W.vanguard.zeilen[0].stand}</p>
        <p class="big">{n(W.vanguard.zeilen[0].vorher?.zahl ?? 0)} → {n(W.vanguard.zeilen[0].nachher.zahl ?? 0)} <small>DPS</small></p>
        <ul class="rows">
          {W.vanguard.zeilen.map((r) => (
            <li>
              <span class="rows__k">{r.schiffe.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)} <em><Text text={r.was} /></em></span>
              <span class="rows__v"><span class="was">{r.vorher && <Text text={r.vorher.v} />}</span><span class="ist"><Text text={r.nachher.v} /></span></span>
            </li>
          ))}
        </ul>
        <p class="note"><Text text={W.vanguard.notiz} /></p>
      </div>
    </section>
  </section>

  <section class="gear" id="ausruestung">
    <div class="wrap">
      <div class="gear__head">
        <h2 class="title">{I.ausruestung.titel}</h2>
        <p class="big">+{I.ausruestung.bauplaeneNeu} <small>{T('Baupläne', 'blueprints')}</small></p>
      </div>
      <div class="cards">
        <article class="card card--wide">
          <div class="card__art card__art--rifles">
            {I.ausruestung.skarnov.map((a) => (
              <div class="rifle"><Skarnov toene={a.toene} label={`Skarnov ${a.name}`} /><a href={L(a.link.h)}>{a.name}</a></div>
            ))}
          </div>
          <div class="card__in">
            <p class="credit">{K.skarnov.tag} · {stand(K.skarnov.stand)}</p>
            <h3>{K.skarnov.titel}</h3>
            <p><Text text={K.skarnov.text} /></p>
            <p class="links"><span>{K.skarnov.liste[1].k}</span> <a href={L(K.skarnov.liste[1].v[0].h)}>{K.skarnov.liste[1].v[0].t}</a></p>
          </div>
        </article>
        <article class="card">
          <div class="card__art"><Camo label={T('Muster Raider Camo', 'Raider Camo pattern')} class="art art--fill" /></div>
          <div class="card__in">
            <p class="credit">{K['raider-camo'].tag} · {stand(K['raider-camo'].stand)}</p>
            <h3>{K['raider-camo'].titel}</h3>
            <p><Text text={K['raider-camo'].text} /></p>
            {I.ausruestung.camo.map((c) => <p class="links"><span>{c.k}</span> {c.v.map((x) => <a href={L(x.h)}>{x.t}</a>)}</p>)}
          </div>
        </article>
        <article class="card">
          <div class="card__art"><Bild bild={polaris} sizes="(max-width: 900px) 100vw, 33vw" /></div>
          <div class="card__in">
            <p class="credit">{K.deterrent.tag} · {stand(K.deterrent.stand)}</p>
            <h3>{K.deterrent.titel}</h3>
            <p><Text text={K.deterrent.text} /></p>
            <p class="links">{K.deterrent.liste.map((z) => <a href={L(z.v[0].h)}>{z.v[0].t}</a>)}</p>
          </div>
        </article>
        <article class="card" id="namen">
          <div class="card__art"><Bild bild={namenBild} sizes="(max-width: 900px) 100vw, 33vw" /></div>
          <div class="card__in">
            <p class="credit">{K.namen.tag} · {stand(K.namen.stand)}</p>
            <h3>{K.namen.titel}</h3>
            <p><Text text={K.namen.text} /></p>
          </div>
        </article>
      </div>
    </div>
    <div class="frame frame--iae" id="iae-2956">
      <div class="bg"><Bild bild={iaeBild} sizes="100vw" /></div>
      <div class="cap">
        <p class="credit">{K['iae-2956'].tag} · {stand(K['iae-2956'].stand)}</p>
        <h3 class="title">{K['iae-2956'].titel}</h3>
      </div>
    </div>
    <div class="wrap iae">
      <p class="lead"><Text text={K['iae-2956'].text} /></p>
      <div class="iae__lists">
        {K['iae-2956'].liste.map((z) => <p class="links"><span>{z.k}</span> {z.v.map((x) => <a href={L(x.h)}>{x.t}</a>)}</p>)}
      </div>
    </div>
  </section>

  <section class="stock" id="bestand">
    <div class="frame frame--low">
      <div class="bg"><Bild bild={stadtBild} sizes="100vw" /></div>
      <div class="cap">
        <p class="credit"><a href={L(I.vorgaenger.h)}>{I.vorgaenger.t}</a> → {I.version}</p>
        <h2 class="title">{T('Bestand', 'Catalogue')}</h2>
      </div>
    </div>
    <div class="wrap">
      <ul class="stock__rows">
        {I.bestand.zeilen.map((c) => (
          <li>
            <a href={L(c.was.h)}>{c.was.t}</a>
            <span class="stock__n">{n(c.nachher)}</span>
            <span class="stock__d">+{n(c.nachher - c.vorher)} <small>{T('seit', 'since')} {c.vorherStand} ({n(c.vorher)}) · {stand(c.stand)}</small></span>
          </li>
        ))}
      </ul>
