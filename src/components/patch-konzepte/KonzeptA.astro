---
// Entwurf A „Kino“ der 4.10.3-Seite (Platzhalter). Inhalt nur aus
// src/lib/patch-4-10-3/inhalt.ts, Bausteine in src/components/patch-blocks/.
import { localeFromPath } from '../../i18n/ui';
import { patchInhalt } from '../../lib/patch-4-10-3/inhalt';
import Bild from '../patch-blocks/Bild.astro';

const lang = localeFromPath(Astro.url.pathname);
const I = await patchInhalt(lang);
const kopf = I.bilder.find((b) => b.key === 'vanduul-angriff');
if (!kopf) throw new Error('KonzeptA: Kopfbild vanduul-angriff fehlt');
---
<main id="main" class="konzept-a">
  <h1>{lang === 'de' ? 'Entwurf A · Kino' : 'Concept A · Kino'}: {I.kopf.titel}</h1>
  <Bild bild={kopf} sizes="100vw" eager />
</main>
<style>
  .konzept-a{max-width:1280px;margin:0 auto;padding:6rem 1rem 3rem}
  .konzept-a h1{font-family:var(--font-display,sans-serif);font-size:clamp(1.6rem,4vw,3rem);margin-bottom:1rem}
  .konzept-a :global(img){display:block;width:100%;height:auto}
</style>