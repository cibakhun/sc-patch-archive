---
// Uebersicht der drei Entwuerfe fuer die 4.10.3-Seite, nur im Vorschau-Bau
// (scripts/lib/vorschau-patches.mjs VORSCHAU_KONZEPTE). Die Vorschaubilder sind
// Aufnahmen des ersten Bildschirms jedes Entwurfs bei 1366 px.
import { localeFromPath, href } from '../../i18n/ui';
import { patchInhalt } from '../../lib/patch-4-10-3/inhalt';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const I = await patchInhalt(lang);
const KONZEPTE = [
  { id: 'a', name: 'Kino', satz: de ? 'Dunkle Szenen über die volle Breite, jede Neuerung mit großem Bild und riesiger Schrift.' : 'Dark full-width scenes, each novelty with a large image and huge type.' },
  { id: 'b', name: 'Magazin', satz: de ? 'Titelseite aus Bildkacheln, darunter Strecken auf hellen und dunklen Flächen.' : 'A cover of image tiles, then spreads on light and dark surfaces.' },
  { id: 'c', name: 'Cockpit', satz: de ? 'Schiffsanzeige mit Holo-Schiffen, Zahlen in Monospace, Balken und Reitern.' : 'A ship display with holo ships, monospace numbers, bars and tabs.' },
].map((k) => ({ ...k, href: href(`/patches/konzept-${k.id}.html`, lang), bild: `/assets/patch-4-10-3/konzepte/konzept-${k.id}` }));
---
<main id="main" class="konzepte">
  <p class="eyebrow">{de ? 'Vorschau · nicht live' : 'Preview · not live'}</p>
  <h1>{de ? `Drei Entwürfe für ${I.kopf.titel}` : `Three concepts for ${I.kopf.titel}`}</h1>
  <p class="lead">{de ? 'Gleiche Inhalte, drei Gestaltungen. Ein Klick öffnet den Entwurf.' : 'Same content, three designs. Click to open a concept.'}</p>
  <ul>
    {KONZEPTE.map((k, i) => (
      <li>
        <a href={k.href}>
          <img src={`${k.bild}.webp`} srcset={`${k.bild}-600.webp 600w, ${k.bild}.webp 1200w`} sizes="(max-width: 900px) 100vw, 400px" width="1200" height="750" alt={de ? `Erster Bildschirm von Entwurf ${k.id.toUpperCase()}, ${k.name}` : `First screen of concept ${k.id.toUpperCase()}, ${k.name}`} loading={i === 0 ? 'eager' : 'lazy'} />
          <h2>{de ? 'Entwurf' : 'Concept'} {k.id.toUpperCase()} · {k.name}</h2>
          <p>{k.satz}</p>
        </a>
      </li>
    ))}
  </ul>
</main>
<style>
  .konzepte{max-width:1280px;margin:0 auto;padding:7rem 1rem 3rem}
  .konzepte .eyebrow{font-family:var(--font-ui,sans-serif);text-transform:uppercase;letter-spacing:var(--ls-12);font-size:var(--fs-6);color:var(--accent,#e0563f);margin:0 0 .4rem}
  .konzepte h1{font-family:var(--font-display,sans-serif);font-size:clamp(1.8rem,4.5vw,3rem);margin:0 0 .5rem}
  .konzepte .lead{color:var(--muted,#a3abb8);margin:0 0 2rem}
  .konzepte ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:1.4rem;padding:0;margin:0}
  .konzepte a{display:block;color:inherit;text-decoration:none;border:1px solid var(--line-soft,rgba(255,255,255,.12));background:rgba(255,255,255,.02);transition:border-color var(--dur-fast) var(--ease-ui),transform var(--dur-fast) var(--ease-ui)}
  .konzepte a:hover,.konzepte a:focus-visible{border-color:var(--accent,#e0563f);transform:translateY(-2px)}
  .konzepte img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover}
  .konzepte h2{font-size:var(--fs-12,1.25rem);margin:.9rem 1rem .3rem}
  .konzepte a p{margin:0 1rem 1.1rem;color:var(--muted,#a3abb8)}
  @media (prefers-reduced-motion: reduce){.konzepte a{transition:none}.konzepte a:hover{transform:none}}
</style>
