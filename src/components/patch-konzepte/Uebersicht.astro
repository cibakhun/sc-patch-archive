---
// Uebersicht der drei Entwuerfe fuer die 4.10.3-Seite, nur im Vorschau-Bau
// (scripts/lib/vorschau-patches.mjs VORSCHAU_KONZEPTE).
import { localeFromPath, href } from '../../i18n/ui';
import { patchInhalt } from '../../lib/patch-4-10-3/inhalt';
import Bild from '../patch-blocks/Bild.astro';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const I = await patchInhalt(lang);
const KONZEPTE = [
  { id: 'a', name: 'Kino', bild: 'vanduul-angriff', satz: de ? 'Dunkel, vollbreite Szenen, riesige Schrift.' : 'Dark, full-width scenes, huge type.' },
  { id: 'b', name: 'Magazin', bild: 'iae-2956-stadt', satz: de ? 'Bento-Raster aus Bildkacheln, redaktionell erzählt.' : 'Bento grid of image tiles, told like a magazine.' },
  { id: 'c', name: 'Cockpit', bild: 'rsi-galaxy-hologramm', satz: de ? 'Schiffs-HUD: Holo-Schiffe, Zahlen in Monospace, Balken und Anzeigen.' : 'Ship HUD: holo ships, monospace numbers, bars and gauges.' },
].map((k) => {
  const bild = I.bilder.find((b) => b.key === k.bild);
  if (!bild) throw new Error(`Uebersicht: Bild ${k.bild} fehlt`);
  return { ...k, bild, href: href(`/patches/konzept-${k.id}.html`, lang) };
});
---
<main id="main" class="konzepte">
  <h1>{de ? `Drei Entwürfe für ${I.kopf.titel}` : `Three concepts for ${I.kopf.titel}`}</h1>
  <ul>
    {KONZEPTE.map((k) => (
      <li>
        <a href={k.href}>
          <Bild bild={k.bild} sizes="(max-width: 900px) 100vw, 400px" />
          <h2>{de ? 'Entwurf' : 'Concept'} {k.id.toUpperCase()} · {k.name}</h2>
          <p>{k.satz}</p>
        </a>
      </li>
    ))}
  </ul>
</main>
<style>
  .konzepte{max-width:1280px;margin:0 auto;padding:6rem 1rem 3rem}
  .konzepte h1{font-family:var(--font-display,sans-serif);font-size:clamp(1.6rem,4vw,2.6rem);margin-bottom:1.5rem}
  .konzepte ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:1.2rem;padding:0}
  .konzepte a{display:block;color:inherit;text-decoration:none;border:1px solid var(--line-soft,rgba(255,255,255,.12))}
  .konzepte a:hover{border-color:var(--accent,#e0563f)}
  .konzepte :global(img){display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}
  .konzepte h2{font-size:var(--fs-12,1.2rem);margin:.8rem 1rem .2rem}
  .konzepte p{margin:0 1rem 1rem;color:var(--muted,#a3abb8)}
</style>
