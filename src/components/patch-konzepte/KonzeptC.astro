---
// Entwurf C „Cockpit“ der 4.10.3-Seite: die Seite als Schiffsanzeige.
// Inhalt nur aus src/lib/patch-4-10-3/inhalt.ts, Bausteine in
// src/components/patch-blocks/, eigene Teile in ./c/.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben,
// Astro 5.18 verschluckt sonst dessen schliessendes Tag.
import SiteNav from '../SiteNav.astro';
import PatchDossier from '../dossier/PatchDossier.astro';
import Bild from '../patch-blocks/Bild.astro';
import Text from '../patch-blocks/Text.astro';
import Grafik from './c/Grafik.astro';
import Messung from './c/Messung.astro';
import './c/cockpit.css';
import { getEntry } from 'astro:content';
import { mergePatchEn } from '../../i18n/patchText';
import { versioned } from '../../lib/assetVersion';
import { localeFromPath, href } from '../../i18n/ui';
import { patchInhalt, type Bild as BildT, type Kachel, type Link, type Text as TextT } from '../../lib/patch-4-10-3/inhalt';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const L = (p: string) => href(p, lang);
const T = (d: string, e: string) => (de ? d : e);
const n = (x: number) => x.toLocaleString(de ? 'de-DE' : 'en-US');
const entry = await getEntry('patches', '4-10-3');
if (!entry) throw new Error('KonzeptC: Patch-Daten 4-10-3 fehlen in src/data/patches/');
const patch = mergePatchEn('4-10-3', entry.data, lang);
const I = await patchInhalt(lang);
const W = Object.fromEntries(I.werte.map((g) => [g.id, g]));
const K = Object.fromEntries(I.ausruestung.karten.map((k) => [k.id, k]));

const bild = (key: string): BildT => {
  const b = I.bilder.find((x) => x.key === key);
  if (!b) throw new Error(`KonzeptC: Bild ${key} fehlt`);
  return b;
};
/** freigestelltes Hologramm (eigener Render) eines Schiffs */
const holo = (thema: string) => bild(`${thema}-holo`);
const holos = (bs: BildT[]) => bs.filter((b) => b.art === 'holo' && b.key === `${b.thema}-holo`);
const istLink = (x: TextT[number]): x is Link => typeof x === 'object' && 'h' in x;
const linkIn = (text: TextT, h: string): Link => {
  const l = text.filter(istLink).find((x) => x.h === h);
  if (!l) throw new Error(`KonzeptC: Link ${h} fehlt im Text`);
  return l;
};
/** "1.234 HP" / "1,234 HP" -> 1234 */
const zahlAus = (s: string) => Number(s.replace(/[^\d]/g, ''));

/* ---- Auf einen Blick: drei Reiter ---- */

type Anzeige =
  | { art: 'bild'; bild: BildT }
  | { art: 'grafik'; grafik: 'mauler' | 'skarnov' | 'torpedo' | 'radar' }
  | { art: 'messung'; vorher: number; nachher: number; einheit: string };
type BlickKachel = Pick<Kachel, 'k' | 'v' | 's' | 'link' | 'stand'> & { art: 'new' | 'event' | 'changed' | 'removed' | 'renamed'; ziel: string; anzeige: Anzeige; vorherStand?: string; satz?: TextT };

const kachelAnzeige = (g: Kachel): Anzeige => {
  if (g.ziel === 'auftraege') return { art: 'bild', bild: holo('vncl-scythe') };
  if (g.ziel === 'schiffe') return { art: 'bild', bild: holo('anvl-liberator') };
  if (g.ziel === 'auec') return { art: 'bild', bild: holo('drak-ironclad') };
  if (g.ziel === 'ausruestung') return { art: 'grafik', grafik: 'skarnov' };
  if (g.ziel === 'radar') return { art: 'grafik', grafik: 'radar' };
  if (g.ziel === 'salvage') {
    const r = W.salvage.zeilen[0];
    return { art: 'messung', vorher: r.vorher!.zahl!, nachher: r.nachher.zahl!, einheit: 'SCU' };
  }
  if (g.ziel === 'kampf' && g.link?.h.includes('mauler')) {
    const r = W.kampf.zeilen[0];
    return { art: 'messung', vorher: r.vorher!.zahl!, nachher: r.nachher.zahl!, einheit: T('Schaden', 'damage') };
  }
  return { art: 'grafik', grafik: 'torpedo' };
};
const ausKachel = (g: Kachel): BlickKachel => ({ ...g, art: g.art === 'event' ? 'event' : g.art === 'changed' ? 'changed' : 'new', anzeige: kachelAnzeige(g), vorherStand: g.art === 'changed' ? '4.10.2' : undefined });

const phoenix = linkIn(K.namen.text, '/schiffe/rsi-constellation-phoenix.html');
const hm6 = ['anvl-ballista', 'anvl-spartan', 'anvl-centurion'].map((id) => linkIn(K.namen.text, `/schiffe/${id}.html`));
const deterrent = linkIn(K.deterrent.text, '/items/deterrent.html');
const entfallen: BlickKachel[] = [
  { art: 'removed', k: 'Phoenix Emerald', v: T('entfernt', 'removed'), s: '', satz: [T('Jetzt eine Lackierung der ', 'Now a livery for the '), phoenix], link: null, ziel: 'namen', stand: K.namen.stand, anzeige: { art: 'bild', bild: holo('rsi-constellation-phoenix') } },
  { art: 'removed', k: 'Hammerhead 2949 Best In Show', v: T('entfernt', 'removed'), s: T('Kein eigenes Fahrzeug mehr', 'No longer a separate vehicle'), link: null, ziel: 'namen', stand: K.namen.stand, anzeige: { art: 'bild', bild: holo('aegs-hammerhead') } },
  { art: 'renamed', k: 'Glacis → Deterrent', v: T('umbenannt', 'renamed'), s: '', satz: [T('RSI-Schild Größe 4, ab Werk auf der ', 'RSI size 4 shield, factory-fitted on the '), linkIn(K.deterrent.text, '/schiffe/rsi-polaris.html')], link: deterrent, ziel: 'ausruestung', stand: K.deterrent.stand, anzeige: { art: 'bild', bild: holo('rsi-polaris') } },
  { art: 'renamed', k: 'HM6', v: T('umbenannt', 'renamed'), s: '', satz: hm6.flatMap((x, i) => (i > 0 ? [' · ', x] : [x])), link: null, ziel: 'namen', stand: K.namen.stand, anzeige: { art: 'bild', bild: holo('anvl-ballista') } },
];
const reiter = [
  { id: 'neu', t: T('Neu', 'New'), kacheln: I.kacheln.filter((g) => g.art === 'new' || g.art === 'event').map(ausKachel) },
  { id: 'geaendert', t: T('Geändert', 'Changed'), kacheln: I.kacheln.filter((g) => g.art === 'changed').map(ausKachel) },
  { id: 'entfernt', t: T('Entfernt · umbenannt', 'Removed · renamed'), kacheln: entfallen },
];

/* ---- Auftraege: ein Vanduul-Schiff je Gruppe, der Mauler gezeichnet ---- */

const GRUPPEN_BILD: (string | null)[] = ['vncl-glaive', null, 'vncl-scythe', 'vncl-stinger'];
const gruppen = I.auftraege.gruppen.map((g, i) => ({ ...g, holo: GRUPPEN_BILD[i] ? holo(GRUPPEN_BILD[i]!) : null }));

/* ---- aUEC: eine Preisskala fuer alle acht ---- */

const PREIS_MAX = Math.max(...I.auec.schiffe.flatMap((s) => s.angebote.map((o) => o.preis)));
const auec = I.auec.schiffe.map((s) => ({ ...s, holo: holo(s.id) }));
---
<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.10.3' }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.10.3' }]} />

<main id="main" class="kc">

  <section class="kc-hero" aria-labelledby="kc-titel">
    <div class="kc-hero__in">
      <div class="kc-hero__txt">
        <p class="kc-eyebrow"><span class="kc-led" aria-hidden="true"></span>{I.kopf.eyebrow}</p>
        <h1 id="kc-titel" class="kc-title"><span class="kc-title__pre">Alpha</span>{I.kopf.titel}</h1>
        <p class="kc-codename">{I.kopf.codename[0]}<b>{I.kopf.codename[1]}</b></p>
        <p class="kc-satz">{I.kopf.satz}</p>
        <p class="kc-hero__notes"><a href={I.notes.h} target="_blank" rel="noopener">{I.notes.t}</a></p>
      </div>
      <figure class="kc-hero__holo">
        <Bild bild={bild('rsi-galaxy-hologramm')} sizes="(max-width: 900px) 100vw, 62vw" eager />
        <span class="kc-reticle" aria-hidden="true"></span>
        <figcaption class="kc-callout">
          <span class="kc-callout__tag">{T('Neu', 'New')} · {I.neueSchiffe[0].stand}</span>
          <a href={L(I.neueSchiffe[0].link.h)}>{I.neueSchiffe[0].hersteller.split(' ').map((w) => w[0]).join('')} {I.neueSchiffe[0].name}</a>
          <span class="kc-callout__v">{I.neueSchiffe[0].werte[2].k} <Text text={I.neueSchiffe[0].werte[2].v} /></span>
        </figcaption>
      </figure>
    </div>
    <nav class="kc-keys" aria-label={T('Abschnitte', 'Sections')}>
      <ul>
        {I.abschnitte.map((j) => <li><a href={`#${j.id}`}>{j.t}</a></li>)}
      </ul>
    </nav>
  </section>

  <section class="kc-blk kc-blick" aria-labelledby="kc-blick-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-blick-h">{T('Auf einen Blick', 'At a glance')}</h2>
        <span class="kc-stamp">4.10.2 → 4.10.3</span>
      </header>
      <div class="kc-tabs" data-kc-tabs>
        <div class="kc-tablist" data-kc-tablist hidden>
          {reiter.map((r, i) => (
            <button type="button" id={`kc-tab-${r.id}`} data-kc-tab={r.id} class={`kc-tab kc-tab--${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'} aria-controls={`kc-tp-${r.id}`}>
              {r.t}<span class="kc-tab__n">{r.kacheln.length}</span>
            </button>
          ))}
        </div>
        {reiter.map((r) => (
          <div class="kc-tp" id={`kc-tp-${r.id}`} data-kc-panel={r.id}>
            <h3 class="kc-tp__h">{r.t}</h3>
            <ul class="kc-tiles">
              {r.kacheln.map((g) => (
                <li class={`kc-tile kc-tile--${g.art}`}>
                  <div class="kc-tile__vis">
                    {g.anzeige.art === 'bild' && <Bild bild={g.anzeige.bild} sizes="(max-width: 560px) 44vw, (max-width: 1100px) 46vw, 300px" />}
                    {g.anzeige.art === 'grafik' && <Grafik art={g.anzeige.grafik} />}
                    {g.anzeige.art === 'messung' && (
                      <div class="kc-tile__mess">
                        <span class="kc-num kc-num--was">{n(g.anzeige.vorher)}</span>
                        <Messung vorher={g.anzeige.vorher} nachher={g.anzeige.nachher} />
                        <span class="kc-num">{n(g.anzeige.nachher)} <small>{g.anzeige.einheit}</small></span>
                      </div>
                    )}
                  </div>
                  <p class="kc-tile__k">{g.k}</p>
                  <p class="kc-tile__v"><a href={`#${g.ziel}`}>{g.v}</a></p>
                  <p class="kc-tile__s">{g.satz ? <Text text={g.satz} /> : g.s}</p>
                  <p class="kc-tile__f">
                    <span class="kc-stand">{g.vorherStand ? `${g.vorherStand} → ${g.stand}` : `${T('Stand', 'Data')} ${g.stand}`}</span>
                    {g.link && <a href={L(g.link.h)}>{g.link.t} →</a>}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="kc-blk" id="auftraege" aria-labelledby="kc-auftraege-h">
    <div class="kc-wrap">
      <div class="kc-brief">
        <Bild bild={bild('vanduul-angriff')} sizes="(max-width: 1280px) 100vw, 1280px" class="kc-brief__bild" />
        <div class="kc-brief__in">
          <p class="kc-eyebrow kc-eyebrow--hot"><span class="kc-led kc-led--hot" aria-hidden="true"></span>{T('Kontakt · feindlich · Nyx', 'Contact · hostile · Nyx')}</p>
          <h2 id="kc-auftraege-h">{I.auftraege.titel}</h2>
          <p class="kc-lead"><Text text={I.auftraege.lead} /></p>
          <p class="kc-meta">{T('Auftraggeber', 'Contractor')} <b>{I.auftraege.auftraggeber}</b> · <span class="kc-stand">{T('Stand', 'Data')} {gruppen[0].auftraege[0].stand}</span></p>
        </div>
        <Grafik art="scope" gruppen={gruppen.map((g) => g.auftraege.length)} class="kc-brief__scope" label={T(`Radarschirm mit ${gruppen.reduce((a, g) => a + g.auftraege.length, 0)} Kontakten, einer je Auftrag`, `Radar scope with ${gruppen.reduce((a, g) => a + g.auftraege.length, 0)} contacts, one per contract`)} />
      </div>
      <div class="kc-ops">
        {gruppen.map((m, gi) => (
          <article class="kc-op kc-frame">
            <div class="kc-op__vis">
              {m.holo ? <Bild bild={m.holo} sizes="(max-width: 800px) 90vw, 560px" /> : <Grafik art="mauler" label={T('Umriss eines Vanduul Mauler', 'Outline of a Vanduul Mauler')} />}
              <span class="kc-op__code" aria-hidden="true">{`TGT-${String.fromCharCode(65 + gi)}`}</span>
            </div>
            <div class="kc-op__in">
              <p class="kc-op__typ">{m.typ}</p>
              <h3>{m.titel}</h3>
              <p class="kc-op__txt">{m.text}</p>
              <ol class="kc-op__list">
                {m.auftraege.map((x) => (
                  <li>
                    <a href={L(x.link.h)}>{x.titel}</a>
                    <span class="kc-chip">{T('ab', 'from')} {x.rang}</span>
                    {x.belohnung && <a class="kc-op__reward" href={L(x.belohnung.h)}>{x.belohnung.t}</a>}
                  </li>
                ))}
              </ol>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="kc-blk kc-bay" id="schiffe" aria-labelledby="kc-schiffe-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-schiffe-h">{T('Neue Schiffe', 'New ships')}</h2>
        <span class="kc-stamp">{T('Stand', 'Data')} {I.neueSchiffe[0].stand}</span>
      </header>
      {I.neueSchiffe.map((s) => {
        const vmax = s.vergleich.werte.map((w) => Math.max(zahlAus(w.dieses), zahlAus(w.jenes)));
        return (
          <article class="kc-sheet kc-frame">
            <div class="kc-sheet__holo">
              <Bild bild={holo(s.id)} sizes="(max-width: 900px) 100vw, 760px" />
              <div class="kc-sheet__name">
                <span class="kc-sheet__mfr">{s.hersteller}</span>
                <h3><a href={L(s.link.h)}>{s.name}</a></h3>
              </div>
            </div>
            <div class="kc-sheet__data">
              <p class="kc-sheet__txt">{s.text}</p>
              <dl class="kc-readout">
                {s.werte.map((r) => <div><dt>{r.k}</dt><dd><Text text={r.v} /></dd></div>)}
              </dl>
              {s.module.length > 0 && <ul class="kc-chips">{s.module.map((p) => <li><a class="kc-chip kc-chip--link" href={L(p.h)}>{p.t}</a></li>)}</ul>}
              <a class="kc-more" href={L(s.link.h)}>{T('Zum Datenblatt →', 'Full data sheet →')}</a>
            </div>
            <div class="kc-sheet__vs">
              <div class="kc-vs">
                <p class="kc-vs__h">
                  <span class="kc-key kc-key--ist">{s.name}</span>
                  <span class="kc-key kc-key--vs"><a href={L(s.vergleich.schiff.h)}>{s.vergleich.schiff.t}</a></span>
                </p>
                <ul>
                  {s.vergleich.werte.map((w, i) => (
                    <li>
                      <span class="kc-vs__k">{w.k}</span>
                      <span class="kc-vs__bars">
                        <Messung vorher={null} nachher={zahlAus(w.dieses)} max={vmax[i]} />
                        <Messung vorher={null} nachher={zahlAus(w.jenes)} max={vmax[i]} vergleich />
                      </span>
                      <span class="kc-vs__n"><b>{w.dieses}</b><span>{w.jenes}</span></span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="kc-blk" id="auec" aria-labelledby="kc-auec-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-auec-h">{I.auec.titel}</h2>
        <span class="kc-stamp">{T('Stand', 'Data')} {auec[0].stand} · {T('Preise vom', 'Prices from')} {auec[0].preiseVom}</span>
      </header>
      <p class="kc-lead"><Text text={I.auec.lead} /></p>
      <ul class="kc-shop">
        {auec.map((s) => (
          <li class="kc-buy kc-frame">
            <a class="kc-buy__pic" href={L(s.link.h)} tabindex="-1" aria-hidden="true"><Bild bild={s.holo} sizes="(max-width: 560px) 38vw, (max-width: 1100px) 46vw, 300px" /></a>
            <div class="kc-buy__in">
              <p class="kc-buy__mfr">{s.hersteller}</p>
              <h3><a href={L(s.link.h)}>{s.name}</a></h3>
              <ul class="kc-buy__offers">
                {s.angebote.map((o) => (
                  <li>
                    <span class="kc-buy__where"><b>{o.haendler}</b>{o.ort}</span>
                    <span class="kc-num">{n(o.preis)} <small>aUEC</small></span>
                    <Messung vorher={null} nachher={o.preis} max={PREIS_MAX} />
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="kc-blk" id="werte" aria-labelledby="kc-werte-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-werte-h">{T('Geänderte Werte', 'Changed values')}</h2>
        <span class="kc-stamp"><span class="kc-key kc-key--was">4.10.2</span><span class="kc-key kc-key--ist">4.10.3</span></span>
      </header>
      <div class="kc-panels">
        {I.werte.map((g) => {
          const bilder = holos(g.bilder).slice(0, 3);
          return (
            <section class="kc-panel kc-frame" id={g.id}>
              <div class="kc-panel__vis" data-n={g.id === 'kampf' ? 2 : bilder.length}>
                {g.id === 'kampf' && <Grafik art="mauler" label={T('Umriss eines Vanduul Mauler', 'Outline of a Vanduul Mauler')} />}
                {bilder.slice(0, g.id === 'kampf' ? 1 : 3).map((b) => <Bild bild={b} sizes="(max-width: 560px) 30vw, 180px" />)}
              </div>
              <header>
                <h3>{g.titel}</h3>
                <span class:list={['kc-tag', { 'kc-tag--warn': !g.inNotes }]}>{g.tag}</span>
              </header>
              {g.id === 'radar' && <Grafik art="radar" class="kc-panel__radar" label={T('Radargröße 2 in 4.10.2, 3 in 4.10.3', 'Radar size 2 in 4.10.2, 3 in 4.10.3')} />}
              <ul class="kc-rows">
                {g.zeilen.map((r) => (
                  <li class:list={['kc-row', { 'kc-row--text': !r.vorher && !r.schon }]}>
                    <span class="kc-row__was">
                      {r.schiffe.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}
                      {r.schiffe.length > 0 && r.was.length > 0 && ' · '}
                      {r.was.length > 0 && <Text text={r.was} />}
                    </span>
                    <span class="kc-row__ba">
                      {r.vorher ? <span class="kc-num kc-num--was"><Text text={r.vorher.v} /></span> : r.schon ? <span class="kc-num kc-num--was">{T('schon', 'already')}</span> : null}
                      {(r.vorher || r.schon) && <span class="kc-arrow" aria-hidden="true">→</span>}
                      <span class="kc-num"><Text text={r.nachher.v} />{g.einheit && <small> {g.einheit}</small>}</span>
                      {r.delta != null && <span class="kc-delta">+{n(r.delta)} %</span>}
                    </span>
                    {r.vorher?.zahl != null && r.nachher.zahl != null && <Messung vorher={r.vorher.zahl} nachher={r.nachher.zahl} />}
                  </li>
                ))}
              </ul>
              <p class="kc-note"><Text text={g.notiz} /></p>
            </section>
          );
        })}
      </div>
    </div>
  </section>

  <section class="kc-blk" id="ausruestung" aria-labelledby="kc-aus-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-aus-h">{I.ausruestung.titel}</h2>
        <span class="kc-stamp"><a href={L('/crafting.html')}>{T('Baupläne', 'Blueprints')} +{I.ausruestung.bauplaeneNeu}</a> · {T('Stand', 'Data')} {K.skarnov.stand}</span>
      </header>
      <div class="kc-gear">
        <article class="kc-card kc-frame">
          <header><h3>{K.skarnov.titel}</h3><span class="kc-tag">{K.skarnov.tag}</span></header>
          <ul class="kc-skarnov">
            {I.ausruestung.skarnov.map((a) => (
              <li><Grafik art="skarnov" toene={a.toene} /><a href={L(a.link.h)}>{a.name}</a></li>
            ))}
          </ul>
          <p class="kc-note"><Text text={K.skarnov.text} /></p>
          <p class="kc-chips"><a class="kc-chip kc-chip--link" href={L(K.skarnov.liste[1].v[0].h)}>{K.skarnov.liste[1].v[0].t}</a></p>
        </article>
        <article class="kc-card kc-frame">
          <Grafik art="camo" class="kc-card__swatch" label={T('Farbmuster der Tarnung „Raider Camo“', 'Swatch of the "Raider Camo" pattern')} />
          <header><h3>{K['raider-camo'].titel}</h3><span class="kc-tag">{K['raider-camo'].tag}</span></header>
          <p class="kc-note"><Text text={K['raider-camo'].text} /></p>
          <dl class="kc-readout kc-readout--list">
            {I.ausruestung.camo.map((c) => <div><dt>{c.k}</dt><dd>{c.v.map((x, i) => <>{i > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}</dd></div>)}
          </dl>
        </article>
        <article class="kc-card kc-frame">
          <div class="kc-card__holo"><Bild bild={holo('rsi-polaris')} sizes="(max-width: 640px) 90vw, 400px" /></div>
          <header><h3>{K.deterrent.titel}</h3><span class="kc-tag">{K.deterrent.tag}</span></header>
          <p class="kc-note"><Text text={K.deterrent.text} /></p>
          <p class="kc-chips">{K.deterrent.liste.map((z) => <a class="kc-chip kc-chip--link" href={L(z.v[0].h)}>{z.v[0].t}</a>)}</p>
        </article>
        <article class="kc-card kc-card--wide kc-frame">
          <div class="kc-card__photo"><Bild bild={bild('iae-2956-halle')} sizes="(max-width: 640px) 90vw, 820px" /></div>
          <header><h3>{K['iae-2956'].titel}</h3><span class="kc-tag">{K['iae-2956'].tag}</span></header>
          <p class="kc-note"><Text text={K['iae-2956'].text} /></p>
        </article>
        <article class="kc-card kc-frame" id="namen">
          <div class="kc-card__strip">{hm6.map((x) => <Bild bild={holo(x.h.replace('/schiffe/', '').replace('.html', ''))} sizes="(max-width: 640px) 30vw, 130px" />)}</div>
          <header><h3>{K.namen.titel}</h3><span class="kc-tag kc-tag--hot">{K.namen.tag}</span></header>
          <p class="kc-note"><Text text={K.namen.text} /></p>
        </article>
      </div>
    </div>
  </section>

  <section class="kc-blk" id="bestand" aria-labelledby="kc-bestand-h">
    <div class="kc-wrap">
      <header class="kc-head">
        <h2 id="kc-bestand-h">{T('Bestand', 'Catalogue')}</h2>
        <span class="kc-stamp"><a href={L(I.vorgaenger.h)}>{I.vorgaenger.t}</a> → {I.version}</span>
      </header>
      <ul class="kc-count kc-frame">
        {I.bestand.zeilen.map((c) => (
          <li>
            <a class="kc-count__k" href={L(c.was.h)}>{c.was.t}</a>
            <span class="kc-num kc-num--was">{n(c.vorher)} <small>{c.vorherStand}</small></span>
            <span class="kc-num kc-count__ist">{n(c.nachher)} <small>{c.stand}</small></span>
            <span class="kc-delta">+{n(c.nachher - c.vorher)}</span>
          </li>
        ))}
      </ul>
      <div class="kc-neu kc-frame">
        <div class="kc-neu__holos">{I.neueSchiffe.map((s) => <a href={L(s.link.h)} tabindex="-1" aria-hidden="true"><Bild bild={holo(s.id)} sizes="(max-width: 560px) 44vw, 220px" /></a>)}</div>
        <p class="kc-note"><Text text={I.bestand.notiz} /></p>
      </div>
    </div>
  </section>

  <section class="kc-blk kc-fold">
    <details class="kc-wrap" id="akte">
      <summary class="kc-frame"><Grafik art="akte" class="kc-fold__ico" /><span class="kc-fold__ttl">{I.dossier.titel}</span><span class="kc-fold__sub">{I.dossier.text}</span></summary>
      <PatchDossier patch={patch} lang={lang} />
    </details>
  </section>

</main>

<footer class="kc-foot">
  <nav class="kc-pager" aria-label={de ? 'Patch-Navigation' : 'Patch navigation'}>
    <a href={L(I.vorgaenger.h)}><span class="kc-pager__dir">{de ? '← Älter' : '← Older'}</span><span class="kc-pager__ttl">{I.vorgaenger.titel}</span></a>
    <span class="kc-pager__off"><span class="kc-pager__dir">{de ? 'Neuer →' : 'Newer →'}</span><span class="kc-pager__ttl">{de ? 'Aktuellster Patch' : 'Latest patch'}</span></span>
  </nav>
  <div class="kc-foot__meta">
    <a href={de ? '/de/archiv.html' : '/archiv.html'}>{de ? '⌂ Alle Patches' : '⌂ All patches'}</a>
    <span>{de ? 'Quellen: RSI Patch Notes & Comm-Links' : 'Sources: RSI patch notes & comm-links'}</span>
  </div>
  <p class="kc-foot__disc">{de ? 'Inoffizielles Fan-Projekt. Star Citizen® © Cloud Imperium Rights LLC & Ltd. Keine Verbindung zu CIG. Standbilder & Schiff-/System-Bilder aus offiziellen Quellen (© Cloud Imperium Games), Fan-Content-Nutzung.' : 'Unofficial fan project. Star Citizen® © Cloud Imperium Rights LLC & Ltd. No affiliation with CIG. Stills & ship/system imagery from official sources (© Cloud Imperium Games), fan-content usage.'}</p>
</footer>

<script is:inline>
(function(){
const tb=document.getElementById('topbar');
if(tb)addEventListener('scroll',()=>tb.classList.toggle('scrolled',scrollY>40),{passive:true});
const root=document.querySelector('[data-kc-tabs]');if(!root)return;
const list=root.querySelector('[data-kc-tablist]');
const tabs=[...root.querySelectorAll('[data-kc-tab]')];
const panels=[...root.querySelectorAll('[data-kc-panel]')];
list.hidden=false;list.setAttribute('role','tablist');list.setAttribute('aria-label',document.getElementById('kc-blick-h').textContent);
root.classList.add('kc-tabs--on');
tabs.forEach(t=>t.setAttribute('role','tab'));
panels.forEach(p=>{p.setAttribute('role','tabpanel');p.setAttribute('tabindex','0');p.setAttribute('aria-labelledby','kc-tab-'+p.dataset.kcPanel);});
function show(id,focus){tabs.forEach(t=>{const on=t.dataset.kcTab===id;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1;if(on&&focus)t.focus();});panels.forEach(p=>{p.hidden=p.dataset.kcPanel!==id;});}
tabs.forEach((t,i)=>{t.addEventListener('click',()=>show(t.dataset.kcTab,false));t.addEventListener('keydown',e=>{const k={ArrowRight:i+1,ArrowLeft:i-1,Home:0,End:tabs.length-1}[e.key];if(k===undefined)return;e.preventDefault();show(tabs[(k+tabs.length)%tabs.length].dataset.kcTab,true);});});
show(tabs[0].dataset.kcTab,false);
})();
</script>
