---
// Draufsicht eines Vanduul-Maulers als Zeichnung: von ihm gibt es kein
// offizielles Bild. Die Strahlen davor stehen fuer den STRIKER-Schuss.
interface Props { label: string; class?: string }
const { label, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 260" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="260" fill="#5a1a12" />
  <circle cx="200" cy="170" r="190" fill="#8a2a1b" opacity=".55" />
  <g stroke="#ffd2a8" stroke-opacity=".8" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 14">
    <line x1="186" y1="96" x2="176" y2="6" />
    <line x1="214" y1="96" x2="224" y2="6" />
    <line x1="160" y1="120" x2="132" y2="20" opacity=".7" />
    <line x1="240" y1="120" x2="268" y2="20" opacity=".7" />
  </g>
  <path fill="#171b23" stroke="#e0563f" stroke-width="1.5" stroke-linejoin="round"
    d="M200 84 L214 128 L250 120 L336 168 L384 236 L300 204 L246 196 L226 248 L200 230 L174 248 L154 196 L100 204 L16 236 L64 168 L150 120 L186 128 Z" />
  <path fill="none" stroke="#e0563f" stroke-width="1" opacity=".6" d="M200 96 L200 226 M150 132 L120 196 M250 132 L280 196" />
</svg>
