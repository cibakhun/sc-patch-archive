---
// Torpedo und Entfernungsringe: Groesse 5 und 7 machen sich erst ab 700 m scharf.
interface Props { label: string; class?: string }
const { label, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 260" role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="260" fill="#121722" />
  <g fill="none" stroke="#8fb8d8">
    <circle cx="40" cy="40" r="90" stroke-opacity=".25" stroke-dasharray="4 6" />
    <circle cx="40" cy="40" r="180" stroke-opacity=".35" stroke-dasharray="4 6" />
    <circle cx="40" cy="40" r="270" stroke="#e0563f" stroke-width="2.5" />
  </g>
  <g transform="rotate(32 40 40)">
    <rect x="70" y="32" width="130" height="16" rx="8" fill="#d9dee6" />
    <path fill="#e0563f" d="M200 32 L228 40 L200 48 Z" />
    <path fill="#8a93a3" d="M70 32 L56 24 L56 56 L70 48 Z" />
  </g>
</svg>
