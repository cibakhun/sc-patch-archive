---
// Entwurf B „Magazin“ der 4.10.3-Seite: Titelseite als Raster aus
// Bildkacheln, darunter Strecken auf hellen und dunklen Flaechen.
// Ein Element auf OBERSTER Ebene darf keinen {ausdruck} als Kind haben,
// Astro 5.18 verschluckt sonst dessen schliessendes Tag.
import { getEntry } from 'astro:content';
import SiteNav from '../SiteNav.astro';
import PatchDossier from '../dossier/PatchDossier.astro';
import Bild from '../patch-blocks/Bild.astro';
import Text from '../patch-blocks/Text.astro';
import { mergePatchEn } from '../../i18n/patchText';
import { localeFromPath, href } from '../../i18n/ui';
import { patchInhalt } from '../../lib/patch-4-10-3/inhalt';
import type { Bild as BildT, BildArt, Kachel } from '../../lib/patch-4-10-3/inhalt';
import Mauler from './b/Mauler.astro';
import Skarnov from './b/Skarnov.astro';
import Camo from './b/Camo.astro';
import Reichweite from './b/Reichweite.astro';
import Komponente from './b/Komponente.astro';

const lang = localeFromPath(Astro.url.pathname);
const de = lang === 'de';
const T = (d: string, e: string) => (de ? d : e);
const L = (p: string) => href(p, lang);
const n = (x: number) => x.toLocaleString(de ? 'de-DE' : 'en-US');
const I = await patchInhalt(lang);
const entry = await getEntry('patches', '4-10-3');
if (!entry) throw new Error('KonzeptB: Patch-Daten 4-10-3 fehlen');
const patch = mergePatchEn('4-10-3', entry.data, lang);

const foto = (thema: string, art: BildArt = 'rsi', key?: string): BildT => {
  const b = I.bilder.find((x) => x.thema === thema && x.art === art && (!key || x.key === key));
  if (!b) throw new Error(`KonzeptB: Bild ${thema}/${art}${key ? '/' + key : ''} fehlt`);
  return b;
};
const zahlAus = (s: string) => Number(s.replace(/[^\d]/g, '')) || 0;
const datum = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString(de ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

type Platz = 'gross' | 'schiffe' | 'auec' | 'radar' | 'salvage' | 'mauler' | 'torpedo' | 'bauplan';
const PLAETZE: [Platz, Kachel['ziel']][] = [['gross', 'auftraege'], ['schiffe', 'schiffe'], ['auec', 'auec'], ['radar', 'radar'], ['salvage', 'salvage'], ['mauler', 'kampf'], ['torpedo', 'kampf'], ['bauplan', 'ausruestung']];
if (I.kacheln.length !== PLAETZE.length) throw new Error(`KonzeptB: ${I.kacheln.length} Kacheln, Raster hat ${PLAETZE.length} Plaetze`);
const KACHEL_BILD: Partial<Record<Platz, BildT[]>> = {
  gross: [foto('vanduul-incursion', 'rsi')],
  schiffe: [foto('rsi-galaxy', 'rsi', 'rsi-galaxy-flug'), foto('anvl-liberator')],
  auec: [foto('drak-ironclad')],
  radar: [foto('anvl-carrack', 'render')],
  salvage: [foto('aegs-reclaimer', 'render')],
};
const kacheln = I.kacheln.map((k, i) => {
  const [platz, ziel] = PLAETZE[i];
  if (k.ziel !== ziel) throw new Error(`KonzeptB: Kachel ${i} zeigt auf ${k.ziel}, erwartet ${ziel}`);
  return { ...k, platz, fotos: KACHEL_BILD[platz] ?? [] };
});
const KACHEL_SIZES: Record<Platz, string> = {
  gross: '(max-width: 760px) 100vw, 640px',
  schiffe: '(max-width: 760px) 50vw, 320px',
  auec: '(max-width: 760px) 50vw, 320px',
  radar: '(max-width: 760px) 50vw, 320px',
  salvage: '(max-width: 760px) 50vw, 320px',
  mauler: '', torpedo: '', bauplan: '',
};

const RUBRIK: Record<string, string> = {
  auftraege: T('Titelthema', 'Cover story'),
  schiffe: T('Neu im Hangar', 'New in the hangar'),
  auec: T('Kaufberatung', 'Buyer’s guide'),
  werte: T('Balance-Report', 'Balance report'),
  ausruestung: T('Ausrüstung', 'Gear'),
  iae: T('Expo', 'Expo'),
  bestand: T('Statistik', 'Statistics'),
};

const GRUPPEN_BILD: (BildT | 'mauler')[] = [foto('vncl-scythe'), 'mauler', foto('vncl-glaive'), foto('vanduul-incursion', 'szene')];
if (I.auftraege.gruppen.length !== GRUPPEN_BILD.length) throw new Error('KonzeptB: Auftragsgruppen und Bilder passen nicht zusammen');
const auftragsZahl = I.auftraege.gruppen.reduce((s, g) => s + g.auftraege.length, 0);
const GEGNER = ([['vncl-scythe', 'Scythe'], ['vncl-glaive', 'Glaive'], ['vncl-blade', 'Blade'], ['vncl-stinger', 'Stinger']] as const)
  .map(([id, name]) => ({ name, bild: foto(id, 'render'), h: `/schiffe/${id}.html` }));

const SCHIFF_FOTOS: Record<string, BildT[]> = {
  'rsi-galaxy': [foto('rsi-galaxy', 'rsi', 'rsi-galaxy'), foto('rsi-galaxy', 'rsi', 'rsi-galaxy-flug'), foto('rsi-galaxy', 'render'), foto('rsi-galaxy', 'holo', 'rsi-galaxy-hologramm')],
  'anvl-liberator': [foto('anvl-liberator'), foto('anvl-liberator', 'render'), foto('anvl-liberator', 'holo', 'anvl-liberator-holo'), foto('anvl-liberator', 'holo', 'anvl-liberator-hologramm')],
};
const schiffe = I.neueSchiffe.map((s) => {
  const fotos = SCHIFF_FOTOS[s.id];
  if (!fotos) throw new Error(`KonzeptB: keine Bilder fuer ${s.id}`);
  const balken = s.vergleich.werte.map((w) => {
    const a = zahlAus(w.dieses), b = zahlAus(w.jenes), max = Math.max(a, b) || 1;
    return { ...w, a: a / max, b: b / max };
  });
  return { ...s, fotos, balken };
});

const W = Object.fromEntries(I.werte.map((g) => [g.id, g]));
const WERTE_BILD: Record<string, BildT | 'mauler'> = { radar: foto('anvl-carrack', 'render'), salvage: foto('aegs-reclaimer', 'render'), kampf: 'mauler', vanguard: foto('aegs-vanguard', 'render') };
const SALVAGE_MAX = Math.max(...W.salvage.zeilen.map((r) => r.nachher.zahl ?? 0));

const K = Object.fromEntries(I.ausruestung.karten.map((k) => [k.id, k]));
const NAMEN_BILD = ['anvl-ballista', 'anvl-spartan', 'anvl-centurion'].map((id) => foto(id, 'render'));
const iae = { halle: foto('iae-2956', 'rsi', 'iae-2956-halle'), stadt: foto('iae-2956', 'rsi', 'iae-2956-stadt'), logo: foto('iae-2956', 'rsi', 'iae-2956-logo') };
const BESTAND_MAX = Math.max(...I.bestand.zeilen.map((z) => z.nachher - z.vorher));
const preiseVom = datum(I.auec.schiffe[0].preiseVom);
---
<SiteNav crumbs={de ? [{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Alpha 4.10.3' }] : [{ label: 'Archive', href: '/archiv.html' }, { label: 'Alpha 4.10.3' }]} />

<main id="main" class="mag">

  <header class="cover">
    <div class="wrap">
      <div class="mast">
        <span class="brand">VerseBase <b>{T('Patch-Magazin', 'Patch Magazine')}</b></span>
        <span class="issue">{T('Ausgabe', 'Issue')} {I.version} · {I.kopf.eyebrow}</span>
        <a class="notes" href={I.notes.h} target="_blank" rel="noopener">{I.notes.t}</a>
      </div>
      <div class="titel">
        <h1><span class="nr">{I.kopf.titel}</span><span class="cn">{I.kopf.codename[0]}<em>{I.kopf.codename[1]}</em></span></h1>
        <div class="titel__rechts">
          <p class="satz">{I.kopf.satz}</p>
          <nav aria-label={T('Abschnitte', 'Sections')}>
            <ul class="sprung">{I.abschnitte.map((a) => <li><a href={`#${a.id}`}>{a.t}</a></li>)}</ul>
          </nav>
        </div>
      </div>
      <section class="bento" aria-label={T('Auf einen Blick', 'At a glance')}>
        {kacheln.map((k, i) => (
          <article class={`t t--${k.platz} t--${k.art}`}>
            <div class="t__bild">
              {k.fotos.map((f) => <Bild bild={f} sizes={KACHEL_SIZES[k.platz]} eager />)}
              {k.platz === 'mauler' && <Mauler label={T('Zeichnung eines Vanduul-Maulers, der Energieschüsse abgibt', 'Drawing of a Vanduul Mauler firing energy bolts')} />}
              {k.platz === 'torpedo' && <Reichweite label={T('Torpedo vor Entfernungsringen, der äußere Ring markiert 700 m', 'Torpedo in front of range rings, the outer ring marks 700 m')} />}
              {k.platz === 'bauplan' && <Camo label={T('Muster der Tarnung Raider Camo', 'Raider Camo pattern')} />}
              {k.platz === 'bauplan' && <Skarnov class="t__gewehr" toene={['#2b3320', '#6e6244']} label={T('Skarnov-Gewehr in Raider Camo', 'Skarnov rifle in Raider Camo')} />}
            </div>
            <div class="t__txt">
              <span class="t__k">{k.k}{i === 0 && <span class="t__marke">{T('Titelthema', 'Cover story')}</span>}</span>
              <h2 class="t__v"><a href={`#${k.ziel}`}>{k.v}</a></h2>
              <p class="t__s">{k.s}</p>
              <span class="t__fuss">
                <span class="stand">{T('Stand', 'Data')} {k.stand}</span>
                {k.platz === 'schiffe'
                  ? I.neueSchiffe.map((s) => <a class="t__link" href={L(s.link.h)}>{s.name} →</a>)
                  : k.link && <a class="t__link" href={L(k.link.h)}>{k.link.t} →</a>}
              </span>
            </div>
          </article>
        ))}
      </section>
    </div>
  </header>

  <section class="sek dunkel" id="auftraege">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.auftraege}</span>
        <h2>{I.auftraege.titel}</h2>
        <ul class="fakten">
          <li><b>{auftragsZahl}</b>{T('Aufträge', 'contracts')}</li>
          <li><b>{I.auftraege.gruppen.length}</b>{T('Einsatzarten', 'mission types')}</li>
          <li><b>Nyx</b>{I.auftraege.auftraggeber}</li>
        </ul>
        <p class="lead"><Text text={I.auftraege.lead} /></p>
      </header>
      <div class="einsaetze">
        {I.auftraege.gruppen.map((g, i) => (
          <article class="einsatz">
            <figure class="einsatz__bild">
              {GRUPPEN_BILD[i] === 'mauler'
                ? <Mauler label={T('Zeichnung eines Vanduul-Maulers', 'Drawing of a Vanduul Mauler')} />
                : <Bild bild={GRUPPEN_BILD[i] as BildT} sizes="(max-width: 760px) 100vw, 620px" />}
              <figcaption>{g.typ}</figcaption>
            </figure>
            <div class="einsatz__txt">
              <h3>{g.titel}</h3>
              <p>{g.text}</p>
              <ol>
                {g.auftraege.map((a) => (
                  <li>
                    <a href={L(a.link.h)}>{a.titel}</a>
                    <span class="rang">{T('ab', 'from')} {a.rang}</span>
                    {a.bauplaene > 0 && <span class="chip">{a.bauplaene} {T('Baupläne', 'blueprints')}</span>}
                    {a.belohnung && <a class="chip chip--rot" href={L(a.belohnung.h)}>{a.belohnung.t}</a>}
                  </li>
                ))}
              </ol>
              <span class="stand">{T('Stand', 'Data')} {g.auftraege[0].stand}</span>
            </div>
          </article>
        ))}
      </div>
      <h3 class="zwischen">{T('Die Gegner', 'The enemy')}</h3>
      <ul class="galerie">
        {GEGNER.map((g) => (
          <li>
            <a href={L(g.h)}>
              <Bild bild={g.bild} sizes="(max-width: 760px) 50vw, 300px" />
              <span>Vanduul <b>{g.name}</b></span>
            </a>
          </li>
        ))}
        <li>
          <a href={L('/items/vanduul-mauler-striker-repeater.html')}>
            <Mauler label={T('Zeichnung eines Vanduul-Maulers', 'Drawing of a Vanduul Mauler')} />
            <span>Vanduul <b>Mauler</b></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="sek hell" id="schiffe">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.schiffe}</span>
        <h2>{T('Neue Schiffe', 'New ships')}</h2>
      </header>
      {schiffe.map((s, i) => (
        <article class={`spread${i % 2 ? ' spread--rechts' : ''}`}>
          <div class="spread__bilder">
            <figure class="spread__haupt"><Bild bild={s.fotos[0]} sizes="(max-width: 900px) 100vw, 720px" /></figure>
            <ul class="spread__strip">
              {s.fotos.slice(1).map((f) => <li><Bild bild={f} sizes="(max-width: 900px) 33vw, 240px" /></li>)}
            </ul>
          </div>
          <div class="spread__txt">
            <span class="rubrik">{s.hersteller}</span>
            <h3><a href={L(s.link.h)}>{s.name}</a></h3>
            <p>{s.text}</p>
            <dl class="daten">
              {s.werte.map((w) => <div><dt>{w.k}</dt><dd><Text text={w.v} /></dd></div>)}
            </dl>
            {s.module.length > 0 && <ul class="chips">{s.module.map((m) => <li><a class="chip" href={L(m.h)}>{m.t}</a></li>)}</ul>}
            <div class="vergleich">
              <p class="vergleich__kopf">{T('Im Vergleich mit', 'Compared with')} <a href={L(s.vergleich.schiff.h)}>{s.vergleich.schiff.t}</a></p>
              <ul>
                {s.balken.map((b) => (
                  <li>
                    <span class="vergleich__k">{b.k}</span>
                    <span class="bar bar--a" style={`--w:${b.a}`}><i></i><em>{b.dieses}</em></span>
                    <span class="bar bar--b" style={`--w:${b.b}`}><i></i><em>{b.jenes}</em></span>
                  </li>
                ))}
              </ul>
              <p class="legende"><span class="dot dot--a"></span>{s.name} <span class="dot dot--b"></span>{s.vergleich.schiff.t} · <span class="stand">{T('Stand', 'Data')} {s.stand}</span></p>
            </div>
            <a class="mehr" href={L(s.link.h)}>{T('Zum Datenblatt', 'Full data sheet')} →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sek dunkel" id="auec">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.auec}</span>
        <h2>{I.auec.titel}</h2>
        <p class="lead"><Text text={I.auec.lead} /></p>
      </header>
      <ul class="laden">
        {I.auec.schiffe.map((s) => (
          <li class="ware">
            <a class="ware__bild" href={L(s.link.h)} tabindex="-1" aria-hidden="true"><Bild bild={s.bilder[0]} sizes="(max-width: 600px) 40vw, (max-width: 1100px) 50vw, 310px" /></a>
            <div class="ware__txt">
              <span class="ware__hersteller">{s.hersteller}</span>
              <h3><a href={L(s.link.h)}>{s.name}</a></h3>
              <dl>
                {s.angebote.map((o) => <div><dt><b>{o.haendler}</b>{o.ort}</dt><dd>{n(o.preis)}<small>aUEC</small></dd></div>)}
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="stand stand--zeile">{T('Preise Stand', 'Prices as of')} {I.auec.schiffe[0].stand} · {T('abgerufen am', 'retrieved')} {preiseVom}</p>
    </div>
  </section>

  <section class="sek hell" id="werte">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.werte}</span>
        <h2>{T('Geänderte Werte', 'Changed values')}</h2>
        <p class="kopf__meta"><span class="stand">4.10.2 → 4.10.3</span> <a href={I.notes.h} target="_blank" rel="noopener">{I.notes.t}</a></p>
      </header>
      <div class="tafeln">
        {I.werte.map((g) => (
          <section class="tafel" id={g.id}>
            <figure class="tafel__bild">
              {WERTE_BILD[g.id] === 'mauler'
                ? <Mauler label={T('Zeichnung eines Vanduul-Maulers', 'Drawing of a Vanduul Mauler')} />
                : <Bild bild={WERTE_BILD[g.id] as BildT} sizes="(max-width: 900px) 100vw, 620px" />}
              <figcaption><h3>{g.titel}</h3><span class={`tag${g.inNotes ? '' : ' tag--aus'}`}>{g.tag}</span></figcaption>
            </figure>
            <ul class="zeilen">
              {g.zeilen.map((z) => (
                <li>
                  <span class="zeile__was">
                    {z.schiffe.map((x, j) => <>{j > 0 && ' · '}<a href={L(x.h)}>{x.t}</a></>)}
                    {z.schiffe.length > 0 && z.was.length > 0 && <br />}
                    {z.was.length > 0 && <span class="zeile__wert"><Text text={z.was} /></span>}
                  </span>
                  <span class="zeile__ba">
                    {z.vorher ? <span class="vorher"><Text text={z.vorher.v} /></span> : <span class="vorher vorher--ohne">{z.schon ? T('schon', 'already') : T('neu', 'new')}</span>}
                    <span class="pfeil" aria-hidden="true">→</span>
                    <span class="nachher"><Text text={z.nachher.v} />{g.einheit && <small> {g.einheit}</small>}</span>
                    {z.delta != null && <span class="delta">{z.delta > 0 ? '+' : ''}{z.delta} %</span>}
                  </span>
                  {g.id === 'salvage' && <span class="zeile__bar" aria-hidden="true" style={`--a:${(z.vorher?.zahl ?? 0) / SALVAGE_MAX};--b:${(z.nachher.zahl ?? 0) / SALVAGE_MAX}`}><i></i><b></b></span>}
                </li>
              ))}
            </ul>
            <p class="notiz"><Text text={g.notiz} /></p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="sek dunkel" id="ausruestung">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.ausruestung}</span>
        <h2>{I.ausruestung.titel}</h2>
        <ul class="fakten"><li><b>+{I.ausruestung.bauplaeneNeu}</b>{T('Baupläne', 'blueprints')}</li></ul>
      </header>
      <div class="ausr">
        <article class="karte karte--breit">
          <div class="karte__kopf"><h3>{K.skarnov.titel}</h3><span class="tag">{K.skarnov.tag}</span></div>
          <ul class="gewehre">
            {I.ausruestung.skarnov.map((a) => (
              <li>
                <a href={L(a.link.h)}>
                  <Skarnov toene={a.toene} label={`Skarnov ${a.name}`} />
                  <span class="gewehr__name">{a.name}</span>
                </a>
                <span class="toene" aria-hidden="true">{a.toene.map((t) => <i style={`background:${t}`}></i>)}</span>
              </li>
            ))}
          </ul>
          <p><Text text={K.skarnov.text} /></p>
          <p class="karte__fuss"><a class="chip" href={L(K.skarnov.liste[1].v[0].h)}>{K.skarnov.liste[1].v[0].t}</a> <span class="stand">{T('Stand', 'Data')} {K.skarnov.stand}</span></p>
        </article>
        <article class="karte">
          <Camo class="karte__svg" label={T('Muster der Tarnung Raider Camo', 'Raider Camo pattern')} />
          <div class="karte__kopf"><h3>{K['raider-camo'].titel}</h3><span class="tag">{K['raider-camo'].tag}</span></div>
          <p><Text text={K['raider-camo'].text} /></p>
          <dl class="liste">
            {I.ausruestung.camo.map((c) => <div><dt>{c.k}</dt><dd>{c.v.map((x) => <a class="chip" href={L(x.h)}>{x.t}</a>)}</dd></div>)}
          </dl>
          <span class="stand">{T('Stand', 'Data')} {K['raider-camo'].stand}</span>
        </article>
        <article class="karte">
          <Komponente class="karte__svg" label={T('Zeichnung eines Schildgenerators Größe 4 und eines Radars Größe 3', 'Drawing of a size 4 shield generator and a size 3 radar')} />
          <div class="karte__kopf"><h3>{K.deterrent.titel}</h3><span class="tag">{K.deterrent.tag}</span></div>
          <p class="klein"><Text text={K.deterrent.text} /></p>
          <p class="karte__fuss">{K.deterrent.liste.map((z) => <a class="chip" href={L(z.v[0].h)}>{z.v[0].t}</a>)} <span class="stand">{T('Stand', 'Data')} {K.deterrent.stand}</span></p>
        </article>
        <article class="karte" id="namen">
          <ul class="karte__strip">{NAMEN_BILD.map((b) => <li><Bild bild={b} sizes="(max-width: 760px) 33vw, 140px" /></li>)}</ul>
          <div class="karte__kopf"><h3>{K.namen.titel}</h3><span class="tag">{K.namen.tag}</span></div>
          <p class="klein"><Text text={K.namen.text} /></p>
          <span class="stand">{T('Stand', 'Data')} {K.namen.stand}</span>
        </article>
      </div>
    </div>
  </section>

  <section class="sek hell" id="iae-2956">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.iae}</span>
        <h2>{K['iae-2956'].titel}</h2>
      </header>
      <div class="expo">
        <figure class="expo__gross"><Bild bild={iae.halle} sizes="(max-width: 900px) 100vw, 820px" /></figure>
        <figure class="expo__klein"><Bild bild={iae.stadt} sizes="(max-width: 900px) 50vw, 420px" /></figure>
        <figure class="expo__klein"><Bild bild={iae.logo} sizes="(max-width: 900px) 50vw, 420px" /></figure>
        <div class="expo__txt">
          <span class="tag">{K['iae-2956'].tag}</span>
          <p class="klein"><Text text={K['iae-2956'].text} /></p>
          <dl class="liste">
            {K['iae-2956'].liste.map((z) => <div><dt>{z.k}</dt><dd>{z.v.map((x) => <a class="chip" href={L(x.h)}>{x.t}</a>)}</dd></div>)}
          </dl>
          <span class="stand">{T('Stand', 'Data')} {K['iae-2956'].stand}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sek dunkel" id="bestand">
    <div class="wrap">
      <header class="kopf">
        <span class="rubrik">{RUBRIK.bestand}</span>
        <h2>{T('Bestand', 'Catalogue')}</h2>
        <p class="kopf__meta"><a href={L(I.vorgaenger.h)}>{I.vorgaenger.t}</a> → {I.version}</p>
      </header>
      <ul class="zaehler">
        {I.bestand.zeilen.map((z) => (
          <li>
            <a href={L(z.was.h)}>{z.was.t}</a>
            <b>+{n(z.nachher - z.vorher)}</b>
            <span class="zaehler__bar" aria-hidden="true" style={`--w:${(z.nachher - z.vorher) / BESTAND_MAX}`}><i></i></span>
            <span class="zaehler__ba">{n(z.vorher)} <small>{z.vorherStand}</small> → {n(z.nachher)} <small>{z.stand}</small></span>
          </li>
        ))}
      </ul>
      <div class="neuzugang">
        <ul>{schiffe.map((s) => <li><a href={L(s.link.h)}><Bild bild={foto(s.id, 'render')} sizes="(max-width: 760px) 45vw, 240px" /><span>{s.name}</span></a></li>)}</ul>
        <p class="klein"><Text text={I.bestand.notiz} /></p>
      </div>
    </div>
  </section>

  <section class="sek dunkel sek--akte">
    <details class="wrap akte" id="akte">
      <summary>
        <Bild class="akte__bild" bild={iae.logo} sizes="160px" />
        <span class="akte__t"><b>{I.dossier.titel}</b>{I.dossier.text}</span>
      </summary>
      <PatchDossier patch={patch} lang={lang} />
    </details>
  </section>

</main>

<footer class="mag-fuss">
  <nav class="pager" aria-label={T('Patch-Navigation', 'Patch navigation')}>
    <a href={L(I.vorgaenger.h)}><span>{T('← Älter', '← Older')}</span><b>{I.vorgaenger.titel}</b></a>
    <a href={de ? '/de/archiv.html' : '/archiv.html'}><span>{T('Archiv', 'Archive')}</span><b>{T('Alle Patches', 'All patches')}</b></a>
  </nav>
  <p class="disclaimer">{T('Inoffizielles Fan-Projekt. Star Citizen® © Cloud Imperium Rights LLC & Ltd., keine Verbindung zu CIG. Standbilder & Schiff-/System-Bilder aus offiziellen Quellen (© Cloud Imperium Games), Fan-Content-Nutzung. Renderbilder und Zeichnungen: VerseBase.', 'Unofficial fan project. Star Citizen® © Cloud Imperium Rights LLC & Ltd. No affiliation with CIG. Stills & ship/system imagery from official sources (© Cloud Imperium Games), fan-content usage. Renders and drawings: VerseBase.')}</p>
</footer>

<style>
  .mag, .mag-fuss {
    --ink: #0c0e13; --ink-2: #141821; --ink-3: #1d2230;
    --paper: #e4e7ec; --paper-2: #f6f7f9; --on-paper: #11141a; --on-paper-2: #4a5161;
    --rot: #e0563f; --rot-tief: #ad3823; --eis: #8fb8d8;
    --hell: #eef1f5; --grau: #a3abb8;
    --f-display: 'Teko', 'Rajdhani', sans-serif; --f-ui: 'Rajdhani', sans-serif; --f-body: 'Barlow', system-ui, sans-serif; --f-mono: 'Share Tech Mono', monospace;
    --wrap: 1280px; --gut: clamp(1rem, 4vw, 2.5rem);
    background: var(--ink); color: var(--hell); font-family: var(--f-body); line-height: 1.55;
  }
  :global(body) { background: #0c0e13; margin: 0; }
  .mag :global(a), .mag-fuss a { color: inherit; }
  .mag :global(:focus-visible), .mag-fuss :global(:focus-visible) { outline: 2px solid var(--eis); outline-offset: 3px; }
  .mag :global(picture) { display: block; height: 100%; }
  .mag :global(img) { display: block; width: 100%; height: auto; }
  .mag :global(svg) { display: block; width: 100%; height: 100%; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--gut); }
  [id] { scroll-margin-top: 5.5rem; }

  .stand { font-family: var(--f-mono); font-size: .68rem; letter-spacing: .04em; text-transform: uppercase; opacity: .75; }
  .chip { display: inline-block; font-family: var(--f-ui); font-weight: 600; font-size: .8rem; line-height: 1.2; padding: .22rem .55rem; border: 1px solid currentColor; border-radius: 2px; text-decoration: none; white-space: nowrap; }
  .chip:hover { background: var(--rot); border-color: var(--rot); color: #fff; }
  .chip--rot { border-color: var(--rot); color: var(--rot); }
  .tag { font-family: var(--f-ui); font-weight: 700; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; padding: .15rem .5rem; background: var(--rot); color: #fff; white-space: nowrap; }
  .tag--aus { background: transparent; color: inherit; border: 1px dashed currentColor; }
  .klein { font-size: .9rem; }

  /* ---------- Titelseite ---------- */
  .cover { padding: 6.3rem 0 2.2rem; background: radial-gradient(120% 70% at 80% 0, #1a1f2b, var(--ink) 60%); }
  .mast { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; align-items: baseline; border-bottom: 3px solid var(--rot); padding-bottom: .45rem; font-family: var(--f-ui); font-weight: 600; font-size: .82rem; letter-spacing: .14em; text-transform: uppercase; color: var(--grau); }
  .brand { color: var(--hell); }
  .brand b { color: var(--rot); }
  .notes { margin-left: auto; text-decoration: none; color: var(--eis); }
  .titel { display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: end; padding: .8rem 0 1rem; }
  .titel h1 { margin: 0; display: flex; flex-direction: column; font-family: var(--f-display); font-weight: 600; line-height: .8; }
  .nr { font-size: clamp(5rem, 10vw, 7rem); letter-spacing: -.01em; color: var(--hell); }
  .cn { font-family: var(--f-ui); font-weight: 700; font-size: clamp(1rem, 1.9vw, 1.35rem); letter-spacing: .08em; text-transform: uppercase; line-height: 1.1; margin-top: .45rem; color: var(--grau); }
  .cn em { font-style: normal; color: var(--rot); }
  .titel__rechts { max-width: 40rem; justify-self: end; }
  .satz { margin: 0 0 .8rem; font-size: 1.12rem; line-height: 1.4; }
  .sprung { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }
  .sprung a { display: inline-block; font-family: var(--f-ui); font-weight: 600; font-size: .82rem; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; padding: .25rem .6rem; background: var(--ink-3); border-radius: 2px; }
  .sprung a:hover { background: var(--rot); color: #fff; }

  .bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 180px); gap: 10px; grid-template-areas: "gross gross schiffe schiffe" "gross gross auec mauler" "radar salvage torpedo bauplan"; }
  .t { position: relative; overflow: hidden; background: var(--ink-3); isolation: isolate; }
  .t--gross { grid-area: gross; } .t--schiffe { grid-area: schiffe; } .t--auec { grid-area: auec; } .t--mauler { grid-area: mauler; }
  .t--radar { grid-area: radar; } .t--salvage { grid-area: salvage; } .t--torpedo { grid-area: torpedo; } .t--bauplan { grid-area: bauplan; }
  .t__bild { position: absolute; inset: 0; z-index: -1; display: flex; }
  .t__bild > :global(picture) { flex: 1; min-width: 0; }
  .t__bild :global(img) { height: 100%; object-fit: cover; transition: transform .5s ease; }
  .t--schiffe .t__bild { gap: 2px; }
  .t__bild::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 10, 14, 0) 30%, rgba(8, 10, 14, .88) 100%); }
  .t--gross .t__bild::after { background: linear-gradient(180deg, rgba(8, 10, 14, 0) 35%, rgba(8, 10, 14, .92) 100%); }
  .t--bauplan .t__bild { position: absolute; }
  .t--bauplan :global(.t__gewehr) { position: absolute; left: 6%; top: 8%; width: 88%; height: auto; filter: drop-shadow(0 0 1px #efe6c8) drop-shadow(0 0 1px #efe6c8) drop-shadow(0 8px 10px rgba(0, 0, 0, .6)); }
  .t__txt { position: absolute; inset: auto 0 0 0; padding: .7rem .85rem .75rem; display: flex; flex-direction: column; gap: .1rem; }
  .t__k { font-family: var(--f-ui); font-weight: 700; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--eis); display: flex; gap: .5rem; align-items: center; }
  .t--changed .t__k { color: #ffc7b8; }
  .t__marke { background: var(--rot); color: #fff; padding: .05rem .4rem; letter-spacing: .1em; }
  .t__v { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 2.15rem; line-height: .95; }
  .t__v a { text-decoration: none; }
  .t__v a::after { content: ""; position: absolute; inset: 0; z-index: 0; }
  .t--gross .t__v { font-size: clamp(2.6rem, 5vw, 4.4rem); }
  .t--gross .t__txt { padding: 1.3rem 1.4rem 1.2rem; }
  .t--gross .t__s { font-size: 1.05rem; max-width: 30rem; }
  .t__s { margin: 0; font-size: .85rem; line-height: 1.3; color: #d5dae2; }
  .t__fuss { display: flex; flex-wrap: wrap; gap: .3rem .8rem; align-items: baseline; margin-top: .3rem; }
  .t__link { position: relative; z-index: 1; font-family: var(--f-ui); font-weight: 700; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--eis); text-decoration: none; }
  .t__link:hover { text-decoration: underline; }
  .t:hover .t__bild :global(img) { transform: scale(1.04); }
  .t:has(.t__v a:focus-visible) { outline: 2px solid var(--eis); }

  /* ---------- Abschnitte ---------- */
  .sek { padding: clamp(3rem, 7vw, 5.5rem) 0; }
  .hell { background: var(--paper); color: var(--on-paper); }
  .hell .stand { color: var(--on-paper-2); opacity: 1; }
  .kopf { display: grid; grid-template-columns: 1fr auto; gap: .2rem 2rem; align-items: end; margin-bottom: 2rem; border-top: 1px solid currentColor; padding-top: .7rem; }
  .rubrik { grid-column: 1 / -1; font-family: var(--f-ui); font-weight: 700; font-size: .8rem; letter-spacing: .18em; text-transform: uppercase; color: var(--rot); }
  .hell .rubrik { color: var(--rot-tief); }
  .kopf h2 { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: .9; }
  .kopf .lead { grid-column: 1 / -1; max-width: 46rem; margin: .8rem 0 0; font-size: 1.08rem; }
  .kopf__meta { margin: 0; display: flex; gap: 1rem; align-items: baseline; font-family: var(--f-ui); font-weight: 600; }
  .kopf__meta a { color: var(--rot-tief); }
  .dunkel .kopf__meta a { color: var(--eis); }
  .fakten { list-style: none; display: flex; gap: 1.6rem; margin: 0; padding: 0; }
  .fakten li { display: flex; flex-direction: column; font-family: var(--f-ui); font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--grau); }
  .fakten b { font-family: var(--f-display); font-weight: 600; font-size: 2.6rem; line-height: .9; letter-spacing: 0; color: var(--hell); }
  .zwischen { font-family: var(--f-ui); font-weight: 700; font-size: .85rem; letter-spacing: .18em; text-transform: uppercase; margin: 3rem 0 1rem; padding-bottom: .4rem; border-bottom: 1px solid rgba(238, 241, 245, .2); }

  /* Auftraege */
  .einsaetze { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
  .einsatz { background: var(--ink-2); display: flex; flex-direction: column; }
  .einsatz__bild { position: relative; margin: 0; aspect-ratio: 16 / 7; overflow: hidden; }
  .einsatz__bild :global(img) { height: 100%; object-fit: cover; }
  .einsatz__bild figcaption { position: absolute; left: 0; bottom: 0; background: var(--rot); color: #fff; font-family: var(--f-ui); font-weight: 700; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; padding: .25rem .7rem; }
  .einsatz__txt { padding: 1rem 1.2rem 1.2rem; display: flex; flex-direction: column; gap: .5rem; flex: 1; }
  .einsatz h3 { margin: 0; font-family: var(--f-display); font-weight: 500; font-size: 1.9rem; line-height: 1; }
  .einsatz p { margin: 0; color: var(--grau); font-size: .92rem; }
  .einsatz ol { list-style: none; margin: .2rem 0 .2rem; padding: 0; display: flex; flex-direction: column; }
  .einsatz li { display: flex; flex-wrap: wrap; gap: .25rem .6rem; align-items: center; padding: .45rem 0; border-top: 1px solid rgba(238, 241, 245, .1); }
  .einsatz li > a:first-child { font-weight: 600; text-decoration: none; margin-right: auto; }
  .einsatz li > a:first-child:hover { color: var(--eis); text-decoration: underline; }
  .rang { font-family: var(--f-mono); font-size: .72rem; color: var(--grau); }
  .einsatz .stand { margin-top: auto; }
  .galerie { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .galerie a { display: block; position: relative; text-decoration: none; background: var(--ink-3); }
  .galerie :global(img), .galerie :global(svg) { aspect-ratio: 16 / 10; height: auto; object-fit: cover; }
  .galerie span { display: block; padding: .4rem .6rem; font-family: var(--f-ui); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--grau); }
  .galerie b { color: var(--hell); font-size: 1rem; letter-spacing: .04em; }
  .galerie a:hover b { color: var(--eis); }

  /* Neue Schiffe */
  .spread { display: grid; grid-template-columns: 7fr 5fr; gap: 2.4rem; align-items: start; }
  .spread + .spread { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid rgba(17, 20, 26, .2); }
  .spread--rechts .spread__bilder { order: 2; }
  .spread__haupt { margin: 0; aspect-ratio: 16 / 8; overflow: hidden; background: var(--ink); }
  .spread__haupt :global(img) { height: 100%; object-fit: cover; }
  .spread__strip { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .spread__strip li { aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink); }
  .spread__strip :global(img) { height: 100%; object-fit: cover; }
  .spread__txt h3 { margin: .1rem 0 .4rem; font-family: var(--f-display); font-weight: 600; font-size: clamp(3rem, 6vw, 4.8rem); line-height: .85; }
  .spread__txt h3 a { text-decoration: none; }
  .spread__txt h3 a:hover { color: var(--rot-tief); }
  .spread__txt > p { margin: 0 0 1rem; font-size: .95rem; color: var(--on-paper-2); }
  .daten { margin: 0 0 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(17, 20, 26, .15); border: 1px solid rgba(17, 20, 26, .15); }
  .daten div { background: var(--paper-2); padding: .45rem .65rem; }
  .daten dt { font-family: var(--f-ui); font-weight: 700; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--on-paper-2); }
  .daten dd { margin: 0; font-weight: 600; font-size: .92rem; }
  .daten dd :global(a) { color: var(--rot-tief); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0 0 1rem; padding: 0; }
  .vergleich { background: var(--paper-2); padding: .8rem .9rem; margin-bottom: 1rem; }
  .vergleich__kopf { margin: 0 0 .5rem; font-family: var(--f-ui); font-weight: 700; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--on-paper-2); }
  .vergleich__kopf a { color: var(--on-paper); }
  .vergleich ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .vergleich li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 2px .6rem; align-items: center; }
  .vergleich__k { grid-row: span 2; font-size: .8rem; font-weight: 600; }
  .bar { position: relative; display: flex; align-items: center; height: 15px; }
  .bar i { display: block; height: 100%; width: calc(var(--w) * 70%); min-width: 2px; }
  .bar em { font-style: normal; font-family: var(--f-mono); font-size: .68rem; margin-left: .4rem; white-space: nowrap; }
  .bar--a i { background: var(--rot-tief); }
  .bar--b i { background: #9aa3b2; }
  .legende { margin: .6rem 0 0; font-size: .78rem; display: flex; flex-wrap: wrap; align-items: center; gap: .3rem; }
  .dot { width: .7rem; height: .7rem; display: inline-block; }
  .dot--a { background: var(--rot-tief); } .dot--b { background: #9aa3b2; margin-left: .5rem; }
  .mehr { font-family: var(--f-ui); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--rot-tief); }

  /* aUEC */
  .laden { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .ware { background: var(--ink-2); display: flex; flex-direction: column; }
  .ware__bild { display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .ware__bild :global(img) { height: 100%; object-fit: cover; transition: transform .4s ease; }
  .ware:hover .ware__bild :global(img) { transform: scale(1.04); }
  .ware__txt { padding: .7rem .85rem .85rem; }
  .ware__hersteller { font-family: var(--f-ui); font-weight: 600; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--grau); }
  .ware h3 { margin: 0 0 .4rem; font-family: var(--f-display); font-weight: 500; font-size: 1.9rem; line-height: 1; }
  .ware h3 a { text-decoration: none; }
  .ware h3 a:hover { color: var(--eis); }
  .ware dl { margin: 0; }
  .ware dl div { display: flex; justify-content: space-between; gap: .6rem; align-items: baseline; padding: .35rem 0; border-top: 1px solid rgba(238, 241, 245, .1); }
  .ware dt { font-size: .76rem; color: var(--grau); line-height: 1.25; }
  .ware dt b { display: block; color: var(--hell); font-size: .84rem; }
  .ware dd { margin: 0; font-family: var(--f-display); font-weight: 500; font-size: 1.45rem; line-height: 1; white-space: nowrap; color: var(--eis); }
  .ware dd small { font-family: var(--f-ui); font-size: .7rem; margin-left: .2rem; color: var(--grau); }
  .stand--zeile { margin: 1rem 0 0; }

  /* Werte */
  .tafeln { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; align-items: start; }
  .tafel { background: var(--paper-2); }
  .tafel__bild { position: relative; margin: 0; aspect-ratio: 16 / 6; overflow: hidden; background: var(--ink); }
  .tafel__bild :global(img) { height: 100%; object-fit: cover; }
  .tafel__bild figcaption { position: absolute; inset: auto 0 0 0; display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding: .6rem .9rem; background: linear-gradient(180deg, transparent, rgba(8, 10, 14, .85)); color: var(--hell); }
  .tafel__bild h3 { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 2rem; line-height: .9; }
  .tafel .tag--aus { color: var(--hell); }
  .zeilen { list-style: none; margin: 0; padding: .3rem .9rem; }
  .zeilen li { display: grid; grid-template-columns: 1fr auto; gap: .2rem 1rem; align-items: center; padding: .55rem 0; border-bottom: 1px solid rgba(17, 20, 26, .12); }
  .zeile__was { font-weight: 600; font-size: .9rem; }
  .zeile__was a { color: var(--on-paper); }
  .zeile__wert { font-weight: 400; color: var(--on-paper-2); font-size: .84rem; }
  .zeile__wert :global(a) { color: var(--on-paper-2); }
  .zeile__ba { display: flex; align-items: baseline; gap: .4rem; justify-content: end; flex-wrap: wrap; text-align: right; }
  .vorher { color: var(--on-paper-2); text-decoration: line-through; text-decoration-thickness: 1px; font-size: .88rem; }
  .vorher :global(a) { color: inherit; }
  .vorher--ohne { text-decoration: none; font-family: var(--f-mono); font-size: .72rem; text-transform: uppercase; }
  .pfeil { color: var(--rot-tief); }
  .nachher { font-family: var(--f-display); font-weight: 600; font-size: 1.5rem; line-height: 1; }
  .nachher :global(a) { color: var(--on-paper); }
  .nachher small { font-family: var(--f-ui); font-size: .75rem; }
  .delta { font-family: var(--f-mono); font-size: .72rem; background: var(--on-paper); color: var(--paper-2); padding: .1rem .35rem; }
  .zeile__bar { grid-column: 1 / -1; position: relative; height: 8px; background: rgba(17, 20, 26, .08); }
  .zeile__bar b, .zeile__bar i { position: absolute; left: 0; top: 0; bottom: 0; }
  .zeile__bar b { width: calc(var(--b) * 100%); background: var(--rot-tief); }
  .zeile__bar i { width: calc(var(--a) * 100%); background: var(--on-paper); z-index: 1; }
  .notiz { margin: 0; padding: .7rem .9rem 1rem; font-size: .86rem; color: var(--on-paper-2); }
  .notiz :global(a) { color: var(--rot-tief); }

  /* Ausruestung */
  .ausr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .karte { background: var(--ink-2); padding: 0 0 1rem; display: flex; flex-direction: column; gap: .6rem; }
  .karte > :not(svg):not(ul.karte__strip) { margin-left: 1rem; margin-right: 1rem; }
  .karte--breit { grid-column: 1 / -1; padding-top: 1rem; }
  .karte__kopf { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .karte h3 { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 2rem; line-height: 1; }
  .karte p { margin: 0; color: #cfd5de; }
