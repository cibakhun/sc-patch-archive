---
// Ctrl+K search — an in-universe terminal prompt over the whole archive.
// Rendered once per page via SiteNav.
//
// Logik und Aussehen liegen seit dem 06.11.2026 in assets/search-overlay.js
// und assets/search-overlay.css, weil die schlanken Datenseiten (DataShell)
// dieselbe Suche als nachgeladene Datei bekommen. Hier wird beides wie zuvor
// ausgeliefert: das Skript INLINE an derselben Stelle (gleiche Reihenfolge der
// Tasten-Lauscher), das CSS gebuendelt wie vorher der <style is:global>-Block.
//
// i18n: Chrome kommt aus t(); Index-Adressen, Leer-Zustand und Art-Labels
// stehen als data-Attribute am Overlay (src/lib/searchUi.ts, eine Quelle fuer
// beide Huellen).
import '../../assets/search-overlay.css';
import OVERLAY_JS from '../../assets/search-overlay.js?raw';
import { useTranslations, assertLocale, type Locale } from '../i18n/ui';
import { searchRootData } from '../lib/searchUi';
interface Props {
  lang: Locale;
}
// Sprache ohne Vorgabe (assertLocale, Anlass in src/i18n/ui.ts).
const lang = assertLocale(Astro.props.lang, 'SearchOverlay');
const t = useTranslations(lang);
const rootData = searchRootData(lang);
---
<div
  class="scs"
  id="scs"
  hidden
  {...rootData}
>
  <div class="scs__back" data-scs-close></div>
  <div class="scs__panel" role="dialog" aria-modal="true" aria-label={t('search.dialog')}>
    <div class="scs__bar">
      <span class="scs__prompt" aria-hidden="true">›</span>
      <input
        id="scs-in"
        type="search"
        placeholder={t('search.placeholder')}
        autocomplete="off"
        spellcheck="false"
        aria-label={t('search.term')}
      />
      <span class="scs__sys" aria-hidden="true" set:html={t('search.sys')}></span>
      <button class="scs__x" data-scs-close aria-label={t('search.close')}>Esc</button>
    </div>
    <ul class="scs__list" id="scs-list" role="listbox" aria-label={t('search.results')}></ul>
    <div class="scs__foot">
      <span><kbd>↑↓</kbd> {t('search.pick')}</span>
      <span><kbd>↵</kbd> {t('search.open')}</span>
      <span><kbd>Esc</kbd> {t('search.dismiss')}</span>
    </div>
  </div>
</div>
<script is:inline set:html={OVERLAY_JS}></script>
