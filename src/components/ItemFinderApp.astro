---
// Universal Item Finder — durchsuchbarer Katalog aller Items mit verifizierten
// Bezugsquellen (Shop-Snapshot, Loot-Recherche, UEX-Fahrzeugpreise). Ohne Quelle
// wird ein Item ehrlich als Katalog-Eintrag gezeigt — keine erfundenen Werte.
// Daten: assets/universal-items.json (scripts/build-universal-db.mjs).
//
// Jede Karte traegt einen echten <a> auf /items/<id>.html (die statische
// Detailseite) als „stretched link". Ein normaler Linksklick oeffnet weiterhin
// das Modal — Strg/Cmd/Mittelklick und Crawler folgen dem href. Ohne diese Links
// haengen die Detailseiten nur an der Sitemap und bekommen kein internes Gewicht.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { ICON_BLUEPRINT } from '../lib/icons';
import { ITEM_UI } from '../i18n/itemText';

interface Props { lang?: 'de' | 'en' }
const { lang = 'en' } = Astro.props;

// Cache-Bust per Content-Hash (sha1) — MUSS sein, und zwar fuer BEIDE Dateien:
// /assets/* wird mit `max-age=86400` ausgeliefert. Ohne ?v= bekommt ein
// wiederkehrender Besucher bis zu 24 h das ALTE Skript gegen das NEUE HTML —
// neue Funktionen sind dann schlicht unsichtbar. Genauso die Datendatei: ein
// gecachtes universal-items.json ohne `sets` laesst die Set-Ansicht auch mit
// frischem Skript nicht erscheinen. Live nach dem Set-Deploy genau so passiert.
const ver = (f: string) => {
  try { return createHash('sha1').update(readFileSync(f)).digest('hex').slice(0, 8); } catch { return 'x'; }
};
const appJs = `/assets/item-finder-app.js?v=${ver('assets/item-finder-app.js')}`;
const dbUrl = `/assets/universal-items.json?v=${ver('assets/universal-items.json')}`;
const craftUrl = `/assets/crafting-db.json?v=${ver('assets/crafting-db.json')}`;

const t = {
  de: {
    searchPlaceholder: 'Item, Waffe, Schiff, Fundort suchen…',
    hAvailability: 'Fundart', hCategories: 'Kategorien', hSize: 'Größe',
    hWeight: 'Panzerungsklasse', hRarity: 'Seltenheit',
    loading: 'Datenbank wird geladen…',
    sortNameAsc: 'Name (A–Z)', sortNameDesc: 'Name (Z–A)',
    sortPriceAsc: 'Preis (aufsteigend)', sortPriceDesc: 'Preis (absteigend)',
    sortStat: 'Wert (hoch→niedrig)',
    modalClose: 'Schließen',
  },
  en: {
    searchPlaceholder: 'Search item, weapon, ship, location…',
    hAvailability: 'Availability', hCategories: 'Categories', hSize: 'Size',
    hWeight: 'Armor class', hRarity: 'Rarity',
    loading: 'Loading database…',
    sortNameAsc: 'Name (A–Z)', sortNameDesc: 'Name (Z–A)',
    sortPriceAsc: 'Price (low–high)', sortPriceDesc: 'Price (high–low)',
    sortStat: 'Value (high–low)',
    modalClose: 'Close',
  },
}[lang];

// Strings, die das Client-JS braucht (window.__UIF.t). Der Katalog liegt in
// i18n/itemText.ts, weil die statischen Item-Seiten DIESELBEN Labels rendern —
// zwei Kopien wuerden zwangslaeufig auseinanderlaufen.
const JS_T = ITEM_UI[lang];
---

<div class="uif-container" id="uif-app">
  <div class="uif-sidebar">
    <div class="uif-search">
      <input type="text" id="uif-search-input" placeholder={t.searchPlaceholder} autocomplete="off" />
    </div>

    <div class="uif-filters">
      <h3>{t.hAvailability}</h3>
      <div id="uif-kind-chips" class="uif-chips"><!-- Chips via JS --></div>
      <h3>{t.hSize}</h3>
      <div id="uif-size-chips" class="uif-chips"><!-- Größen via JS --></div>
      <h3>{t.hWeight}</h3>
      <div id="uif-weight-chips" class="uif-chips"><!-- Panzerungsklassen via JS --></div>
      <h3>{t.hRarity}</h3>
      <div id="uif-rarity-chips" class="uif-chips"><!-- Seltenheiten via JS --></div>
      <h3>{t.hCategories}</h3>
      <div id="uif-category-list"><!-- Kategorien via JS --></div>
    </div>
  </div>

  <div class="uif-main">
    <div class="uif-header">
      <div class="uif-stats" id="uif-stats-count">{t.loading}</div>
      {/* Einzelteile <-> Sets. Nur die Ruestungs-Daten kennen Sets, deshalb
          blendet das JS den Schalter aus, sobald die aktuellen Filter kein
          einziges Set uebrig lassen. */}
      <div class="uif-view" id="uif-view-toggle" role="group" aria-label="Ansicht"><!-- via JS --></div>
      <div class="uif-sort">
        <select id="uif-sort-select" aria-label="Sort">
          <option value="name_asc">{t.sortNameAsc}</option>
          <option value="name_desc">{t.sortNameDesc}</option>
          <option value="stat_desc">{t.sortStat}</option>
          <option value="price_asc">{t.sortPriceAsc}</option>
          <option value="price_desc">{t.sortPriceDesc}</option>
        </select>
      </div>
    </div>

    <div class="uif-results" id="uif-results-grid"><!-- Items via JS --></div>

    <div class="uif-pagination" id="uif-pagination-container"><!-- Pagination via JS --></div>
  </div>
</div>

<div class="uif-modal-overlay" id="uif-item-modal" style="display: none;" role="dialog" aria-modal="true">
  <div class="uif-modal-container">
    <button class="uif-modal-close" id="uif-modal-close-btn" aria-label={t.modalClose}>&times;</button>
    <div class="uif-modal-body" id="uif-modal-body-content"><!-- Details via JS --></div>
  </div>
</div>

<style is:global>
  /* Universal Item Finder — nutzt die Seiten-Palette (--surface/--accent/--muted/--line),
     definiert bewusst KEINE :root-Variablen. */
  .uif-container {
    display: flex;
    max-width: var(--maxw, 1240px);
    margin: 0 auto;
    padding: 2rem 1rem;
    gap: 2rem;
    align-items: flex-start;
    /* Die Seiten-Navigation (.snav) ist fixed, immer sichtbar und ~67 px hoch.
       ALLES, was hier klebt, muss darunter anhalten — sonst verschwindet es
       hinter der Nav. Genau das passierte der Sidebar bisher: sie klebte bei
       2rem (36 px) und schob sich unter die Nav. Eine Zahl fuer beide. */
    --uif-stick: 4.6rem;
  }

  .uif-sidebar {
    width: 300px;
    flex-shrink: 0;background:var(--surface, var(--veil-2));
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    border-radius: 8px;
    padding: 1.5rem;
    position: sticky;
    top: var(--uif-stick);box-shadow:0 4px 12px var(--shadow-color);
  }

  .uif-search input {
    width: 100%;background:var(--veil);border:1px solid var(--line-soft, var(--line-soft));
    color: var(--text, #eef1f5);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .uif-search input:focus {
    outline: none;
    border-color: var(--accent, #ff5e1a);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent, #ff5e1a) 40%, transparent);
  }

  .uif-filters h3 {
    margin: 1.5rem 0 0.75rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent, #ff5e1a);
    border-bottom: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    padding-bottom: 0.5rem;
  }

  .uif-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .uif-chip {
    background: transparent;border:1px solid var(--line-soft, var(--line-soft));
    color: var(--muted, #9ba2ae);
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .uif-chip:hover {color:var(--text, var(--text)); border-color: var(--accent, #ff5e1a); }

  .uif-chip.active {
    background: var(--accent, #ff5e1a);
    border-color: var(--accent, #ff5e1a);color:var(--ink, var(--ink));
    font-weight: 700;
  }

  #uif-category-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .uif-category-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: 1px solid transparent;
    color: var(--muted, #9ba2ae);
    padding: 0.6rem 0.8rem;
    border-radius: 6px;
    text-align: left;
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .uif-category-btn:hover {background:var(--veil-hi);color:var(--text, var(--text));
  }

  .uif-category-btn.active {
    background: color-mix(in srgb, var(--accent, #ff5e1a) 12%, transparent);color:var(--text, var(--text));
    border: 1px solid var(--accent, #ff5e1a);
  }

  .uif-category-btn-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    /* Gehoert zur Null-Untergrenze des Rasters (s. u., 480 px): erst wenn
       der Text auch KUERZEN darf, kann die Spur wirklich schrumpfen —
       sonst schiebt er die Schaltflaeche wieder auf. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .uif-category-count {
    font-size: 0.8rem;background:var(--veil-hi);
    padding: 0.15rem 0.5rem;
    border-radius: 12px;
    color: var(--muted, #9ba2ae);
    flex-shrink: 0;
  }

  .uif-category-btn.active .uif-category-count {
    background: var(--accent, #ff5e1a);color:var(--ink, var(--ink));
  }

  .uif-main { flex-grow: 1; min-width: 0; }

  /* Bleibt beim Scrollen stehen: Trefferzahl, Ansichts-Umschalter und
     Sortierung gehoeren zu den Ergebnissen darunter — wer auf Seite 3 einer
     Trefferliste umschalten will, soll nicht erst nach oben scrollen muessen.
     z-index unter dem Modal (1000) und ueber den Karten. */
  .uif-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 0.85rem 0 1rem;
    border-bottom: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    position: sticky;
    top: var(--uif-stick);
    z-index: 20;
    background: var(--bg, #0d0c14);
    background: color-mix(in srgb, var(--bg, #0d0c14) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .uif-stats { color: var(--muted, #9ba2ae); font-size: 0.95rem; }

  .uif-sort select {background:var(--surface, var(--veil-2));color:var(--text, var(--text));
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .uif-sort select:focus { outline: none; border-color: var(--accent, #ff5e1a); }

  .uif-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
  }

  .uif-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--muted, #9ba2ae);
  }

  /* Karten */
  .uif-card {background:var(--surface, var(--veil-2));
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.25s, box-shadow 0.25s;
    cursor: pointer;box-shadow:0 4px 6px var(--shadow-color);
    position: relative;
    overflow: hidden;
  }

  /* Karten mit Detailseite sind <a> — Linkfarbe/Unterstreichung zurücksetzen,
     das Aussehen bleibt exakt wie bei den Karten ohne Seite. */
  a.uif-card { text-decoration: none; color: inherit; }

  .uif-card:hover,
  .uif-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent, #ff5e1a);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--accent, #ff5e1a) 15%, transparent);
    outline: none;
  }

  .uif-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .uif-card-cat-wrapper {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted, #9ba2ae);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-width: 0;
  }

  .uif-card-cat-wrapper span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .uif-card-title {
    margin: 0.5rem 0 1rem;color:var(--text, var(--text));
    font-size: 1.1rem;
    line-height: 1.4;
    font-weight: 600;
  }

  .uif-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;border-top:1px solid var(--line-soft, var(--line-soft));
    padding-top: 0.75rem;
    margin-top: auto;
  }

  .uif-card-price {
    color: var(--accent, #ff5e1a);
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  /* Fundort-Zeile: der Name darf kuerzen, die Zahl der weiteren Fundorte
     nicht. Vorher kuerzte die Box als Ganzes und schnitt damit genau das
     `+N` ab, das hinten steht (gemessen bei 375 px: x=409, also ausserhalb
     des Bildes). Jetzt traegt der Name die Kuerzung allein. */
  .uif-card-location {
    font-size: 0.8rem;
    color: var(--muted, #9ba2ae);
    min-width: 0;
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.3rem;
    text-align: right;
  }

  .uif-loc-name {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .uif-loc-more {
    color: var(--accent-2, var(--accent, #ff5e1a));
    font-weight: 700;
    flex: none;
  }

  .uif-loc-none { font-style: italic; opacity: 0.8; }

  .uif-icon { display: inline-block; vertical-align: middle; flex-shrink: 0; }

  /* Pagination */
  .uif-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .uif-page-btn {background:var(--surface, var(--veil-2));
    color: var(--muted, #9ba2ae);
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    padding: 0.5rem 0.85rem;
    border-radius: 6px;
    font-family: inherit;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    user-select: none;
  }

  .uif-page-btn:hover:not(:disabled) {color:var(--text, var(--text));
    border-color: var(--accent, #ff5e1a);
  }

  .uif-page-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .uif-page-info {
    color: var(--muted, #9ba2ae);
    font-size: 0.9rem;
    margin: 0 0.5rem;
    user-select: none;
  }

  /* Modal */
  .uif-modal-overlay {
    position: fixed;
    inset: 0;background:var(--veil-2);
    backdrop-filter: blur(6px);
    display: flex;
    justify-content: center;
    align-items: center;
    /* 1000 lag UNTER der festen Kopfleiste (.snav, z-index 9600): die
       Leiste samt Verlauf und Weichzeichner stand ueber dem Modal, und
       ein Tipp auf ihre obere Kante traf die Navigation statt des
       Dialogs. 9650 legt das Modal darueber — ueber die Leiste, aber
       unter nichts anderes: die Suche und das Menue teilen sich 9500 bis
       9600, und die duerfen ein Modal ueberdecken, weil sie es beim
       Oeffnen ohnehin ersetzen. */
    z-index: 9650;
    padding: 1.5rem;
    animation: uif-fade-in 0.2s ease-out;
  }

  @keyframes uif-fade-in { from { opacity: 0; } to { opacity: 1; } }

  .uif-modal-container {background:var(--surface, var(--veil-2));
    border: 1px solid var(--accent, #ff5e1a);
    box-shadow: 0 0 30px color-mix(in srgb, var(--accent, #ff5e1a) 25%, transparent);
    border-radius: 12px;
    width: 100%;
    max-width: 800px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    padding: 2rem;
    animation: uif-slide-up 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes uif-slide-up { from { transform: translateY(15px); } to { transform: translateY(0); } }

  .uif-modal-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    color: var(--muted, #9ba2ae);
    font-size: 1.75rem;
    cursor: pointer;
    transition: color 0.2s;
    line-height: 1;
  }

  .uif-modal-close:hover { color: var(--accent, #ff5e1a); }

  .uif-modal-header {
    border-bottom: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .uif-modal-title {
    margin: 0.25rem 0 0.5rem;color:var(--text, var(--text));
    font-size: 1.6rem;
    font-weight: 700;
  }

  .uif-modal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--muted, #9ba2ae);
    align-items: center;
  }

  .uif-modal-meta-item { display: flex; align-items: center; gap: 0.4rem; }

  .uif-modal-section { margin-bottom: 1.75rem; }

  .uif-modal-section h4 {
    color: var(--accent, #ff5e1a);
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;border-bottom:1px solid var(--line-soft, var(--line-soft));
    padding-bottom: 0.4rem;
  }

  .uif-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    border-radius: 6px;
  }

  .uif-locations-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .uif-locations-table th,
  .uif-locations-table td { padding: 0.75rem 1rem; }

  .uif-locations-table th {background:var(--surface-2, var(--veil-2));color:var(--text, var(--text));
    font-weight: 600;
    border-bottom: 1px solid var(--line, rgba(255, 94, 26, 0.22));
  }

  .uif-locations-table td {border-bottom:1px solid var(--line-soft);
    color: var(--muted, #9ba2ae);
  }

  .uif-locations-table tr:last-child td { border-bottom: none; }

  .uif-locations-table tr:hover td {background:var(--veil-hi);color:var(--text, var(--text));
  }

  .uif-td-kind { white-space: nowrap; }
  .uif-td-price { white-space: nowrap; font-weight: 700; color: var(--accent, #ff5e1a); }

  .uif-volatile-note,
  .uif-catalog-note {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--muted, #9ba2ae);
    line-height: 1.5;
  }

  .uif-guide-text {
    margin: 0;
    color: var(--text, #eef1f5);
    font-size: 0.95rem;
    line-height: 1.65;background:var(--veil-hi);border:1px solid var(--line-soft, var(--line-soft));
    border-left: 3px solid var(--accent, #ff5e1a);
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
  }

  /* Technische Daten (Spieldaten aus dem DataCore) */
  .uif-spec-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .uif-spec-chip {
    font-size: 0.82rem; color: var(--muted, #9ba2ae);
    background: var(--surface-2, var(--veil-2));
    border: 1px solid var(--line-soft, var(--line-soft));
    border-radius: 999px; padding: 0.3rem 0.75rem; white-space: nowrap;
  }
  .uif-spec-chip b { color: var(--text, #eef1f5); font-weight: 600; margin-right: 0.3rem; }
  .uif-stat-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem; margin-bottom: 1rem;
  }
  /* Varianten: mehrere Spiel-Items unter einem Anzeigenamen, je Größe ein Block */
  .uif-variants-note { margin: -0.35rem 0 0.9rem; font-size: 0.85rem; color: var(--muted, #9ba2ae); line-height: 1.5; }
  .uif-variant + .uif-variant { margin-top: 0.9rem; }
  .uif-variant-h {
    font-weight: 700; font-size: 0.82rem; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--accent-2, var(--accent, #ff5e1a)); margin-bottom: 0.5rem;
  }
  .uif-stat {
    display: flex; flex-direction: column; gap: 0.2rem;
    background: var(--veil-hi, var(--surface-2));
    border: 1px solid var(--line-soft, var(--line-soft));
    border-left: 3px solid var(--accent-2, var(--accent, #ff5e1a));
    border-radius: 6px; padding: 0.55rem 0.75rem;
  }
  .uif-stat-l { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted, #9ba2ae); }
  .uif-stat-v { font-size: 1.05rem; font-weight: 700; color: var(--text, #eef1f5); }
  .uif-item-desc { margin: 0; color: var(--muted, #9ba2ae); font-size: 0.92rem; line-height: 1.6; white-space: pre-line; }
  .uif-card-spec {
    font-size: 0.78rem; color: var(--muted, #9ba2ae); margin: -0.35rem 0 0.6rem;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .uif-card-stat {
    font-weight: 700; font-size: 0.8rem; white-space: nowrap; flex-shrink: 0; margin-left: 0.5rem;
    color: var(--accent-2, var(--accent, #ff5e1a));
    background: color-mix(in srgb, var(--accent-2, var(--accent, #ff5e1a)) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2, var(--accent, #ff5e1a)) 35%, transparent);
    border-radius: 999px; padding: 0.15rem 0.55rem;
  }

  .uif-crafting-header {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;background:var(--surface-2, var(--veil-2));
    padding: 1rem;
    border-radius: 6px;
    border: 1px solid var(--line, rgba(255, 94, 26, 0.22));
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .uif-crafting-ingredients h5 {
    font-size: 0.9rem;color:var(--text, var(--text));
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .uif-crafting-ingredients ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .uif-crafting-ingredients li {background:var(--veil-hi);border:1px solid var(--line-soft, var(--line-soft));
    padding: 0.6rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--muted, #9ba2ae);
  }

  .uif-crafting-ingredients li strong {color:var(--text, var(--text)); }

  /* Cross-Link ins Crafting (Deep-Link zum Blueprint) */
  .uif-xlink {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.9rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent, #2dd4ff);
    border: 1px solid color-mix(in srgb, var(--accent, #2dd4ff) 45%, transparent);
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .uif-xlink:hover {
    background: color-mix(in srgb, var(--accent, #2dd4ff) 12%, transparent);
    border-color: var(--accent, #2dd4ff);
  }
  /* Weg vom Schnellblick (Modal) zur verlinkbaren Detailseite */
  .uif-xlink--page { margin-top: 0.75rem; }

  /* Responsive */
  @media (max-width: 900px) {
    /* Die Nav ist auf schmalen Schirmen niedriger (~58 px) — Klebepunkt mit */
    .uif-container { flex-direction: column; padding: 1rem; --uif-stick: 4rem; }

    .uif-sidebar {
      width: 100%;
      position: static;
      box-shadow: none;
    }

    #uif-category-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.5rem;
    }

    .uif-category-btn { padding: 0.5rem; font-size: 0.85rem; }

    /* Mobil NICHT stapeln: als Spalte waere die klebende Leiste ~150 px hoch
       und fraesse den halben Bildschirm. Stattdessen umbrechende Zeile —
       Trefferzahl links, Umschalter und Sortierung rechts daneben. */
    .uif-header {
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding: 0.7rem 0 0.75rem;
    }

    /* Trefferzahl bekommt die erste Zeile, Umschalter und Sortierung teilen
       sich die zweite. Der Umschalter behaelt seine natuerliche Breite
       (flex:0 0 auto), die Sortierung nimmt den Rest — sonst waere jedes
       Element 100 % breit und die Leiste dreizeilig. */
    .uif-stats { flex: 1 1 100%; font-size: 0.86rem; }
    .uif-view { flex: 0 0 auto; }
    /* flex-basis MUSS 0 sein, nicht auto: mit `auto` fordert die Sortierung die
       intrinsische Breite ihres <select> (nach der laengsten Option „Preis
       (absteigend)") — Flexbox bricht dann UM, statt zu schrumpfen, und die
       Leiste bleibt dreizeilig. Mit Basis 0 nimmt sie schlicht den Rest. */
    .uif-sort { flex: 1 1 0; min-width: 0; }
    .uif-sort select { width: 100%; min-width: 0; padding: 0.4rem 0.7rem; }
    .uif-viewbtn { padding: 0.4rem 0.65rem; font-size: 0.76rem; }

    .uif-modal-container { padding: 1.25rem; }
  }

  /* --- Tag-Facetten: Seltenheit + Set ------------------------------------
     Die Seltenheitsfarben sind eine reine Lesehilfe (Spiel-Konvention grau →
     grün → blau → violett → gold). Sie stehen bewusst NICHT im Theme-Token-Satz:
     sie sollen in beiden Modi identisch bleiben, damit „Rare" nicht je nach
     Hell/Dunkel eine andere Farbe hat. */
  .uif-chip-n { opacity: .6; font-size: .74em; margin-left: .15rem; }
  .uif-card-tags { display: flex; gap: .35rem; margin: -0.2rem 0 .45rem; }
  .uif-rarity {
    font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: .1rem .45rem; border-radius: 3px; border: 1px solid currentColor;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  .uif-rarity--common { color: #9aa3b2; }
  .uif-rarity--uncommon { color: #4ec97a; }
  .uif-rarity--rare { color: #4aa3ff; }
  .uif-rarity--epic { color: #b07cff; }
  .uif-rarity--legendary { color: #f0a52e; }

  /* --- Set-Ansicht: Umschalter, Set-Karte, Set-Chip --- */
  .uif-view { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .uif-viewbtn {
    background: transparent; border: 0; color: var(--muted, #9ba2ae);
    font-family: inherit; font-size: 0.82rem; padding: 0.45rem 0.9rem; cursor: pointer;
  }
  .uif-viewbtn:hover { color: var(--text); }
  .uif-viewbtn.active { background: var(--accent, #ff5e1a); color: var(--ink); font-weight: 700; }

  .uif-setcard { cursor: pointer; }
  /* Eyebrow der Set-Karte: nur der Herstellername darf gekuerzt werden.
     Die Panzerungsklasse ist kurz und die eigentliche Aussage der Zeile —
     sie schrumpft nie. Der volle Herstellername steht im title-Attribut. */
  .uif-setcard-mfr { flex: 0 1 auto; min-width: 0; }
  .uif-setcard-weight { flex: 0 0 auto; }
  .uif-setcard-weight::before { content: '·'; margin-right: .35rem; opacity: .55; }
  .uif-setbadge {
    font-size: .68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
    padding: .1rem .45rem; border-radius: 3px; border: 1px solid currentColor;
    color: #d7a13a; white-space: nowrap; flex-shrink: 0;
  }
  .uif-setbadge.is-ok { color: #4ec97a; }

  /* „Stretched link": die ganze Karte ist klickbar, ohne den Titel-Link um die
     Karte zu wickeln. Nur so darf der Set-Chip ein echter <button> sein —
     interaktive Elemente ineinander sind ungueltiges HTML und eine
     Tastatur-/Screenreader-Falle. */
  .uif-card.is-linked { position: relative; }
  .uif-card-link { color: inherit; text-decoration: none; }
  .uif-card-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .uif-card-link:focus-visible { outline: 2px solid var(--accent, #ff5e1a); outline-offset: 2px; }
  .uif-card-tags { position: relative; z-index: 2; }

  .uif-setchip {
    font-family: inherit; font-size: .68rem; font-weight: 700; letter-spacing: .04em;
    padding: .1rem .45rem; border-radius: 3px; cursor: pointer;
    border: 1px solid var(--line); background: transparent; color: var(--accent, #ff5e1a);
  }
  .uif-setchip:hover { border-color: currentColor; background: color-mix(in srgb, currentColor 12%, transparent); }

  .uif-activeset {
    display: inline-flex; align-items: center; gap: .3rem; margin-left: .5rem;
    padding: .1rem .2rem .1rem .5rem; border-radius: 999px;
    border: 1px solid var(--accent, #ff5e1a); color: var(--accent, #ff5e1a);
    font-size: .8rem; font-weight: 700;
  }
  .uif-activeset button {
    background: transparent; border: 0; color: inherit; cursor: pointer;
    font-size: 1rem; line-height: 1; padding: 0 .35rem;
  }
  .uif-activeset button:hover { color: var(--text); }

  .uif-setbox h4 a { color: var(--accent, #ff5e1a); text-decoration: none; border-bottom: 1px solid var(--line); }
  .uif-setbox h4 a:hover { color: var(--accent-2, var(--accent)); border-color: currentColor; }
  .uif-set-meta { margin: 0 0 .6rem; font-size: .84rem; color: var(--muted, #9ba2ae); }
  .uif-set-links { display: flex; flex-wrap: wrap; gap: .35rem; }
  .uif-set-link {
    font-size: .78rem; padding: .2rem .5rem; border-radius: 3px;
    border: 1px solid var(--line-soft); color: var(--muted, #9ba2ae); text-decoration: none;
  }
  a.uif-set-link:hover { color: var(--text); border-color: var(--accent, #ff5e1a); }

  @media (max-width: 480px) {
    /* minmax(0, 1fr), NICHT 1fr: `1fr` ist die Kurzform von
       `minmax(auto, 1fr)` — die Untergrenze ist damit die MIN-CONTENT-Breite
       der Schaltflaeche. Der laengste Eintrag ("Tools & consumables (344)")
       zwang die Spuren so auf 183 + 189 px in einem 283 px breiten
       Behaelter; die rechte Spalte reichte bis x=428 bei 375 px Viewport
       und wurde von html{overflow-x:clip} einfach abgeschnitten. Mit der
       Null-Untergrenze duerfen die Spuren schrumpfen. */
    #uif-category-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .uif-modal-title { font-size: 1.3rem; }
  }
</style>

