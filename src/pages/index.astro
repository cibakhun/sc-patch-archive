---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import { getCollection } from 'astro:content';
import { mergePatchEn } from '../i18n/patchText';

const patches = (await getCollection('patches')).sort((a, b) => a.data.date.localeCompare(b.data.date)).map((p) => ({ ...p, data: mergePatchEn(p.id, p.data, 'en') }));

const latest = patches[patches.length - 1];
const first = patches[0];

// Hero still image: cinematic wide render (ship, station, planet)
const HERO_IMG = '/assets/t-polaris-5.jpg';

// Tools as image tiles (bento). No text ballast, no number soup — each tile
// just a name + short label, the image carries the visual weight.
// Das Patch-Archiv ist die Leitkachel (xl) — Bild aus dem Ära-Anfang (4.0),
// damit es sich von der „Latest"-Karte (aktueller Patch) unterscheidet.
const tools = [
  { name: 'Patch Archive', href: '/archiv.html', sub: `${patches.length} patches · Alpha ${first.data.version} → ${latest.data.version}`, img: '/assets/trailer-4-0-0.jpg', size: 'xl' },
  { name: 'Ships', href: '/schiffe.html', sub: 'Data sheets & specs', img: '/assets/t-perseus-1.jpg', size: 'w' },
  { name: 'Missions', href: '/missionen.html', sub: 'Rewards & reputation', img: '/assets/t-tsg-4.jpg', size: 'w' },
  { name: 'Mining', href: '/topics/mining.html', sub: 'Minerals & calculators', img: '/assets/t-align-1.jpg', size: 't' },
  { name: 'Refinery', href: '/refinery.html', sub: 'Track your haul', img: '/assets/img-refinery.jpg', size: 't' },
  { name: 'Crafting', href: '/topics/crafting.html', sub: 'Blueprints & planner', img: '/assets/t-craft-1.jpg', size: 't' },
  { name: "Wikelo's Emporium", href: '/topics/wikelo-emporium.html', sub: 'Banu trades', img: '/assets/img-railen.jpg', size: 't' },
  { name: 'Item Finder', href: '/item-finder.html', sub: 'Prices & locations', img: '/assets/cz-loot.jpg', size: 't' },
  { name: 'Evolution', href: '/evolution.html', sub: 'Systems × patches', img: '/assets/t-mesh-1.jpg', size: 't' },
];
---
<Layout title={"VerseBase — the Star Citizen compendium"} description={"VerseBase — the unofficial Star Citizen compendium: item finder with prices & locations, mining tools, crafting database, Wikelo trades, ship database and the complete patch archive of the Alpha 4 era. Game-accurate, bilingual."} themeColor="#04060c" footer={true} translated={true}>
<style is:inline>
  :root{
    --bg:#04060c;--bg-2:#080d18;--surface:#0e1626;
    --accent:#2dd4ff;--text:#eef3fb;--muted:#8ea0be;
    --line:rgba(150,180,220,.14);--line-2:rgba(150,180,220,.26);
    --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;
    --maxw:1280px;
  }
  /* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
  :root[data-theme="light"]{--bg:#f4f7fe;--bg-2:#e8eef9;--surface:#fdfdff;--text:#1c1f25;--muted:#4d596c;--accent:#05657c;--ink:#ffffff;--accent-media:#2dd4ff;--line:rgba(43,125,148,.3);--line-2:rgba(43,125,148,.42)}





  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  ::selection{background:var(--accent);color:var(--ink)}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .skip{position:absolute;left:-999px;top:0;z-index:200;background:var(--accent);color:var(--ink);padding:.6rem 1rem;font-weight:700}
  .skip:focus{left:0}

  /* ========== HERO ========== */
  /* Mittig statt am Fuss: seit die Ueberschrift oben steht und die Lede weg
     ist, traegt .hero__inner nur noch das Suchfeld. Am unteren Rand sass es
     weit weg von der Wortmarke; auf der Bildmitte stehen beide auf einer
     Achse und das Motiv bleibt darunter frei.
     flex-start statt center, weil die Hoehe unten ueber die Innenkante
     gerechnet wird — siehe .hero__inner. */
  .hero{position:relative;min-height:94svh;display:flex;align-items:flex-start;overflow:hidden;isolation:isolate}
  .hero__img{position:absolute;inset:0;z-index:-2;background:var(--media-void) center right/cover no-repeat;
    background-image:var(--hero);transform:scale(1.06);animation:kenburns 34s ease-in-out infinite alternate}
  @keyframes kenburns{from{transform:scale(1.06)}to{transform:scale(1.15) translate3d(-1.5%,-1%,0)}}
  /* Der Schleier bleibt in beiden Modi dunkel — das Motiv ist dunkel und der
     Text darauf hell. Nur der untere Verlauf endet auf var(--bg) und blendet
     damit von selbst in die helle bzw. dunkle Seite über. */
  .hero__scrim{position:absolute;inset:0;z-index:-1;background:
    linear-gradient(90deg,var(--scrim-6) 0%,var(--scrim-4) 40%,var(--scrim-0) 78%,transparent 100%),
    linear-gradient(0deg,var(--bg) 1%,var(--scrim-2) 24%,transparent 58%)}
  /* Untere Innenkante deutlich höher als die ursprünglichen 3,5rem: darunter
     steht die vierstufige V-Marke (bis 71 px + Klickfläche). Als Mindestwert
     im clamp statt als Sonderfall im 520er-Umbruch — sonst kollidiert sie im
     Bereich 521–880 px mit dem Suchfeld. Enge Stelle ist vw≈1200, wo das
     clamp-Minimum greift, die Marke aber schon mitwächst. */
  /* Mittig, aber nie so hoch, dass es die Ueberschrift trifft.
     `calc(47svh - 38px)` ist die Mitte: der Hero misst 94svh, davon die
     Haelfte, minus die halbe Feldhoehe. Reines align-items:center hat genau
     das gemacht — und auf flachen Fenstern das Feld in die Ueberschrift
     geschoben (gemessen bei 1280x560: 10 px Ueberlappung).
     Die Untergrenze von 16rem haelt es unter der Ueberschrift, die im
     ungueltigsten Fall (breites Fenster, Schriftgrad am Anschlag) bei ~235 px
     endet. Auf normalen Hoehen gewinnt die Mitte, auf flachen die Grenze. */
  .hero__inner{position:relative;width:100%;max-width:var(--maxw);margin:0 auto;
    padding:max(16rem,calc(47svh - 38px)) clamp(1.25rem,5vw,3.5rem) clamp(4rem,9vh,6rem)}
  /* Kein Eyebrow mehr über dem H1: die getrackte Versalien-Kleinzeile direkt
     über einer übergroßen Überschrift ist der Standard-Hero jeder generierten
     SaaS-Seite. Der Inhalt ("Star Citizen compendium") stand ohnehin doppelt
     in der Lede darunter. Titel jetzt in Volltonfarbe statt Verlauf — der
     Verlauf drückte "VerseBase" auf 3,0:1 gegen das Hero-Foto. */
  /* ---- Wortmarke: oben mittig, wandert beim Scrollen in die Kopfleiste ----
     position:fixed, damit der Schriftzug die Kopfleiste (z-index 9600)
     überhaupt erreichen kann — ein Element im Fluss läge hinter deren
     Hintergrund und würde auf dem letzten Stück verschluckt.
     Bewegt wird ausschliesslich per transform/opacity. Die Zielwerte
     --dx/--dy/--s misst SiteNav.astro zur Laufzeit gegen den Schriftzug in
     der Leiste; --p ist der Fortschritt 0..1. Ohne JS bleibt --p bei 0: die
     Überschrift steht dann schlicht oben mittig — nichts ist kaputt, nur
     unbewegt. */
  /* Der Massstab laeuft der Fahrt voraus: die Ueberschrift ist bereits auf
     Leistengroesse geschrumpft, bevor sie die Kopfleiste erreicht. Sonst
     stuende sie in voller Groesse quer ueber deren Kante — halb auf dem
     dunklen Motiv, halb auf der Fuellung, und keine Schriftfarbe waere fuer
     beide Haelften richtig. */
  .hero__mark{position:fixed;top:clamp(5.25rem,11vh,7.5rem);left:0;right:0;z-index:9601;
    display:flex;justify-content:center;pointer-events:none;
    --ps:clamp(0,(var(--p,0) / .55),1);
    --pt:clamp(0,((var(--p,0) - .2) / .8),1);
    transform:translate3d(calc(var(--dx,0px)*var(--pt)),calc(var(--dy,0px)*var(--pt)),0)
              scale(calc(1 + (var(--s,1) - 1)*var(--ps)))}
  /* Overlays (Suche 9600, Menü 9500) müssen die wandernde Überschrift
     verdecken können. Die geteilte Scroll-Sperre ist die eine Stelle, die
     jedes Overlay durchläuft — siehe assets/scroll-lock.js. */
  :root.is-locked .hero__mark{visibility:hidden}
  .hero__mark h1{font-family:var(--font-display);font-weight:900;line-height:.92;margin:0;
    font-size:clamp(2.9rem,12vw,8.5rem);letter-spacing:-.02em;
    /* Die Schrift wechselt unterwegs die Unterlage: erst das dunkle
       Hero-Motiv (dort ist Weiss richtig, in BEIDEN Farbmodi — der Schleier
       bleibt dunkel), am Ende die Fuellung der Kopfleiste. Im Hellmodus ist
       die nahezu weiss; bliebe die Schrift weiss, verschwaende sie auf dem
       letzten Stueck. Die Farbe folgt deshalb der Unterlage.
       color ist eine reine Malen-Eigenschaft — kein Layout, kein Sprung. */
    color:color-mix(in srgb,var(--text) calc(clamp(0,((var(--p,0) - .5) / .22),1) * 100%),var(--title-hi));
    text-shadow:0 10px 60px var(--on-media-shadow);
    /* Übergabe an die Kopfleiste: die Überschrift verlischt auf dem letzten
       Fünftel des Wegs, während dort der Schriftzug aufblendet. Beide stehen
       in diesem Moment an derselben Stelle und in derselben Höhe. */
    opacity:calc(1 - clamp(0,(var(--p,0) - .8)*5,1))}
  /* Kein Lede-Absatz mehr unter dem Titel: der Satz stand wortgleich in der
     Meta-Description und wiederholte nur die Kachelnamen darunter. Das
     Werkzeug ist das Produkt, nicht der Text — Wortmarke, Suchfeld, fertig. */
  /* Das Suchfeld liegt auf dem Hero-Foto, nicht auf der Seitenfläche —
     deshalb durchgehend Medien-Farben statt --muted/--accent. Im Hellmodus
     wären das sonst dunkle Schrift und dunkler Akzent auf dunklem Bild. */
  /* Mittig und eine Spur groesser: die Wortmarke steht oben in der Mitte,
     das Suchfeld unten in der Mitte — der Hero steht damit auf einer Achse
     statt in zwei Ecken. width:100% mit max-width bleibt, damit auf schmalen
     Ansichten nichts ueber den Rand laeuft; `auto` an den Seiten zentriert. */
  .hero__search{display:flex;align-items:center;gap:1rem;width:100%;max-width:720px;margin:0 auto;
    padding:1.25rem 1.6rem;background:var(--scrim-5);border:1px solid var(--on-media-line);border-radius:11px;
    color:var(--on-media-dim);font-family:var(--font-ui);font-size:1.15rem;cursor:pointer;text-align:left;
    backdrop-filter:blur(8px);transition:border-color .2s,box-shadow .2s,background-color .2s}
  /* Höhenschatten statt Akzent-Halo: ein Glow ohne Versatz ist der
     auffälligste Standard-Effekt generierter Oberflächen. */
  .hero__search:hover,.hero__search:focus-visible{border-color:var(--accent-media);background:var(--scrim-6);
    box-shadow:var(--shadow-2);outline:none}
  .hero__search .p{color:var(--accent-media);font-weight:800;flex:none}
  .hero__search .h{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
  .hero__search .k{display:flex;gap:.3rem;flex:none}
  /* Tastenkappen auf undurchsichtigem Grund: der aufhellende Schleier ließ
     "Ctrl"/"K" über hellen Stellen des Hero-Fotos auf 1,3:1 fallen. */
  .hero__search kbd{font-family:var(--font-ui);font-size:.82rem;font-weight:700;letter-spacing:.06em;color:var(--on-media);
    border:1px solid var(--on-media-line);border-bottom-width:2px;border-radius:5px;padding:.18rem .55rem;background:var(--scrim-6)}
  /* Sprungmarke nach unten: das „V" der Wortmarke zeigt selbst nach unten.
     Dreimal ineinandergesetzt wird aus dem Markenbuchstaben eine Abstiegs-
     Marke — HUD-Vokabular, das Spieler ohne Beschriftung lesen; deshalb
     ersetzt das Zeichen die Textzeile „Tools ↓" ersatzlos.
     Farbe ist --accent (Seitenakzent), NICHT --accent-media: der Hero-Schleier
     endet am Fuß auf var(--bg), das Zeichen liegt dort also auf der
     Seitenfläche und nicht mehr auf dem Foto — im Hellmodus wäre das helle
     Medien-Cyan auf hellem Grund unlesbar. */
  /* Die Reihe spannt sich über den Satzspiegel (dieselbe Breite und dieselben
     Seitenränder wie .hero__inner), die vier Stapel sitzen per space-between
     darauf — der äußerste links steht damit exakt auf der Fluchtlinie der
     Wortmarke.
     pointer-events:none auf dem Link, :auto auf den SVG: sonst wäre der halbe
     Hero-Fuß eine unsichtbare Klickfläche. Der Klick auf ein Zeichen steigt
     zum <a> auf, also bleibt es EIN Bedienelement mit EINEM Tab-Stopp. */
  .hero__cue{position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);z-index:1;
    width:100%;max-width:var(--maxw);pointer-events:none;
    display:flex;align-items:flex-start;justify-content:space-between;
    padding:.4rem clamp(1.25rem,5vw,3.5rem);color:var(--accent);
    transition:transform .25s cubic-bezier(.2,.7,.3,1)}
  /* Fuenf Stapel nebeneinander, jeder vier Stufen tief — ungerade Zahl,
     damit einer genau auf der Mitte sitzt. Die Welle läuft nicht
     nur abwärts, sondern auch nach rechts (0,09 s je Spalte) — der Puls
     streicht diagonal durch das Feld wie eine Anflug-Befeuerung. */
  .hero__cue svg{display:block;width:clamp(30px,3vw,40px);height:auto;overflow:visible;pointer-events:auto;--col:0s}
  .hero__cue svg:nth-child(2){--col:.09s}
  .hero__cue svg:nth-child(3){--col:.18s}
  .hero__cue svg:nth-child(4){--col:.27s}
  .hero__cue svg:nth-child(5){--col:.36s}
  /* Maße vom Wortmarken-V abgenommen, nicht geraten: Orbitron 900 setzt ein
     breites V mit ~60°-Schenkeln und schwerem Strich. Eine 2,4px-Haarlinie
     las sich als beliebiger UI-Pfeil — erst Strich 4,5 bei 46px Breite
     erkennt man den Buchstaben wieder.
     Gleicher Winkel, gleiche Strichstärke, konstanter Versatz — nur so
     bleiben die Schenkel parallel und die Lücken gleich breit. Die
     Tiefenstaffelung liegt allein in der Deckkraft. */
  /* Verzögerung ist die Summe aus Zeile und Spalte — 8 Regeln statt 16
     Einzelkombinationen; --col erbt vom <svg> auf die Pfade. */
  .hero__cue path{fill:none;stroke:currentColor;stroke-width:4.5;stroke-linejoin:miter;
    opacity:var(--o);--row:0s;animation:vdrop 2.4s ease-out infinite;
    animation-delay:calc(var(--row) + var(--col));transition:opacity .25s}
  .hero__cue path:nth-child(1){--o:1}
  .hero__cue path:nth-child(2){--o:.74;--row:.13s}
  .hero__cue path:nth-child(3){--o:.52;--row:.26s}
  .hero__cue path:nth-child(4){--o:.34;--row:.39s}
  /* Hellmodus braucht einen höheren Boden: dort ist der Akzent dunkles
     Petrol auf hellem Verlauf statt hellem Cyan auf Schwarz, und die unteren
     V verlieren bei gleicher Deckkraft deutlich mehr. Von Hand geschrieben —
     build-light-overrides.mjs kennt nur Farbwerte, keine Deckkraft. */
  :root[data-theme="light"] .hero__cue path:nth-child(2){--o:.84}
  :root[data-theme="light"] .hero__cue path:nth-child(3){--o:.68}
  :root[data-theme="light"] .hero__cue path:nth-child(4){--o:.54}
  /* Ein Signal FÄLLT durch den Stapel: schneller Anstieg (0,17 s), langsames
     Abklingen (0,55 s), dazu ein kurzer Versatz nach unten. Erst der Versatz
     macht aus dem Flackern eine Welle, die sichtbar nach unten wandert —
     0,13 s Abstand je Stufe, danach 1,7 s Ruhe. Kein Halo. */
  @keyframes vdrop{0%,30%,100%{opacity:var(--o);transform:translateY(0)}
    7%{opacity:1;transform:translateY(1.6px)}}
  /* animation:none statt play-state: eine laufende Animation schlägt jede
     normale Deklaration, sonst käme opacity:1 beim Hover nie an. */
  .hero__cue:hover,.hero__cue:focus-visible{transform:translate(-50%,3px)}
  .hero__cue:hover path,.hero__cue:focus-visible path{animation:none;opacity:1}
  /* Der Ring sitzt an den Zeichen, nicht am Link: der Link ist jetzt so breit
     wie der Satzspiegel, ein Rahmen darum wäre ein Kasten quer über den
     Hero-Fuß statt einer Fokus-Anzeige. */
  .hero__cue:focus-visible{outline:none}
  .hero__cue:focus-visible svg{outline:2px solid var(--accent);outline-offset:4px}

  /* ========== Layout ========== */
  main{position:relative;z-index:1;max-width:var(--maxw);margin:0 auto;padding:0 clamp(1.25rem,5vw,3.5rem)}
  .sec{margin:clamp(3.5rem,7vw,6rem) 0 0}
  .sec__head{display:flex;align-items:center;gap:1.1rem;margin-bottom:1.5rem}
  .sec__head h2{font-family:var(--font-display);font-weight:800;font-size:clamp(1.15rem,2.6vw,1.6rem);letter-spacing:.02em;white-space:nowrap}
  .sec__head .rule{flex:1;height:1px;background:linear-gradient(90deg,var(--line-2),transparent)}

  /* ========== Tools — bento of image tiles ========== */
  .tools{display:grid;gap:.85rem;grid-template-columns:1fr}
  .tools__more{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin-top:1.3rem;font-family:var(--font-ui);font-weight:700;font-size:.9rem;align-items:baseline}
  .tools__more>span{color:var(--muted);text-transform:uppercase;letter-spacing:.14em;font-size:.74rem}
  .tools__more a{color:var(--accent);border-bottom:1px solid var(--line-2);padding-bottom:1px;transition:color .2s,border-color .2s}
  .tools__more a:hover,.tools__more a:focus-visible{color:var(--text);border-color:var(--accent);outline:none}
  .tool{position:relative;display:flex;flex-direction:column;justify-content:flex-end;isolation:isolate;
    min-height:210px;padding:1.4rem 1.5rem;border-radius:14px;overflow:hidden;border:1px solid var(--line);
    background:var(--media-void);color:var(--on-media);transition:border-color .3s,box-shadow .3s,transform .3s cubic-bezier(.2,.7,.3,1)}
  .tool::before{content:"";position:absolute;inset:0;z-index:-2;background:var(--img) center/cover no-repeat;
    filter:saturate(.8) brightness(.66);transform:scale(1.03);transition:transform .7s ease,filter .7s ease}
  .tool::after{content:"";position:absolute;inset:0;z-index:-1;
    background:linear-gradient(to top,var(--scrim-6) 4%,var(--scrim-4) 42%,var(--scrim-0) 100%)}
  .tool:hover,.tool:focus-visible{transform:translateY(-4px);border-color:var(--accent);
    box-shadow:0 22px 50px -24px var(--shadow-color);outline:none}
  .tool:hover::before,.tool:focus-visible::before{transform:scale(1.09);filter:saturate(1.02) brightness(.82)}
  .tool__name{font-family:var(--font-display);font-weight:800;font-size:1.45rem;line-height:1.04;letter-spacing:.01em;
    text-shadow:0 2px 18px var(--on-media-shadow)}
  .tool__sub{margin-top:.3rem;font-family:var(--font-ui);font-weight:600;letter-spacing:.04em;color:var(--on-media-dim);font-size:.9rem}
  .tool__arrow{position:absolute;top:1.15rem;right:1.25rem;width:38px;height:38px;display:grid;place-items:center;
    border:1px solid var(--on-media-line);border-radius:50%;font-size:1.05rem;color:var(--on-media);line-height:1;
    background:var(--scrim-1);backdrop-filter:blur(4px);opacity:.85;transition:.25s}
  .tool:hover .tool__arrow,.tool:focus-visible .tool__arrow{background:var(--accent-media);color:var(--ink-media);
    border-color:var(--accent-media);opacity:1;transform:translate(2px,-2px)}
  .tool--xl .tool__name{font-size:clamp(1.9rem,4vw,2.7rem)}
  .tool--xl .tool__sub{font-size:1rem}
  @media(min-width:600px){
    .tools{grid-template-columns:1fr 1fr}
    .tool--xl{grid-column:1 / -1}
  }
  @media(min-width:980px){
    .tools{grid-template-columns:repeat(6,1fr);grid-auto-rows:230px}
    .tool--xl{grid-column:span 3;grid-row:span 2}
    .tool--w{grid-column:span 3}
    .tool--t{grid-column:span 2}
  }

  /* ========== Latest patch ========== */
  .fresh{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);
    border-radius:14px;overflow:hidden;background:var(--surface)}
  .fresh__body{padding:clamp(1.5rem,3vw,2.4rem);display:flex;flex-direction:column;gap:.5rem;min-width:0}
  .fresh__ey{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--font-ui);font-weight:800;
    letter-spacing:.16em;text-transform:uppercase;font-size:.72rem;color:var(--accent)}
  .fresh__dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px var(--accent);flex:none}
  .fresh__ver{font-family:var(--font-display);font-weight:900;font-size:clamp(2rem,5vw,3.1rem);line-height:1;margin-top:.2rem}
  .fresh__name{font-family:var(--font-ui);font-weight:700;font-size:1.2rem;color:var(--text)}
  .fresh__go{align-self:flex-start;margin-top:.8rem;font-family:var(--font-ui);font-weight:700;letter-spacing:.08em;
    text-transform:uppercase;font-size:.78rem;color:var(--ink);background:var(--accent);padding:.6rem 1.15rem;border-radius:7px;
    display:inline-flex;gap:.5rem;align-items:center;transition:filter .18s,transform .18s}
  .fresh__go:hover{filter:brightness(1.08);transform:translateX(2px)}
  .fresh__media{position:relative;background:var(--media-void) center/cover no-repeat;min-height:180px}
  .fresh__media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--surface),transparent 42%)}

  .reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}

  @media(max-width:820px){
    .fresh{grid-template-columns:1fr}
    .fresh__media{min-height:160px;order:-1}
    .fresh__media::after{background:linear-gradient(0deg,var(--surface),transparent 55%)}
  }
  /* Die frühere Sonderregel padding-top:7.5rem unter 520px entfällt: sie
     schob den Inhalt von der Kopfleiste weg, als er noch oben im Hero begann.
     Mit align-items:center wäre sie eine einseitige Innenkante und zöge das
     Suchfeld wieder aus der Mitte. */
  @media(max-width:360px){.hero__mark h1{font-size:2.5rem}}
  /* Unter 580px zeigt die Kopfleiste nur das Monogramm — es gibt dort keinen
     Schriftzug, auf den die Überschrift zulaufen könnte. Sie bleibt deshalb
     im Hero stehen und scrollt schlicht mit weg. */
  @media(max-width:580px){
    .hero__mark{position:absolute;transform:none}
    .hero__mark h1{opacity:1}
  }
  @media (prefers-reduced-motion:reduce){
    .reveal{opacity:1;transform:none}
    .hero__img{animation:none}
    /* Ohne Bewegung keine Wanderung: die Überschrift bleibt im Hero, die
       Kopfleiste holt ihren Schriftzug beim Scrollen einfach herein. */
    .hero__mark{position:absolute;transform:none}
    .hero__mark h1{opacity:1}
    *{animation:none!important;scroll-behavior:auto!important}
  }</style>

<a class="skip" href="#tools">Skip to tools</a>

<SiteNav heroMorph={true} />

{/* Bewusst AUSSERHALB von .hero: der Hero traegt isolation:isolate und damit
    einen eigenen Stacking-Kontext — darin koennte die Wortmarke die
    Kopfleiste (z-index 9600) nie ueberholen und wuerde auf dem letzten
    Stueck hinter deren Hintergrund verschwinden. */}
<div class="hero__mark"><h1>VerseBase</h1></div>

<header class="hero">
  <div class="hero__img" style={`--hero:url('${HERO_IMG}')`} aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    <button class="hero__search" type="button" data-scs-open aria-label="Open search">
      <span class="p" aria-hidden="true">&gt;_</span>
      <span class="h">Search items, ships, patches…</span>
      <span class="k" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
    </button>
  </div>
  <a class="hero__cue" href="#tools" aria-label="Go to tools">
    {[0, 1, 2, 3, 4].map(() => (
      <svg viewBox="0 0 46 90" aria-hidden="true" focusable="false">
        <path d="M3 3 23 31 43 3"/>
        <path d="M3 21 23 49 43 21"/>
        <path d="M3 39 23 67 43 39"/>
        <path d="M3 57 23 85 43 57"/>
      </svg>
    ))}
  </a>
</header>

<main>
  <!-- TOOLS — image bento -->
  <section class="sec" id="tools">
    <div class="sec__head"><h2>Tools</h2><span class="rule"></span></div>
    <div class="tools">
      {tools.map((t) => (
        <a class={`tool tool--${t.size}`} style={`--img:url('${t.img}')`} href={t.href}>
          <span class="tool__arrow" aria-hidden="true">→</span>
          <span class="tool__name">{t.name}</span>
          <span class="tool__sub">{t.sub}</span>
        </a>
      ))}
    </div>
    <p class="tools__more">
      <span>Full database:</span>
      <a href="/items.html">All items by category</a>
      <a href="/crafting.html">Blueprints</a>
      <a href="/schiffe.html">Ship index</a>
      <a href="/missionen.html">Missions</a>
    </p>
  </section>

  <!-- LATEST -->
  <section class="sec reveal">
    <div class="sec__head"><h2>Latest</h2><span class="rule"></span></div>
    <a class="fresh" href={`/patches/sc-${latest.id}.html`}>
      <div class="fresh__body">
        <span class="fresh__ey"><span class="fresh__dot" aria-hidden="true"></span>Live · {latest.data.dateDisplay}</span>
        <span class="fresh__ver">Alpha {latest.data.version}</span>
        <span class="fresh__name">{latest.data.codename ?? latest.data.tagline}</span>
        <span class="fresh__go">Open patch <span aria-hidden="true">→</span></span>
      </div>
      <div class="fresh__media" style={`background-image:url('${latest.data.heroImage ?? `/assets/trailer-${latest.id}.jpg`}')`} aria-hidden="true"></div>
    </a>
  </section>
</main>

<script is:inline>
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .08 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
</Layout>
