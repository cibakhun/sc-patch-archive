---
// Support — thin EN wrapper (mirror of /de/support.html, same slug so the
// language switcher pairs them). Body lives in <SupportBody>.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import SupportBody from '../components/SupportBody.astro';
---
<Layout
  title={'Support VerseBase | VerseBase'}
  description={'How you can help VerseBase, the free Star Citizen reference: feedback, bug reports, sharing and Discord cost nothing. Money is optional, with no funding goal.'}
  themeColor="#0d0a06"
  translated={true}
>
<SiteNav crumbs={[{ label: 'Support' }]} hasEn={true} />
<SupportBody lang="en" />
<Attribution sources={[]} />
</Layout>
