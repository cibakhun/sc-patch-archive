---
// Support — thin EN wrapper (mirror of /de/support.html, same slug so the
// language switcher pairs them). Body lives in <SupportBody>.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import SupportBody from '../components/SupportBody.astro';
---
<Layout
  title={'Support VerseBase | VerseBase'}
  description={'The power supply in the machine VerseBase is built on cuts out without warning — mid-work, taking the unsaved work with it. If the site is worth something to you, you can support it: voluntary, nothing in return, nothing behind a paywall.'}
  themeColor="#0d0a06"
  translated={true}
>
<SiteNav crumbs={[{ label: 'Support' }]} hasEn={true} />
<SupportBody lang="en" />
<Attribution sources={[]} />
</Layout>
