---
// Support — thin EN wrapper (mirror of /de/support.html, same slug so the
// language switcher pairs them). Body lives in <SupportBody>.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import SupportBody from '../components/SupportBody.astro';
---
<Layout
  title={'Support VerseBase | VerseBase'}
  description={'The new power supply for the PC that VerseBase is built on has been bought — thank you to everyone who chipped in. If you want to keep supporting the site, you can do so here: voluntary, nothing in return, nothing behind a paywall.'}
  themeColor="#0d0a06"
  translated={true}
>
<SiteNav crumbs={[{ label: 'Support' }]} hasEn={true} />
<SupportBody lang="en" />
<Attribution sources={[]} />
</Layout>
