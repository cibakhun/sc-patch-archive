---
// Impressum (Pflichtangaben § 5 DDG / § 18 MStV). Die [TODO]-Felder MÜSSEN vor
// dem Publish mit den echten Betreiberdaten gefüllt werden — npm run audit:site
// bleibt absichtlich rot, solange sie im Build stehen.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Attribution from '../../components/Attribution.astro';
---
<Layout title={"Impressum | VerseBase"} description={"Impressum von VerseBase: Anbieterkennzeichnung, Kontakt sowie Marken- und Urheberrechtshinweise des inoffiziellen Star-Citizen-Fan-Projekts."} themeColor="#05070d" translated={true}>
<style is:inline>
:root{--bg:#05070d;--bg-2:#0a0e18;--surface:#0f1524;--surface-2:#141c30;--accent:#2dd4ff;--accent-2:#6ea8ff;--text:#e8eefc;--muted:#8a99b8;--line:rgba(110,168,255,.16);--line-soft:rgba(232,238,252,.10);--ink:#05070d;--maxw:840px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f7fe;--bg-2:#e9eef9;--surface:#fdfdff;--surface-2:#eef2fc;--text:#1b1f29;--muted:#4e586c;--accent:#05657c;--accent-2:#0850ad;--ink:#ffffff;--accent-media:#2dd4ff;--accent-2-media:#6ea8ff;--line:rgba(43,125,148,.3);--line-soft:rgba(41,46,56,.12)}


.lg-wrap{max-width:var(--maxw);margin:0 auto;padding:3.2rem 1.25rem 4rem}
.lg-wrap h1{font-family:var(--font-display);font-weight:900;font-size:clamp(2rem,6vw,3rem);color:var(--text);margin:0 0 1.6rem}
.lg-wrap h2{font-family:var(--font-ui);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:.95rem;color:var(--accent);margin:2.2rem 0 .6rem;border-bottom:1px solid var(--line);padding-bottom:.4rem}
.lg-wrap p, .lg-wrap li{color:var(--text);line-height:1.7;font-size:.98rem}
.lg-wrap .muted{color:var(--muted)}
.lg-fill{display:inline-block;background:color-mix(in srgb,#ff5b5b 14%,transparent);border:1px dashed #ff5b5b;border-radius:4px;padding:0 .45rem;color:#ffb4b4;font-weight:700}
/* Hell-Entsprechungen — erzeugt von scripts/build-light-overrides.mjs. Nicht von Hand ändern. */
:root[data-theme="light"] .lg-fill{color:#893c40}
</style>
<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Impresszum' }]} translated={true} />
<main id="main">
  <div class="lg-wrap">
    <h1>Impresszum</h1>
    <p class="muted">A német jog (§ 5 DDG) írja elő ezt a szolgáltatói adatközlést („Impressum”).</p>

    <h2>Szolgáltató</h2>
    <p>
      Krisztofer Milánkovits<br />
      Schlossstraße 6<br />
      85411 Hohenkammer<br />
      Németország
    </p>

    <h2>Kapcsolat</h2>
    <p>E-mail: <a href="mailto:krysx141@gmail.com">krysx141@gmail.com</a></p>

    <h2>A tartalomért felelős a § 18 (2) MStV szerint</h2>
    <p>Krisztofer Milánkovits, a fenti címen.</p>

    <h2>Védjegy- és szerzői jogi tájékoztató</h2>
    <p>
      Ez egy nem hivatalos, nem kereskedelmi rajongói projekt dokumentációs céllal.
      A Star Citizen®, a Squadron 42®, a Roberts Space Industries® és a Cloud Imperium® a
      Cloud Imperium Rights LLC bejegyzett védjegye. Minden jog fenntartva. Ez a webhely semmilyen
      kapcsolatban nem áll a Cloud Imperium cégcsoporttal, és az nem is támogatja vagy szponzorálja.
    </p>
    <p>
      Játékbeli tartalmak, trailerek és állóképek © Cloud Imperium Games — felhasználás az
      RSI rajongóitartalom-irányelvei keretében. A starcitizen.tools wiki-tartalmai
      CC-BY-SA 4.0 licenc alatt állnak. A hajóképeket a fleetyards.net szolgáltatja.
    </p>

    <h2>Felelősség a hivatkozásokért</h2>
    <p class="muted">
      Ez a webhely harmadik felek külső webhelyeire mutató hivatkozásokat tartalmaz, amelyek
      tartalmára nincs befolyásunk. A hivatkozott oldalak tartalmáért mindig az adott szolgáltató
      felel. A hivatkozás időpontjában jogsértő tartalom nem volt felismerhető.
    </p>
  </div>
</main>
<Attribution sources={[]} />
</Layout>
