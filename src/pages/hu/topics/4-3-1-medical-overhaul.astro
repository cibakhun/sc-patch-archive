---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Medical Overhaul — Star Citizen 4.3.1 | VerseBase"} description={"Medical Overhaul: az Alpha 4.3.1 átépíti az orvosi rendszert — a sebek, a gyógyulás, a mentés és az újraélesztés újragondolva, élén az RSI Apollóval és a MedGel-rendszerrel."} themeColor="#0f2336" ogType="article" ogImage="/assets/t-med-1.jpg" translated={true}>
<TopicSeo slug="4-3-1-medical-overhaul" image="/assets/t-med-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Medical-Theme (4.3.1 "Virtue's Descent") */
:root{--bg:#0f2336;--bg-2:#13304a;--surface:#19395a;--surface-2:#21466b;--accent:#1FAA8C;--accent-2:#9bdfce;--hot:#D7263D;--text:#F2F5F7;--muted:#a9c0d4;--line:rgba(31,170,140,.22);--line-soft:rgba(242,245,247,.10);--glow:0 0 44px rgba(31,170,140,.30);--ink:#0f2336;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f2f8fe;--bg-2:#e6eff8;--surface:#fcfdff;--surface-2:#ecf3fc;--text:#1d2021;--muted:#485a6b;--accent:#066b56;--accent-2:#006454;--hot:#9d0223;--ink:#ffffff;--accent-media:#1FAA8C;--accent-2-media:#9bdfce;--line:rgba(44,130,108,.3);--line-soft:rgba(43,46,47,.12);--glow:0 6px 22px rgba(44,130,108,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.vitals{font-family:var(--font-ui);font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--accent-2);font-size:.74rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.3.1', href: '/hu/patches/sc-4-3-1.html' }, { label: "Medical Overhaul" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-med-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-3-1.html">Alpha 4.3.1 · Virtue's Descent</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">A gyógyítás újragondolva</span>Medical Overhaul</h1>
      <p class="lead">A 4.3.1 átépíti az orvosi rendszert: a sebek, a gyógyulás, a mentés és az újraélesztés másképp működik — élén az RSI Apollóval és a MedGel-rendszerrel.</p>
      <div class="tags"><span class="tag">Medical</span><span class="tag">MedGel</span><span class="tag">Ágyfokozatok</span><span class="tag">RSI Apollo</span><span class="tag">Site B</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>MEDICAL OVERHAUL</span><span class="dot">◆</span><span>MEDGEL</span><span class="dot">◆</span><span>ÁGYFOKOZATOK T1-T3</span><span class="dot">◆</span><span>RSI APOLLO</span><span class="dot">◆</span><span>SITE B</span><span class="dot">◆</span><span>ÚJRAÉLESZTÉS</span><span class="dot">◆</span>
      <span>MEDICAL OVERHAUL</span><span class="dot">◆</span><span>MEDGEL</span><span class="dot">◆</span><span>ÁGYFOKOZATOK T1-T3</span><span class="dot">◆</span><span>RSI APOLLO</span><span class="dot">◆</span><span>SITE B</span><span class="dot">◆</span><span>ÚJRAÉLESZTÉS</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-3-1-medical-overhaul" />

  <!-- FULL-BLEED BAND — opening statement over the medbay (parallax) -->
  <section class="band band--center">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/img-apollo.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Egy rendszer, alapjaitól újra</div>
      <div class="big outline">ÉLETJELEK.</div>
      <p>Az Alpha 4.3.1 alapjaiban dolgozza át az orvosi rendszert — hogyan keletkeznek és gyógyulnak a sebek, és hogyan mentik meg, illetve élesztik újra a játékosokat. A mellékszálból önálló körforgás lesz.</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Ágyfokozat · T1-től T3-ig</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">A pillanat hajója · RSI Apollo</div></div>
    <div class="s"><div class="n">MedGel</div><div class="c">Az ágyak fogyóanyaga</div></div>
    <div class="s"><div class="n">Site B</div><div class="c">Onyx-történet · Dr. Jorrit laborja</div></div>
  </div>

  <!-- SCROLLYTELLING — die neue Versorgungs-Schleife (full-bleed, process fits) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Az új ellátási körforgás</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-med-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-med-6.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Sérülés</h3><p>A sebek mostantól új szabályok szerint keletkeznek — az átdolgozott orvosi rendszer első építőköve határozza meg, hogyan sérül meg egyáltalán egy játékos.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>MedGel-ellátás</h3><p>Az orvosi ágyak MedGel-töltetet fogyasztanak a funkcióikhoz. A MedGel fogyóanyag — ha elfogy, az ágy leáll.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Ágyfokozatok T1-T3</h3><p>Az ágyak T1-től T3-ig terjednek, eltérő újraéledési távolságokkal — a T1 például a New Babbage-i kórház prémium ellátással, a T3 például a Cutlass Red.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Újraélesztés</h3><p>A mentés és az újraélesztés másképp működik — a körforgás utolsó lépése dönti el, hol és hogyan kerül vissza a játékos a Verse-be.</p></div>
    </div>
  </div>

  <!-- SPLIT — RSI Apollo (the ONE framed/split section) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/img-apollo2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">02 · A pillanat hajója</div>
        <h3>RSI Apollo — Medivac &amp; Triage</h3>
        <p>Az orvosi átépítéssel az <b>RSI Apollo</b> kerül a középpontba: dedikált egészségügyi hajó két kivitelben — <b>Medivac</b> a mentéshez, <b>Triage</b> az ellátáshoz.</p>
        <p>Orvosi ágyai <b>regenerációs képességet</b> kapnak, és az Apollót repülő támaszponttá teszik a Verse mélyén dolgozó csapatoknak — ott, ahol messze van a legközelebbi kórház.</p>
      </div>
    </div>
  </section>

  <!-- VERSUS — die zwei Ausrichtungen des Apollo (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>✚ Medivac</h3>
        <ul>
          <li>A sebesültek terepről való kimentésére tervezve.</li>
          <li>Odaviszi az elesett játékosokat, ahol ellátják őket.</li>
          <li>Az RSI Apollo két orvosi változatának egyike.</li>
          <li>Erőssége: a sebesültek gyors kimentése a terepről.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>✚ Triage</h3>
        <ul>
          <li>A fedélzeti ellátásra tervezve.</li>
          <li>Orvosi ágyak regenerációs képességgel.</li>
          <li>Repülő támaszpont a folyó műveletekhez.</li>
          <li>Teljes ellátás a fedélzeten — kórházba visszarepülés nélkül.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Bett-Stufen (parallax, big overlaid text) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-med-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">03 · Ágyfokozatok</div>
      <div class="big" style="font-size:clamp(2.4rem,8vw,6rem)">T1 → T3</div>
      <p>Az orvosi ágyaknak <b style="color:var(--accent-2)">T1-től T3-ig</b> vannak fokozatai, eltérő újraéledési távolságokkal. A <b style="color:var(--accent-2)">T1</b> például a New Babbage-i kórházat jelenti prémium ellátással, a <b style="color:var(--accent-2)">T3</b> például a Cutlass Redet — minél magasabb a fokozat, annál közelebbi a visszatérés.</p>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Aki megment, az dönti el, <span class="hl">hol ébredsz fel újra.</span></blockquote>
    <cite>Medical Overhaul · Alpha 4.3.1</cite>
  </section>

  <!-- FULL-BLEED BAND — Site B / Onyx-Story (parallax) -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/trailer-4-3-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · Folytatódik az Onyx-történet</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">SITE B</div>
      <p>Az Onyx-történet a <b style="color:var(--accent-2)">Site B</b> helyszínnel folytatódik: <b style="color:var(--accent-2)">Dr. Jorrit laborjával</b>, ahol a játékosok biológiai mintákat mentenek ki — újabb felfedezhető réteg, szorosan összefonódva a patch orvosi témájával.</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery — full-bleed close, no video embed) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/vid-apollo.jpg"><img src="/assets/vid-apollo.jpg" alt="RSI Apollo — orvosi részleg" loading="lazy"><span class="zoomic">⤢</span><figcaption>RSI Apollo · orvosi részleg</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-med-1.jpg"><img src="/assets/t-med-1.jpg" alt="Orvosi ellátás a Med-Bayben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Ellátás · Medical Overhaul</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-med-2.jpg"><img src="/assets/t-med-2.jpg" alt="Orvosi ágy" loading="lazy"><span class="zoomic">⤢</span><figcaption>Orvosi ágy · ágyfokozatok</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-apollo.jpg"><img src="/assets/img-apollo.jpg" alt="RSI Apollo repülés közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>RSI Apollo</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-apollo2.jpg"><img src="/assets/img-apollo2.jpg" alt="RSI Apollo — Triage" loading="lazy"><span class="zoomic">⤢</span><figcaption>Apollo · Triage</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-3-1.jpg"><img src="/assets/trailer-4-3-1.jpg" alt="Virtue's Descent — Site B" loading="lazy"><span class="zoomic">⤢</span><figcaption>Site B · Onyx-történet</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: hivatalos Star Citizen-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). A képek szemléltetésül, rajongói felhasználásban.</p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-3-1-medical-overhaul" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
