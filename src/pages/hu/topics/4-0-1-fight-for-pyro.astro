---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Fight for Pyro — Star Citizen 4.0.1 | VerseBase"} description={"Fight for Pyro: a Save Stanton-kampány 2. fejezete. Kötelezd el magad véglegesen a három frakció egyike mellett, és döntsd el, kié a törvényen kívüli Pyro — az Alpha 4.0.1-gyel bevezetve."} themeColor="#0c1320" ogType="article" ogImage="/assets/t-ffp-1.jpg" translated={true}>
<TopicSeo slug="4-0-1-fight-for-pyro" image="/assets/t-ffp-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* 4.0.1 "Stabilität & Save Stanton II" — Konsolen-Blau (geerbt vom Patch) */
:root{--bg:#0c1320;--bg-2:#101a2b;--surface:#152237;--surface-2:#1c2d46;--accent:#36c5d8;--accent-2:#f0a32a;--hot:#36c5d8;--text:#e6f0fa;--muted:#8ba3bd;--line:rgba(54,197,216,.22);--line-soft:rgba(230,240,250,.10);--glow:0 0 44px rgba(54,197,216,.30);--ink:#0c1320;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f8fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#192027;--muted:#4a5a6b;--accent:#026772;--accent-2:#754b03;--hot:#055e68;--ink:#ffffff;--accent-media:#36c5d8;--accent-2-media:#f0a32a;--line:rgba(42,127,138,.3);--line-soft:rgba(39,47,54,.12);--glow:0 6px 22px rgba(42,127,138,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem;max-width:var(--maxw);margin:0 auto}
@media(max-width:860px){.trio{grid-template-columns:1fr}}
.fcard{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:10px;min-height:340px;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem 1.4rem;isolation:isolate}
.fcard .fbg{position:absolute;inset:0;z-index:-2;background-size:cover;background-position:center;transition:transform .8s;filter:saturate(.9)}
.fcard:hover .fbg{transform:scale(1.07)}
.fcard::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,var(--veil-2),var(--veil-2) 45%,var(--veil))}
.fcard .fk{font-family:var(--font-ui);font-weight:700;letter-spacing:.22em;text-transform:uppercase;font-size:.68rem;color:var(--accent-2)}
.fcard h3{font-family:var(--font-display);font-weight:800;font-size:clamp(1.2rem,2.2vw,1.6rem);line-height:1.05;color:var(--text);margin:.35rem 0 .5rem}
.fcard p{color:var(--text);font-size:.95rem;opacity:.92}
.fcard .ftag{margin-top:.8rem;display:inline-flex;align-self:flex-start;font-family:var(--font-ui);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.66rem;padding:.3rem .7rem;border:1px solid var(--line);border-radius:50px;color:var(--accent)}
.reward{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.1rem}
.reward .chip{font-family:var(--font-ui);font-weight:600;font-size:.82rem;color:var(--text);padding:.45rem .85rem;border:1px solid var(--line);border-radius:6px;background:var(--veil)}
.reward .chip b{color:var(--accent-2)}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.0.1', href: '/hu/patches/sc-4-0-1.html' }, { label: "Fight for Pyro" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-ffp-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-0-1.html">Alpha 4.0.1 · Save Stanton II</a> &nbsp;·&nbsp; Dinamikus esemény</div>
      <h1><span class="thin">Save Stanton · 2. fejezet</span>Fight for Pyro</h1>
      <p class="lead">A háború átterelődik a Pyróba: a Save Stanton-kampány 2. fejezetében véglegesen elkötelezed magad a három frakció egyike mellett, és beleszólsz abba, kié a törvényen kívüli rendszer.</p>
      <div class="tags"><span class="tag hot">Dinamikus esemény</span><span class="tag">3 frakció</span><span class="tag">Végleges választás</span><span class="tag">Ripper SMG</span><span class="tag">Pyro</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>FIGHT FOR PYRO</span><span class="dot">◆</span><span>SAVE STANTON</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>RIPPER SMG</span><span class="dot">◆</span>
      <span>FIGHT FOR PYRO</span><span class="dot">◆</span><span>SAVE STANTON</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>RIPPER SMG</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-1-fight-for-pyro" />

  <!-- FULL-BLEED BAND — der Krieg zieht nach Pyro -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-pyro-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">2. fejezet · A háború tovább vonul</div>
      <div class="big outline">IRÁNY PYRO.</div>
      <p>A Stanton elleni támadás után a cselekmény a konfliktust követve a törvényen kívüli <b style="color:var(--accent-2)">Pyróba</b> tart. Ahol nincs törvény, ott három frakció küzd az uralomért — és te is beleszólsz, melyik oldalon állsz.</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">A Save Stanton-kampány fejezete</div></div>
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Választható frakció</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Választás · és ez végleges</div></div>
    <div class="s"><div class="n">Pyro</div><div class="c">Helyszín · törvényen kívüli rendszer</div></div>
  </div>

  <!-- DREI FRAKTIONEN (image-backed trio, design on top) -->
  <section>
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Válaszd meg az oldaladat</h2><span class="rule"></span></div>
      <p class="lead-p reveal" style="margin-bottom:1.6rem">Három frakció küzd a Pyróért. Az első küldetéseddel színt vallasz — onnantól a küldetéseid reputációhoz kötöttek.</p>
    </div>
    <div class="trio reveal">
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/cz-facility.jpg')"></div>
        <div class="fk">01. frakció</div>
        <h3>Citizens for Prosperity</h3>
        <p>Harcolj egy olyan Pyróért, amely többet akar a káosznál — rendet és jólétet a törvényen kívüli rendszerben.</p>
        <span class="ftag">Reputációhoz kötött</span>
      </div>
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/cz-combat.jpg')"></div>
        <div class="fk">02. frakció</div>
        <h3>Headhunters</h3>
        <p>Vérdíj, acél és kemény kéz: állj azok mellé, akik a Pyróban saját szabályaik szerint vadásznak.</p>
        <span class="ftag">Reputációhoz kötött</span>
      </div>
      <div class="fcard">
        <div class="fbg" style="background-image:url('/assets/t-ffp-2.jpg')"></div>
        <div class="fk">03. frakció</div>
        <h3>Frontier Fighters</h3>
        <p>A szabad határvidék védelme — azoknak, akik a Pyrót az utolsó független frontnak tekintik.</p>
        <span class="ftag">Reputációhoz kötött</span>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING — so legst du dich fest (process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>Így kötelezed el magad</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-pyro-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-facility.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-3.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Irány a Pyro</h3><p>Kövesd a Save Stanton-kampányt a 2. fejezetben a törvényen kívüli Pyro-rendszerbe, ahol fellángolt a harc az uralomért.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Az első küldetés</h3><p>Citizens for Prosperity, Headhunters vagy Frontier Fighters: az első küldetésed dönti el, kiért harcolsz a Pyróban.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Eldőlt</h3><p>Az első küldetés után a választás végleges. Nincs visszaút — mostantól minden küldetés a frakciód reputációjához kötött.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>A befejezésig</h3><p>Dolgozd végig a frakciód küldetésláncát, és zárd le a Fight for Pyrót — az időzítés dönt a jutalmadról.</p></div>
    </div>
  </div>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Egy küldetés. Egy frakció. <span class="hl">Nincs második választás.</span></blockquote>
    <cite>Fight for Pyro · Save Stanton 2. fejezet</cite>
  </section>

  <!-- SPLIT (the ONE framed section) — permanente Wahl -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-pyro-5.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">03 · Végleges választás</div>
        <h3>Egy döntés, amely megmarad</h3>
        <p>Sok eseménnyel ellentétben a Fight for Pyróban a frakcióválasztásod <b>végleges</b>: amint az első küldetés lezárult, el vagy kötelezve. Nincs többé átállás a másik oldalra.</p>
        <p>Onnantól a küldetéseid <b>reputációhoz kötöttek</b> — kiérdemled a frakciód bizalmát, és a kampány végéig az ő csatáikat vívod.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Belohnungen / Ripper SMG -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-ffp-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · Amit kiérdemelsz</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">RIPPER SMG</div>
      <p>Aki a Fight for Pyrót <b style="color:var(--accent-2)">a 4.0.2 indulása előtt</b> lezárta, megszerezte az exkluzív Pyro Ripper SMG-t — jutalom csak azoknak, akik időben harcoltak a frakciójukért.</p>
      <div class="reward">
        <span class="chip"><b>Exkluzív</b> · Pyro Ripper SMG</span>
        <span class="chip">csak a <b>4.0.2</b> indulása előtt</span>
      </div>
    </div>
  </section>

  <!-- LACKIERUNGEN (data over surface, no image card) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Frakciófestések</h2><span class="rule"></span></div>
      <p class="lead-p reveal">Aki a <b>Save Stanton 1. fejezetét</b> <i>és</i> a <b>Fight for Pyro 2. fejezetét</b> is lezárta, frakcióspecifikus hajófestéseket érdemelt ki — színeket, amelyek megmutatják, kiért harcoltál a Pyróban.</p>
      <div class="reward reveal" style="margin-top:1.4rem">
        <span class="chip">Anvil <b>C8R Pisces</b></span>
        <span class="chip">Anvil <b>Carrack</b></span>
        <span class="chip">Drake <b>Cutter</b></span>
        <span class="chip">RSI <b>Zeus Mk II</b></span>
      </div>
    </div>
  </section>

  <!-- CLOSING — mixed full-bleed gallery (no official video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Képgaléria</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-ffp-1.jpg"><img src="/assets/t-ffp-1.jpg" alt="Fight for Pyro — harc a Pyróért" loading="lazy"><span class="zoomic">⤢</span><figcaption>Fight for Pyro</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-pyro-7.jpg"><img src="/assets/t-pyro-7.jpg" alt="Patch City — bandaállomás a Pyro aszteroidamezőjében" loading="lazy"><span class="zoomic">⤢</span><figcaption>Patch City · bandakikötő</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-ruin-1.jpg"><img src="/assets/t-ruin-1.jpg" alt="Ruin Station a Terminus bolygó előtt" loading="lazy"><span class="zoomic">⤢</span><figcaption>Ruin Station · Terminus</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-cutlass.jpg"><img src="/assets/img-cutlass.jpg" alt="Drake Cutlass a Pyro felett" loading="lazy"><span class="zoomic">⤢</span><figcaption>Drake Cutlass</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-pyro-6.jpg"><img src="/assets/t-pyro-6.jpg" alt="Világító növényzet sziklatűk között egy Pyro-világon" loading="lazy"><span class="zoomic">⤢</span><figcaption>A Pyro vadonja</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-0-0.jpg"><img src="/assets/trailer-4-0-0.jpg" alt="Destination Pyro" loading="lazy"><span class="zoomic">⤢</span><figcaption>Destination Pyro</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: Star Citizen Wiki &amp; hivatalos közösségi források (© Cloud Imperium Games). A képek illusztrációk.</p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-0-1-fight-for-pyro" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
