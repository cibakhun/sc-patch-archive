---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Onyx Facilities — Star Citizen 4.3.0 | VerseBase"} description={"Onyx Facilities: mintegy 100 elhagyott ASD-kutatóállomás Stanton-szerte — adatmentés, hangnaplók és a regenerációs válság mögötti sötét igazság. Az Alpha 4.3.0 Dark Territoryval bevezetve."} themeColor="#0B0B0F" ogType="article" ogImage="/assets/t-onyx-1.jpg" translated={true}>
<TopicSeo slug="4-3-0-onyx-facilities" image="/assets/t-onyx-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Onyx-Theme (4.3.0 · Dark Territory) */
:root{--bg:#0B0B0F;--bg-2:#101218;--surface:#15181f;--surface-2:#1c212b;--accent:#E8A317;--accent-2:#3E5C76;--hot:#C0392B;--text:#e9edf2;--muted:#97a3b2;--line:rgba(232,163,23,.22);--line-soft:rgba(233,237,242,.10);--glow:0 0 44px rgba(232,163,23,.30);--ink:#0B0B0F;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f7f7fd;--bg-2:#eaeef7;--surface:#fdfdff;--surface-2:#eef3fc;--text:#1d2023;--muted:#4e5967;--accent:#785305;--accent-2:#365977;--hot:#9e0500;--ink:#ffffff;--accent-media:#E8A317;--accent-2-media:#3E5C76;--line:rgba(144,106,39,.3);--line-soft:rgba(43,46,49,.12);--glow:0 6px 22px rgba(144,106,39,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.dossier{font-family:var(--font-ui);font-weight:700;letter-spacing:.28em;text-transform:uppercase;color:var(--hot);font-size:.78rem}
.tag.case{border-color:color-mix(in srgb,var(--accent-2) 60%,transparent);color:color-mix(in srgb,var(--accent-2) 80%,var(--text))}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.3.0', href: '/hu/patches/sc-4-3-0.html' }, { label: "Onyx Facilities" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed, kinetic) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-onyx-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-3-0.html">Alpha 4.3.0 · Dark Territory</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">Elhagyott ASD-kutatóállomások</span>Onyx Facilities</h1>
      <p class="lead">Az Associated Sciences and Development mintegy 100 elhagyott kutatólétesítménye Stanton-szerte szétszórva — veszélyes romok, tele adatnyomokkal, hangnaplókkal és a regenerációs válság mögötti sötét igazsággal.</p>
      <div class="tags"><span class="tag hot">Investigation</span><span class="tag case">ASD</span><span class="tag">Personal Hangars</span><span class="tag hot">Regenerációs válság</span><span class="tag">Loot</span></div>
      <div class="hero__play" data-lb="yt:MCJlD2Meuek"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>ONYX</span><span class="dot">◆</span><span>ASD</span><span class="dot">◆</span><span>REGENERÁCIÓS VÁLSÁG</span><span class="dot">◆</span><span>ARKEN MALLOR</span><span class="dot">◆</span><span>DR. JORRIT</span><span class="dot">◆</span><span>ADATMENTÉS</span><span class="dot">◆</span><span>PERSONAL HANGARS</span><span class="dot">◆</span>
      <span>ONYX</span><span class="dot">◆</span><span>ASD</span><span class="dot">◆</span><span>REGENERÁCIÓS VÁLSÁG</span><span class="dot">◆</span><span>ARKEN MALLOR</span><span class="dot">◆</span><span>DR. JORRIT</span><span class="dot">◆</span><span>ADATMENTÉS</span><span class="dot">◆</span><span>PERSONAL HANGARS</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-3-0-onyx-facilities" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="100">0</div><div class="c">Elhagyott ASD-létesítmény</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Rendszer · Stanton, teljes lefedettséggel</div></div>
    <div class="s"><div class="n count" data-to="0">0</div><div class="c">Biztosított belső tér</div></div>
    <div class="s"><div class="n">ASD</div><div class="c">Associated Sciences & Development</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax, big overlaid text) -->
  <section class="band" style="padding-top:0">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-onyx-3.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Dark Territory</div>
      <div class="big outline">ELHAGYATVA.</div>
      <p>Az Alpha 4.3.0-val megjelent az Associated Sciences and Development mintegy <b style="color:var(--accent-2)">100 elhagyott kutatólétesítménye</b> — az egész Stanton-rendszerben szétszórva. Senki nem biztosította őket. Ami hátramaradt: romok és annak nyomai, amit itt kutattak.</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: Die Ermittlung (full-bleed process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>A nyomozás</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-onyx-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-onyx-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-onyx-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-onyx-7.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>A megbízás elvállalása</h3><p>Arken Mallor a Hockrow Agencytől keres meg. A mobiGlas új nyomozási és adatmentési rendszerén keresztül viszi előre a nyomozást az ASD és Dr. Logan Jorrit ellen.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Belépés a létesítménybe</h3><p>Szállj le a mintegy 100 elhagyott ASD-állomás egyikén, és hatolj be gyalog. A belső terek biztosítatlanok és veszélyesek — nincs biztonság, csak romok és nyomok.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Adatmentés</h3><p>Ments ki adatokat, oldd meg a létesítmény rejtvényeit, és találd meg az elrejtett hangnaplókat. Minden lelet egy újabb darabot tesz a képhez — a regenerációs válság előtörténetéhez.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Az igazság összerakása</h3><p>A kimentett nyomok Dr. Jorrit regenerációs kísérleteiről mesélnek. Amit az ASD el akart rejteni, ott hever a törmelék és a félbeszakadt naplók között.</p></div>
    </div>
  </div>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Minden rom mögött <span class="hl">a regenerációs válság igazsága</span>.</blockquote>
    <cite>Onyx Facilities · ASD-nyomozás</cite>
  </section>

  <!-- VERSUS: Datenbergung vs Gefahr (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚠ A veszély</h3>
        <ul>
          <li>A belső terek biztosítatlanok — nincs biztonsági zóna.</li>
          <li>Romok és instabil szerkezetek biztonságos utak helyett.</li>
          <li>Amit az ASD hátrahagyott, megvédi önmagát.</li>
          <li>Mélyen a komplexumban — nincs orvosi részleg, nincs gyors újraéledés.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>★ A mentés</h3>
        <ul>
          <li>A kimentett adatok viszik előre a nyomozást.</li>
          <li>A létesítmények rejtvényei zárt nyomokat nyitnak meg.</li>
          <li>Elrejtett hangnaplók fedik fel Jorrit kísérleteit.</li>
          <li>Loot az elhagyott állomások mélyéről.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- AKTEURE — single framed/split section (the one allowed card-like layout) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-onyx-8.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">03 · A szereplők</div>
        <h3>Mallor, az ASD és Dr. Jorrit</h3>
        <p>A megbízó <b>Arken Mallor</b> a <b>Hockrow Agencytől</b>. Ő viszi előre a nyomozást az Associated Sciences and Development és <b>Dr. Logan Jorrit</b> ellen.</p>
        <p>Az elhagyott létesítmények a regenerációs válság előtörténetét mesélik el: <b>Dr. Jorrit regenerációs kísérleteit</b>. Aki átkutatja az Onyx Facilitiest, a nyomot egészen az eredetéig követi.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Personal Hangars (image as background, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-hangar-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · Szintén a 4.3.0-ban</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">PERSONAL HANGARS</div>
      <p>A 4.3.0 emellett elhozta a <b style="color:var(--accent-2)">Personal Hangarst</b>: a játékosok mostantól közvetlenül a saját, példányosított hangárjukba töltenek be az otthoni helyszínen — szilárd kiindulópont minden Dark Territorybe tett kiránduláshoz.</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery + trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-onyx-1.jpg"><img src="/assets/t-onyx-1.jpg" alt="Onyx Facility — elhagyott ASD-létesítmény" loading="lazy"><span class="zoomic">⤢</span><figcaption>Elhagyott ASD-létesítmény</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-onyx-2.jpg"><img src="/assets/t-onyx-2.jpg" alt="Romok egy Onyx Facility belsejében" loading="lazy"><span class="zoomic">⤢</span><figcaption>Romok a belsejében</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-onyx-3.jpg"><img src="/assets/t-onyx-3.jpg" alt="ASD-létesítmény kívülről — érkező hajó" loading="lazy"><span class="zoomic">⤢</span><figcaption>ASD-létesítmény · megközelítés</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/trailer-4-3-0.jpg"><img src="/assets/trailer-4-3-0.jpg" alt="Dark Territory — 4.3.0" loading="lazy"><span class="zoomic">⤢</span><figcaption>Dark Territory</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-onyx-9.jpg"><img src="/assets/t-onyx-9.jpg" alt="Egy Onyx Facility belső tere terminállal és felépítményekkel" loading="lazy"><span class="zoomic">⤢</span><figcaption>Belül · terminálok &amp; felépítmények</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="MCJlD2Meuek" style="background-image:url('/assets/trailer-4-3-0.jpg')"><span class="vlbl">Alpha 4.3.0 Dark Territory — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=MCJlD2Meuek" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-3-0-onyx-facilities" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
