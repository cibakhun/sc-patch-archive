---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Supply or Die — Star Citizen 4.0.2 | VerseBase"} description={"Supply or Die: egyszeri PvPvE utánpótlás-esemény a Pyróban — két frakció, három küldetéstípus, és a kérdés, hogy ki uralja a törvényen kívüli rendszert. Alpha 4.0.2."} themeColor="#1a1d20" ogType="article" ogImage="/assets/t-supply-1.jpg" translated={true}>
<TopicSeo slug="4-0-2-supply-or-die" image="/assets/t-supply-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

:root{--bg:#1a1d20;--bg-2:#21252a;--surface:#2a2e33;--surface-2:#33373b;--accent:#c0271f;--accent-2:#e8771a;--hot:#c0271f;--text:#ece6da;--muted:#9aa0a6;--line:rgba(192,39,31,.22);--line-soft:rgba(236,230,218,.10);--glow:0 0 44px rgba(192,39,31,.30);--ink:#1a1d20;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f8fc;--bg-2:#e9eef5;--surface:#fcfdff;--surface-2:#eef3f8;--text:#231f16;--muted:#53595e;--accent:#ac0507;--accent-2:#853f02;--hot:#9e0004;--ink:#ffffff;--accent-media:#c0271f;--accent-2-media:#e8771a;--line:rgba(164,89,79,.3);--line-soft:rgba(50,45,36,.12);--glow:0 6px 22px rgba(173,83,72,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.0.2', href: '/hu/patches/sc-4-0-2.html' }, { label: "Supply or Die" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed, kinetic) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-supply-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-0-2.html">Alpha 4.0.2 · Pyro</a> &nbsp;·&nbsp; Egyszeri esemény · 2025. február 28.</div>
      <h1><span class="thin">A Pyro utánpótlásháborúja</span>Supply or Die</h1>
      <p class="lead">PvPvE utánpótlásháború a Pyróért: állj a két frakció egyike mellé, szerezz anyagot raktárharcokkal, bányászattal és roncsmentéssel — és döntsd el, ki uralja a törvényen kívüli rendszert.</p>
      <div class="tags"><span class="tag hot">PvPvE</span><span class="tag">Event</span><span class="tag">Pyro</span><span class="tag">Frakciók</span><span class="tag">Detatrine</span></div>
      <div class="hero__play" data-lb="yt:R9p2q5fFUJk"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>SUPPLY OR DIE</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>DETATRINE</span><span class="dot">◆</span><span>PVPVE</span><span class="dot">◆</span><span>DEPOTS</span><span class="dot">◆</span>
      <span>SUPPLY OR DIE</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>DETATRINE</span><span class="dot">◆</span><span>PVPVE</span><span class="dot">◆</span><span>DEPOTS</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-2-supply-or-die" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Egymással szemben álló frakció</div></div>
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Küldetéstípus · háborús előrehaladás</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Egyszeri történet-esemény</div></div>
    <div class="s"><div class="n">PvPvE</div><div class="c">Utánpótlásháború a Pyróért</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax) — Überblick als großer overlaid Text -->
  <section class="band band--center" style="padding-top:0">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-supply-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Az utánpótlás dönt</div>
      <div class="big outline">AKI SZÁLLÍT,<br>AZ URALKODIK.</div>
      <p>A Supply or Die egyszeri, történetvezérelt PvPvE utánpótlás-esemény volt a Pyróban. Rögzített frontvonal helyett a háború az <b style="color:var(--accent-2)">anyagért</b> dúlt: minden szállítmány elmozdította a háborús előrehaladást — és ezzel azt is, melyik frakció uralta a végén a törvényen kívüli rendszert.</p>
    </div>
  </section>

  <!-- VERSUS: zwei Fraktionen (full-bleed) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>Válaszd meg az oldaladat</h2><span class="rule"></span></div></div>
  </section>
  <section style="padding:0 0 clamp(2rem,5vw,3.5rem)">
    <div class="versus reveal">
      <div class="side a">
        <h3>☣ Citizens for Prosperity</h3>
        <ul>
          <li>Ipari árukat és a ritka Detatrine vegyszert gyűjtik.</li>
          <li>Ebből orvosi utánpótlást állítanak elő.</li>
          <li>Cél: a Pyro stabilizálása és a rendszer rendbe tétele.</li>
          <li>Aki nekik szállít, ellenséggé teszi a Headhunterst.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>⚔ Headhunters</h3>
        <ul>
          <li>Roncsmentésből és bányászatból szereznek erőforrást.</li>
          <li>Minden eszközzel — a harcot és a kalózkodást is beleértve.</li>
          <li>Cél: a törvényen kívüli Pyrót a kezükben tartani.</li>
          <li>Aki nekik szállít, ellenséggé teszi a Citizenst.</li>
        </ul>
      </div>
    </div>
    <div class="wrap" style="margin-top:1.4rem"><p class="src reveal" style="margin-top:0">A játékosok a két frakció egyikét választják és annak szállítanak — a másik oldal ezzel automatikusan ellenségessé válik.</p></div>
  </section>

  <!-- SCROLLYTELLING: Drei Missionstypen, die den Krieg speisen (full-bleed process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>Három út a háború táplálására</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-facility.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-supply-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-supply-4.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Raktárharcok</h3><p>PvPvE-összecsapások a vitatott raktárakért: küzdj MI-vel és rivális játékosokkal, biztosítsd be a készleteket, és szállítsd le őket a frakciódnak.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Bányászat és finomítás</h3><p>Fejts ki nyersanyagot a Pyróban, finomítsd, és tereld az anyagot az utánpótlásba — ez minden szállítmány alapja.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Roncsmentés</h3><p>Ments ki roncsokat és hulladékot a törvényen kívüli rendszerből. A Headhunters ebből él — a többit pedig szükség esetén erőszakkal szerzi meg.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Háborús előrehaladás</h3><p>Mindhárom küldetésfajta ugyanazt a sávot tölti. Elég szállítmány, és a frakciód elbillenti a Pyro feletti uralmat.</p></div>
    </div>
  </div>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>A törvényen kívüli Pyróban nem a fegyver dönt — hanem <span class="hl">az utánpótlás</span>.</blockquote>
    <cite>Supply or Die · Alpha 4.0.2</cite>
  </section>

  <!-- DETATRINE BAND — full-bleed, design auf Bild -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-pyro-7.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · A háború nyersanyaga</div>
      <div class="big" style="font-size:clamp(2.6rem,9vw,6.5rem)">DETATRINE</div>
      <p>A Citizens for Prosperity ipari árukra és a ritka <b style="color:var(--accent-2)">Detatrine</b> vegyszerre vadászik — ez az alapanyaga annak az orvosi utánpótlásnak, amelynek stabilizálnia kell a Pyrót. Minden lefoglalt tétel csapás a Headhuntersre.</p>
    </div>
  </section>

  <!-- BELOHNUNGEN — eine framed/split Sektion (das eine erlaubte) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-supply-5.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">05 · A háború zsákmánya</div>
        <h3>Jutalom azoknak, akik szállítanak</h3>
        <p>A <b>2. fokozaton</b> a <b>Ravager-212 Outcast</b> várt — Outcast-stílusú ikersörétes, az utánpótlásháború közelharcára szabva.</p>
        <p>A <b>3. fokozaton</b> jött rá az <b>Outcast festéscsomag</b>: illő festések a MISC Fortune, a Drake Vulture és a MISC Prospector számára — a bányászat és a roncsmentés igáslovainak.</p>
      </div>
    </div>
  </section>

  <!-- MEDIA (mixed gallery + trailer, full-bleed close) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-supply-1.jpg"><img src="/assets/t-supply-1.jpg" alt="Supply or Die — utánpótlásháború a Pyróban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Utánpótlásháború · Pyro</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-supply-2.jpg"><img src="/assets/t-supply-2.jpg" alt="Raktárharc és utánpótlás" loading="lazy"><span class="zoomic">⤢</span><figcaption>Raktár és utánpótlás</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-combat.jpg"><img src="/assets/cz-combat.jpg" alt="PvPvE-összecsapás" loading="lazy"><span class="zoomic">⤢</span><figcaption>PvPvE-összecsapás</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-facility.jpg"><img src="/assets/cz-facility.jpg" alt="Üzem a Pyróban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Üzem · Pyro</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-cutlass.jpg"><img src="/assets/img-cutlass.jpg" alt="Drake Cutlass a törvényen kívüli rendszerben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Törvényen kívüli Pyro</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="R9p2q5fFUJk" style="background-image:url('/assets/trailer-4-0-0.jpg')"><span class="vlbl">Supply or Die — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=R9p2q5fFUJk" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-0-2-supply-or-die" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
