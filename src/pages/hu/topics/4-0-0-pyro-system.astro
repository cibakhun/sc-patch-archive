---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Pyro — A második csillagrendszer · Star Citizen 4.0.0 | VerseBase"} description={"Pyro: az Alpha 4.0.0-val a haldokló csillag körüli törvényen kívüli csillagrendszer lesz a Persistent Universe második, teljesen szimulált rendszere — hat romba dőlt világ, a Ruin Station és egy Stantonból nyíló ugrópont."} themeColor="#120f0c" ogType="article" ogImage="/assets/t-pyro-1.jpg" translated={true}>
<TopicSeo slug="4-0-0-pyro-system" image="/assets/t-pyro-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Pyro-Theme (System 4.0.0) */
:root{--bg:#120f0c;--bg-2:#1a1714;--surface:#211b16;--surface-2:#2b231b;--accent:#ff5a1f;--accent-2:#d9d12a;--hot:#c0271f;--text:#f3e9df;--muted:#b6a596;--line:rgba(255,90,31,.22);--line-soft:rgba(243,233,223,.10);--glow:0 0 44px rgba(255,90,31,.32);--ink:#120f0c;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#fbf7f2;--bg-2:#f1ede9;--surface:#fefdfc;--surface-2:#f9f1e9;--text:#251e17;--muted:#645547;--accent:#9e2f01;--accent-2:#5c5801;--hot:#9e0004;--ink:#ffffff;--accent-media:#ff5a1f;--accent-2-media:#d9d12a;--line:rgba(163,91,69,.3);--line-soft:rgba(52,44,37,.12);--glow:0 6px 22px rgba(171,85,59,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10.5rem)}
.moons{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.3rem}
.moons .moon{font-family:var(--font-ui);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.74rem;padding:.4rem .85rem;border:1px solid var(--line);border-radius:50px;background:var(--veil);color:var(--text)}
.moons .moon b{color:var(--accent-2);font-weight:700}
.band .big.flare{color:transparent;background:linear-gradient(180deg,var(--title-hi),var(--accent) 72%,var(--hot));-webkit-background-clip:text;background-clip:text;filter:drop-shadow(0 0 36px color-mix(in srgb,var(--accent) 50%,transparent))}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.0.0', href: '/hu/patches/sc-4-0-0.html' }, { label: "Pyro-rendszer" }]} translated={true} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-pyro-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-0-0.html">Alpha 4.0.0 · Destination Pyro</a> &nbsp;·&nbsp; Csillagrendszer</div>
      <h1><span class="thin">A második csillagrendszer</span>Pyro</h1>
      <p class="lead">Törvényen kívüli, napperzselte, bandák uralta világ: a 4.0.0-val a Pyro lesz a második teljesen szimulált csillagrendszer — hat romba dőlt világ egy haldokló csillag körül, biztonság nélkül, mentés nélkül.</p>
      <div class="tags"><span class="tag">Csillagrendszer</span><span class="tag">6 bolygó</span><span class="tag">Ruin Station</span><span class="tag hot">Törvényen kívüli</span><span class="tag">Jump Point</span></div>
      <div class="hero__play" data-lb="yt:DE3ePRgpUQo"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>PYRO</span><span class="dot">◆</span><span>6 ROMBA DŐLT VILÁG</span><span class="dot">◆</span><span>RUIN STATION</span><span class="dot">◆</span><span>FLARE STAR</span><span class="dot">◆</span><span>TÖRVÉNYEN KÍVÜL</span><span class="dot">◆</span><span>JUMP POINT</span><span class="dot">◆</span>
      <span>PYRO</span><span class="dot">◆</span><span>6 ROMBA DŐLT VILÁG</span><span class="dot">◆</span><span>RUIN STATION</span><span class="dot">◆</span><span>FLARE STAR</span><span class="dot">◆</span><span>TÖRVÉNYEN KÍVÜL</span><span class="dot">◆</span><span>JUMP POINT</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-0-pyro-system" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Teljesen szimulált rendszer a PU-ban</div></div>
    <div class="s"><div class="n count" data-to="6">0</div><div class="c">Bolygó · Pyro I–VI</div></div>
    <div class="s"><div class="n count" data-to="6">0</div><div class="c">Hold a Pyro V körül</div></div>
    <div class="s"><div class="n">0</div><div class="c">Biztonsági zóna</div></div>
  </div>

  <!-- FULL-BLEED BAND — Was ist Pyro? (parallax, image as background) -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/t-pyro-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Egy haldokló csillag</div>
      <div class="big flare">FLARE STAR</div>
      <p>A Pyro központjában fényes, haldokló csillag ég elnyújtott nóvafázisban. Körülötte <b style="color:var(--accent-2)">hat bolygó</b> kering — Pyro I-től VI-ig, romba dőlt világok, amelyeket a sugárzása nemzedékeken át perzselt. Az Alpha 4.0.0-val a Pyro Stanton után a Persistent Universe második, teljesen szimulált csillagrendszere lesz.</p>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>A Pyróban <span class="hl">nincs törvény</span> — csak a bandák, amelyek megmaradnak.</blockquote>
    <cite>Pyro · A törvényen kívüli rendszer</cite>
  </section>

  <!-- VERSUS — Stanton vs Pyro (two sides) -->
  <section style="padding:0">
    <div class="wrap" style="padding:clamp(3rem,7vw,5.5rem) clamp(1.25rem,5vw,4rem) 0">
      <div class="sec-head reveal"><span class="num">02</span><h2>Két rendszer, két világ</h2><span class="rule"></span></div>
    </div>
    <div class="versus reveal">
      <div class="side b">
        <h3>★ Stanton</h3>
        <ul>
          <li>A Persistent Universe bejáratott anyarendszere.</li>
          <li>Konszernek uralta világok renddel és törvénnyel.</li>
          <li>Biztonsági zónák és hatósági védelem.</li>
          <li>A hajóvesztés biztosított — a pótlás garantált.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side a">
        <h3>⚠ Pyro</h3>
        <ul>
          <li>A 4.0.0-val a második teljesen szimulált csillagrendszer.</li>
          <li>Nincs biztosítás, nincs mentés az elvesztett hajókra.</li>
          <li>Nincs ASOP-vészhívás, nincs behívható biztonsági erő.</li>
          <li>A haldokló csillag perzselő sugárzása mindenen átüt.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING — Die Reise nach Pyro (a process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>Az út a Pyróba</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/img-pyro.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-ruin-1.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Indulás Stantonból</h3><p>Minden Pyróba vezető út az ismerős anyarendszerben, Stantonban kezdődik — a Persistent Universe első, teljesen szimulált csillagrendszerében.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Át az ugróponton</h3><p>A rendszerek közötti alagút szűk és kanyargós — aki nekiér a falnak, kockára teszi a hajóját. Itt kalózok lesnek az utazókra, akik kíséret nélkül érkeznek ki az ugrásból.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Megérkezés a Pyróba</h3><p>A túloldalon azonnal elvakít a Flare Star: felfúvódott csillag, fakó fény, sodródó törmelék. Az első bolygók és állomások sötét sziluettként rajzolódnak ki a parázs előtt.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Ráfordulás a Ruin Stationre</h3><p>Kvantumugrás a rendszer legnagyobb jelzőpontjához: a Ruin Station kinő a sötétből — átépített bányászplatform, dokkjaiban idegen hajókkal. Ide köt ki az ember, ha üzemanyag, javítás vagy üzlet kell.</p></div>
    </div>
  </div>

  <!-- SPLIT — Ruin Station (the ONE framed/split section) -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/cz-ruin.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">04 · A központi előőrs</div>
        <h3>Ruin Station</h3>
        <p>A törvényen kívüli Pyróban a <b>Ruin Station</b> a központi találkozópont — egy régi Gold Horizon bányászplatform, amelyet rég megfosztottak eredeti rendeltetésétől.</p>
        <p>Ma a düledező szerkezet a <b>feketepiac és a bandák</b> menedéke: hely, ahol el lehet tűnni, kereskedni és új megbízást találni — ha valaki túléli a kockázatot.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Pyro V & seine Monde -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-pyro-5.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">05 · A Pyro V &amp; holdrendszere</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">HAT HOLD</div>
      <p>A Pyro V körül mindjárt hat hold kering — a nevük elárulja a természetüket: az <b style="color:var(--accent-2)">Ignis</b>, a <b style="color:var(--accent-2)">Fuego</b> és a <b style="color:var(--accent-2)">Vuur</b> különböző nyelveken „tüzet" jelent, a <b style="color:var(--accent-2)">Vatra</b> lángot és parazsat, az <b style="color:var(--accent-2)">Adir</b> és a <b style="color:var(--accent-2)">Fairo</b> pedig zord, életellenes kőzetet. Kopár, elutasító sziklavilágok, amelyekbe csempészek és bandák vájják a rejtekhelyüket.</p>
      <div class="moons">
        <span class="moon"><b>Ignis</b></span><span class="moon"><b>Vatra</b></span><span class="moon"><b>Adir</b></span><span class="moon"><b>Fairo</b></span><span class="moon"><b>Fuego</b></span><span class="moon"><b>Vuur</b></span>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Gesetzlos -->
  <section class="band" style="min-height:64vh">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-pyro-7.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Nagy kockázat · nagy fizetség</div>
      <div class="big outline">NINCS MENTÉS.</div>
      <p>Épp ez a védtelenség teszi kifizetődővé a Pyrót: ritka erőforrások, biztosítatlan rakományok és olyan megbízások, amilyeneket Stantonban senki nem ad ki. Aki itt helytáll, azt viszi el, amit meg tud védeni — és hátrahagyja, ami lelassítja.</p>
    </div>
  </section>

  <!-- MEDIA — mixed gallery + closing trailer -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-pyro-1.jpg"><img src="/assets/t-pyro-1.jpg" alt="Pyro — haldokló csillag és romba dőlt világ" loading="lazy"><span class="zoomic">⤢</span><figcaption>Pyro · Flare Star</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-pyro.jpg"><img src="/assets/img-pyro.jpg" alt="A Pyro rendszertérképe" loading="lazy"><span class="zoomic">⤢</span><figcaption>Rendszertérkép</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-pyro-2.jpg"><img src="/assets/t-pyro-2.jpg" alt="Romba dőlt világ a Pyróban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Romba dőlt világ</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-pyro-6.jpg"><img src="/assets/t-pyro-6.jpg" alt="Világító növényzet sziklatűk között egy Pyro-világon" loading="lazy"><span class="zoomic">⤢</span><figcaption>Világító növényzet</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-ruin-1.jpg"><img src="/assets/t-ruin-1.jpg" alt="Ruin Station a Terminus bolygó előtt" loading="lazy"><span class="zoomic">⤢</span><figcaption>Ruin Station · Terminus</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="DE3ePRgpUQo" style="background-image:url('/assets/trailer-4-0-0.jpg')"><span class="vlbl">Destination Pyro — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=DE3ePRgpUQo" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-0-0-pyro-system" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
