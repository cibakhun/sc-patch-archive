---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Server Meshing — Star Citizen 4.0.0 | VerseBase"} description={"Server Meshing: az Alpha 4.0.0 kulcstechnológiája. Több játékszerver szolgál ki láthatatlanul és zökkenőmentesen egyetlen shardot — a Stanton és a Pyro egyetlen közös univerzumban."} themeColor="#120f0c" ogType="article" ogImage="/assets/t-mesh-1.jpg" translated={true}>
<TopicSeo slug="4-0-0-server-meshing" image="/assets/t-mesh-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Pyro-Theme (geerbt von 4.0.0) */
:root{--bg:#120f0c;--bg-2:#1a1714;--surface:#211b16;--surface-2:#2b231b;--accent:#ff5a1f;--accent-2:#d9d12a;--hot:#c0271f;--text:#f3e9df;--muted:#b6a596;--line:rgba(255,90,31,.22);--line-soft:rgba(243,233,223,.10);--glow:0 0 44px rgba(255,90,31,.32);--ink:#120f0c;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#fbf7f2;--bg-2:#f1ede9;--surface:#fefdfc;--surface-2:#f9f1e9;--text:#251e17;--muted:#645547;--accent:#9e2f01;--accent-2:#5c5801;--hot:#9e0004;--ink:#ffffff;--accent-media:#ff5a1f;--accent-2-media:#d9d12a;--line:rgba(163,91,69,.3);--line-soft:rgba(52,44,37,.12);--glow:0 6px 22px rgba(171,85,59,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3rem,12vw,9.5rem)}
.tech-tag{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}
.band .big.layer{-webkit-text-stroke:2px var(--accent-2);color:transparent}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.0.0', href: '/hu/patches/sc-4-0-0.html' }, { label: "Server Meshing" }]} translated={true} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-mesh-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-0-0.html">Alpha 4.0.0 · Destination Pyro</a> &nbsp;·&nbsp; Technológia</div>
      <h1><span class="thin">A 4.0.0 mögötti technológia</span>Server Meshing</h1>
      <p class="lead">Az Alpha 4.0.0 kulcstechnológiája: több játékszerver szolgál ki láthatatlanul és zökkenőmentesen egyetlen shardot — több száz játékos osztozik először egyetlen összefüggő univerzumon.</p>
      <div class="tags"><span class="tag">Static Server Meshing</span><span class="tag">Replication Layer</span><span class="tag">1 Shard</span><span class="tag hot">500 játékos</span><span class="tag">Stanton + Pyro</span></div>
      <div class="hero__play" data-lb="yt:DE3ePRgpUQo"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>SERVER MESHING</span><span class="dot">◆</span><span>REPLICATION LAYER</span><span class="dot">◆</span><span>1 SHARD</span><span class="dot">◆</span><span>500 JÁTÉKOS</span><span class="dot">◆</span><span>STATIC MESH</span><span class="dot">◆</span><span>STANTON + PYRO</span><span class="dot">◆</span>
      <span>SERVER MESHING</span><span class="dot">◆</span><span>REPLICATION LAYER</span><span class="dot">◆</span><span>1 SHARD</span><span class="dot">◆</span><span>500 JÁTÉKOS</span><span class="dot">◆</span><span>STATIC MESH</span><span class="dot">◆</span><span>STANTON + PYRO</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-0-0-server-meshing" />

  <!-- FULL-BLEED BAND (parallax) — the thesis -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/img-pyro.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Évekig tartó fejlesztés után</div>
      <div class="big outline">EGY SHARD.</div>
      <p>Az Alpha 4.0.0 hozta a <b style="color:var(--accent-2)">statikus Server Meshing</b> első megvalósítását — a patch kulcstechnológiáját. Játékvilágonként egyetlen szerver helyett mostantól több szerver szimulál együtt egyetlen, zökkenőmentes univerzumot.</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="500">0</div><div class="c">Játékos shardonként</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Megosztott shard</div></div>
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Rendszerek · Stanton + Pyro</div></div>
    <div class="s"><div class="n">STATIC</div><div class="c">Server Meshing-bemutatkozás</div></div>
  </div>

  <!-- SCROLLYTELLING: Wie Meshing funktioniert (process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Hogyan működik a meshing</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/img-pyro.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-7.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-pyro-5.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>A világ felosztása</h3><p>A statikus Server Meshing a világ rögzített, előre meghatározott felosztását használja több szerver között — mindegyik az univerzum egy világosan kijelölt részét veszi át.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>A szerverek szimulálnak</h3><p>Minden játékszerver önállóan szimulálja a saját szakaszát — például a Stantont vagy a Pyrót —, miközben együtt ugyanazt a játékteret tartják.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Replication Layer</h3><p>Alatta helyezkedik el a Replication Layer, amely leválasztja a játékállás-perzisztenciát az egyes szerverekről — a világ állapota az egyes szerverektől függetlenül él.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Zökkenőmentes váltás</h3><p>Így a játékosok kapcsolatbontás nélkül váltanak a meshelt szerverek között, és az egészet egyetlen, összefüggő shardként élik meg.</p></div>
    </div>
  </div>

  <!-- VERSUS: Vorher vs Nachher (full-bleed) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚙ Egyetlen szerver</h3>
        <ul>
          <li>Egyetlen szerver visz el egy játékvilágot.</li>
          <li>Nagyjából 100 játékos ugyanabban a térben.</li>
          <li>A perzisztencia az egyes szerverhez kötve.</li>
          <li>Több rendszer együtt nem lehetséges.</li>
        </ul>
      </div>
      <div class="vs">→</div>
      <div class="side b">
        <h3>★ Server Meshing</h3>
        <ul>
          <li>Több szerver szolgál ki egy shardot.</li>
          <li>Akár 500 játékos ugyanabban a térben.</li>
          <li>A Replication Layer tartja a perzisztenciát.</li>
          <li>A Stanton és a Pyro közös shardban.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Sok szerver. <span class="hl">Egy zökkenőmentes univerzum.</span> Egyetlen varrat sem látszik.</blockquote>
    <cite>Static Server Meshing · Alpha 4.0.0</cite>
  </section>

  <!-- DER REPLICATION LAYER — single framed/split section (the only one) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-mesh-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">02 · Az alapozás</div>
        <h3>A Replication Layer</h3>
        <p>A meshing alatt fekszik a <b>Replication Layer</b> — az a réteg, amely leválasztja a játékállás-perzisztenciát az egyes játékszerverekről. A világ állapotát már nem egyetlen szerver tartja, hanem központilag replikálódik.</p>
        <p>Pontosan ez teszi lehetővé a zökkenőmentes átmenetet: a játékosok <b>kapcsolatbontás nélkül</b> váltanak a meshelt szerverek között. Ez az első lépés a későbbi <b>dinamikus Server Meshing</b> felé, amelynél a világ felosztása rugalmasan igazodik a terheléshez.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — warum es nötig war -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-pyro-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">03 · Miért egyáltalán?</div>
      <div class="big layer" style="font-size:clamp(2.4rem,8vw,6rem)">STANTON + PYRO</div>
      <p>A technológia ahhoz kellett, hogy a <b style="color:var(--accent-2)">Stanton és a Pyro</b> együtt, egy közös shardban működjön. Két teljes naprendszer egyetlen összefüggő térben — ez túllépte egyetlen szerver határait, és a meshinget a Destination Pyro előfeltételévé tette.</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery + trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-mesh-1.jpg"><img src="/assets/t-mesh-1.jpg" alt="Server Meshing — szerverfürt" loading="lazy"><span class="zoomic">⤢</span><figcaption>Szerverfürt · egy shard</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-mesh-2.jpg"><img src="/assets/t-mesh-2.jpg" alt="Replication Layer" loading="lazy"><span class="zoomic">⤢</span><figcaption>Replication Layer</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-pyro-3.jpg"><img src="/assets/t-pyro-3.jpg" alt="Széthasadt, izzó hold törmelékmezővel a Pyróban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Pyro · új rendszer</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-facility.jpg"><img src="/assets/cz-facility.jpg" alt="Pyro-Anlage" loading="lazy"><span class="zoomic">⤢</span><figcaption>Megosztott tér</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="DE3ePRgpUQo" style="background-image:url('/assets/trailer-4-0-0.jpg')"><span class="vlbl">Destination Pyro — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna és Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=DE3ePRgpUQo" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-0-0-server-meshing" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
