---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Nyx — Star Citizen 4.4.0 | VerseBase"} description={"Welcome to Nyx: az Alpha 4.4.0-val a Nyx lesz a harmadik, teljesen szimulált naprendszer — Glaciem Ring, a sziklaváros Levski és az első vanduul MI-ellenségek."} themeColor="#0c1020" ogType="article" ogImage="/assets/t-nyx-1.jpg" translated={true}>
<TopicSeo slug="4-4-0-nyx-system" image="/assets/t-nyx-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Nyx-Theme (Alpha 4.4.0) — dunkel, nebelverhangen, eisblau */
:root{
  --bg:#0c1020;--bg-2:#121a30;--surface:#16203a;--surface-2:#1d2949;
  --accent:#7fb2d9;--accent-2:#d4af37;--hot:#c0271f;
  --text:#e6edfb;--muted:#93a4c4;
  --line:rgba(127,178,217,.22);--line-soft:rgba(230,237,251,.10);
  --glow:0 0 44px rgba(127,178,217,.30);--ink:#0c1020;
  --maxw:1180px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f7fe;--bg-2:#e9eef9;--surface:#fdfdff;--surface-2:#eef2fc;--text:#1a1f29;--muted:#4e586c;--accent:#246089;--accent-2:#685301;--hot:#9e0004;--ink:#ffffff;--accent-media:#7fb2d9;--accent-2-media:#d4af37;--line:rgba(61,119,162,.3);--line-soft:rgba(41,46,56,.12);--glow:0 6px 22px rgba(61,119,162,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.4.0', href: '/hu/patches/sc-4-4-0.html' }, { label: "Nyx rendszer" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed lead media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-nyx-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-4-0.html">Alpha 4.4.0 · Welcome to Nyx</a> &nbsp;·&nbsp; Sternsystem</div>
      <h1><span class="thin">A harmadik naprendszer</span>Nyx</h1>
      <p class="lead">Sötét, aszteroidákkal sűrűn tele, ködbe burkolva: a 4.4.0-val a Nyx lesz a harmadik, teljesen szimulált naprendszer — a Glaciem Ring és a sziklába épített Levski város otthona.</p>
      <div class="tags"><span class="tag">Sternsystem</span><span class="tag">Glaciem Ring</span><span class="tag">Levski</span><span class="tag">Delamar</span><span class="tag">Peoples Alliance</span></div>
      <div class="hero__play" data-lb="yt:ilDmGyHLQNg"><span class="pbtn">▶</span>Trailer ansehen</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>NYX</span><span class="dot">◆</span><span>GLACIEM RING</span><span class="dot">◆</span><span>LEVSKI</span><span class="dot">◆</span><span>DELAMAR</span><span class="dot">◆</span><span>PEOPLES ALLIANCE</span><span class="dot">◆</span><span>DRITTES SYSTEM</span><span class="dot">◆</span>
      <span>NYX</span><span class="dot">◆</span><span>GLACIEM RING</span><span class="dot">◆</span><span>LEVSKI</span><span class="dot">◆</span><span>DELAMAR</span><span class="dot">◆</span><span>PEOPLES ALLIANCE</span><span class="dot">◆</span><span>DRITTES SYSTEM</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-4-0-nyx-system" />

  <!-- FULL-BLEED BAND — the arrival statement (parallax) -->
  <section class="band band--center">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-nyx-3.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Nach Stanton. Nach Pyro.</div>
      <div class="big outline">SYSTEM DREI.</div>
      <p>Az Alpha 4.4.0-val a Nyx harmadik, teljesen szimulált naprendszerként nyílik meg. Jump Pointokon keresztül elérve egy törvényen kívüli, ködbe burkolt világba lépsz — ez a színtere az első vanduul MI-ellenségeknek és az IAE 2955-nek.</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Voll simuliertes System · nach Stanton &amp; Pyro</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Felsenstadt · Levski in Delamar</div></div>
    <div class="s"><div class="n">VANDUUL</div><div class="c">Erste KI-Gegner · IAE 2955</div></div>
  </div>

  <!-- VERSUS: Stanton/Pyro vs Nyx — the two faces (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚠ Glaciem Ring</h3>
        <ul>
          <li>Dichter, nebelverhangener Asteroidengürtel quer durchs System.</li>
          <li>Szűk látótávolság, alig van tájékozódási pont a sziklák között.</li>
          <li>Az első vanduul MI-ellenségek vadászterülete.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>✦ Levski · Delamar</h3>
        <ul>
          <li>Leszállózóna, a Delamar aszteroidába vájva — város a sziklában.</li>
          <li>A Peoples Alliance frakció székhelye.</li>
          <li>Einziger fester Halt im sonst gesetzlosen Nyx.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: Ankunft in Nyx — der Weg ins System (full-bleed process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Ankunft in Nyx</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/trailer-4-4-0.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-nyx-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-nyx-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-levski.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Át a Jump Ponton</h3><p>A Nyx Jump Pointokon keresztül kapcsolódik az ismert verse-hez. Az Alpha 4.4.0-val a Stanton és a Pyro után harmadik, teljesen szimulált naprendszerként válik elérhetővé.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Be a Glaciem Ringbe</h3><p>Az ugráson túl fekszik a Glaciem Ring — sűrű, sötét, ködbe burkolt aszteroidaöv, amely a rendszernek a nyers, hideg arcát adja.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Törvényen kívüli terep</h3><p>A Nyx az a komor, törvényen kívüli díszlet, ahol az első vanduul MI-ellenségek felbukkannak — és ahol az IAE 2955 idejére az események csúcspontra érnek.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Megközelítés Levski felé</h3><p>Mélyen a rendszerben vár a Delamar: aszteroida, amelynek sziklájába a Levski leszállózónát építették — a Peoples Alliance frakcióhoz kötve.</p></div>
    </div>
  </div>

  <!-- GLACIEM RING — full-bleed band (image as background, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-nyx-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">02 · Az aszteroidaöv</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">GLACIEM RING</div>
      <p>Sűrű, sötét, ködbe burkolt aszteroidaöv húzódik át a rendszeren. A <b style="color:var(--accent-2)">Glaciem Ring</b> jobban meghatározza a Nyxet, mint bármely más helyszín — hideg, szűk, nehezen járható.</p>
    </div>
  </section>

  <!-- LEVSKI — the one framed/split section (50/50 media | text) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/img-levski.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">03 · Stadt im Fels</div>
        <h3>Levski — gebaut in Delamar</h3>
        <p>A rendszer közepén fekszik a <b>Delamar</b> aszteroida. A sziklájába vájták a <b>Levski</b> leszállózónát — nem keringő előőrs, hanem város a kőzetben.</p>
        <p>A Levski szorosan kötődik a <b>Peoples Alliance</b>-hoz, egy frakcióhoz, amelynek története visszatükröződik e helyszín folyosóin és csarnokaiban. Menedék az ismert világ peremén.</p>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Három rendszer. <span class="hl">A térkép új vége.</span></blockquote>
    <cite>Nyx · Alpha 4.4.0</cite>
  </section>

  <!-- MEDIA (mixed gallery + closing full-bleed trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/img-nyx.jpg"><img src="/assets/img-nyx.jpg" alt="Nyx-System — Übersichtskarte" loading="lazy"><span class="zoomic">⤢</span><figcaption>Nyx · System</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-nyx-4.jpg"><img src="/assets/t-nyx-4.jpg" alt="Glaciem Ring fénysugárral a Nyx terében" loading="lazy"><span class="zoomic">⤢</span><figcaption>Glaciem Ring</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-nyx-3.jpg"><img src="/assets/t-nyx-3.jpg" alt="A Nyx csillaga köddel" loading="lazy"><span class="zoomic">⤢</span><figcaption>Nyx · csillag</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-nyx-5.jpg"><img src="/assets/t-nyx-5.jpg" alt="A Keeger-öv a Nyxben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Keeger-öv</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-nyx-2.jpg"><img src="/assets/t-nyx-2.jpg" alt="Levski — Landekrater im Asteroiden Delamar" loading="lazy"><span class="zoomic">⤢</span><figcaption>Levski · Delamar</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="ilDmGyHLQNg" style="background-image:url('/assets/trailer-4-4-0.jpg')"><span class="vlbl">Welcome to Nyx — Trailer</span><button class="play" aria-label="Trailer abspielen">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna és Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=ilDmGyHLQNg" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-4-0-nyx-system" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Schließen">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
