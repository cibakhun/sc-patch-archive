---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Storm Breaker — Star Citizen 4.2.0 | VerseBase"} description={"Storm Breaker: az Alpha 4.2.0-val az időjárás halálos veszéllyé válik — a dinamikus eső, a repülési turbulencia és a vadonatúj sugárzásveszély Stantont és Pyrót a túlélés színterévé változtatja."} themeColor="#16142a" ogType="article" ogImage="/assets/t-storm-3.jpg" translated={true}>
<TopicSeo slug="4-2-0-storm-breaker" image="/assets/t-storm-3.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Storm-Breaker-Theme (4.2.0) */
:root{--bg:#16142a;--bg-2:#1d1a38;--surface:#252247;--surface-2:#2e2a4a;--accent:#36e2f0;--accent-2:#f5c518;--hot:#f5c518;--text:#eef1f7;--muted:#a6abc4;--line:rgba(54,226,240,.22);--line-soft:rgba(238,241,247,.10);--glow:0 0 44px rgba(54,226,240,.30);--ink:#16142a;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f7f7fe;--bg-2:#ececf8;--surface:#fdfdff;--surface-2:#f2f1fc;--text:#1d1f23;--muted:#53576c;--accent:#05676f;--accent-2:#695200;--hot:#655000;--ink:#ffffff;--accent-media:#36e2f0;--accent-2-media:#f5c518;--line:rgba(44,127,135,.3);--line-soft:rgba(44,46,50,.12);--glow:0 6px 22px rgba(44,127,135,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.kx-stat{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.2.0', href: '/hu/patches/sc-4-2-0.html' }, { label: "Storm Breaker · Az időjárás veszéllyé válik" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed cinematic) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-storm-3.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-2-0.html">Alpha 4.2.0 · Storm Breaker</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">Az időjárás veszéllyé válik</span>Storm Breaker</h1>
      <p class="lead">A 4.2.0-val az időjárás visszaüt: a dinamikus eső, a repülési turbulencia és a vadonatúj sugárzásveszély halálos színterekké változtatja a bolygókat — a közepén a Storm Breaker-tevékenységgel.</p>
      <div class="tags"><span class="tag hot">Dinamikus időjárás</span><span class="tag">Sugárzás</span><span class="tag">Turbulencia</span><span class="tag">Esőválság</span><span class="tag">Hazard</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>STORM BREAKER</span><span class="dot">◆</span><span>SUGÁRZÁS</span><span class="dot">◆</span><span>DINAMIKUS ESŐ</span><span class="dot">◆</span><span>TURBULENCIA</span><span class="dot">◆</span><span>DECONPEN</span><span class="dot">◆</span><span>HAZARD</span><span class="dot">◆</span>
      <span>STORM BREAKER</span><span class="dot">◆</span><span>SUGÁRZÁS</span><span class="dot">◆</span><span>DINAMIKUS ESŐ</span><span class="dot">◆</span><span>TURBULENCIA</span><span class="dot">◆</span><span>DECONPEN</span><span class="dot">◆</span><span>HAZARD</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-2-0-storm-breaker" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="190">0</div><div class="c">Hiba- és összeomlásjavítás</div></div>
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Új időjárási veszély</div></div>
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Rendszer: Stanton & Pyro</div></div>
    <div class="s"><div class="n">∞</div><div class="c">A sugárzás felépül — védelem nélkül halálos</div></div>
  </div>

  <!-- FULL-BLEED OPENING BAND (parallax, design over media) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-storm-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Az időjárás visszaüt</div>
      <div class="big outline">ESIK AZ ESŐ.</div>
      <p>Az Alpha 4.2.0 <b style="color:var(--accent-2)">dinamikus esőt és dinamikus időjárást</b> hoz a stantoni és pyrói helyszínekre. Ami egykor díszlet volt, most aktív fenyegetés — az ég is beleszól abba, hogy leszállsz-e vagy lezuhansz.</p>
    </div>
  </section>

  <!-- OVERVIEW as full-bleed band (right) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-storm-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">02 · Storm Breaker</div>
      <div class="big" style="font-size:clamp(2.4rem,8vw,6rem)">A TEVÉKENYSÉG</div>
      <p>A patch középpontjában a névadó <b style="color:var(--accent-2)">Storm Breaker-tevékenység</b> áll — szorosan a folyamatos <b style="color:var(--accent-2)">esőválság-történethez</b> kötve. Az időjárás már nem csak hangulat, hanem játékcél: aki a viharba repül, a természeti erőkkel keresi a konfliktust.</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: Anatomie eines Sturms -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>Egy vihar anatómiája</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-storm-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-storm-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-storm-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-storm-7.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Időjárás-fordulat</h3><p>A stantoni és pyrói helyszíneken dinamikus időjárás vonul fel — megered az eső, csökken a látótávolság, a talaj kiszámíthatatlan tényezővé válik.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Turbulencia</h3><p>A viharok repülési turbulenciát keltenek, amely rontja a repülési stabilitást. A precíz megközelítés meginog — minden széllökés rángatja az irányt.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>VTOL a határon</h3><p>Különösen kényes: a VTOL-manőverek viharban jóval nehezebbé válnak. A lebegés és a függőleges leszállás most teljes összpontosítást kíván.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Nő a sugárzás</h3><p>Mindenek felett ott az új veszély: a sugárzás idővel felépül. Védelem nélkül halálos — a vihar csendben is öl.</p></div>
    </div>
  </div>

  <!-- MANIFESTO (pull-quote) -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Az ég többé nem <span class="hl">díszlet</span>. Az ég az ellenfél.</blockquote>
    <cite>Storm Breaker · Alpha 4.2.0</cite>
  </section>

  <!-- VERSUS: Sturm vs Schutz (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚠ A veszély</h3>
        <ul>
          <li>A dinamikus eső rontja a látást és az irányítást.</li>
          <li>A turbulencia lenyomja a repülési stabilitást.</li>
          <li>A VTOL-manőverek viharban idegtépővé válnak.</li>
          <li>A sugárzás felépül — védtelenül halálos.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>★ Az ellenszer</h3>
        <ul>
          <li>CureLife DeconPen Xtra vészhelyzeti injektorként.</li>
          <li>Canoiodidot fecskendez be a sugárzás ellen.</li>
          <li>Hatóanyagként ráadásul Hemozalt is bead.</li>
          <li>Aki időben szúr, túléli a felépülő dózist.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FRAMED SPLIT (the one allowed card section) — DeconPen detail -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/trailer-4-2-0.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">04 · Az ellenszer</div>
        <h3>CureLife DeconPen Xtra</h3>
        <p>Az új sugárzásveszélyre pontosan egy válasz van: a <b>CureLife DeconPen Xtra</b>. Az injektor <b>Canoiodidot</b> és <b>Hemozalt</b> juttat közvetlenül a véráramba, és időt vásárol a növekvő dózis ellen.</p>
        <p>A sugárzás azért alattomos, mert <b>csendben, idővel épül fel</b> — aki túl későn kapja elő a DeconPent, már veszített. A vihar-felszerelésben 4.2.0-tól kötelező darab.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED CLOSING BAND (radiation) -->
  <section class="band band--center">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/t-storm-8.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">05 · A láthatatlan veszély</div>
      <div class="big outline">SUGÁRZÁS.</div>
      <p>Vadonatúj a 4.2.0-ban, és más, mint bármi korábban: a sugárzás olyan környezeti veszély, amely idővel felépül, és védelem nélkül <b style="color:var(--accent-2)">halálos</b> véget ér. Elővigyázatosságra kényszerít — mert ha a számláló felmegy, a visszavonulás sem segít.</p>
    </div>
  </section>

  <!-- MEDIA (mixed full-bleed gallery, no video embed) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-storm-1.jpg"><img src="/assets/t-storm-1.jpg" alt="Storm Breaker — vihar a helyszín felett" loading="lazy"><span class="zoomic">⤢</span><figcaption>Vihar a helyszín felett</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-storm-2.jpg"><img src="/assets/t-storm-2.jpg" alt="Dinamikus időjárás — viharrendszer az orbitról" loading="lazy"><span class="zoomic">⤢</span><figcaption>Dinamikus eső</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-storm-3.jpg"><img src="/assets/t-storm-3.jpg" alt="Vihar villámmal és esővel — a 4.2.0 kulcsképe" loading="lazy"><span class="zoomic">⤢</span><figcaption>A vihar szemében</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-2-0.jpg"><img src="/assets/trailer-4-2-0.jpg" alt="Alpha 4.2.0 Storm Breaker" loading="lazy"><span class="zoomic">⤢</span><figcaption>Alpha 4.2.0 · Storm Breaker</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="/hu/patches/sc-4-2-0.html">A 4.2.0 patch-áttekintéshez ↗</a></p>
    </div>
  </section>

  {/* Kein OnepagerLink: den Onepager gibt es nur auf Deutsch — die EN-Seite
      laesst ihn aus demselben Grund weg. */}

</main>

<RelatedTopics topicSlug="4-2-0-storm-breaker" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
