---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Frontier Fighters — Star Citizen 4.3.2 | VerseBase"} description={"Frontier Fighters: az Alpha 4.3.2 'Fractured Frontiers' nagy fináléja. A Headhunters és a Citizens for Prosperity három fázison át üldözi Amelia Boyd Frontier Fightersét Stantonon és Pyrón keresztül — egészen a szerverszintű Polaris-levadászásig."} themeColor="#16181b" ogType="article" ogImage="/assets/t-front-1.jpg" translated={true}>
<TopicSeo slug="4-3-2-frontier-fighters" image="/assets/t-front-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Fractured-Frontiers-Theme (4.3.2) */
:root{--bg:#16181b;--bg-2:#1d2024;--surface:#23272b;--surface-2:#2c3137;--accent:#B5642A;--accent-2:#E4B400;--hot:#8E1F1F;--text:#ede6db;--muted:#a89d8e;--line:rgba(181,100,42,.22);--line-soft:rgba(237,230,219,.10);--glow:0 0 44px rgba(181,100,42,.30);--ink:#16181b;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f8fc;--bg-2:#eaeef4;--surface:#fcfeff;--surface-2:#edf3fb;--text:#231e16;--muted:#605649;--accent:#8d4402;--accent-2:#6a5200;--hot:#9a1118;--ink:#ffffff;--accent-media:#B5642A;--accent-2-media:#E4B400;--line:rgba(159,96,54,.3);--line-soft:rgba(50,45,37,.12);--glow:0 6px 22px rgba(166,91,37,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.phasetag{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.78rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.3.2', href: '/hu/patches/sc-4-3-2.html' }, { label: "Frontier Fighters" }]} translated={true} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-front-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-3-2.html">Alpha 4.3.2 · Fractured Frontiers</a> &nbsp;·&nbsp; Fináléesemény</div>
      <h1><span class="thin">A finálé · Pyro Must Burn</span>Frontier Fighters</h1>
      <p class="lead">A 4.3.2 nagy fináléja: a Headhunters és a Citizens for Prosperity szövetkezik, hogy három fázison át, Stantonon és Pyrón keresztül terítse le Amelia Boyd Frontier Fightersét.</p>
      <div class="tags"><span class="tag hot">Fináléesemény</span><span class="tag">3 fázis</span><span class="tag">Headhunters + CFP</span><span class="tag">Amelia Boyd</span><span class="tag">Polaris-levadászás</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>PYRO MUST BURN</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>AMELIA BOYD</span><span class="dot">◆</span><span>3 FÁZIS</span><span class="dot">◆</span>
      <span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>PYRO MUST BURN</span><span class="dot">◆</span><span>HEADHUNTERS</span><span class="dot">◆</span><span>CITIZENS FOR PROSPERITY</span><span class="dot">◆</span><span>AMELIA BOYD</span><span class="dot">◆</span><span>3 FÁZIS</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-3-2-frontier-fighters" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Fázis a levadászásig</div></div>
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Szövetséges frakció</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Üldözött Polaris</div></div>
    <div class="s"><div class="n">FINALE</div><div class="c">A Pyro-történet zárófejezete</div></div>
  </div>

  <!-- FULL-BLEED BAND — Auftakt / Überblick als Riesentext über Standbild -->
  <section class="band band--center" style="padding-top:0">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/cz-ruin.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">A 4.3.2 zárófejezete</div>
      <div class="big outline">PYRO MUST BURN.</div>
      <p>A Frontier Fighters-finálé az Alpha 4.3.2 narratív zárófejezete — a <b style="color:var(--accent-2)">Pyro Must Burn</b>-történet csúcspontja, amely Stantonon és Pyrón keresztül bontakozik ki, és az egész Verse-t egyetlen hajszába rántja.</p>
    </div>
  </section>

  <!-- MANIFESTO — early pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Ezúttal <span class="hl">az egész szerver</span> ugyanazt a célt üldözi.</blockquote>
    <cite>Frontier Fighters · Finale 4.3.2</cite>
  </section>

  <!-- VERSUS: Die Allianz vs. die Frontier Fighters (full-bleed) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚔ A Frontier Fighters</h3>
        <ul>
          <li>Törvényen kívüli frakció a 4.3.2 fináléjának középpontjában.</li>
          <li>Vezetőjük <b>Amelia Boyd</b>.</li>
          <li>Stantontól a Pyro mélyéig tevékenykednek.</li>
          <li>Az eszkalációban ellopnak egy teljes Polarist.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>★ A szövetség</h3>
        <ul>
          <li>Headhunters és Citizens for Prosperity — itt szövetségesek.</li>
          <li>Közös hajsza Boyd Fightersére.</li>
          <li>Mindhárom fázison át összehangoltan dolgoznak.</li>
          <li>A Verse-t a végső levadászás felé hajtják.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: Die drei Phasen als Eskalations-Prozess -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Három fázis a levadászásig</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-ffp-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-facility.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/cz-combat.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-1.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">00</div><h3>Szövetség alakul</h3><p>A Headhunters és a Citizens for Prosperity félreteszi a nézeteltéréseit, és összefog, hogy célkeresztbe vegye az Amelia Boyd köré szerveződő Frontier Fighterst.</p></div>
      <div class="sstep"><div class="sn">01</div><h3>Első fázis · felderítés</h3><p>Az eszkaláció nyitánya: a szövetség Stantonon és Pyrón keresztül felderíti a Frontier Fighters mozgásait, és kijelöli a csatateret.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Második fázis · ostrom</h3><p>A hajsza sűrűsödik. A felderítésből nyomás lesz — a szövetségesek a támaszpontjaikon szorongatják Boyd Fightersét, és sarokba szorítják őket.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Harmadik fázis · a levadászás</h3><p>A záró fázisban az egész szerver együtt üldözi azt az egy Polarist, amelyet a Frontier Fighters ellopott — az egész finálé csúcspontja.</p></div>
    </div>
  </div>

  <!-- FULL-BLEED BAND — Der Polaris-Takedown -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/img-polaris.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="phasetag">Harmadik fázis · szerveresemény</div>
      <div class="big" style="font-size:clamp(2.4rem,8vw,6rem)">EGY POLARIS.<br>EGY SZERVER.</div>
      <p>A Frontier Fighters ellopott egy teljes Polarist — és a fináléban már csak egy számít: az egész Verse közösen üldözi ezt az egyetlen hajót. A szerverszintű levadászás teszi ki a pontot a Pyro Must Burn-történet végére.</p>
    </div>
  </section>

  <!-- SPLIT — der EINE gerahmte Abschnitt: weitere 4.3.2-Inhalte (Paladin, Yormandi, Salvage) -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/img-paladin.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">02 · Mi mást hozott még a 4.3.2</div>
        <h3>Több, mint pusztán a finálé</h3>
        <p>A Frontier Fighters-esemény köré az Alpha <b>4.3.2 „Fractured Frontiers"</b> érezhetően többet is szállított: a patch fő hajója az <b>Anvil Paladin</b>.</p>
        <p>Ehhez jött a <b>Yormandi-boss</b> az Onyx-barlangokban az <b>ASD Site B</b> helyszínen, valamint egy átfogó <b>roncsmentés- és finomítás-átdolgozás</b> — tartalmak, amelyek a fináléon túl is megmaradnak.</p>
      </div>
    </div>
  </section>

  <!-- CLOSING — full-bleed mixed gallery (kein offizielles Video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">03</span><h2>Képgaléria</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-front-1.jpg"><img src="/assets/t-front-1.jpg" alt="Frontier Fighters — fináléesemény" loading="lazy"><span class="zoomic">⤢</span><figcaption>Frontier Fighters · finálé</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-pyro.jpg"><img src="/assets/img-pyro.jpg" alt="A Pyro-rendszer — a hajsza színtere" loading="lazy"><span class="zoomic">⤢</span><figcaption>Pyro · helyszín</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-combat.jpg"><img src="/assets/cz-combat.jpg" alt="Összecsapás a hajsza közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Ostrom</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/cz-facility.jpg"><img src="/assets/cz-facility.jpg" alt="Üzem a Pyróban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Felderítés</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-polaris.jpg"><img src="/assets/img-polaris.jpg" alt="Az ellopott Polaris" loading="lazy"><span class="zoomic">⤢</span><figcaption>Az ellopott Polaris</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-paladin.jpg"><img src="/assets/img-paladin.jpg" alt="Anvil Paladin — a patch fő hajója" loading="lazy"><span class="zoomic">⤢</span><figcaption>Anvil Paladin · fő hajó</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: Star Citizen Wiki &amp; hivatalos közösségi források (© Cloud Imperium Games). A képek illusztrációk.</p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-3-2-frontier-fighters" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
