---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"XenoThreat — Star Citizen 4.8.3 | VerseBase"} description={"XenoThreat: emberfelsőbbség-hirdető, idegenellenes törvényen kívüli frakció — az Alpha 4.8.3-mal az Assault on Stanton pontalapú harci eseményként tér vissza (2026. július 1–15., 120 000 eseménypont, tervrajz-jutalmak)."} themeColor="#0d0a16" ogType="article" ogImage="/assets/t-xeno-1.jpg" translated={true}>
<TopicSeo slug="4-8-3-xenothreat" image="/assets/t-xeno-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Tactical-Strike-Theme (4.8.x) */
:root{--bg:#0d0a16;--bg-2:#140f24;--surface:#1a1330;--surface-2:#231a3e;--accent:#E8651E;--accent-2:#1FB8A6;--hot:#E8651E;--text:#ede9f5;--muted:#a39db5;--line:rgba(232,101,30,.22);--line-soft:rgba(237,233,245,.10);--glow:0 0 44px rgba(232,101,30,.30);--ink:#0d0a16;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f8f6ff;--bg-2:#eeecf8;--surface:#fdfdff;--surface-2:#f2f1fb;--text:#201e26;--muted:#5a546a;--accent:#963a01;--accent-2:#056359;--hot:#893400;--ink:#ffffff;--accent-media:#E8651E;--accent-2-media:#1FB8A6;--line:rgba(162,93,63,.3);--line-soft:rgba(46,44,53,.12);--glow:0 6px 22px rgba(170,87,49,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.kx-tag{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.8.3', href: '/hu/patches/sc-4-8-3.html' }, { label: "XenoThreat" }]} translated={true} />


<main id="main">

  <!-- HERO -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-xeno-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-8-3.html">Alpha 4.8.3 · XenoThreat</a> &nbsp;·&nbsp; Frakció</div>
      <h1><span class="thin">Támadás a Stanton ellen</span>XenoThreat</h1>
      <p class="lead">Emberfelsőbbség-hirdető, idegenellenes törvényen kívüli frakció: a 4.8.3-mal visszatér az Assault on Stanton eseményük — ezúttal nem mozivászonra való szerverháborúként, hanem pontalapú PvE harci eseményként 2026. július 1-jétől 15-éig.</p>
      <div class="tags"><span class="tag hot">Törvényen kívüli frakció</span><span class="tag">Assault on Stanton</span><span class="tag">Pontalapú esemény</span><span class="tag">Foxwell Enforcement</span><span class="tag">Idris-célpont</span></div>
      <div class="hero__play" data-lb="yt:SsOtI2dtvBc"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>XENOTHREAT</span><span class="dot">◆</span><span>ASSAULT ON STANTON</span><span class="dot">◆</span><span>FOXWELL ENFORCEMENT</span><span class="dot">◆</span><span>120 000 PONT</span><span class="dot">◆</span><span>5 KÜLDETÉSTÍPUS</span><span class="dot">◆</span><span>IDRIS FREGATT</span><span class="dot">◆</span>
      <span>XENOTHREAT</span><span class="dot">◆</span><span>ASSAULT ON STANTON</span><span class="dot">◆</span><span>FOXWELL ENFORCEMENT</span><span class="dot">◆</span><span>120 000 PONT</span><span class="dot">◆</span><span>5 KÜLDETÉSTÍPUS</span><span class="dot">◆</span><span>IDRIS FREGATT</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-8-3-xenothreat" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="120000">0</div><div class="c">Eseménypont a teljes jutalomsávhoz</div></div>
    <div class="s"><div class="n count" data-to="5">0</div><div class="c">Küldetéstípus gyűjt pontot</div></div>
    <div class="s"><div class="n">JÚLIUS 1–15.</div><div class="c">Eseményablak 2026</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax) — wer ist XenoThreat -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-xeno-3.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">A Pyro romjaiból</div>
      <div class="big outline">ÁRULÁS.</div>
      <p>A XenoThreat emberfelsőbbség-hirdető, idegenellenes törvényen kívüli csoport a Pyróból — nagyrészt egykori <b style="color:var(--accent-2)">UEE-haditengerészek</b>, akik az UEE idegen fajokkal való együttélését az emberiség elárulásának tekintik. Mivel a Stanton támogatja ezt az együttélést, a XenoThreat megtámadja a rendszert.</p>
    </div>
  </section>

  <!-- OVERVIEW as SPLIT (the one framed/split section) -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-hh-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">01 · Kik ők</div>
        <h3>Dezertőrök egy doktrínával</h3>
        <p>Ami a XenoThreatet megkülönbözteti a közönséges törvényen kívüliektől, az a meggyőződés. Képzett katonák, akik felmondták a hűségüket az UEE-nek — abban a hitben, hogy az idegen fajokkal kötött szövetség elárulja az emberiséget.</p>
        <p>A Pyro törvényen kívüli mélységeiből nem puszta bandát formálnak, hanem <b>félkatonai frakciót</b> hajókkal, fegyelemmel és egyetlen céllal: ott ütni a Stantont, ahol a legnyíltabban éli meg az idegenekkel való együttélést.</p>
      </div>
    </div>
  </section>

  <!-- HISTORY — full-bleed band (image as background, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/cz-ruin.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">02 · A történelmi nyitány (2951)</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">STANTON 2951</div>
      <p>A XenoThreat már 2951-ben lerohant egy Terra felé tartó polgári konvojt a Stantonban — minden hajót megsemmisítettek, a legénységet kivégezték. Az UEE haditengerészete mozgósította a <b style="color:var(--accent-2)">Civilian Defense Force</b>-ot; tizenegy nap harc után a XenoThreat visszavonult a Pyróba. A 4.8.3 visszahozza őket.</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: Die fünf Missionstypen -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>Öt út a pontgyűjtéshez</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-xeno-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-hammerhead.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-hh-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-def-2.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-idris.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Idegen hajók védelme</h3><p>Az idegenek építette hajók az izolacionisták tüze alá kerülnek — a játékosok tartják őket szabadon.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Idegenellenes vadászgépek kiiktatása</h3><p>Idegengyűlölő vadászgép-hullámok érkeznek, és el kell fogni őket.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Kötelékek elfogása</h3><p>Az érkező, kirekesztő elitistákat felkutatjuk és megsemmisítjük.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Hadnagyok kicsalogatása</h3><p>Az idegengyűlölő vezetőket kicsaljuk és legyőzzük, hogy gyengítsük a parancsnoki struktúrát.</p></div>
      <div class="sstep"><div class="sn">05</div><h3>Idris fregatt</h3><p>A kapitálishajó-célpont: az Idrist vagy megsemmisíteni, vagy a pilótáját kiiktatni — a sáv legigényesebb megbízása.</p></div>
    </div>
  </div>

  <!-- REWARD BAND -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/cz-loot.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · A jutalomsáv</div>
      <div class="big">120 000 PONT</div>
      <p>A 4.8.3 harci pontfarmolás: az előrehaladást a napló követi, a standard küldetések nagyjából 4 000 pontot adnak. Aki felküzdi magát a teljes, <b style="color:var(--accent-2)">120 000 eseménypontos</b> sávra, <b style="color:var(--accent-2)">egyedi tervrajzokat</b> nyit meg, amelyek a jövőbeli frissítéseken át is megmaradnak.</p>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Öt front, egy cél: az <span class="hl">Idris</span> elesik — vagy a Stanton meghajol az idegengyűlölet előtt.</blockquote>
    <cite>XenoThreat · Assault on Stanton (4.8.3)</cite>
  </section>

  <!-- MEDIA (mixed gallery + trailer) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-xeno-1.jpg"><img src="/assets/t-xeno-1.jpg" alt="XenoThreat-alakulatok a Stanton felett" loading="lazy"><span class="zoomic">⤢</span><figcaption>XenoThreat · alakulatok</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-xeno-2.jpg"><img src="/assets/t-xeno-2.jpg" alt="XenoThreat harcban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Harcban</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-idris.jpg"><img src="/assets/img-idris.jpg" alt="Idris fregatt mint nagyhajó-célpont" loading="lazy"><span class="zoomic">⤢</span><figcaption>Idris · Nagyhajó-célpont</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt="Hammerhead ágyúnaszád" loading="lazy"><span class="zoomic">⤢</span><figcaption>Hammerhead ágyúnaszád</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-xeno-3.jpg"><img src="/assets/t-xeno-3.jpg" alt="XenoThreat propagandaadás összegyűlt tömeg előtt" loading="lazy"><span class="zoomic">⤢</span><figcaption>Propagandaadás</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="SsOtI2dtvBc" style="background-image:url('/assets/t-hh-1.jpg')"><span class="vlbl">XenoThreat — Assault on Stanton</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna és Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=SsOtI2dtvBc" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-3-xenothreat" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
