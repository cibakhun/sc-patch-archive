---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Engineering — Star Citizen 4.5.0 | VerseBase"} description={"Dawn of Engineering: az Alpha 4.5.0-val maga a hajóüzemeltetés válik játékmenetté — energiaelosztás, a Ship Armor kezelése, tűzoltás. Ráadásul a Vulkan lesz az alapértelmezett renderer, és kísérleti VR-támogatás érkezik."} themeColor="#0f1316" ogType="article" ogImage="/assets/t-eng-3.jpg" translated={true}>
<TopicSeo slug="4-5-0-engineering" image="/assets/t-eng-3.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Engineering-Theme (geerbt von 4.5.0 "Dawn of Engineering") */
:root{--bg:#0f1316;--bg-2:#151a1e;--surface:#1c2024;--surface-2:#262c31;--accent:#FFB000;--accent-2:#2BC4C4;--hot:#D7263D;--text:#e9eef0;--muted:#9aa7ac;--line:rgba(255,176,0,.22);--line-soft:rgba(233,238,240,.10);--glow:0 0 44px rgba(255,176,0,.30);--ink:#0f1316;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f2f8fd;--bg-2:#e8eff5;--surface:#fcfeff;--surface-2:#ecf4fa;--text:#1c2021;--muted:#4f5a5f;--accent:#7a5201;--accent-2:#056262;--hot:#9d0223;--ink:#ffffff;--accent-media:#FFB000;--accent-2-media:#2BC4C4;--line:rgba(146,105,37,.3);--line-soft:rgba(42,47,48,.12);--glow:0 6px 22px rgba(146,105,37,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.kx-hot{color:var(--hot)!important}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.5.0', href: '/hu/patches/sc-4-5-0.html' }, { label: "Engineering" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-eng-3.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-5-0.html">Alpha 4.5.0 · Dawn of Engineering</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">A hajó válik csatatérré</span>Engineering</h1>
      <p class="lead">A 4.5.0-val maga a hajóüzemeltetés válik játékmenetté: energiaelosztás, a páncélzat kezelése, tűzoltás — aki túléli a harcot, az működésben tartja a hajóját.</p>
      <div class="tags"><span class="tag">Engineering</span><span class="tag">Ship Armor</span><span class="tag hot">Tűzveszély</span><span class="tag">Power Management</span><span class="tag">VR</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>ENGINEERING</span><span class="dot">◆</span><span>SHIP ARMOR</span><span class="dot">◆</span><span>TŰZVESZÉLY</span><span class="dot">◆</span><span>POWER MANAGEMENT</span><span class="dot">◆</span><span>VULKAN</span><span class="dot">◆</span><span>VR</span><span class="dot">◆</span>
      <span>ENGINEERING</span><span class="dot">◆</span><span>SHIP ARMOR</span><span class="dot">◆</span><span>TŰZVESZÉLY</span><span class="dot">◆</span><span>POWER MANAGEMENT</span><span class="dot">◆</span><span>VULKAN</span><span class="dot">◆</span><span>VR</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-5-0-engineering" />

  <!-- INTRO as FULL-BLEED BAND (parallax, big overlaid text) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-eng-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Dawn of Engineering</div>
      <div class="big outline">TARTSD MŰKÖDÉSBEN.</div>
      <p>Leomlanak a pajzsok, kiégnek a komponensek, fogy az energia. A 4.5.0-ban már nem csak az dönt, milyen jól repülsz — hanem az is, mennyire tudod <b style="color:var(--accent-2)">életben tartani</b> a hajódat a harcban.</p>
    </div>
  </section>

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="4">0</div><div class="c">Új rendszer · Engineering, Armor, tűz, energia</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Fizikai páncélréteg a hajótesten</div></div>
    <div class="s"><div class="n">VULKAN</div><div class="c">Alapértelmezett renderer 4.5.0-tól</div></div>
    <div class="s"><div class="n">VR</div><div class="c">Kísérleti · Vulkanon keresztül</div></div>
  </div>

  <!-- OVERVIEW — single split section (the ONE framed/split allowed) -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-eng-4.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">01 · Engineering-játékmenet</div>
        <h3>A gépházból pilótafülke lesz</h3>
        <p>Egy <b>Engineering-terminálon</b> a játékosok valós időben követik a hajójuk állapotát — és menet közben javítják a sérült komponenseket. Ami eddig láthatatlanul futott a háttérben, most aktív fedélzeti feladattá válik.</p>
        <p>A többszemélyes hajón így önálló szerep születik: míg egyesek repülnek és tüzelnek, a mérnök működésben tartja a reaktort, a pajzsokat és a hajtóművet. A hajók eszközből <b>legénységi élménnyé</b> válnak.</p>
      </div>
    </div>
  </section>

  <!-- VERSUS: Ship Armor vs Feuer-Hazard (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="wrap" style="padding:clamp(2.5rem,6vw,4.5rem) 0 1.4rem"><div class="sec-head reveal"><span class="num">02</span><h2>Védelem &amp; veszély</h2><span class="rule"></span></div></div>
    <div class="versus reveal">
      <div class="side b">
        <h3>★ Ship Armor</h3>
        <ul>
          <li>Önálló fizikai réteg a hajótest és a komponensek felett.</li>
          <li>Elnyeli a beérkező sebzést, mielőtt elérné a szerkezetet.</li>
          <li>Idővel elkopik — a páncélzat véges.</li>
          <li>A sérüléskezelést stratégiai döntéssé teszi.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side a">
        <h3>⚠ Tűzveszély</h3>
        <ul>
          <li>A tűz dinamikusan terjed szét a hajón.</li>
          <li>Felemészti az oxigént — a fedélzeti légkör veszélyessé válik.</li>
          <li>Átterjed a szomszédos terekre, ha nem teszel semmit.</li>
          <li>Aktívan el kell oltani — magától nem alszik ki.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: So ueberlebst du ein Gefecht (process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>Válságkezelés a fedélzeten</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-eng-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-eng-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-eng-7.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-eng-8.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Találatot bezsebelni</h3><p>A beérkező tűz először a Ship Armort éri. A páncélréteg elnyeli a sebzést — de minden találattal tovább kopik.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Helyzetfelmérés</h3><p>Az Engineering-terminálon látszik, mely komponensek sérültek, hol hiányzik az energia, és hol lett már veszélyesen forró a helyzet.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Tűzoltás</h3><p>Ha tűz üt ki, felemészti az oxigént, és átterjed a szomszédos terekre. Aktívan el kell oltani, mielőtt végigrágja magát a hajón.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Javítás &amp; tovább</h3><p>A sérült komponensek valós időben javulnak, az energia újraosztódik — és a hajó harcban marad. Aki ezt uralja, az túlél.</p></div>
    </div>
  </div>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Repülni bárki tud. <span class="hl">Életben tartani</span> — az a művészet.</blockquote>
    <cite>Dawn of Engineering · Alpha 4.5.0</cite>
  </section>

  <!-- POWER MANAGEMENT — full-bleed band (image as background, design on top) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/trailer-4-5-0.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · Power Management</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">MINDEN WATT SZÁMÍT</div>
      <p>Az energia valós időben oszlik el a komponensek között — több teljesítmény a pajzsoknak, a hajtóműveknek vagy a fegyvereknek, a helyzettől függően. A <b style="color:var(--hot)">túlterhelés</b> viszont hőt, kimaradást és sérülést okoz. Aki mindent egyszerre akar, azt kockáztatja, hogy semmi sem működik.</p>
    </div>
  </section>

  <!-- TECH BAND: Vulkan & VR (full-bleed, big overlaid text) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-eng-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">05 · A motorháztető alatt</div>
      <div class="big">VULKAN &amp; VR</div>
      <p>A 4.5.0-tól a <b style="color:var(--accent-2)">Vulkan</b> az alapértelmezett renderer, és leváltja a DirectX 11-et — az API 3.23 óta jelen van a játékban. Erre a pipeline-ra épül az új, <b>kísérleti VR-támogatás</b>: első lépés afelé, hogy szemüvegen át éld át a Verse-t.</p>
    </div>
  </section>

  <!-- MEDIA — closing mixed gallery (no video embed) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-eng-1.jpg"><img src="/assets/t-eng-1.jpg" alt="Engineering — hajóüzemeltetés harc közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Engineering · hajóüzemeltetés</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-eng-2.jpg"><img src="/assets/t-eng-2.jpg" alt="Sérülés- és komponenskezelés" loading="lazy"><span class="zoomic">⤢</span><figcaption>Komponensek tűz alatt</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/trailer-4-5-0.jpg"><img src="/assets/trailer-4-5-0.jpg" alt="Dawn of Engineering — kulcsillusztráció" loading="lazy"><span class="zoomic">⤢</span><figcaption>Dawn of Engineering</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-eng-4.jpg"><img src="/assets/t-eng-4.jpg" alt="Az Engineering-terminál a fedélzeten" loading="lazy"><span class="zoomic">⤢</span><figcaption>Engineering-terminál</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-eng-3.jpg"><img src="/assets/t-eng-3.jpg" alt="Legénység a hajó belsejében a harc közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Legénység a gépházban</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). Nem hivatalos rajongói feldolgozás.</p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-5-0-engineering" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
