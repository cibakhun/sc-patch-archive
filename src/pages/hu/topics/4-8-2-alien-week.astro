---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Alien Week — Star Citizen 4.8.2 | VerseBase"} description={"Alien Week: a nem emberi gyártók éves ünnepe a First Contact Day körül — a 2956-os évad fő fellépői a Gatac Railen, Syulen és Tyilui."} themeColor="#0c0a16" ogType="article" ogImage="/assets/t-alien-1.jpg" translated={true}>
<TopicSeo slug="4-8-2-alien-week" image="/assets/t-alien-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Strike / Xenotech-Theme (4.8.x) */
:root{--bg:#0c0a16;--bg-2:#140f24;--surface:#1a1330;--surface-2:#231a3e;--accent:#1FB8A6;--accent-2:#E8651E;--hot:#E8651E;--text:#e8f0ef;--muted:#9ab0ad;--line:rgba(31,184,166,.22);--line-soft:rgba(232,240,239,.10);--glow:0 0 44px rgba(31,184,166,.30);--ink:#0c0a16;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f7f6ff;--bg-2:#eeecf8;--surface:#fdfdff;--surface-2:#f2f1fb;--text:#1b2120;--muted:#495d5a;--accent:#046a5f;--accent-2:#8d3601;--hot:#893400;--ink:#ffffff;--accent-media:#1FB8A6;--accent-2-media:#E8651E;--line:rgba(43,129,118,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,129,118,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.xeyebrow{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.8.2', href: '/hu/patches/sc-4-8-2.html' }, { label: "Alien Week 2956" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed media) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-alien-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-8-2.html">Alpha 4.8.2 · Gatac &amp; Alien Week</a> &nbsp;·&nbsp; Event</div>
      <h1><span class="thin">First Contact Day 2956</span>Alien Week</h1>
      <p class="lead">A nem emberi gyártók éves ünnepe: a First Contact Day körül az Alien Week a xenotechet állítja reflektorfénybe — a fő fellépők a Gatac Railen, Syulen és Tyilui.</p>
      <div class="tags"><span class="tag hot">Event</span><span class="tag">First Contact Day</span><span class="tag">Gatac</span><span class="tag">Aopoa</span><span class="tag">Xenotech</span></div>
      <div class="hero__play" data-lb="yt:Xh35kuWo0a4"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>ALIEN WEEK 2956</span><span class="dot">◆</span><span>GATAC RAILEN</span><span class="dot">◆</span><span>GATAC TYILUI</span><span class="dot">◆</span><span>GATAC SYULEN</span><span class="dot">◆</span><span>FIRST CONTACT DAY</span><span class="dot">◆</span><span>XENOTECH</span><span class="dot">◆</span>
      <span>ALIEN WEEK 2956</span><span class="dot">◆</span><span>GATAC RAILEN</span><span class="dot">◆</span><span>GATAC TYILUI</span><span class="dot">◆</span><span>GATAC SYULEN</span><span class="dot">◆</span><span>FIRST CONTACT DAY</span><span class="dot">◆</span><span>XENOTECH</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-8-2-alien-week" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="3">0</div><div class="c">Gatac fő fellépő · 2956</div></div>
    <div class="s"><div class="n count" data-to="4">0</div><div class="c">Idegen gyártó reflektorfényben</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Repülésre kész Railen</div></div>
    <div class="s"><div class="n">Xi'an</div><div class="c">Nyelvleckék az eseményhez</div></div>
  </div>

  <!-- FULL-BLEED BAND #1 (parallax, big text over still) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-alien-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">A First Contact Day körül</div>
      <div class="big outline">ALIEN WEEK</div>
      <p>Évente egyszer a Verse megünnepli az első kapcsolatfelvételt — és azokat a gyártókat állítja a középpontba, amelyek nem emberi kéz alkotásai. Az Alien Week a <b style="color:var(--accent-2)">xenotech</b> színpada.</p>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Egy hét, amelyben az <span class="hl">idegen technika</span> játssza a főszerepet.</blockquote>
    <cite>Alien Week · First Contact Day 2956</cite>
  </section>

  <!-- OVERVIEW as the single framed SPLIT -->
  <section style="padding-bottom:0">
    <div class="split reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-alien-3.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">01 · Miről szól</div>
        <h3>A nem emberi gyártók ünnepe</h3>
        <p>Az Alien Week a <b>First Contact Day</b> köré szervezett éves esemény, amely a Star Citizen nem emberi, illetve xenotech-gyártóit állítja a középpontba. Egy héten át minden az emberi hajógyárakon túli technikáról szól.</p>
        <p>Az eseményt közösségi programok kísérik, például <b>idegen lore-anyagok</b> és <b>xi'an nyelvleckék</b> — háttér és kultúra azokhoz az idegen konstruktőrökhöz, akiknek a hajói reflektorfénybe kerülnek.</p>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: So funktioniert Alien Week (PROCESS) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>Így működik az esemény</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-alien-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-alien-7.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>First Contact Day</h3><p>Az esemény a First Contact Day körül indul — ez az éves alkalom ünnepli az első kapcsolatfelvételt, és állítja a xenotechet a középpontba.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Pledge Store-akciók</h3><p>A Pledge Store időben korlátozott akciói elérhetővé teszik az idegen gyártók — Gatac Manufacture, Aopoa, Banu és Esperia — hajóit.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Limitált felszerelés</h3><p>Ehhez jönnek a limitált festések és felszerelések — idegen formanyelv, amely csak ebben az időablakban szerezhető meg.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Lore &amp; nyelv</h3><p>Idegen lore-anyagok és xi'an nyelvleckék kísérik a hetet, és megadják a gyártók kulturális hátterét.</p></div>
    </div>
  </div>

  <!-- FULL-BLEED BAND #2 — Die Headliner 2956 -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/img-railen.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">03 · Fő fellépők 2956</div>
      <div class="big" style="font-size:clamp(2.6rem,9vw,6.5rem)">GATAC</div>
      <p>2956-ban három Gatac-hajó vezeti a hetet: a repülésre kész <b style="color:var(--accent-2)">Railen</b>, a <b style="color:var(--accent-2)">Syulen</b> kezdőhajó és az új <b style="color:var(--accent-2)">Tyilui</b> hordozó.</p>
    </div>
  </section>

  <!-- HERSTELLER IM SPOTLIGHT — full-bleed flow (no framed cards) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>Gyártók reflektorfényben</h2><span class="rule"></span></div>
      <div class="flow reveal">
        <div class="node"><div class="dot">G</div><h3>Gatac Manufacture</h3><p>Fő fellépők 2956-ban: Railen, Syulen és az új Tyilui hordozó.</p></div>
        <div class="node"><div class="dot">A</div><h3>Aopoa</h3><p>Xi'an építésmód — olyan hajókkal bemutatva, mint a Khartu-al és a Nox.</p></div>
        <div class="node"><div class="dot">E</div><h3>Esperia</h3><p>Rekonstruált idegen technika — a Talon képviseli.</p></div>
        <div class="node"><div class="dot">B</div><h3>Banu</h3><p>A Banu-sorozat teszi teljessé az idegen gyártók felhozatalát.</p></div>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND #3 — Xenotech -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/img-tyilui.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Technika, amely nem tőlünk származik</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">XENOTECH</div>
      <p>Az Aopoa Khartu-aljától és Noxától az Esperia Talonján át a Banu-sorozatig — az Alien Week időben korlátozott store-akciókat, limitált festéseket és az idegen hajógyárak felszereléseit hozza.</p>
    </div>
  </section>

  <!-- CLOSING: mixed gallery + trailer (full-bleed close) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-alien-1.jpg"><img src="/assets/t-alien-1.jpg" alt="Alien Week — xenotech a reflektorfényben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Alien Week · Xenotech</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-railen.jpg"><img src="/assets/img-railen.jpg" alt="Gatac Railen" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Railen</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-syulen.jpg"><img src="/assets/img-syulen.jpg" alt="Gatac Syulen" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Syulen</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-tyilui.jpg"><img src="/assets/img-tyilui.jpg" alt="Gatac Tyilui" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac Tyilui</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-alien-2.jpg"><img src="/assets/t-alien-2.jpg" alt="Gatac-hajó Grav-Lev hajtóművel az aszteroidamezőben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Gatac · Grav-Lev</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="Xh35kuWo0a4" style="background-image:url('/assets/vid-railen.jpg')"><span class="vlbl">Gatac &amp; Alien Week — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=Xh35kuWo0a4" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-2-alien-week" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
