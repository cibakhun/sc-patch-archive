---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Hunt The Polaris — Star Citizen 4.1.1 | VerseBase"} description={"Hunt The Polaris: a Fleet Week 2955 alatt a Frontier Fighters ellop egy RSI Polarist — és az egész szerver üldözi Stantonon keresztül, egészen a tovatűnő féreglyuknál vívott utolsó ütközetig."} themeColor="#0c1422" ogType="article" ogImage="/assets/img-polaris.jpg" translated={true}>
<TopicSeo slug="4-1-1-hunt-the-polaris" image="/assets/img-polaris.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Fleet-Week-Theme (Invictus-Orange / Korvettengrau) */
:root{--bg:#0c1422;--bg-2:#111c30;--surface:#16243c;--surface-2:#1d3050;--accent:#ff7a1a;--accent-2:#7d8b9a;--hot:#FF7A1A;--text:#f2f4f8;--muted:#9fb0c2;--line:rgba(255,122,26,.22);--line-soft:rgba(242,244,248,.10);--glow:0 0 44px rgba(255,122,26,.30);--ink:#0c1422;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f8fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#1e1f22;--muted:#4b5a6a;--accent:#914000;--accent-2:#485767;--hot:#843a00;--ink:#ffffff;--accent-media:#ff7a1a;--accent-2-media:#7d8b9a;--line:rgba(160,94,58,.3);--line-soft:rgba(45,46,49,.12);--glow:0 6px 22px rgba(168,89,42,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10.5rem)}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.1.1', href: '/hu/patches/sc-4-1-1.html' }, { label: "Hunt The Polaris" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed lead) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/img-polaris.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-1-1.html">Alpha 4.1.1 · Balancing &amp; Fleet Week</a> &nbsp;·&nbsp; Szerveresemény</div>
      <h1><span class="thin">Fleet Week 2955</span>Hunt The Polaris</h1>
      <p class="lead">A Fleet Week alatt a Frontier Fighters ellop egy RSI Polarist — és az egész szerver üldözi Stantonon keresztül, egészen a tovatűnő féreglyuknál vívott utolsó ütközetig.</p>
      <div class="tags"><span class="tag hot">Szerverszintű esemény</span><span class="tag">Fleet Week</span><span class="tag">RSI Polaris</span><span class="tag">Frontier Fighters</span><span class="tag">Megosztott jutalom</span></div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>HUNT THE POLARIS</span><span class="dot">◆</span><span>FLEET WEEK 2955</span><span class="dot">◆</span><span>RSI POLARIS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>INVICTUS</span><span class="dot">◆</span><span>RECOIL-SYSTEM</span><span class="dot">◆</span>
      <span>HUNT THE POLARIS</span><span class="dot">◆</span><span>FLEET WEEK 2955</span><span class="dot">◆</span><span>RSI POLARIS</span><span class="dot">◆</span><span>FRONTIER FIGHTERS</span><span class="dot">◆</span><span>INVICTUS</span><span class="dot">◆</span><span>RECOIL-SYSTEM</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-1-1-hunt-the-polaris" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Ellopott RSI Polaris</div></div>
    <div class="s"><div class="n"><span class="count" data-to="1">0</span></div><div class="c">Stanton · egyetlen vadászterület</div></div>
    <div class="s"><div class="n count" data-to="2955">0</div><div class="c">Fleet Week · Invictus</div></div>
    <div class="s"><div class="n">SERVER</div><div class="c">Mind vadászik · mind osztozik</div></div>
  </div>

  <!-- FULL-BLEED BAND — Intro über einer Polaris-Aufnahme -->
  <section class="band band--center" style="padding-block:clamp(3rem,8vw,7rem)">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/t-polaris-5.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">Invictus 2955 · Kezdődik a hajsza</div>
      <div class="big outline">ELLOPVA.</div>
      <p>A flottaparádé kellős közepén a <b style="color:var(--accent-2)">Frontier Fighters</b> az ég legnagyobb zsákmánya után nyúl — egy teljes <b>RSI Polaris</b> után. Ami merész húzásként indul, szerverszintű hajszává válik egész Stantonon át.</p>
    </div>
  </section>

  <!-- MANIFESTO pull-quote -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Egy korvett menekül. <span class="hl">Egy egész szerver</span> üldözi.</blockquote>
    <cite>Hunt The Polaris · Fleet Week 2955</cite>
  </section>

  <!-- SCROLLYTELLING — So läuft die Jagd (full-bleed process) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">01</span><h2>Így zajlik a hajsza</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-polaris-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/img-hammerhead.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-polaris-1.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>A rablás</h3><p>A Fleet Week alatt a Frontier Fighters magához ragad egy RSI Polarist — a Roberts Space Industries nagyméretű korvettjét —, és kitör vele a flottaszemléről.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>A hajsza</h3><p>Az ellopott Polaris Stantonon keresztül menekül. Az egész szerver felzárkózik — a rendszer minden szegletéből vadászok veszik célba a korvettet.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Az utolsó ütközet</h3><p>A menekülés egy tovatűnő féreglyuknál ér véget. Itt dől el a Polaris sorsa a döntő csatában, mielőtt a kapu ismét bezárul.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Megosztott zsákmány</h3><p>Ha a korvett elesik, a jutalom szétoszlik minden résztvevő között. Aki együtt vadászott, megkapja a részét — a hajsza az egész szervernek megéri.</p></div>
    </div>
  </div>

  <!-- VERSUS: Jäger vs Beute (full-bleed dual pane) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⚑ Frontier Fighters</h3>
        <ul>
          <li>A Fleet Week kellős közepén ellopnak egy teljes RSI Polarist.</li>
          <li>A nagy korvettel menekülnek Stantonon keresztül.</li>
          <li>Egy tovatűnő féreglyuk felé tartanak menekülőútként.</li>
          <li>Túl kell élniük az utolsó ütközetet, hogy elmeneküljenek.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>★ A szerver</h3>
        <ul>
          <li>A shard bármelyik játékosa csatlakozhat a hajszához.</li>
          <li>Az üldözés az egész Stanton-rendszeren végighúzódik.</li>
          <li>A féreglyuknál dől el a Polaris sorsa.</li>
          <li>A jutalom szétoszlik minden résztvevő között.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Recoil-System -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-hh-1.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">02 · A hajszával párhuzamosan</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">HÁTRARÚGÁS.</div>
      <p>Az Alpha 4.1.1 új <b style="color:var(--accent-2)">hátrarúgás-rendszert</b> hozott a hajó- és járműfegyverekhez — látható effektusokkal tüzeléskor. A Polarisra vadászva minden lövés súlyosabbnak és kézzelfoghatóbbnak hat.</p>
    </div>
  </section>

  <!-- SPLIT (the single framed section) — Turret-Munition -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-polaris-2.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">03 · Több tűzerő</div>
        <h3>Teli tárak a lövegtornyoknak</h3>
        <p>A 4.1.1-gyel sok hajó <b>lövegtorony-lőszerkészlete</b> jelentősen megnőtt. Aki a hajszában a lövegtornyokat kezeli, ritkábban tölt újra, és tovább bírja a harcban.</p>
        <p>Maga az <b>RSI Polaris</b> is kifejezetten az érintett hajók között van — a hajsza középpontjában álló korvett közvetlenül profitál a feltöltött torony-lőszerkészletből.</p>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND — Fleet Week Rahmen -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/img-idris.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">A nagy látványosságba ágyazva</div>
      <div class="big">FLEET WEEK</div>
      <p>A Hunt The Polaris az Alpha 4.1.1 szerverszintű küldetése, amely a <b style="color:var(--accent-2)">Fleet Week / Invictus 2955</b> rendezvénybe ágyazódik — a Verse éves flottaünnepébe, ahol az UEE legnagyobb hajói sorakoznak egymás mellett.</p>
    </div>
  </section>

  <!-- MEDIA — closing mixed gallery (no official video) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">04</span><h2>Galéria</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/img-polaris.jpg"><img src="/assets/img-polaris.jpg" alt="RSI Polaris repülés közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>RSI Polaris · nagy korvett</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-polaris-5.jpg"><img src="/assets/t-polaris-5.jpg" alt="A Polaris egy Gladiust bocsát ki a vadászöbölből" loading="lazy"><span class="zoomic">⤢</span><figcaption>Menekülés Stantonon át</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/t-polaris-2.jpg"><img src="/assets/t-polaris-2.jpg" alt="A Polaris lövegtornyai" loading="lazy"><span class="zoomic">⤢</span><figcaption>Feltöltött tornyok</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-hammerhead.jpg"><img src="/assets/img-hammerhead.jpg" alt="Hammerhead az üldöző kötelékben" loading="lazy"><span class="zoomic">⤢</span><figcaption>A szerver vadászai</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/img-idris.jpg"><img src="/assets/img-idris.jpg" alt="Aegis Idris — a Fleet Week nagyhajója" loading="lazy"><span class="zoomic">⤢</span><figcaption>Fleet Week · Invictus 2955</figcaption></figure>
      </div>
      <p class="src reveal">Forrás: Star Citizen Wiki &amp; az Alpha 4.1.1 hivatalos patch-jegyzetei (© Cloud Imperium Games). · Nem hivatalos rajongói projekt.</p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-1-1-hunt-the-polaris" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
