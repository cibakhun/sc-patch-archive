---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Align &amp; Mine — Star Citizen 4.1.0 | VerseBase"} description={"Align & Mine: kooperatív sandbox-tevékenység az Alpha 4.1.0 Orbital Assaultból — állítsd be a Hathor-létesítményeket az Aberdeenen és a Daymaron, és az orbitális lézer új, ásványokban gazdag barlangot robbant szabaddá."} themeColor="#10141a" ogType="article" ogImage="/assets/t-align-3.jpg" translated={true}>
<TopicSeo slug="4-1-0-align-and-mine" image="/assets/t-align-3.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Orbital-Assault-Theme (4.1.0) */
:root{--bg:#10141a;--bg-2:#171c24;--surface:#1d242e;--surface-2:#26303c;--accent:#3DA5D9;--accent-2:#E8A33D;--hot:#C0392B;--text:#eef1f4;--muted:#9aa4af;--line:rgba(61,165,217,.22);--line-soft:rgba(238,241,244,.10);--glow:0 0 44px rgba(61,165,217,.30);--ink:#10141a;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#ecf3fc;--text:#1d1f22;--muted:#505963;--accent:#00638a;--accent-2:#754b02;--hot:#9e0500;--ink:#ffffff;--accent-media:#3DA5D9;--accent-2-media:#E8A33D;--line:rgba(40,122,163,.3);--line-soft:rgba(44,46,49,.12);--glow:0 6px 22px rgba(40,122,163,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.1rem,13vw,10rem)}
.lede-kx{font-family:var(--font-ui);font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--accent-2);font-size:.8rem}
.moon-tag{font-family:var(--font-ui);font-weight:700;letter-spacing:.16em;text-transform:uppercase;font-size:.72rem;color:var(--accent-2)}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.1.0', href: '/hu/patches/sc-4-1-0.html' }, { label: "Align & Mine" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed bg, kinetic) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-align-3.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-1-0.html">Alpha 4.1.0 · Orbital Assault</a> &nbsp;·&nbsp; Feature</div>
      <h1><span class="thin">Orbitális lézeres bányászat</span>Align &amp; Mine</h1>
      <p class="lead">Kooperatív sandbox-tevékenység: állítsd be a Hathor-létesítményeket két holdon, süsd el az orbitális bányászlézert — és az vadonatúj, ásványokban gazdag barlangot robbant a felszínbe.</p>
      <div class="tags"><span class="tag">Co-op</span><span class="tag">Mining</span><span class="tag">Hathor</span><span class="tag">Orbitális lézer</span><span class="tag">Perzisztens</span></div>
      <div class="hero__play" data-lb="yt:NArGjlRFsQQ"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>ALIGN &amp; MINE</span><span class="dot">◆</span><span>HATHOR</span><span class="dot">◆</span><span>ORBITAL-LASER</span><span class="dot">◆</span><span>ABERDEEN</span><span class="dot">◆</span><span>DAYMAR</span><span class="dot">◆</span><span>MINING</span><span class="dot">◆</span>
      <span>ALIGN &amp; MINE</span><span class="dot">◆</span><span>HATHOR</span><span class="dot">◆</span><span>ORBITAL-LASER</span><span class="dot">◆</span><span>ABERDEEN</span><span class="dot">◆</span><span>DAYMAR</span><span class="dot">◆</span><span>MINING</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-1-0-align-and-mine" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="2">0</div><div class="c">Hold · Aberdeen &amp; Daymar</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Orbital Mining Station holdanként</div></div>
    <div class="s"><div class="n">1<span class="u">barlang</span></div><div class="c">Szabaddá robbantva beállításonként</div></div>
    <div class="s"><div class="n">Co-op</div><div class="c">Perzisztens többjátékos körforgás</div></div>
  </div>

  <!-- FULL-BLEED BAND (parallax) — big overlaid statement -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-align-4.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Mi az Align &amp; Mine?</div>
      <div class="big outline">BEÁLLÍTANI. ELSÜTNI. FEJTENI.</div>
      <p>Az Alpha 4.1.0 <b style="color:var(--accent-2)">Orbital Assaulttal</b> új, kooperatív, perzisztens sandbox-tevékenység érkezik a Stanton-rendszerbe. A játékosok beállítják a holdakon szétszórt <b style="color:var(--accent-2)">Hathor-létesítményeket</b> — és ezzel csapást váltanak ki az orbitról.</p>
    </div>
  </section>

  <!-- SCROLLYTELLING: der mehrstufige Loop (PROCESS / steps) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>A körforgás lépésről lépésre</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-align-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-align-9.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-align-7.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-align-2.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Hathor-létesítmények megtalálása</h3><p>A Hathor-létesítmények a Stanton holdjain, az Aberdeenen és a Daymaron vannak szétszórva. Mindegyik holdhoz felszíni Alignment Facility tartozik — minden run kiindulópontja.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Beállítás a felszínen</h3><p>A legénység végigdolgozza a felszíni Alignment Facilityket, és helyesen beállítja a létesítményt. Ez a felszíni szakasz az előkészítés — kooperatív és többlépcsős.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>A lézer az orbitról tüzel</h3><p>Helyesen beállítva a Hathor-lézer az Orbital Mining Stationről, az orbitról tüzel a holdfelszínre — ez a körforgás döntő pillanata.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>Barlang &amp; jutalom</h3><p>A sugár vadonatúj, értékes ásványokkal teli barlangot robbant szabaddá. A felszíni előkészítésből jutalom lesz: friss, ásványokban gazdag fejtőterület.</p></div>
    </div>
  </div>

  <!-- VERSUS: zwei Seiten des Loops (full-bleed) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>⛏ Felszín · beállítás</h3>
        <ul>
          <li>A felszíni Alignment Facilityk végigdolgozása.</li>
          <li>A Hathor-létesítmény helyes beállítása.</li>
          <li>Kooperatív, többlépcsős előkészítés.</li>
          <li>Az Aberdeenen és a Daymaron elszórva.</li>
        </ul>
      </div>
      <div class="vs">VS</div>
      <div class="side b">
        <h3>★ Orbit · jutalom</h3>
        <ul>
          <li>A Hathor-lézer az orbitról tüzel.</li>
          <li>A sugár vadonatúj barlangot robbant szabaddá.</li>
          <li>Értékes ásványokkal teli barlang.</li>
          <li>A bányászat a közös run hozadéka.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Előbb <span class="hl">beállítás a felszínen</span> — aztán az orbit barlangot üt a holdba.</blockquote>
    <cite>Align &amp; Mine · Orbital Assault</cite>
  </section>

  <!-- FRAMED SPLIT (the one framed section) — die Hathor-Anlagen -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-align-1.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">03 · A Hathor-létesítmények</div>
        <h3>Felszín és orbit, két hold</h3>
        <p>Mindkét holdhoz — az <b>Aberdeenhez</b> és a <b>Daymarhoz</b> — felszíni <b>Alignment Facilityk</b> tartoznak, plusz egy <b>Orbital Mining Station</b>. Csak a felszíni létesítmények és az orbitális platform együttjátéka teszi lehetővé a csapást.</p>
        <p>A létesítmények a holdfelszínen vannak elszórva; a legénységnek fel kell keresnie és be kell állítania őket, mielőtt az orbitális állomás tüzelhet. <b>Helyesen beállítva</b> a Hathor-lézer egyetlen felszíni pontra fókuszálja az energiáját.</p>
        <div style="margin-top:.4rem"><span class="moon-tag">Aberdeen</span> &nbsp;·&nbsp; <span class="moon-tag">Daymar</span></div>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED BAND (parallax) — der Einschlag -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/t-align-8.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">04 · A becsapódás</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">ÚJ BARLANG</div>
      <p>Ahol a sugár eléri a felszínt, vadonatúj barlang nyílik, tele értékes ásvánnyal — friss fejtőterület, amely korábban nem létezett. Perzisztensen az univerzumban, a közös run teremtette meg.</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery + trailer) — close with full-bleed media -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">05</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-align-3.jpg"><img src="/assets/t-align-3.jpg" alt="Hathor-létesítmény a felkelő nap ellenfényében" loading="lazy"><span class="zoomic">⤢</span><figcaption>Hathor-létesítmény · napkelte</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-align-7.jpg"><img src="/assets/t-align-7.jpg" alt="Az orbitális bányászlézer a felszínre tüzel" loading="lazy"><span class="zoomic">⤢</span><figcaption>Lézer az orbitról</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-align-2.jpg"><img src="/assets/t-align-2.jpg" alt="Fúrófej a szabaddá robbantott barlangban" loading="lazy"><span class="zoomic">⤢</span><figcaption>Barlang · fúrófej</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="NArGjlRFsQQ" style="background-image:url('/assets/trailer-4-1-0.jpg')"><span class="vlbl">Orbital Assault — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=NArGjlRFsQQ" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-1-0-align-and-mine" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
