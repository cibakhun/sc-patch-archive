  <!-- DIE DREI STATIONEN -->
  <section>
    <div class="wrap"><div class="sec-head reveal"><span class="num">03</span><h2>A három Emporium-állomás</h2><span class="rule"></span></div></div>
    <figure class="wk-figure reveal">
      <img src="/assets/wk-selo.jpg" alt="Wikelo Emporium Selo Station — banu kereskedőállomás egy aszteroidán a Yela közelében" loading="lazy" decoding="async" />
      <figcaption>Wikelo Emporium — a Selo-állomás egy aszteroidán a Yela közelében, a banu tornyokkal és leszállóplatformokkal. Mindhárom állomás (Dasi, Selo, Kinga) ugyanezt a felépítést használja.</figcaption>
    </figure>
    <div class="wk-bento reveal">
      <div class="wk-cell">
        <div class="wk-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13 8 5l7-2 5 6-3 9-8 1z"/><path d="m8 5 3 5 4-1M11 10l-2 8m6-8 2 4"/></svg></div>
