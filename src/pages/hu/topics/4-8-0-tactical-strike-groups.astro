---
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TopicFacts from '../../../components/TopicFacts.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';
import Attribution from '../../../components/Attribution.astro';
import TopicSeo from '../../../components/dossier/TopicSeo.astro';
---
<Layout title={"Tactical Strike Groups — Star Citizen 4.8.0 | VerseBase"} description={"Tactical Strike Groups: a Star Citizen első dedikált kooperatív hajócsata-hadművelete — többfázisú vanduul csata a Nyxben, az Alpha 4.8.0 Tactical Strike-kal bevezetve."} themeColor="#0d0a16" ogType="article" ogImage="/assets/t-tsg-1.jpg" translated={true}>
<TopicSeo slug="4-8-0-tactical-strike-groups" image="/assets/t-tsg-1.jpg" />
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>

/* Strike-Theme (4.8.0 Tactical Strike) */
:root{--bg:#0d0a16;--bg-2:#140f24;--surface:#1a1330;--surface-2:#231a3e;--accent:#E8651E;--accent-2:#1FB8A6;--hot:#E8651E;--text:#ede9f5;--muted:#a39db5;--line:rgba(232,101,30,.22);--line-soft:rgba(237,233,245,.10);--glow:0 0 44px rgba(232,101,30,.30);--ink:#0d0a16;--maxw:1180px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f8f6ff;--bg-2:#eeecf8;--surface:#fdfdff;--surface-2:#f2f1fb;--text:#201e26;--muted:#5a546a;--accent:#963a01;--accent-2:#056359;--hot:#893400;--ink:#ffffff;--accent-media:#E8651E;--accent-2-media:#1FB8A6;--line:rgba(162,93,63,.3);--line-soft:rgba(46,44,53,.12);--glow:0 6px 22px rgba(170,87,49,.18)}


/* page-local accents */
.hero h1{font-size:clamp(3.2rem,13vw,10rem)}
.kx-teal{color:var(--accent-2)}
.roleline{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.1rem}
.rolechip{font-family:var(--font-ui);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.72rem;padding:.4rem .85rem;border:1px solid var(--line);border-radius:3px;background:var(--veil);color:var(--accent-2)}</style>
<a class="skip" href="#main">Ugrás a tartalomra</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Archívum', href: '/hu/archiv.html' }, { label: 'Alpha 4.8.0', href: '/hu/patches/sc-4-8-0.html' }, { label: "Tactical Strike Groups" }]} translated={true} />


<main id="main">

  <!-- HERO (full-bleed lead) -->
  <section class="hero">
    <div class="hero__photo" data-par="0.10" style="background-image:url('/assets/t-tsg-1.jpg')" aria-hidden="true"></div>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="hero__in">
      <div class="eyebrow"><a href="/hu/patches/sc-4-8-0.html">Alpha 4.8.0 · Tactical Strike</a> &nbsp;·&nbsp; Endgame</div>
      <h1><span class="thin">Az első igazi koop-raid</span>Tactical Strike Groups</h1>
      <p class="lead">A 4.8.0 endgame-je: többfázisú, kooperatív csata egy vanduul fenyegetés ellen — az űrben és a földön. Csak összehangolt, világos szerepekkel bíró hajóhaderő jut át.</p>
      <div class="tags"><span class="tag hot">Koop-raid</span><span class="tag">PvE-endgame</span><span class="tag">Vanduul Mauler</span><span class="tag">Nyx</span><span class="tag">7+ játékos</span></div>
      <div class="hero__play" data-lb="yt:SsOtI2dtvBc"><span class="pbtn">▶</span>Trailer megtekintése</div>
    </div>
    <div class="scrollcue" aria-hidden="true">Görgess ↓</div>
  </section>

  <!-- MARQUEE -->
  <div class="dmarquee" aria-hidden="true">
    <div class="dmtrack">
      <span>TACTICAL STRIKE GROUPS</span><span class="dot">◆</span><span>VANDUUL MAULER</span><span class="dot">◆</span><span>QV EXTRACTION</span><span class="dot">◆</span><span>NYX</span><span class="dot">◆</span><span>FIGHTER · BOMBER · CAPITAL</span><span class="dot">◆</span><span>PVE-ENDGAME</span><span class="dot">◆</span>
      <span>TACTICAL STRIKE GROUPS</span><span class="dot">◆</span><span>VANDUUL MAULER</span><span class="dot">◆</span><span>QV EXTRACTION</span><span class="dot">◆</span><span>NYX</span><span class="dot">◆</span><span>FIGHTER · BOMBER · CAPITAL</span><span class="dot">◆</span><span>PVE-ENDGAME</span><span class="dot">◆</span>
    </div>
  </div>

  <!-- AUF EINEN BLICK (Daten-Register, uniform) -->
  <TopicFacts topicSlug="4-8-0-tactical-strike-groups" />

  <!-- STAT STRIP (animated counters) -->
  <div class="statstrip reveal">
    <div class="s"><div class="n count" data-to="7" data-suffix="+">0</div><div class="c">Játékos · ajánlott csapatlétszám</div></div>
    <div class="s"><div class="n count" data-to="1">0</div><div class="c">Vanduul Mauler · a késői boss</div></div>
    <div class="s"><div class="n">∞</div><div class="c">Fázis · az űrtől az FPS-beszivárgásig</div></div>
    <div class="s"><div class="n">Koop</div><div class="c">PvE-endgame szervezeteknek</div></div>
  </div>

  <!-- MANIFESTO (moved up — varies from template) -->
  <section class="manifesto reveal" style="padding-inline:clamp(1.25rem,5vw,4rem)">
    <blockquote>Nincsenek magányos hősök. Csak <span class="hl">összehangolt haderő</span> jut át.</blockquote>
    <cite>Tactical Strike Groups · Nyx</cite>
  </section>

  <!-- OVERVIEW — full-bleed band (image as background, design on top) -->
  <section class="band">
    <div class="bbg" data-par="0.14" style="background-image:url('/assets/t-tsg-2.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">01 · Áttekintés</div>
      <div class="big outline">EGY FLOTTA.</div>
      <p>Az Alpha 4.8 <b style="color:var(--accent-2)">Tactical Strike</b> elhozza a Star Citizen első dedikált kooperatív hajócsata-hadműveletét — többfázisú küldetésláncot valódi szerepspecializációval. Nem a szerencse, hanem az egyeztetés dönti el, ki jut el a magig.</p>
    </div>
  </section>

  <!-- VERSUS: Zwei Schauplätze (full-bleed, two sides) -->
  <section style="padding:0">
    <div class="versus reveal">
      <div class="side a">
        <h3>✦ Az űrben</h3>
        <ul>
          <li>Nyílt hajócsata a vanduulok ellen az állomás körül.</li>
          <li>Az energiarelék megrongálása a létesítmény megnyitásához.</li>
          <li>Alagútrepülés a belsejébe — szűk, precíz, könyörtelen.</li>
          <li>A hűtők szétlövése és a mag szabaddá tétele.</li>
        </ul>
      </div>
      <div class="vs">&amp;</div>
      <div class="side b">
        <h3>★ A földön</h3>
        <ul>
          <li>A QV Extraction Station FPS-beszivárgása.</li>
          <li>Az eltűnt felderítőcsapat kimentése.</li>
          <li>Pilótakimenekítés ellenséges tűz alatt.</li>
          <li>Helytállás egy késői Vanduul Maulerrel szemben.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCROLLYTELLING: Die Phasen (process, full-bleed) -->
  <section style="padding-bottom:0">
    <div class="wrap"><div class="sec-head reveal"><span class="num">02</span><h2>A hadművelet fázisai</h2><span class="rule"></span></div></div>
  </section>
  <div class="scrolly">
    <div class="scrolly__media" aria-hidden="true">
      <div class="frame active" style="background-image:url('/assets/t-tsg-3.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-tsg-4.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-tsg-5.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-tsg-6.jpg')"></div>
      <div class="frame" style="background-image:url('/assets/t-tsg-7.jpg')"></div>
    </div>
    <div class="scrolly__steps">
      <div class="sstep"><div class="sn">01</div><h3>Hajócsata odakint</h3><p>A Strike Group eléri a QV Extraction Stationt a Nyx-rendszerben, és nyílt térben néz szembe a vanduul fenyegetéssel — a vadászok biztosítják az eget, a bombázók és a támogatás utánuk nyomul.</p></div>
      <div class="sstep"><div class="sn">02</div><h3>Energiarelék &amp; alagútrepülés</h3><p>Az energiarelék célzott sérülése megnyitja a létesítményt. Ezután jön az alagútrepülés az aszteroida belsejébe — szűk folyosók, ahol minden szerep számít.</p></div>
      <div class="sstep"><div class="sn">03</div><h3>Hűtők &amp; mag</h3><p>Az állomás hűtőit szét kell lőni, hogy a mag szabaddá váljon — ez az átmenet a hajócsatából a gyalogos beszivárgásba.</p></div>
      <div class="sstep"><div class="sn">04</div><h3>FPS-beszivárgás &amp; kimenekítés</h3><p>Gyalog átfésülitek az állomást, megkeresitek az eltűnt felderítőcsapatot, és megindítjátok a pilótakimenekítést — egyre nagyobb nyomás alatt.</p></div>
      <div class="sstep"><div class="sn">05</div><h3>A Vanduul Mauler</h3><p>A hadművelet vége felé felbukkan egy Vanduul Mauler. Csak világos szerepekkel bíró csapat — vadász, bombázó, támogató, nagyhajó — állja meg a helyét, és zárja le a raidet.</p></div>
    </div>
  </div>

  <!-- ROLLEN — full-bleed band (image as background) -->
  <section class="band band--right">
    <div class="bbg" data-par="0.12" style="background-image:url('/assets/img-vanduul.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">03 · Összetétel</div>
      <div class="big outline" style="font-size:clamp(2.4rem,8vw,6rem)">A SZEREPEK SZÁMÍTANAK</div>
      <p><b style="color:var(--accent-2)">Hét játékostól</b> felfelé álló csapatokra tervezve, amelyek vadászokat, bombázókat, támogatóhajókat, sőt nagyhajókat vegyítenek. Aki elhanyagolja a szerepeket, nem jut át minden fázison.</p>
      <div class="roleline" style="justify-content:flex-end">
        <span class="rolechip">Fighter</span><span class="rolechip">Bomber</span><span class="rolechip">Support</span><span class="rolechip">Capital</span>
      </div>
    </div>
  </section>

  <!-- BELOHNUNGEN — the single framed/split section -->
  <section style="padding-bottom:0">
    <div class="split split--rev reveal">
      <div class="split__media"><div class="m" style="background-image:url('/assets/t-tsg-9.jpg')"></div></div>
      <div class="split__text">
        <div class="kx">04 · Zsákmány</div>
        <h3>Az új PvE-endgame szervezeteknek</h3>
        <p>A Tactical Strike Groups az új <b>PvE-endgame szervezett orgoknak</b> — olyan hadművelet, amely csak fegyelemmel és szerepfelosztással teljesíthető.</p>
        <p>Aki átjut, egyedi jutalmat kap: egy exkluzív <b>számszeríj-tervrajzot</b> és értékes lootot, amely minden eddigi fölé emeli ezt a hadműveletet.</p>
      </div>
    </div>
  </section>

  <!-- SCHAUPLATZ — full-bleed band (Nyx) -->
  <section class="band">
    <div class="bbg" data-par="0.13" style="background-image:url('/assets/t-tsg-8.jpg')" aria-hidden="true"></div>
    <div class="band__in reveal">
      <div class="kx">05 · Helyszín</div>
      <div class="big">QV EXTRACTION</div>
      <p>A helyszín a <b style="color:var(--accent-2)">QV Extraction Stations</b> — nagy aszteroidalétesítmények mélyen a <b style="color:var(--accent-2)">Nyx-rendszerben</b>, ahol egy eltűnt felderítőcsapatot keresnek. Az Alpha 4.8 Tactical Strike-kal indult a hadművelet, teljes wipe-pal együtt.</p>
    </div>
  </section>

  <!-- MEDIA (mixed gallery + trailer — full-bleed close) -->
  <section>
    <div class="wrap">
      <div class="sec-head reveal"><span class="num">06</span><h2>Media</h2><span class="rule"></span></div>
      <div class="gallery reveal">
        <figure class="gtile full b2" data-lb="img:/assets/t-tsg-1.jpg"><img src="/assets/t-tsg-1.jpg" alt="Tactical Strike Groups — hajócsata a QV Extraction Stationnél" loading="lazy"><span class="zoomic">⤢</span><figcaption>QV Extraction Station · Nyx</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/t-tsg-2.jpg"><img src="/assets/t-tsg-2.jpg" alt="Strike Group megközelítés közben" loading="lazy"><span class="zoomic">⤢</span><figcaption>Strike Group · megközelítés</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/img-vanduul.jpg"><img src="/assets/img-vanduul.jpg" alt="Vanduul fenyegetés" loading="lazy"><span class="zoomic">⤢</span><figcaption>Vanduul fenyegetés</figcaption></figure>
        <figure class="gtile" data-lb="img:/assets/vid-isc48.jpg"><img src="/assets/vid-isc48.jpg" alt="Inside Star Citizen 4.8" loading="lazy"><span class="zoomic">⤢</span><figcaption>Inside Star Citizen 4.8</figcaption></figure>
        <figure class="gtile w2" data-lb="img:/assets/trailer-4-8-0.jpg"><img src="/assets/trailer-4-8-0.jpg" alt="Alpha 4.8 Tactical Strike — Trailer" loading="lazy"><span class="zoomic">⤢</span><figcaption>Tactical Strike · Trailer</figcaption></figure>
      </div>
      <div class="video reveal" data-yt="SsOtI2dtvBc" style="background-image:url('/assets/trailer-4-8-0.jpg')"><span class="vlbl">Alpha 4.8 Tactical Strike — Trailer</span><button class="play" aria-label="Trailer lejátszása">▶</button></div>
      <p class="src reveal">Forrás: hivatalos Star Citizen YouTube-csatorna &amp; Star Citizen Wiki (© Cloud Imperium Games). · <a href="https://www.youtube.com/watch?v=SsOtI2dtvBc" target="_blank" rel="noopener">Megtekintés a YouTube-on ↗</a></p>
    </div>
  </section>

</main>

<RelatedTopics topicSlug="4-8-0-tactical-strike-groups" />

<Attribution />

<div class="lb" id="lb" aria-hidden="true"><div class="lb__body"><button class="lb__x" aria-label="Bezárás">✕</button><div class="lb__content"></div></div></div>

<script is:inline src="/assets/detail.js"></script>
</Layout>
