---
// gate.astro — Testpilot-Torseite (Phase 14 Plan 01, D-11).
//
// EIGENSTAENDIGE, UNGEPAARTE Seite: kein src/pages/de/gate.astro, kein
// Layout.astro, kein SiteNav — die Menuestruktur eines gesperrten Bereichs
// waere selbst eine Auskunft (D-11). `findPagePairs` (scripts/lib/page-
// pairs.mjs) ueberspringt eine EN-only-Datei ohne Partner still, es braucht
// also keine neue Ausnahmeklasse in verify:sync (Pitfall 5, 14-RESEARCH.md).
// Nur Englisch (D-11); nach dem Anmelden geht es normal in der gewuenschten
// Sprache weiter.
//
// Saemtliches Skript/Stil steht INLINE im Dokument (Pitfall 6): ein
// content-gehashtes /_astro/-Buendel waere bei jedem Bau ein anderer
// Dateiname und damit nicht als feste Ausnahme in nginx/default.conf
// benennbar. `define:vars` haengt die Astro-Frontmatter-Werte (Supabase-URL/
// -Key/Storage-Key) als literale Konstanten ins Skript — Astro behandelt den
// Block dabei genau wie is:inline (keine Bundelung, kein separates Chunk).
// Aus demselben Grund kein supabase-js hier: die Sitzung wird SDK-frei aus
// localStorage gelesen/geschrieben, genau wie assets/account-lite.js es
// seit jeher tut.
//
// Warum die Torseite SELBST anmelden muss, obwohl D-11 nur den
// Discord-Knopf nennt: staging.verse-base.com und verse-base.com sind
// verschiedene Ursprünge und teilen keinen localStorage. Eine Anmeldung auf
// der Live-Seite erzeugt auf der Vorschau keine Sitzung, und /account/ liegt
// auf der Vorschau selbst hinter dem Tor. D-04 verlangt zusaetzlich
// ausdruecklich einen Weg, der NICHT von Discord abhaengt — das E-Mail-
// Formular ist dieser Weg (Discord kommt in Plan 04 als optisch fuehrender
// Knopf daneben, ohne dass sich diese Bauform aendert).
// Plan 04 (D-01/D-03/D-11): Discord wird der Hauptweg, das E-Mail-Formular
// bleibt der von D-04 verlangte Discord-unabhängige Weg. Der OAuth-Ablauf ist
// PKCE, SDK-frei wie der Rest der Seite (Pitfall 6 — kein /_astro/-Bündel):
// vor dem Sprung zu Discord entsteht ein code_verifier, der nur im
// localStorage DIESES Browsers liegt (wie bei supabase-js: auch ein
// Rücksprung in einem neuen Tab, etwa aus der Discord-App, findet ihn);
// /auth/v1/authorize bekommt dessen SHA-256 als code_challenge. Der Rücksprung trägt `?code=`, den nur
// /auth/v1/token?grant_type=pkce zusammen mit dem Verifier einlöst. Ein
// Rücksprung ohne gespeicherten Verifier wird verworfen, Sitzungs-Tokens im
// Fragment werden nie übernommen, und gespeichert wird eine Sitzung erst,
// wenn /_gate/mint sie angenommen hat.
// Zweiter Faktor (TOTP): hat das Konto einen bestaetigten Authenticator und
// traegt die frische Sitzung noch kein aal2 (Passwort und Discord liefern
// aal1), fragt die Seite zuerst den Code ab und hebt die Sitzung ueber
// /auth/v1/factors/<id>/challenge + /verify auf aal2 — ebenfalls SDK-frei.
// Gemintet und gespeichert wird dann die Sitzung mit Code. Der Admin-Zweig
// von gate_verdict verlangt aal2 (20261030142000_admin_second_factor.sql).
import { versioned } from '../lib/assetVersion';
import { SUPABASE, DISCORD } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="Sign in to access the VerseBase Test Pilot preview." />
  <title>Test Pilot Access — VerseBase</title>
  <link href={versioned('assets/theme.css', '/assets/theme.css')} rel="stylesheet" />
  <link href={versioned('assets/fonts.css', '/assets/fonts.css')} rel="stylesheet" />
  <style is:inline>
    :root{
      --bg:#05070d;--surface:#0f1524;--accent:#2dd4ff;--accent-2:#6ea8ff;
      --text:#e8eefc;--muted:#a7b6cf;--line:rgba(110,168,255,.16);--err:#ff8a8a;
      --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;
    }
    /* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
    :root[data-theme="light"]{--bg:#f4f7fe;--surface:#fdfdff;--text:#1b1f29;--muted:#4d596c;--accent:#05657c;--accent-2:#0850ad;--ink:#ffffff;--accent-media:#2dd4ff;--accent-2-media:#6ea8ff;--line:rgba(43,125,148,.3)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{
      min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;
      gap:1.3rem;text-align:center;padding:2rem 1.5rem;
      background:radial-gradient(120% 90% at 50% 20%,rgba(45,212,255,.10),transparent 60%),var(--bg);
      color:var(--text);font-family:var(--font-body);
    }
    .kicker{font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-16);text-transform:uppercase;font-size:var(--fs-6);color:var(--accent)}
    h1{font-family:var(--font-display);font-weight:700;font-size:var(--fs-17);letter-spacing:var(--ls-4)}
    .lede{max-width:42ch;color:var(--muted);font-size:var(--fs-11);line-height:1.5}
    .card{width:100%;max-width:22rem;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:1.6rem;display:flex;flex-direction:column;gap:.9rem}
    .field{display:flex;flex-direction:column;gap:.35rem;text-align:left}
    label{font-family:var(--font-ui);font-size:var(--fs-6);letter-spacing:var(--ls-8);text-transform:uppercase;color:var(--muted)}
    /* ⚠ --fs-8 (0,9rem = 16,2 px), nicht --fs-9 (0,95rem = 15,2 px): Safari
       zoomt beim Fokus in JEDES Feld mit weniger als 16 px hinein und der
       Nutzer sitzt danach in einem verschobenen Viewport fest. Gemessen
       30.08.2026 bei 390x844 UND 844x390. Diese Seite laedt
       assets/mobile-ux.css NICHT (sie ist die Tuer davor und traegt ihr CSS
       komplett selbst), die dortige Regel aus Abschnitt 1 greift hier also
       nicht — und ein roher 16px-Wert waere ein Rest ausserhalb der Skala,
       den verify:typo zu Recht meldet (einmal vorgefuehrt). */
    input{font:inherit;font-size:var(--fs-8);padding:.6rem .7rem;border-radius:6px;border:1px solid var(--line);background:var(--veil-2);color:var(--text)}
    input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    button{
      font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-8);color:var(--ink);background:var(--accent);border:0;border-radius:6px;padding:.75rem 1rem;cursor:pointer;
      transition:transform var(--dur-base) var(--ease-ui),box-shadow var(--dur-base) var(--ease-ui);
    }
    button:hover{transform:translateY(-1px);box-shadow:0 0 24px rgba(45,212,255,.35)}
    button:disabled{opacity:.6;cursor:progress}
    .status{font-size:var(--fs-5);color:var(--muted);min-height:1.2em}
    .status[data-tone="error"]{color:var(--err)}
    .status a{color:var(--accent-2)}
    .role-link{font-size:var(--fs-6);color:var(--muted)}
    .role-link a{color:var(--accent-2)}
    /* D-01/D-11: Discord ist der Hauptweg -- gleiche Knopfform wie das
       E-Mail-Formular, volle Kartenbreite, oben platziert. */
    .discord-btn{
      width:100%;max-width:22rem;display:flex;align-items:center;justify-content:center;gap:.6rem;
      font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-10);text-transform:uppercase;font-size:var(--fs-8);
      color:var(--ink);background:var(--accent);border:0;border-radius:6px;padding:.85rem 1rem;cursor:pointer;
      transition:transform var(--dur-base) var(--ease-ui),box-shadow var(--dur-base) var(--ease-ui);
    }
    .discord-btn:hover{transform:translateY(-1px);box-shadow:0 0 24px rgba(45,212,255,.35)}
    .discord-btn:disabled{opacity:.6;cursor:progress}
    [hidden]{display:none!important}
    .divider{font-family:var(--font-ui);font-size:var(--fs-5);color:var(--muted);text-transform:uppercase;letter-spacing:var(--ls-8);margin:.2rem 0}
    :focus-visible{outline:2px solid var(--accent);outline-offset:3px}</style>
</head>
<body>
  <div class="kicker">VerseBase</div>
  <h1>Test Pilot Preview</h1>
  <p class="lede">This preview is for Test Pilots. Sign in to continue.</p>

  <button type="button" class="discord-btn" id="gateDiscordBtn"><span id="gateDiscordBtnTxt">Sign in with Discord</span></button>
  <p class="status" id="gateDiscordStatus" role="alert" aria-live="assertive"></p>

  <p class="divider">or sign in with e-mail</p>

  <form class="card" id="gateForm" novalidate>
    <div class="field">
      <label for="gateEmail">E-mail</label>
      <input id="gateEmail" name="email" type="email" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="gatePass">Password</label>
      <input id="gatePass" name="password" type="password" required autocomplete="current-password" />
    </div>
    <button type="submit" id="gateBtn"><span id="gateBtnTxt">Sign in</span></button>
    <p class="status" id="gateStatus" role="alert" aria-live="assertive"></p>
  </form>

  <form class="card" id="gateMfaForm" novalidate hidden>
    <p class="role-link">This account uses two-factor sign-in. Enter the six-digit code from your authenticator app.</p>
    <div class="field">
      <label for="gateMfaCode">Code</label>
      <input id="gateMfaCode" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="9" spellcheck="false" required />
    </div>
    <button type="submit" id="gateMfaBtn"><span id="gateMfaBtnTxt">Verify</span></button>
    <p class="status" id="gateMfaStatus" role="alert" aria-live="assertive"></p>
  </form>

  <p class="role-link">Not a Test Pilot yet? <a href={DISCORD.invite}>Get the role on Discord</a>.</p>

  <script define:vars={{ SB_URL: SUPABASE.url, SB_KEY: SUPABASE.publishableKey, STORE: SUPABASE.storageKey }}>
    (function () {
      'use strict';

      // Nur SAME-ORIGIN-Rücksprungziele akzeptieren (kein offener Redirect,
      // T-14-05): genau ein führender "/", kein "//" (Protokoll-relativ).
      // Zusätzlich gegen die eigene Origin aufgelöst, und auch der FERTIGE
      // Pfad muss mit genau einem "/" beginnen. Dieselbe Regel wie
      // src/lib/safe-next.ts (hier als Kopie, die Seite ist bundlerfrei).
      function safeNext(raw) {
        if (!raw || raw.charAt(0) !== '/' || raw.charAt(1) === '/') return '/';
        try {
          var u = new URL(raw, location.origin);
          if (u.origin !== location.origin) return '/';
          var rel = u.pathname + u.search + u.hash;
          if (rel.charAt(1) === '/' || rel.charAt(1) === '\\') return '/';
          return rel;
        } catch (e) {
          return '/';
        }
      }
      var next = safeNext(new URLSearchParams(location.search).get('next') || '');

      function readSession() {
        try {
          var raw = localStorage.getItem(STORE);
          return raw ? JSON.parse(raw) : null;
        } catch (e) { return null; }
      }

      // Ablageform exakt wie assets/account-lite.js (ensureSession): fehlt
      // expires_at, wird es aus expires_in berechnet.
      function storeSession(sess) {
        if (!sess.expires_at) sess.expires_at = Math.floor(Date.now() / 1000) + (sess.expires_in || 3600);
        try { localStorage.setItem(STORE, JSON.stringify(sess)); } catch (e) { /* noop */ }
      }

      function mint(accessToken) {
        return fetch('/_gate/mint', {
          method: 'POST',
          headers: { Authorization: 'Bearer ' + accessToken },
        });
      }

      // Gespeicherte Sitzung, bei Bedarf erneuert. Das Zugangstoken lebt nur
      // eine Stunde; wer nach Tagen wiederkommt, hat ein abgelaufenes, und
      // /_gate/mint wies es still ab (Supabase 401 -> 403) — der Testpilot
      // musste sich neu anmelden, obwohl sein refresh_token noch galt.
      // Erneuert wird wie in assets/account-lite.js (refresh/swap): gleicher
      // Endpunkt, gleiche Ablageform, gleicher Riegel gegen einen zweiten
      // Refresh aus einem anderen Tab. Zurueckgeschrieben wird PFLICHT:
      // refresh_tokens rotieren, ein verworfenes Ergebnis liesse die
      // Kontoseite mit einem verbrauchten Token zurueck. Geschrieben wird nur,
      // solange noch die Sitzung gespeichert ist, fuer die gefragt wurde.
      // Ergebnis: eine Sitzung mit gueltigem Zugangstoken oder null.
      var REFRESH_LOCK = 'sb-lite-refresh-lock';
      // Restlaufzeit in Sekunden: expires_at der Ablage, sonst exp aus dem
      // Token selbst; ohne beides unbekannt (Infinity) — dann entscheidet
      // /_gate/mint wie bisher.
      function expiresIn(sess) {
        var at = sess && sess.expires_at;
        if (!at) at = jwtClaim(sess && sess.access_token, 'exp');
        return typeof at === 'number' && at > 0 ? at - Math.floor(Date.now() / 1000) : Infinity;
      }
      function usable(sess) {
        return sess && sess.access_token && expiresIn(sess) > 0 ? sess : null;
      }
      // Warum freshSession() zuletzt keine Sitzung lieferte: 'rejected' (das
      // refresh_token gilt nicht mehr) oder 'down' (Supabase nicht erreichbar).
      var refreshFail = '';
      function freshSession() {
        var sess = readSession();
        if (!sess || !sess.access_token) return Promise.resolve(null);
        if (expiresIn(sess) > 60) return Promise.resolve(sess);
        if (!sess.refresh_token) return Promise.resolve(usable(sess));
        var lock = 0;
        try { lock = +localStorage.getItem(REFRESH_LOCK) || 0; } catch (e) { /* noop */ }
        if (Date.now() - lock < 10000) {
          // Ein anderer Tab erneuert gerade: kurz warten, dann dessen Ergebnis.
          return new Promise(function (res) { setTimeout(res, 1500); }).then(function () { return usable(readSession()); });
        }
        try { localStorage.setItem(REFRESH_LOCK, String(Date.now())); } catch (e) { /* noop */ }
        return fetch(SB_URL + '/auth/v1/token?grant_type=refresh_token', {
          method: 'POST',
          headers: { apikey: SB_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ refresh_token: sess.refresh_token }),
        })
          .then(function (r) {
            var stored = readSession();
            if (!stored || stored.refresh_token !== sess.refresh_token) return usable(stored);
            // Abgelehntes refresh_token: die Sitzung ist tot, wie account-lite.js
            // raeumt die Seite sie weg. 5xx/429 lassen sie liegen.
            if (r.status === 400 || r.status === 401 || r.status === 403) {
              try { localStorage.removeItem(STORE); } catch (e) { /* noop */ }
              refreshFail = 'rejected';
              return null;
            }
            if (!r.ok) { refreshFail = 'down'; return usable(stored); }
            return r.json().then(function (fresh) {
              if (!fresh || !fresh.access_token) return usable(readSession());
              var now = readSession();
              if (!now || now.refresh_token !== sess.refresh_token) return usable(now);
              storeSession(fresh);
              return fresh;
            });
          })
          .catch(function () { refreshFail = 'down'; return usable(readSession()); });
      }

      // Schon angemeldet (Sitzung aus einem frueheren Besuch oder von
      // account-lite.js aktualisiert)? Dann direkt minten und weiterspringen.
      // Laeuft erst, wenn kein Discord-Ruecksprung zu behandeln ist (unten).
      function tryEnter() {
        freshSession().then(function (sess) {
          if (!sess) {
            if (refreshFail === 'rejected') showDiscordStatus('Your sign-in has expired — please sign in again.', 'error');
            else if (refreshFail === 'down') showDiscordStatus('Could not renew your sign-in — please try again in a moment.', 'error');
            return;
          }
          return mint(sess.access_token).then(function (r) {
            if (r.ok) { location.replace(next); return; }
            if (r.status !== 403) return;
            // Abgewiesen, Sitzung noch ohne Code, Konto mit Authenticator
            // (Admin-Zweig verlangt aal2): den Code anbieten.
            var f = codeFactors(sess);
            if (f) { askGateCode(sess, f, 'Enter the code from your authenticator app to continue.'); return; }
            // Gueltige Sitzung, aber kein Zugang: sagen statt still stehen.
            showDiscordStatus('You are signed in, but this account has no Test Pilot access.', 'error');
          });
        }).catch(function () { /* bleibt auf der Torseite */ });
      }

      // ---- Zweiter Faktor (TOTP) ------------------------------------------
      // Ein Feld aus der Nutzlast des Zugangstokens, ungeprueft gelesen: nur
      // fuer Entscheidungen dieser Seite (Code abfragen, erneuern), nie fuer
      // den Zugang — den entscheidet /_gate/mint.
      function jwtClaim(token, name) {
        try {
          var p = String(token).split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
          while (p.length % 4) p += '=';
          return JSON.parse(atob(p))[name];
        } catch (e) { return undefined; }
      }
      function jwtAal(token) {
        return jwtClaim(token, 'aal') || '';
      }
      // Bestaetigte TOTP-Faktoren, wenn die Sitzung noch den Code braucht;
      // sonst null. Die Faktoren stehen im user-Objekt der Token-Antwort.
      function codeFactors(sess) {
        var f = (sess && sess.user && sess.user.factors) || [];
        var out = [];
        for (var i = 0; i < f.length; i++) {
          if (f[i] && f[i].factor_type === 'totp' && f[i].status === 'verified') out.push(f[i]);
        }
        return out.length && jwtAal(sess.access_token) !== 'aal2' ? out : null;
      }
      function asJson(r) {
        return r.json().then(
          function (b) { return { ok: r.ok, status: r.status, body: b }; },
          function () { return { ok: r.ok, status: r.status, body: null }; }
        );
      }
      // Code gegen jeden bestaetigten Faktor pruefen (zwei Geraete = zwei
      // Schluessel), bis einer passt. Ergebnis: { status, sess? }.
      function verifyGate(sess, factors, code, i) {
        var hdr = { apikey: SB_KEY, Authorization: 'Bearer ' + sess.access_token, 'Content-Type': 'application/json' };
        var base = SB_URL + '/auth/v1/factors/' + encodeURIComponent(factors[i].id);
        return fetch(base + '/challenge', { method: 'POST', headers: hdr, body: '{}' })
          .then(asJson)
          .then(function (ch) {
            if (!ch.ok || !ch.body || !ch.body.id) return { status: ch.status };
            return fetch(base + '/verify', {
              method: 'POST', headers: hdr,
              body: JSON.stringify({ challenge_id: ch.body.id, code: code }),
            })
              .then(asJson)
              .then(function (v) {
                if (v.ok && v.body && v.body.access_token) return { status: 200, sess: v.body };
                if (v.status === 429 || i + 1 >= factors.length) return { status: v.status };
                return verifyGate(sess, factors, code, i + 1);
              });
          });
      }
      var mfaForm = document.getElementById('gateMfaForm');
      var mfaBtn = document.getElementById('gateMfaBtn');
      var mfaBtnTxt = document.getElementById('gateMfaBtnTxt');
      var mfaStatus = document.getElementById('gateMfaStatus');
      var mfaPending = null;
      function showMfaStatus(msg, tone) {
        mfaStatus.textContent = msg;
        if (tone) mfaStatus.setAttribute('data-tone', tone);
        else mfaStatus.removeAttribute('data-tone');
      }
      function askGateCode(sess, factors, msg) {
        mfaPending = { sess: sess, factors: factors };
        mfaForm.hidden = false;
        showMfaStatus(msg || '');
        try { document.getElementById('gateMfaCode').focus(); } catch (e) { /* noop */ }
      }
      mfaForm.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!mfaPending) return;
        var code = String(mfaForm.elements.namedItem('code').value || '').replace(/[\s-]/g, '');
        if (!/^[0-9]{6}$/.test(code)) { showMfaStatus('Please enter the six digits from the app.', 'error'); return; }
        var p = mfaPending;
        mfaBtn.disabled = true;
        mfaBtnTxt.textContent = 'Checking …';
        showMfaStatus('');
        verifyGate(p.sess, p.factors, code, 0)
          .then(function (res) {
            if (!res.sess) {
              showMfaStatus(
                res.status === 429 ? 'Too many attempts — please wait a moment and try again.'
                  : res.status === 401 ? 'Your sign-in has expired — please sign in again.'
                  : res.status === 400 || res.status === 422 ? 'That code is not right — use the current one from the app.'
                  : 'Could not verify the code — please try again.',
                'error'
              );
              mfaBtn.disabled = false;
              mfaBtnTxt.textContent = 'Verify';
              return;
            }
            return mint(res.sess.access_token).then(function (r) {
              if (r.ok) {
                // Erst jetzt speichern: die Sitzung MIT Code, angenommen vom Tor.
                storeSession(res.sess);
                location.replace(next);
                return;
              }
              mfaPending = null;
              showMfaStatus(
                r.status === 403
                  ? 'Signed in, but this account has no Test Pilot access.'
                  : 'Could not verify access — please try again.',
                'error'
              );
              mfaBtn.disabled = false;
              mfaBtnTxt.textContent = 'Verify';
            });
          })
          .catch(function () {
            showMfaStatus('Network error — please try again.', 'error');
            mfaBtn.disabled = false;
            mfaBtnTxt.textContent = 'Verify';
          });
      });

      var form = document.getElementById('gateForm');
      var status = document.getElementById('gateStatus');
      var btn = document.getElementById('gateBtn');
      var btnTxt = document.getElementById('gateBtnTxt');
      var discordBtn = document.getElementById('gateDiscordBtn');
      var discordBtnTxt = document.getElementById('gateDiscordBtnTxt');
      var discordStatus = document.getElementById('gateDiscordStatus');

      function showStatus(msg, tone) {
        status.textContent = msg;
        if (tone) status.setAttribute('data-tone', tone);
        else status.removeAttribute('data-tone');
      }

      // textContent: keine Meldung dieser Seite traegt mehr Markup (der Link
      // zur E-Mail-Registrierung ist weg), und error_description kommt so
      // auch kuenftig nie als HTML an.
      function showDiscordStatus(msg, tone) {
        discordStatus.textContent = msg;
        if (tone) discordStatus.setAttribute('data-tone', tone);
        else discordStatus.removeAttribute('data-tone');
      }

      // PKCE ohne SDK (RFC 7636, S256): base64url ohne Auffuellung. Der
      // Verifier liegt im localStorage, nicht im sessionStorage: oeffnet die
      // Discord-App den Ruecksprung in einem neuen Tab, ist er dort sonst
      // weg. Er ist nur zusammen mit dem Code nutzbar und wird beim ersten
      // Ruecksprung verbraucht.
      var PKCE_KEY = 'vb_gate_pkce';
      function b64url(bytes) {
        var s = '';
        for (var i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
        return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      discordBtn.addEventListener('click', function () {
        discordBtn.disabled = true;
        discordBtnTxt.textContent = 'Redirecting …';
        // Keine zusaetzlichen Scopes -- identify+email ist die
        // Provider-Vorgabe (D-03, siehe Koordinator-Gegenprobe:
        // scope=email+identify). redirect_to zeigt auf DIESE Seite selbst
        // (next bleibt erhalten), damit der Ruecksprung SDK-frei vom
        // bestehenden Inline-Skript gelesen werden kann.
        var redirectTo = location.origin + '/gate.html?next=' + encodeURIComponent(next);
        var verifier;
        try {
          var raw = new Uint8Array(32);
          crypto.getRandomValues(raw);
          verifier = b64url(raw);
          localStorage.setItem(PKCE_KEY, verifier);
        } catch (e) { verifier = null; }
        if (!verifier || !crypto.subtle) {
          showDiscordStatus('Your browser blocks this sign-in — please sign in with e-mail and password below.', 'error');
          discordBtn.disabled = false;
          discordBtnTxt.textContent = 'Sign in with Discord';
          return;
        }
        crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)).then(function (hash) {
          location.href = SB_URL + '/auth/v1/authorize?provider=discord' +
            '&redirect_to=' + encodeURIComponent(redirectTo) +
            '&code_challenge=' + encodeURIComponent(b64url(new Uint8Array(hash))) +
            '&code_challenge_method=s256';
        }).catch(function () {
          showDiscordStatus('Your browser blocks this sign-in — please sign in with e-mail and password below.', 'error');
          discordBtn.disabled = false;
          discordBtnTxt.textContent = 'Sign in with Discord';
        });
      });

      // Konto liess sich nicht anlegen: GoTrue meldet einen Fehler aus dem
      // Anlege-Trigger generisch ("Database error saving new user",
      // error_code "unexpected_failure"). Bis 29.10.2026 hiess das "Discord
      // darf kein Konto anlegen" (D-02) und die Seite schickte zur
      // E-Mail-Registrierung. D-02 ist aufgehoben
      // (20261029121956_allow_discord_signup.sql), und die E-Mail-
      // Registrierung ist pausiert (register antwortet 503). Der Hinweis
      // folgt jetzt der Anmeldeseite (AuthLogin.astro, errDiscordBlocked):
      // der haeufigste Grund ist eine E-Mail-Adresse, die schon einem Konto
      // gehoert, und dafuer steht das Formular darunter.
      function looksLikeAccountSetupFailed(desc, code) {
        var d = (desc || '').toLowerCase();
        var c = (code || '').toLowerCase();
        return d.indexOf('database error saving new user') !== -1 || c === 'unexpected_failure';
      }

      // Rueckgabe: true, wenn ein Discord-Ruecksprung behandelt wird (dann
      // kein tryEnter mit einer aelteren Sitzung dazwischen).
      function handleOauthReturn() {
        var qp = new URLSearchParams(location.search);
        var hp = new URLSearchParams(location.hash.charAt(0) === '#' ? location.hash.slice(1) : '');
        var code = qp.get('code');
        var oauthErr = qp.get('error') || hp.get('error');
        var errDesc = qp.get('error_description') || hp.get('error_description');
        var errCode = qp.get('error_code') || hp.get('error_code');
        // Sitzungs-Tokens im Fragment stammen nie aus dem eigenen Ablauf
        // (PKCE) und werden nicht uebernommen -- nur weggeraeumt.
        var tokensInUrl = hp.has('access_token') || hp.has('refresh_token') ||
          qp.has('access_token') || qp.has('refresh_token');
        if (!code && !oauthErr && !tokensInUrl && !hp.has('error_description')) return false;
        // Verbraucht wird der Verifier nur bei einem Ruecksprung mit Code
        // oder Fehler; ein blosser Aufruf der Torseite (zweiter Tab) laesst
        // eine laufende Anmeldung in Ruhe.
        var verifier = null;
        if (code || oauthErr) {
          try { verifier = localStorage.getItem(PKCE_KEY); localStorage.removeItem(PKCE_KEY); } catch (e) { /* noop */ }
        }

        // Adresse sofort bereinigen (T-14-23): kein Code, Token oder
        // Fehlertext im Verlauf, in einem Lesezeichen oder Bildschirmfoto.
        // Nur next bleibt stehen.
        var keep = new URLSearchParams();
        if (qp.has('next')) keep.set('next', qp.get('next'));
        var ks = keep.toString();
        history.replaceState(null, '', location.pathname + (ks ? '?' + ks : ''));

        if (oauthErr) {
          if (looksLikeAccountSetupFailed(errDesc, errCode)) {
            showDiscordStatus(
              'Discord did not work. Do you already have a VerseBase account with the same e-mail? ' +
              'Then sign in with e-mail and password below.',
              'error'
            );
          } else {
            showDiscordStatus('Discord sign-in failed — please try again, or sign in with e-mail and password below.', 'error');
          }
          discordBtnTxt.textContent = 'Sign in with Discord';
          return true;
        }
        if (!code) return false; // nur Tokens im Fragment: verworfen, normal weiter
        if (!verifier) {
          // Kein Verifier in diesem Browser: der Ruecksprung gehoert nicht
          // zu einer hier gestarteten Anmeldung.
          showDiscordStatus('Discord sign-in could not be completed in this browser — please try again.', 'error');
          return true;
        }

        discordBtn.disabled = true;
        discordBtnTxt.textContent = 'Signing in …';
        fetch(SB_URL + '/auth/v1/token?grant_type=pkce', {
          method: 'POST',
          headers: { apikey: SB_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ auth_code: code, code_verifier: verifier }),
        })
          .then(function (r) {
            return r.json().then(function (body) { return { ok: r.ok, body: body }; });
          })
          .then(function (result) {
            if (!result.ok || !result.body || !result.body.access_token) {
              showDiscordStatus('Discord sign-in failed — please try again, or sign in with e-mail and password below.', 'error');
              discordBtn.disabled = false;
              discordBtnTxt.textContent = 'Sign in with Discord';
              return;
            }
            var sess = result.body;
            var factors = codeFactors(sess);
            if (factors) {
              discordBtn.disabled = false;
              discordBtnTxt.textContent = 'Sign in with Discord';
              askGateCode(sess, factors);
              return;
            }
            return mint(sess.access_token).then(function (r) {
              if (r.ok) {
                // Erst jetzt speichern: das Tor hat die Sitzung angenommen.
                storeSession(sess);
                location.replace(next);
                return;
              }
              showDiscordStatus(
                r.status === 403
                  ? 'Signed in, but this account has no Test Pilot access.'
                  : 'Could not verify access — please try again.',
                'error'
              );
              discordBtn.disabled = false;
              discordBtnTxt.textContent = 'Sign in with Discord';
            });
          })
          .catch(function () {
            showDiscordStatus('Network error — please try again.', 'error');
            discordBtn.disabled = false;
            discordBtnTxt.textContent = 'Sign in with Discord';
          });
        return true;
      }

      if (!handleOauthReturn()) tryEnter();

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = form.elements.namedItem('email').value.trim();
        var password = form.elements.namedItem('password').value;
        if (!email || !password) return;

        btn.disabled = true;
        btnTxt.textContent = 'Signing in …';
        showStatus('');

        // SDK-frei, same-origin-unabhaengig: derselbe Endpunkt, den
        // assets/account-lite.js fuer den Refresh nutzt (grant_type
        // unterscheidet sich).
        fetch(SB_URL + '/auth/v1/token?grant_type=password', {
          method: 'POST',
          headers: { apikey: SB_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, password: password }),
        })
          .then(function (r) {
            return r.json().then(function (body) { return { ok: r.ok, body: body }; });
          })
          .then(function (result) {
            if (!result.ok || !result.body || !result.body.access_token) {
              showStatus('Wrong e-mail or password.', 'error');
              btn.disabled = false;
              btnTxt.textContent = 'Sign in';
              return;
            }
            var factors = codeFactors(result.body);
            if (factors) {
              btn.disabled = false;
              btnTxt.textContent = 'Sign in';
              askGateCode(result.body, factors);
              return;
            }
            return mint(result.body.access_token).then(function (r) {
              if (r.ok) {
                // Erst speichern, wenn das Tor die Sitzung angenommen hat.
                storeSession(result.body);
                location.replace(next);
                return;
              }
              showStatus(
                r.status === 403
                  ? 'Signed in, but this account has no Test Pilot access.'
                  : 'Could not verify access — please try again.',
                'error'
              );
              btn.disabled = false;
              btnTxt.textContent = 'Sign in';
            });
          })
          .catch(function () {
            showStatus('Network error — please try again.', 'error');
            btn.disabled = false;
            btnTxt.textContent = 'Sign in';
          });
      });
    })();
  </script>
</body>
</html>
