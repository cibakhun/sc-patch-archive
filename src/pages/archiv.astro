---
// Patch archive hub (EN). Body lives in PatchArchive.astro — shared verbatim
// with /de/archiv.astro so the two languages cannot drift.
import Layout from '../layouts/Layout.astro';
import PatchArchive from '../components/PatchArchive.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';

const patches = await getCollection('patches');
const patchCount = patches.length;
const topicCount = patches.reduce((n, p) => n + p.data.topics.length, 0);
// Spanne aus dem Bestand statt von Hand: Titel und Beschreibung standen bis
// 07.10.2026 noch auf "4.0 bis 4.9", zwei Patches nach 4.9.
const latest = [...patches].sort((a, b) => a.data.date.localeCompare(b.data.date)).at(-1)!.data;
const latestMinor = latest.version.split('.').slice(0, 2).join('.');

// Cache-Bust für /assets/archive.css: feste URL, sonst liefert das CDN nach
// einem Deploy bis zu 1 Tag die ALTE Datei aus (siehe SiteNav/account-lite.js).
let cssVer = 'x';
try {
  cssVer = createHash('sha1').update(readFileSync('assets/archive.css')).digest('hex').slice(0, 8);
} catch { /* dev-Fallback */ }
---

<Layout
  title={`Star Citizen Patch Archive — Alpha 4.0 to ${latestMinor} | VerseBase`}
  description={`The complete Star Citizen patch archive of the Alpha 4 era: ${patchCount} patches from Destination Pyro (4.0.0) to ${latest.codename} (${latest.version}), with ${topicCount} topic deep dives.`}
  themeColor="#04060e"
  footer={true}
  translated={true}
  ogImage="/assets/trailer-4-9-0.jpg"
>
  <link slot="head" rel="stylesheet" href={`/assets/archive.css?v=${cssVer}`} />
  <PatchArchive />
</Layout>
