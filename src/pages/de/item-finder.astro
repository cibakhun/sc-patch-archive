---
// Hülle (DE). Körper: components/ItemFinderPage.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können.
import { versioned } from '../../lib/assetVersion';
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/ItemFinderPage.astro';
import DB from '../../../assets/universal-items.json';

const total = DB.counts.items;
const sourced = DB.counts.withObtain;
---
<Layout title={`Star Citizen Item Finder — ${total} Items & Preise | VerseBase`} description={`Alle ${total} Star-Citizen-Items durchsuchen: Kaufpreise, Shop-Orte, Loot-Fundorte und Schiffshändler — ${sourced} mit verifizierten In-Game-Quellen.`} themeColor="#0d0c14" ogType="article" ogImage="/assets/cz-loot.jpg" translated={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
