---
// EVOLUTION — the signature feature no other SC site has: every game system
// (rows) × every patch (columns), each cell colored in its patch's palette.
// Click a cell to expand the actual changes with deep-links into the archive.
// Fed entirely by the data layer. Calm data page: no starfield, no scanlines,
// no motion — the per-patch color system itself is the spectacle here.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import { getCollection } from 'astro:content';

const patches = (await getCollection('patches')).sort((a, b) =>
  a.data.date.localeCompare(b.data.date)
);

// rows: systems ordered by how often they were touched
const counts = new Map<string, number>();
for (const p of patches)
  for (const f of p.data.features)
    counts.set(f.system ?? 'Sonstiges', (counts.get(f.system ?? 'Sonstiges') ?? 0) + 1);
const systems = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([s]) => s);

// cells: system × patch -> features
type Feat = (typeof patches)[number]['data']['features'][number];
const cell = (sys: string, p: (typeof patches)[number]): Feat[] =>
  p.data.features.filter((f) => (f.system ?? 'Sonstiges') === sys);

const total = [...counts.values()].reduce((a, b) => a + b, 0);
const eraCount = new Set(patches.map((p) => p.data.era)).size;
// era zones: first column of each era gets a vertical seam + era label
const eraStarts = patches.map((p, i) => i === 0 || p.data.era !== patches[i - 1].data.era);
// Feinere Trennung nach Patch-Zyklus: 4.8.0–4.8.3 gehoeren zusammen, 4.9.0
// faengt neu an. Eine Aera fasst bis zu vier Zyklen (Neue Horizonte = 4.4–4.7),
// zwischen denen sonst gar keine Linie stuende. Jeder Aera-Anfang ist auch ein
// Zyklus-Anfang, die Aera-Naht bleibt deshalb die kraeftigere von beiden.
const cycleOf = (v: string) => v.split('.').slice(0, 2).join('.');
const cycleStarts = patches.map(
  (p, i) => i === 0 || cycleOf(p.data.version) !== cycleOf(patches[i - 1].data.version)
);
const rowTotal = (sys: string) => patches.reduce((n, p) => n + cell(sys, p).length, 0);
const tierOf = (n: number) => (n <= 2 ? '1' : n <= 5 ? '2' : '3');
---
<Layout
  title="Star Citizen Evolution — Patch-Verlauf je System | VerseBase"
  description={`Jedes Star-Citizen-System über jeden Patch: ${total} dokumentierte Änderungen über ${patches.length} Patches, von Alpha 4.0.0 bis ${patches[patches.length - 1].data.version}. Die interaktive Übersicht.`}
  themeColor="#04060c"
  footer={true}
  translated={true}
  ogImage="/assets/t-mesh-1.jpg"
>
<style is:inline>
:root{
  --bg:#04060c;--bg-2:#080d18;--surface:#0e1626;--surface-2:#131e33;
  --accent:#2dd4ff;--accent-2:#6ea8ff;--gold:#d4af37;
  --text:#eef3fb;--muted:#8ea0be;--line:rgba(150,180,220,.14);--line-2:rgba(150,180,220,.26);
  --font-display:'Orbitron',sans-serif;--font-ui:'Rajdhani',sans-serif;--font-body:'Barlow',system-ui,sans-serif;
  --maxw:1400px;
}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f4f7fe;--bg-2:#e8eef9;--surface:#fdfdff;--surface-2:#edf3fc;--text:#1c1f25;--muted:#4d596c;--accent:#05657c;--accent-2:#0850ad;--gold:#685301;--ink:#ffffff;--accent-media:#2dd4ff;--accent-2-media:#6ea8ff;--line:rgba(43,125,148,.3);--line-2:rgba(43,125,148,.42)}





*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}</style>

<SiteNav crumbs={[{ label: 'Archiv', href: '/de/archiv.html' }, { label: 'Evolution' }]} hasEn={true} />

<main class="evo">
  <header class="evo__head">
    <span class="evo__kicker">Systeme × Patches</span>
    <h1>Evolution</h1>
    <p class="evo__sub">
      Wie sich jedes Spielsystem von Alpha 4.0.0 bis {patches[patches.length - 1].data.version} entwickelt hat.
      Jede Spalte trägt die Farbe ihres Patches — Zelle anklicken für die Details.
    </p>
    <dl class="evo__metrics">
      <div><dt>Änderungen</dt><dd>{total}</dd></div>
      <div><dt>Systeme</dt><dd>{systems.length}</dd></div>
      <div><dt>Patches</dt><dd>{patches.length}</dd></div>
      <div><dt>Ären</dt><dd>{eraCount}</dd></div>
    </dl>
  </header>

  <div class="evo__matrix" data-evo-matrix>
  <div class="evo__legend">
    <span class="evo__lg" aria-hidden="true"><i class="t1"></i><i class="t2"></i><i class="t3"></i></span>
    <span>Intensität = Aktivität</span>
    <span class="evo__legdot" aria-hidden="true">·</span>
    <span>Zahl = Einträge · Klick = Details</span>
    <span class="evo__legmore" data-evo-hint>Seitwärts scrollen für die neueren Patches →</span>
  </div>

  <div class="evo__scrollwrap">
  <div class="evo__scroll" tabindex="0" aria-label="Evolutions-Matrix (horizontal scrollbar)">
    <table class="evo__table">
      <thead>
        <tr>
          <th class="evo__syshead" scope="col">System</th>
          {patches.map((p, pi) => (
            <th scope="col" class={`evo__col${cycleStarts[pi] ? ' evo__cyclestart' : ''}${eraStarts[pi] ? ' evo__erastart' : ''}`} style={`--c:${p.data.palette.accent}`}>
              {eraStarts[pi] && <span class="evo__era">{p.data.era}</span>}
              <a href={`/de/patches/sc-${p.id}.html`} title={`${p.data.codename} · ${p.data.dateDisplay}`}>
                {p.data.version}
              </a>
            </th>
          ))}
          <th scope="col" class="evo__tot" title="Einträge gesamt">Σ</th>
        </tr>
      </thead>
      <tbody>
        {systems.map((sys, si) => (
          <tr>
            <th scope="row" class="evo__sys">{sys}</th>
            {patches.map((p, pi) => {
              const feats = cell(sys, p);
              return (
                <td class={`evo__td${cycleStarts[pi] ? ' evo__cyclestart' : ''}${eraStarts[pi] ? ' evo__erastart' : ''}`}>
                  {feats.length > 0 ? (
                    <button
                      class="evo__cell"
                      style={`--c:${p.data.palette.accent}`}
                      data-ed={`ed-${si}-${pi}`}
                      data-tier={tierOf(feats.length)}
                      aria-expanded="false"
                      aria-label={`${sys} in Alpha ${p.data.version}: ${feats.length} Änderung${feats.length > 1 ? 'en' : ''}`}
                    >{feats.length}</button>
                  ) : (
                    <span class="evo__dot" aria-hidden="true">·</span>
                  )}
                </td>
              );
            })}
            <td class="evo__totcell">×{rowTotal(sys)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  </div>
  </div>

  <div class="evo__detail" id="evo-detail" hidden>
    {systems.map((sys, si) =>
      patches.map((p, pi) => {
        const feats = cell(sys, p);
        if (!feats.length) return null;
        return (
          <div class="edet" id={`ed-${si}-${pi}`} hidden style={`--c:${p.data.palette.accent}`}>
            <header class="edet__head">
              <span class="edet__sys">{sys}</span>
              <span class="edet__meta">
                <a class="edet__patch" href={`/de/patches/sc-${p.id}.html`}>
                  Alpha {p.data.version} — {p.data.codename} · {p.data.dateDisplay} →
                </a>
                <button class="edet__x" data-eclose aria-label="Details schließen">Esc</button>
              </span>
            </header>
            {feats.map((f) => (
              <article class="edet__feat">
                <h3>{f.name}{f.unverified && <abbr class="edet__unv" title="unbestätigt">*</abbr>}</h3>
                <p>{f.desc}</p>
                {(f.facts?.length ?? 0) > 0 && (
                  <dl class="edet__facts">
                    {f.facts!.map((x) => (
                      <div><dt>{x.label}</dt><dd>{x.value}</dd></div>
                    ))}
                  </dl>
                )}
                {f.topicSlug && <a class="edet__link" href={`/de/topics/${f.topicSlug}.html`}>Deep-Dive ansehen →</a>}
              </article>
            ))}
          </div>
        );
      })
    )}
  </div>
</main>

<style is:inline>
.evo{--gut:clamp(1.25rem,4vw,3rem);max-width:var(--maxw);margin:0 auto;padding:8rem var(--gut) 5rem}
.evo__head{margin-bottom:1.8rem}
.evo__kicker{display:inline-flex;align-items:center;gap:.7rem;font-family:var(--font-ui);font-weight:700;letter-spacing:var(--ls-19);text-transform:uppercase;font-size:var(--fs-5);color:var(--accent)}
.evo__kicker::before{content:"";width:26px;height:1px;background:var(--accent)}
.evo__head h1{font-family:var(--font-display);font-weight:900;font-size:clamp(2.4rem,6vw,4rem);line-height:.95;margin:.7rem 0 0;letter-spacing:var(--ls-1);background:linear-gradient(180deg,var(--title-hi) 55%,#c4dae6);-webkit-background-clip:text;background-clip:text;color:transparent}
.evo__sub{max-width:64ch;color:var(--muted);margin-top:.8rem;font-size:var(--fs-11)}
.evo__metrics{display:flex;flex-wrap:wrap;gap:.5rem 2.6rem;margin:1.6rem 0 0;padding-top:1.4rem;border-top:1px solid var(--line)}
.evo__metrics div{display:flex;flex-direction:column;line-height:1.1}
.evo__metrics dt{order:2;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted);margin-top:.2rem}
.evo__metrics dd{order:1;font-family:var(--font-display);font-weight:800;font-size:clamp(1.4rem,2.5vw,1.9rem);color:var(--text);font-variant-numeric:tabular-nums}
.evo__legend{display:flex;align-items:center;gap:.7rem 1rem;flex-wrap:wrap;padding:.7rem 1.1rem;border:1px solid var(--line);border-radius:10px;background:var(--bg-2);margin-bottom:1rem;
  font-family:var(--font-ui);font-weight:600;font-size:var(--fs-6);letter-spacing:var(--ls-9);color:var(--muted)}
.evo__legdot{opacity:.45}
.evo__lg{display:inline-flex;gap:.25rem}
.evo__lg i{width:1rem;height:1rem;border-radius:3px;border:1px solid color-mix(in srgb,var(--accent) 45%,transparent)}
.evo__lg .t1{background:color-mix(in srgb,var(--accent) 13%,transparent)}
.evo__lg .t2{background:color-mix(in srgb,var(--accent) 28%,transparent)}
.evo__lg .t3{background:color-mix(in srgb,var(--accent) 46%,transparent)}
/* Erscheint nur, wenn die Matrix wirklich breiter ist als das Fenster. */
.evo__legmore{display:none}
.evo__legmore.is-on{display:inline;margin-left:auto;color:var(--accent)}

/* Die Matrix wächst mit jedem Patch um eine Spalte und ist längst breiter
   als die 1400er-Lesespalte. Sie bricht deshalb auf die volle Fensterbreite
   aus — ab ~1700 px passt sie damit ganz hinein. Was dann noch fehlt, muss
   man scrollen, und DASS es scrollbar ist, muss man sehen: assets/theme.css
   blendet global JEDE Bildlaufleiste mit !important aus, und der Ersatz-
   Hinweis in assets/mobile-ux.css hängt an max-width:820px. Am Desktop
   endete die Tabelle deshalb ohne jeden Hinweis mitten in einer Spalte.
   Die Legende zieht mit — sie beschreibt die Matrix und soll auf deren
   Kante sitzen, nicht auf der der Lesespalte. */
.evo__matrix{margin-inline:calc(50% - 50vw);padding-inline:var(--gut)}
.evo__scrollwrap{position:relative}
.evo__scrollwrap::after{content:"";position:absolute;z-index:4;top:1px;bottom:1px;right:1px;
  width:56px;border-radius:0 13px 13px 0;pointer-events:none;opacity:0;transition:opacity var(--dur-base) var(--ease-ui);
  background:linear-gradient(270deg,var(--bg-2) 16%,color-mix(in srgb,var(--bg-2) 55%,transparent) 62%,transparent)}
.evo__matrix.is-more .evo__scrollwrap::after{opacity:1}

/* Eigene Hoehe, damit die Matrix senkrecht IN SICH scrollt. Nur so bleiben
   die Patch-Nummern beim Lesen der unteren Zeilen stehen: `position:sticky`
   richtet sich immer am naechsten Scrollbereich aus, und der ist hier durch
   `overflow-x:auto` ohnehin dieser Kasten — an den Seiten-Scrollbereich kommt
   ein Kopf darin nicht heran (mit `overflow-y:clip` geprueft: der Kopf klebt
   dann bloss am oberen Rand des Kastens statt am Fenster).
   9rem lassen Platz fuer die feste Leiste (65 px) und etwas Luft. */
.evo__scroll{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--bg-2);
  max-height:calc(100vh - 9rem);max-height:calc(100dvh - 9rem)}
/* Bildlaufleiste zurückholen — nur für diese eine Tabelle. Das !important
   ist kein Schmuck: die globale Ausblendung in assets/theme.css trägt
   selbst eines und gewinnt sonst. */
.evo__scroll{scrollbar-width:thin!important;scrollbar-color:color-mix(in srgb,var(--accent) 50%,transparent) transparent}
.evo__scroll::-webkit-scrollbar{display:block!important;height:10px!important;background:transparent!important}
.evo__scroll::-webkit-scrollbar-track{background:transparent}
.evo__scroll::-webkit-scrollbar-thumb{background-color:color-mix(in srgb,var(--accent) 42%,transparent);
  border:3px solid transparent;background-clip:padding-box;border-radius:999px}
.evo__scroll::-webkit-scrollbar-thumb:hover{background-color:color-mix(in srgb,var(--accent) 70%,transparent)}
.evo__table{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%}
.evo__table th,.evo__table td{border-bottom:1px solid var(--line)}
/* Die Ecke klebt in BEIDE Richtungen und muss ueber beiden Leisten liegen:
   z 5 Ecke > 4 Kopfzeile > 2 System-Spalte. */
.evo__syshead{position:sticky;left:0;top:0;z-index:5;background:var(--bg-2);text-align:left;
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-14);text-transform:uppercase;color:var(--muted);
  padding:.9rem 1rem;min-width:210px;border-right:1px solid var(--line-2)}
/* Das obere Drittel der Kopfzeile ist das Ären-Band; die Höhe steht fest,
   damit die Beschriftungen aus dem Fluss dürfen (siehe .evo__era). */
/* `sticky` ist ein positionierter Wert — die absolut gesetzte Ären-Beschriftung
   haengt weiterhin an dieser Zelle und faehrt mit. Der deckende Hintergrund ist
   Pflicht, sonst scheinen die Zeilen beim Scrollen durch die Kopfzeile. */
.evo__col{position:sticky;top:0;z-index:3;background:var(--bg-2);
  padding:2.05rem .4rem .55rem;min-width:70px;border-bottom:2px solid var(--c);vertical-align:bottom}
/* Die Ären-Beschriftung ragt ueber ihre Spalte hinaus (deshalb steht sie
   absolut, siehe unten). Seit die Kopfzellen einen deckenden Hintergrund
   brauchen, uebermalt die naechste Zelle diesen Ueberstand — die Naht-Zelle
   muss deshalb VOR ihren Nachbarn liegen. Unter der Ecke (z 5) bleibt sie,
   sonst schoebe sich die Beschriftung beim Scrollen ueber die System-Spalte. */
.evo__col.evo__erastart{z-index:4}
.evo__col a{font-family:var(--font-display);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-5);color:var(--c);white-space:nowrap}
.evo__col a:hover{text-decoration:underline}
/* Ären-Namen sind bis zu 104 px breit und haben ihre Spalte auf 120 px
   aufgebläht — fünfmal, zusammen 164 px, die rechts fehlten. Absolut
   gesetzt beschriften sie die Naht, ohne die Spalte zu bestimmen. */
.evo__era{position:absolute;top:.62rem;left:.34rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-3);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--c);opacity:.7;white-space:nowrap;text-align:left}
/* Zwei Staerken: jeder Patch-Zyklus bekommt eine feine Naht, der Ären-Wechsel
   die kraeftige. Reihenfolge zaehlt — beide Klassen sitzen an denselben
   Zellen, die Aera muss gewinnen. */
.evo__cyclestart{border-left:1px solid var(--line)}
.evo__erastart{border-left:1px solid var(--line-2)}
.evo__tot{position:sticky;top:0;z-index:3;background:var(--bg-2);
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-11);color:var(--muted);padding:.7rem .8rem;border-left:1px solid var(--line-2);vertical-align:bottom}
.evo__totcell{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);color:var(--muted);text-align:center;padding:.3rem .6rem;border-left:1px solid var(--line-2);font-variant-numeric:tabular-nums}
.evo__sys{position:sticky;left:0;z-index:2;background:var(--bg-2);text-align:left;
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-10);color:var(--text);
  padding:.5rem 1rem;border-right:1px solid var(--line-2);white-space:nowrap;transition:background-color var(--dur-fast) var(--ease-ui),color var(--dur-fast) var(--ease-ui)}
tbody tr:hover .evo__sys{background:var(--surface);color:var(--text)}
.evo__td{text-align:center;padding:.32rem .28rem}
.evo__cell{font-family:var(--font-ui);font-weight:700;
  width:2.15rem;height:2.15rem;cursor:pointer;color:var(--c);
  border:1px solid color-mix(in srgb,var(--c) 45%,transparent);border-radius:6px;
  transition:background-color var(--dur-fast) var(--ease-ui),border-color var(--dur-fast) var(--ease-ui),transform var(--dur-fast) var(--ease-ui)}
.evo__cell[data-tier="1"]{background:color-mix(in srgb,var(--c) 13%,transparent);font-size:var(--fs-7)}
.evo__cell[data-tier="2"]{background:color-mix(in srgb,var(--c) 26%,transparent);font-size:var(--fs-9)}
.evo__cell[data-tier="3"]{background:color-mix(in srgb,var(--c) 42%,transparent);font-size:var(--fs-10)}
.evo__cell:hover{background:color-mix(in srgb,var(--c) 55%,transparent);border-color:var(--c);transform:translateY(-1px)}
.evo__cell.sel{background:var(--c);color:var(--ink);border-color:var(--c)}
.evo__dot{color:var(--muted);opacity:.22}
/* --c ist die Patch-Akzentfarbe und kommt als style="--c:…" aus den Daten —
   eine Palette kann sie deshalb nicht überschreiben. Für Papier wird sie hier
   zur Laufzeit abgedunkelt: Farbton bleibt (jede Ära behält ihre Farbe),
   Helligkeit wird lesbar. In oklab gemischt, damit der Ton beim Abdunkeln
   nicht kippt. */
:root[data-theme="light"] .evo__cell{color:color-mix(in oklab,var(--c) 58%,#000);border-color:color-mix(in oklab,var(--c) 46%,#000)}
:root[data-theme="light"] .evo__cell.sel{background:color-mix(in oklab,var(--c) 62%,#000);border-color:color-mix(in oklab,var(--c) 62%,#000);color:#fff}
:root[data-theme="light"] :is(.evo__col,.evo__col a,.evo__era,.edet__sys,.edet__patch){color:color-mix(in oklab,var(--c) 58%,#000)}

.evo__detail{margin-top:1.4rem}
.edet{border:1px solid var(--line);border-top:2px solid var(--c);border-radius:12px;background:var(--surface);padding:1.4rem 1.6rem 1.5rem}
.edet__head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.6rem 1.2rem;
  border-bottom:1px solid var(--line);padding-bottom:.6rem;margin-bottom:1rem}
.edet__sys{font-family:var(--font-display);font-weight:800;font-size:var(--fs-11);letter-spacing:var(--ls-5);color:var(--text)}
.edet__meta{display:inline-flex;align-items:baseline;gap:1rem}
.edet__patch{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-13);text-transform:uppercase;color:var(--muted);transition:color var(--dur-fast) var(--ease-ui)}
.edet__patch:hover{color:var(--c)}
.edet__x{background:var(--veil);border:1px solid var(--line);border-radius:1px;color:var(--muted);
  font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-10);text-transform:uppercase;
  padding:.14rem .45rem;cursor:pointer;transition:color var(--dur-fast) var(--ease-ui),border-color var(--dur-fast) var(--ease-ui)}
.edet__x:hover{color:var(--c);border-color:color-mix(in srgb,var(--c) 55%,transparent)}
.edet__feat{padding:.85rem 0;border-top:1px solid var(--line)}
.edet__feat:first-of-type{border-top:0}
.edet__feat h3{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-11)}
.edet__feat p{font-size:var(--fs-10);color:var(--text);opacity:.85;max-width:88ch}
.edet__facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:.5rem 1.2rem;margin:.6rem 0 0}
.edet__facts div{border-left:2px solid var(--line);padding-left:.6rem}
.edet__facts dt{font-family:var(--font-ui);font-weight:700;font-size:var(--fs-4);letter-spacing:var(--ls-12);text-transform:uppercase;color:var(--muted)}
.edet__facts dd{margin:.05rem 0 0;font-size:var(--fs-9)}
.edet__link{display:inline-block;margin-top:.55rem;font-family:var(--font-ui);font-weight:700;font-size:var(--fs-6);letter-spacing:var(--ls-11);text-transform:uppercase;color:var(--c)}
.edet__link:hover{text-decoration:underline}
.edet__unv{color:var(--c);text-decoration:none;cursor:help;margin-left:.15rem}

@media(max-width:1024px){
  .evo__cell{width:1.85rem;height:1.85rem}
  .evo__cell[data-tier="1"]{font-size:var(--fs-6)}
  .evo__cell[data-tier="2"]{font-size:var(--fs-7)}
  .evo__cell[data-tier="3"]{font-size:var(--fs-8)}
  .evo__col{min-width:64px}
  .evo__col a{font-size:var(--fs-4)}
  .evo__sys{font-size:var(--fs-8)}
  .evo__syshead{min-width:150px}
}
@media(max-width:560px){
  .evo{padding-top:6.5rem}
  .evo__syshead,.evo__sys{min-width:128px}
  .evo__sys{white-space:normal}
}</style>

<script is:inline>
(function () {
  // Kante und Hinweis stehen nur da, solange rechts wirklich noch etwas
  // kommt — am Ende angekommen verschwinden beide, sonst wäre der
  // Farbverlauf eine Dauerlüge über einer vollständigen Tabelle.
  var shell = document.querySelector('[data-evo-matrix]');
  var scroller = shell && shell.querySelector('.evo__scroll');
  if (scroller) {
    var hint = document.querySelector('[data-evo-hint]');
    var syncEdge = function () {
      var more = scroller.scrollWidth - scroller.clientWidth - scroller.scrollLeft > 2;
      shell.classList.toggle('is-more', more);
      if (hint) hint.classList.toggle('is-on', more);
    };
    scroller.addEventListener('scroll', syncEdge, { passive: true });
    window.addEventListener('resize', syncEdge);
    if (window.ResizeObserver) new ResizeObserver(syncEdge).observe(scroller);
    // Die Anzeigeschriften laden nach und ändern die Tabellenbreite.
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncEdge);
    syncEdge();
  }

  var detail = document.getElementById('evo-detail');
  if (!detail) return;
  var open = null;
  function closeAll() {
    detail.hidden = true;
    open = null;
    document.querySelectorAll('.edet').forEach(function (x) { x.hidden = true; });
    document.querySelectorAll('.evo__cell.sel').forEach(function (x) {
      x.classList.remove('sel');
      x.setAttribute('aria-expanded', 'false');
    });
  }
  document.querySelectorAll('.evo__cell').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-ed');
      var d = document.getElementById(id);
      if (!d) return;
      var wasOpen = open === id;
      closeAll();
      if (wasOpen) return;
      detail.hidden = false;
      d.hidden = false;
      btn.classList.add('sel');
      btn.setAttribute('aria-expanded', 'true');
      open = id;
      d.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });
  });
  document.querySelectorAll('[data-eclose]').forEach(function (b) {
    b.addEventListener('click', closeAll);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && open) closeAll();
  });
  document.addEventListener('click', function (e) {
    if (!open) return;
    if (!detail.contains(e.target) && !e.target.closest('.evo__cell')) closeAll();
  });
})();
</script>
</Layout>
