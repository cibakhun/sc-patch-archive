---
// Hülle (DE). Körper: components/ships/ShipsOverview.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können (D-12).
import vehiclesSnapshot from '../../data/vehicles.json';
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/ships/ShipsOverview.astro';
---
<Layout
  title="Star-Citizen-Schiffe & Fahrzeuge — Datenbank | VerseBase"
  description={`${vehiclesSnapshot.count} Star-Citizen-Schiffe und Fahrzeuge mit Specs, Pledge- und Ingame-Preisen, deutschen Beschreibungen und Patch-Historie — Datenstand ${vehiclesSnapshot.fetchedAt}.`}
  themeColor="#05070d"
  footer={true}
  translated={true}
  ogImage="/assets/img-hammerhead.jpg"
>
{/* Die Filterleiste steht in Rajdhani 600 (font-ui). Ohne Vorladen kam die
    Schrift erst nach dem ersten Bild, die Auswahlfelder wurden schmaler und
    die Leiste brach neu um: gemessen CLS 0,31 → 0,06 (27.10.2026). */}
<link slot="head" rel="preload" href="/assets/fonts/rajdhani-600-latin.woff2" as="font" type="font/woff2" crossorigin />
<Body />
</Layout>
