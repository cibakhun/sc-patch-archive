---
// Passwort vergessen — DE-Spiegel. noindex: reiner Utility-Schritt.
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Attribution from '../../../components/Attribution.astro';
import AccountShell from '../../../components/account/AccountShell.astro';
import AuthReset from '../../../components/account/AuthReset.astro';
import { versioned } from '../../../lib/assetVersion';
---
<Layout
  title={'Passwort zurücksetzen | VerseBase'}
  description={'Passwort vergessen? Fordere einen Zurücksetz-Link für dein VerseBase-Konto an und komm in wenigen Minuten zurück zu deinen Schiffs-Favoriten.'}
  themeColor="#05070d"
  ogImage="/assets/og-default.jpg"
  translated={true}
  noindex={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<link slot="head" rel="stylesheet" href={versioned('assets/account.css', '/assets/account.css')} />
<style is:inline>
/* Palette lebt jetzt in /assets/account.css (geteilt, entdoppelt). */


.reveal{opacity:1 !important;transform:none !important}
.hero__in{max-width:var(--maxw)}</style>
<a class="skip" href="#main">Zum Inhalt springen</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Konto', href: '/de/account.html' }, { label: 'Passwort zurücksetzen' }]} hasEn={true} />

<main id="main">
  <AccountShell
    eyebrow="VerseBase · Systemzugang"
    titleThin="Ausgesperrt?"
    title="Passwort zurücksetzen"
  >
    <AuthReset lang="de" />
  </AccountShell>
</main>

<Attribution sources={[]} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
