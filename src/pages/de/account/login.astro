---
// Anmelden — DE-Spiegel von /account/login.html.
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Attribution from '../../../components/Attribution.astro';
import AccountShell from '../../../components/account/AccountShell.astro';
import AuthLogin from '../../../components/account/AuthLogin.astro';
import { versioned } from '../../../lib/assetVersion';
---
<Layout
  title={'Anmelden | VerseBase'}
  description={'Melde dich bei deinem VerseBase-Konto an: Profil verwalten und deine Star-Citizen-Lieblingsschiffe im Blick behalten.'}
  themeColor="#05070d"
  ogImage="/assets/og-default.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<link slot="head" rel="stylesheet" href={versioned('assets/account.css', '/assets/account.css')} />
<style is:inline>
/* Palette lebt jetzt in /assets/account.css (geteilt, entdoppelt). */

.hero__in{max-width:var(--maxw)}</style>
<a class="skip" href="#main">Zum Inhalt springen</a>

<SiteNav crumbs={[{ label: 'Konto', href: '/de/account.html' }, { label: 'Anmelden' }]} hasEn={true} />

<main id="main">
  <AccountShell
    eyebrow="VerseBase · Systemzugang"
    titleThin="Willkommen zurück"
    title="Anmelden"
    lead="Dein Profil und deine Lieblingsschiffe — ein Konto für ganz VerseBase."
  >
    <AuthLogin lang="de" />
  </AccountShell>
</main>

<Attribution sources={[]} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
