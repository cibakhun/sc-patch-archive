---
// Neues Passwort setzen (Recovery-Landing) — DE-Spiegel. noindex.
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Attribution from '../../../components/Attribution.astro';
import AccountShell from '../../../components/account/AccountShell.astro';
import AuthUpdatePassword from '../../../components/account/AuthUpdatePassword.astro';
import { versioned } from '../../../lib/assetVersion';
---
<Layout
  title={'Neues Passwort setzen | VerseBase'}
  description={'Setze ein neues Passwort für dein VerseBase-Konto — der Wiederherstellungs-Link aus deiner E-Mail landet hier und meldet dich sicher wieder an.'}
  themeColor="#05070d"
  ogImage="/assets/og-default.jpg"
  translated={true}
  noindex={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<link slot="head" rel="stylesheet" href={versioned('assets/account.css', '/assets/account.css')} />
<style is:inline>
/* Palette lebt jetzt in /assets/account.css (geteilt, entdoppelt). */


.reveal{opacity:1 !important;transform:none !important}
.hero__in{max-width:var(--maxw)}</style>
<a class="skip" href="#main">Zum Inhalt springen</a>

<SiteNav crumbs={[{ label: 'Konto', href: '/de/account.html' }, { label: 'Neues Passwort' }]} hasEn={true} />

<main id="main">
  <AccountShell
    eyebrow="VerseBase · Systemzugang"
    titleThin="Fast wieder drin"
    title="Neues Passwort"
  >
    <AuthUpdatePassword lang="de" />
  </AccountShell>
</main>

<Attribution sources={[]} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
