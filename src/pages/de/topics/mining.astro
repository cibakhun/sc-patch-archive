---
// Hülle (DE). Körper: components/topics/mining.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können.
import DB from '../../../../assets/mining-db.json';
import { versioned } from '../../../lib/assetVersion';
import { patchFromKennung } from '../../../lib/patchPages';
const total = DB.counts.minerals;
// Stand aus der Kennung der Mining-Datei, nicht von Hand: bis 03.11.2026 stand
// hier "4.9", waehrend die Datei auf 4.10.2 lag (verify:patch-angaben).
const patch = patchFromKennung(DB.game_version);
import Layout from '../../../layouts/Layout.astro';
import Body from '../../../components/topics/mining.astro';
---
<Layout title={`Mining-Datenbank — Star Citizen ${patch} | VerseBase`} description={`Interaktive Mining-Datenbank für Star Citizen ${patch}: ${total} Minerale durchsuchen, nach System, Methode & Typ filtern, echte Deposit-Regionen mit Erz-Anteil (%) ansehen, Scan-Signaturen identifizieren, Refinery-Methoden abwägen und sehen, welche Gesteinsart welches Erz führt.`} themeColor="#14181a" ogType="article" ogImage="/assets/img-mole.jpg" translated={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
