---
// Precision Jump — Aaron-Halo-Routenrechner (DE, /de/precision-jump.html).
// Reines Client-Werkzeug (kein Konto), indexierbar. Navigations-HUD-Theme
// (Amber/Cyan). Open-Source-Einsendung von „Jordessey", auf den Site-Design-
// Kit portiert. EN-Pendant: /precision-jump.html.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Attribution from '../../components/Attribution.astro';
import PrecisionJumpApp from '../../components/PrecisionJumpApp.astro';
import { buildAnchorRecords, AH_BAND_INFO } from '../../data/precision-jump';

const anchorCount = buildAnchorRecords().length;
const bandCount = Object.keys(AH_BAND_INFO).length;
---
<Layout
  title={'Precision Jump — Aaron-Halo-Routenrechner · Star Citizen | VerseBase'}
  description={`Aaron-Halo-Routenrechner fürs Star-Citizen-Mining: plotte die Quantum-Travel-Linie zwischen zwei von ${anchorCount} QT-Ankern und erhalte die exakte Ausstiegs-Koordinate samt Bandfenster für jedes der ${bandCount} Halo-Dichtebänder. Kostenloses, zweisprachiges Navigations-Werkzeug.`}
  themeColor="#080a14"
  ogType="article"
  ogImage="/assets/og-default.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<style is:inline>
/* Farbstrategie „Restrained": neutraler Grund plus GENAU EIN Akzent (Amber).
   --accent-2 war die zweite, cyanfarbene Leitfarbe und traegt allein auf
   dieser Seite rund 140 Fundstellen. Statt 140 Aufrufstellen anzufassen,
   wird der Token zur neutralen Sekundaerfarbe herabgestuft: die
   Zweitfarbigkeit verschwindet an der Wurzel, jede bestehende Regel bleibt
   gueltig. --glow existiert nicht mehr; Hoehe kommt aus Versatzschatten. */
:root{--bg:#0b0d12;--bg-2:#11141b;--surface:#151922;--surface-2:#1c212c;--accent:#f5a623;--accent-2:#9aa6bd;--hot:#ff5b6e;--text:#e9edf5;--muted:#9aa6bd;--line:rgba(233,237,245,.16);--line-soft:rgba(233,237,245,.08);--ink:#0a0d16;--maxw:1240px;--measure:68ch;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f7fe;--bg-2:#eaedf9;--surface:#fdfdff;--surface-2:#eff2fc;--text:#1b1f29;--muted:#4f586c;--accent:#7c5104;--accent-2:#045f77;--hot:#9c002c;--ink:#ffffff;--accent-media:#f5a623;--accent-2-media:#35d0ff;--line:rgba(148,104,38,.3);--line-soft:rgba(41,46,56,.12);--glow:0 6px 22px rgba(148,104,38,.18)}


.reveal{opacity:1 !important;transform:none !important}

/* ── Titelei ─────────────────────────────────────────────────────────────
   Kein Hero-Foto, kein Riesentitel, keine Kennzahlenzeile. Ein Almanach
   beginnt mit einer Titelseite: Reihe, Werktitel, Untertitel, Vorspann.
   Die Zahlen (25 Anker, 10 Baender) stehen im Satz, nicht in Kacheln —
   die Kennzahlenreihe war die Schablone, die diese Kategorie immer baut. */
.alm{max-width:var(--maxw);margin:0 auto;padding:clamp(2.5rem,7vw,5rem) clamp(1.25rem,5vw,3rem) 0}
.alm__series{font-family:var(--font-ui);font-size:.82rem;color:var(--muted);margin:0 0 1.6rem}
.alm__series a{color:var(--muted);border-bottom:1px solid var(--line)}
.alm__series a:hover{color:var(--accent);border-bottom-color:var(--accent)}
.alm__title{font-family:var(--font-display);font-weight:800;line-height:1.02;
  font-size:clamp(2.2rem,5.5vw,3.8rem);letter-spacing:-.02em;color:var(--text);margin:0}
.alm__sub{font-family:var(--font-ui);font-size:1.02rem;color:var(--muted);
  margin:.6rem 0 0;padding-bottom:1.5rem;border-bottom:1px solid var(--line);max-width:var(--measure)}
.alm__body{margin-top:1.8rem;max-width:var(--measure)}
.alm__body p{font-size:1.04rem;line-height:1.68;color:var(--text);margin:0 0 1.1rem}
.alm__body p:last-child{margin-bottom:0}
.alm__note{margin-top:1.7rem;padding-top:1.1rem;border-top:1px solid var(--line-soft);
  max-width:var(--measure);font-size:.94rem;line-height:1.6;color:var(--muted)}
.alm__note b{color:var(--text);font-weight:600}</style>
<a class="skip" href="#main">Zum Inhalt springen</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Mining', href: '/de/topics/mining.html' }, { label: 'Precision Jump' }]} hasEn={true} />

<main id="main">
  <header class="alm">
    <nav class="alm__series" aria-label="Brotkrumen"><a href="/de/topics/mining.html">Mining</a></nav>
    <h1 class="alm__title">Aaron Halo</h1>
    <p class="alm__sub">Austrittstafeln und Interpolationshilfe für den Quantenflug · Stanton · Spielstand 4.9</p>
    <div class="alm__body">
      <p>Der Aaron Halo ist der Asteroidenring zwischen Crusader und Hurston.
        Der Quantenflug durchquert ihn in Sekunden, und deshalb ist sein Abbau
        weniger eine Frage des Hinfliegens als des Anhaltens: Man verlässt den
        Antrieb auf einer Linie, die man nicht sieht, und wenige hundert
        Kilometer entscheiden, ob man im dichten Gestein ankommt oder im Leeren.</p>
      <p>Diese Tafeln geben dem Ring seine Zahlen. {bandCount} Dichtebänder sind
        nach Radius verzeichnet, und je zwei der {anchorCount} Quantenanker in
        Stanton spannen eine Flugline darüber auf. Wo eine Linie ein Band trifft,
        gibt es genau eine Entfernung, bei der man den Antrieb abschaltet — die
        Tafeln unten führen die Bänder, die Interpolationshilfe rechnet diese
        Entfernung für das gewählte Paar aus.</p>
    </div>
    <p class="alm__note">Ankerpositionen und Ringgeometrie sind spielgenau für 4.9.
      Die Dichtebänder sind die eine Ausnahme: Sie stammen aus einer
      Community-Vermessung von <b>cstone.space</b> und sind Schätzwerte. Verfahren
      und Ursprungsdaten der Route stammen von <b>Jordessey</b>; ein Ankerwert
      (MIC-L5) wurde bei der Prüfung gegen das Spiel korrigiert.</p>
  </header>

  <PrecisionJumpApp lang="de" />
</main>

<Attribution sources={["Jordessey (Werkzeug & Routendaten)", "cstone.space (Halo-Band-Vermessung)"]} credit="VerseBase · ein Star-Citizen-Fan-Projekt" />

<script is:inline src="/assets/detail.js"></script>
</Layout>
