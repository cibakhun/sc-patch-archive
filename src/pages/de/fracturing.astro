---
// Fracturing-Rechner — DE (/de/fracturing.html). Gegenstueck zu
// /fracturing.html; Koerper und Palette sind dort erklaert.
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Attribution from '../../components/Attribution.astro';
import FracturingCalc from '../../components/FracturingCalc.astro';
import DB from '../../../assets/mining-db.json';
import { versioned } from '../../lib/assetVersion';

const total = DB.counts.minerals;
const snap = DB.snapshot_date;
const verShort = DB.game_version.split('-')[0];
---
<Layout
  title={'Fracturing-Rechner — Star Citizen Mining | VerseBase'}
  description={`Rechne aus, ob dein Mining-Laser den Brocken aufbekommt (Star Citizen ${verShort}): eines von ${total} Erzen wählen, Laser, Module, Gadget und Felsmasse einstellen — mit Verhältniszahl und ausgeschriebenem Rechenweg.`}
  themeColor="#14181a"
  ogType="article"
  ogImage="/assets/img-mole.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<style is:inline>
:root{--bg:#14181a;--bg-2:#181d1f;--surface:#1e2427;--surface-2:#252c30;--accent:#2FBFA4;--accent-2:#E0A526;--hot:#A970FF;--text:#eaf2f1;--muted:#8fa3a0;--line:rgba(47,191,164,.22);--line-soft:rgba(234,242,241,.10);--glow:0 0 44px rgba(47,191,164,.26);--ink:#0e1214;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fb;--bg-2:#e8eff2;--surface:#fcfefe;--surface-2:#ebf4f9;--text:#1b2120;--muted:#4a5c5a;--accent:#036a5a;--accent-2:#704f00;--hot:#642aaa;--ink:#ffffff;--accent-media:#2FBFA4;--accent-2-media:#E0A526;--line:rgba(43,130,113,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,130,113,.18)}


/* ⚠ Der `.hero`-Block ist am 15.08.2026 ersatzlos entfallen — das Gehaeuse des
   Rechners traegt den Titel jetzt in seinem Kopfband. Geblieben ist allein die
   Polsterung, die vorher am Hero hing: die Navigationsleiste ist fest
   positioniert, sonst stuende der Rechner darunter. */
main > .fc{padding-top:4.4rem}
@media(max-width:1180px){main > .fc{padding-top:calc(var(--nav-h,116px) + .6rem)}}</style>
<a class="skip" href="#main">Zum Inhalt springen</a>

<SiteNav crumbs={[{ label: 'Mining', href: '/de/topics/mining.html' }, { label: 'Fracturing' }]} />

<main id="main">
  <FracturingCalc
    lang="de"
    title="Fracturing"
    eyebrow={`Alpha ${verShort} · Live-Daten`}
    lead="Ausrüstung einstellen, Erz wählen — der Rechner sagt, ob der Brocken bricht, und zeigt jeden Schritt der Rechnung." />
</main>

<Attribution sources={[]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
