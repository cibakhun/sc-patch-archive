---
// Refinery — DE (/de/refinery.html). Öffentlicher Wissensteil + kontogebundener
// Tracker (Auth in der Komponente, RLS). Als Mining-WERKZEUG platziert, nicht
// unter /account/, aber im Konto-Design (account.css + account-dossier.css).
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Attribution from '../../components/Attribution.astro';
import AccountShell from '../../components/account/AccountShell.astro';
import RefineryDashboard from '../../components/account/RefineryDashboard.astro';
import { versioned } from '../../lib/assetVersion';

const cssVer = (f: string) => { try { return createHash('sha1').update(readFileSync(f)).digest('hex').slice(0, 8); } catch { return 'x'; } };
const accountCss = `/assets/account.css?v=${cssVer('assets/account.css')}`;
const dossierCss = `/assets/account-dossier.css?v=${cssVer('assets/account-dossier.css')}`;
---
<Layout
  title={'Star Citizen Raffinerie: Ertrag je Station, Erze, Methoden & Auftrags-Tracker | VerseBase'}
  description={'Alle Star-Citizen-Raffinerien im Vergleich: Ertragsaufschlag je Station und Erz, alle Raffinerie-Methoden, Erzpreise, dazu ein Tracker für deine Aufträge mit Countdown und Erlös.'}
  themeColor="#05070d"
  ogImage="/assets/og-default.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<link slot="head" rel="stylesheet" href={accountCss} />
<link slot="head" rel="stylesheet" href={dossierCss} />
<a class="skip" href="#main">Zum Inhalt springen</a>

<SiteNav crumbs={[{ label: 'Mining', href: '/de/topics/mining.html' }, { label: 'Raffinerie' }]} hasEn={true} />

<main id="main">
  <AccountShell bare={true}>
    <RefineryDashboard lang="de" />
  </AccountShell>
</main>

<Attribution sources={['UEX Corp']} />

<script is:inline defer src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
