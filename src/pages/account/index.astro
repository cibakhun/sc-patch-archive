---
// Account-Dashboard — EN (/account.html). noindex: private Inhalte.
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import Attribution from '../../components/Attribution.astro';
import AccountShell from '../../components/account/AccountShell.astro';
import AccountDashboard from '../../components/account/AccountDashboard.astro';
import { versioned } from '../../lib/assetVersion';

// CSS-Cache-Bust per Content-Hash (sha1): die Dateien haben feste URLs und
// werden von Cloudflare/Browser gecacht; der Hash im ?v= erzwingt bei jeder
// Änderung automatisch einen frischen Abruf — kein manuelles Hochzählen mehr.
const cssVer = (f: string) => { try { return createHash('sha1').update(readFileSync(f)).digest('hex').slice(0, 8); } catch { return 'x'; } };
const accountCss = `/assets/account.css?v=${cssVer('assets/account.css')}`;
const dossierCss = `/assets/account-dossier.css?v=${cssVer('assets/account-dossier.css')}`;
---
<Layout
  title={'Your account | VerseBase'}
  description={'Your VerseBase account: profile, favorite ships, security settings.'}
  themeColor="#05070d"
  ogImage="/assets/og-default.jpg"
  translated={true}
  noindex={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<link slot="head" rel="stylesheet" href={accountCss} />
<link slot="head" rel="stylesheet" href={dossierCss} />
<style is:inline>
/* Palette + Shell-Stile leben jetzt in /assets/account.css (geteilt, entdoppelt). */
.hero__in{max-width:var(--maxw)}
.hero--acct{min-height:34svh}
.acwrap--wide .sec-head{margin-top:2.6rem}</style>
<a class="skip" href="#main">Skip to content</a>

<SiteNav crumbs={[{ label: 'Account' }]} hasEn={true} />

<main id="main">
  <AccountShell bare={true}>
    <AccountDashboard lang="en" />
  </AccountShell>
</main>

<Attribution sources={[]} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
