---
// Hülle (EN). Körper: components/topics/mining.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können.
import DB from '../../../assets/mining-db.json';
import { versioned } from '../../lib/assetVersion';
const total = DB.counts.minerals;
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/topics/mining.astro';
---
<Layout title={"Mining Database — Star Citizen 4.9 | VerseBase"} description={`Interactive mining database for Star Citizen 4.9: browse ${total} minerals, filter by system, method & type, see real deposit regions with ore-share %, identify scan signatures, weigh refinery methods and see which rocks carry which ore.`} themeColor="#14181a" ogType="article" ogImage="/assets/img-mole.jpg" translated={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
