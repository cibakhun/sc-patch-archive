---
// Hülle (EN). Körper: components/topics/mining.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können.
import DB from '../../../assets/mining-db.json';
import { versioned } from '../../lib/assetVersion';
const total = DB.counts.minerals;
// Patch aus dem Datenstand ("4.10.2-live.12881860" -> "4.10.2"), wie im Koerper
// (components/topics/mining.astro). Hier stand bis 03.11.2026 ein festes 4.9.
const ver = String(DB.game_version).split('-')[0];
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/topics/mining.astro';
---
<Layout title={`Mining Database — Star Citizen ${ver} | VerseBase`} description={`Interactive mining database for Star Citizen ${ver}: browse ${total} minerals, filter by system, method & type, see real deposit regions with ore-share %, identify scan signatures, weigh refinery methods and see which rocks carry which ore.`} themeColor="#14181a" ogType="article" ogImage="/assets/img-mole.jpg" translated={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
