---
// Hülle (EN). Körper: components/topics/crafting.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können.
import DB from '../../../assets/crafting-db.json';
const total = DB.counts.blueprints;
const ver = DB.version;
const patch = (ver.match(/(\d+\.\d+)/) ?? [])[1] ?? '4.9';
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/topics/crafting.astro';
---
<Layout title={`Crafting Database — Star Citizen ${patch} | VerseBase`} description={`Interactive crafting database for Star Citizen ${patch}: browse ${total} blueprints, filter by category & resource, inspect ingredients and item stats, simulate material quality and aggregate a shopping list in the fabricator planner.`} themeColor="#16161a" ogType="article" ogImage="/assets/t-craft-1.jpg" translated={true}>
<link slot="head" rel="stylesheet" href="/assets/detail.css" />
<Body />
</Layout>
