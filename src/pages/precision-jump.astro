---
// Precision Jump — Aaron-Halo-Routenrechner (EN, /precision-jump.html).
// Reines Client-Werkzeug (kein Konto), indexierbar.
//
// RICHTUNGSVERTRAG — siehe DESIGN.md, Fassung 2 (Modus `operate`).
// Kurz: das Werkzeug IST das Produkt dieser Seite. Kompakte Titelei,
// darunter sofort Bedienung und Karte; alles Erklaerende steht am Fuss.
// Kein Hero, keine Marginalspalte — beides gehoerte zur verworfenen
// Fassung 1 (Modus `read`).
// DE-Pendant: /de/precision-jump.html.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import PrecisionJumpApp from '../components/PrecisionJumpApp.astro';
import { buildAnchorRecords, AH_BAND_INFO } from '../data/precision-jump';
import { versioned } from '../lib/assetVersion';

const anchorCount = buildAnchorRecords().length;
const bands = Object.values(AH_BAND_INFO);
const bandCount = bands.length;
---
<Layout
  title={'Precision Jump — Aaron Halo Route Calculator · Star Citizen | VerseBase'}
  description={`Aaron Halo route calculator for Star Citizen mining: plot the quantum-travel line between any two of ${anchorCount} QT anchors, get the exact dropout coordinate and band window to drop into any of the ${bandCount} Halo density bands. Free, bilingual navigation tool.`}
  themeColor="#080a14"
  ogType="article"
  ogImage="/assets/og-default.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<style is:inline>
/* Farbstrategie „Restrained": neutraler Grund plus GENAU EIN Akzent (Amber).
   --accent-2 war die zweite, cyanfarbene Leitfarbe und traegt allein auf
   dieser Seite rund 140 Fundstellen. Statt 140 Aufrufstellen anzufassen,
   wird der Token zur neutralen Sekundaerfarbe herabgestuft: die
   Zweitfarbigkeit verschwindet an der Wurzel, jede bestehende Regel bleibt
   gueltig. --glow existiert nicht mehr; Hoehe kommt aus Versatzschatten. */
:root{--bg:#0b0d12;--bg-2:#11141b;--surface:#151922;--surface-2:#1c212c;--accent:#f5a623;--accent-2:#9aa6bd;--hot:#ff5b6e;--text:#e9edf5;--muted:#9aa6bd;--line:rgba(233,237,245,.16);--line-soft:rgba(233,237,245,.08);--ink:#0a0d16;--maxw:1240px;--measure:68ch;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f5f7fe;--bg-2:#e9eef8;--surface:#fdfdff;--surface-2:#eef2fc;--text:#1c1f25;--muted:#4e586c;--accent:#7c5104;--accent-2:#49556d;--hot:#9c002c;--ink:#ffffff;--accent-media:#f5a623;--accent-2-media:#9aa6bd;--line:rgba(148,104,38,.3);--line-soft:rgba(43,46,52,.12)}




.reveal{opacity:1 !important;transform:none !important}

/* ── Titelei ─────────────────────────────────────────────────────────────
   Kein Hero-Foto, kein Riesentitel, keine Kennzahlenzeile. Ein Almanach
   beginnt mit einer Titelseite: Reihe, Werktitel, Untertitel, Vorspann.
   Die Zahlen (25 Anker, 10 Baender) stehen im Satz, nicht in Kacheln —
   die Kennzahlenreihe war die Schablone, die diese Kategorie immer baut. */
/* ── Titelei ── volle Breite, darunter beginnt der zweispaltige Satzspiegel */
/* Kompakt: der Kopf darf das Werkzeug nicht unter die Falz schieben. */
/* Der Titelkopf begann bei y=0 — die Reihenzeile („Mining ›") lag damit
   vollstaendig hinter der festen Kopfleiste, und der Titel begann 9 px
   darunter. --nav-h ist der von SiteNav veroeffentlichte Freiraum (Leiste
   plus die frei haengende Zurueck-Marke, falls vorhanden). */
.alm{max-width:var(--maxw);margin:0 auto;padding:calc(var(--nav-h, 68px) + clamp(1.2rem,3vw,2rem)) clamp(1.25rem,5vw,3rem) 0}
.alm__series{font-family:var(--font-ui);font-size:.84rem;color:var(--muted);margin:0 0 .7rem}
.alm__series a{color:var(--muted);border-bottom:1px solid var(--line)}
.alm__series a:hover{color:var(--accent);border-bottom-color:var(--accent)}
.alm__title{font-family:var(--font-display);font-weight:800;line-height:1.02;
  font-size:clamp(1.7rem,3.4vw,2.4rem);letter-spacing:-.02em;color:var(--text);margin:0}
.alm__sub{font-family:var(--font-ui);font-size:.95rem;color:var(--muted);
  margin:.4rem 0 0;padding-bottom:.9rem;border-bottom:1px solid var(--line);max-width:74ch}</style>
<a class="skip" href="#main">Skip to content</a>
<div class="cursorglow" aria-hidden="true"></div>

<SiteNav crumbs={[{ label: 'Mining', href: '/topics/mining.html' }, { label: 'Precision Jump' }]} hasEn={true} />

<main id="main">
  <header class="alm">
    <nav class="alm__series" aria-label="Breadcrumb"><a href="/topics/mining.html">Mining</a></nav>
    <h1 class="alm__title">Aaron Halo</h1>
    <p class="alm__sub">Where to leave quantum to land in the asteroid band you want · Stanton · 4.9</p>
  </header>

  <PrecisionJumpApp lang="en" />

</main>

<Attribution sources={["Jordessey (tool & route data)", "cstone.space (Halo band survey)"]} credit="VerseBase · a Star Citizen fan project" />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
