---
// Hülle (EN). Körper: components/ships/ShipsOverview.astro — geteilt mit der
// anderen Sprache, damit die beiden nicht auseinanderlaufen können (D-12).
import vehiclesSnapshot from '../data/vehicles.json';
import Layout from '../layouts/Layout.astro';
import Body from '../components/ships/ShipsOverview.astro';
---
<Layout
  title="Star Citizen Ships & Vehicles — Database | VerseBase"
  description={`${vehiclesSnapshot.count} Star Citizen ships and vehicles with specs, pledge and in-game prices, English descriptions and patch history — data as of ${vehiclesSnapshot.fetchedAt}.`}
  themeColor="#05070d"
  footer={true}
  translated={true}
  ogImage="/assets/img-hammerhead.jpg"
>
<Body />
</Layout>
