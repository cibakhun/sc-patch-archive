---
// Fracturing-Rechner — EN (/fracturing.html). Reines Client-Werkzeug, kein
// Konto, indexierbar. DE-Pendant: /de/fracturing.html.
//
// Am 12.08.2026 aus der Mining-Werkbank herausgeloest (siehe
// components/FracturingCalc.astro). Die Palette ist absichtlich Zeichen fuer
// Zeichen die der Mining-Seite: beide gehoeren zum selben Kreislauf, und die
// helle Entsprechung darunter ist damit dieselbe, die build-light-palettes
// dort schon erzeugt hat.
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Attribution from '../components/Attribution.astro';
import FracturingCalc from '../components/FracturingCalc.astro';
import DB from '../../assets/mining-db.json';
import { versioned } from '../lib/assetVersion';

const total = DB.counts.minerals;
const snap = DB.snapshot_date;
const verShort = DB.game_version.split('-')[0];
---
<Layout
  title={'Fracturing calculator — Star Citizen mining | VerseBase'}
  description={`Work out whether your mining laser cracks the rock in Star Citizen ${verShort}: pick any of ${total} ores, set laser, modules, gadget and rock mass, and read the damage ratio with the full maths written out.`}
  themeColor="#14181a"
  ogType="article"
  ogImage="/assets/img-mole.jpg"
  translated={true}
>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<style is:inline>
:root{--bg:#14181a;--bg-2:#181d1f;--surface:#1e2427;--surface-2:#252c30;--accent:#2FBFA4;--accent-2:#E0A526;--hot:#2FBFA4;--text:#eaf2f1;--muted:#8fa3a0;--line:rgba(47,191,164,.22);--line-soft:rgba(234,242,241,.10);--glow:0 0 44px rgba(47,191,164,.26);--ink:#0e1214;--maxw:1240px;}
/* Hellmodus — erzeugt von scripts/build-light-palettes.mjs. Nicht von Hand ändern. */
:root[data-theme="light"]{--bg:#f3f8fb;--bg-2:#e8eff2;--surface:#fcfefe;--surface-2:#ebf4f9;--text:#1b2120;--muted:#4a5c5a;--accent:#036a5a;--accent-2:#704f00;--hot:#046151;--ink:#ffffff;--accent-media:#2FBFA4;--accent-2-media:#E0A526;--line:rgba(43,130,113,.3);--line-soft:rgba(41,47,46,.12);--glow:0 6px 22px rgba(43,130,113,.18)}

/* Werkzeugseite, keine Leinwand: der Hero ist ein schmaler Titelstreifen —
   dieselbe Entscheidung wie auf der Mining-Seite und bei hero--tool im
   Item Finder. Alles Erklaerende steht in der Werkzeug-Hilfe, nicht hier. */
.hero{min-height:0;justify-content:flex-start;padding-top:4.4rem;padding-bottom:.5rem;
  background:radial-gradient(120% 90% at 78% 12%,rgba(47,191,164,.14),transparent 60%),radial-gradient(90% 80% at 12% 90%,rgba(224,165,38,.10),transparent 55%),var(--bg)}
.hero h1{font-size:clamp(1.6rem,3vw,2.1rem);font-weight:600;letter-spacing:var(--ls-1);color:var(--text);margin:0}
.hero .lead{flex:1 1 24ch;max-width:70ch;font-size:var(--fs-6);color:var(--muted);margin:0}
@media(max-width:1180px){.hero{padding-top:calc(var(--nav-h,116px) + .6rem)}}
.hero__in{max-width:1560px;display:flex;align-items:baseline;gap:.3rem 1rem;flex-wrap:wrap}
.hero__in .eyebrow{order:0;width:auto;flex:0 0 auto}</style>
<a class="skip" href="#main">Skip to content</a>

<SiteNav crumbs={[{ label: 'Mining', href: '/topics/mining.html' }, { label: 'Fracturing' }]} />

<main id="main">
  <section class="hero">
    <div class="hero__in">
      <div class="eyebrow">Alpha {verShort} · live data</div>
      <h1>Fracturing</h1>
      <p class="lead">Set your gear, pick an ore — the calculator says whether the rock breaks, and shows every step of the sum.</p>
    </div>
  </section>

  <FracturingCalc lang="en" />
</main>

<Attribution sources={[]} updated={snap} />

<script is:inline src={versioned('assets/detail.js', '/assets/detail.js')}></script>
</Layout>
