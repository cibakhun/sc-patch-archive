---
// Prototyp der Items-Werkbank (EN), nur im Vorschau-Bau
// (scripts/lib/vorschau-seiten.mjs). Koerper: components/items/
// ItemsWerkbankPage.astro, geteilt mit der anderen Sprache.
import { versioned } from '../lib/assetVersion';
import Layout from '../layouts/Layout.astro';
import Body from '../components/items/ItemsWerkbankPage.astro';
import { db, ITEM_PATCH, num } from '../lib/items';

const total = num(db.counts.items, 'en');
const sourced = num(db.counts.withObtain, 'en');
---
<Layout title={`Star Citizen Items — all ${total} items, prices & locations (prototype) | VerseBase`} description={`Every Star Citizen ${ITEM_PATCH} item in one workbench: browse ${total} items by group, filter and search, with stats, buy prices and loot spots; ${sourced} with verified in-game sources.`} themeColor="#0d0c14" ogType="article" ogImage="/assets/cz-loot.jpg" translated={true} noindex={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
