---
// Prototyp der Items-Werkbank (DE), nur im Vorschau-Bau
// (scripts/lib/vorschau-seiten.mjs). Koerper: components/items/
// ItemsWerkbankPage.astro, geteilt mit der anderen Sprache.
import { versioned } from '../../lib/assetVersion';
import Layout from '../../layouts/Layout.astro';
import Body from '../../components/items/ItemsWerkbankPage.astro';
import { db, ITEM_PATCH, num } from '../../lib/items';

const total = num(db.counts.items, 'de');
const sourced = num(db.counts.withObtain, 'de');
---
<Layout title={`Star Citizen Items — alle ${total} Items, Preise & Fundorte (Prototyp) | VerseBase`} description={`Alle Star-Citizen-Items aus ${ITEM_PATCH} in einer Werkbank: ${total} Items nach Gruppen durchsehen, filtern und suchen, mit Werten, Kaufpreisen und Loot-Fundorten; ${sourced} mit verifizierten In-Game-Quellen.`} themeColor="#0d0c14" ogType="article" ogImage="/assets/cz-loot.jpg" translated={true} noindex={true}>
<link slot="head" rel="stylesheet" href={versioned('assets/detail.css', '/assets/detail.css')} />
<Body />
</Layout>
