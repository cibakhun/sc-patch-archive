.cf-*.log
.cf-tunnel.log

# Multi-Agent-Arbeitsverzeichnisse / Scratch
.agents/
scratch/
TEST_*.md

# Von `npx skills add` installierte Fremd-Skills (Stripe-Doku u. a.).
# Sie liegen als echte Dateien in skills/ und werden nach .agents/skills/
# verlinkt — .agents/ steht schon oben, skills/ fehlte und wäre sonst
# mit eingecheckt worden. Werkzeug, kein Projektinhalt: genauso behandelt
# wie gsd-core und impeccable unter .claude/.
skills/
skills-lock.json

# Holo-glTF-Downloadcache (scripts/build-holo-meshes.mjs, einmalig ~2 GB)
# Frueher von calibrate-holo-markers.mjs mitbenutzt — das Skript ist in
# Phase 01.3 entfallen (toter 4.8-Marker-Stand, siehe 01.3-01-SUMMARY.md).
.cache/

# Spielermarkt-Mitschrieb: der Bestand gehoert auf den Zweig data/marketplace-log
# (siehe .github/workflows/track-marketplace.yml), nicht auf staging/main — sonst
# loest jeder Daten-Commit ein komplettes Deploy aus.
/data/
